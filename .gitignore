## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.pdb
*.dll.config
*.exe.config
*.exe.manifest
*.vshost.exe
*.pak
*.D
*.resources
*.userosscache
*.sln.docstates
*.log
appsettings.Development.json

# User-specific files (MoniDevelop/Xamarin Studio)
*.userprefs


# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
packages/
[Ll]ogs/
App_Data/


# Visual Studio 2015 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# idea
.idea/

.trae/

#MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*


# 其他目录过滤
Temp/
TempPE/

# Testing UI 测试随项目携带的本地浏览器，不提交
src/Services/Testing/H.Testing.Application/data/

# node
node_modules/


