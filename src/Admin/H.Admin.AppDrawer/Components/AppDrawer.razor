@namespace H.Admin.AppDrawer
@using Microsoft.JSInterop
@using System.Threading.Tasks
@using System.Linq

@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<link rel="stylesheet" href="_content/H.Admin.AppDrawer/css/AppDrawer.css" />
<script src="_content/H.Admin.AppDrawer/js/AppDrawer.js"></script>

@if (Visible)
{
    <div class="app-drawer-container visible">
        <div class="app-drawer-overlay"></div>
        <div class="app-drawer">
            <div class="drawer-header">
                <h4>@Title</h4>
                <button class="close-drawer">×</button>
            </div>
            <div class="drawer-content">
                @if (AppCategories != null && AppCategories.Any())
                {
                    @foreach (var category in AppCategories)
                    {
                        <div class="app-category">
                            <div class="category-title">@category.CategoryName</div>
                            <div class="category-apps">
                                @foreach (var app in category.Apps)
                                {
                                    <div class="app-item" 
                                         @key="app.Id"
                                         data-app-id="@app.Id"
                                         title="@app.Name (@(app.Target == "_blank" ? "新标签页" : "当前页"))">
                                        @if (!string.IsNullOrEmpty(app.Icon))
                                        {
                                            <div class="app-icon">@app.Icon</div>
                                        }
                                        else if (!string.IsNullOrEmpty(app.IconUrl))
                                        {
                                            <img src="@app.IconUrl" alt="" class="app-icon-image" />
                                        }
                                        <div class="app-info">
                                            <div class="app-name-text">@app.Name</div>
                                            @if (ShowTargetBadge)
                                            {
                                                <div class="app-target-badge">@(app.Target == "_blank" ? "🔗" : "📄")</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">@EmptyMessage</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DotNetObjectReference<AppDrawer>? _dotNetRef;

    /// <summary>
    /// 是否显示抽屉
    /// </summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>
    /// 抽屉标题
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "应用列表";

    /// <summary>
    /// 空状态提示文字
    /// </summary>
    [Parameter]
    public string EmptyMessage { get; set; } = "暂无应用";

    /// <summary>
    /// 是否显示目标标识（新标签页/当前页）
    /// </summary>
    [Parameter]
    public bool ShowTargetBadge { get; set; } = true;

    /// <summary>
    /// 应用分类列表
    /// </summary>
    [Parameter]
    public List<AppCategoryInfo> AppCategories { get; set; } = new();

    /// <summary>
    /// 关闭抽屉事件
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// 点击应用事件（如果设置此事件,将覆盖默认跳转行为）
    /// </summary>
    [Parameter]
    public EventCallback<AppItemInfo> OnAppClick { get; set; }

    /// <summary>
    /// 应用选择后的回调（可选，用于更新状态等）
    /// </summary>
    [Parameter]
    public EventCallback<AppItemInfo> OnAppSelected { get; set; }

    /// <summary>
    /// 点击遮罩层是否关闭抽屉
    /// </summary>
    [Parameter]
    public bool CloseOnOverlayClick { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible)
        {
            // 等待 DOM 渲染完成
            await Task.Delay(50);
            
            // 创建或复用 DotNetObjectReference
            _dotNetRef ??= DotNetObjectReference.Create(this);
            
            // 绑定事件（JS 已通过 script 标签加载）
            await JSRuntime.InvokeVoidAsync("AppDrawer.init", _dotNetRef);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    [JSInvokable]
    public async Task HandleOverlayClick()
    {
        if (CloseOnOverlayClick && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    [JSInvokable]
    public async Task HandleAppClickById(string appId)
    {
        var app = AppCategories
            .SelectMany(c => c.Apps)
            .FirstOrDefault(a => a.Id == appId);
        
        if (app != null)
        {
            await HandleAppClick(app);
        }
    }

    private async Task HandleAppClick(AppItemInfo app)
    {
        if (OnAppClick.HasDelegate)
        {
            // 使用自定义点击处理
            await OnAppClick.InvokeAsync(app);
        }
        else
        {
            // 触发 OnAppSelected 回调（用于更新状态等）
            if (OnAppSelected.HasDelegate)
            {
                await OnAppSelected.InvokeAsync(app);
            }
            
            // 关闭抽屉
            if (OnClose.HasDelegate)
            {
                await OnClose.InvokeAsync();
            }
            
            // 等待抽屉关闭动画
            await Task.Delay(100);
            
            // 根据 Target 决定打开方式
            if (app.Target == "_blank")
            {
                await JSRuntime.InvokeVoidAsync("open", app.Url, "_blank");
            }
            else
            {
                NavigationManager.NavigateTo(app.Url);
            }
        }
    }

    private async Task OnAppItemClick(AppItemInfo app)
    {
        await HandleAppClick(app);
    }
}
