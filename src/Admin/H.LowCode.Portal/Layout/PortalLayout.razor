@namespace H.LowCode.Portal
@inherits LayoutComponentBase
@inject H.LowCode.Host.All.Shared.Services.AppStateManager AppStateManager
@inject NavigationManager NavigationManager

<link rel="stylesheet" href="_content/H.Util.Blazor/css/AppDrawer.css" />
<link rel="stylesheet" href="_content/H.LowCode.Portal/css/site.css" />

<div class="layout-container">
    <!-- 顶部导航栏 -->
    <div class="top-navbar">
        <div class="navbar-left">
            <!-- 应用抽屉按钮 -->
            <button class="drawer-toggle" @onclick="ToggleAppDrawer">
                <span class="drawer-icon">☰</span>
            </button>
            
            <!-- 测试按钮 -->
            <button @onclick="TestClick" style="margin-left: 10px; padding: 5px 10px;">测试点击</button>
            
            <!-- 应用名称 -->
            <div class="app-name">
                <h3>@CurrentAppName</h3>
            </div>
        </div>
        
        <div class="navbar-right">
            <!-- 控制台 -->
            @* <a href="/" class="nav-link">
                <span>控制台</span>
            </a> *@
            
            <!-- 登录/用户信息 -->
            @if (IsLoggedIn)
            {
                <!-- 用户头像 -->
                <div class="user-avatar" style="background-color: #1890ff; display: flex; align-items: center; justify-content: center;">
                    <svg viewBox="0 0 100 100" style="width: 100%; height: 100%;">
                        <circle fill="#fff" cx="50" cy="35" r="20"/>
                        <path fill="#fff" d="M50 60 Q20 60 20 85 L80 85 Q80 60 50 60"/>
                    </svg>
                </div>
                
                <!-- 用户名称 -->
                <div class="user-name">
                    <span>@UserName</span>
                </div>
                
                <!-- 退出登录 -->
                @* <button class="logout-btn" @onclick="Logout">
                    <span>退出</span>
                </button> *@
            }
            else
            {
                <!-- 登录按钮 -->
                <button class="login-btn" @onclick="Login">
                    <span>登录</span>
                </button>
            }
        </div>
    </div>
    
    <!-- 主体内容区域 -->
    <div class="main-content">
        @Body
    </div>
    
    <!-- 应用抽屉（使用组件） -->
    <AppDrawer Visible="showAppDrawer"
               Title="应用列表"
               AppCategories="@appCategories"
               OnAppClick="@(async (app) => await OnAppSelected(app))"
               OnClose="CloseAppDrawer" />
</div>

@code{
    private bool showAppDrawer = false;
    private bool IsLoggedIn => !string.IsNullOrEmpty(UserName);
    private string UserName { get; set; } = "用户";
    private string UserAvatarUrl { get; set; } = ""; // 如果有用户头像 URL，设置此属性
    
    // 应用列表数据
    private List<AppCategoryInfo> appCategories = new();
    
    // 当前应用名称
    private string CurrentAppName => GetCurrentAppName();
    
    protected override void OnInitialized()
    {
        // 初始化应用列表
        appCategories = AppStateManager.GetAppCategories();
        
        // 订阅应用切换事件
        AppStateManager.OnAppChanged += OnAppChanged;
    }
    
    private void OnAppChanged(string appId)
    {
        StateHasChanged();
    }
    
    private async Task OnAppSelected(H.Util.Blazor.AppItemInfo app)
    {
        Console.WriteLine($"OnAppSelected 被调用: {app.Name}, URL: {app.Url}");
        
        // 更新当前应用状态
        AppStateManager.CurrentAppId = app.Id;
        
        // 关闭抽屉
        showAppDrawer = false;
        StateHasChanged();
        
        // 导航到应用页面
        await Task.Delay(100); // 等待 UI 更新
        NavigationManager.NavigateTo(app.Url);
    }
    
    private void ToggleAppDrawer()
    {
        showAppDrawer = !showAppDrawer;
    }
    
    private void CloseAppDrawer()
    {
        showAppDrawer = false;
        StateHasChanged();
    }
    
    private string GetCurrentAppName()
    {
        var currentPath = NavigationManager.Uri.Replace(NavigationManager.BaseUri, "");
        return currentPath switch
        {
            var p when p.StartsWith("/account") => "用户管理",
            var p when p.StartsWith("/organization") => "组织管理",
            var p when p.StartsWith("/design") => "应用设计器",
            var p when p.StartsWith("/render") => "应用预览",
            _ => "H.LowCode"
        };
    }
    
    private void Login()
    {
        // TODO: 实现登录逻辑
        UserName = "测试用户";
    }
    
    private void Logout()
    {
        // TODO: 实现登出逻辑
        UserName = null;
    }
    
    private void TestClick()
    {
        Console.WriteLine("[TEST] TestClick 被调用！");
        UserName = UserName == "测试用户" ? "点击成功！" : "测试用户";
    }
}