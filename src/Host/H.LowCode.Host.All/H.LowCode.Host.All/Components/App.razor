<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["H.LowCode.Host.All.styles.css"]" />
    <link rel="stylesheet" href="_content/H.Util.Blazor/h-components.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    @* 加载指示器 - WASM 运行时下载期间展示 *@
    <div id="loading-overlay" style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#f0f2f5;z-index:9999;">
        <div style="text-align:center;">
            <div class="loading-spinner"></div>
            <p style="margin-top:16px;color:#666;font-size:14px;">加载中...</p>
        </div>
    </div>
    <style>
        .loading-spinner {
            width: 40px; height: 40px; margin: 0 auto;
            border: 3px solid #e8e8e8; border-top-color: #1890ff;
            border-radius: 50%; animation: spin 0.8s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>

    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // 定义 ABP 工具函数
        window.abp = window.abp || {};
        window.abp.utils = window.abp.utils || {};
        
        window.abp.utils.getCookieValue = function(name) {
            var equalities = document.cookie.split(';');
            for (var i = 0; i < equalities.length; i++) {
                if (!equalities[i]) {
                    continue;
                }
                var equalSignIndex = equalities[i].indexOf('=');
                if (equalSignIndex < 0) {
                    continue;
                }
                var key = equalities[i].substring(0, equalSignIndex).trim();
                if (key === name) {
                    var val = equalities[i].substring(equalSignIndex + 1);
                    return val;
                }
            }
            return null;
        };

        // 移除加载指示器（由 Blazor 组件首次渲染后调用）
        window.removeLoadingOverlay = function() {
            var el = document.getElementById('loading-overlay');
            if (el) {
                el.style.transition = 'opacity 0.3s';
                el.style.opacity = '0';
                setTimeout(function() { el.remove(); }, 300);
            }
        };
    </script>
    <script src="_content/H.Assistant.Web/js/chatStateBus.js"></script>
</body>

</html>
