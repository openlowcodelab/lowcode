<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.AppLab.Desktop.Host.Views.HostTasksView">
  <!-- 任务页（占位，后续接入任务中心） -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
    <TextBlock Text="🗓" FontSize="48" Foreground="#d9d9d9" HorizontalAlignment="Center" />
    <TextBlock Text="任务中心即将上线" FontSize="16" Foreground="#8c8c8c" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
