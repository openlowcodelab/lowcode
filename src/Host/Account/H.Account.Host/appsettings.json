{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AccountDb": "Server=(localdb)\\mssqllocaldb;Database=AccountDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKey12345678901234567890",
    "Issuer": "H.Account",
    "Audience": "H.Account",
    "ExpirationMinutes": 1440
  },
  "ExternalLogin": {
    "WeChat": {
      "Enabled": false,
      "ClientId": "your_wechat_app_id",
      "ClientSecret": "your_wechat_app_secret",
      "CallbackPath": "/signin-wechat"
    },
    "DingTalk": {
      "Enabled": false,
      "ClientId": "your_dingtalk_app_id",
      "ClientSecret": "your_dingtalk_app_secret",
      "CallbackPath": "/signin-dingtalk"
    }
  }
}
