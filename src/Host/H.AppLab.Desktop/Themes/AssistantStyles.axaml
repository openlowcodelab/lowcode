<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Assistant 应用样式（由 AssistantAppView 引入，随应用接入宿主生效） -->

  <!-- ========== 基础按钮（无边框浅灰实底，与应用页 appOpen 一致） ========== -->
  <Style Selector="Button.btn">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#e0e0e0" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="Background" Value="#d5d5d5" />
  </Style>

  <!-- 主按钮（与应用页 appOpen 一致，当前与基础按钮同色） -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#e0e0e0" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#d5d5d5" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>

  <!-- 灰色系 primary（对应 assistant-btn-primary，选中态比基础按钮更深） -->
  <Style Selector="Button.assistantPrimary">
    <Setter Property="Background" Value="#d5d5d5" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
  <Style Selector="Button.assistantPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#c9c9c9" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>

  <!-- 链接按钮 -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#595959" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>

  <!-- 危险按钮 -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="#ff4d4f" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#ff4d4f" />
    <Setter Property="Background" Value="#fff1f0" />
  </Style>

  <!-- 小尺寸按钮 -->
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- 图标按钮（36x36 白底） -->
  <Style Selector="Button.iconBtn">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#d9d9d9" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0f0f0" />
    <Setter Property="BorderBrush" Value="#bfbfbf" />
  </Style>

  <!-- 无边框小图标按钮 -->
  <Style Selector="Button.ghostIcon">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#8c8c8c" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.ghostIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0f0f0" />
    <Setter Property="Foreground" Value="#595959" />
  </Style>

  <!-- 模态框主按钮（浅灰） -->
  <Style Selector="Button.modalPrimary">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="20,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#e0e0e0" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.modalPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#d5d5d5" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>

  <!-- 模态框危险按钮（红色，定义在 modalPrimary 之后以覆盖其颜色） -->
  <Style Selector="Button.modalDanger">
    <Setter Property="Background" Value="#ff4d4f" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>
  <Style Selector="Button.modalDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#ff7875" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>

  <!-- 模态框取消按钮 -->
  <Style Selector="Button.modalCancel">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="20,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.modalCancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="BorderBrush" Value="#bfbfbf" />
    <Setter Property="Background" Value="#f5f5f5" />
  </Style>

  <!-- ========== 标签 tag ========== -->
  <Style Selector="Border.tag">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.tagGreen">
    <Setter Property="Background" Value="#f6ffed" />
    <Setter Property="BorderBrush" Value="#b7eb8f" />
  </Style>
  <Style Selector="Border.tagGreen > TextBlock">
    <Setter Property="Foreground" Value="#52c41a" />
  </Style>
  <Style Selector="Border.tagBlue">
    <Setter Property="Background" Value="#e6f7ff" />
    <Setter Property="BorderBrush" Value="#91d5ff" />
  </Style>
  <Style Selector="Border.tagBlue > TextBlock">
    <Setter Property="Foreground" Value="#1890ff" />
  </Style>
  <Style Selector="Border.tagDefault">
    <Setter Property="Background" Value="#fafafa" />
    <Setter Property="BorderBrush" Value="#d9d9d9" />
  </Style>
  <Style Selector="Border.tagDefault > TextBlock">
    <Setter Property="Foreground" Value="#595959" />
  </Style>

  <!-- ========== 表单 ========== -->
  <Style Selector="TextBlock.formLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBox.modalInput">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
  <Style Selector="TextBox.modalInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#a6a6a6" />
  </Style>
  <Style Selector="TextBox.modalInput:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#e5e5e5" />
  </Style>
  <Style Selector="ComboBox.modalSelect">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.modalSelect:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#e5e5e5" />
  </Style>
  <Style Selector="NumericUpDown.modalInput">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="NumericUpDown.modalInput:pointerover /template/ Border#PART_Background">
    <Setter Property="BorderBrush" Value="#e5e5e5" />
  </Style>

  <!-- ========== 下拉菜单项 ========== -->
  <Style Selector="Button.menuItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f5f5f5" />
  </Style>
  <Style Selector="Button.menuItemDanger">
    <Setter Property="Foreground" Value="#ff4d4f" />
  </Style>
  <Style Selector="Button.menuItemDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#fff1f0" />
    <Setter Property="Foreground" Value="#ff4d4f" />
  </Style>

  <!-- ========== 卡片 ========== -->
  <Style Selector="Border.card">
    <Setter Property="BorderBrush" Value="#e8e8e8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#ffffff" />
  </Style>

  <!-- Tab 项 -->
  <Style Selector="Button.tabItem">
    <Setter Property="Padding" Value="20,12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="#8c8c8c" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.tabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#595959" />
  </Style>
  <Style Selector="Button.tabItemActive">
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderBrush" Value="#262626" />
  </Style>
  <Style Selector="Button.tabItemActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#262626" />
  </Style>

  <!-- ========== 会话侧栏（原 MainWindow 样式） ========== -->
  <!-- 侧栏菜单项 -->
  <Style Selector="Button.sideMenuItem">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.sideMenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0f0f0" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
  <Style Selector="Button.sideMenuActive">
    <Setter Property="Background" Value="#e6f7ff" />
    <Setter Property="Foreground" Value="#1890ff" />
  </Style>
  <Style Selector="Button.sideMenuActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#e6f7ff" />
    <Setter Property="Foreground" Value="#1890ff" />
  </Style>

  <!-- 会话分区标题 -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#8c8c8c" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- 会话项 -->
  <Style Selector="Button.sessionItem">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
  <Style Selector="Button.sessionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0f0f0" />
  </Style>
  <Style Selector="Button.sessionItemActive">
    <Setter Property="Background" Value="#f2f2f2" />
  </Style>

  <!-- ========== 分类筛选 chip ========== -->
  <Style Selector="Button.categoryChip">
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#e8e8e8" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#595959" />
  </Style>
  <Style Selector="Button.categoryChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#a6a6a6" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="Background" Value="#ffffff" />
  </Style>
  <Style Selector="Button.categoryChipActive">
    <Setter Property="Background" Value="#262626" />
    <Setter Property="BorderBrush" Value="#262626" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>
  <Style Selector="Button.categoryChipActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#404040" />
    <Setter Property="BorderBrush" Value="#404040" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>

  <!-- ========== 分段切换按钮（创建方式/执行方式） ========== -->
  <Style Selector="Button.segBtn">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#595959" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.segBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#bfbfbf" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="Background" Value="#ffffff" />
  </Style>
  <Style Selector="Button.segBtnActive">
    <Setter Property="Background" Value="#f0f5ff" />
    <Setter Property="BorderBrush" Value="#bfbfbf" />
    <Setter Property="Foreground" Value="#262626" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.segBtnActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0f5ff" />
    <Setter Property="BorderBrush" Value="#bfbfbf" />
    <Setter Property="Foreground" Value="#262626" />
  </Style>
</Styles>
