<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.AppLab.Desktop.Views.AppsView">
  <!-- 应用中心：展示所有已接入的插件应用 -->
  <ScrollViewer>
    <StackPanel Margin="48,40" MaxWidth="1080" HorizontalAlignment="Left" Spacing="8">
      <TextBlock Text="应用" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="已接入宿主的独立应用，点击打开后在内容区展示。"
                 FontSize="14" Foreground="#8c8c8c" Margin="0,0,0,24" />

      <ItemsControl ItemsSource="{Binding Apps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="appCard">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="30" />
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8c8c8c"
                           TextWrapping="Wrap" MinHeight="32" />
                <Button Classes="appOpen" HorizontalAlignment="Left" Command="{Binding OpenCommand}">
                  <TextBlock Text="打开" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
