<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.AppLab.Desktop.Views.McpSettingsView">
  <Panel>
    <ScrollViewer Padding="24,14,24,24">
      <StackPanel>
        <TextBlock Text="MCP 管理" FontSize="20" Margin="0,0,0,14" />

        <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
          <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Servers}" IsVisible="{Binding HasServers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,0,12" ClipToBounds="True">
                <StackPanel>
                  <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="tag tagBlue"><TextBlock Text="{Binding TransportType}" /></Border>
                      <Border Classes="tag tagGreen" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                      <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="16,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="名称:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="端点:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Endpoint}" FontSize="13" Foreground="#595959" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="超时:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding TimeoutText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="Token:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" IsVisible="{Binding HasAuthToken}" />
                      <TextBlock Text="{Binding MaskedAuthToken}" FontSize="13" Foreground="#595959" IsVisible="{Binding HasAuthToken}" />
                      <TextBlock Text="API Key:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" IsVisible="{Binding HasApiKey}" />
                      <TextBlock Text="{Binding MaskedApiKey}" FontSize="13" Foreground="#595959" IsVisible="{Binding HasApiKey}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Loading" /><Binding Path="!HasServers" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
          <TextBlock Text="暂无 MCP 服务配置" Foreground="#8c8c8c" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
