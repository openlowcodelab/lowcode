<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.AppLab.Desktop.Views.LlmSettingsView">
  <Panel>
    <ScrollViewer Padding="24,14,24,24">
      <StackPanel>
        <TextBlock Text="模型管理" FontSize="20" Margin="0,0,0,14" />

        <!-- 加载中 -->
        <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
          <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 卡片列表（两列） -->
        <ItemsControl ItemsSource="{Binding Configs}" IsVisible="{Binding HasConfigs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="6" ClipToBounds="True">
                <StackPanel>
                  <!-- 卡片头 -->
                  <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProviderDisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="tag tagGreen" IsVisible="{Binding IsDefault}"><TextBlock Text="默认" /></Border>
                      <Border Classes="tag tagBlue" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                      <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                    </StackPanel>
                  </Border>
                  <!-- 卡片体 -->
                  <StackPanel Margin="16,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Provider:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding ProviderName}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="模型:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Model}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="API Key:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding MaskedApiKey}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBaseUrl}">
                      <TextBlock Text="Base URL:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding BaseUrl}" FontSize="13" Foreground="#595959" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="MaxTokens:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding MaxTokensText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="Temperature:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding TemperatureText}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Loading" />
              <Binding Path="!HasConfigs" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
          <TextBlock Text="暂无模型配置" Foreground="#8c8c8c" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
