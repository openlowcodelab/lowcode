<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:H.AppLab.Desktop.ViewModels"
             xmlns:views="using:H.AppLab.Desktop.Views"
             x:Class="H.AppLab.Desktop.Views.AssistantAppView"
             FontFamily="Microsoft YaHei UI, Segoe UI, Inter"
             FontSize="14"
             Foreground="#262626"
             Background="#ffffff">
  <!-- 助手应用根视图（原 MainWindow，现以插件应用形式嵌入宿主外壳） -->
  <UserControl.Styles>
    <StyleInclude Source="avares://H.AppLab.Desktop/Themes/AssistantStyles.axaml" />
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
      <views:ChatView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KnowledgeViewModel}">
      <views:KnowledgeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KnowledgeSectionViewModel}">
      <views:KnowledgeSectionView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- ========== 主布局：会话侧栏 + 页面内容（对应 ChatLayout） ========== -->
    <Grid ColumnDefinitions="280,*">
      <!-- 会话侧栏 -->
      <Border Grid.Column="0" Background="#fafafa" BorderBrush="#f5f5f5" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- 顶部：新建会话 -->
          <Border DockPanel.Dock="Top" Padding="16" Background="Transparent">
            <Button Classes="iconBtn" HorizontalAlignment="Right" Command="{Binding NewChatCommand}"
                    ToolTip.Tip="新建会话">
              <TextBlock Text="＋" FontSize="16" />
            </Button>
          </Border>

          <!-- 会话标题 -->
          <Button DockPanel.Dock="Top" Classes="sectionTitle" Command="{Binding GoToChatCommand}"
                  IsHitTestVisible="{Binding SessionTitleClickable}">
            <TextBlock Text="会话" />
          </Button>

          <!-- 知识中心菜单项（底部） -->
          <Button DockPanel.Dock="Bottom" Classes="sideMenuItem"
                  Classes.sideMenuActive="{Binding IsKnowledgePage}"
                  Command="{Binding GoToKnowledgeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="📖" FontSize="14" />
              <TextBlock Text="知识中心" />
            </StackPanel>
          </Button>

          <!-- 会话列表 -->
          <ScrollViewer>
            <Panel Margin="8">
              <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding HasSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="sessionItem"
                            Classes.sessionItemActive="{Binding IsSelected}"
                            Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding MessageCountText}" FontSize="12" Foreground="#8c8c8c" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="12" Foreground="#8c8c8c" />
                          </Grid>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghostIcon" VerticalAlignment="Top" ToolTip.Tip="更多操作">
                          <TextBlock Text="⋮" FontSize="14" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="删除" Foreground="#ff4d4f" Command="{Binding DeleteCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 空状态 -->
              <StackPanel IsVisible="{Binding !HasSessions}" HorizontalAlignment="Center" Margin="20,60" Spacing="12">
                <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
                <TextBlock Text="暂无会话" Foreground="#8c8c8c" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 右侧页面内容 -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>

    <!-- ========== Toast ========== -->
    <Border IsVisible="{Binding Toast.IsVisible}"
            Background="{Binding Toast.Background}"
            CornerRadius="6" Padding="16,10"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
            BoxShadow="0 2 8 0 #33000000">
      <TextBlock Text="{Binding Toast.Message}" Foreground="White" FontSize="13" />
    </Border>
  </Panel>
</UserControl>
