<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.AppLab.Desktop.Views.SkillSettingsView">
  <Panel>
    <ScrollViewer Padding="24,14,24,24">
      <StackPanel>
        <TextBlock Text="技能管理" FontSize="20" Margin="0,0,0,16" />

        <!-- Skill / Tool 选项卡 -->
        <Border BorderBrush="#e8e8e8" BorderThickness="0,0,0,2" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal">
            <Button Classes="tabItem" Classes.tabItemActive="{Binding IsSkillTab}"
                    Command="{Binding SwitchTabCommand}" CommandParameter="skill" Content="Skill 列表" />
            <Button Classes="tabItem" Classes.tabItemActive="{Binding IsToolTab}"
                    Command="{Binding SwitchTabCommand}" CommandParameter="tool" Content="Tool 列表" />
          </StackPanel>
        </Border>

        <!-- Skill 列表 -->
        <StackPanel IsVisible="{Binding IsSkillTab}">
          <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
            <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Skills}" IsVisible="{Binding HasSkills}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,12" ClipToBounds="True">
                  <StackPanel>
                    <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="tag tagBlue"><TextBlock Text="{Binding SkillName}" /></Border>
                        <Border Classes="tag tagGreen" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                        <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                      </StackPanel>
                    </Border>
                    <StackPanel Margin="16,12" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="类型:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding SkillType}" FontSize="13" Foreground="#595959" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="描述:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#595959" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasImplementationClass}">
                        <TextBlock Text="实现类:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding ImplementationClass}" FontSize="13" Foreground="#595959"
                                   FontFamily="Consolas,Monaco,Courier New" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="使用次数:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding UsageCountText}" FontSize="13" Foreground="#595959" />
                        <TextBlock Text="最后使用:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" IsVisible="{Binding HasLastUsedTime}" />
                        <TextBlock Text="{Binding LastUsedTimeText}" FontSize="13" Foreground="#595959" IsVisible="{Binding HasLastUsedTime}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!Loading" /><Binding Path="!HasSkills" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
            <TextBlock Text="暂无技能" Foreground="#8c8c8c" />
          </StackPanel>
        </StackPanel>

        <!-- Tool 列表 -->
        <StackPanel IsVisible="{Binding IsToolTab}">
          <ItemsControl ItemsSource="{Binding Tools}" IsVisible="{Binding HasTools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,12" ClipToBounds="True">
                  <StackPanel>
                    <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="tag tagGreen" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                        <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                      </StackPanel>
                    </Border>
                    <StackPanel Margin="16,12" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="描述:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#595959" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="实现类:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding FullName}" FontSize="13" Foreground="#595959"
                                   FontFamily="Consolas,Monaco,Courier New" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="关联 Skill:" FontSize="13" Foreground="#8c8c8c" />
                        <TextBlock Text="{Binding SkillName}" FontSize="13" Foreground="#595959" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12" IsVisible="{Binding !HasTools}">
            <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
            <TextBlock Text="暂无 Tool" Foreground="#8c8c8c" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
