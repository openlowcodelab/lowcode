@namespace H.AppDrawer.Components
@inject NavigationManager Navigation

<style>
.top-navbar { display: flex; justify-content: space-between; align-items: center; height: 56px; flex-shrink: 0; padding: 0 20px 0 8px; background-color: #fff; border-bottom: 1px solid var(--h-border-2, #E5E6EB); z-index: 100; }
.navbar-left { display: flex; align-items: center; gap: 12px; }
.navbar-center { display: flex; align-items: center; flex: 1; margin-left: 40px; }
.drawer-toggle { background: none; border: none; font-size: 20px; color: var(--h-text-2, #4E5969); cursor: pointer; padding: 6px 10px; border-radius: 4px; transition: all 0.15s; }
.drawer-toggle:hover { background-color: var(--h-fill-2, #F2F3F5); color: var(--h-text, #1D2129); }
.app-name h3 { margin: 0; font-size: 16px; font-weight: 600; color: var(--h-text, #1D2129); }
.navbar-logo { height: 30px; width: 30px; object-fit: contain; display: block; position: relative; top: 3px; }
.navbar-right { display: flex; align-items: center; gap: 10px; }
.user-avatar { width: 32px; height: 32px; border-radius: 50%; overflow: hidden; }
.user-name span { color: var(--h-text-2, #4E5969); font-size: 14px; }
.login-btn { padding: 5px 16px; background-color: var(--h-primary, #165DFF); color: white; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; transition: background 0.15s; }
.login-btn:hover { background-color: var(--h-primary-hover, #4080FF); }
.user-dropdown { position: relative; cursor: pointer; }
.user-info { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 4px; transition: background 0.15s; }
.user-info:hover { background-color: var(--h-fill-2, #F2F3F5); }
.dropdown-mask { position: fixed; inset: 0; z-index: 999; background: transparent; }
.dropdown-menu { 
    position: absolute; top: 100%; right: 0; background: white; 
    box-shadow: 0 6px 18px rgba(29,33,41,0.10); border: 1px solid var(--h-border-light, #F2F3F5); border-radius: 8px; 
    width: 200px; z-index: 1000; margin-top: 8px; overflow: hidden; padding: 4px;
}
.dropdown-item { padding: 8px 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--h-text, #1D2129); border-radius: 4px; transition: background 0.15s; }
.dropdown-item:hover { background-color: var(--h-fill-1, #F7F8FA); }
.dropdown-section-title { padding: 8px 12px 4px; font-size: 12px; color: var(--h-text-3, #86909C); font-weight: 500; }
.enterprise-item { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: 4px; margin: 0 0 4px; cursor: pointer; box-sizing: border-box; max-width: 100%; transition: background 0.15s; }
.enterprise-item:hover { background-color: var(--h-fill-1, #F7F8FA); }
.enterprise-item .enterprise-name-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
.enterprise-item .enterprise-name-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
.enterprise-item .enterprise-switch { display: flex; align-items: center; gap: 4px; color: var(--h-text-3, #86909C); white-space: nowrap; margin-left: 12px; font-size: 13px; }
</style>

<div class="top-navbar">
    <div class="navbar-left">
        <button class="drawer-toggle" @onclick="OnDrawerToggle">
            <span class="drawer-icon">☰</span>
        </button>
        @if (!string.IsNullOrEmpty(Logo))
        {
            <a href="/" target="_self">
                <img class="navbar-logo" src="@Logo" alt="logo" />
            </a>
        }
        <div class="app-name">
            <h3>@AppName</h3>
        </div>
    </div>
    
    @if (ChildContent != null)
    {
        <div class="navbar-center">
            @ChildContent
        </div>
    }
    
    <div class="navbar-right">
        @if (IsLoggedIn)
        {
            <div class="user-dropdown" @onclick:stopPropagation="true">
                <div class="user-info" @onclick="ToggleDropdown">
                    <div class="user-avatar" style="background-color: var(--h-primary, #165DFF); display: flex; align-items: center; justify-content: center;">
                        <svg viewBox="0 0 100 100" style="width: 100%; height: 100%;">
                            <circle fill="#fff" cx="50" cy="35" r="20"/>
                            <path fill="#fff" d="M50 60 Q20 60 20 85 L80 85 Q80 60 50 60"/>
                        </svg>
                    </div>
                    <div class="user-name">
                        <span>@UserName</span>
                    </div>
                </div>
                
                @if (showDropdown)
                {
                    <div class="dropdown-mask" @onclick="CloseDropdown"></div>
                    <div class="dropdown-menu">
                        <div class="dropdown-item" @onclick="GoToProfile">
                            个人设置
                        </div>
                        <div class="dropdown-item" @onclick="OnLogout">
                            退出登录
                        </div>
                        @if (!string.IsNullOrEmpty(EnterpriseName))
                        {
                            <div style="margin: 4px 0; border-top: 1px solid var(--h-border-light, #F2F3F5);"></div>
                            <div class="dropdown-section-title">组织</div>
                            <div class="enterprise-item" @onclick="GoToEnterpriseSelect">
                                <div class="enterprise-name-left">
                                    <span class="enterprise-name-text">@EnterpriseName</span>
                                </div>
                                <div class="enterprise-switch">
                                    <span>切换</span>
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <button class="login-btn" @onclick="HandleLogin">
                <span>登录</span>
            </button>
        }
    </div>
</div>

@code {
    /// <summary>
    /// 应用名称
    /// </summary>
    [Parameter]
    public string AppName { get; set; } = "应用";

    /// <summary>
    /// Logo 图片路径
    /// </summary>
    [Parameter]
    public string? Logo { get; set; }

    /// <summary>
    /// 抽屉切换事件
    /// </summary>
    [Parameter]
    public EventCallback OnDrawerToggle { get; set; }

    /// <summary>
    /// 中间内容（通常是菜单）
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 用户名（由外部传入）
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = "用户";

    /// <summary>
    /// 是否已登录（由外部传入）
    /// </summary>
    [Parameter]
    public bool IsLoggedIn { get; set; }

    /// <summary>
    /// 登录Url（由外部传入，默认/account/login）
    /// </summary>
    [Parameter]
    public string LoginUrl { get; set; } = "/account/login";

    /// <summary>
    /// 个人资料Url（由外部传入，默认/account/users）
    /// </summary>
    [Parameter]
    public string ProfileUrl { get; set; } = "/account/users";

    /// <summary>
    /// 当前企业名称
    /// </summary>
    [Parameter]
    public string? EnterpriseName { get; set; }

    /// <summary>
    /// 退出登录回调（由外部处理）
    /// </summary>
    [Parameter]
    public EventCallback OnLogout { get; set; }

    private bool showDropdown = false;

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private void GoToProfile()
    {
        showDropdown = false;
        Navigation.NavigateTo(ProfileUrl);
    }

    private void HandleLogin()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.Uri);
        Navigation.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}");
    }

    private void GoToEnterpriseSelect()
    {
        showDropdown = false;
        Navigation.NavigateTo("/enterprise/select", forceLoad: true);
    }
}
