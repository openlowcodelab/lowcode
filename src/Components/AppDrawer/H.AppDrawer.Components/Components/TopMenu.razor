@namespace H.AppDrawer.Components

<style>
.navbar-menu { display: flex; align-items: center; gap: 4px; flex: 1; }
.menu-item-top { display: flex; align-items: center; height: 56px; gap: 6px; padding: 0 16px; cursor: pointer; transition: all 0.15s; color: var(--h-text-2, #4E5969); font-size: 14px; border-bottom: 2px solid transparent; box-sizing: border-box; }
.menu-item-top:hover { color: var(--h-primary, #165DFF); }
.menu-item-top.active { color: var(--h-primary, #165DFF); font-weight: 500; border-bottom-color: var(--h-primary, #165DFF); }
.menu-icon-top { font-size: 16px; display: inline-flex; align-items: center; }
</style>

@if (MenuItems != null && MenuItems.Any())
{
    <div class="navbar-menu">
        @foreach (var item in MenuItems)
        {
            var menuItem = item;
            var isActive = IsActiveMenu(item.Url);
            <div class="menu-item-top @(isActive ? "active" : "")"
                 style="cursor: pointer;"
                 @onclick="() => NavigateToMenuItem(menuItem)">
                <span class="menu-icon-top">@MenuIcons.GetSvg(item.Icon)</span>
                <span>@item.Name</span>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// 菜单列表
    /// </summary>
    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    /// <summary>
    /// 判断顶部菜单是否激活
    /// </summary>
    private bool IsActiveMenu(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return false;

        // 使用 ToBaseRelativePath 获取不带前导斜杠的相对路径，并去除 query/hash
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var separatorIndex = currentPath.IndexOfAny(new[] { '?', '#' });
        if (separatorIndex >= 0)
            currentPath = currentPath.Substring(0, separatorIndex);

        // 菜单 Url 可能带前导斜杠，统一去除后比较
        var target = url.TrimStart('/');
        return currentPath.StartsWith(target, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// 导航到菜单项
    /// </summary>
    private async Task NavigateToMenuItem(AppMenuItem item)
    {
        if (!string.IsNullOrEmpty(item.Url))
        {
            await Task.Delay(10);
            NavigationManager.NavigateTo(item.Url, forceLoad: false);
        }
    }
}
