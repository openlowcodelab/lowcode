@namespace H.AppDrawer.Components

@inherits LayoutComponentBase

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
</style>

<div class="layout-container">
    <TopNavbar AppName="@AppName" OnDrawerToggle="ToggleAppDrawer">
        <SidebarMenu MenuItems="@MenuItems" ShowSidebar="@ShowSidebar">
            @Body
        </SidebarMenu>
    </TopNavbar>
    
    <AppDrawer @ref="appDrawer" />
</div>

@code {
    private AppDrawer? appDrawer;
    private string UserName { get; set; } = string.Empty;

    /// <summary>
    /// 应用名称（子类可重写）
    /// </summary>
    protected virtual string AppName => "应用";

    /// <summary>
    /// 菜单项列表（子类可重写）
    /// </summary>
    protected virtual List<AppMenuItem> MenuItems => new();

    /// <summary>
    /// 是否显示侧边栏（子类可重写）
    /// </summary>
    protected virtual bool ShowSidebar => true;

    /// <summary>
    /// 切换应用抽屉
    /// </summary>
    private void ToggleAppDrawer()
    {
        appDrawer?.Toggle();
    }
}
