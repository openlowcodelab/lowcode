@namespace H.AppDrawer.Components

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; }
.menu-container { display: flex; flex: 1; }
.content-container { flex: 1; overflow-y: auto; background-color: #f0f2f5; padding: 20px; }
</style>

<div class="layout-container">
    <TopNavbar 
        AppName="@AppName" 
        OnDrawerToggle="ToggleAppDrawer"
        UserName="@UserName"
        IsLoggedIn="@IsLoggedIn"
        LoginUrl="@LoginUrl"
        ProfileUrl="@ProfileUrl"
        OnLogout="HandleLogout">
        @if (MenuPosition == MenuPosition.Top)
        {
            <TopMenu MenuItems="@MenuItems" />
        }
    </TopNavbar>

    <div class="menu-container">
        @if (MenuPosition != MenuPosition.Top)
        {
            <SideMenu MenuItems="@MenuItems" />
        }

        <div class="content-container">
            @ChildContent
        </div>
    </div>

    <AppDrawer @ref="appDrawer" />
</div>

@code {
    /// <summary>
    /// 应用名称
    /// </summary>
    [Parameter]
    public string AppName { get; set; } = "应用";

    /// <summary>
    /// 菜单列表（不传则不渲染菜单）
    /// </summary>
    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    /// <summary>
    /// 菜单位置（默认左侧）
    /// </summary>
    [Parameter]
    public MenuPosition MenuPosition { get; set; } = MenuPosition.Left;

    /// <summary>
    /// 用户名（由外部传入）
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = "用户";

    /// <summary>
    /// 是否已登录（由外部传入）
    /// </summary>
    [Parameter]
    public bool IsLoggedIn { get; set; }

    /// <summary>
    /// 登录Url（默认/account/login）
    /// </summary>
    [Parameter]
    public string LoginUrl { get; set; } = "/account/login";

    /// <summary>
    /// 个人资料Url（默认/account/users）
    /// </summary>
    [Parameter]
    public string ProfileUrl { get; set; } = "/account/users";

    /// <summary>
    /// 退出登录回调（由外部处理）
    /// </summary>
    [Parameter]
    public EventCallback OnLogout { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private AppDrawer? appDrawer;

    /// <summary>
    /// 切换应用抽屉
    /// </summary>
    private void ToggleAppDrawer()
    {
        appDrawer?.Toggle();
    }

    /// <summary>
    /// 处理退出登录（默认实现，可被外部覆盖）
    /// </summary>
    private async Task HandleLogout()
    {
        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }
        else
        {
            // 默认行为：跳转到首页
            NavigationManager.NavigateTo("/");
        }
    }
}
