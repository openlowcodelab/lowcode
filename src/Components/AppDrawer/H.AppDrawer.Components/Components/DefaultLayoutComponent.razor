@namespace H.AppDrawer.Components
@using Microsoft.AspNetCore.Http

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; }
.menu-container { display: flex; flex: 1; }
.content-container { flex: 1; overflow-y: auto; background-color: #f0f2f5; padding: 20px; }
</style>

<div class="layout-container">
    <TopNavbar 
        AppName="@AppName" 
        OnDrawerToggle="ToggleAppDrawer"
        UserName="@(RequireAuthentication ? _userName : UserName)"
        IsLoggedIn="@(RequireAuthentication ? _isLoggedIn : IsLoggedIn)"
        LoginUrl="@LoginUrl"
        ProfileUrl="/account/profile"
        OnLogout="HandleLogout">
        @if (MenuPosition == MenuPosition.Top)
        {
            <TopMenu MenuItems="@MenuItems" />
        }
    </TopNavbar>

    <div class="menu-container">
        @if (MenuPosition != MenuPosition.Top)
        {
            <SideMenu MenuItems="@MenuItems" />
        }

        <div class="content-container">
            @ChildContent
        </div>
    </div>

    <AppDrawer @ref="appDrawer" />
</div>

@code {
    /// <summary>
    /// 应用名称
    /// </summary>
    [Parameter]
    public string AppName { get; set; } = "应用";

    /// <summary>
    /// 菜单列表（不传则不渲染菜单）
    /// </summary>
    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    /// <summary>
    /// 菜单位置（默认左侧）
    /// </summary>
    [Parameter]
    public MenuPosition MenuPosition { get; set; } = MenuPosition.Left;

    /// <summary>
    /// 登录Url（默认/account/login）
    /// </summary>
    [Parameter]
    public string LoginUrl { get; set; } = "/account/login";

    /// <summary>
    /// 退出登录回调（由外部处理）
    /// </summary>
    [Parameter]
    public EventCallback OnLogout { get; set; }

    /// <summary>
    /// 是否需要认证（默认 false，开启后组件内部处理登录态校验与跳转）
    /// </summary>
    [Parameter]
    public bool RequireAuthentication { get; set; }

    /// <summary>
    /// 用户名（RequireAuthentication=false 时由外部传入）
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = "用户";

    /// <summary>
    /// 是否已登录（RequireAuthentication=false 时由外部传入）
    /// </summary>
    [Parameter]
    public bool IsLoggedIn { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IServiceProvider ServiceProvider { get; set; } = default!;

    [Inject]
    private HttpClient HttpClient { get; set; } = default!;

    private bool _isLoggedIn;
    private string _userName = "用户";
    private AppDrawer? appDrawer;

    protected override async Task OnInitializedAsync()
    {
        if (!RequireAuthentication)
            return;

        // 服务端预渲染：通过 HttpContext 快速验证
        bool isAuthenticated = IsAuthenticatedViaHttpContext();

        if (!isAuthenticated && OperatingSystem.IsBrowser())
        {
            // WASM 环境：通过 API 验证 Cookie 认证状态
            var result = await CheckAuthViaApiAsync();
            isAuthenticated = result.authenticated;
            if (!string.IsNullOrEmpty(result.userName))
            {
                _userName = result.userName;
            }
        }
        else if (isAuthenticated)
        {
            // 服务端：从 HttpContext 获取用户名
            var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
            var name = httpContextAccessor?.HttpContext?.User?.Identity?.Name;
            if (!string.IsNullOrEmpty(name))
            {
                _userName = name;
            }
        }

        _isLoggedIn = isAuthenticated;

        if (!isAuthenticated)
        {
            var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
            NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}", forceLoad: true);
        }
    }

    private bool IsAuthenticatedViaHttpContext()
    {
        var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
        return httpContextAccessor?.HttpContext?.User?.Identity?.IsAuthenticated == true;
    }

    private async Task<(bool authenticated, string? userName)> CheckAuthViaApiAsync()
    {
        try
        {
            var response = await HttpClient.GetAsync("/api/app/account/current-user");
            if (!response.IsSuccessStatusCode)
                return (false, null);

            var content = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(content))
                return (false, null);

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            var root = doc.RootElement;

            // 检查 isAuthenticated 字段
            if (root.TryGetProperty("isAuthenticated", out var authProp) &&
                authProp.ValueKind == System.Text.Json.JsonValueKind.False)
            {
                return (false, null);
            }

            // 解析用户名
            var userName = root.TryGetProperty("userName", out var nameProp)
                ? nameProp.GetString()
                : null;
            return (true, userName);
        }
        catch
        {
            return (false, null);
        }
    }

    /// <summary>
    /// 切换应用抽屉
    /// </summary>
    private void ToggleAppDrawer()
    {
        appDrawer?.Toggle();
    }

    /// <summary>
    /// 处理退出登录（默认实现，可被外部覆盖）
    /// </summary>
    private async Task HandleLogout()
    {
        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }
        else
        {
            // 默认行为：跳转到账户登出端点
            NavigationManager.NavigateTo("/account/logout", forceLoad: true);
        }
    }
}
