@namespace H.AppDrawer.Components

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; }
.menu-container { display: flex; flex: 1; }
.content-container { flex: 1; overflow-y: auto; background-color: #f0f2f5; padding: 20px; }
</style>

<div class="layout-container">
    <TopNavbar 
        AppName="@AppName" 
        OnDrawerToggle="ToggleAppDrawer"
        UserName="@_userName"
        IsLoggedIn="@_isLoggedIn"
        LoginUrl="@LoginUrl"
        ProfileUrl="/account/profile"
        OnLogout="HandleLogout">
        @if (MenuPosition == MenuPosition.Top)
        {
            <TopMenu MenuItems="@MenuItems" />
        }
    </TopNavbar>

    <div class="menu-container">
        @if (MenuPosition != MenuPosition.Top)
        {
            <SideMenu MenuItems="@MenuItems" />
        }

        <div class="content-container">
            @ChildContent
        </div>
    </div>

    <AppDrawer @ref="appDrawer" />
</div>

@code {
    /// <summary>
    /// 应用名称
    /// </summary>
    [Parameter]
    public string AppName { get; set; } = "应用";

    /// <summary>
    /// 菜单列表（不传则不渲染菜单）
    /// </summary>
    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    /// <summary>
    /// 菜单位置（默认左侧）
    /// </summary>
    [Parameter]
    public MenuPosition MenuPosition { get; set; } = MenuPosition.Left;

    /// <summary>
    /// 登录Url（默认/account/login）
    /// </summary>
    [Parameter]
    public string LoginUrl { get; set; } = "/account/login";

    /// <summary>
    /// 退出登录回调（由外部处理）
    /// </summary>
    [Parameter]
    public EventCallback OnLogout { get; set; }

    /// <summary>
    /// 认证模式（None=不检测，Optional=检测但允许匿名，Required=强制登录）
    /// </summary>
    [Parameter]
    public AuthenticationMode AuthMode { get; set; } = AuthenticationMode.Required;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IServiceProvider ServiceProvider { get; set; } = default!;

    [Inject]
    private HttpClient HttpClient { get; set; } = default!;

    private bool _isLoggedIn;
    private string _userName = "用户";
    private AppDrawer? appDrawer;

    protected override async Task OnInitializedAsync()
    {
        if (AuthMode == AuthenticationMode.None)
            return;

        Console.WriteLine($"[DefaultLayout] OnInitializedAsync: AuthMode={AuthMode}, IsBrowser={OperatingSystem.IsBrowser()}");

        // 服务端预渲染：通过 HttpContext 快速验证
        bool isAuthenticated = IsAuthenticatedViaHttpContext();
        Console.WriteLine($"[DefaultLayout] HttpContext auth: {isAuthenticated}");

        if (!isAuthenticated && OperatingSystem.IsBrowser())
        {
            // WASM 环境：通过 API 验证 Cookie 认证状态
            var result = await CheckAuthViaApiAsync();
            Console.WriteLine($"[DefaultLayout] API auth: authenticated={result.authenticated}, userName={result.userName}");
            isAuthenticated = result.authenticated;
            if (!string.IsNullOrEmpty(result.userName))
            {
                _userName = result.userName;
            }
        }
        else if (isAuthenticated)
        {
            // 服务端：从 HttpContext 获取用户名
            var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
            var name = httpContextAccessor?.HttpContext?.User?.Identity?.Name;
            if (!string.IsNullOrEmpty(name))
            {
                _userName = name;
            }
        }

        _isLoggedIn = isAuthenticated;
        Console.WriteLine($"[DefaultLayout] Final: _isLoggedIn={_isLoggedIn}, _userName={_userName}");

        // 强制认证模式下，未登录跳转登录页
        if (AuthMode == AuthenticationMode.Required && !isAuthenticated)
        {
            var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
            NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}", forceLoad: true);
        }
    }

    private bool IsAuthenticatedViaHttpContext()
    {
        var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
        return httpContextAccessor?.HttpContext?.User?.Identity?.IsAuthenticated == true;
    }

    private async Task<(bool authenticated, string? userName)> CheckAuthViaApiAsync()
    {
        try
        {
            var response = await HttpClient.GetAsync("/api/app/account/current-user");
            if (!response.IsSuccessStatusCode)
                return (false, null);

            var content = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(content) || content == "null")
                return (false, null);

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            var root = doc.RootElement;

            // JSON null 表示未登录（ABP 返回 UserDto?）
            if (root.ValueKind == System.Text.Json.JsonValueKind.Null)
                return (false, null);

            // 格式1: 最小 API 格式 { isAuthenticated: bool, userName: string }
            if (root.TryGetProperty("isAuthenticated", out var authProp))
            {
                if (authProp.ValueKind == System.Text.Json.JsonValueKind.False)
                    return (false, null);
                var userName = root.TryGetProperty("userName", out var nameProp)
                    ? nameProp.GetString()
                    : null;
                return (true, userName);
            }

            // 格式2: ABP UserDto 格式 { id, userName, email, ... }
            var abpUserName = root.TryGetProperty("userName", out var abpNameProp)
                ? abpNameProp.GetString()
                : null;
            if (!string.IsNullOrEmpty(abpUserName))
                return (true, abpUserName);

            return (false, null);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DefaultLayout] CheckAuthViaApiAsync error: {ex.Message}");
            return (false, null);
        }
    }

    /// <summary>
    /// 切换应用抽屉
    /// </summary>
    private void ToggleAppDrawer()
    {
        appDrawer?.Toggle();
    }

    /// <summary>
    /// 处理退出登录（默认实现，可被外部覆盖）
    /// </summary>
    private async Task HandleLogout()
    {
        if (OnLogout.HasDelegate)
        {
            await OnLogout.InvokeAsync();
        }
        else
        {
            // 默认行为：跳转到账户登出端点
            NavigationManager.NavigateTo("/account/logout", forceLoad: true);
        }
    }
}
