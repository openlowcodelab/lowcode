@namespace H.AppDrawer.Components

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; }
.menu-container { display: flex; flex: 1; }
.content-container { flex: 1; overflow-y: auto; background-color: #f0f2f5; padding: 20px; }
</style>

<div class="layout-container">
    <TopNavbar 
        AppName="@AppName"
        Logo="@Logo"
        OnDrawerToggle="ToggleAppDrawer"
        UserName="@_userName"
        IsLoggedIn="@_isLoggedIn"
        LoginUrl="@LoginUrl"
        ProfileUrl="/account/profile"
        EnterpriseName="@_enterpriseName"
        OnLogout="HandleLogout">
        @if (MenuPosition == MenuPosition.Top)
        {
            <TopMenu MenuItems="@MenuItems" />
        }
    </TopNavbar>

    <div class="menu-container">
        @if (MenuPosition != MenuPosition.Top)
        {
            <SideMenu MenuItems="@MenuItems" />
        }

        <div class="content-container">
            @ChildContent
        </div>
    </div>

    <AppDrawer @ref="appDrawer" />
</div>

@code {
    /// <summary>
    /// 应用名称
    /// </summary>
    [Parameter]
    public string AppName { get; set; } = "应用";

    /// <summary>
    /// Logo 图片路径
    /// </summary>
    [Parameter]
    public string Logo { get; set; } = "/favicon.png";

    /// <summary>
    /// 菜单列表（不传则不渲染菜单）
    /// </summary>
    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    /// <summary>
    /// 菜单位置（默认左侧）
    /// </summary>
    [Parameter]
    public MenuPosition MenuPosition { get; set; } = MenuPosition.Left;

    /// <summary>
    /// 登录Url（默认/account/login）
    /// </summary>
    [Parameter]
    public string LoginUrl { get; set; } = "/account/login";

    /// <summary>
    /// 认证模式（None=不检测，Optional=检测但允许匿名，Required=强制登录，EnterpriseRequired=仅企业用户）
    /// </summary>
    [Parameter]
    public AuthenticationMode AuthMode { get; set; } = AuthenticationMode.Required;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IServiceProvider ServiceProvider { get; set; } = default!;

    [Inject]
    private HttpClient HttpClient { get; set; } = default!;

    private bool _isLoggedIn;
    private bool _authChecked;
    private string _userName = "用户";
    private string? _enterpriseName;
    private AppDrawer? appDrawer;

    /// <summary>
    /// 服务端预渲染时通过 HttpContext 快速验证认证状态（不阻塞 WASM 渲染）
    /// </summary>
    protected override void OnInitialized()
    {
        if (AuthMode == AuthenticationMode.None)
            return;

        // 仅服务端预渲染时通过 HttpContext 验证
        if (IsAuthenticatedViaHttpContext())
        {
            var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
            var user = httpContextAccessor?.HttpContext?.User;
            var name = user?.Identity?.Name;
            if (!string.IsNullOrEmpty(name))
                _userName = name;

            // 从 Claims 中读取当前企业信息
            _enterpriseName = user?.FindFirst("EnterpriseName")?.Value;

            _isLoggedIn = true;
            _authChecked = true;
        }
    }

    /// <summary>
    /// 首次渲染完成后异步检查认证状态（WASM 环境下通过 API 验证）
    /// 使用 OnAfterRenderAsync 而非 OnInitializedAsync，避免认证检查阻塞首次渲染导致白屏
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authChecked || AuthMode == AuthenticationMode.None)
            return;

        // WASM 环境：通过 API 验证 Cookie 认证状态
        if (OperatingSystem.IsBrowser())
        {
            var result = await CheckAuthViaApiAsync();
            _isLoggedIn = result.authenticated;
            if (!string.IsNullOrEmpty(result.userName))
            {
                _userName = result.userName;
            }

            // 如果服务端预渲染已设置 _enterpriseName，保留它
            // 否则从 Enterprise API 获取当前企业信息
            if (_isLoggedIn && string.IsNullOrEmpty(_enterpriseName))
            {
                _enterpriseName = await FetchCurrentEnterpriseNameAsync();
            }
        }

        _authChecked = true;

        var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);

        // 访问控制逻辑
        if (AuthMode == AuthenticationMode.EnterpriseRequired)
        {
            if (!_isLoggedIn)
            {
                NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}");
            }
        }
        else if (AuthMode == AuthenticationMode.Required && !_isLoggedIn)
        {
            // 强制认证模式下，未登录跳转登录页
            NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}");
        }
        // 已登录且没有企业 → 重定向到企业选择
        else if (_isLoggedIn && string.IsNullOrEmpty(_enterpriseName))
        {
            var currentPath = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath;
            if (!currentPath.StartsWith("/enterprise") && !currentPath.StartsWith("/account/"))
            {
                NavigationManager.NavigateTo("/enterprise/select", forceLoad: true);
            }
        }

        StateHasChanged();
    }

    private async Task<string?> FetchCurrentEnterpriseNameAsync()
    {
        try
        {
            var response = await HttpClient.GetAsync("/api/app/enterprise/current-enterprise");
            if (!response.IsSuccessStatusCode)
                return null;

            var content = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(content) || content == "null")
                return null;

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            if (doc.RootElement.TryGetProperty("name", out var nameProp))
                return nameProp.GetString();

            return null;
        }
        catch
        {
            return null;
        }
    }

    private bool IsAuthenticatedViaHttpContext()
    {
        var httpContextAccessor = ServiceProvider.GetService<IHttpContextAccessor>();
        return httpContextAccessor?.HttpContext?.User?.Identity?.IsAuthenticated == true;
    }

    private async Task<(bool authenticated, string? userName)> CheckAuthViaApiAsync()
    {
        try
        {
            var response = await HttpClient.GetAsync("/api/app/account/current-user");
            if (!response.IsSuccessStatusCode)
                return (false, null);

            var content = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(content) || content == "null")
                return (false, null);

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            var root = doc.RootElement;

            // JSON null 表示未登录（ABP 返回 UserDto?）
            if (root.ValueKind == System.Text.Json.JsonValueKind.Null)
                return (false, null);

            // 格式1: 最小 API 格式 { isAuthenticated: bool, userName: string }
            if (root.TryGetProperty("isAuthenticated", out var authProp))
            {
                if (authProp.ValueKind == System.Text.Json.JsonValueKind.False)
                    return (false, null);
                var userName = root.TryGetProperty("userName", out var nameProp)
                    ? nameProp.GetString()
                    : null;
                return (true, userName);
            }

            // 格式2: ABP UserDto 格式 { id, userName, email, ... }
            var abpUserName = root.TryGetProperty("userName", out var abpNameProp)
                ? abpNameProp.GetString()
                : null;
            if (!string.IsNullOrEmpty(abpUserName))
                return (true, abpUserName);

            return (false, null);
        }
        catch
        {
            return (false, null);
        }
    }

    /// <summary>
    /// 切换应用抽屉
    /// </summary>
    private void ToggleAppDrawer()
    {
        appDrawer?.Toggle();
    }

    /// <summary>
    /// 处理退出登录
    /// </summary>
    private async Task HandleLogout()
    {
        NavigationManager.NavigateTo("/account/logout", forceLoad: true);
    }
}
