@namespace H.LowCode.Components

<div class="hc-select-wrapper" style="@Style">
    <div class="hc-select @(Disabled ? "hc-select-disabled" : "") @(_isOpen ? "hc-select-open" : "")" @onclick="ToggleOpen">
        <span class="hc-select-value">@(!string.IsNullOrEmpty(_displayValue) ? _displayValue : Placeholder)</span>
        <span class="hc-select-arrow">▼</span>
        @if (AllowClear && !string.IsNullOrEmpty(_displayValue))
        {
            <span class="hc-select-clear" @onclick:stopPropagation="true" @onclick="ClearSelection">×</span>
        }
    </div>
    @if (_isOpen)
    {
        <div class="hc-select-dropdown">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                <div class="hc-select-empty">暂无选项</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "请选择";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool ShowSearch { get; set; }
    [Parameter] public string Mode { get; set; } = "single";
    [Parameter] public bool Bordered { get; set; } = true;
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Style { get; set; }

    private bool _isOpen;
    private string _displayValue;

    protected override void OnParametersSet()
    {
        _displayValue = Value;
    }

    private void ToggleOpen()
    {
        if (!Disabled)
        {
            _isOpen = !_isOpen;
        }
    }

    private async Task ClearSelection()
    {
        _displayValue = "";
        _isOpen = false;
        await ValueChanged.InvokeAsync("");
    }
}
