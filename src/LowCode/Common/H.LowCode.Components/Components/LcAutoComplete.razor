@namespace H.LowCode.Components

<div class="hc-select-wrapper" style="@Style">
    <div class="hc-input-wrapper">
        <input class="hc-input @(Disabled ? "hc-input-disabled" : "")"
               type="text"
               placeholder="@Placeholder"
               disabled="@Disabled"
               value="@_value"
               @oninput="OnInputHandler"
               @onfocus="OpenDropdown"
               @onblur="CloseDropdownDelayed" />
    </div>
    @if (_isOpen)
    {
        <div class="hc-select-dropdown">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                <div class="hc-select-empty">暂无选项</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "请输入";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool BackfillOnSelect { get; set; } = true;
    [Parameter] public string Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Style { get; set; }

    private bool _isOpen;
    private string _value;

    protected override void OnParametersSet()
    {
        _value = Value ?? "";
    }

    private async Task OnInputHandler(ChangeEventArgs e)
    {
        _value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(_value);
    }

    private void OpenDropdown()
    {
        if (!Disabled) _isOpen = true;
    }

    private async Task CloseDropdownDelayed()
    {
        await Task.Delay(200);
        _isOpen = false;
    }
}
