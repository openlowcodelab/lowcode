@namespace H.LowCode.Components.Defaults

<div class="hc-placeholder" style="@Style">
    <div class="hc-placeholder-content">
        <span class="hc-placeholder-icon">⬚</span>
        <span class="hc-placeholder-label">树组件</span>
    </div>
    @ChildContent
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowIcon { get; set; }
    [Parameter] public bool Checkable { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool DefaultExpandAll { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public bool BlockNode { get; set; }
    [Parameter] public string Style { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }
}
