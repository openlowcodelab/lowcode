@namespace H.LowCode.Components.Defaults

<button class="hc-btn hc-btn-@Type.ToLower()" disabled="@Disabled" @onclick="OnClickHandler" style="@Style">
    @if (Loading)
    {
        <span class="hc-btn-loading"></span>
    }
    <span class="hc-btn-text">@Text</span>
    @ChildContent
</button>

@code {
    [Parameter] public string Text { get; set; } = "按钮";
    [Parameter] public string Type { get; set; } = "default";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Style { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private async Task OnClickHandler(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (!Disabled && !Loading)
        {
            await OnClick.InvokeAsync(args);
        }
    }
}
