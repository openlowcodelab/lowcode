@namespace H.LowCode.Components.Defaults

<CascadingValue Value="this" IsFixed="true">
    <div class="hc-radio-group @(Direction == "vertical" ? "hc-radio-vertical" : "hc-radio-horizontal")" style="@Style">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <span class="hc-radio-empty">暂无选项</span>
        }
    </div>
</CascadingValue>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Direction { get; set; } = "horizontal";
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Style { get; set; }

    /// <summary>
    /// 选中值
    /// </summary>
    [Parameter] public object Value { get; set; }
    [Parameter] public EventCallback<object> ValueChanged { get; set; }

    /// <summary>
    /// 判断选项是否选中
    /// </summary>
    internal bool IsSelected(object optionValue)
    {
        return string.Equals(Value?.ToString(), optionValue?.ToString(), StringComparison.Ordinal);
    }

    /// <summary>
    /// 选项选中
    /// </summary>
    internal async Task SelectOptionAsync(object optionValue)
    {
        if (Disabled)
            return;

        Value = optionValue;
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
}
