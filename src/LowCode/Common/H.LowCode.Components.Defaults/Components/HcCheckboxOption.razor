@namespace H.LowCode.Components.Defaults

<label class="hc-checkbox-option @(IsDisabled ? "hc-checkbox-option-disabled" : "")">
    <input type="checkbox" disabled="@IsDisabled" checked="@IsChecked" @onchange="OnChangedHandler" />
    <span class="hc-checkbox-option-label">@ChildContent</span>
</label>

@code {
    [CascadingParameter] public HcCheckbox Group { get; set; }

    [Parameter] public object Value { get; set; }
    [Parameter] public object Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private bool IsDisabled => Disabled || (Group?.Disabled ?? false);

    private bool IsChecked => Group?.IsChecked(Value) ?? false;

    private async Task OnChangedHandler()
    {
        if (Group != null)
            await Group.ToggleOptionAsync(Value);
    }
}
