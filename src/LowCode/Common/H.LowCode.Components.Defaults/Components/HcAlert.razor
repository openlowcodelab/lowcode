@namespace H.LowCode.Components.Defaults

<div class="hc-alert hc-alert-@Type" style="@Style">
    @if (ShowIcon)
    {
        <span class="hc-alert-icon">@GetIcon()</span>
    }
    <div class="hc-alert-content">
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="hc-alert-message">@Message</div>
        }
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="hc-alert-description">@Description</div>
        }
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = "提示信息";
    [Parameter] public string Description { get; set; }
    [Parameter] public string Type { get; set; } = "info";
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public string Style { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string GetIcon() => Type switch
    {
        "success" => "✓",
        "warning" => "!",
        "error" => "✕",
        _ => "i"
    };
}
