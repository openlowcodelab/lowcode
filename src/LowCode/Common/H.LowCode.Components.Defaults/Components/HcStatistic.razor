@namespace H.LowCode.Components.Defaults

<div class="hc-statistic" style="@Style">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="hc-statistic-title">@Title</div>
    }
    <div class="hc-statistic-content">
        @if (!string.IsNullOrEmpty(Prefix))
        {
            <span class="hc-statistic-prefix">@Prefix</span>
        }
        <span class="hc-statistic-value" style="@(string.IsNullOrEmpty(ValueColor) ? "" : $"color:{ValueColor}")">@Value</span>
        @if (!string.IsNullOrEmpty(Suffix))
        {
            <span class="hc-statistic-suffix">@Suffix</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "统计项";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Prefix { get; set; }
    [Parameter] public string Suffix { get; set; }
    [Parameter] public string ValueColor { get; set; }
    [Parameter] public string Style { get; set; }
}
