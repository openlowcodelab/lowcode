@namespace H.LowCode.Components.Defaults

<button class="hc-switch @(_checked ? "hc-switch-checked" : "") @(Disabled ? "hc-switch-disabled" : "") @(Size == "small" ? "hc-switch-small" : "")"
        disabled="@Disabled"
        @onclick="ToggleSwitch"
        style="@Style">
    <span class="hc-switch-handle">
        @if (Loading)
        {
            <span class="hc-switch-loading"></span>
        }
    </span>
    <span class="hc-switch-inner">
        @if (_checked && !string.IsNullOrEmpty(CheckedChildren))
        {
            @CheckedChildren
        }
        else if (!_checked && !string.IsNullOrEmpty(UnCheckedChildren))
        {
            @UnCheckedChildren
        }
    </span>
</button>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string CheckedChildren { get; set; }
    [Parameter] public string UnCheckedChildren { get; set; }
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Style { get; set; }

    private bool _checked;

    protected override void OnParametersSet()
    {
        _checked = Value;
    }

    private async Task ToggleSwitch()
    {
        if (!Disabled && !Loading)
        {
            _checked = !_checked;
            await ValueChanged.InvokeAsync(_checked);
        }
    }
}
