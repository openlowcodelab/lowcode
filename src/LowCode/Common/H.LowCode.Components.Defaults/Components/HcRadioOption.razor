@namespace H.LowCode.Components.Defaults

<label class="hc-radio-option @(IsDisabled ? "hc-radio-option-disabled" : "")">
    <input type="radio" disabled="@IsDisabled" checked="@IsChecked" @onchange="OnChangedHandler" />
    <span class="hc-radio-option-label">@ChildContent</span>
</label>

@code {
    [CascadingParameter] public HcRadio Group { get; set; }

    [Parameter] public object Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private bool IsDisabled => Disabled || (Group?.Disabled ?? false);

    private bool IsChecked => Group?.IsSelected(Value) ?? false;

    private async Task OnChangedHandler()
    {
        if (Group != null)
            await Group.SelectOptionAsync(Value);
    }
}
