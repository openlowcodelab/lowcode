@namespace H.LowCode.Components.Defaults

@if (string.IsNullOrEmpty(Text))
{
    <div class="hc-divider @(Vertical ? "hc-divider-vertical" : "hc-divider-horizontal")" style="@Style"></div>
}
else
{
    <div class="hc-divider hc-divider-horizontal hc-divider-with-text hc-divider-@Orientation" style="@Style">
        <span class="hc-divider-text">@Text</span>
    </div>
}

@code {
    [Parameter] public string Text { get; set; }
    [Parameter] public string Orientation { get; set; } = "left";
    [Parameter] public bool Vertical { get; set; }
    [Parameter] public string Style { get; set; }
}
