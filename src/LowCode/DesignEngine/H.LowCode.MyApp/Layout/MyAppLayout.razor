@namespace H.LowCode.MyApp
@inherits LowCodeLayoutComponentBase

@inject IAppApplicationService AppApplicationService

<link href="@Assets["_content/H.LowCode.MyApp/myapp.css"]" rel="stylesheet" />

@if (_appSchema != null)
{
    <CascadingValue Value="@_appSchema" Name="appCascading">
        <DefaultLayoutComponent AppName="@_appSchema.Name" Logo="_content/H.LowCode.MyApp/logo.png"
            MenuItems="@_menuItems" AuthMode="AuthenticationMode.None">
            @Body
        </DefaultLayoutComponent>
        <SettingDrawer />
    </CascadingValue>
}

@code
{
    [PersistentState]
    public AppPartsSchema _appSchema { get; set; }
    [PersistentState]
    public List<AppMenuItem> _menuItems { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _appSchema = await GetAppSchemaAsync(AppId);

        _menuItems = InitMenuData(AppId);
    }

    private async Task<AppPartsSchema> GetAppSchemaAsync(string appId)
    {
        return await AppApplicationService.GetByIdAsync(appId);
    }

    private List<AppMenuItem> InitMenuData(string appId)
    {
        return [
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/pagemanager",
                Name = "页面管理",
                Icon = "profile",
                Key = "page"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/menumanager",
                Name = "菜单管理",
                Icon = "menu",
                Key = "menu"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/datasource",
                Name = "数据源",
                Icon = "database",
                Key = "datasource"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/integration",
                Name = "集成",
                Icon = "api",
                Key = "integration"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/autoflow",
                Name = "自动化",
                Icon = "tool",
                Key = "autoflow"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/members",
                Name = "成员权限",
                Icon = "team",
                Key = "members"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/publish",
                Name = "应用发布",
                Icon = "cloud-upload",
                Key = "publish"
            },
            new AppMenuItem
            {
                Url = $"/designengine/myapp/{appId}/appsettings",
                Name = "应用设置",
                Icon = "setting",
                Key = "appsettings"
            }
        ];
    }
}