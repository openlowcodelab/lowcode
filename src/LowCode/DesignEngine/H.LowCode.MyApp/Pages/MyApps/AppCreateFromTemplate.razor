@namespace H.LowCode.MyApp
@inherits LowCodeComponentBase
@layout MyAppLayout

@inject IAppApplicationService AppApplicationService

<div style="width:100%; height: 500px; margin:auto;">
    <h3>基础创建</h3>
    <HCard Style="width:300px; margin:5px;">
        <a href="javascript:void(0)" @onclick='() => { _visible = true; }'>创建空白应用</a>
    </HCard>
    <br/>
    <h3>从模板创建</h3>
    <AppPopularTemplates OnUsed="Submit"></AppPopularTemplates>
</div>

<HModal Title="创建应用" Visible="@_visible" OnOk="OnConfirm" OnCancel='() => _visible = false'>
    <AppForm OnSubmit="Submit" @ref="@_appForm"></AppForm>
</HModal>

@code {
    [Parameter]
    public Action OnSubmit { get; set; }

    private bool _visible = false;
    private AppForm _appForm;

    private async Task OnConfirm()
    {
        _visible = true;
        await _appForm.SubmitAsync();
    }

    private void Submit()
    {
        _visible = false;
        StateHasChanged();

        if (OnSubmit != null)
            OnSubmit();
    }
}