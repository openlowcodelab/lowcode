@namespace H.LowCode.MyApp
@inherits LowCodeComponentBase

@inject IDataSourceAppService DataSourceAppService

<div style="display: flex; justify-content: space-between; margin: 0 0 8px 0;">
    <div style="width:250px;">
        <input type="search" class="inp" placeholder="表名、表中文名" />
    </div>
    <div style="width:80px; line-height:32px; margin: 0 22px 0 0;">
        <button class="btn btn-primary" @onclick="CreateAsync">新建数据表</button>
    </div>
</div>
<table class="data-table">
    <thead>
        <tr>
            <th>名称</th>
            <th>中文名</th>
            <th>修改人</th>
            <th>修改时间</th>
            <th>发布状态</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in _dataSourceList)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.DisplayName</td>
                <td>@item.ModifiedUser</td>
                <td>@item.ModifiedTime?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    <label class="switch">
                        <input type="checkbox" checked="@item.PublishStatus" @onchange='(e) => item.PublishStatus = (bool)(e.Value ?? false)' />
                        <span class="slider"></span>
                    </label>
                </td>
                <td>
                    <div class="row-actions">
                        <a @onclick='() => EditAsync(item.Id)'>编辑</a>
                        <a @onclick='() => DeleteAsync(item.Id)' class="danger">删除</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<HModal Title="@_modalTitle" Visible="@_visible" OnOk="OnConfirmAsync" OnCancel='() => _visible = false' Style="width:1100px;">
    <table class="descriptions" style="margin: 0 0 8px 0;">
        <tr>
            <th>表名</th>
            <td>
                <input class="inp" @bind="_dataSource.Name" disabled="@(!string.IsNullOrEmpty(_dataSource.Name))" />
            </td>
        </tr>
        <tr>
            <th>表中文名</th>
            <td colspan="2">
                <input class="inp" @bind="_dataSource.DisplayName" />
            </td>
        </tr>
        <tr>
            <th>描述</th>
            <td colspan="3">
                <textarea class="ta" @bind="_dataSource.Description" rows="2"></textarea>
            </td>
        </tr>
    </table>

    <div style="display: flex; justify-content: space-between; margin: 0 0 8px 0;">
        <div style="width:250px;">
            <input type="search" class="inp" placeholder="字段名" />
        </div>
        <div style="width:80px; line-height:32px; margin: 0 22px 0 0;">
            <button class="btn btn-primary" @onclick="CreateFieldAsync">新增字段</button>
        </div>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>字段名</th>
                <th>字段中文名</th>
                <th>字段类型</th>
                <th>是否主键</th>
                <th>是否唯一</th>
                <th>是否可空</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var field in _dataSource.TableFields)
            {
                <tr>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @field.Name
                        }
                        else
                        {
                            <input class="inp" @bind="_fieldEditCache[field.Id].field.Name" />
                        }
                    </td>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @field.DisplayName
                        }
                        else
                        {
                            <input class="inp" @bind="_fieldEditCache[field.Id].field.DisplayName" />
                        }
                    </td>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @field.Type
                        }
                        else
                        {
                            <input class="inp" @bind="_fieldEditCache[field.Id].field.Type" />
                        }
                    </td>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @if (field.IsPrimaryKey)
                            {
                                <span style="color:#F53F3F;">是</span>
                            }
                            else
                            {
                                <span>否</span>
                            }
                        }
                        else
                        {
                            <label class="chk-label"><input type="checkbox" checked="@_fieldEditCache[field.Id].field.IsPrimaryKey" @onchange='(e) => _fieldEditCache[field.Id].field.IsPrimaryKey = (bool)(e.Value ?? false)' /></label>
                        }
                    </td>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @if(field.IsUnique)
                            {
                                <span style="color:#F53F3F;">是</span>
                            }
                            else
                            {
                                <span>否</span>
                            }
                        }
                        else
                        {
                            <label class="chk-label"><input type="checkbox" checked="@_fieldEditCache[field.Id].field.IsUnique" @onchange='(e) => _fieldEditCache[field.Id].field.IsUnique = (bool)(e.Value ?? false)' /></label>
                        }
                    </td>
                    <td>
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            @if (field.IsNullable)
                            {
                                <span>是</span>
                            }
                            else
                            {
                                <span style="color:#F53F3F;">否</span>
                            }
                        }
                        else
                        {
                            <label class="chk-label"><input type="checkbox" checked="@_fieldEditCache[field.Id].field.IsNullable" @onchange='(e) => _fieldEditCache[field.Id].field.IsNullable = (bool)(e.Value ?? false)' /></label>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                        @if (!_fieldEditCache[field.Id].edit)
                        {
                            <a @onclick='() => FieldStartEdit(field.Id)'>编辑</a>
                            <a @onclick='() => DeleteFieldAsync(field.Id)' class="danger">删除</a>
                        }
                        else
                        {
                            <a @onclick='() => SaveFieldAsync(field.Id)' class="save">保存</a>
                            <a @onclick='() => FieldCancelEditAsync(field.Id)'>取消</a>
                        }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</HModal>

@code {
    [Parameter]
    public string AppId { get; set; }

    [PersistentState]
    public IList<DataSourceListModel> _dataSourceList { get; set; }

    IDictionary<string, (bool edit, TableFieldSchema field)> _fieldEditCache = new Dictionary<string, (bool edit, TableFieldSchema field)>();

    private DataSourceSchema _dataSource;

    int _pageIndex = 1;
    int _pageSize = 10;
    int _total = 0;

    private bool _visible;
    private string _modalTitle;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _total = 50;
        _dataSourceList = await LoadDataSourcesAsync(1, 50);
    }

    private async Task<IList<DataSourceListModel>> LoadDataSourcesAsync(int pageIndex, int pageSize)
    {
        return (await DataSourceAppService.GetListAsync(AppId, new() { DataSourceType = ComponentDataSourceTypeEnum.DB })).Data;
    }

    private async Task<DataSourceSchema> GetDataSourceAsync(string dataSourceId)
    {
        var dataSourceSchema = (await DataSourceAppService.GetByIdAsync(AppId, dataSourceId)).Data!;

        //初始化缓存
        foreach (var item in dataSourceSchema.TableFields)
        {
            _fieldEditCache[item.Id] = (false, item);
        }

        return dataSourceSchema;
    }

    private async Task OnConfirmAsync()
    {
        // var validate = _form.Validate();
        // if (validate)
        // {
        var isSuccess = await SaveDataSourceSchemaAsync();
        if (isSuccess)
        {
            _visible = false;
            //_form.Submit();
            Toast.Success("保存成功");
            //_form.Reset();

            //StateHasChanged();
        }
        else
        {
            _visible = true;
            Toast.Error($"保存失败");
        }
        // }
        // else
        // {
        //     _visible = true;
        // }
    }

    private async Task OnFinishAsync()
    {
        _dataSourceList = await LoadDataSourcesAsync(1, 50);
    }

    private async Task<bool> SaveDataSourceSchemaAsync()
    {
        //过滤空字段
        _dataSource.TableFields = _dataSource.TableFields
            .Where(t => !string.IsNullOrEmpty(t.Name) && !string.IsNullOrEmpty(t.DisplayName))
            .ToList();

        return (await DataSourceAppService.SaveAsync(AppId, _dataSource)).Data == true;
    }

    private async Task CreateAsync()
    {
        await Task.Delay(1);
        _dataSource = new()
            {
                AppId = AppId,
                Id = ShortIdGenerator.Generate(),
                Name = string.Empty,
                DataSourceType = ComponentDataSourceTypeEnum.DB
            };
        _visible = true;
        _modalTitle = "新建数据表";

        StateHasChanged();
    }

    private async Task EditAsync(string id)
    {
        _visible = true;
        _modalTitle = "编辑数据表";
        _dataSource = await GetDataSourceAsync(id);

        StateHasChanged();
    }

    private async Task DeleteAsync(string id)
    {
        await DataSourceAppService.DeleteAsync(AppId, id);

        Toast.Success("删除成功！");
    }

    private async Task PublishAsync(string id)
    {
        await Task.Delay(1);
    }

    private async Task CreateFieldAsync()
    {
        await Task.Delay(1);

        TableFieldSchema newField = new() { Id = ShortIdGenerator.Generate(), IsNullable = true };

        //添加编辑缓存
        _fieldEditCache[newField.Id] = (true, newField);

        _dataSource.TableFields.Add(newField);

        //StateHasChanged();
    }

    private async Task SaveFieldAsync(string id)
    {
        await Task.Delay(1);
        var index = _dataSource.TableFields.ToList().FindIndex(item => item.Id == id);
        _dataSource.TableFields[index] = _fieldEditCache[id].field; // apply the copy to data source
        _fieldEditCache[id] = (false, _dataSource.TableFields[index]); // don't affect rows in editing

        StateHasChanged();
    }

    private async Task DeleteFieldAsync(string id)
    {
        await Task.Delay(1);

    }

    private async Task FieldStartEdit(string id)
    {
        await Task.Delay(1);
        var data = _fieldEditCache[id];
        _fieldEditCache[id] = (true, data.field with { }); // add a copy in cache

        StateHasChanged();
    }

    private async Task FieldCancelEditAsync(string id)
    {
        await Task.Delay(1);
        var data = _dataSource.TableFields.FirstOrDefault(item => item.Id == id);
        _fieldEditCache[id] = (false, data); // recovery

        StateHasChanged();
    }
}
