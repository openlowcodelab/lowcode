@page "/designengine/myapp/{AppId}/datasource/{DataSourceType?}"
@namespace H.LowCode.MyApp
@inherits LowCodePageComponentBase
@layout MyAppLayout

<PageTitle>数据源管理 - 我的应用</PageTitle>

<div class="tabs-header">
    <button class="tab-btn @(DataSourceType == "table" ? "active" : "")" @onclick='() => OnTabChange("table")'>数据表</button>
    <button class="tab-btn @(DataSourceType == "api" ? "active" : "")" @onclick='() => OnTabChange("api")'>API</button>
    <button class="tab-btn @(DataSourceType == "option" ? "active" : "")" @onclick='() => OnTabChange("option")'>选项</button>
</div>
<div class="tab-content">
    @if (DataSourceType == "table")
    {
        <TableDataSourceList AppId="@AppId"></TableDataSourceList>
    }
    else if (DataSourceType == "api")
    {
        <APIDataSourceList AppId="@AppId"></APIDataSourceList>
    }
    else if (DataSourceType == "option")
    {
        <OptionDataSourceList AppId="@AppId"></OptionDataSourceList>
    }
</div>

@code {
    [Parameter]
    public string DataSourceType { get; set; } = "table";

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(DataSourceType))
            DataSourceType = "table";
    }

    private void OnTabChange(string key)
    {
        base.NavigateTo($"/designengine/myapp/{AppId}/datasource/{key}");
    }
}