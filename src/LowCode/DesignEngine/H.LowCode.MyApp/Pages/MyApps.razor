@page "/designengine/myapps"
@namespace H.LowCode.MyApp
@inherits LowCodePageComponentBase
@layout WorkbenchNavLayout

@inject IAppApplicationService AppApplicationService
@inject IAppTemplateAppService AppTemplateAppService

<PageTitle>我的应用 - H.LowCode</PageTitle>

<style>
    .myapps-banner {
        margin: -20px -20px 0 -20px;
        padding: 28px 0;
        background: linear-gradient(120deg, #165DFF 0%, #5b8def 55%, #7c5cfc 100%);
        color: #fff;
    }
    .myapps-banner-inner { width: 80%; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
    .myapps-banner-title { font-size: 22px; font-weight: 600; margin: 0; }
    .myapps-banner-sub { font-size: 13px; opacity: 0.85; margin-top: 6px; }
    .myapps-banner .btn-create { background: #fff; color: #165DFF; border: none; font-weight: 600; height: 38px; padding: 0 22px; border-radius: 8px; }
    .myapps-banner .btn-create:hover { background: #f0f4ff; color: #4080FF; }

    .myapp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .myapp-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--h-border-light); }
</style>

<div class="myapps-banner">
    <div class="myapps-banner-inner">
        <div>
            <div class="myapps-banner-title">你好，欢迎回来</div>
            <div class="myapps-banner-sub">从这里开始创建与管理你的低代码应用</div>
        </div>
        <button class="btn btn-create" @onclick="CreateApp">+ 创建应用</button>
    </div>
</div>

<div class="page-container" style="padding: 20px 0;">
    <div class="toolbar">
        <div class="toolbar-left">
            <div style="width: 220px;">
                <input type="search" class="inp" placeholder="搜索应用名称" />
            </div>
        </div>
        <div class="toolbar-right">
            <select class="sel" style="width:120px">
                <option value="all">全部状态</option>
                <option value="published">已发布</option>
                <option value="unpublished">未发布</option>
            </select>
        </div>
    </div>

    @if (_appList != null)
    {
        <div class="myapp-grid">
            @foreach (var app in _appList)
            {
                <div class="card card-hoverable">
                    <a class="card-title" href="@($"/designengine/myapp/{app.Id}/pagemanager")" target="_blank">@app.Name</a>
                    <div class="card-desc">@app.Description</div>
                    <div class="myapp-card-footer">
                        <span class="tag @(app.PublishStatus == PublishStatusEnum.Published ? "tag-green" : "tag-gold")">
                            @(app.PublishStatus == PublishStatusEnum.Published ? "已发布" : "开发中")
                        </span>
                        <div class="actions">
                            <a class="icon-btn" href="@($"/designengine/myapp/{app.Id}/pagemanager")" title="开发应用" target="_blank">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                            </a>
                            <a class="icon-btn" href="@(string.IsNullOrEmpty(app.SiteUrl) ? "#" : $"{app.SiteUrl}/app/{app.Id}/index")" title="访问应用" target="_blank">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            </a>
                            <button class="icon-btn" @onclick='() => EditApp(app.Id)' title="编辑">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="icon-btn" @onclick='() => ShowSaveAsTemplate(app.Id, app.Name)' title="另存为模板">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            </button>
                            <a class="icon-btn" href="@($"/designengine/myapp/{app.Id}/appsettings")" title="应用设置" target="_blank">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<HModal Title="创建应用" Visible="@_createVisible" Style="width:1100px;" OnCancel='() => _createVisible = false'>
    <AppCreateFromTemplate OnSubmit="ReloadApps"></AppCreateFromTemplate>
</HModal>

<HModal Title="编辑应用" Visible="@_editVisible" OnOk="OnConfirm" OnCancel='() => _editVisible = false'>
    <AppForm AppSchema="_currentApp" OnSubmit="ReloadApps" @ref="@_appForm"></AppForm>
</HModal>

<HModal Title="另存为应用模板" Visible="@_saveTemplateVisible" OnOk="OnSaveTemplateConfirm" OnCancel='() => _saveTemplateVisible = false'>
    <div style="padding: 8px 16px;">
        <div style="margin-bottom: 16px;">
            <label style="display:block; margin-bottom:4px; font-weight:500;"><span style="color:red;">*</span> 模板名称</label>
            <input class="inp" @bind="_templateName" placeholder="请输入模板名称" />
        </div>
        <div style="margin-bottom: 16px;">
            <label style="display:block; margin-bottom:4px; font-weight:500;">模板描述</label>
            <textarea class="ta" rows="3" @bind="_templateDescription" placeholder="请输入模板描述"></textarea>
        </div>
    </div>
</HModal>

@code {
    [PersistentState]
    public IList<AppListModel> _appList { get; set; }

    private AppPartsSchema _currentApp;

    private bool _createVisible = false;
    private bool _editVisible = false;
    private AppForm _appForm;

    private bool _saveTemplateVisible = false;
    private string _templateSourceAppId = "";
    private string _templateName = "";
    private string _templateDescription = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _appList = await LoadAppsAsync();
    }

    private async Task<IList<AppListModel>> LoadAppsAsync()
    {
        return (await AppApplicationService.GetAppsAsync()).Data ?? [];
    }

    private async Task OnConfirm()
    {
        await _appForm.SubmitAsync();
    }

    private async void ReloadApps()
    {
        _createVisible = false;
        _editVisible = false;
        _appList = await LoadAppsAsync();

        StateHasChanged();
    }

    private void CreateApp()
    {
        _currentApp = new()
        {
            Id = ShortIdGenerator.Generate()
        };
        _createVisible = true;
        StateHasChanged();
    }

    private async Task EditApp(string id)
    {
        _currentApp = (await AppApplicationService.GetByIdAsync(id)).Data!;
        _editVisible = true;
        StateHasChanged();
    }

    private void ShowSaveAsTemplate(string appId, string appName)
    {
        _templateSourceAppId = appId;
        _templateName = $"{appName}-模板";
        _templateDescription = string.Empty;
        _saveTemplateVisible = true;
        StateHasChanged();
    }

    private async Task OnSaveTemplateConfirm()
    {
        if (string.IsNullOrWhiteSpace(_templateName))
        {
            Toast.Error("请输入模板名称");
            return;
        }

        try
        {
            await AppTemplateAppService.SaveFromAppAsync(_templateSourceAppId, _templateName, _templateDescription);
            _saveTemplateVisible = false;
            Toast.Success("已保存为应用模板！可在\"我的物料-应用模板\"中查看");
        }
        catch (Exception ex)
        {
            Toast.Error($"保存模板失败：{ex.Message}");
        }
    }
}