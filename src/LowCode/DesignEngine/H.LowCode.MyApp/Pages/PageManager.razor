@page "/designengine/myapp/{AppId}/pagemanager"
@namespace H.LowCode.MyApp
@inherits LowCodePageComponentBase
@layout MyAppLayout

@inject IPageAppService PageAppService
@inject IPageTemplateAppService PageTemplateAppService

<PageTitle>页面管理</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-header-title">页面管理</h2>
        <div class="page-header-subtitle">管理应用内的所有页面，支持表单、列表、报表等类型</div>
    </div>
    <button class="btn btn-primary" @onclick='() => CreateAsync(string.Empty)'>+ 新建页面</button>
</div>

<div class="toolbar">
    <div class="toolbar-left">
        <div style="width:250px;">
            <input type="search" class="inp" placeholder="搜索页面名称" />
        </div>
    </div>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>页面名称</th>
            <th>排序</th>
            <th>类型</th>
            <th>修改时间</th>
            <th>发布状态</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in _pageList)
        {
            <tr>
                <td>@item.PageId</td>
                <td>@item.PageName</td>
                <td>@item.Order</td>
                <td>@item.PageType</td>
                <td>@item.ModifiedTime?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    <span class="tag @(item.PublishStatus == 1 ? "tag-green" : "tag-gold")">
                        @(item.PublishStatus == 1 ? "已发布" : "待发布")
                    </span>
                </td>
                <td>
                    <div class="space">
                        <a class="btn btn-sm" href="@($"/designengine/designer/{AppId}/{item.PageId}")" target="_blank">设计</a>
                        <button class="btn btn-sm btn-text" @onclick='() => EditAsync(item.PageId)'>编辑</button>
                        <button class="btn btn-sm btn-text btn-danger" @onclick='() => DeleteAsync(item.PageId)'>删除</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<HModal Title="新建页面" Visible="@_visible" OnOk="OnConfirmAsync" OnCancel='() => _visible = false'>
    <form>
        @if (_isNew)
        {
            <div class="form-item">
                <label>创建方式</label>
                <div class="radio-group">
                    <label class="radio-label"><input type="radio" name="create-mode" checked='@(_createMode == "blank")' @onchange='() => _createMode = "blank"' /> 空白页面</label>
                    <label class="radio-label"><input type="radio" name="create-mode" checked='@(_createMode == "template")' @onchange='() => _createMode = "template"' /> 从模板新建</label>
                </div>
            </div>
            @if (_createMode == "template")
            {
                <div class="form-item">
                    <label>选择模板</label>
                    <select class="sel" @bind="_selectedTemplateId">
                        <option value="">请选择页面模板</option>
                        @foreach (var tpl in _templates)
                        {
                            <option value="@tpl.TemplateId">@tpl.Name</option>
                        }
                    </select>
                </div>
            }
        }
        <div class="form-item">
            <label>页面名称</label>
            <input class="inp" @bind="_pageSchema.Name" />
        </div>
        <div class="form-item">
            <label>类型</label>
            <div class="radio-group">
    <label class="radio-label"><input type="radio" name="page-type" checked='@(_pageSchema.PageType == PageTypeEnum.Normal)' @onchange='() => _pageSchema.PageType = PageTypeEnum.Normal' /> 普通</label>
    <label class="radio-label"><input type="radio" name="page-type" checked='@(_pageSchema.PageType == PageTypeEnum.Form)' @onchange='() => _pageSchema.PageType = PageTypeEnum.Form' /> 表单</label>
    <label class="radio-label"><input type="radio" name="page-type" checked='@(_pageSchema.PageType == PageTypeEnum.Table)' @onchange='() => _pageSchema.PageType = PageTypeEnum.Table' /> 列表</label>
    <label class="radio-label"><input type="radio" name="page-type" checked='@(_pageSchema.PageType == PageTypeEnum.Report)' @onchange='() => _pageSchema.PageType = PageTypeEnum.Report' /> 报表</label>
</div>
        </div>
        <div class="form-item">
            <label>发布状态</label>
            <div class="radio-group">
                <label class="radio-label"><input type="radio" name="publishStatus" value="0" checked="@(_pageSchema.PublishStatus == 0)" @onchange='() => _pageSchema.PublishStatus = 0' />待发布</label>
                <label class="radio-label"><input type="radio" name="publishStatus" value="1" checked="@(_pageSchema.PublishStatus == 1)" @onchange='() => _pageSchema.PublishStatus = 1' />已发布</label>
            </div>
        </div>
        <div class="form-item">
            <label>排序</label>
            <input type="number" class="inp" @bind="_pageSchema.Order" min="0" />
        </div>
    </form>
</HModal>

@code {
    [PersistentState]
    public IList<PageListModel> _pageList { get; set; }

    int _total = 0;

    private bool _visible;
    private PagePartsSchema _pageSchema = new PagePartsSchema();

    private bool _isNew;
    private string _createMode = "blank";
    private string _selectedTemplateId = "";
    private IList<PageTemplateListModel> _templates = new List<PageTemplateListModel>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _total = 50;
        _pageList = await LoadPagesAsync(1, 50);
    }

    private async Task<IList<PageListModel>> LoadPagesAsync(int pageIndex, int pageSize)
    {
        return await PageAppService.GetListAsync(AppId);
    }

    private async Task<PagePartsSchema> GetPageAsync(string pageId)
    {
        return await PageAppService.GetByIdAsync(AppId, pageId);
    }

    private async Task CreateAsync(string parentId)
    {
        _isNew = true;
        _createMode = "blank";
        _selectedTemplateId = "";
        _pageSchema = new PagePartsSchema();
        _pageSchema.AppId = AppId;

        //加载已发布的页面模板供"从模板新建"使用
        _templates = (await PageTemplateAppService.GetListAsync())
            .Where(t => t.PublishStatus == 1).ToList();

        _visible = true;
        StateHasChanged();
    }

    private async Task EditAsync(string id)
    {
        _isNew = false;
        _pageSchema = await GetPageAsync(id);
        _visible = true;

        StateHasChanged();
    }

    private async Task DeleteAsync(string pageId)
    {
        await PageAppService.DeleteAsync(AppId, pageId);

        await Message.SuccessAsync("删除成功！");
    }

    private async Task OnConfirmAsync()
    {
        //从模板新建：克隆模板组件树（重新生成组件Id）到新页面
        if (_isNew && _createMode == "template")
        {
            if (string.IsNullOrWhiteSpace(_selectedTemplateId))
            {
                await Message.WarningAsync("请选择一个页面模板");
                return;
            }

            var template = await PageTemplateAppService.GetByIdAsync(_selectedTemplateId);
            if (template != null)
            {
                _pageSchema.Components = template.Components?
                    .Select(c => c.DeepClone())
                    .ToList() ?? new List<ComponentPartsSchema>();
                _pageSchema.PageProperty = template.PageProperty ?? _pageSchema.PageProperty;
                if (_pageSchema.PageType == PageTypeEnum.Normal)
                    _pageSchema.PageType = template.PageType;
            }
        }

        var isSuccess = await SavePageSchemaAsync();
        if (isSuccess)
        {
            _visible = false;
            _pageList = await LoadPagesAsync(1, 50);
            await Message.SuccessAsync("保存成功！");
        }
        else
        {
            _visible = true;
            await Message.ErrorAsync("保存失败");
        }
    }

    private async Task OnFinishAsync()
    {
        _pageList = await LoadPagesAsync(1, 50);
    }


    private async Task<bool> SavePageSchemaAsync()
    {
        return await PageAppService.SaveAsync(_pageSchema);
    }
}