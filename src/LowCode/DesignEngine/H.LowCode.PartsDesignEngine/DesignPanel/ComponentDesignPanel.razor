@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

@if (_rootComponent != null)
{
    <div class="designpanel" style="margin:5px; height:100%; overflow-y: auto;">
        <DraggableContainer ContainerComponent="@_rootComponent" IsRootContainer="true"></DraggableContainer>
    </div>
}
else
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
        <span class="spinner"></span>
    </div>
}

@code {
    private ComponentPartsSchema _rootComponent;

    [CascadingParameter(Name = "partsCascading")]
    public PartsCascadingModel PartsCascading { get; set; }

    [Parameter]
    public ComponentPartsSchema ComponentPartsSchema { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _rootComponent = LoadRootComponent();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        _rootComponent = LoadRootComponent();
    }

    /// <summary>
    /// 加载根组件：如果传入了组件定义，则以其子组件树为根；否则创建空根容器
    /// </summary>
    private ComponentPartsSchema LoadRootComponent()
    {
        ComponentPartsSchema rootComponent = null;

        // 如果传入了要编辑的组件定义
        if (ComponentPartsSchema != null)
        {
            // 确保 Childrens 不为 null
            if (ComponentPartsSchema.Childrens == null)
            {
                ComponentPartsSchema.Childrens = new List<ComponentPartsSchema>();
            }
            
            // 创建一个虚拟根容器，直接引用原组件的子组件列表（不复制）
            rootComponent = new ComponentPartsSchema()
            {
                Id = "root",
                PartsId = "root",
                Name = "root",
                IsContainer = true,
                Childrens = ComponentPartsSchema.Childrens  // 直接引用，不复制
            };
        }
        else
        {
            // 创建空根容器
            rootComponent = new ComponentPartsSchema()
            {
                Id = "root",
                PartsId = "root",
                Name = "root",
                IsContainer = true,
                Childrens = new List<ComponentPartsSchema>()
            };
        }

        rootComponent.Refresh = StateHasChanged;
        
        // 注册到拖拽状态服务，使拖拽功能正常工作
        PartsDragDropStateService.SetRootComponent(PartsCascading.LibraryId, PartsCascading.PartsId, rootComponent);
        
        return rootComponent;
    }

    /// <summary>
    /// 获取当前设计的根组件结构
    /// </summary>
    public List<ComponentPartsSchema> GetDesignedComponents()
    {
        return _rootComponent?.Childrens?.ToList() ?? new List<ComponentPartsSchema>();
    }
}
