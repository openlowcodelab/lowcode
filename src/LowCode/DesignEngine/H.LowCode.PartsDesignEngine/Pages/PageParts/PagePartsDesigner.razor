@page "/designengine/myparts/page/designer/{TemplateId}"
@namespace H.LowCode.PartsDesignEngine
@inherits LowCodePageComponentBase
@layout PartsDesignEngineLayout

@inject IPageTemplateAppService PageTemplateAppService

<PageTitle>@($"{_partsCascading?.PartsName} - 页面物料设计器")</PageTitle>

@if (_loading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <div class="loading-spinner">加载中...</div>
    </div>
}
else
{
    <CascadingValue Value="@_partsCascading" Name="partsCascading">
        <div class="designpage layout" style="padding:0 2px; background-color: #f7f7f7;">
            <div class="layout-header" style="background-color: white; padding:0 20px; display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <a href="javascript:void(0)" @onclick="GoBack"> @("<") 返回 </a>
                </div>
                <div style="text-align: center;">
                    <h3 style="margin: 0; line-height: 64px;">页面物料设计器 - @_template?.Name</h3>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="SavePageTemplateAsync" disabled="@_saving">保存</button>
                </div>
            </div>
            <div class="layout-body">
                <div class="layout-sider" style="min-width: 200px; flex: auto; max-width: max-content;">
                    <ComponentPanel></ComponentPanel>
                </div>
                <div class="layout-main">
                    <div class="designpage layout-content">
                        <PageDesignPanel @ref="_designPanel"></PageDesignPanel>
                    </div>
                </div>
                <div class="layout-sider designpage" style="flex: auto; max-width: max-content; min-width: 250px;">
                    <PartsSettingPanel></PartsSettingPanel>
                </div>
            </div>
        </div>
    </CascadingValue>
}

@code
{
    [Parameter]
    public string TemplateId { get; set; }

    /// <summary>
    /// 页面模板设计使用的虚拟组件库Id（用于拖拽状态服务 Key）
    /// </summary>
    private const string PageTemplateLibId = "__pagetpl__";

    private PageDesignPanel _designPanel;

    private PartsCascadingModel _partsCascading;
    private PageTemplateSchema _template;

    private bool _loading = true;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _partsCascading = new() { LibraryId = PageTemplateLibId, PartsId = TemplateId, PartsName = "..." };

        await LoadTemplateAsync();
    }

    private async Task LoadTemplateAsync()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _template = (await PageTemplateAppService.GetByIdAsync(TemplateId)).Data;
            if (_template == null)
            {
                Toast.Error("页面模板不存在！");
                GoBack();
                return;
            }

            _template.Components ??= new List<ComponentPartsSchema>();
            _partsCascading.PartsName = _template.Name;

            //将模板组件树装入拖拽状态服务的根容器（PageDesignPanel 初始化时会读取）
            var rootComponent = new ComponentPartsSchema
            {
                Id = "root",
                PartsId = "root",
                Name = "root",
                IsContainer = true,
                Childrens = _template.Components
            };
            rootComponent.Refresh = StateHasChanged;
            PartsDragDropStateService.SetRootComponent(PageTemplateLibId, TemplateId, rootComponent);
        }
        catch (Exception ex)
        {
            Toast.Error($"加载页面模板失败: {ex.Message}");
            GoBack();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SavePageTemplateAsync()
    {
        if (_template == null) return;

        try
        {
            _saving = true;
            StateHasChanged();

            var rootComponent = PartsDragDropStateService.GetRootComponent(PageTemplateLibId, TemplateId);
            _template.Components = rootComponent?.Childrens ?? new List<ComponentPartsSchema>();

            if (_template.Components.Count == 0)
            {
                Toast.Warning("请先添加组件后再保存！");
                return;
            }

            var success = (await PageTemplateAppService.SaveAsync(_template)).Data == true;
            if (success)
                Toast.Success("保存成功！");
            else
                Toast.Error("保存失败！");
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        NavigateTo("/designengine/myparts/pagelibraries");
    }
}
