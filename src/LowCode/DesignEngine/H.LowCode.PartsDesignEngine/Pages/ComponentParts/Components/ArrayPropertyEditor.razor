@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

<div class="array-property-editor">
    <Card Title="@Title" Style="margin-bottom: 16px;">
        <Extra>
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" 
                    OnClick="AddItem" Icon="plus">添加项</Button>
        </Extra>
        <ChildContent>
            @if (Items != null && Items.Any())
            {
                @for (int index = 0; index < Items.Count; index++)
                {
                    var item = Items[index];
                    var currentIndex = index;
                    
                    <Card Size="@CardSize.Small" Style="margin-bottom: 8px;">
                        <Extra>
                            <Space>
                                @if (index > 0)
                                {
                                    <Button Type="@ButtonType.Text" Icon="up" Size="@ButtonSize.Small" 
                                            OnClick="() => MoveUp(currentIndex)" Title="上移">
                                    </Button>
                                }
                                @if (index < Items.Count - 1)
                                {
                                    <Button Type="@ButtonType.Text" Icon="down" Size="@ButtonSize.Small" 
                                            OnClick="() => MoveDown(currentIndex)" Title="下移">
                                    </Button>
                                }
                                <Button Type="@ButtonType.Text" Icon="delete" Size="@ButtonSize.Small" 
                                        OnClick="() => RemoveItem(currentIndex)" Danger Title="删除">
                                </Button>
                            </Space>
                        </Extra>
                        <ChildContent>
                            @if (ItemTemplate != null)
                            {
                                @ItemTemplate((item, currentIndex))
                            }
                            else
                            {
                                @* 默认的简单编辑器 *@
                                <div style="margin-bottom: 16px;">
                                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">@($"项 {index + 1}")</label>
                                    @if (ItemType == "string")
                                    {
                                        <Input Value="@((string)item)" 
                                               @onchange="@((e) => UpdateItem(currentIndex, e.Value?.ToString()))"
                                               Placeholder="请输入值" />
                                    }
                                    else if (ItemType == "int")
                                    {
                                        <InputNumber Value="@((int)item)" 
                                                     @onchange="@((e) => UpdateItem(currentIndex, int.TryParse(e.Value?.ToString(), out var v) ? v : 0))" />
                                    }
                                    else if (ItemType == "bool")
                                    {
                                        <Switch Checked="@((bool)item)" 
                                                @onchange="@((e) => UpdateItem(currentIndex, e))" />
                                    }
                                    else
                                    {
                                        <Input Value="@(item?.ToString())" 
                                               @onchange="@((e) => UpdateItem(currentIndex, e.Value?.ToString()))"
                                               Placeholder="请输入值" />
                                    }
                                </div>
                            }
                        </ChildContent>
                    </Card>
                }
            }
            else
            {
                <AntDesign.Empty Description="@("暂无数据,点击上方按钮添加项")" />
            }
        </ChildContent>
    </Card>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "数组编辑器";
    
    [Parameter]
    public List<object> Items { get; set; } = new();
    
    [Parameter]
    public EventCallback<List<object>> ItemsChanged { get; set; }
    
    [Parameter]
    public string ItemType { get; set; } = "string";
    
    [Parameter]
    public RenderFragment<(object item, int index)> ItemTemplate { get; set; }
    
    [Parameter]
    public Func<object> CreateNewItem { get; set; }

    private async Task AddItem()
    {
        object newItem;
        
        if (CreateNewItem != null)
        {
            newItem = CreateNewItem();
        }
        else
        {
            // 根据类型创建默认值
            newItem = ItemType switch
            {
                "string" => "",
                "int" => 0,
                "bool" => false,
                "decimal" => 0m,
                "double" => 0.0,
                _ => ""
            };
        }
        
        Items.Add(newItem);
        await NotifyChange();
    }

    private async Task RemoveItem(int index)
    {
        if (index >= 0 && index < Items.Count)
        {
            Items.RemoveAt(index);
            await NotifyChange();
        }
    }

    private async Task MoveUp(int index)
    {
        if (index > 0 && index < Items.Count)
        {
            var item = Items[index];
            Items.RemoveAt(index);
            Items.Insert(index - 1, item);
            await NotifyChange();
        }
    }

    private async Task MoveDown(int index)
    {
        if (index >= 0 && index < Items.Count - 1)
        {
            var item = Items[index];
            Items.RemoveAt(index);
            Items.Insert(index + 1, item);
            await NotifyChange();
        }
    }

    private async Task UpdateItem(int index, object value)
    {
        if (index >= 0 && index < Items.Count)
        {
            Items[index] = value;
            await NotifyChange();
        }
    }

    private async Task NotifyChange()
    {
        if (ItemsChanged.HasDelegate)
        {
            await ItemsChanged.InvokeAsync(Items);
        }
        StateHasChanged();
    }
}