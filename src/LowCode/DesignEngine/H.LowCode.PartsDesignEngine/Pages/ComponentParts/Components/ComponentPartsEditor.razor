@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

<div class="component-parts-editor">
    <div class="tabs-section">
        <div class="tabs-section-header">基本信息</div>
        <div class="tabs-section-body">
            <div class="row">
                <div class="col col-12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                            组件Id <span style="color: #ff4d4f;">*</span>
                        </label>
                        <input class="inp" @bind="ComponentParts.PartsId" placeholder="组件Name" />
                    </div>
                </div>
                <div class="col col-12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">显示名称</label>
                        <input class="inp" @bind="ComponentParts.Label" placeholder="显示名称" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">组件类型</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="componentType" value="1" checked="@(ComponentParts.ComponentType == 1)" @onchange="() => ComponentParts.ComponentType = 1" />原子组件</label>
                            <label class="radio-label"><input type="radio" name="componentType" value="2" checked="@(ComponentParts.ComponentType == 2)" @onchange="() => ComponentParts.ComponentType = 2" />低代码组件</label>
                        </div>
                    </div>
                </div>
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">排序</label>
                        <input type="number" class="inp" @bind="ComponentParts.Order" min="0" />
                    </div>
                </div>
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">版本</label>
                        <input class="inp" @bind="ComponentParts.Version" placeholder="版本号" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">是否容器</label>
                        <label class="switch"><input type="checkbox" @bind="ComponentParts.IsContainer"></label>
                    </div>
                </div>
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">支持数据源</label>
                        <label class="switch"><input type="checkbox" @bind="ComponentParts.IsSupportDataSource" disabled="@ComponentParts.IsContainer"></label>
                    </div>
                </div>
                <div class="col col-8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">隐藏标签</label>
                        <label class="switch"><input type="checkbox" @bind="ComponentParts.IsHiddenLabel"></label>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">组件描述</label>
                <textarea class="ta" @bind="ComponentParts.Description" rows="3" placeholder="组件描述"></textarea>
            </div>
            <div style="margin-top: 16px;">
                <ComponentFragmentEditor @bind-Fragment="@ComponentParts.Fragment" />
            </div>
            <div style="margin-top: 16px;">
                <HCard Title="基础样式">
                    <div class="row">
                        <div class="col col-8">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">组件宽度(24栅格)</label>
                                <input type="range" value="@ComponentParts.Style.ItemWidth" min="4" max="24" @onchange='(e) => { ComponentParts.Style.ItemWidth = double.Parse(e.Value?.ToString() ?? "4"); OnBasicStyleChange(); }' />
                            </div>
                        </div>
                        @if (ComponentParts.IsHiddenLabel == false && ComponentParts.IsContainer == false)
                        {
                            <div class="col col-8">
                                <div style="margin-bottom: 16px;">
                                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">标签宽度(px)</label>
                                    <input type="range" value="@ComponentParts.Style.LabelWidth" min="4" max="300" @onchange='(e) => { ComponentParts.Style.LabelWidth = double.Parse(e.Value?.ToString() ?? "180"); OnBasicStyleChange(); }' />
                                </div>
                            </div>
                        }
                        <div class="col col-8">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">组件高度(px)</label>
                                <input type="range" value="@ComponentParts.Style.ItemHeight" min="40" max="500" @onchange='(e) => { ComponentParts.Style.ItemHeight = double.Parse(e.Value?.ToString() ?? "85"); OnBasicStyleChange(); }' />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col col-24">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">默认样式</label>
                                <textarea class="ta" @bind="ComponentParts.Style.DefaultStyle" rows="4" placeholder="例如：margin:8px; padding:4px;"></textarea>
                            </div>
                        </div>
                    </div>
                </HCard>
            </div>
        </div>
    </div>

    <div class="tabs-section">
        <div class="tabs-section-header">组件设计属性</div>
        <div class="tabs-section-body">
            <AttributeDefineGroupEditor @bind-AttributeDefineGroups="@ComponentParts.AttributeDefineGroups" />
        </div>
    </div>

    <div class="tabs-section">
        <div class="tabs-section-header">数据源</div>
        <div class="tabs-section-body">
            <ComponentDataSourceEditor @bind-DataSource="@ComponentParts.DataSource" />
        </div>
    </div>

    <div class="tabs-section">
        <div class="tabs-section-header">事件定义</div>
        <div class="tabs-section-body">
            <EventDefineEditor @bind-EventDefines="@ComponentParts.EventDefines" />
        </div>
    </div>

    <div class="tabs-section">
        <div class="tabs-section-header">样式定义</div>
        <div class="tabs-section-body">
            <StyleDefineEditor StyleDefines="@ComponentParts.StyleDefines" />
        </div>
    </div>

    <div class="editor-actions" style="margin-top: 16px; text-align: right;">
        <div class="space">
            <button class="btn" @onclick="OnCancel">取消</button>
            <button class="btn btn-primary" @onclick="HandleSave" disabled="@_saving">保存</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ComponentPartsSchema? ComponentParts { get; set; }
    
    [Parameter]
    public EventCallback<ComponentPartsSchema> ComponentPartsChanged { get; set; }
    
    [Parameter]
    public EventCallback OnCancel { get; set; }
    
    [Parameter]
    public EventCallback<ComponentPartsSchema> OnSave { get; set; }

    private bool _saving = false;

    protected override void OnParametersSet()
    {
        if (ComponentParts == null)
        {
            ComponentParts = new ComponentPartsSchema
            {
                Id = ShortIdGenerator.Generate(),
                PartsId = ShortIdGenerator.Generate(),
                ComponentType = 1,
                Order = 0,
                AttributeDefineGroups = new List<ComponentPartsAttributeDefineGroupSchema>(),
                EventDefines = new List<ComponentPartsEventDefineSchema>(),
                StyleDefines = new List<ComponentPartsStyleDefineSchema>()
            };
        }
        
        // 确保集合不为空
        if (ComponentParts.AttributeDefineGroups == null)
        {
            ComponentParts.AttributeDefineGroups = new List<ComponentPartsAttributeDefineGroupSchema>();
        }
        
        if (ComponentParts.EventDefines == null)
        {
            ComponentParts.EventDefines = new List<ComponentPartsEventDefineSchema>();
        }
        
        if (ComponentParts.StyleDefines == null)
        {
            ComponentParts.StyleDefines = new List<ComponentPartsStyleDefineSchema>();
        }
    }

    private void OnBasicStyleChange()
    {
    }

    private async Task HandleSave()
    {
        _saving = true;
        try
        {
            await ComponentPartsChanged.InvokeAsync(ComponentParts);
            await OnSave.InvokeAsync(ComponentParts);
        }
        finally
        {
            _saving = false;
        }
    }
}

<style>
    .component-parts-editor .tabs-section-body {
        padding: 16px 0;
    }
    
    .editor-actions {
        border-top: 1px solid #f0f0f0;
        padding-top: 16px;
    }
</style>