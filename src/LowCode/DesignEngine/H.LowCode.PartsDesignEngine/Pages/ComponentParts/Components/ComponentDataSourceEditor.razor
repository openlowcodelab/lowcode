@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

<div class="component-datasource-editor">
    <Card Title="数据源配置" Style="margin-bottom: 16px;">
        <ChildContent>
            <Row Gutter="16">
                <Col Span="12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源分组类型</label>
                        <EnumSelect TEnum="ComponentDataSourceGroupTypeEnum" @bind-Value="@DataSource.DataSourceGroupType" />
                    </div>
                </Col>
                <Col Span="12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源类型</label>
                        <EnumSelect TEnum="ComponentDataSourceTypeEnum" @bind-Value="@DataSource.DataSourceType" />
                    </div>
                </Col>
            </Row>
            
            <Row Gutter="16">
                <Col Span="8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源ID</label>
                        <Input @bind-Value="@DataSource.DataSourceId" Placeholder="数据源唯一标识" />
                    </div>
                </Col>
                <Col Span="8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源名称</label>
                        <Input @bind-Value="@DataSource.DataSourceName" Placeholder="数据源显示名称" />
                    </div>
                </Col>
                <Col Span="8">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源值</label>
                        <Input @bind-Value="@DataSource.DataSourceValue" Placeholder="数据源值" />
                    </div>
                </Col>
            </Row>
            
            @if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.Fiexd)
            {
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">固定选项数据源</label>
                    <FixedOptionDataSourceEditor @bind-Options="@DataSource.FiexdOptionDataSource" />
                </div>
            }
            else if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.API)
            {
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">API选项数据源</label>
                    <APIDataSourceEditor @bind-DataSource="@DataSource.APIOptionDataSource" />
                </div>
            }
            else if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.SQL)
            {
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">SQL选项数据源</label>
                    <SQLDataSourceEditor @bind-DataSource="@DataSource.SQLOptionDataSource" />
                </div>
            }
            
            @if (DataSource.DataSourceFragment != null)
            {
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据源Fragment</label>
                    <ComponentFragmentEditor @bind-Fragment="@DataSource.DataSourceFragment" />
                </div>
            }
            else
            {
                <Button Type="@ButtonType.Dashed" OnClick="AddDataSourceFragment" Icon="plus">添加数据源Fragment</Button>
            }
        </ChildContent>
    </Card>
</div>

@code {
    [Parameter]
    public ComponentPartsDataSourceSchema DataSource { get; set; }
    
    [Parameter]
    public EventCallback<ComponentPartsDataSourceSchema> DataSourceChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (DataSource == null)
        {
            DataSource = new ComponentPartsDataSourceSchema();
        }
    }

    private async Task AddDataSourceFragment()
    {
        DataSource.DataSourceFragment = new ComponentPartsFragmentSchema
        {
            Attributes = new ComponentAttributeFragmentSchema[0],
            ChildFragments = new ComponentPartsFragmentSchema[0]
        };
        await NotifyChange();
    }

    private async Task NotifyChange()
    {
        await DataSourceChanged.InvokeAsync(DataSource);
        StateHasChanged();
    }
}