@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

<div class="sql-data-source-editor">
    <HCard Style="margin-bottom: 8px;">
        <div class="row">
            <div class="col col-12">
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据库类型</label>
                    <select class="sel" @bind="DataSource.DbType">
                        <option value="SqlServer">SQL Server</option>
                        <option value="MySQL">MySQL</option>
                        <option value="PostgreSQL">PostgreSQL</option>
                        <option value="Oracle">Oracle</option>
                        <option value="SQLite">SQLite</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col col-24">
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">SQL 查询</label>
                    <textarea class="ta" @bind="DataSource.Sql" rows="4" placeholder="请输入 SQL 查询语句"></textarea>
                </div>
            </div>
        </div>
    </HCard>
</div>

@code {
    [Parameter]
    public SQLDataSourceSchema DataSource { get; set; }
    [Parameter]
    public EventCallback<SQLDataSourceSchema> DataSourceChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (DataSource == null)
        {
            DataSource = new SQLDataSourceSchema
            {
                DbType = "SqlServer",
                Sql = ""
            };
        }
    }
}