@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

@inject PartsDragDropStateService PartsDragDropStateService

<div class="settingpanel" style="width:250px; padding:0px 8px;">
    @if (_showPropertyPanel)
    {
        <div class="tabs-header">
            @if (_component.IsContainer == false)
            {
                <button class='tab-btn @(_activeTabKey == "tab_property" ? "tab-active" : "")' @onclick='() => _activeTabKey = "tab_property"'>属性</button>
            }
            <button class='tab-btn @(_activeTabKey == "tab_style" ? "tab-active" : "")' @onclick='() => _activeTabKey = "tab_style"'>样式</button>
        </div>
        @if (_activeTabKey == "tab_property" && _component.IsContainer == false)
        {
            <PropertySetting Component="@_component"></PropertySetting>
        }
        @if (_activeTabKey == "tab_style")
        {
            <StyleSetting Component="@_component"></StyleSetting>
        }
    }
</div>

@code {
    [CascadingParameter(Name = "pageCascading")]
    public PageCascadingModel PageCascading { get; set; }

    private ComponentPartsSchema _component { get; set; }

    private bool _showPropertyPanel { get; set; }

    private string _activeTabKey { get; set; } = "tab_property";

    #region Init
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RegisterEventDispatcher();
    }

    private void RegisterEventDispatcher()
    {
        //订阅设计面板中的组件点击事件
        BlazorEventDispatcher.Subscribe("designengine.draggableitem.onclick", (value) =>
        {
            if (value != null)
            {
                _component = (ComponentPartsSchema)value;
                _showPropertyPanel = true;
                _activeTabKey = "tab_property";
                // 使用InvokeAsync确保在正确的线程上下文中执行
                InvokeAsync(StateHasChanged);
            }
        });

        //订阅设计面板取消选中事件
        BlazorEventDispatcher.Subscribe("designengine.draggableitem.onblur", (value) =>
        {
            _component = null;
            _showPropertyPanel = false;
            _activeTabKey = "tab_property";
            // 使用InvokeAsync确保在正确的线程上下文中执行
            InvokeAsync(StateHasChanged);
        });
    }
    #endregion
}
