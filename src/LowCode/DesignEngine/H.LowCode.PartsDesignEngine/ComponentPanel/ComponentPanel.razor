@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

@inject IComponentLibraryAppService ComponentLibraryAppService
@inject IComponentPartsAppService ComponentPartsAppService

<div class="componentpanel" style="padding-left:8px;">
    <div class="tabs-header" style="width:270px; padding:0px 4px;">
        <button class='tab-btn tab-active'>组件库</button>
    </div>
    <div style="padding: 4px 8px;">
        <select class="sel" @bind="_selectedLibraryId" @bind:after="OnLibraryChanged">
            @if (_componentLibraries != null)
            {
                @foreach (var lib in _componentLibraries)
                {
                    <option value="@lib.LibraryId">@lib.LibraryName</option>
                }
            }
        </select>
    </div>
    <div style="height:100%; overflow-y: auto; padding: 4px 0;">
        @if (_componentPartsList != null && _componentPartsList.Count > 0)
        {
            @foreach (var component in _componentPartsList)
            {
                <DragItem Component="component"></DragItem>
            }
        }
        else
        {
            <div style="padding: 12px; color:#999; font-size:12px;">该组件库暂无可用的原子组件</div>
        }
    </div>
</div>

@code {
    [CascadingParameter(Name = "partsCascading")]
    public PartsCascadingModel PartsCascading { get; set; }

    private IList<ComponentLibrarySchema> _componentLibraries { get; set; }

    private IList<ComponentPartsSchema> _componentPartsList { get; set; }

    private string _selectedLibraryId;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _componentLibraries = await ComponentLibraryAppService.GetListAsync();

        //默认选中当前设计上下文所在组件库（上下文库不存在时回退到第一个库）
        var contextLibraryId = PartsCascading?.LibraryId;
        _selectedLibraryId = (_componentLibraries?.Any(l => l.LibraryId == contextLibraryId) == true)
            ? contextLibraryId
            : _componentLibraries?.FirstOrDefault()?.LibraryId;

        _componentPartsList = await LoadAtomicComponentsAsync(_selectedLibraryId);
    }

    private async Task OnLibraryChanged()
    {
        _componentPartsList = await LoadAtomicComponentsAsync(_selectedLibraryId);
    }

    /// <summary>
    /// 加载指定组件库下已发布的原子组件（低代码组件由原子组件拼装而来）
    /// </summary>
    private async Task<IList<ComponentPartsSchema>> LoadAtomicComponentsAsync(string libraryId)
    {
        if (string.IsNullOrEmpty(libraryId))
            return new List<ComponentPartsSchema>();

        var allComponents = await ComponentPartsAppService.GetAllComponentsAsync(libraryId);
        //仅原子组件（ComponentType==1），GetAllComponentsAsync 已过滤为已发布
        return allComponents.Where(t => t.ComponentType == 1).ToList();
    }
}
