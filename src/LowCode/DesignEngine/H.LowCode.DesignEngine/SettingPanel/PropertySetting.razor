@namespace H.LowCode.DesignEngine
@inherits LowCodeComponentBase
@using H.LowCode.MetaSchema
@using H.LowCode.MetaSchema.DesignEngine

<div class="propertysetting-wrapper">
    @if (Component != null)
    {
        @* 基础属性 *@
        <BasicPropertyItem Component="@Component"></BasicPropertyItem>

        @* 显示条件（组件显隐联动） *@
        <div class="setting-group-title">
            <span class="setting-group-title-icon">◎</span>显示条件
        </div>

        <div class="propertysetting-item">
            <label>启用显示条件：</label>
            <label class="switch"><input type="checkbox" @bind="@_isVisibleConditionEnabled" @bind:after="() => OnVisibleConditionEnabledChange(_isVisibleConditionEnabled)" /></label>
        </div>

        @if (_isVisibleConditionEnabled && Component.VisibleCondition != null)
        {
            <div class="propertysetting-item">
                <label>值来源：</label>
                <input class="inp" @bind="@Component.VisibleCondition.ValueExpr" @bind:after="OnVisibleConditionChange"
                       placeholder="如 $(item.f_x) 或 $(form.key)" />
            </div>

            <div class="propertysetting-item">
                <label>比较符：</label>
                <select class="sel" @bind="@Component.VisibleCondition.Op" @bind:after="OnVisibleConditionChange">
                    <option value="@VisibleConditionOpEnum.Equals">等于</option>
                    <option value="@VisibleConditionOpEnum.NotEquals">不等于</option>
                    <option value="@VisibleConditionOpEnum.Contains">包含</option>
                    <option value="@VisibleConditionOpEnum.In">在列表中</option>
                    <option value="@VisibleConditionOpEnum.NotEmpty">非空</option>
                    <option value="@VisibleConditionOpEnum.IsEmpty">为空</option>
                </select>
            </div>

            @if (Component.VisibleCondition.Op is VisibleConditionOpEnum.Equals
                or VisibleConditionOpEnum.NotEquals or VisibleConditionOpEnum.Contains
                or VisibleConditionOpEnum.In)
            {
                <div class="propertysetting-item">
                    <label>期望值：</label>
                    <input class="inp" @bind="@Component.VisibleCondition.ExpectExpr" @bind:after="OnVisibleConditionChange"
                           placeholder="支持表达式，如 $(item.f_x)" />
                </div>
            }
        }

        @* 数据源属性 *@
        <DataSourcePropertyItem Component="@Component"></DataSourcePropertyItem>

        @*扩展属性*@
        <ExtensionPropertyItem Component="@Component"></ExtensionPropertyItem>

        @*校验属性*@
        <div class="setting-group-title">
            <span class="setting-group-title-icon">✓</span>校验设置
        </div>
        
        <div class="propertysetting-item">
            <label>启用校验：</label>
            <label class="switch"><input type="checkbox" @bind="@_isValidationEnabled" @bind:after="() => OnValidationEnabledChange(_isValidationEnabled)" /></label>
        </div>

        @if (_isValidationEnabled)
        {
            <div class="setting-group-title setting-group-title-sub">
                校验规则
            </div>

            @if (Component.ValidationRules != null && Component.ValidationRules.Any())
            {
                @for (int i = 0; i < Component.ValidationRules.Count; i++)
                {
                    var index = i;
                    var rule = Component.ValidationRules[index];
                    
                    <div class="card card-small" style="margin-bottom: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span>规则 @(index + 1)</span>
                                <div>
                                    <label class="switch"><input type="checkbox" @bind="@rule.IsEnabled" @bind:after="OnRuleChange" /></label>
                                    <button class="btn btn-text btn-danger btn-sm" @onclick="() => RemoveRule(index)">删除</button>
                                </div>
                            </div>
                            <div class="propertysetting-item">
                                <label>校验类型：</label>
                                <select class="sel" @bind="@rule.RuleType" @bind:after="OnRuleChange">
                                    <option value="@ValidationRuleTypeEnum.Required">必填</option>
                                    <option value="@ValidationRuleTypeEnum.MinLength">最小长度</option>
                                    <option value="@ValidationRuleTypeEnum.MaxLength">最大长度</option>
                                    <option value="@ValidationRuleTypeEnum.MinValue">最小值</option>
                                    <option value="@ValidationRuleTypeEnum.MaxValue">最大值</option>
                                    <option value="@ValidationRuleTypeEnum.Pattern">正则表达式</option>
                                    <option value="@ValidationRuleTypeEnum.Email">邮箱格式</option>
                                    <option value="@ValidationRuleTypeEnum.Phone">手机号格式</option>
                                    <option value="@ValidationRuleTypeEnum.Url">URL格式</option>
                                    <option value="@ValidationRuleTypeEnum.Custom">自定义</option>
                                </select>
                            </div>

                            @if (rule.RuleType == ValidationRuleTypeEnum.MinLength)
                            {
                                <div class="propertysetting-item">
                                    <label>最小长度：</label>
                                    <input type="number" class="inp" @bind="@rule.MinLength" Min="0" @bind:after="OnRuleChange" />
                                </div>
                            }

                            @if (rule.RuleType == ValidationRuleTypeEnum.MaxLength)
                            {
                                <div class="propertysetting-item">
                                    <label>最大长度：</label>
                                    <input type="number" class="inp" @bind="@rule.MaxLength" Min="1" @bind:after="OnRuleChange" />
                                </div>
                            }

                            @if (rule.RuleType == ValidationRuleTypeEnum.MinValue)
                            {
                                <div class="propertysetting-item">
                                    <label>最小值：</label>
                                    <input type="number" class="inp" @bind="@rule.MinValue" @bind:after="OnRuleChange" />
                                </div>
                            }

                            @if (rule.RuleType == ValidationRuleTypeEnum.MaxValue)
                            {
                                <div class="propertysetting-item">
                                    <label>最大值：</label>
                                    <input type="number" class="inp" @bind="@rule.MaxValue" @bind:after="OnRuleChange" />
                                </div>
                            }

                            @if (rule.RuleType == ValidationRuleTypeEnum.Pattern || rule.RuleType == ValidationRuleTypeEnum.Custom)
                            {
                                <div class="propertysetting-item">
                                    <label>@(rule.RuleType == ValidationRuleTypeEnum.Pattern ? "正则表达式" : "自定义表达式")：</label>
                                    <input class="inp" @bind="@rule.Pattern" @bind:after="OnRuleChange" />
                                </div>
                            }

                            <div class="propertysetting-item">
                                <label>错误消息：</label>
                                <input class="inp" @bind="@rule.ErrorMessage" @bind:after="OnRuleChange" 
                                       placeholder="@GetDefaultErrorMessage(rule.RuleType)" />
                            </div>

                            <div class="propertysetting-item">
                                <label>触发时机：</label>
                                <div class="radio-group">
                                    <label class="radio-label"><input type="radio" name='trigger_@index' value="@ValidationTriggerEnum.Change" checked="@(rule.Trigger == ValidationTriggerEnum.Change)" @onchange='() => { rule.Trigger = ValidationTriggerEnum.Change; OnRuleChange(); }' /> 输入时</label>
                                    <label class="radio-label"><input type="radio" name='trigger_@index' value="@ValidationTriggerEnum.Blur" checked="@(rule.Trigger == ValidationTriggerEnum.Blur)" @onchange='() => { rule.Trigger = ValidationTriggerEnum.Blur; OnRuleChange(); }' /> 失去焦点时</label>
                                </div>
                            </div>

                            <div class="propertysetting-item">
                                <label>优先级：</label>
                                <input type="number" class="inp" @bind="@rule.Order" Min="1" @bind:after="OnRuleChange" />
                            </div>
                        </div>
                }
            }

            <button class="btn btn-dashed" @onclick="AddRule">
                添加校验规则
            </button>
        }

        @*事件属性*@
        @if (Component.SupportEvents != null && Component.SupportEvents.Any())
        {
            <EventPropertyItem Component="@Component"></EventPropertyItem>
        }
    }
</div>

@code {
    [Parameter]
    public ComponentPartsSchema Component { get; set; }

    private bool _isValidationEnabled;
    private bool _isVisibleConditionEnabled;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        InitializeValidationState();
        InitializeVisibleConditionState();
    }

    protected override void OnParametersSet()
    {
        InitializeValidationState();
        InitializeVisibleConditionState();
    }

    private void InitializeVisibleConditionState()
    {
        _isVisibleConditionEnabled = Component?.VisibleCondition != null;
    }

    private void OnVisibleConditionEnabledChange(bool enabled)
    {
        _isVisibleConditionEnabled = enabled;

        if (enabled)
        {
            Component.VisibleCondition ??= new VisibleConditionSchema();
        }
        else
        {
            Component.VisibleCondition = null;
        }

        OnPropertyChange();
    }

    private void OnVisibleConditionChange()
    {
        OnPropertyChange();
    }

    private void InitializeValidationState()
    {
        if (Component?.ValidationRules != null && Component.ValidationRules.Any())
        {
            _isValidationEnabled = true;
        }
        else
        {
            _isValidationEnabled = false;
        }
    }

    private void OnValidationEnabledChange(bool enabled)
    {
        _isValidationEnabled = enabled;
        
        if (enabled)
        {
            if (Component.ValidationRules == null || !Component.ValidationRules.Any())
            {
                Component.ValidationRules = new List<ValidationRuleSchema>();
                AddRule();
            }
        }
        else
        {
            Component.ValidationRules?.Clear();
        }
        
        OnPropertyChange();
    }

    private void AddRule()
    {
        if (Component.ValidationRules == null)
        {
            Component.ValidationRules = new List<ValidationRuleSchema>();
        }

        var newRule = new ValidationRuleSchema
        {
            Id = Guid.NewGuid().ToString(),
            ComponentId = Component.Id,
            RuleType = ValidationRuleTypeEnum.Required,
            IsEnabled = true,
            Trigger = ValidationTriggerEnum.Blur,
            Order = Component.ValidationRules.Count + 1
        };

        Component.ValidationRules.Add(newRule);
        OnPropertyChange();
    }

    private void RemoveRule(int index)
    {
        if (Component.ValidationRules != null && index >= 0 && index < Component.ValidationRules.Count)
        {
            Component.ValidationRules.RemoveAt(index);
            
            // 重新排序
            for (int i = 0; i < Component.ValidationRules.Count; i++)
            {
                Component.ValidationRules[i].Order = i + 1;
            }
            
            OnPropertyChange();
        }
    }

    private void OnRuleChange()
    {
        OnPropertyChange();
    }

    private void OnPropertyChange()
    {
        Component.RefreshState();
        StateHasChanged();
    }

    private string GetDefaultErrorMessage(ValidationRuleTypeEnum ruleType)
    {
        return ruleType switch
        {
            ValidationRuleTypeEnum.Required => "此字段为必填项",
            ValidationRuleTypeEnum.MinLength => "输入长度不足",
            ValidationRuleTypeEnum.MaxLength => "输入长度超限",
            ValidationRuleTypeEnum.MinValue => "输入值过小",
            ValidationRuleTypeEnum.MaxValue => "输入值过大",
            ValidationRuleTypeEnum.Pattern => "格式不正确",
            ValidationRuleTypeEnum.Email => "请输入有效的邮箱地址",
            ValidationRuleTypeEnum.Phone => "请输入有效的手机号码",
            ValidationRuleTypeEnum.Url => "请输入有效的URL地址",
            ValidationRuleTypeEnum.Custom => "自定义校验失败",
            _ => "输入不符合要求"
        };
    }
}
