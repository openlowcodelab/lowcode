@namespace H.LowCode.DesignEngine
@inherits LowCodeComponentBase
@using System.Text.Json

<div style="margin: 16px 0;">
    <div class="alert alert-info" style="padding:8px 12px; border:1px solid #91d5ff; background:#e6f7ff; border-radius:4px; margin-bottom:16px;">
        <strong>固定数据源说明</strong>
        <div style="margin-top:4px; font-size:12px; color:#666;">用于设计时预览和测试。运行时可以切换为 API 或 SQL 数据源。数据格式为 JSON 数组，每个元素是一个对象。</div>
    </div>

    <div style="margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label style="font-weight: 500;">数据列表</label>
            <button class="btn btn-primary btn-sm" @onclick="AddDataItem">+ 添加数据项</button>
        </div>

        @if (DataSource?.FixedData != null && DataSource.FixedData.Count > 0)
        {
            <div style="max-height: 400px; overflow-y: auto;">
                @for (int i = 0; i < DataSource.FixedData.Count; i++)
                {
                    var index = i;
                    var dataItem = DataSource.FixedData[index];
                    
                    <div class="card" style="border:1px solid #e8e8e8; border-radius:4px; margin-bottom:8px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:4px 8px; background:#fafafa; border-bottom:1px solid #e8e8e8;">
                            <span>数据项 @(index + 1)</span>
                            <div style="display:flex; gap:4px;">
                                <button class="btn btn-text btn-sm" @onclick="() => MoveUp(index)" disabled="@(index == 0)">↑ 上移</button>
                                <button class="btn btn-text btn-sm" @onclick="() => MoveDown(index)" disabled="@(index == DataSource.FixedData.Count - 1)">↓ 下移</button>
                                <button class="btn btn-text btn-sm" @onclick="() => RemoveDataItem(index)" style="color:red;">✕ 删除</button>
                            </div>
                        </div>
                        <div style="padding:8px;">
                            <div style="margin-bottom: 8px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">数据项 @(index + 1) (JSON 格式)</label>
                                <textarea class="ta" rows="4"
                                    value="@GetJsonString(dataItem)"
                                    @onchange='(e) => UpdateDataItem(index, e.Value?.ToString() ?? "{}")'
                                    placeholder='{"id": "1", "title": "问题标题", "type": 1}'></textarea>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding: 16px; text-align: center; color: #999;">暂无数据</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ListDataSourceSchema DataSource { get; set; }

    [Parameter]
    public EventCallback<ListDataSourceSchema> DataSourceChanged { get; set; }

    private void AddDataItem()
    {
        if (DataSource != null)
        {
            if (DataSource.FixedData == null)
            {
                DataSource.FixedData = new List<Dictionary<string, object>>();
            }

            DataSource.FixedData.Add(new Dictionary<string, object>
            {
                { "id", DataSource.FixedData.Count + 1 },
                { "title", $"示例数据 {DataSource.FixedData.Count + 1}" }
            });

            StateHasChanged();
        }
    }

    private void RemoveDataItem(int index)
    {
        if (DataSource?.FixedData != null && index >= 0 && index < DataSource.FixedData.Count)
        {
            DataSource.FixedData.RemoveAt(index);
            StateHasChanged();
        }
    }

    private void MoveUp(int index)
    {
        if (DataSource?.FixedData != null && index > 0)
        {
            var item = DataSource.FixedData[index];
            DataSource.FixedData.RemoveAt(index);
            DataSource.FixedData.Insert(index - 1, item);
            StateHasChanged();
        }
    }

    private void MoveDown(int index)
    {
        if (DataSource?.FixedData != null && index < DataSource.FixedData.Count - 1)
        {
            var item = DataSource.FixedData[index];
            DataSource.FixedData.RemoveAt(index);
            DataSource.FixedData.Insert(index + 1, item);
            StateHasChanged();
        }
    }

    private string GetJsonString(Dictionary<string, object> dataItem)
    {
        return dataItem.ToJson() ?? "{}";
    }

    private void UpdateDataItem(int index, string jsonString)
    {
        if (DataSource?.FixedData == null || index < 0 || index >= DataSource.FixedData.Count)
            return;

        try
        {
            var dict = jsonString.FromJson<Dictionary<string, object>>();
            if (dict != null)
            {
                DataSource.FixedData[index] = dict;
            }
        }
        catch
        {
        }
    }
}
