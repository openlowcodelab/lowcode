@namespace H.LowCode.DesignEngine
@inherits LowCodeComponentBase
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime

<div @ref="itemRef" class="draggableitem-box @DraggableItemBoxClassMapper"
    draggable="true"
     style="flex: 0 0 auto;
        width: @((Component.Style.ItemWidth > 4 ? Component.Style.ItemWidth : (IsInRootContainer ? 24/_pageLayout : 24)) / 24.0 * 100)%;
        min-height: @(Component.Style.ItemHeight)px;
        transform: @Component.DesignState.AnimationTransform;
        will-change: @(isDragging || Component.DesignState.IsAnimating ? "transform" : "auto");
        transition: @(isDragging ? "none" : "transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1)");
        z-index: @(isDragging ? "9999" : "auto");
        position: @(isDragging ? "relative" : "static");
        opacity: @(isDragging ? "0.6" : "1");
        pointer-events: @(isDragging ? "none" : "auto");
        @Component.Style.DefaultStyle @Component.Style.CustomStyle"
     @onclick="OnClick" @onclick:stopPropagation
     @ondragstart="OnDragStart" @ondragstart:stopPropagation
     @ondrag="OnDrag" @ondrag:stopPropagation
     @ondragenter="OnDragEnter" @ondragenter:preventDefault @ondragenter:stopPropagation
     @ondragover="OnDragOver" @ondragover:preventDefault @ondragover:stopPropagation
     @ondragleave="OnDragLeave" @ondragleave:stopPropagation
     @ondragend="OnDragEnd" @ondragend:stopPropagation
     @onmouseover="OnMouseOver" @onmouseover:stopPropagation
     @onmouseout="OnMouseOut" @onmouseout:stopPropagation>

    <div class="draggableitem @DraggableItemClassMapper" style="@Component.DesignState.DragEffectStyle">
        <div draggable="true" class="draggableitem-icon-move">
            <span class="icon-drag">⠿</span>
        </div>
        @* 删除/复制按钮：hover 时通过 CSS 显示 *@
        <div class="draggableitem-pointer-wrapper">
            <div class="draggableitem-pointer" @onclick="OnDelete">
                <span class="icon-delete">✕</span>
            </div>
            <div class="draggableitem-pointer" @onclick="OnCopy">
                <span class="icon-copy">📋</span>
            </div>
        </div>

        <DynamicComponentItem Component="@Component"></DynamicComponentItem>
    </div>
</div>

@code {
    [CascadingParameter(Name = "pageCascading")]
    public PageCascadingModel PageCascading { get; set; }

    [Parameter]
    public ComponentPartsSchema Component { get; set; }

    /// <summary>
    /// 当前组件是否在根容器内
    /// </summary>
    [Parameter]
    public bool IsInRootContainer { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemClick { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemDelete { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemCopy { get; set; }

    private string DraggableItemBoxClassMapper
    {
        get
        {
            var cls = Component.DesignState.IsSelected ? "draggableitem-selected" : string.Empty;
            if (Component.DesignState.ShowDropIndicator)
                cls += " draggableitem-drop-target";
            return cls;
        }
    }
    private string DraggableItemClassMapper => string.Empty;

    private ElementReference itemRef;
    private DragDropElementDimensions dimensions;

    private bool isDragging = false;
    private double initialX = 0;
    private double initialY = 0;

    /// <summary>
    /// 本地缓存的页面布局列数，用于宽度计算
    /// </summary>
    private int _pageLayout = 2;

    #region Init
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _pageLayout = PageCascading?.PageLayout ?? 2;
        Init();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateDimensions();
            //设置拖拽图像（自定义 DragImage）：使用跟随鼠标的克隆覆盖层实现平滑跟手。
            //改由 JS 在 requestAnimationFrame 中直接更新覆盖层 transform，避免通过 Blazor 逐个 drag 事件渲染带来的跟随延迟。
            try { await JSRuntime.InvokeVoidAsync("elementUtils.attachDragImage", itemRef, Component?.Label ?? "组件"); } catch { }
            RegisterEventDispatcher();
        }
    }

    private async Task UpdateDimensions()
    {
        try
        {
            dimensions = await JSRuntime.InvokeAsync<DragDropElementDimensions>("elementUtils.getDimensions", itemRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting element dimensions: {ex.Message}");
        }
    }

    private void Init()
    {
        if (Component == null)
            throw new NullReferenceException(nameof(Component));
    }

    private void RegisterEventDispatcher()
    {
        if (IsInRootContainer)
        {
            //订阅 PageSetting 中的组件点击事件
            BlazorEventDispatcher.Subscribe("designengine.pagesetting.pagelayout.onchange", (value) =>
            {
                if (value != null)
                {
                    var newLayout = (int)value;
                    PageCascading.PageLayout = newLayout;
                    _pageLayout = newLayout;
                    // 使用InvokeAsync确保在正确的线程上下文中执行
                    InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    private void SetClassMap()
    {
    }
    #endregion

    #region Event
    private void OnClick()
    {
        Component.DesignState.DragEffectStyle = string.Empty;
        Component.DesignState.AnimationTransform = string.Empty;
        Component.DesignState.IsAnimating = false;

        //重置所有组件的动画状态
        ResetAllAnimationStates();

        OnItemClick.Invoke(Component);
        // 使用InvokeAsync确保在正确的线程上下文中执行
        InvokeAsync(() => BlazorEventDispatcher.Publish("designengine.draggableitem.onclick", Component));
    }

    private void OnDragStart(DragEventArgs dragEventArgs)
    {
        //注意：此处不要立即设置 isDragging=true。
        //isDragging 会改变被拖拽元素自身的 position/opacity/pointer-events 等内联样式，
        //而在 dragstart 处理过程中同步改动拖拽源节点会导致浏览器立即取消原生拖拽
        //（表现为 dragstart 后立刻触发 dragend，drag/dragover 均不触发，让位动画失效）。
        //因此将 isDragging 的置位推迟到首个 drag 事件（此时原生拖拽已开始，改动源节点不会中断拖拽）。
        initialX = dragEventArgs.ClientX;
        initialY = dragEventArgs.ClientY;
        Console.WriteLine($"拖拽开始:{initialX}-{initialY}");

        //记录当前选中对象
        DragDropStateService.SetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId, Component);
        //拖拽开始前，清理兄弟组件残留动画，避免初始闪烁
        ClearSiblingAnimation();
    }

    private void OnDragEnter(DragEventArgs dragEventArgs)
    {
        // 更新最后悬停目标，但避免全量重置以防频繁进出同一目标导致闪烁
        DragDropStateService.SetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId, Component);
        SetDropIndicator();
    }

    private void OnDragOver(DragEventArgs dragEventArgs)
    {
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(currentDragComponent, Component))
            return;

        var lastDragOverComponent = DragDropStateService.GetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId);

        // 只有当拖拽到不同组件时才触发让位动画，避免连续拖拽问题
        if (!ReferenceEquals(lastDragOverComponent, Component))
        {
            // 先清理之前的动画状态
            ClearSiblingAnimation();

            // 更新最后拖拽经过的组件
            DragDropStateService.SetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId, Component);
        }

        TriggerSiblingAnimation();
    }

    private void OnDragLeave()
    {
        //如果当前被拖拽的组件和拖拽到上面的组件是同一个，直接返回
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(currentDragComponent, Component))
            return;

        Component.DesignState.DragEffectStyle = string.Empty;
        Component.DesignState.ShowDropIndicator = false;
        Component.RefreshState();

        //清理让位动画
        //ClearSiblingAnimation();
    }

    private void OnDragEnd(DragEventArgs e)
    {
        isDragging = false;
        Console.WriteLine("拖拽结束");
        initialX = 0;
        initialY = 0;

        // 清理所有拖动相关的样式和状态
        Component.DesignState.DragEffectStyle = string.Empty;
        Component.DesignState.AnimationTransform = string.Empty;
        Component.DesignState.IsAnimating = false;
        Component.DesignState.ShowDropIndicator = false;
        //重置所有组件的动画状态
        ResetAllAnimationStates();
    }

    private void OnDrag(DragEventArgs dragEventArgs)
    {
        //原生拖拽已开始后再置位 isDragging，避免在 dragstart 阶段改动源节点导致拖拽被取消
        //跟随鼠标的平滑动画由 JS 覆盖层（elementUtils.attachDragImage）处理，
        //此处不再通过 Blazor 逐事件设置 transform（逐事件渲染会导致明显的跟随延迟）。
        if (!isDragging)
            isDragging = true;
    }

    private void OnMouseOver()
    {
        // hover 边框由 CSS 处理，此处不再设置 outline
    }

    private void OnMouseOut()
    {
        // hover 边框由 CSS 处理，此处不再清除 outline
    }

    private void TriggerCurrentSiblingAnimation(double clientX, double clientY)
    {
        if (!isDragging) return;

        // 计算相对于初始位置的偏移量
        var dragOffsetX = clientX - initialX;
        var dragOffsetY = clientY - initialY;

        Console.WriteLine($"dragOffset:{dragOffsetX}-{dragOffsetY}");

        // 优化：只有当偏移量发生变化时才更新，避免不必要的重渲染
        if (Math.Abs(dragOffsetX) < 2 && Math.Abs(dragOffsetY) < 2)
            return;

        // 使用 transform3d 优化性能，触发 GPU 加速，添加 will-change 提示浏览器优化
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (currentDragComponent != null)
        {
            currentDragComponent.DesignState.AnimationTransform = $"translate3d({dragOffsetX}px, {dragOffsetY}px, 0)";
            currentDragComponent.DesignState.IsAnimating = true;
            currentDragComponent.RefreshState();
        }
    }

    private void OnDelete()
    {
        OnItemDelete.Invoke(Component);
    }

    private void OnCopy()
    {
        OnItemCopy.Invoke(Component);
    }
    #endregion

    #region Animation Methods
    /// <summary>
    /// 设置当前组件为放置指示目标，并清除其他兄弟组件的指示线
    /// </summary>
    private void SetDropIndicator()
    {
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(currentDragComponent, Component))
            return;

        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        if (rootComponent?.Childrens != null)
        {
            foreach (var child in rootComponent.Childrens)
            {
                var show = ReferenceEquals(child, Component);
                if (child.DesignState.ShowDropIndicator != show)
                {
                    child.DesignState.ShowDropIndicator = show;
                    child.RefreshState();
                }
            }
        }
    }

    /// <summary>
    /// 重置所有组件的动画状态
    /// </summary>
    private void ResetAllAnimationStates()
    {
        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        if (rootComponent?.Childrens != null)
        {
            foreach (var child in rootComponent.Childrens)
            {
                child.DesignState.AnimationTransform = string.Empty;
                child.DesignState.IsAnimating = false;
                child.DesignState.ShowDropIndicator = false;
                child.RefreshState();
            }
        }
    }

    /// <summary>
    /// 触发兄弟组件的让位动画
    /// </summary>
    private void TriggerSiblingAnimation()
    {
        if (dimensions == null) return;

        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);

        if (rootComponent?.Childrens == null || currentDragComponent == null)
            return;

        var overIndex = rootComponent.Childrens.IndexOf(Component);
        var dragIndex = rootComponent.Childrens.IndexOf(currentDragComponent);

        if (overIndex == -1 || dragIndex == -1)
            return;

        // 计算每行可容纳的组件数量
        var itemsPerRow = Math.Floor(dimensions.ContainerWidth / dimensions.ActualWidth);
        if (itemsPerRow < 1) itemsPerRow = 1;

        foreach (var child in rootComponent.Childrens)
        {
            if (ReferenceEquals(child, currentDragComponent))
                continue;

            var childIndex = rootComponent.Childrens.IndexOf(child);
            var shouldMove = false;
            var moveDistanceX = 0.0;
            var moveDistanceY = 0.0;

            if (dragIndex > overIndex)    //往前拖拽,向后移动
            {
                if (childIndex >= overIndex && childIndex < dragIndex)
                {
                    shouldMove = true;

                    var isChangeRow = (childIndex + 1) % itemsPerRow == 0;
                    if (!isChangeRow)
                    {
                        // 同行移动
                        moveDistanceX = dimensions.ActualWidth;
                    }
                    else
                    {
                        // 跨行移动
                        moveDistanceX = -(itemsPerRow - 1) * dimensions.ActualWidth;
                        moveDistanceY = dimensions.ActualHeight;
                    }
                }
            }
            else    //往后拖拽,向前移动
            {
                if (childIndex > dragIndex && childIndex <= overIndex)
                {
                    shouldMove = true;

                    var isChangeRow = (childIndex + 1) % itemsPerRow == 1;
                    if (!isChangeRow)
                    {
                        // 同行移动
                        moveDistanceX = -dimensions.ActualWidth;
                    }
                    else
                    {
                        // 跨行移动
                        moveDistanceX = (itemsPerRow - 1) * dimensions.ActualWidth;
                        moveDistanceY = -dimensions.ActualHeight;
                    }
                }
            }

            if (shouldMove)
            {
                // 使用 translate3d 优化性能，触发 GPU 加速
                if (moveDistanceY != 0)
                {
                    child.DesignState.AnimationTransform = $"translate3d({moveDistanceX}px, {moveDistanceY}px, 0)";
                }
                else
                {
                    child.DesignState.AnimationTransform = $"translate3d({moveDistanceX}px, 0, 0)";
                }
                child.DesignState.IsAnimating = true;
                child.RefreshState();
            }
        }
    }

    /// <summary>
    /// 清理兄弟组件的让位动画
    /// </summary>
    private void ClearSiblingAnimation()
    {
        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        if (rootComponent?.Childrens != null)
        {
            var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
            foreach (var child in rootComponent.Childrens)
            {
                if (!ReferenceEquals(child, currentDragComponent))
                {
                    child.DesignState.AnimationTransform = string.Empty;
                    child.DesignState.IsAnimating = false;
                    child.RefreshState();
                }
            }
        }
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (IsInRootContainer)
            {
                BlazorEventDispatcher.Remove("designengine.pagesetting.pagelayout.onchange");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing DraggableItem: {ex.Message}");
        }
    }
}
