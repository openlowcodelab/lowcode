@namespace H.LowCode.DesignEngine
@inherits LowCodeComponentBase

@inject IComponentLibraryAppService ComponentLibraryAppService
@inject IComponentPartsAppService ComponentPartsAppService

<div class="componentpanel-layout">
    @* 左侧垂直图标栏 *@
    <div class="componentpanel-iconbar">
        <div class="iconbar-item @(_activeTab == "1" ? "active" : "")" @onclick='() => _activeTab = "1"' title="组件库">
            <span class="iconbar-icon">📦</span>
        </div>
        <div class="iconbar-item @(_activeTab == "2" ? "active" : "")" @onclick='() => _activeTab = "2"' title="数据源">
            <span class="iconbar-icon">🗃</span>
        </div>
        <div class="iconbar-item @(_activeTab == "3" ? "active" : "")" @onclick='() => _activeTab = "3"' title="在线编码">
            <span class="iconbar-icon">💻</span>
        </div>
    </div>

    @* 右侧内容区 *@
    <div class="componentpanel-content">
        @if (_activeTab == "1")
        {
            @* Tab 页：组件库 / 页面库 *@
            <div class="componentpanel-tabs">
                <div class="tab-header">
                    <div class="tab-item @(_activeInnerTab == "11" ? "active" : "")" @onclick='() => _activeInnerTab = "11"'>组件库</div>
                    <div class="tab-item @(_activeInnerTab == "12" ? "active" : "")" @onclick='() => _activeInnerTab = "12"'>页面库</div>
                </div>
                <div class="tab-body">
                    @if (_activeInnerTab == "11")
                    {
                        <div class="tab-content-scroll">
                            @if (ComponentsByLibrary != null && ComponentsByLibrary.Count > 0)
                            {
                                @foreach (var libraryGroup in ComponentsByLibrary)
                                {
                                    <details open="@(libraryGroup.Key == "antdesign" || libraryGroup.Key == "common")">
                                        <summary>@libraryGroup.Key</summary>
                                        <div class="component-grid">
                                            @if (libraryGroup.Value != null)
                                            {
                                                @foreach (var component in libraryGroup.Value)
                                                {
                                                    <DragItem Component="component"></DragItem>
                                                }
                                            }
                                        </div>
                                    </details>
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <div class="empty-icon"></div>
                                    <div>暂无组件</div>
                                </div>
                            }
                        </div>
                    }
                    @if (_activeInnerTab == "12")
                    {
                        <div class="tab-content-scroll">
                            <div class="empty-state">
                                <div class="empty-icon">📄</div>
                                <div>暂无页面</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (_activeTab == "2")
        {
            <div class="placeholder-content">
                <div class="empty-icon">🗃</div>
                <div>数据源</div>
            </div>
        }
        @if (_activeTab == "3")
        {
            <div class="placeholder-content">
                <div class="empty-icon">💻</div>
                <div>在线编码</div>
            </div>
        }
    </div>
</div>

@code {
    private string _activeTab = "1";
    private string _activeInnerTab = "11";

    /// <summary>
    /// 按组件库分组的组件集合
    /// Key: 组件库名称, Value: 该库的组件列表
    /// </summary>
    [PersistentState]
    public Dictionary<string, List<ComponentPartsSchema>> ComponentsByLibrary { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // 先尝试获取所有组件库
        var libraries = await ComponentLibraryAppService.GetListAsync();

        if (libraries != null && libraries.Count > 0)
        {
            // 为每个库加载组件，并按库分组
            ComponentsByLibrary = new Dictionary<string, List<ComponentPartsSchema>>();

            foreach (var lib in libraries)
            {
                var components = await ComponentPartsAppService.GetAllComponentsAsync(lib.LibraryId);
                if (components != null && components.Count > 0)
                {
                    ComponentsByLibrary[lib.LibraryId] = new List<ComponentPartsSchema>(components);
                }
            }
        }
    }
}
