@page "/designengine/solutions"
@namespace H.LowCode.Workbench
@inherits LowCodePageComponentBase
@layout WorkbenchNavLayout

<PageTitle>解决方案 - H.LowCode</PageTitle>

<style>
    .solution-banner {
        text-align: center;
        height: 160px;
        line-height: 160px;
        overflow: hidden;
        margin: -20px -20px 10px -20px;
        background-size: 100% 160px;
    }

    .solution-card {
        flex: 1 1 260px;
        max-width: 320px;
    }
</style>

<div class="solution-banner">
    <div style="font-size: 24px; font-weight: bold;">
        <span>低代码平台</span>
        <span style="color: white; -webkit-text-fill-color: transparent;
                background: -webkit-linear-gradient(360deg, #0089ff 30%, #30e724);
                background-clip: text; -webkit-background-clip: text;">解决方案</span>
    </div>
</div>

@code {
    private string _activeTab = "tab_template_app";
}

<div class="page-container">
    <div class="tabs-header">
        <button class='tab-btn @(_activeTab == "tab_solution_industry" ? "active" : "")' @onclick='() => _activeTab = "tab_solution_industry"'>行业解决方案</button>
        <button class='tab-btn @(_activeTab == "tab_template_integration" ? "active" : "")' @onclick='() => _activeTab = "tab_template_integration"'>集成解决方案</button>
        <button class='tab-btn @(_activeTab == "tab_template_capabilities" ? "active" : "")' @onclick='() => _activeTab = "tab_template_capabilities"'>开放能力</button>
    </div>
    <div class="tab-content">
        @if (_activeTab == "tab_solution_industry")
        {
            <div class="h-card-grid">
                <HCard Title="智慧医院" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="餐饮连锁" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="酒店行业" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
            </div>
        }
        else if (_activeTab == "tab_template_integration")
        {
            <div class="h-card-grid">
                <HCard Title="微信集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="钉钉集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="飞书集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="页面集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="数据集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="流程审批集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="报表集成" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
            </div>
        }
        else if (_activeTab == "tab_template_capabilities")
        {
            <div class="h-card-grid">
                <HCard Title="JAVA SDK" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
                <HCard Title="个性化定制" Class="solution-card">
                    <a href="#">查看</a>
                    <p>Card content</p>
                </HCard>
            </div>
        }
    </div>
</div>