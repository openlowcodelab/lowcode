@namespace H.LowCode.DesignEngineBase
@inherits LowCodeComponentBase

@if (DataSource != null)
{
    <div class="flex" style="margin-bottom: 8px;">
        <span>
            <select class="sel" @bind="DataSource.Method" style="width: 100px;">
                <option value="GET">GET</option>
                <option value="POST">POST</option>
                <option value="PUT">PUT</option>
                <option value="DELETE">DELETE</option>
            </select>
        </span>
        <input class="inp" @bind="DataSource.Path" style="flex: 1;" />
    </div>
    <div class="tabs-header">
        <button class='@(_activeTab == "Query" ? "tab-btn active" : "tab-btn")' @onclick='() => _activeTab = "Query"'>Query</button>
        <button class='@(_activeTab == "Headers" ? "tab-btn active" : "tab-btn")' @onclick='() => _activeTab = "Headers"'>Headers</button>
        <button class='@(_activeTab == "Body" ? "tab-btn active" : "tab-btn")' @onclick='() => _activeTab = "Body"'>Body</button>
        <button class='@(_activeTab == "Auth" ? "tab-btn active" : "tab-btn")' @onclick='() => _activeTab = "Auth"'>Auth</button>
        <button class='@(_activeTab == "设置" ? "tab-btn active" : "tab-btn")' @onclick='() => _activeTab = "设置"'>设置</button>
    </div>
    @if (_activeTab == "Query")
    {
        <APIParamsList APIParams="@DataSource.Queries"></APIParamsList>
    }
    @if (_activeTab == "Headers")
    {
        <APIParamsList APIParams="@DataSource.Headers"></APIParamsList>
    }
    @if (_activeTab == "Body")
    {
        <label>数据类型：</label>
        <div class="radio-group">
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.None)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.None' /> None</label>
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.Json)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.Json' /> Json</label>
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.Text)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.Text' /> Text</label>
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.Raw)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.Raw' /> Raw</label>
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.Multipart)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.Multipart' /> Multipart</label>
            <label class="radio-label"><input type="radio" name="body-type" checked='@(DataSource.Body.DataType == APIBodyTypeEnum.Baniry)' @onchange='() => DataSource.Body.DataType = APIBodyTypeEnum.Baniry' /> Binary</label>
        </div>
        @if(DataSource.Body.DataType == APIBodyTypeEnum.None)
        {
            <textarea class="ta" disabled rows="10" style="margin-top:10px;"></textarea>
        }
        else if (DataSource.Body.DataType == APIBodyTypeEnum.Json
          || DataSource.Body.DataType == APIBodyTypeEnum.Text
          || DataSource.Body.DataType == APIBodyTypeEnum.Raw)
        {
            <textarea class="ta" @bind="DataSource.Body.Value" rows="10" style="margin-top:10px;"></textarea>
        }
        else if (DataSource.Body.DataType == APIBodyTypeEnum.Multipart)
        {
            <APIParamsList APIParams="@DataSource.Body.MultipartParams"></APIParamsList>
        }
        else if (DataSource.Body.DataType == APIBodyTypeEnum.Baniry)
        {

        }
    }
    @if (_activeTab == "Auth")
    {

    }
    @if (_activeTab == "设置")
    {

    }
}

@code {
    [Parameter]
    public APIDataSourceSchema DataSource { get; set; }

    [Parameter]
    public EventCallback<APIDataSourceSchema> DataSourceChanged { get; set; }

    private string _activeTab = "Query";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (DataSource == null)
        {
            DataSource = new();
        }
    }
}
