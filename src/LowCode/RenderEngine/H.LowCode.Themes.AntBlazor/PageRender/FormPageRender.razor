@namespace H.LowCode.Themes.AntBlazor
@inherits RenderEngineLowCodeComponentBase

@inject IFormDataAppService FormDataAppService
@inject IFormValidationAppService FormValidationAppService

@if (_formDto != null)
{
    <form @onsubmit="OnFinishAsync" @onsubmit:preventDefault>
        @foreach (var component in Page.Components)
        {
            <FormComponentRender Component="@component" IsInRootContainer="true"></FormComponentRender>
        }

        <div class="form-item" style="clear:both; padding-top: 15px;">
            <button class="btn btn-primary" type="submit">
                保存
            </button>
            <button class="btn btn-default" type="button" style="margin: 0 8px">
                取消
            </button>
        </div>
    </form>
}

@code {
    [Parameter]
    public PageSchema Page { get; set; }

    [PersistentState]
    public FormDataDto _formDto { get; set; }

    private string? Id;
    public Dictionary<string, object?> _fieldDictData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Id = GetQueryValue("id");
        if (string.IsNullOrEmpty(Id))
        {
            _formDto = new FormDataDto
            {
                Name = Page?.DataSource?.DataSourceValue,
                Fields = Page.Components
                    .Where(t => t.IsContainer == false)
                    .Select(t => new FormFieldDto
                    {
                        Name = t.Name,
                        TypeName = t.Fragment.ValueType,
                        Value = t.Fragment.GetDefaultValue()
                    }).ToList()
            };
        }
        else
        {
            _formDto = (await FormDataAppService.GetAsync(Page.AppId, Page.Id, Id)).Data;
        }

        _fieldDictData = (_formDto.Fields == null)
            ? new Dictionary<string, object?>()
            : _formDto.Fields.ToDictionary(x => x.Name, x => x.Value);
    }

    private async Task OnFinishAsync()
    {
        if (_formDto == null)
            return;

        // 执行表单校验
        var validationResult = FormValidationAppService.ValidateForm(_fieldDictData, Page.Components.Cast<ComponentSchemaBase>().ToList()).Data!;
        if (!validationResult.IsValid)
        {
            var errorMessage = string.Join("\n", validationResult.ErrorMessages);
            await Message.ErrorAsync($"表单校验失败：\n{errorMessage}");
            return;
        }

        foreach (var field in _formDto.Fields)
        {
            if (!_fieldDictData.ContainsKey(field.Name))
                continue;

            field.Value = _fieldDictData[field.Name];
        }
        
        try
        {
            var success = (await FormDataAppService.SaveAsync(_formDto)).Data == true;
            if (success)
                await Message.SuccessAsync("保存成功");
            else
                await Message.ErrorAsync("保存失败");
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"保存时发生错误：{ex.Message}");
        }
    }

    private void OnFinishFailed(EditContext editContext)
    {

    }

    /// <summary>
    /// 用于 FormDataState 的 key（每个页面每个数据独立缓存）
    /// </summary>
    /// <returns></returns>
    public override string ToString()
    {
        return $"{base.ToString()}-{Page.AppId}-{Page.Id}-{Id}";
    }
}