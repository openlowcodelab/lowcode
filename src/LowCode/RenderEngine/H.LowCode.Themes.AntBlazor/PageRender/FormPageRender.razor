@namespace H.LowCode.Themes.AntBlazor
@inherits RenderEngineLowCodeComponentBase

@inject IFormDataAppService FormDataAppService
@inject PageFormStateService FormState

@if (_formDto != null)
{
    <form @onsubmit="OnFinishAsync" @onsubmit:preventDefault>
        <div class="renderengine-page-root" style="@(Page.PageProperty?.DefaultStyle) @(Page.PageProperty?.CustomStyle)">
        @foreach (var component in Page.Components)
        {
            <FormComponentRender Component="@component" IsInRootContainer="true"></FormComponentRender>
        }
        </div>

        @if (!_hasCustomActions)
        {
            <div class="form-item" style="clear:both; padding-top: 15px;">
                <button class="btn btn-primary" type="submit">
                    保存
                </button>
                <button class="btn btn-default" type="button" style="margin: 0 8px">
                    取消
                </button>
            </div>
        }
    </form>
}

@code {
    [Parameter]
    public PageSchema Page { get; set; }

    [PersistentState]
    public FormDataDto _formDto { get; set; }

    private string? Id;
    public Dictionary<string, object?> _fieldDictData;

    // 页面已配置自定义操作按钮时，隐藏默认保存/取消按钮
    private bool _hasCustomActions;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _hasCustomActions = HasCustomActions(Page?.Components);

        Id = GetQueryValue("id");
        var templateId = GetQueryValue("templateId");
        if (!string.IsNullOrEmpty(Id))
        {
            _formDto = (await FormDataAppService.GetAsync(Page.AppId, Page.Id, Id)).Data;
        }
        else if (!string.IsNullOrEmpty(templateId))
        {
            // 从已有记录复制创建：加载源记录作为初始值，但移除主键以新记录保存
            _formDto = (await FormDataAppService.GetAsync(Page.AppId, Page.Id, templateId)).Data;
            RemovePrimaryKeyField();
        }
        else
        {
            _formDto = new FormDataDto
            {
                Name = PageCascading?.DataSourceName ?? Page?.DataSource?.DataSourceValue,
                Fields = Page.Components
                    .Where(t => t.IsContainer == false && !string.IsNullOrEmpty(t.Fragment?.ValueType))
                    .Select(t => new FormFieldDto
                    {
                        Name = t.Name,
                        TypeName = t.Fragment.ValueType,
                        Value = t.Fragment.GetDefaultValue()
                    }).ToList()
            };
        }

        _fieldDictData = (_formDto.Fields == null)
            ? new Dictionary<string, object?>()
            : _formDto.Fields.ToDictionary(x => x.Name, x => x.Value);

        // 将初始值回填到表单状态，供组件值绑定与提交收集使用
        foreach (var kv in _fieldDictData)
        {
            FormState.SetValueSilently(kv.Key, kv.Value);
        }
    }

    /// <summary>
    /// 移除主键字段（从已有记录复制创建时以新记录保存）
    /// </summary>
    private void RemovePrimaryKeyField()
    {
        if (_formDto?.Fields == null)
            return;

        var pkField = _formDto.Fields.FirstOrDefault(f => f.Name == "f_id");
        if (pkField != null)
            _formDto.Fields.Remove(pkField);
    }

    /// <summary>
    /// 判断页面组件树中是否存在已配置事件的组件
    /// </summary>
    private static bool HasCustomActions(IList<ComponentSchema>? components)
    {
        if (components == null)
            return false;

        foreach (var component in components)
        {
            if (component.Events != null && component.Events.Count > 0)
                return true;

            if (component.Childrens != null && HasCustomActions(component.Childrens.ToList()))
                return true;

            if (component.DataSource?.ItemTemplate != null)
            {
                var itemTemplate = component.DataSource.ItemTemplate;
                if (itemTemplate.Events != null && itemTemplate.Events.Count > 0)
                    return true;
                if (itemTemplate.Childrens != null && HasCustomActions(itemTemplate.Childrens.ToList()))
                    return true;
            }
        }

        return false;
    }

    private async Task OnFinishAsync()
    {
        if (_formDto == null)
            return;

        // 提交前从表单状态收集用户输入值
        foreach (var kv in _fieldDictData.Keys.ToList())
        {
            if (FormState.HasValue(kv))
                _fieldDictData[kv] = FormState.GetValue(kv);
        }

        // 执行表单校验（逐字段调用校验服务）
        var validationErrors = new List<string>();
        await ValidateComponentsAsync(Page.Components, validationErrors);
        if (validationErrors.Count > 0)
        {
            Toast.Error($"表单校验失败：\n{string.Join("\n", validationErrors)}");
            return;
        }

        foreach (var field in _formDto.Fields)
        {
            if (!_fieldDictData.ContainsKey(field.Name))
                continue;

            field.Value = _fieldDictData[field.Name];
        }
        
        try
        {
            var savedId = (await FormDataAppService.SaveAsync(_formDto)).Data;
            if (!string.IsNullOrEmpty(savedId))
                Toast.Success("保存成功");
            else
                Toast.Error("保存失败");
        }
        catch (Exception ex)
        {
            Toast.Error($"保存时发生错误：{ex.Message}");
        }
    }

    private void OnFinishFailed(EditContext editContext)
    {

    }

    /// <summary>
    /// 递归校验组件树（字段值优先取表单状态）
    /// </summary>
    private async Task ValidateComponentsAsync(IEnumerable<ComponentSchema> components, List<string> errors)
    {
        foreach (var component in components)
        {
            if (component.ValidationRules != null && component.ValidationRules.Count > 0)
            {
                var key = component.Name ?? component.Id;
                object? value = FormState.HasValue(key)
                    ? FormState.GetValue(key)
                    : (_fieldDictData.TryGetValue(key, out var fieldValue) ? fieldValue : null);

                var result = FieldValidator.Validate(value, component.ValidationRules);
                if (!result.IsValid)
                {
                    errors.Add($"{component.Label ?? key}: {result.ErrorMessage}");
                }
            }

            if (component.Childrens != null && component.Childrens.Length > 0)
            {
                await ValidateComponentsAsync(component.Childrens, errors);
            }
        }
    }

    /// <summary>
    /// 用于 FormDataState 的 key（每个页面每个数据独立缓存）
    /// </summary>
    /// <returns></returns>
    public override string ToString()
    {
        return $"{base.ToString()}-{Page.AppId}-{Page.Id}-{Id}";
    }
}