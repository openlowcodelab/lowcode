@namespace H.LowCode.RenderEngine
@inherits RenderEngineLowCodeComponentBase

<div class="renderengine-componentcontainer" style="@ContainerComponent.Style.DefaultStyle @ContainerComponent.Style.CustomStyle">
    @if (ContainerComponent.Childrens != null)
    {
        foreach (var comp in ContainerComponent.Childrens)
        {
            <div class="renderengine-componentcontainer-item" style="min-height: @(comp.Style.ItemHeight)px;
                width: @((comp.Style.ItemWidth > 4 ? comp.Style.ItemWidth : 24) /24 * 100)%;
                box-sizing: border-box;
                @comp.Style.DefaultStyle @comp.Style.CustomStyle">
                <ComponentRender Component="@comp"></ComponentRender>
            </div>
        }

    }
</div>

@code {
    [Parameter]
    public ComponentSchema ContainerComponent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
}