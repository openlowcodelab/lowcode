@namespace H.Assistant.Web

<select class="model-select-dropdown"
        value="@Value"
        @onchange="OnChanged">
    @if (Models.Any())
    {
        @foreach (var model in Models)
        {
            <option value="@(model.Id)">
                @model.ProviderDisplayName (@model.Model)
            </option>
        }
    }
    else
    {
        <option value="">未配置模型</option>
    }
</select>

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public List<LLMDto> Models { get; set; } = new();

    private async Task OnChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}

<style>
    .model-selector-label {
        font-size: 13px;
        color: #595959;
        font-weight: 500;
        white-space: nowrap;
    }

    .model-select-dropdown {
        height: 34px;
        padding: 4px 11px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        font-size: 13px;
        color: #262626;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
        cursor: pointer;
        min-width: 200px;
    }

    .model-select-dropdown:focus {
        border-color: #a6a6a6;
        box-shadow: 0 0 0 2px rgba(166, 166, 166, 0.1);
    }
</style>
