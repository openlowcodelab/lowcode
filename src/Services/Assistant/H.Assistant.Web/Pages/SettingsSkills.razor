@page "/assistant/settings-skills"

@layout AssistantLayout
@inject ISkillAppService SkillDefinitionAppService
@inject NavigationManager Navigation

<PageTitle>设置 - Agent 助手</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">
        @toastMessage
    </div>
}

<div class="settings-container">
    <div class="settings-sidebar">
        <div class="sidebar-header">
            <button class="btn back-btn" @onclick="GoBack">
                @IconSvg("arrow-left") 返回
            </button>
        </div>
        <div class="sidebar-menu">
            @foreach (var item in menuItems)
            {
                <div class="menu-item @(IsActive(item.Url) ? "active" : "")"
                     @onclick="() => Navigation.NavigateTo(item.Url)">
                    @IconSvg(item.Icon)
                    <span>@item.Label</span>
                </div>
            }
        </div>
    </div>

    <div class="settings-content">
        <div class="content-header">
            <h2>技能管理</h2>
        </div>

        <!-- Skill/Tool 选项卡 -->
        <div class="tab-nav">
            <div class="tab-item @(selectedSkillTab == "skill" ? "active" : "")" @onclick="@(() => selectedSkillTab = "skill")">
                Skill 列表
            </div>
            <div class="tab-item @(selectedSkillTab == "tool" ? "active" : "")" @onclick="@(() => selectedSkillTab = "tool")">
                Tool 列表
            </div>
        </div>

        @if (selectedSkillTab == "skill")
        {
            <div class="content-header" style="margin-top: 16px;">
                <button class="btn btn-primary assistant-btn-primary btn-small" @onclick="ShowAddSkill">
                    @IconSvg("plus") 添加
                </button>
            </div>
            <div class="skill-list">
            @if (loadingSkills)
            {
                <div class="loading-spinner"><div class="spinner"></div><span>加载中...</span></div>
            }
            else if (skills.Any())
            {
                @foreach (var skill in skills)
                {
                    <div class="model-card">
                        <div class="model-card-header">
                            <div class="model-name">
                                <strong>@skill.DisplayName</strong>
                                <span class="tag tag-blue">@skill.SkillName</span>
                                @if (skill.IsEnabled)
                                {
                                    <span class="tag tag-green">已启用</span>
                                }
                                else
                                {
                                    <span class="tag tag-default">已禁用</span>
                                }
                            </div>
                            <div class="model-actions">
                                <button class="btn btn-link btn-small" @onclick="@(() => ToggleSkill(skill))">
                                    @(skill.IsEnabled ? "禁用" : "启用")
                                </button>
                                <button class="btn btn-link btn-small" @onclick="@(() => EditSkill(skill))">编辑</button>
                                <button class="btn btn-link btn-small btn-danger" @onclick="@(() => DeleteSkill(skill.Id))">删除</button>
                            </div>
                        </div>
                        <div class="model-card-body">
                            <div class="model-info-row">
                                <span class="info-label">类型:</span>
                                <span>@skill.SkillType</span>
                            </div>
                            <div class="model-info-row">
                                <span class="info-label">描述:</span>
                                <span>@skill.Description</span>
                            </div>
                            @if (!string.IsNullOrEmpty(skill.ImplementationClass))
                            {
                                <div class="model-info-row">
                                    <span class="info-label">实现类:</span>
                                    <span class="code-text">@skill.ImplementationClass</span>
                                </div>
                            }
                            <div class="model-info-row">
                                <span class="info-label">使用次数:</span>
                                <span>@skill.UsageCount</span>
                                @if (skill.LastUsedTime.HasValue)
                                {
                                    <span class="info-label" style="margin-left:16px;">最后使用:</span>
                                    <span>@skill.LastUsedTime.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">@IconSvg("inbox")</div>
                    <div class="empty-text">暂无技能，点击添加按钮新增</div>
                </div>
            }
        </div>
        }
        else
        {
            <!-- Tool 列表 -->
            <div class="tool-list">
                @if (loadingSkills)
                {
                    <div class="loading-spinner"><div class="spinner"></div><span>加载中...</span></div>
                }
                else if (tools.Any())
                {
                    @foreach (var tool in tools)
                    {
                        <div class="model-card">
                            <div class="model-card-header">
                                <div class="model-name">
                                    <strong>@tool.ClassName</strong>
                                    @if (tool.IsEnabled)
                                    {
                                        <span class="tag tag-green">已启用</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-default">已禁用</span>
                                    }
                                </div>
                            </div>
                            <div class="model-card-body">
                                <div class="model-info-row">
                                    <span class="info-label">描述:</span>
                                    <span>@tool.Description</span>
                                </div>
                                <div class="model-info-row">
                                    <span class="info-label">实现类:</span>
                                    <span class="code-text">@tool.FullName</span>
                                </div>
                                <div class="model-info-row">
                                    <span class="info-label">关联 Skill:</span>
                                    <span>@tool.SkillName</span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">@IconSvg("inbox")</div>
                        <div class="empty-text">暂无 Tool</div>
                    </div>
                }
            </div>
        }

        @if (showSkillDialog)
        {
            <div class="modal-overlay" @onclick="CloseSkillDialog">
                <div class="modal-dialog model-dialog" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(isEditingSkill ? "编辑技能" : "添加技能")</h3>
                        <button class="btn btn-text modal-close-btn" @onclick="CloseSkillDialog">
                            @IconSvg("close")
                        </button>
                    </div>
                    <div class="modal-body">
                        @if (!isEditingSkill)
                        {
                            <div class="form-item required">
                                <label>* 技能名称</label>
                                <input class="modal-input" @bind="@editSkill.SkillName" placeholder="英文标识，如 weather_query" />
                            </div>
                        }
                        <div class="form-item required">
                            <label>* 显示名称</label>
                            <input class="modal-input" @bind="@editSkill.DisplayName" placeholder="如：天气查询" />
                        </div>
                        <div class="form-item required">
                            <label>* 描述</label>
                            <textarea class="modal-input modal-textarea" @bind="@editSkill.Description" placeholder="描述技能的功能，AI 会根据描述自动选择使用此技能"></textarea>
                        </div>
                        <div class="form-item required">
                            <label>* 类型</label>
                            <select class="modal-select" @bind="@editSkill.SkillType">
                                <option value="Function">Function (函数调用)</option>
                                <option value="Plugin">Plugin (插件)</option>
                                <option value="Workflow">Workflow (工作流)</option>
                            </select>
                        </div>
                        <div class="form-item">
                            <label>实现类</label>
                            <input class="modal-input" @bind="@editSkill.ImplementationClass" placeholder="完整类名，如 H.Assistant.Core.Tools.WeatherTool" />
                        </div>
                        <div class="form-item">
                            <label>配置 (JSON)</label>
                            <textarea class="modal-input modal-textarea" @bind="@editSkill.Config" placeholder='可选，如 {"api_key": "xxx"}'></textarea>
                        </div>
                        <div class="form-item">
                            <label>参数 Schema (JSON)</label>
                            <textarea class="modal-input modal-textarea" @bind="@editSkill.ParameterSchema" placeholder='可选，JSON Schema 格式'></textarea>
                        </div>
                        <div class="form-item">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="@editSkill.IsEnabled" />
                                启用
                            </label>
                        </div>
                        <div class="form-item">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="@editSkill.RequiresApproval" />
                                需要审批
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="modal-btn-cancel" @onclick="CloseSkillDialog">取消</button>
                        <button class="modal-btn-primary" @onclick="SaveSkill" disabled="@savingSkill">
                            @(isEditingSkill ? "保存" : "添加")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool loadingSkills;
    private bool savingSkill;
    private bool showSkillDialog;
    private bool isEditingSkill;
    private List<SkillDto> skills = new();
    private List<ToolDisplayInfo> tools = new();
    private string selectedSkillTab = "skill";
    private SkillEditModel editSkill = new();

    private string toastMessage = string.Empty;
    private string toastType = "info";
    private bool toastVisible;

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private record MenuItemDef(string Key, string Label, string Icon, string Url);
    private readonly List<MenuItemDef> menuItems = new()
    {
        new("general", "通用", "setting", "/assistant/settings"),
        new("agent", "智能体", "robot", "/assistant/settings-agents"),
        new("skill", "技能", "thunderbolt", "/assistant/settings-skills"),
        new("model", "模型", "api", "/assistant/settings-llms"),
        new("mcp", "MCP", "plug", "/assistant/settings-mcp")
    };

    private bool IsActive(string url)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var targetPath = url.TrimStart('/').TrimEnd('/');
        return string.Equals(relativePath, targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack() { Navigation.NavigateTo("/assistant/chat"); }

    protected override async Task OnInitializedAsync()
    {
        await LoadSkills();
    }

    private async Task LoadSkills()
    {
        loadingSkills = true;
        try
        {
            var result = await SkillDefinitionAppService.GetListAsync(new SkillDefinitionQueryDto
            {
                MaxResultCount = 100
            });
            skills = result.Items.ToList();

            tools = skills
                .Where(s => !string.IsNullOrWhiteSpace(s.ImplementationClass))
                .GroupBy(s => s.ImplementationClass)
                .Select(g =>
                {
                    var first = g.First();
                    return new ToolDisplayInfo
                    {
                        ClassName = first.ImplementationClass.Split('.').Last(),
                        FullName = first.ImplementationClass,
                        Description = first.Description,
                        SkillName = string.Join(", ", g.Select(s => s.DisplayName)),
                        SkillId = first.Id,
                        IsEnabled = g.Any(s => s.IsEnabled)
                    };
                })
                .ToList();
        }
        catch (Exception ex) { ShowToast("加载技能列表失败: " + ex.Message, "error"); }
        finally { loadingSkills = false; }
    }

    private void ShowAddSkill()
    {
        isEditingSkill = false;
        editSkill = new SkillEditModel
        {
            SkillName = "",
            DisplayName = "",
            Description = "",
            SkillType = "Function",
            ImplementationClass = "",
            Config = "",
            ParameterSchema = "",
            IsEnabled = true,
            RequiresApproval = false
        };
        showSkillDialog = true;
    }

    private void EditSkill(SkillDto skill)
    {
        isEditingSkill = true;
        editSkill = new SkillEditModel
        {
            Id = skill.Id,
            SkillName = skill.SkillName,
            DisplayName = skill.DisplayName,
            Description = skill.Description,
            SkillType = skill.SkillType,
            ImplementationClass = skill.ImplementationClass ?? "",
            Config = skill.Config ?? "",
            ParameterSchema = skill.ParameterSchema ?? "",
            IsEnabled = skill.IsEnabled,
            RequiresApproval = skill.RequiresApproval
        };
        showSkillDialog = true;
    }

    private void CloseSkillDialog() { showSkillDialog = false; }

    private async Task SaveSkill()
    {
        if (string.IsNullOrWhiteSpace(editSkill.SkillName)) { ShowToast("请输入技能名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editSkill.DisplayName)) { ShowToast("请输入显示名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editSkill.Description)) { ShowToast("请输入描述", "warning"); return; }

        savingSkill = true;
        try
        {
            if (isEditingSkill)
            {
                await SkillDefinitionAppService.UpdateAsync(editSkill.Id.Value, new UpdateSkillDefinitionDto
                {
                    DisplayName = editSkill.DisplayName,
                    Description = editSkill.Description,
                    ImplementationClass = string.IsNullOrWhiteSpace(editSkill.ImplementationClass) ? null : editSkill.ImplementationClass,
                    Config = string.IsNullOrWhiteSpace(editSkill.Config) ? null : editSkill.Config,
                    ParameterSchema = string.IsNullOrWhiteSpace(editSkill.ParameterSchema) ? null : editSkill.ParameterSchema,
                    IsEnabled = editSkill.IsEnabled,
                    RequiresApproval = editSkill.RequiresApproval
                });
                ShowToast("技能已更新", "success");
            }
            else
            {
                await SkillDefinitionAppService.CreateAsync(new CreateSkillDefinitionDto
                {
                    SkillName = editSkill.SkillName.Trim().ToLower(),
                    DisplayName = editSkill.DisplayName,
                    Description = editSkill.Description,
                    SkillType = editSkill.SkillType,
                    ImplementationClass = string.IsNullOrWhiteSpace(editSkill.ImplementationClass) ? null : editSkill.ImplementationClass,
                    Config = string.IsNullOrWhiteSpace(editSkill.Config) ? null : editSkill.Config,
                    ParameterSchema = string.IsNullOrWhiteSpace(editSkill.ParameterSchema) ? null : editSkill.ParameterSchema,
                    IsEnabled = editSkill.IsEnabled,
                    RequiresApproval = editSkill.RequiresApproval
                });
                ShowToast("技能已添加", "success");
            }
            showSkillDialog = false;
            await LoadSkills();
        }
        catch (Exception ex) { ShowToast("保存失败: " + ex.Message, "error"); }
        finally { savingSkill = false; }
    }

    private async Task ToggleSkill(SkillDto skill)
    {
        try
        {
            await SkillDefinitionAppService.ToggleEnabledAsync(skill.Id, !skill.IsEnabled);
            ShowToast(skill.IsEnabled ? "技能已禁用" : "技能已启用", "success");
            await LoadSkills();
        }
        catch (Exception ex) { ShowToast("操作失败: " + ex.Message, "error"); }
    }

    private async Task DeleteSkill(Guid id)
    {
        try
        {
            await SkillDefinitionAppService.DeleteAsync(id);
            ShowToast("已删除", "success");
            await LoadSkills();
        }
        catch (Exception ex) { ShowToast("删除失败: " + ex.Message, "error"); }
    }

    private class ToolDisplayInfo
    {
        public string ClassName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Description { get; set; } = "";
        public string SkillName { get; set; } = "";
        public Guid SkillId { get; set; }
        public bool IsEnabled { get; set; }
    }

    private class SkillEditModel
    {
        public Guid? Id { get; set; }
        public string SkillName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public string SkillType { get; set; } = "Function";
        public string ImplementationClass { get; set; } = "";
        public string Config { get; set; } = "";
        public string ParameterSchema { get; set; } = "";
        public bool IsEnabled { get; set; } = true;
        public bool RequiresApproval { get; set; }
    }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);

    private static string GetIconSvg(string name) => name switch
    {
        "plus" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg>",
        "setting" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>",
        "robot" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"10\" rx=\"2\"></rect><circle cx=\"12\" cy=\"5\" r=\"2\"></circle><path d=\"M12 7v4\"></path><line x1=\"8\" y1=\"16\" x2=\"8\" y2=\"16\"></line><line x1=\"16\" y1=\"16\" x2=\"16\" y2=\"16\"></line></svg>",
        "thunderbolt" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg>",
        "arrow-left" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg>",
        "sun" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"5\"></circle><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\"></line><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\"></line><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"></line><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"></line><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"></line><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"></line><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"></line><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"></line></svg>",
        "moon" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg>",
        "close" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>",
        "inbox" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"></polyline><path d=\"M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path></svg>",
        "api" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"></polyline><polyline points=\"8 6 2 12 8 18\"></polyline></svg>",
        "plug" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2v6a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V2\"></path><path d=\"M12 10v12\"></path><path d=\"M8 22h8\"></path><path d=\"M5 2h14\"></path></svg>",
        _ => ""
    };
}

<style>
    /* ========== Settings Page ========== */
    .settings-container {
        display: flex;
        height: 100%;
        width: 100%;
    }

    .settings-sidebar {
        width: 220px;
        border-right: 1px solid #e8e8e8;
        background: #fafafa;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .sidebar-menu {
        padding: 8px;
        flex: 1;
    }

    .menu-item {
        padding: 10px 16px;
        cursor: pointer;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        margin-bottom: 4px;
        transition: background-color 0.2s;
    }

    .menu-item:hover {
        background-color: #f0f0f0;
    }

    .menu-item.active {
        background-color: #d9d9d9;
        font-weight: 500;
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .content-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .settings-form {
        max-width: 600px;
    }

    .form-section {
        margin-bottom: 32px;
    }

    .form-section h3 {
        font-size: 16px;
        margin-bottom: 16px;
        color: #262626;
    }

    .form-item {
        margin-bottom: 16px;
    }

    .form-item label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        color: #595959;
        font-weight: 500;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .form-row .form-item {
        flex: 1;
    }

    .theme-options {
        display: flex;
        gap: 8px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-item label {
        margin-bottom: 0;
    }

    /* ========== Model Cards ========== */
    .model-list {
        display: grid;
