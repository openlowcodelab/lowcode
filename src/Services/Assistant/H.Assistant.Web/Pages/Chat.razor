@page "/assistant"
@page "/assistant/chat"

@layout ChatLayout
@inject IChatMessageAppService ChatMessageAppService
@inject ILLMAppService LLMAppService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Chat - Agent 助手</PageTitle>

<!-- Right Panel - Chat Area -->
<div class="chat-main-panel">
    @if (selectedChatId.HasValue)
    {
        <div class="chat-header">
            <div class="chat-header-left">
                <span>Agent: @selectedAgent?.DisplayName</span>
            </div>
        </div>

        <div class="chat-messages" @ref="chatMessagesRef">
            @if (loadingMessages)
            {
                <div class="loading-spinner"><div class="spinner"></div><span>Loading...</span></div>
            }
            else if (messages.Any() || pendingUserMessage != null)
            {
                @foreach (var message in messages)
                {
                    <div class="message-item @(message.Role == "user" ? "user-message" : "assistant-message")">
                        <div class="message-avatar">
                            @if (message.Role == "user") { @IconSvg("user") } else { @IconSvg("robot") }
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                <MarkdownRenderer Content="@message.Content" />
                            </div>
                            <div class="message-time">@message.CreationTime.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }

                @if (pendingUserMessage != null)
                {
                    <div class="message-item user-message">
                        <div class="message-avatar">@IconSvg("user")</div>
                        <div class="message-content">
                            <div class="message-text">
                                <MarkdownRenderer Content="@pendingUserMessage.Content" />
                            </div>
                            <div class="message-time">@pendingUserMessage.CreationTime.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(streamingResponse))
                {
                    <div class="message-item assistant-message">
                        <div class="message-avatar">@IconSvg("robot")</div>
                        <div class="message-content">
                            <div class="message-text">
                                <div class="markdown-content">
                                    @((MarkupString)RenderMarkdown(streamingResponse))
                                </div>
                            </div>
                            <div class="message-time">@DateTime.Now.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><div class="empty-icon">@IconSvg("chat")</div><div class="empty-text">Start a conversation</div></div>
            }

            @if (isSending && string.IsNullOrEmpty(streamingResponse))
            {
                <div class="message-item assistant-message">
                    <div class="message-avatar">@IconSvg("robot")</div>
                    <div class="message-content">
                        <div class="message-text thinking-text">
                            <span class="thinking-dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <ChatInput @bind-Message="inputMessage"
                       @bind-SelectedAgentType="selectedAgentType"
                       @bind-SelectedProviderName="selectedProviderName"
                       AvailableAgents="availableAgents"
                       AvailableModels="availableModels"
                       IsSending="isSending"
                       OnSend="SendMessage"
                       OnStop="StopSending" />
    }
    else
    {
        <div class="new-task-container">
            <ChatInput @bind-Message="inputMessage"
                           @bind-SelectedAgentType="selectedAgentType"
                           @bind-SelectedProviderName="selectedProviderName"
                           AvailableAgents="availableAgents"
                           AvailableModels="availableModels"
                           IsSending="isSending"
                           OnSend="SendNewTask" />
        </div>
    }
</div>

@code {
    private List<ChatMessageDto> messages = new();
    private Guid? selectedChatId;
    private List<AgentConfigDto> availableAgents = new();
    private List<LLMDto> availableModels = new();
    private string selectedAgentType = "";
    private string inputMessage = string.Empty;
    private string selectedProviderName = string.Empty;
    private bool loadingMessages;
    private bool isSending;
    private bool isNewTask;
    private AgentConfigDto? selectedAgent;
    private ChatMessageDto? pendingUserMessage;
    private string streamingResponse = string.Empty;
    private ElementReference chatMessagesRef;
    private CancellationTokenSource? streamCts;
    private DotNetObjectReference<SseStreamCallbacks>? _sseCallbacksRef;

    private static readonly MarkdownPipeline _mdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseEmojiAndSmiley()
        .UseCustomContainers()
        .Build();

    private static string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        var html = Markdown.ToHtml(markdown, _mdPipeline);
        html = html.Replace("<pre><code", "<pre class=\"markdown-code-block\"><code");
        html = html.Replace("<code>", "<code class=\"markdown-inline-code\">");
        return html;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Inject JS SSE stream helper
            await JS.InvokeVoidAsync("eval", @"
                window.__chatSseStream = async function(url, body, dotNetRef) {
                    const resp = await fetch(url, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: typeof body === 'string' ? body : JSON.stringify(body),
                        credentials: 'same-origin'
                    });
                    if (!resp.ok) { await dotNetRef.invokeMethodAsync('OnSseDone'); await dotNetRef.invokeMethodAsync('OnSseError', 'HTTP ' + resp.status); return; }
                    const reader = resp.body.pipeThrough(new TextDecoderStream()).getReader();
                    let buffer = '';
                    try {
                        while (true) {
                            const { done, value } = await reader.read();
                            if (done) break;
                            buffer += value;
                            let nl;
                            while ((nl = buffer.indexOf('\n')) >= 0) {
                                const line = buffer.substring(0, nl).trimEnd();
                                buffer = buffer.substring(nl + 1);
                                if (!line.startsWith('data: ')) continue;
                                const d = line.substring(6);
                                if (d === '[DONE]') { await dotNetRef.invokeMethodAsync('OnSseDone'); return; }
                                await dotNetRef.invokeMethodAsync('OnSseChunk', d);
                            }
                        }
                        await dotNetRef.invokeMethodAsync('OnSseDone');
                    } catch(e) {
                        await dotNetRef.invokeMethodAsync('OnSseError', e.message);
                    }
                };
            ");

            await LoadAvailableAgents();
            await LoadAvailableModels();

            // Read query param for initial session selection
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var idStr = query["id"];
            if (!string.IsNullOrEmpty(idStr) && Guid.TryParse(idStr, out var id))
            {
                await SelectChat(id);
            }
            else
            {
                _ = CreateNewChat();
            }
        }
        catch (Exception ex) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Handle navigation from sidebar (page stays alive, only query param changes)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var idStr = query["id"];
        if (!string.IsNullOrEmpty(idStr) && Guid.TryParse(idStr, out var id))
        {
            if (selectedChatId != id)
            {
                await SelectChat(id);
            }
        }
        else if (!selectedChatId.HasValue)
        {
            await CreateNewChat();
        }
    }

    private async Task LoadAvailableAgents()
    {
        availableAgents = await ChatMessageAppService.GetAvailableAgentsAsync();
        selectedAgent = availableAgents.FirstOrDefault(a => a.AgentType == selectedAgentType);
    }

    private async Task LoadAvailableModels()
    {
        try
        {
            var allConfigs = await LLMAppService.GetAllAsync();
            availableModels = allConfigs.Where(c => c.IsEnabled).ToList();
            if (string.IsNullOrEmpty(selectedProviderName) && availableModels.Any())
            {
                var defaultModel = availableModels.FirstOrDefault(m => m.IsDefault) ?? availableModels.First();
                selectedProviderName = defaultModel.Id.ToString();
            }
        }
        catch (Exception ex) { availableModels = new List<LLMDto>(); await ShowToast($"Load models failed: {ex.Message}", "error"); }
    }

    private async Task SelectChat(Guid sessionId)
    {
        selectedChatId = sessionId;
        isNewTask = false;
        inputMessage = string.Empty;
        await LoadMessages(sessionId);
        StateHasChanged();
    }

    private async Task LoadMessages(Guid sessionId)
    {
        loadingMessages = true;
        try { messages = await ChatMessageAppService.GetMessagesAsync(sessionId); await ScrollToBottom(); }
        finally { loadingMessages = false; }
    }

    private async Task CreateNewChat()
    {
        selectedChatId = null;
        messages.Clear(); inputMessage = string.Empty; isNewTask = true;
        await LoadAvailableModels(); StateHasChanged();
    }

    private async Task SendNewTask()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isSending)
        {
            return;
        }

        isSending = true; var message = inputMessage; inputMessage = string.Empty;
        var newSessionTitle = message.Length > 30 ? message[..30] + "..." : message;
        pendingUserMessage = new ChatMessageDto { Id = Guid.NewGuid(), SessionId = Guid.NewGuid(), Role = "user", Content = message, CreationTime = DateTime.Now };
        streamingResponse = string.Empty; StateHasChanged(); await ScrollToBottom();
        try
        {
            var input = new SendChatMessageInputDto
                {
                    SessionId = null,
                    Message = message,
                    AgentType = string.IsNullOrEmpty(selectedAgentType) ? null : selectedAgentType,
                    ProviderName = string.IsNullOrEmpty(selectedProviderName) ? null : selectedProviderName,
                    ModelConfigId = Guid.TryParse(selectedProviderName, out var configId) ? configId : null
                };

            await foreach (var chunk in SendMessageStreamViaJsAsync(input, newSessionTitle))
            {
                streamingResponse += chunk;
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(1);
            }

            if (selectedChatId.HasValue)
            {
                isNewTask = false;
                pendingUserMessage = null;
                streamingResponse = string.Empty;
                await LoadMessages(selectedChatId.Value);
                await JS.InvokeVoidAsync("ChatStateBus.notifySessionsChanged", "chatLayout");
            }
        }
        catch (Exception ex)
        {
            inputMessage = message; pendingUserMessage = null;
            streamingResponse = string.Empty;
            await ShowToast("Send failed: " + ex.Message, "error");
        }
        finally { isSending = false; StateHasChanged(); }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isSending)
        {
            return;
        }
        if (!selectedChatId.HasValue) { await ShowToast("请先选择或创建一个会话", "warning"); return; }
        isSending = true; var message = inputMessage; inputMessage = string.Empty;
        pendingUserMessage = new ChatMessageDto { Id = Guid.NewGuid(), SessionId = selectedChatId.Value, Role = "user", Content = message, CreationTime = DateTime.Now };
        streamingResponse = string.Empty; StateHasChanged(); await ScrollToBottom();
        try
        {
            var input = new SendChatMessageInputDto
                {
                    SessionId = selectedChatId,
                    Message = message,
                    AgentType = string.IsNullOrEmpty(selectedAgentType) ? null : selectedAgentType,
                    ProviderName = string.IsNullOrEmpty(selectedProviderName) ? null : selectedProviderName,
                    ModelConfigId = Guid.TryParse(selectedProviderName, out var configId) ? configId : null
                };

            await foreach (var chunk in SendMessageStreamViaJsAsync(input))
            {
                streamingResponse += chunk;
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(1);
            }

            pendingUserMessage = null;
            streamingResponse = string.Empty;
            await LoadMessages(selectedChatId.Value);
            await JS.InvokeVoidAsync("ChatStateBus.notifySessionsChanged", "chatLayout");
        }
        catch (Exception ex)
        {
            inputMessage = message; pendingUserMessage = null;
            streamingResponse = string.Empty; await ShowToast("Send failed: " + ex.Message, "error");
        }
        finally { isSending = false; StateHasChanged(); }
    }

    private async IAsyncEnumerable<string> SendMessageStreamViaJsAsync(SendChatMessageInputDto input, string? newSessionTitle = null)
    {
        streamCts?.Cancel();
        streamCts = new CancellationTokenSource();

        var chunkQueue = new Queue<string>();
        var tcs = new TaskCompletionSource<bool>();
        var error = (string?)null;

        void OnChunk(string data)
        {
            if (data.TrimStart().StartsWith("{"))
            {
                try
                {
                    using var doc = JsonDocument.Parse(data);
                    if (doc.RootElement.TryGetProperty("session", out var s))
                    {
                        var sessionId = Guid.Parse(s.GetString()!);
                        selectedChatId = sessionId;
                        if (!string.IsNullOrEmpty(newSessionTitle))
                        {
                            var newChat = new ChatDto
                            {
                                Id = sessionId,
                                Title = newSessionTitle,
                                CreationTime = DateTime.Now,
                                LastMessageTime = DateTime.Now,
                                MessageCount = 1
                            };
                            _ = JS.InvokeVoidAsync("ChatStateBus.insertSessionAtTop", "chatLayout", JsonSerializer.Serialize(newChat));
                            _ = JS.InvokeVoidAsync("ChatStateBus.notifyChatSelected", "chatLayout", sessionId.ToString());
                        }
                        _ = InvokeAsync(StateHasChanged);
                        return;
                    }
                    if (doc.RootElement.TryGetProperty("error", out var e))
                    {
                        error = e.GetString();
                        tcs.TrySetResult(false);
                        return;
                    }
                }
                catch (JsonException) { }
            }
            chunkQueue.Enqueue(data);
            tcs.TrySetResult(true);
        }

        void OnDone()
        {
            tcs.TrySetResult(false);
        }

        void OnError(string msg)
        {
            error = msg;
            tcs.TrySetResult(false);
        }

        var callbacks = new SseStreamCallbacks(OnChunk, OnDone, OnError);
        _sseCallbacksRef?.Dispose();
        _sseCallbacksRef = DotNetObjectReference.Create(callbacks);
        var requestJson = JsonSerializer.Serialize(input);
        _ = JS.InvokeVoidAsync("__chatSseStream", "api/assistant/chat/stream", requestJson, _sseCallbacksRef);

        try
        {
            while (true)
            {
                streamCts.Token.ThrowIfCancellationRequested();

                while (chunkQueue.Count > 0)
                    yield return chunkQueue.Dequeue();

                if (error != null) throw new Exception(error);

                var hasMore = await tcs.Task;
                tcs = new TaskCompletionSource<bool>();

                while (chunkQueue.Count > 0)
                    yield return chunkQueue.Dequeue();

                if (!hasMore) yield break;
            }
        }
        finally
        {
            _sseCallbacksRef?.Dispose();
            _sseCallbacksRef = null;
        }
    }

    private class SseStreamCallbacks
    {
        private readonly Action<string> _onChunk;
        private readonly Action _onDone;
        private readonly Action<string> _onError;

        public SseStreamCallbacks(Action<string> onChunk, Action onDone, Action<string> onError)
        {
            _onChunk = onChunk; _onDone = onDone; _onError = onError;
        }

        [JSInvokable] public void OnSseChunk(string data) => _onChunk(data);
        [JSInvokable] public void OnSseDone() => _onDone();
        [JSInvokable] public void OnSseError(string msg) => _onError(msg);
    }

    private void StopSending()
    {
        streamCts?.Cancel();
        isSending = false;
        StateHasChanged();
    }

    private async Task ShowToast(string message, string type = "info") => await JS.InvokeVoidAsync("ChatStateBus.showToast", message, type);

    private async Task ScrollToBottom() { try { await JS.InvokeVoidAsync("eval", "var el = document.querySelector('.chat-messages'); if(el) el.scrollTop = el.scrollHeight;"); } catch { } }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);
    private static string GetIconSvg(string name) => name switch
    {
        "user" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg>",
        "robot" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"10\" rx=\"2\"></rect><circle cx=\"12\" cy=\"5\" r=\"2\"></circle><path d=\"M12 7v4\"></path><line x1=\"8\" y1=\"16\" x2=\"8\" y2=\"16\"></line><line x1=\"16\" y1=\"16\" x2=\"16\" y2=\"16\"></line></svg>",
        "chat" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>",
        _ => ""
    };
}

<style>
    /* ========== Chat Header ========== */
    .chat-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* ========== Main Chat Area ========== */
    .chat-main-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .message-item {
        display: flex;
        margin-bottom: 16px;
        gap: 12px;
    }

    .user-message {
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #bfbfbf;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .message-avatar svg {
        width: 18px;
        height: 18px;
    }

    .user-message .message-avatar {
        background-color: #a6a6a6;
    }

    .message-content {
        max-width: 60%;
    }

    .message-text {
        padding: 12px;
        border-radius: 8px;
        background-color: #f0f0f0;
        line-height: 1.5;
    }

    .user-message .message-text {
        background-color: #595959;
        color: white;
    }

    .message-time {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    /* ========== Thinking / Loading ========== */
    .thinking-text {
        color: #8c8c8c;
        font-style: italic;
    }

    .thinking-dots {
        display: inline-flex;
        gap: 4px;
        align-items: center;
    }

    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #8c8c8c;
        display: inline-block;
        animation: thinking-bounce 1.4s ease-in-out infinite;
    }

    .dot:nth-child(2) { animation-delay: 0.2s; }
    .dot:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes thinking-bounce {
        0%, 80%, 100% { transform: scale(0); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
    }

    .loading-spinner {
        text-align: center;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: #8c8c8c;
        font-size: 14px;
    }

    .spinner {
        width: 28px;
        height: 28px;
        border: 3px solid #e8e8e8;
        border-top-color: #a6a6a6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ========== Empty State ========== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .empty-icon svg {
        width: 48px;
        height: 48px;
        color: #d9d9d9;
    }

    .empty-text {
        color: #8c8c8c;
        font-size: 14px;
    }

    /* ========== New Task View ========== */
    .new-task-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 60px;
        background: #fff;
        max-width: 800px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    /* ========== Chat Input Container ========== */
    .chat-input-area {
        border-top: 1px solid #e8e8e8;
        padding: 16px;
        background: #fafafa;
    }

    .chat-input-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
        gap: 12px;
    }

    /* ========== Markdown Content Styles ========== */
    .markdown-content {
        line-height: 1.8;
    }

    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
        margin-top: 1em;
        margin-bottom: 0.5em;
        font-weight: 600;
        line-height: 1.25;
    }

    .markdown-content h1 { font-size: 1.75em; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.3em; }
    .markdown-content h2 { font-size: 1.5em; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.3em; }
    .markdown-content h3 { font-size: 1.25em; }
    .markdown-content h4 { font-size: 1em; }

    .markdown-content p { margin-bottom: 0; margin-top: 0; }

    .markdown-content ul,
    .markdown-content ol {
        margin-bottom: 1em;
        padding-left: 2em;
    }

    .markdown-content ul li,
    .markdown-content ol li {
        margin-bottom: 0.25em;
    }

    .markdown-content ul { list-style-type: disc; }
    .markdown-content ol { list-style-type: decimal; }

    .markdown-content blockquote {
        margin: 1em 0;
        padding: 0.5em 1em;
        border-left: 4px solid #a6a6a6;
        background: rgba(0, 0, 0, 0.03);
        color: #595959;
    }

    .markdown-content pre {
        background: #f5f5f5;
        border-radius: 6px;
        padding: 1em;
        overflow-x: auto;
        margin: 1em 0;
    }

    .markdown-content code {
        background: #f0f0f0;
        border-radius: 3px;
        padding: 0.2em 0.4em;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9em;
    }

    .markdown-content pre code {
        background: transparent;
        padding: 0;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .markdown-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1em 0;
    }

    .markdown-content table th,
    .markdown-content table td {
        padding: 0.5em 1em;
        border: 1px solid #e8e8e8;
        text-align: left;
    }

    .markdown-content table th {
        background: #fafafa;
        font-weight: 600;
    }

    .markdown-content hr {
        border: none;
        border-top: 1px solid #e8e8e8;
        margin: 1.5em 0;
    }

    .markdown-content a {
        color: #1890ff;
        text-decoration: none;
    }

    .markdown-content a:hover {
        text-decoration: underline;
    }

    .markdown-content strong { font-weight: 600; }
    .markdown-content em { font-style: italic; }

    .markdown-content img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }
</style>
