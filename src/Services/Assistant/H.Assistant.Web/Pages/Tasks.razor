@page "/assistant/tasks"

@layout ChatLayout
@inject ITaskAppService TaskAppService
@inject ITaskLogAppService TaskLogAppService
@inject IChatMessageAppService ChatMessageAppService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>定时任务 - Agent 助手</PageTitle>

<!-- Right Panel - Tasks Area -->
<div class="tasks-main-panel">
    <!-- Tab Bar -->
    <div class="tasks-tab-bar">
        <div class="tasks-tab @(activeTab == "tasks" ? "active" : "")" @onclick='() => SwitchTab("tasks")'>我的定时任务</div>
        <div class="tasks-tab @(activeTab == "logs" ? "active" : "")" @onclick='() => SwitchTab("logs")'>执行记录</div>
    </div>

    @if (activeTab == "tasks")
    {
        <div class="chat-header">
            <div class="chat-header-left"><span>定时任务</span></div>
            <div class="chat-header-right">
                <button class="btn btn-primary" @onclick="CreateNewTask">@IconSvg("plus") 新建定时任务</button>
            </div>
        </div>
        @if (loadingTasks)
        {
            <div class="loading-spinner"><div class="spinner"></div><span>Loading...</span></div>
        }
        else if (tasks.Any())
        {
            <div class="task-card-list">
                @foreach (var task in tasks)
                {
                    <div class="task-card @(task.IsEnabled ? "" : "disabled")">
                        <div class="task-card-header">
                            <span class="task-name-text">@task.TaskName</span>
                            <div class="task-card-header-right" @onclick:stopPropagation>
                                <label class="toggle-switch" @onclick="() => ToggleTaskEnable(task.Id)">
                                    <div class="toggle-track @(task.IsEnabled ? "on" : "")">
                                        <div class="toggle-thumb"></div>
                                    </div>
                                </label>
                                <div class="more-menu-wrapper">
                                    <button class="task-action-btn" @onclick="() => ToggleMoreMenu(task.Id)">@IconSvg("more")</button>
                                    @if (showMoreMenuId == task.Id)
                                    {
                                        <div class="more-dropdown">
                                            <div class="dropdown-item" @onclick="() => { showMoreMenuId = null; EditTask(task.Id); }">
                                                @IconSvg("edit") <span>编辑</span>
                                            </div>
                                            <div class="dropdown-item" @onclick="async () => { showMoreMenuId = null; await ExecuteTaskNow(task.Id); }">
                                                @IconSvg("play") <span>立即执行</span>
                                            </div>
                                            <div class="dropdown-item danger" @onclick="async () => { showMoreMenuId = null; await DeleteScheduledTask(task.Id); }">
                                                @IconSvg("delete") <span>删除任务</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(task.TaskDescription))
                        {
                            <div class="task-card-info">@task.TaskDescription</div>
                        }
                        <div class="task-card-info">@IconSvg("clock-sm") <span>@task.ScheduleDisplayText</span></div>
                        @if (task.IsEnabled && task.NextExecutionTime.HasValue)
                        {
                            <div class="task-card-info">@IconSvg("timer") <span>下次执行: @task.NextExecutionTime.Value.ToString("MM-dd HH:mm")</span></div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-chat-state">
                <div class="empty-chat-content">
                    <div class="empty-state"><div class="empty-icon">@IconSvg("task")</div><div class="empty-text">暂无定时任务，点击上方按钮创建</div></div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="chat-header">
            <div class="chat-header-left"><span>执行记录</span></div>
            <div class="chat-header-right">
                @if (isLogSelectionMode)
                {
                    <button class="btn btn-sm" @onclick="ToggleLogSelectAll">@GetLogSelectAllText()</button>
                    <button class="btn btn-sm btn-danger" disabled="@(selectedLogIds.Count == 0)" @onclick="ConfirmBatchDeleteLogs">删除选中</button>
                    <button class="btn btn-sm" @onclick="ExitLogSelectionMode">取消</button>
                }
                else
                {
                    <button class="btn" @onclick="ToggleLogSelectionMode">多选</button>
                }
            </div>
        </div>
        @if (loadingTaskLogs)
        {
            <div class="loading-spinner"><div class="spinner"></div><span>Loading...</span></div>
        }
        else if (allTaskLogs.Any())
        {
            <div class="task-log-list">
                @foreach (var log in allTaskLogs)
                {
                    <div class="log-entry @log.Status.ToLower()">
                        <div class="log-header">
                            @if (isLogSelectionMode)
                            {
                                <input type="checkbox" class="log-checkbox"
                                       checked="@selectedLogIds.Contains(log.Id)"
                                       @onchange="() => ToggleLogSelectItem(log.Id)" />
                            }
                            <span class="log-status-badge status-@log.Status.ToLower()">@GetLogStatusText(log.Status)</span>
                            <span class="log-task-name">@log.TaskName</span>
                            <span class="log-time">@log.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            @if (log.DurationSeconds.HasValue)
                            {
                                <span class="log-duration">@(log.DurationSeconds.Value)秒</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(log.Result))
                        {
                            <div class="log-result">@log.Result</div>
                        }
                        @if (!string.IsNullOrEmpty(log.ErrorMessage))
                        {
                            <div class="log-error">@log.ErrorMessage</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-chat-state">
                <div class="empty-chat-content">
                    <div class="empty-state"><div class="empty-icon">@IconSvg("inbox")</div><div class="empty-text">暂无执行记录</div></div>
                </div>
            </div>
        }
    }
</div>

<!-- Scheduled Task Dialog -->
@if (showTaskDialog)
{
    <div class="scheduled-task-dialog">
        <div class="dialog-overlay" @onclick="CloseTaskDialog"></div>
        <div class="dialog-content">
            <div class="dialog-header">
                <h3>@(editingTaskId.HasValue ? "编辑定时任务" : "创建定时任务")</h3>
                <button class="dialog-close" @onclick="CloseTaskDialog">@IconSvg("close")</button>
            </div>
            <div class="dialog-body">
                <div class="form-group">
                    <label class="form-label">任务名称 <span class="required">*</span></label>
                    <input type="text" class="form-input" @bind="newTaskDto.TaskName" placeholder="输入任务名称" />
                </div>
                <div class="form-group">
                    <label class="form-label">提示词内容 <span class="required">*</span></label>
                    <textarea class="form-textarea" @bind="newTaskDto.PromptContent" @bind:event="oninput" placeholder="输入要执行的任务内容..." rows="5"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Agent 类型</label>
                        <select class="form-select" @bind="newTaskDto.AgentType">
                            @foreach (var agent in availableAgents)
                            {
                                <option value="@agent.AgentType">@agent.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">调度类型</label>
                        <select class="form-select" @bind="newTaskDto.ScheduleType">
                            <option value="Once">仅一次</option>
                            <option value="Daily">每天</option>
                            <option value="Weekly">每周</option>
                            <option value="Monthly">每月</option>
                            <option value="Cron">Cron 表达式</option>
                        </select>
                    </div>
                </div>
                @if (newTaskDto.ScheduleType == "Daily" || newTaskDto.ScheduleType == "Weekly" || newTaskDto.ScheduleType == "Monthly")
                {
                    <div class="schedule-config">
                        <div class="config-title">执行时间</div>
                        <div class="time-config">
                            @if (newTaskDto.ScheduleType == "Weekly")
                            {
                                <div class="time-input-group">
                                    <label>星期</label>
                                    <select class="form-select" @bind="newTaskDto.DayOfWeek">
                                        <option value="1">周一</option><option value="2">周二</option><option value="3">周三</option>
                                        <option value="4">周四</option><option value="5">周五</option><option value="6">周六</option><option value="0">周日</option>
                                    </select>
                                </div>
                            }
                            else if (newTaskDto.ScheduleType == "Monthly")
                            {
                                <div class="time-input-group">
                                    <label>日期</label>
                                    <input type="number" class="form-input" @bind="newTaskDto.DayOfMonth" min="1" max="31" />
                                </div>
                            }
                            <div class="time-input-group">
                                <label>小时</label>
                                <input type="number" class="form-input" @bind="newTaskDto.Hour" min="0" max="23" />
                            </div>
                            <div class="time-input-group">
                                <label>分钟</label>
                                <input type="number" class="form-input" @bind="newTaskDto.Minute" min="0" max="59" />
                            </div>
                        </div>
                    </div>
                }
                else if (newTaskDto.ScheduleType == "Cron")
                {
                    <div class="schedule-config">
                        <div class="config-title">Cron 表达式</div>
                        <input type="text" class="form-input" @bind="newTaskDto.CronExpression" placeholder="例如: 0 */2 * * *" />
                    </div>
                }
            </div>
            <div class="dialog-footer">
                <button class="btn" @onclick="CloseTaskDialog">取消</button>
                <button class="btn btn-primary" @onclick="SaveScheduledTask" disabled="@(string.IsNullOrWhiteSpace(newTaskDto.TaskName) || string.IsNullOrWhiteSpace(newTaskDto.PromptContent))">
                    @(editingTaskId.HasValue ? "保存" : "创建")
                </button>
            </div>
        </div>
    </div>
}

<!-- Batch Delete Confirmation Modal -->
@if (showBatchDeleteConfirm)
{
    <div class="scheduled-task-dialog">
        <div class="dialog-overlay" @onclick="(() => showBatchDeleteConfirm = false)"></div>
        <div class="dialog-content confirm-dialog">
            <div class="dialog-header">
                <h3>确认批量删除</h3>
                <button class="dialog-close" @onclick="() => showBatchDeleteConfirm = false">@IconSvg("close")</button>
            </div>
            <div class="dialog-body">
                <p class="confirm-message">确定要删除选中的 @selectedLogIds.Count 条执行日志吗？此操作不可撤销。</p>
            </div>
            <div class="dialog-footer">
                <button class="btn" @onclick="() => showBatchDeleteConfirm = false">取消</button>
                <button class="btn btn-danger" @onclick="BatchDeleteLogs">删除</button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "tasks";
    private List<TaskDto> tasks = new();
    private List<AgentConfigDto> availableAgents = new();
    private bool loadingTasks;
    private bool showTaskDialog;
    private CreateTaskDto newTaskDto = new();
    private Guid? editingTaskId;
    private Guid? showMoreMenuId;

    private List<TaskLogDto> allTaskLogs = new();
    private bool loadingTaskLogs;

    private bool isLogSelectionMode = false;
    private HashSet<Guid> selectedLogIds = new();
    private bool showBatchDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableAgents();
        await LoadTasks();
        await LoadAllTaskLogs();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        showMoreMenuId = null;
        if (tab == "logs")
        {
            await LoadAllTaskLogs();
        }
        else
        {
            await LoadTasks();
        }
    }

    private async Task LoadAllTaskLogs()
    {
        loadingTaskLogs = true;
        try
        {
            var result = await TaskLogAppService.GetListAsync(new TaskLogQueryDto { MaxResultCount = 50 });
            allTaskLogs = result.Items.ToList();
        }
        finally { loadingTaskLogs = false; }
    }

    private void ToggleMoreMenu(Guid taskId)
    {
        showMoreMenuId = showMoreMenuId == taskId ? null : taskId;
    }

    private string GetLogStatusText(string status)
    {
        return status switch
        {
            "Success" => "成功",
            "Failed" => "失败",
            "Running" => "运行中",
            _ => status
        };
    }

    private void ToggleLogSelectionMode()
    {
        isLogSelectionMode = !isLogSelectionMode;
        if (!isLogSelectionMode)
        {
            selectedLogIds.Clear();
        }
    }

    private void ExitLogSelectionMode()
    {
        isLogSelectionMode = false;
        selectedLogIds.Clear();
    }

    private bool IsAllLogsSelected()
    {
        return allTaskLogs.Count > 0 && selectedLogIds.Count == allTaskLogs.Count;
    }

    private void ToggleLogSelectAll()
    {
        if (IsAllLogsSelected())
        {
            selectedLogIds.Clear();
        }
        else
        {
            selectedLogIds = new HashSet<Guid>(allTaskLogs.Select(l => l.Id));
        }
    }

    private string GetLogSelectAllText()
    {
        return IsAllLogsSelected() ? "取消全选" : "全选";
    }

    private void ToggleLogSelectItem(Guid logId)
    {
        if (selectedLogIds.Contains(logId))
        {
            selectedLogIds.Remove(logId);
        }
        else
        {
            selectedLogIds.Add(logId);
        }
    }

    private void ConfirmBatchDeleteLogs()
    {
        if (selectedLogIds.Count > 0)
        {
            showBatchDeleteConfirm = true;
        }
    }

    private async Task BatchDeleteLogs()
    {
        foreach (var logId in selectedLogIds.ToList())
        {
            await TaskLogAppService.DeleteAsync(logId);
        }
        
        showBatchDeleteConfirm = false;
        selectedLogIds.Clear();
        isLogSelectionMode = false;
        await LoadAllTaskLogs();
    }

    private async Task LoadTasks()
    {
        loadingTasks = true;
        try
        {
            var result = await TaskAppService.GetListAsync(new TaskQueryDto { MaxResultCount = 50 });
            tasks = result.Items.ToList();
        }
        finally { loadingTasks = false; }
    }

    private async Task LoadAvailableAgents()
    {
        availableAgents = await ChatMessageAppService.GetAvailableAgentsAsync();
    }

    private void CreateNewTask()
    {
        editingTaskId = null;
        newTaskDto = new CreateTaskDto
        {
            TaskName = "",
            TaskDescription = "",
            PromptContent = "",
            AgentType = availableAgents.FirstOrDefault()?.AgentType ?? "",
            ScheduleType = "Daily",
            Hour = 9,
            Minute = 0,
            IsEnabled = true
        };
        showTaskDialog = true;
    }

    private void EditTask(Guid taskId)
    {
        var task = tasks.FirstOrDefault(t => t.Id == taskId);
        if (task != null)
        {
            editingTaskId = taskId;
            newTaskDto = new CreateTaskDto
            {
                TaskName = task.TaskName,
                TaskDescription = task.TaskDescription,
                PromptContent = task.PromptContent,
                AgentType = task.AgentType,
                ModelConfigId = task.ModelConfigId,
                ScheduleType = task.ScheduleType,
                CronExpression = task.CronExpression,
                Hour = task.Hour,
                Minute = task.Minute,
                DayOfWeek = task.DayOfWeek,
                DayOfMonth = task.DayOfMonth,
                IsEnabled = task.IsEnabled
            };
            showTaskDialog = true;
        }
    }

    private async Task CloseTaskDialog()
    {
        showTaskDialog = false;
        editingTaskId = null;
    }

    private async Task SaveScheduledTask()
    {
        try
        {
            if (editingTaskId.HasValue)
            {
                await TaskAppService.UpdateAsync(editingTaskId.Value, new UpdateTaskDto
                {
                    TaskName = newTaskDto.TaskName,
                    TaskDescription = newTaskDto.TaskDescription,
                    PromptContent = newTaskDto.PromptContent,
                    AgentType = newTaskDto.AgentType,
                    ModelConfigId = newTaskDto.ModelConfigId,
                    ScheduleType = newTaskDto.ScheduleType,
                    CronExpression = newTaskDto.CronExpression,
                    Hour = newTaskDto.Hour,
                    Minute = newTaskDto.Minute,
                    DayOfWeek = newTaskDto.DayOfWeek,
                    DayOfMonth = newTaskDto.DayOfMonth,
                    IsEnabled = newTaskDto.IsEnabled
                });
                await ShowToast("任务已更新", "success");
            }
            else
            {
                await TaskAppService.CreateAsync(newTaskDto);
                await ShowToast("任务已创建", "success");
            }
            await CloseTaskDialog();
            await LoadTasks();
        }
        catch (Exception ex)
        {
            await ShowToast("保存失败: " + ex.Message, "error");
        }
    }

    private async Task ToggleTaskEnable(Guid taskId)
    {
        try
        {
            await TaskAppService.ToggleEnableAsync(taskId);
            await LoadTasks();
        }
        catch (Exception ex) { await ShowToast("操作失败: " + ex.Message, "error"); }
    }

    private async Task ExecuteTaskNow(Guid taskId)
    {
        try
        {
            await TaskAppService.ExecuteNowAsync(taskId);
            await ShowToast("任务已触发执行", "success");
            await LoadTasks();
        }
        catch (Exception ex) { await ShowToast("执行失败: " + ex.Message, "error"); }
    }

    private async Task DeleteScheduledTask(Guid taskId)
    {
        try
        {
            await TaskAppService.DeleteAsync(taskId);
            await ShowToast("任务已删除", "success");
            await LoadTasks();
        }
        catch (Exception ex) { await ShowToast("删除失败: " + ex.Message, "error"); }
    }

    private async Task ShowToast(string message, string type = "info") => await JS.InvokeVoidAsync("ChatStateBus.showToast", message, type);

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);
    private static string GetIconSvg(string name) => name switch
    {
        "plus" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg>",
        "more" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"1\"></circle><circle cx=\"12\" cy=\"5\" r=\"1\"></circle><circle cx=\"12\" cy=\"19\" r=\"1\"></circle></svg>",
        "send" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line><polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon></svg>",
        "edit" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path><path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path></svg>",
        "pause" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6\" y=\"4\" width=\"4\" height=\"16\"></rect><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\"></rect></svg>",
        "play" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"5 3 19 12 5 21 5 3\"></polygon></svg>",
        "delete" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3-3h8l1 1h-10l1-1z\"></path><line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"></line><line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"></line></svg>",
        "task" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg>",
        "inbox" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"></polyline><path d=\"M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path></svg>",
        "close" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>",
        "clock-sm" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>",
        "timer" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"10\" y1=\"2\" x2=\"14\" y2=\"2\"></line><line x1=\"12\" y1=\"14\" x2=\"12\" y2=\"10\"></line><path d=\"M12 14a7 7 0 1 0 0-14 7 7 0 0 0 0 14z\" transform=\"translate(0 4)\"></path></svg>",
        _ => ""
    };
}

<style>
    /* ========== Tasks Main Panel ========== */
    .tasks-main-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        overflow: hidden;
    }

    /* ========== Tab Bar ========== */
    .tasks-tab-bar {
        display: flex;
        border-bottom: 1px solid #e8e8e8;
        padding: 0 16px;
        background: #fafafa;
    }

    .tasks-tab {
        padding: 12px 20px;
        font-size: 14px;
        color: #8c8c8c;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.2s;
        user-select: none;
    }

    .tasks-tab:hover {
        color: #595959;
    }

    .tasks-tab.active {
        color: #262626;
        font-weight: 500;
        border-bottom-color: #262626;
    }

    /* ========== Chat Header (used in tasks right panel) ========== */
    .chat-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-header-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ========== Chat Input Area (used for log toolbar) ========== */
    .chat-input-area {
        border-top: 1px solid #e8e8e8;
        padding: 16px;
        background: #fafafa;
    }

    .chat-input-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
