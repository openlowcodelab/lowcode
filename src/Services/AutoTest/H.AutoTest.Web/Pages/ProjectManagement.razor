@page "/autotest/projects"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@inject IProjectAppService ProjectService
@inject IProjectEnvironmentAppService ProjectEnvironmentService
@inject IProjectServiceConfigAppService ProjectServiceConfigService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>项目管理</PageTitle>

<style>
    .environment-item-selected {
        font-weight: 500;
        border-left: 3px solid #0d6efd !important;
    }
</style>

<!-- 搜索、筛选和操作按钮 -->
<AntDesign.Row Gutter="16" Style="margin-bottom: 16px;">
    <AntDesign.Col Span="8">
        <AntDesign.Input Search="true" EnterButton="🔍" @bind-Value="searchTerm" Placeholder="搜索项目..." OnSearch="SearchProjects" />
    </AntDesign.Col>
    <AntDesign.Col Span="4">
        <AntDesign.Select TItemValue="string" TItem="string" Placeholder="全部状态" Style="width: 100%;" OnChange="OnStatusChanged">
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("" as string)" Label="全部状态" />
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@(1.ToString())" Label="活跃" />
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@(2.ToString())" Label="未激活" />
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@(3.ToString())" Label="已完成" />
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@(4.ToString())" Label="已取消" />
            <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@(5.ToString())" Label="暂停" />
        </AntDesign.Select>
    </AntDesign.Col>
    <AntDesign.Col Span="12" Style="text-align: right;">
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="ShowAddProjectModal">➕ 新建项目</AntDesign.Button>
    </AntDesign.Col>
</AntDesign.Row>

<!-- 项目列表 -->
@if (loading)
{
    <div style="text-align: center; padding: 40px;">
        <AntDesign.Spin Tip="加载中..." />
    </div>
}
else if (filteredProjects.Any())
{
    <AntDesign.Row Gutter="16">
        @foreach (var project in filteredProjects)
        {
            <AntDesign.Col Xs="24" Sm="12" Lg="8" Xl="6" Style="margin-bottom: 16px;">
                <AntDesign.Card Hoverable="true" Style="cursor: pointer; height: 100%;">
                    <TitleTemplate>
                        <div @onclick="async () => await NavigateToProjectCases(project.Id)" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; cursor: pointer;">
                            <strong style="font-size: 16px;">@project.Name</strong>
                            <AntDesign.Tag Color="@GetStatusTagColor(project.Status)">@GetStatusDisplayName(project.Status)</AntDesign.Tag>
                        </div>
                    </TitleTemplate>
                    <ChildContent>
                        <div @onclick="async () => await NavigateToProjectCases(project.Id)" style="cursor: pointer;">
                            <p style="color: #666; margin-bottom: 12px; min-height: 40px;">@(string.IsNullOrEmpty(project.Description) ? "暂无描述" : project.Description)</p>
                            <div style="color: #999; font-size: 13px; margin-bottom: 12px;">🌍 环境数量：@GetProjectEnvironments(project.Id).Count 个</div>
                        </div>
                        <div style="display: flex; gap: 8px; padding-top: 12px; border-top: 1px solid #f0f0f0;">
                            <AntDesign.Button Size="@ButtonSize.Small" Type="@ButtonType.Default" @onclick="() => ManageProjectServices(project)">⚙️ 服务</AntDesign.Button>
                            <AntDesign.Button Size="@ButtonSize.Small" Type="@ButtonType.Default" @onclick="async () => await ManageEnvironments(project)">🌐 环境</AntDesign.Button>
                            <AntDesign.Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" @onclick="async () => await NavigateToProjectCases(project.Id)">📝 用例</AntDesign.Button>
                        </div>
                    </ChildContent>
                    <Extra>
                        <AntDesign.Dropdown Trigger="new[] { AntDesign.Trigger.Click }">
                            <ChildContent>
                                <AntDesign.Button Size="@ButtonSize.Small" Type="@ButtonType.Default" Shape="@ButtonShape.Circle">⋯</AntDesign.Button>
                            </ChildContent>
                            <Overlay>
                                <AntDesign.Menu>
                                    <AntDesign.MenuItem @onclick="() => ShowEditProjectModal(project)">✏️ 编辑</AntDesign.MenuItem>
                                    <AntDesign.MenuItem Divider="true" />
                                    <AntDesign.MenuItem @onclick="() => DeleteProject(project.Id)" Style="color: #ff4d4f;">🗑️ 删除</AntDesign.MenuItem>
                                </AntDesign.Menu>
                            </Overlay>
                        </AntDesign.Dropdown>
                    </Extra>
                </AntDesign.Card>
            </AntDesign.Col>
        }
    </AntDesign.Row>
}
else
{
    <AntDesign.Result Status="@AntDesign.ResultStatus.Info" Title="暂无项目数据" SubTitle="点击「新建项目」按钮创建您的第一个项目" />
}

<!-- 项目添加/编辑模态框 -->
@{
    var projectModalTitle = isEditingProject ? "编辑项目" : "新建项目";
    var projectModalOkText = isEditingProject ? "更新" : "保存";
    var projectModalCancelText = "取消";
}
<AntDesign.Modal @bind-Visible="showProjectModal" Title="@projectModalTitle" Width="@("700px")" OnOk="SaveProject" OnCancel="HideProjectModal" Footer="null">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;"><span Style="color: red;">*</span> 项目标识</label>
            <div Style="flex: 1;">
                <InputText class="form-control" @bind-Value="currentProject.Id" Placeholder="留空自动生成" Disabled="@isEditingProject" />
                @if (!isEditingProject)
                {
                    <div Style="color: #999; font-size: 12px; margin-top: 4px;">只能包含字母、数字、下划线，以字母开头，长度3-12</div>
                }
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;"><span Style="color: red;">*</span> 项目名称</label>
            <div Style="flex: 1;">
                <InputText class="form-control" @bind-Value="currentProject.Name" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: start;">
            <label Style="width: 100px; text-align: right; margin-right: 16px; margin-top: 6px;">项目描述</label>
            <div Style="flex: 1;">
                <InputTextArea class="form-control" rows="4" @bind-Value="currentProject.Description" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;">状态</label>
            <div Style="flex: 1;">
                <AntDesign.Select @bind-Value="currentProject.Status" TItemValue="ProjectStatus" TItem="ProjectStatus" Style="width: 100%;">
                    <AntDesign.SelectOption TItemValue="ProjectStatus" TItem="ProjectStatus" Value="@ProjectStatus.Active" Label="活跃" />
                    <AntDesign.SelectOption TItemValue="ProjectStatus" TItem="ProjectStatus" Value="@ProjectStatus.Inactive" Label="未激活" />
                    <AntDesign.SelectOption TItemValue="ProjectStatus" TItem="ProjectStatus" Value="@ProjectStatus.Completed" Label="已完成" />
                    <AntDesign.SelectOption TItemValue="ProjectStatus" TItem="ProjectStatus" Value="@ProjectStatus.Cancelled" Label="已取消" />
                    <AntDesign.SelectOption TItemValue="ProjectStatus" TItem="ProjectStatus" Value="@ProjectStatus.OnHold" Label="暂停" />
                </AntDesign.Select>
            </div>
        </div>
    </div>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideProjectModal" Style="margin-right: 8px;">取消</AntDesign.Button>
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveProject">@(isEditingProject ? "更新" : "保存")</AntDesign.Button>
    </div>
</AntDesign.Modal>

<!-- 环境管理模态框 -->
@{
    var envModalTitle = $"环境管理 - {selectedProject?.Name}";
}
<AntDesign.Modal @bind-Visible="showEnvironmentModal" Title="@envModalTitle" Width="@("1100px")" Footer="null">
    <div Style="display: flex; min-height: 600px;">
        <!-- 左侧环境列表 -->
        <div Style="width: 280px; border-right: 1px solid #f0f0f0; padding: 16px; background-color: #fafafa;">
            <div Style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span Style="font-weight: 500;">环境列表</span>
                <AntDesign.Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" @onclick="ShowAddEnvironmentModal">➕</AntDesign.Button>
            </div>
            
            @if (projectEnvironments.Any())
            {
                <div Style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var env in projectEnvironments)
                    {
                        var isSelected = selectedEnvironment?.Id == env.Id;
                        var bgColor = isSelected ? "#1890ff" : "#fff";
                        var textColor = isSelected ? "#fff" : "#333";
                        var subTextColor = isSelected ? "rgba(255,255,255,0.8)" : "#999";
                        var borderColor = isSelected ? "#1890ff" : "#d9d9d9";
                        var dropdownColor = isSelected ? "#fff" : "#999";
                        
                        <div @onclick="() => SelectEnvironment(env)" 
                             Style="padding: 12px; border-radius: 4px; cursor: pointer; background-color: @bgColor; color: @textColor; border: 1px solid @borderColor;">
                            <div Style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div Style="font-weight: 600; margin-bottom: 4px;">@env.Name</div>
                                    <div Style="font-size: 12px; color: @subTextColor;">@GetEnvironmentTypeDisplayName(env.Type)</div>
                                </div>
                                <AntDesign.Dropdown Trigger="new[] { AntDesign.Trigger.Click }">
                                    <ChildContent>
                                        <AntDesign.Button Type="@ButtonType.Text" Size="@ButtonSize.Small" @onclick:stopPropagation>⋯</AntDesign.Button>
                                    </ChildContent>
                                    <Overlay>
                                        <AntDesign.Menu>
                                            <AntDesign.MenuItem @onclick="() => EditEnvironment(env)">✏️ 编辑</AntDesign.MenuItem>
                                            <AntDesign.MenuItem Divider="true" />
                                            <AntDesign.MenuItem @onclick="() => DeleteEnvironment(env.Id)" Style="color: #ff4d4f;">🗑️ 删除</AntDesign.MenuItem>
                                        </AntDesign.Menu>
                                    </Overlay>
                                </AntDesign.Dropdown>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div Style="text-align: center; padding: 40px 20px; color: #999;">
                    <p>暂无环境</p>
                    <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="ShowAddEnvironmentModal">添加环境</AntDesign.Button>
                </div>
            }
        </div>
        
        <!-- 右侧详情 -->
        <div Style="flex: 1; padding: 16px;">
            @if (selectedEnvironment != null)
            {
                <div>
                    <!-- 服务配置 -->
                    <div Style="margin-bottom: 24px; border: 1px solid #d9d9d9; border-radius: 4px;">
                        <div Style="padding: 12px 16px; background-color: #fafafa; border-bottom: 1px solid #d9d9d9; font-weight: 500;">
                            💻 服务配置
                        </div>
                        <div Style="padding: 16px;">
                            @if (serviceConfigViews.Any())
                            {
                                <table class="table" Style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr Style="background-color: #fafafa; border-bottom: 1px solid #d9d9d9;">
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">服务名称</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">基础URL</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500; width: 120px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var config in serviceConfigViews)
                                        {
                                            <tr Style="border-bottom: 1px solid #f0f0f0;">
                                                <td Style="padding: 12px 16px;"><strong>@config.ProjectService.Name</strong></td>
                                                <td Style="padding: 12px 16px;">
                                                    @if (config.EnvironmentConfig != null)
                                                    {
                                                        <a href="@config.EnvironmentConfig.BaseUrl" target="_blank" Style="color: #1890ff;">@config.EnvironmentConfig.BaseUrl</a>
                                                    }
                                                    else
                                                    {
                                                        <span Style="color: #999;">未配置</span>
                                                    }
                                                </td>
                                                <td Style="padding: 12px 16px;">
                                                    @if (config.EnvironmentConfig != null)
                                                    {
                                                        <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="() => EditServiceConfig(config.EnvironmentConfig!)" Style="margin-right: 4px; color: #1890ff; border-color: #1890ff;">✏️</AntDesign.Button>
                                                        <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="() => DeleteServiceConfig(config.EnvironmentConfig!.Id)" Style="color: #ff4d4f; border-color: #ff4d4f;">🗑️</AntDesign.Button>
                                                    }
                                                    else
                                                    {
                                                        <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="() => AddServiceConfig(config.ProjectService)">➕ 配置</AntDesign.Button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div Style="text-align: center; padding: 20px; color: #999;">暂无服务配置</div>
                            }
                        </div>
                    </div>
                    
                    <!-- 环境变量 -->
                    <div Style="border: 1px solid #d9d9d9; border-radius: 4px;">
                        <div Style="padding: 12px 16px; background-color: #fafafa; border-bottom: 1px solid #d9d9d9; display: flex; justify-content: space-between; align-items: center;">
                            <span Style="font-weight: 500;">📊 环境变量</span>
                            <AntDesign.Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" @onclick="ShowAddVariableModal">➕ 添加变量</AntDesign.Button>
                        </div>
                        <div Style="padding: 16px;">
                            @if (selectedEnvironment?.Variables != null && selectedEnvironment.Variables.Any())
                            {
                                <table class="table" Style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr Style="background-color: #fafafa; border-bottom: 1px solid #d9d9d9;">
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">变量名</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">变量值</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500; width: 100px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kvp in selectedEnvironment.Variables)
                                        {
                                            <tr Style="border-bottom: 1px solid #f0f0f0;">
                                                <td Style="padding: 12px 16px;"><strong>@kvp.Key</strong></td>
                                                <td Style="padding: 12px 16px;"><span Style="color: #1890ff; word-break: break-all;">@kvp.Value</span></td>
                                                <td Style="padding: 12px 16px;">
                                                    <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="() => EditVariable(kvp.Key, kvp.Value)" Style="margin-right: 4px;">✏️</AntDesign.Button>
                                                    <AntDesign.Button Type="@ButtonType.Default" Size="@ButtonSize.Small" @onclick="() => DeleteVariable(kvp.Key)" Style="color: #ff4d4f; border-color: #ff4d4f;">🗑️</AntDesign.Button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div Style="text-align: center; padding: 20px; color: #999;">暂无环境变量</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div Style="display: flex; align-items: center; justify-content: center; height: 100%; color: #999;">
                    <div Style="text-align: center;">
                        <h4 Style="margin-bottom: 16px;">选择一个环境</h4>
                        <p>请从左侧列表中选择一个环境来查看详情</p>
                    </div>
                </div>
            }
        </div>
    </div>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideEnvironmentModal" Style="margin-right: 8px;">关闭</AntDesign.Button>
        @if (selectedEnvironment != null)
        {
            <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveEnvironmentChanges" Style="background-color: #52c41a; border-color: #52c41a;">保存更改</AntDesign.Button>
        }
    </div>
</AntDesign.Modal>

<!-- 添加环境模态框 -->
<AntDesign.Modal @bind-Visible="showAddEnvironmentModal" Title="新建环境" Width="@("600px")" Footer="null">
    <EditForm Model="currentEnvironment" OnValidSubmit="SaveEnvironment">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <AntDesign.FormItem Label="环境名称" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <InputText class="form-control" @bind-Value="currentEnvironment.Name" />
            <ValidationMessage For="() => currentEnvironment.Name" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="环境类型" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Select @bind-Value="currentEnvironment.Type" TItemValue="EnvironmentType" TItem="EnvironmentType">
                <AntDesign.SelectOption TItemValue="EnvironmentType" TItem="EnvironmentType" Value="@EnvironmentType.Development" Label="开发环境" />
                <AntDesign.SelectOption TItemValue="EnvironmentType" TItem="EnvironmentType" Value="@EnvironmentType.Testing" Label="项目环境" />
                <AntDesign.SelectOption TItemValue="EnvironmentType" TItem="EnvironmentType" Value="@EnvironmentType.Staging" Label="预发环境" />
                <AntDesign.SelectOption TItemValue="EnvironmentType" TItem="EnvironmentType" Value="@EnvironmentType.Production" Label="生产环境" />
            </AntDesign.Select>
        </AntDesign.FormItem>
        
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
            <AntDesign.Button Type="@ButtonType.Default" @onclick="HideAddEnvironmentModal" Style="margin-right: 8px;">取消</AntDesign.Button>
            <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveEnvironment">保存</AntDesign.Button>
        </div>
    </EditForm>
</AntDesign.Modal>

<!-- 添加变量模态框 -->
<AntDesign.Modal @bind-Visible="showAddVariableModal" Title="添加环境变量" Width="@("500px")" Footer="null">
    <div>
        <AntDesign.FormItem Label="变量名" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="newVariableName" Placeholder="请输入变量名" />
        </AntDesign.FormItem>
        <AntDesign.FormItem Label="变量值" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="newVariableValue" Placeholder="请输入变量值" />
        </AntDesign.FormItem>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideAddVariableModal" Style="margin-right: 8px;">取消</AntDesign.Button>
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveNewVariable">保存</AntDesign.Button>
    </div>
</AntDesign.Modal>

<!-- 编辑变量模态框 -->
<AntDesign.Modal @bind-Visible="showEditVariableModal" Title="编辑环境变量" Width="@("500px")" Footer="null">
    <div>
        <AntDesign.FormItem Label="变量名" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="editVariableName" ReadOnly="true" />
        </AntDesign.FormItem>
        <AntDesign.FormItem Label="变量值" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="editVariableValue" Placeholder="请输入变量值" />
        </AntDesign.FormItem>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideEditVariableModal" Style="margin-right: 8px;">取消</AntDesign.Button>
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveEditVariable">保存</AntDesign.Button>
    </div>
</AntDesign.Modal>

<!-- 项目服务管理模态框 -->
@{
    var serviceModalTitle = selectedProjectForServices != null ? $"{selectedProjectForServices.Name} - 服务管理" : "服务管理";
}
<AntDesign.Modal @bind-Visible="showProjectServiceManagementModal" Title="@serviceModalTitle" Width="@("900px")" Footer="null">
    <div Style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
        <span Style="font-weight: 500;">项目服务列表</span>
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="ShowAddProjectServiceModal">添加服务</AntDesign.Button>
    </div>
    
    @if (projectServices.Any())
    {
        <AntDesign.Table DataSource="projectServices" TItem="ProjectServiceDto" PageSize="10" Bordered="true">
            <AntDesign.Column TData="string" @bind-Field="context.Name" Title="服务名称">
                <strong>@context.Name</strong>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <br /><span Style="color: #999; font-size: 12px;">@context.Description</span>
                }
            </AntDesign.Column>
            <AntDesign.Column TData="DateTime" @bind-Field="context.CreatedAt" Title="创建时间">
                @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </AntDesign.Column>
            <AntDesign.Column TData="string" Title="操作" Width="150px">
                <AntDesign.Button Type="@ButtonType.Primary" Shape="@ButtonShape.Circle" Size="@ButtonSize.Small" @onclick="() => EditProjectService(context)" Style="margin-right: 8px;">
                    ✏️
                </AntDesign.Button>
                <AntDesign.Button Type="@ButtonType.Default" Shape="@ButtonShape.Circle" Size="@ButtonSize.Small" @onclick="() => DeleteProjectService(context.Id)" Style="color: #ff4d4f; border-color: #ff4d4f;">
                    🗑️
                </AntDesign.Button>
            </AntDesign.Column>
        </AntDesign.Table>
    }
    else
    {
        <div Style="text-align: center; padding: 40px; color: #999;">
            <p>暂无服务配置</p>
            <AntDesign.Button Type="@ButtonType.Primary" @onclick="ShowAddProjectServiceModal">添加第一个服务</AntDesign.Button>
        </div>
    }
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideProjectServiceManagementModal">关闭</AntDesign.Button>
    </div>
</AntDesign.Modal>

<!-- 项目服务添加/编辑模态框 -->
@{
    var serviceEditModalTitle = isEditingProjectService ? "编辑项目服务" : "添加项目服务";
}
<AntDesign.Modal @bind-Visible="showProjectServiceModal" Title="@serviceEditModalTitle" Width="@("500px")" Footer="null">
    <EditForm Model="currentProjectService" OnValidSubmit="SaveProjectService">
        <DataAnnotationsValidator />
        
        <AntDesign.FormItem Label="服务名称" Required="true" LabelColSpan="6" WrapperColSpan="18">
            <InputText class="form-control" @bind-Value="currentProjectService.Name" Placeholder="请输入服务名称" />
            <ValidationMessage For="() => currentProjectService.Name" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="服务描述" LabelColSpan="6" WrapperColSpan="18">
            <InputTextArea class="form-control" @bind-Value="currentProjectService.Description" Placeholder="请输入服务描述" rows="3" />
        </AntDesign.FormItem>
        
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
            <AntDesign.Button Type="@ButtonType.Default" @onclick="HideProjectServiceModal" Style="margin-right: 8px;">取消</AntDesign.Button>
            <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveProjectService">@(isEditingProjectService ? "更新" : "保存")</AntDesign.Button>
        </div>
    </EditForm>
</AntDesign.Modal>

<!-- 服务配置添加/编辑模态框 -->
@{
    var serviceConfigModalTitle = isEditingServiceConfig ? "编辑服务配置" : "添加服务配置";
}
<AntDesign.Modal @bind-Visible="showServiceConfigModal" Title="@serviceConfigModalTitle" Width="@("500px")" Footer="null">
    <EditForm Model="currentServiceConfig" OnValidSubmit="SaveServiceConfig">
        <DataAnnotationsValidator />
        
        <AntDesign.FormItem Label="基础URL" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="currentServiceConfig.BaseUrl" Placeholder="请输入基础URL，如：http://127.0.0.1:8080" />
            <ValidationMessage For="() => currentServiceConfig.BaseUrl" />
        </AntDesign.FormItem>
    </EditForm>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #f0f0f0; margin-top: 24px;">
        <AntDesign.Button Type="@ButtonType.Default" @onclick="HideServiceConfigModal" Style="margin-right: 8px;">取消</AntDesign.Button>
        <AntDesign.Button Type="@ButtonType.Primary" @onclick="SaveServiceConfig">@(isEditingServiceConfig ? "更新" : "添加")</AntDesign.Button>
    </div>
</AntDesign.Modal>

@code {
    private List<ProjectDto> projects = new();
    private List<ProjectDto> filteredProjects = new();
    private List<ProjectEnvironmentDto> environments = new();
    private List<ProjectEnvironmentDto> projectEnvironments = new();
    private ProjectDto currentProject = new();
    private ProjectEnvironmentDto currentEnvironment = new();
    private ProjectEnvironmentDto? selectedEnvironment;
    private ProjectDto? selectedProject;
    private bool loading = true;
    private bool showProjectModal = false;
    private bool showEnvironmentModal = false;
    private bool showAddEnvironmentModal = false;
    private bool showAddVariableModal = false;
    private bool showEditVariableModal = false;
    private bool showProjectServiceModal = false;
    private bool showProjectServiceManagementModal = false;
    private bool isEditingProject = false;
    private bool isEditingProjectService = false;
    private string searchTerm = "";
    private string selectedStatus = "";
    private string newVariableName = "";
    private string newVariableValue = "";
    private string editVariableName = "";
    private string editVariableValue = "";
    private List<ProjectServiceDto> projectServices = new();
    private List<ServiceConfigView> serviceConfigViews = new();
    private ProjectServiceDto currentProjectService = new();
    private ProjectDto? selectedProjectForServices;
    private EnvironmentServiceConfigDto currentServiceConfig = new();
    private bool showServiceConfigModal = false;
    private bool isEditingServiceConfig = false;

    protected override async Task OnInitializedAsync() { await LoadData(); }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();
        environments = await ProjectEnvironmentService.GetAllAsync();
        filteredProjects = projects.ToList();
        loading = false;
        StateHasChanged();
    }

    private List<ProjectEnvironmentDto> GetProjectEnvironments(string projectId) => environments.Where(e => e.ProjectId == projectId).ToList();

    private void ShowAddProjectModal() { currentProject = new ProjectDto(); isEditingProject = false; showProjectModal = true; }

    private void ShowEditProjectModal(ProjectDto project)
    {
        currentProject = new ProjectDto { Id = project.Id, Name = project.Name, Description = project.Description, Status = project.Status, Metadata = new Dictionary<string, object>(project.Metadata), CreatedAt = project.CreatedAt, CreatedBy = project.CreatedBy };
        isEditingProject = true;
        showProjectModal = true;
    }

    private void HideProjectModal() { showProjectModal = false; currentProject = new ProjectDto(); }

    private async Task GenerateProjectId() { currentProject.Id = await ProjectService.GenerateUniqueIdAsync(); }

    private async Task SaveProject()
    {
        try
        {
            if (isEditingProject) await ProjectService.UpdateAsync(currentProject.Id, currentProject);
            else await ProjectService.CreateProjectAsync(currentProject);
            HideProjectModal();
            await LoadData();
        }
        catch (InvalidOperationException ex) { await JSRuntime.InvokeVoidAsync("alert", ex.Message); }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"保存项目时发生错误: {ex.Message}"); }
    }

    private async Task DeleteProject(string id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "确定要删除此项目吗？"))
        {
            await ProjectService.DeleteAsync(id);
            await LoadData();
        }
    }

    private async Task NavigateToProjectCases(string projectId)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", projectId);
        NavigationManager.NavigateTo($"/autotest/project-cases/{projectId}");
    }

    private async Task ManageEnvironments(ProjectDto project)
    {
        selectedProject = project;
        projectEnvironments = GetProjectEnvironments(project.Id);
        selectedEnvironment = projectEnvironments.FirstOrDefault();
        if (selectedEnvironment != null) await LoadEnvironmentServiceConfigs();
        showEnvironmentModal = true;
        StateHasChanged();
    }
    
    private void HideEnvironmentModal() { showEnvironmentModal = false; selectedProject = null; selectedEnvironment = null; }
    
    private async Task SelectEnvironment(ProjectEnvironmentDto environment)
    {
        selectedEnvironment = environment;
        if (selectedEnvironment != null && selectedProject != null) await LoadEnvironmentServiceConfigs();
        StateHasChanged();
    }
    
    private void ShowAddEnvironmentModal() { currentEnvironment = new ProjectEnvironmentDto { ProjectId = selectedProject?.Id ?? "" }; showAddEnvironmentModal = true; }
    private void HideAddEnvironmentModal() { showAddEnvironmentModal = false; currentEnvironment = new ProjectEnvironmentDto(); }
    
    private async Task SaveEnvironment()
    {
        await ProjectEnvironmentService.CreateAsync(currentEnvironment);
        environments = await ProjectEnvironmentService.GetAllAsync();
        if (selectedProject != null) projectEnvironments = GetProjectEnvironments(selectedProject.Id);
        HideAddEnvironmentModal();
        StateHasChanged();
    }
    
    private void EditEnvironment(ProjectEnvironmentDto environment)
    {
        currentEnvironment = new ProjectEnvironmentDto { Id = environment.Id, Name = environment.Name, ProjectId = environment.ProjectId, Type = environment.Type, Variables = new Dictionary<string, string>(environment.Variables), Headers = new Dictionary<string, string>(environment.Headers) };
        showAddEnvironmentModal = true;
    }
    
    private async Task DeleteEnvironment(string environmentId)
    {
        await ProjectEnvironmentService.DeleteAsync(environmentId);
        environments = await ProjectEnvironmentService.GetAllAsync();
        if (selectedProject != null)
        {
            projectEnvironments = GetProjectEnvironments(selectedProject.Id);
            if (selectedEnvironment?.Id == environmentId) selectedEnvironment = null;
        }
        StateHasChanged();
    }

    private void ShowAddVariableModal() { newVariableName = ""; newVariableValue = ""; showAddVariableModal = true; }
    private void HideAddVariableModal() { showAddVariableModal = false; newVariableName = ""; newVariableValue = ""; }
    
    private async Task SaveNewVariable()
    {
        if (selectedEnvironment != null && !string.IsNullOrWhiteSpace(newVariableName) && !string.IsNullOrWhiteSpace(newVariableValue))
        {
            selectedEnvironment.Variables[newVariableName] = newVariableValue;
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            HideAddVariableModal();
            StateHasChanged();
        }
    }
    
    private void EditVariable(string key, string value) { editVariableName = key; editVariableValue = value; showEditVariableModal = true; }
    private void HideEditVariableModal() { showEditVariableModal = false; editVariableName = ""; editVariableValue = ""; }
    
    private async Task SaveEditVariable()
    {
        if (selectedEnvironment != null && !string.IsNullOrWhiteSpace(editVariableName) && !string.IsNullOrWhiteSpace(editVariableValue))
        {
            selectedEnvironment.Variables[editVariableName] = editVariableValue;
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            HideEditVariableModal();
            StateHasChanged();
        }
    }
    
    private async Task DeleteVariable(string key)
    {
        if (selectedEnvironment != null)
        {
            selectedEnvironment.Variables.Remove(key);
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            StateHasChanged();
        }
    }

    private async Task SaveEnvironmentChanges()
    {
        if (selectedEnvironment != null) { await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment); await JSRuntime.InvokeVoidAsync("alert", "环境修改已保存"); }
    }

    private void OnSearchChanged(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; FilterProjects(); }
    private Task SearchProjects() { FilterProjects(); return Task.CompletedTask; }
    private void FilterByStatus(ChangeEventArgs e) { selectedStatus = e.Value?.ToString() ?? ""; FilterProjects(); }
    private void OnStatusChanged(string value) { selectedStatus = value; FilterProjects(); }

    private void FilterProjects()
    {
        filteredProjects = projects.Where(p =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            var matchesStatus = string.IsNullOrEmpty(selectedStatus) || ((int)p.Status).ToString() == selectedStatus;
            return matchesSearch && matchesStatus;
        }).ToList();
        StateHasChanged();
    }

    private string GetStatusDisplayName(ProjectStatus status) => status switch { ProjectStatus.Active => "活跃", ProjectStatus.Inactive => "未激活", ProjectStatus.Completed => "已完成", ProjectStatus.Cancelled => "已取消", ProjectStatus.OnHold => "暂停", _ => "未知" };
    private string GetStatusTagColor(ProjectStatus status) => status switch 
    { 
        ProjectStatus.Active => "green", 
        ProjectStatus.Inactive => "orange", 
        ProjectStatus.Completed => "blue", 
        ProjectStatus.Cancelled => "red", 
        ProjectStatus.OnHold => "default", 
        _ => "default" 
    };
    private string GetEnvironmentTypeDisplayName(EnvironmentType type) => type switch { EnvironmentType.Development => "开发环境", EnvironmentType.Testing => "集成环境", EnvironmentType.Staging => "预发环境", EnvironmentType.Production => "生产环境", _ => "未知" };
    
    private async Task ManageProjectServices(ProjectDto project) { selectedProjectForServices = project; projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(project.Id); showProjectServiceManagementModal = true; }
    private void HideProjectServiceManagementModal() { showProjectServiceManagementModal = false; selectedProjectForServices = null; projectServices.Clear(); }
    private void ShowAddProjectServiceModal() { currentProjectService = new ProjectServiceDto { ProjectId = selectedProjectForServices?.Id ?? "" }; isEditingProjectService = false; showProjectServiceModal = true; }
    
    private void EditProjectService(ProjectServiceDto service)
    {
        currentProjectService = new ProjectServiceDto { Id = service.Id, Name = service.Name, Description = service.Description, ProjectId = service.ProjectId, CreatedAt = service.CreatedAt, CreatedBy = service.CreatedBy };
        isEditingProjectService = true;
        showProjectServiceModal = true;
    }
    
    private void HideProjectServiceModal() { showProjectServiceModal = false; currentProjectService = new ProjectServiceDto(); isEditingProjectService = false; }
    
    private async Task SaveProjectService()
    {
        if (selectedProjectForServices != null)
        {
            if (isEditingProjectService) await ProjectServiceConfigService.UpdateProjectServiceAsync(currentProjectService.Id, currentProjectService);
            else await ProjectServiceConfigService.CreateProjectServiceAsync(currentProjectService);
            projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(selectedProjectForServices.Id);
            HideProjectServiceModal();
            StateHasChanged();
        }
    }
    
    private async Task DeleteProjectService(string serviceId)
    {
        await ProjectServiceConfigService.DeleteProjectServiceAsync(selectedProjectForServices.Id, serviceId);
        await ProjectServiceConfigService.DeleteEnvironmentServiceConfigAsync(serviceId);
        projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(selectedProjectForServices.Id);
        await LoadEnvironmentServiceConfigs();
        StateHasChanged();
    }
    
    private async Task LoadEnvironmentServiceConfigs()
    {
        if (selectedEnvironment != null && selectedProject != null) { serviceConfigViews = await ProjectServiceConfigService.GetServiceConfigViewsAsync(selectedEnvironment.Id, selectedProject.Id); StateHasChanged(); }
    }
    
    private async Task DeleteServiceConfig(string configId) { await ProjectServiceConfigService.DeleteEnvironmentServiceConfigAsync(configId); await LoadEnvironmentServiceConfigs(); }
    
    private void EditServiceConfig(EnvironmentServiceConfigDto config)
    {
        currentServiceConfig = new EnvironmentServiceConfigDto { Id = config.Id, EnvironmentId = config.EnvironmentId, ProjectServiceId = config.ProjectServiceId, BaseUrl = config.BaseUrl, CreatedAt = config.CreatedAt, CreatedBy = config.CreatedBy };
        isEditingServiceConfig = true;
        showServiceConfigModal = true;
    }
    
    private void AddServiceConfig(ProjectServiceDto service)
    {
        currentServiceConfig = new EnvironmentServiceConfigDto { EnvironmentId = selectedEnvironment?.Id ?? "", ProjectServiceId = service.Id, BaseUrl = "" };
        isEditingServiceConfig = false;
        showServiceConfigModal = true;
    }
    
    private void HideServiceConfigModal() { showServiceConfigModal = false; currentServiceConfig = new EnvironmentServiceConfigDto(); isEditingServiceConfig = false; }
    
    private async Task SaveServiceConfig()
    {
        if (selectedEnvironment != null)
        {
            if (isEditingServiceConfig) await ProjectServiceConfigService.UpdateEnvironmentServiceConfigAsync(currentServiceConfig);
            else await ProjectServiceConfigService.CreateEnvironmentServiceConfigAsync(currentServiceConfig);
            await LoadEnvironmentServiceConfigs();
            HideServiceConfigModal();
            StateHasChanged();
        }
    }
}
