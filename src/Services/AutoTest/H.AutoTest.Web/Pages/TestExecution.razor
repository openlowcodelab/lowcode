@page "/autotest/test-execution/{testCaseId}"
@page "/autotest/test-execution/batch/{projectId}"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@implements IDisposable

@inject IProjectCaseAppService ProjectCaseService
@inject IEnvironmentAppService EnvironmentService
@inject ITestExecutionEngineAppService ExecutionEngine
@inject ITestExecutionEventNotifier ExecutionEventNotifier
@inject IBatchExecutionAppService BatchExecutionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(IsBatchMode ? "批量执行测试用例" : "执行测试用例")</PageTitle>

<!-- 顶部栏：标题 + 面包屑 + 返回按钮 -->
<AntDesign.Row Style="margin-bottom: 16px; align-items: center;">
    <AntDesign.Col Flex=@("auto")>
        <div style="display: flex; align-items: center; gap: 16px;">
            <h3 style="margin: 0; font-weight: 600;">🚀 @(IsBatchMode ? "批量执行测试用例" : "执行测试用例")</h3>
        </div>
        <AntDesign.Breadcrumb Style="margin-top: 4px;">
            <AntDesign.BreadcrumbItem>
                @if (IsBatchMode)
                {
                    <a href="@($"/autotest/project-cases/{ProjectId}")">测试用例</a>
                }
                else if (testCase != null && !string.IsNullOrEmpty(testCase.ProjectId))
                {
                    <a href="@($"/autotest/project-cases/{testCase.ProjectId}")">测试用例</a>
                }
                else
                {
                    <a href="/autotest/project-cases">测试用例</a>
                }
            </AntDesign.BreadcrumbItem>
            <AntDesign.BreadcrumbItem>@(IsBatchMode ? "批量执行" : "执行测试")</AntDesign.BreadcrumbItem>
        </AntDesign.Breadcrumb>
    </AntDesign.Col>
    <AntDesign.Col>
        <AntDesign.Button OnClick="GoBack">← 返回</AntDesign.Button>
    </AntDesign.Col>
</AntDesign.Row>

@if (loading)
{
    <div style="text-align: center; padding: 60px 0;">
        <AntDesign.Spin Size="@SpinSize.Large" Tip="正在加载测试用例信息..." />
    </div>
}
else if (!IsBatchMode && testCase == null)
{
    <AntDesign.Alert Type="@AlertType.Error" ShowIcon="true" Message="未找到指定的测试用例" />
}
else if (IsBatchMode && !testCases.Any())
{
    <AntDesign.Alert Type="@AlertType.Error" ShowIcon="true" Message="未找到可执行的测试用例" />
}
else
{
    <AntDesign.Row Gutter="16">
        <!-- 左侧：测试用例信息 + 设置 -->
        <AntDesign.Col Span="8">
            <AntDesign.Card Size="@CardSize.Small">
                <TitleTemplate>📋 @(IsBatchMode ? "批量执行信息" : "测试用例信息")</TitleTemplate>
                <Body>
                    @if (IsBatchMode)
                    {
                        <AntDesign.Descriptions Column="1" Size="@DescriptionsSize.Small">
                            <AntDesign.DescriptionsItem Title="执行模式">批量执行</AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="用例数量">@testCases.Count</AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="总步骤数">@testCases.Sum(tc => tc.Steps.Count)</AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="选中用例">
                                @if (selectedTestCaseIds.Any())
                                {
                                    <AntDesign.Tag Color="@TagColor.Blue">@selectedTestCaseIds.Count 个用例</AntDesign.Tag>
                                }
                                else
                                {
                                    <span style="color: #999;">请选择要执行的用例</span>
                                }
                            </AntDesign.DescriptionsItem>
                        </AntDesign.Descriptions>

                        <div style="margin-top: 16px;">
                            <div style="margin-bottom: 8px; font-weight: 500;">选择要执行的测试用例</div>
                            <div style="margin-bottom: 8px;">
                                <AntDesign.Checkbox Checked="@IsAllSelected"
                                                    Indeterminate="@IsPartialSelected"
                                                    CheckedChange="@((bool v) => ToggleSelectAll(v))">
                                    全选/全不选
                                </AntDesign.Checkbox>
                            </div>
                            <div style="max-height: 220px; overflow-y: auto; border: 1px solid #f0f0f0; border-radius: 4px; padding: 8px;">
                                @foreach (var tc in testCases)
                                {
                                    <div style="margin-bottom: 4px;">
                                        <AntDesign.Checkbox Checked="@selectedTestCaseIds.Contains(tc.Id)"
                                                            CheckedChange="@((bool v) => ToggleTestCaseSelection(tc.Id, v))">
                                            @tc.Name
                                            <span style="color: #999; margin-left: 4px;">(@tc.Steps.Count 步骤)</span>
                                        </AntDesign.Checkbox>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <AntDesign.Descriptions Column="1" Size="@DescriptionsSize.Small">
                            <AntDesign.DescriptionsItem Title="用例名称">@testCase!.Name</AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="描述">
                                @(string.IsNullOrEmpty(testCase.Description) ? "无" : testCase.Description)
                            </AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="步骤数量">@testCase.Steps.Count</AntDesign.DescriptionsItem>
                            <AntDesign.DescriptionsItem Title="测试级别">
                                @if (testCase.Levels.Any())
                                {
                                    @foreach (var level in testCase.Levels)
                                    {
                                        <AntDesign.Tag Color="@GetLevelTagColor(level)">@level</AntDesign.Tag>
                                    }
                                }
                                else
                                {
                                    <span style="color: #999;">无</span>
                                }
                            </AntDesign.DescriptionsItem>
                        </AntDesign.Descriptions>
                    }

                    <!-- 环境选择 -->
                    <div style="margin-top: 16px;">
                        <div style="margin-bottom: 6px;">选择执行环境 <span style="color: #ff4d4f;">*</span></div>
                        <AntDesign.Select TItemValue="string" TItem="string"
                                          Value="selectedEnvironmentId"
                                          ValueChanged="@((string v) => { selectedEnvironmentId = v ?? string.Empty; StateHasChanged(); })"
                                          Placeholder="请选择环境"
                                          Style="width: 100%;">
                            @foreach (var env in environments)
                            {
                                <AntDesign.SelectOption TItemValue="string" TItem="string"
                                                        Value="@env.Id"
                                                        Label="@($"{env.Name} ({env.Status})")" />
                            }
                        </AntDesign.Select>
                        @if (!string.IsNullOrEmpty(selectedEnvironmentId))
                        {
                            var selectedEnv = environments.FirstOrDefault(e => e.Id == selectedEnvironmentId);
                            if (selectedEnv != null && !string.IsNullOrEmpty(selectedEnv.Description))
                            {
                                <div style="color: #999; font-size: 12px; margin-top: 4px;">@selectedEnv.Description</div>
                            }
                        }
                    </div>

                    <!-- 性能测试设置 -->
                    <div style="margin-top: 16px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-weight: 500;">⚡ 性能测试设置</span>
                            <AntDesign.Button Size="@ButtonSize.Small" OnClick="TogglePerformanceSettings">
                                @(showPerformanceSettings ? "▲ 收起" : "▼ 展开")
                            </AntDesign.Button>
                        </div>
                        @if (showPerformanceSettings)
                        {
                            <div style="background: #fafafa; border: 1px solid #f0f0f0; border-radius: 4px; padding: 12px;">
                                <div style="margin-bottom: 12px;">
                                    <AntDesign.Checkbox @bind-Checked="performanceSettings.IsPerformanceTestEnabled">
                                        启用性能测试模式
                                    </AntDesign.Checkbox>
                                    <div style="color: #999; font-size: 12px; margin-left: 22px;">启用后将按照性能测试参数执行测试用例</div>
                                </div>

                                @if (performanceSettings.IsPerformanceTestEnabled)
                                {
                                    <AntDesign.Row Gutter="12">
                                        <AntDesign.Col Span="12">
                                            <div style="margin-bottom: 10px;">
                                                <div style="margin-bottom: 4px;">并发数 <span style="color: #ff4d4f;">*</span></div>
                                                <AntDesign.InputNumber TValue="int" @bind-Value="performanceSettings.ConcurrentUsers"
                                                                       Min="1" Max="1000" Style="width: 100%;" />
                                                <div style="color: #999; font-size: 12px;">1-1000，根据服务器性能设置</div>
                                            </div>
                                        </AntDesign.Col>
                                        <AntDesign.Col Span="12">
                                            <div style="margin-bottom: 10px;">
                                                <div style="margin-bottom: 4px;">运行时间（秒） <span style="color: #ff4d4f;">*</span></div>
                                                <AntDesign.InputNumber TValue="int" @bind-Value="performanceSettings.DurationSeconds"
                                                                       Min="1" Max="86400" Style="width: 100%;" />
                                                <div style="color: #999; font-size: 12px;">1-86400 秒（24 小时）</div>
                                            </div>
                                        </AntDesign.Col>
                                        <AntDesign.Col Span="12">
                                            <div style="margin-bottom: 10px;">
                                                <div style="margin-bottom: 4px;">爬坡时间（秒）</div>
                                                <AntDesign.InputNumber TValue="int" @bind-Value="performanceSettings.RampUpSeconds"
                                                                       Min="0" Max="3600" Style="width: 100%;" />
                                                <div style="color: #999; font-size: 12px;">0-3600，0 表示立即达到</div>
                                            </div>
                                        </AntDesign.Col>
                                        <AntDesign.Col Span="12">
                                            <div style="margin-bottom: 10px;">
                                                <div style="margin-bottom: 4px;">思考时间（毫秒）</div>
                                                <AntDesign.InputNumber TValue="int" @bind-Value="performanceSettings.ThinkTimeMs"
                                                                       Min="0" Max="60000" Style="width: 100%;" />
                                                <div style="color: #999; font-size: 12px;">0-60000 毫秒</div>
                                            </div>
                                        </AntDesign.Col>
                                        <AntDesign.Col Span="24">
                                            <div style="margin-bottom: 10px;">
                                                <div style="margin-bottom: 4px;">最大错误率（%）</div>
                                                <AntDesign.InputNumber TValue="double" @bind-Value="performanceSettings.MaxErrorRate"
                                                                       Min="0" Max="100" Step="0.1" Style="width: 100%;" />
                                                <div style="color: #999; font-size: 12px;">0-100%，建议 5-20%</div>
                                            </div>
                                        </AntDesign.Col>
                                    </AntDesign.Row>

                                    <AntDesign.Alert Type="@AlertType.Info"
                                                     ShowIcon="true"
                                                     Style="margin-top: 8px;">
                                        <MessageTemplate>
                                            <strong>📊 性能测试配置预览</strong>
                                            <ul style="margin: 6px 0 0 0; padding-left: 20px;">
                                                <li>并发用户数：@performanceSettings.ConcurrentUsers 个</li>
                                                <li>测试时长：@performanceSettings.DurationSeconds 秒 (@TimeSpan.FromSeconds(performanceSettings.DurationSeconds).ToString(@"hh\:mm\:ss"))</li>
                                                <li>爬坡时间：@performanceSettings.RampUpSeconds 秒</li>
                                                <li>思考时间：@performanceSettings.ThinkTimeMs 毫秒</li>
                                                <li>最大错误率：@performanceSettings.MaxErrorRate%</li>
                                            </ul>
                                        </MessageTemplate>
                                    </AntDesign.Alert>
                                }
                            </div>
                        }
                    </div>

                    <!-- 执行按钮 -->
                    <div style="margin-top: 20px;">
                        <AntDesign.Button Type="@ButtonType.Primary"
                                          Block="true"
                                          Style="background-color: #52c41a; border-color: #52c41a;"
                                          Loading="@isExecuting"
                                          Disabled="@(string.IsNullOrEmpty(selectedEnvironmentId) || isExecuting || (IsBatchMode && !selectedTestCaseIds.Any()))"
                                          OnClick="StartExecution">
                            @if (isExecuting)
                            {
                                <span>执行中...</span>
                            }
                            else
                            {
                                <span>▶ @(IsBatchMode ? "开始批量执行" : "开始执行")</span>
                            }
                        </AntDesign.Button>

                        @if (isExecuting && cancellationTokenSource != null)
                        {
                            <AntDesign.Button Type="@ButtonType.Default"
                                              Danger="true"
                                              Block="true"
                                              Style="margin-top: 8px;"
                                              OnClick="CancelExecution">
                                ✕ 取消执行
                            </AntDesign.Button>
                        }
                    </div>
                </Body>
            </AntDesign.Card>
        </AntDesign.Col>

        <!-- 右侧：执行进度和结果 -->
        <AntDesign.Col Span="16">
            <AntDesign.Card Size="@CardSize.Small">
                <TitleTemplate>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>⚡ 执行进度</span>
                        @{
                            var firstRecord = executionRecords.FirstOrDefault();
                        }
                        @if (firstRecord != null)
                        {
                            <AntDesign.Tag Color="@GetExecutionStatusTagColor(firstRecord.Status)">
                                @GetExecutionStatusDisplayName(firstRecord.Status)
                            </AntDesign.Tag>
                        }
                    </div>
                </TitleTemplate>
                <Body>
                    @if (!executionRecords.Any())
                    {
                        <AntDesign.Empty Description="@($"请选择环境{(IsBatchMode ? "和测试用例" : "")}并点击开始执行")" />
                    }
                    else
                    {
                        @if (IsBatchMode)
                        {
                            <AntDesign.Row Gutter="16" Style="margin-bottom: 16px;">
                                <AntDesign.Col Span="6">
                                    <AntDesign.Statistic Title="总用例" Value="@executionRecords.Count" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <AntDesign.Statistic Title="成功"
                                                         Value="@(executionRecords.Count(r => r.Status == ExecutionStatus.Success))"
                                                         ValueStyle="color: #52c41a;" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <AntDesign.Statistic Title="失败"
                                                         Value="@(executionRecords.Count(r => r.Status == ExecutionStatus.Failed))"
                                                         ValueStyle="color: #ff4d4f;" />
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <AntDesign.Statistic Title="执行中"
                                                         Value="@(executionRecords.Count(r => r.Status == ExecutionStatus.Running))"
                                                         ValueStyle="color: #faad14;" />
                                </AntDesign.Col>
                            </AntDesign.Row>

                            var completedCases = executionRecords.Count(r => r.Status != ExecutionStatus.Running);
                            var totalCases = executionRecords.Count;
                            var batchProgressPercentage = totalCases > 0 ? (int)((double)completedCases / totalCases * 100) : 0;
                            <div style="margin-bottom: 16px;">
                                <div style="display: flex; justify-content: space-between; color: #999; font-size: 12px; margin-bottom: 4px;">
                                    <span>批量执行进度</span>
                                    <span>@completedCases / @totalCases</span>
                                </div>
                                <AntDesign.Progress Percent="batchProgressPercentage" />
                            </div>
                        }
                        else
                        {
                            var executionRecord = executionRecords.FirstOrDefault();
                            if (executionRecord != null)
                            {
                                <AntDesign.Row Gutter="16" Style="margin-bottom: 16px;">
                                    <AntDesign.Col Span="6">
                                        <AntDesign.Statistic Title="总步骤" Value="@executionRecord.TotalSteps" />
                                    </AntDesign.Col>
                                    <AntDesign.Col Span="6">
                                        <AntDesign.Statistic Title="成功" Value="@executionRecord.SuccessSteps"
                                                             ValueStyle="color: #52c41a;" />
                                    </AntDesign.Col>
                                    <AntDesign.Col Span="6">
                                        <AntDesign.Statistic Title="失败" Value="@executionRecord.FailedSteps"
                                                             ValueStyle="color: #ff4d4f;" />
                                    </AntDesign.Col>
                                    <AntDesign.Col Span="6">
                                        <AntDesign.Statistic Title="跳过" Value="@executionRecord.SkippedSteps"
                                                             ValueStyle="color: #faad14;" />
                                    </AntDesign.Col>
                                </AntDesign.Row>

                                @if (executionRecord.TotalSteps > 0)
                                {
                                    var completedSteps = executionRecord.SuccessSteps + executionRecord.FailedSteps + executionRecord.SkippedSteps;
                                    var progressPercentage = (int)((double)completedSteps / executionRecord.TotalSteps * 100);
                                    <div style="margin-bottom: 16px;">
                                        <div style="display: flex; justify-content: space-between; color: #999; font-size: 12px; margin-bottom: 4px;">
                                            <span>执行进度</span>
                                            <span>@completedSteps / @executionRecord.TotalSteps</span>
                                        </div>
                                        <AntDesign.Progress Percent="progressPercentage" />
                                    </div>
                                }

                                @if (executionRecord.Duration > 0)
                                {
                                    <div style="color: #999; margin-bottom: 8px;">
                                        执行时间: @(executionRecord.Duration)ms
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(executionRecord.ErrorMessage))
                                {
                                    <AntDesign.Alert Type="@AlertType.Error"
                                                     ShowIcon="true"
                                                     Message="执行失败"
                                                     Description="@executionRecord.ErrorMessage"
                                                     Style="margin-bottom: 12px;" />
                                }
                            }
                        }

                        @if (IsBatchMode)
                        {
                            <div style="margin-top: 16px;">
                                <h4 style="margin-bottom: 12px;">用例执行详情</h4>
                                <AntDesign.Collapse>
                                    @foreach (var record in executionRecords.OrderBy(r => r.TestCaseName))
                                    {
                                        <AntDesign.Panel Key="@record.Id">
                                            <HeaderTemplate>
                                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                                    <div>
                                                        <strong>@record.TestCaseName</strong>
                                                        <AntDesign.Tag Color="@GetExecutionStatusTagColor(record.Status)" Style="margin-left: 8px;">
                                                            @GetExecutionStatusDisplayName(record.Status)
                                                        </AntDesign.Tag>
                                                    </div>
                                                    <div style="color: #999; font-size: 12px; text-align: right;">
                                                        <div>@record.SuccessSteps / @record.TotalSteps 步骤</div>
                                                        @if (record.Duration > 0)
                                                        {
                                                            <div>@(record.Duration)ms</div>
                                                        }
                                                    </div>
                                                </div>
                                            </HeaderTemplate>
                                            <ChildContent>
                                                @if (!string.IsNullOrEmpty(record.ErrorMessage))
                                                {
                                                    <AntDesign.Alert Type="@AlertType.Error"
                                                                     ShowIcon="true"
                                                                     Message="执行失败"
                                                                     Description="@record.ErrorMessage"
                                                                     Style="margin-bottom: 12px;" />
                                                }
                                                @if (record.StepRecords.Any())
                                                {
                                                    @RenderStepList(record.StepRecords)
                                                }
                                            </ChildContent>
                                        </AntDesign.Panel>
                                    }
                                </AntDesign.Collapse>
                            </div>
                        }
                        else
                        {
                            var singleRecord = executionRecords.FirstOrDefault();
                            if (singleRecord?.StepRecords.Any() == true)
                            {
                                <div style="margin-top: 16px;">
                                    <h4 style="margin-bottom: 12px;">步骤执行详情</h4>
                                    @RenderStepList(singleRecord.StepRecords)
                                </div>
                            }
                        }
                    }
                </Body>
            </AntDesign.Card>
        </AntDesign.Col>
    </AntDesign.Row>
}

@code {
    private RenderFragment RenderStepList(List<StepExecutionRecord> stepRecords) => __builder =>
    {
        <div style="border: 1px solid #f0f0f0; border-radius: 4px;">
            @foreach (var stepRecord in stepRecords.OrderBy(s => s.Order))
            {
                <div style="padding: 10px 12px; border-bottom: 1px solid #f0f0f0;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="flex: 1;">
                            <div style="display: flex; align-items: center; margin-bottom: 4px; gap: 8px;">
                                <AntDesign.Tag Color="@GetStepStatusTagColor(stepRecord.Status)">@stepRecord.Order</AntDesign.Tag>
                                <strong>@stepRecord.StepName</strong>
                                <AntDesign.Tag Color="@TagColor.Default">@stepRecord.StepType</AntDesign.Tag>
                            </div>
                            @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                            {
                                <div style="color: #ff4d4f; font-size: 12px;">@stepRecord.ErrorMessage</div>
                            }
                            @if (stepRecord.Logs.Any())
                            {
                                <details style="margin-top: 6px;">
                                    <summary style="color: #999; font-size: 12px; cursor: pointer;">查看日志 (@stepRecord.Logs.Count 条)</summary>
                                    <div style="margin-top: 6px; background: #fafafa; padding: 8px; border-radius: 4px;">
                                        @foreach (var log in stepRecord.Logs)
                                        {
                                            <div style="color: #666; font-size: 12px; font-family: monospace;">@log</div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                        <div style="text-align: right;">
                            <AntDesign.Tag Color="@GetStepStatusTagColor(stepRecord.Status)">
                                @GetStepStatusDisplayName(stepRecord.Status)
                            </AntDesign.Tag>
                            @if (stepRecord.Duration > 0)
                            {
                                <div style="color: #999; font-size: 12px; margin-top: 4px;">@(stepRecord.Duration)ms</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    [Parameter] public string TestCaseId { get; set; } = string.Empty;
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    private ProjectCaseDto? testCase;
    private List<ProjectCaseDto> testCases = new();
    private List<EnvironmentDto> environments = new();
    private string selectedEnvironmentId = string.Empty;
    private bool loading = true;
    private bool isExecuting = false;
    private List<ExecutionRecordDto> executionRecords = new();
    private HashSet<string> selectedTestCaseIds = new();
    private CancellationTokenSource? cancellationTokenSource;
    private Dictionary<string, ExecutionRecordDto> currentExecutionRecords = new();

    private PerformanceTestSettingsDto performanceSettings = new();
    private bool showPerformanceSettings = false;

    private bool IsBatchMode => !string.IsNullOrEmpty(ProjectId);

    protected override async Task OnInitializedAsync()
    {
        ExecutionEventNotifier.StepUpdated += OnStepUpdated;
        ExecutionEventNotifier.ExecutionUpdated += OnExecutionUpdated;

        if (IsBatchMode)
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var selectedIds = queryParameters["selectedIds"];

            if (!string.IsNullOrEmpty(selectedIds))
            {
                selectedTestCaseIds = selectedIds.Split(',').ToHashSet();
            }
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;

            if (IsBatchMode)
            {
                testCases = await ProjectCaseService.GetByProjectIdAsync(ProjectId);

                if (testCases.Any())
                {
                    environments = await EnvironmentService.GetByProjectIdAsync(ProjectId);

                    if (environments.Count > 0)
                    {
                        selectedEnvironmentId = environments[0].Id;
                    }

                    if (!selectedTestCaseIds.Any())
                    {
                        selectedTestCaseIds = testCases.Select(tc => tc.Id).ToHashSet();
                    }
                }
            }
            else
            {
                testCase = await ProjectCaseService.GetByIdAsync(TestCaseId);

                if (testCase != null)
                {
                    environments = await EnvironmentService.GetByProjectIdAsync(testCase.ProjectId);

                    if (environments.Count > 0)
                    {
                        selectedEnvironmentId = environments[0].Id;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"加载数据失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task StartExecution()
    {
        if (string.IsNullOrEmpty(selectedEnvironmentId))
            return;

        if (IsBatchMode && !selectedTestCaseIds.Any())
            return;

        if (!IsBatchMode && testCase == null)
            return;

        try
        {
            isExecuting = true;
            cancellationTokenSource = new CancellationTokenSource();
            executionRecords.Clear();
            currentExecutionRecords.Clear();

            if (IsBatchMode)
            {
                var batchSettings = new BatchExecutionSettings
                {
                    SelectedTestCaseIds = selectedTestCaseIds.ToList(),
                    PerformanceSettings = performanceSettings,
                    IsParallelExecution = false,
                    ContinueOnFailure = true
                };

                try
                {
                    var batchResult = await BatchExecutionService.ExecuteBatchAsync(
                        batchSettings,
                        selectedEnvironmentId,
                        cancellationTokenSource.Token);

                    executionRecords.AddRange(batchResult.ExecutionRecords);
                    foreach (var record in batchResult.ExecutionRecords)
                    {
                        currentExecutionRecords[record.TestCaseId] = record;
                    }

                    StateHasChanged();

                    var message = $"批量执行完成！\n" +
                                  $"总用例数: {batchResult.TotalTestCases}\n" +
                                  $"成功: {batchResult.SuccessfulTestCases}\n" +
                                  $"失败: {batchResult.FailedTestCases}\n" +
                                  $"执行时间: {batchResult.Duration:hh\\:mm\\:ss}";

                    if (performanceSettings.IsPerformanceTestEnabled)
                    {
                        message += $"\n总执行次数: {batchResult.TotalExecutions}\n" +
                                   $"成功率: {batchResult.SuccessRate:F2}%\n" +
                                   $"错误率: {batchResult.ErrorRate:F2}%\n" +
                                   $"平均执行时间: {batchResult.AverageExecutionTime.TotalMilliseconds:F0}ms";
                    }

                    await JSRuntime.InvokeVoidAsync("alert", message);
                }
                catch (Exception ex)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"批量执行失败: {ex.Message}");
                }
            }
            else
            {
                var initialRecord = new ExecutionRecordDto
                {
                    Id = Guid.NewGuid().ToString(),
                    TestCaseId = testCase!.Id,
                    TestCaseName = testCase.Name,
                    Status = ExecutionStatus.Running,
                    StartTime = DateTime.Now,
                    TotalSteps = testCase.Steps.Count,
                    SuccessSteps = 0,
                    FailedSteps = 0,
                    SkippedSteps = 0,
                    StepRecords = new List<StepExecutionRecord>()
                };

                currentExecutionRecords[testCase.Id] = initialRecord;
                executionRecords.Add(initialRecord);
                StateHasChanged();

                var record = await ExecutionEngine.ExecuteTestCaseAsync(
                    testCase!,
                    selectedEnvironmentId,
                    cancellationTokenSource.Token);

                var index = executionRecords.FindIndex(r => r.TestCaseId == testCase.Id);
                if (index >= 0)
                {
                    executionRecords[index] = record;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"执行失败: {ex.Message}");
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        if (IsBatchMode)
        {
            if (!string.IsNullOrEmpty(ProjectId))
            {
                Navigation.NavigateTo($"/autotest/project-cases/{ProjectId}");
            }
            else
            {
                Navigation.NavigateTo("/autotest/project-cases");
            }
        }
        else
        {
            if (testCase != null && !string.IsNullOrEmpty(testCase.ProjectId))
            {
                Navigation.NavigateTo($"/autotest/project-cases/{testCase.ProjectId}");
            }
            else
            {
                Navigation.NavigateTo("/autotest/project-cases");
            }
        }
    }

    private void CancelExecution()
    {
        cancellationTokenSource?.Cancel();
    }

    private void ToggleSelectAll(bool selected)
    {
        if (selected)
        {
            selectedTestCaseIds = testCases.Select(tc => tc.Id).ToHashSet();
        }
        else
        {
            selectedTestCaseIds.Clear();
        }
        StateHasChanged();
    }

    private void ToggleTestCaseSelection(string testCaseId, bool selected)
    {
        if (selected)
        {
            selectedTestCaseIds.Add(testCaseId);
        }
        else
        {
            selectedTestCaseIds.Remove(testCaseId);
        }
        StateHasChanged();
    }

    private void TogglePerformanceSettings()
    {
        showPerformanceSettings = !showPerformanceSettings;
        StateHasChanged();
    }

    private bool IsAllSelected => testCases.Any() && selectedTestCaseIds.Count == testCases.Count;
    private bool IsPartialSelected => selectedTestCaseIds.Any() && selectedTestCaseIds.Count < testCases.Count;

    private string GetLevelTagColor(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        "P3" => "default",
        _ => "default"
    };

    private string GetExecutionStatusTagColor(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "green",
        ExecutionStatus.Failed => "red",
        ExecutionStatus.Running => "blue",
        ExecutionStatus.Cancelled => "orange",
        _ => "default"
    };

    private string GetExecutionStatusDisplayName(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "执行中",
        ExecutionStatus.Cancelled => "已取消",
        _ => "未知"
    };

    private string GetStepStatusTagColor(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "green",
        StepExecutionStatus.Failed => "red",
        StepExecutionStatus.Running => "blue",
        StepExecutionStatus.Skipped => "orange",
        _ => "default"
    };

    private string GetStepStatusDisplayName(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "成功",
        StepExecutionStatus.Failed => "失败",
        StepExecutionStatus.Running => "执行中",
        StepExecutionStatus.Skipped => "跳过",
        _ => "未知"
    };

    private void OnStepUpdated(string testCaseId, StepExecutionRecord stepRecord)
    {
        InvokeAsync(() =>
        {
            if (currentExecutionRecords.TryGetValue(testCaseId, out var record))
            {
                var existingStep = record.StepRecords.FirstOrDefault(s => s.StepId == stepRecord.StepId);
                if (existingStep != null)
                {
                    var index = record.StepRecords.IndexOf(existingStep);
                    record.StepRecords[index] = stepRecord;
                }
                else
                {
                    record.StepRecords.Add(stepRecord);
                }

                StateHasChanged();
            }
        });
    }

    private void OnExecutionUpdated(string testCaseId, ExecutionRecordDto executionRecord)
    {
        InvokeAsync(() =>
        {
            currentExecutionRecords[testCaseId] = executionRecord;

            var existingRecord = executionRecords.FirstOrDefault(r => r.TestCaseId == testCaseId);
            if (existingRecord != null)
            {
                var index = executionRecords.IndexOf(existingRecord);
                executionRecords[index] = executionRecord;
            }
            else
            {
                executionRecords.Add(executionRecord);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ExecutionEventNotifier.StepUpdated -= OnStepUpdated;
        ExecutionEventNotifier.ExecutionUpdated -= OnExecutionUpdated;

        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();
    }
}
