@page "/autotest/test-execution/{testCaseId}"
@page "/autotest/test-execution/batch/{projectId}"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@inject IProjectCaseAppService ProjectCaseService
@inject IEnvironmentAppService EnvironmentService
@inject ITestExecutionEngineAppService ExecutionEngine
@inject IBatchExecutionAppService BatchExecutionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(IsBatchMode ? "批量执行测试用例" : "执行测试用例")</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1">🚀 @(IsBatchMode ? "批量执行测试用例" : "执行测试用例")</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                @if (IsBatchMode)
                                {
                                    <a href="/autotest/project-cases/@ProjectId">测试用例</a>
                                }
                                else if (testCase != null && !string.IsNullOrEmpty(testCase.ProjectId))
                                {
                                    <a href="/autotest/project-cases/@testCase.ProjectId">测试用例</a>
                                }
                                else
                                {
                                    <a href="/autotest/project-cases">测试用例</a>
                                }
                            </li>
                            <li class="breadcrumb-item active">@(IsBatchMode ? "批量执行" : "执行测试")</li>
                        </ol>
                    </nav>
                </div>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="oi oi-arrow-left"></i> 返回
                </button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
            <p class="mt-2">正在加载测试用例信息...</p>
        </div>
    }
    else if (!IsBatchMode && testCase == null)
    {
        <div class="alert alert-danger">
            <i class="oi oi-warning"></i> 未找到指定的测试用例
        </div>
    }
    else if (IsBatchMode && !testCases.Any())
    {
        <div class="alert alert-danger">
            <i class="oi oi-warning"></i> 未找到可执行的测试用例
        </div>
    }
    else
    {
        <div class="row">
            <!-- 左侧：测试用例信息 -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">📋 @(IsBatchMode ? "批量执行信息" : "测试用例信息")</h6>
                    </div>
                    <div class="card-body">
                        @if (IsBatchMode)
                        {
                            <dl class="row">
                                <dt class="col-sm-4">执行模式:</dt>
                                <dd class="col-sm-8">批量执行</dd>
                                
                                <dt class="col-sm-4">用例数量:</dt>
                                <dd class="col-sm-8">@testCases.Count</dd>
                                
                                <dt class="col-sm-4">总步骤数:</dt>
                                <dd class="col-sm-8">@testCases.Sum(tc => tc.Steps.Count)</dd>
                                
                                <dt class="col-sm-4">选中用例:</dt>
                                <dd class="col-sm-8">
                                    @if (selectedTestCaseIds.Any())
                                    {
                                        <span class="badge bg-primary">@selectedTestCaseIds.Count 个用例</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">请选择要执行的用例</span>
                                    }
                                </dd>
                            </dl>
                            
                            <!-- 用例选择列表 -->
                            <div class="mt-3">
                                <label class="form-label">选择要执行的测试用例</label>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" 
                                           @onchange="ToggleSelectAll" 
                                           checked="@(selectedTestCaseIds.Count == testCases.Count)">
                                    <label class="form-check-label">
                                        全选/全不选
                                    </label>
                                </div>
                                <div style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var tc in testCases)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" 
                                                   @onchange="@((e) => ToggleTestCaseSelection(tc.Id, (bool)e.Value!))"
                                                   checked="@selectedTestCaseIds.Contains(tc.Id)">
                                            <label class="form-check-label">
                                                @tc.Name
                                                <small class="text-muted">(@tc.Steps.Count 步骤)</small>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <dl class="row">
                                <dt class="col-sm-4">用例名称:</dt>
                                <dd class="col-sm-8">@testCase!.Name</dd>
                                
                                <dt class="col-sm-4">描述:</dt>
                                <dd class="col-sm-8">@(string.IsNullOrEmpty(testCase.Description) ? "无" : testCase.Description)</dd>
                                
                                <dt class="col-sm-4">步骤数量:</dt>
                                <dd class="col-sm-8">@testCase.Steps.Count</dd>
                                
                                <dt class="col-sm-4">测试级别:</dt>
                                <dd class="col-sm-8">
                                    @if (testCase.Levels.Any())
                                    {
                                        @foreach (var level in testCase.Levels)
                                        {
                                            <span class="badge @GetLevelBadgeClass(level) me-1">@level</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">无</span>
                                    }
                                </dd>
                            </dl>
                        }
                        
                        <!-- 环境选择 -->
                        <div class="mt-3">
                            <label class="form-label">选择执行环境 <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="selectedEnvironmentId">
                                <option value="">请选择环境</option>
                                @foreach (var env in environments)
                                {
                                    <option value="@env.Id">@env.Name (@env.Status)</option>
                                }
                            </select>
                            @if (!string.IsNullOrEmpty(selectedEnvironmentId))
                            {
                                var selectedEnv = environments.FirstOrDefault(e => e.Id == selectedEnvironmentId);
                                if (selectedEnv != null)
                                {
                                    <small class="text-muted">@selectedEnv.Description</small>
                                }
                            }
                        </div>
                        
                        <!-- 性能测试设置 -->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label mb-0">⚡ 性能测试设置</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="TogglePerformanceSettings">
                                    @if (showPerformanceSettings)
                                    {
                                        <i class="oi oi-chevron-top"></i>
                                        <span>收起</span>
                                    }
                                    else
                                    {
                                        <i class="oi oi-chevron-bottom"></i>
                                        <span>展开</span>
                                    }
                                </button>
                            </div>
                            
                            @if (showPerformanceSettings)
                            {
                                <div class="card mt-2">
                                    <div class="card-body">
                                        <!-- 启用性能测试 -->
                                        <div class="form-check mb-3">
                                            <input class="form-check-input" type="checkbox" 
                                                   @bind="performanceSettings.IsPerformanceTestEnabled" 
                                                   id="enablePerformanceTest">
                                            <label class="form-check-label" for="enablePerformanceTest">
                                                启用性能测试模式
                                            </label>
                                            <div class="form-text">启用后将按照性能测试参数执行测试用例</div>
                                        </div>
                                        
                                        @if (performanceSettings.IsPerformanceTestEnabled)
                                        {
                                            <div class="row">
                                                <!-- 并发数 -->
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">并发数 <span class="text-danger">*</span></label>
                                                    <input type="number" class="form-control" 
                                                           @bind="performanceSettings.ConcurrentUsers" 
                                                           min="1" max="1000" 
                                                           placeholder="同时执行的线程数">
                                                    <div class="form-text">范围：1-1000，建议根据服务器性能设置</div>
                                                </div>
                                                
                                                <!-- 运行时间 -->
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">运行时间（秒） <span class="text-danger">*</span></label>
                                                    <input type="number" class="form-control" 
                                                           @bind="performanceSettings.DurationSeconds" 
                                                           min="1" max="86400" 
                                                           placeholder="测试持续时间">
                                                    <div class="form-text">范围：1-86400秒（24小时）</div>
                                                </div>
                                                
                                                <!-- 爬坡时间 -->
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">爬坡时间（秒）</label>
                                                    <input type="number" class="form-control" 
                                                           @bind="performanceSettings.RampUpSeconds" 
                                                           min="0" max="3600" 
                                                           placeholder="逐渐增加到目标并发数的时间">
                                                    <div class="form-text">范围：0-3600秒，0表示立即达到目标并发数</div>
                                                </div>
                                                
                                                <!-- 思考时间 -->
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">思考时间（毫秒）</label>
                                                    <input type="number" class="form-control" 
                                                           @bind="performanceSettings.ThinkTimeMs" 
                                                           min="0" max="60000" 
                                                           placeholder="每次请求之间的等待时间">
                                                    <div class="form-text">范围：0-60000毫秒，模拟用户操作间隔</div>
                                                </div>
                                                
                                                <!-- 最大错误率 -->
                                                <div class="col-md-12 mb-3">
                                                    <label class="form-label">最大错误率（%）</label>
                                                    <input type="number" class="form-control" 
                                                           @bind="performanceSettings.MaxErrorRate" 
                                                           min="0" max="100" step="0.1"
                                                           placeholder="超过此错误率将停止测试">
                                                    <div class="form-text">范围：0-100%，建议设置为5-20%</div>
                                                </div>
                                            </div>
                                            
                                            <!-- 性能测试预览 -->
                                            <div class="alert alert-info">
                                                <h6 class="alert-heading">📊 性能测试配置预览</h6>
                                                <ul class="mb-0">
                                                    <li><strong>并发用户数：</strong>@performanceSettings.ConcurrentUsers 个</li>
                                                    <li><strong>测试时长：</strong>@performanceSettings.DurationSeconds 秒 (@TimeSpan.FromSeconds(performanceSettings.DurationSeconds).ToString(@"hh\:mm\:ss"))</li>
                                                    <li><strong>爬坡时间：</strong>@performanceSettings.RampUpSeconds 秒</li>
                                                    <li><strong>思考时间：</strong>@performanceSettings.ThinkTimeMs 毫秒</li>
                                                    <li><strong>最大错误率：</strong>@performanceSettings.MaxErrorRate%</li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <!-- 执行按钮 -->
                        <div class="mt-4">
                            <button class="btn btn-success w-100" 
                                    @onclick="StartExecution" 
                                    disabled="@(string.IsNullOrEmpty(selectedEnvironmentId) || isExecuting || (IsBatchMode && !selectedTestCaseIds.Any()))">
                                @if (isExecuting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>执行中...</span>
                                }
                                else
                                {
                                    <i class="oi oi-play-circle me-2"></i>
                                    <span>@(IsBatchMode ? "开始批量执行" : "开始执行")</span>
                                }
                            </button>
                            
                            @if (isExecuting && cancellationTokenSource != null)
                            {
                                <button class="btn btn-outline-danger w-100 mt-2" @onclick="CancelExecution">
                                    <i class="oi oi-x me-2"></i>
                                    取消执行
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 右侧：执行进度和结果 -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">⚡ 执行进度</h6>
                            @if (executionRecords.Any())
                            {
                                var firstRecord = executionRecords.FirstOrDefault();
                                if (firstRecord != null)
                                {
                                    <span class="badge @GetExecutionStatusBadgeClass(firstRecord.Status)">@GetExecutionStatusDisplayName(firstRecord.Status)</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!executionRecords.Any())
                        {
                            <div class="text-center text-muted p-4">
                                <i class="oi oi-info"></i> 请选择环境@(IsBatchMode ? "和测试用例" : "")并点击开始执行
                            </div>
                        }
                        else
                        {
                            <!-- 执行统计 -->
                            @if (IsBatchMode)
                            {
                                <div class="row mb-3">
                                    <div class="col-3">
                                        <div class="text-center">
                                            <div class="h5 text-primary mb-0">@executionRecords.Count</div>
                                            <small class="text-muted">总用例</small>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <div class="h5 text-success mb-0">@executionRecords.Count(r => r.Status == ExecutionStatus.Success)</div>
                                            <small class="text-muted">成功</small>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <div class="h5 text-danger mb-0">@executionRecords.Count(r => r.Status == ExecutionStatus.Failed)</div>
                                            <small class="text-muted">失败</small>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <div class="h5 text-warning mb-0">@executionRecords.Count(r => r.Status == ExecutionStatus.Running)</div>
                                            <small class="text-muted">执行中</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 批量执行进度条 -->
                                var completedCases = executionRecords.Count(r => r.Status != ExecutionStatus.Running);
                                var totalCases = executionRecords.Count;
                                var batchProgressPercentage = totalCases > 0 ? (double)completedCases / totalCases * 100 : 0;
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="text-muted">批量执行进度</small>
                                        <small class="text-muted">@completedCases/@totalCases</small>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(batchProgressPercentage)%"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                var executionRecord = executionRecords.FirstOrDefault();
                                @if (executionRecord != null)
                                {
                                    <div class="row mb-3">
                                        <div class="col-3">
                                            <div class="text-center">
                                                <div class="h5 text-primary mb-0">@executionRecord.TotalSteps</div>
                                                <small class="text-muted">总步骤</small>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="text-center">
                                                <div class="h5 text-success mb-0">@executionRecord.SuccessSteps</div>
                                                <small class="text-muted">成功</small>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="text-center">
                                                <div class="h5 text-danger mb-0">@executionRecord.FailedSteps</div>
                                                <small class="text-muted">失败</small>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="text-center">
                                                <div class="h5 text-warning mb-0">@executionRecord.SkippedSteps</div>
                                                <small class="text-muted">跳过</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            
                            <!-- 进度条 -->
                            @if (!IsBatchMode)
                            {
                                var currentRecord = executionRecords.FirstOrDefault();
                                if (currentRecord != null && currentRecord.TotalSteps > 0)
                                {
                                    var completedSteps = currentRecord.SuccessSteps + currentRecord.FailedSteps + currentRecord.SkippedSteps;
                                    var progressPercentage = (double)completedSteps / currentRecord.TotalSteps * 100;
                                
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="text-muted">执行进度</small>
                                        <small class="text-muted">@completedSteps/@currentRecord.TotalSteps</small>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" style="width: @(progressPercentage)%"></div>
                                    </div>
                                </div>
                                }
                            }
                            
                            <!-- 执行时间 -->
                            @if (!IsBatchMode)
                            {
                                var currentRecord = executionRecords.FirstOrDefault();
                                if (currentRecord != null)
                            {
                                @if (currentRecord.Duration > 0)
                                {
                                    <div class="mb-3">
                                        <small class="text-muted">执行时间: @(currentRecord.Duration)ms</small>
                                    </div>
                                }
                                
                                <!-- 错误信息 -->
                                @if (!string.IsNullOrEmpty(currentRecord.ErrorMessage))
                                {
                                    <div class="alert alert-danger">
                                        <strong>执行失败:</strong> @currentRecord.ErrorMessage
                                    </div>
                                }
                                }
                            }
                            
                            <!-- 执行详情 -->
                            @if (IsBatchMode)
                            {
                                <!-- 批量执行用例列表 -->
                                <div class="mt-4">
                                    <h6>用例执行详情</h6>
                                    <div class="accordion" id="executionAccordion">
                                        @foreach (var record in executionRecords.OrderBy(r => r.TestCaseName))
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="heading-@record.Id">
                                                    <button class="accordion-button @(record.Status == ExecutionStatus.Running ? "" : "collapsed")" 
                                                            type="button" 
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="#collapse-@record.Id">
                                                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                                            <div>
                                                                <strong>@record.TestCaseName</strong>
                                                                <span class="badge @GetExecutionStatusBadgeClass(record.Status) ms-2">@GetExecutionStatusDisplayName(record.Status)</span>
                                                            </div>
                                                            <div class="text-end">
                                                                <small class="text-muted">@record.SuccessSteps/@record.TotalSteps 步骤</small>
                                                                @if (record.Duration > 0)
                                                                {
                                                                    <div class="small text-muted">@(record.Duration)ms</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </button>
                                                </h2>
                                                <div id="collapse-@record.Id" 
                                                     class="accordion-collapse collapse @(record.Status == ExecutionStatus.Running ? "show" : "")" 
                                                     data-bs-parent="#executionAccordion">
                                                    <div class="accordion-body">
                                                        @if (!string.IsNullOrEmpty(record.ErrorMessage))
                                                        {
                                                            <div class="alert alert-danger">
                                                                <strong>执行失败:</strong> @record.ErrorMessage
                                                            </div>
                                                        }
                                                        
                                                        @if (record.StepRecords.Any())
                                                        {
                                                            <div class="list-group">
                                                                @foreach (var stepRecord in record.StepRecords.OrderBy(s => s.Order))
                                                                {
                                                                    <div class="list-group-item">
                                                                        <div class="d-flex justify-content-between align-items-start">
                                                                            <div class="flex-grow-1">
                                                                                <div class="d-flex align-items-center mb-1">
                                                                                    <span class="badge @GetStepStatusBadgeClass(stepRecord.Status) me-2">@stepRecord.Order</span>
                                                                                    <strong>@stepRecord.StepName</strong>
                                                                                    <span class="badge bg-secondary ms-2">@stepRecord.StepType</span>
                                                                                </div>
                                                                                @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                                                                                {
                                                                                    <div class="text-danger small">@stepRecord.ErrorMessage</div>
                                                                                }
                                                                                @if (stepRecord.Logs.Any())
                                                                                {
                                                                                    <details class="mt-2">
                                                                                        <summary class="text-muted small">查看日志 (@stepRecord.Logs.Count 条)</summary>
                                                                                        <div class="mt-2">
                                                                                            @foreach (var log in stepRecord.Logs)
                                                                                            {
                                                                                                <div class="small text-muted">@log</div>
                                                                                            }
                                                                                        </div>
                                                                                    </details>
                                                                                }
                                                                            </div>
                                                                            <div class="text-end">
                                                                                <span class="badge @GetStepStatusBadgeClass(stepRecord.Status)">@GetStepStatusDisplayName(stepRecord.Status)</span>
                                                                                @if (stepRecord.Duration > 0)
                                                                                {
                                                                                    <div class="small text-muted">@(stepRecord.Duration)ms</div>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- 单个用例步骤详情 -->
                                var singleRecord = executionRecords.FirstOrDefault();
                                @if (singleRecord?.StepRecords.Any() == true)
                                {
                                    <div class="mt-4">
                                        <h6>步骤执行详情</h6>
                                        <div class="list-group">
                                            @foreach (var stepRecord in singleRecord.StepRecords.OrderBy(s => s.Order))
                                            {
                                                <div class="list-group-item">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex align-items-center mb-1">
                                                                <span class="badge @GetStepStatusBadgeClass(stepRecord.Status) me-2">@stepRecord.Order</span>
                                                                <strong>@stepRecord.StepName</strong>
                                                                <span class="badge bg-secondary ms-2">@stepRecord.StepType</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                                                            {
                                                                <div class="text-danger small">@stepRecord.ErrorMessage</div>
                                                            }
                                                            @if (stepRecord.Logs.Any())
                                                            {
                                                                <details class="mt-2">
                                                                    <summary class="text-muted small">查看日志 (@stepRecord.Logs.Count 条)</summary>
                                                                    <div class="mt-2">
                                                                        @foreach (var log in stepRecord.Logs)
                                                                        {
                                                                            <div class="small text-muted">@log</div>
                                                                        }
                                                                    </div>
                                                                </details>
                                                            }
                                                        </div>
                                                        <div class="text-end">
                                                            <span class="badge @GetStepStatusBadgeClass(stepRecord.Status)">@GetStepStatusDisplayName(stepRecord.Status)</span>
                                                            @if (stepRecord.Duration > 0)
                                                            {
                                                                <div class="small text-muted">@(stepRecord.Duration)ms</div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string TestCaseId { get; set; } = string.Empty;
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    
    private ProjectCaseDto? testCase;
    private List<ProjectCaseDto> testCases = new();
    private List<EnvironmentDto> environments = new();
    private string selectedEnvironmentId = string.Empty;
    private bool loading = true;
    private bool isExecuting = false;
    private List<ExecutionRecordDto> executionRecords = new();
    private HashSet<string> selectedTestCaseIds = new();
    private CancellationTokenSource? cancellationTokenSource;
    private Dictionary<string, ExecutionRecordDto> currentExecutionRecords = new();
    
    // 性能测试设置
    private PerformanceTestSettingsDto performanceSettings = new();
    private bool showPerformanceSettings = false;
    
    private bool IsBatchMode => !string.IsNullOrEmpty(ProjectId);
    
    protected override async Task OnInitializedAsync()
    {
        // 订阅执行引擎的实时更新事件
        ExecutionEngine.StepUpdated += OnStepUpdated;
        ExecutionEngine.ExecutionUpdated += OnExecutionUpdated;
        
        // 如果是批量模式，从查询参数获取选中的用例ID
        if (IsBatchMode)
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var selectedIds = queryParameters["selectedIds"];
            
            if (!string.IsNullOrEmpty(selectedIds))
            {
                selectedTestCaseIds = selectedIds.Split(',').ToHashSet();
            }
        }
        
        await LoadData();
    }
    
    private async Task LoadData()
    {
        try
        {
            loading = true;
            
            if (IsBatchMode)
            {
                // 批量模式：加载项目下的所有测试用例
                testCases = await ProjectCaseService.GetByProjectIdAsync(ProjectId);
                
                if (testCases.Any())
                {
                    // 加载环境列表
                    environments = await EnvironmentService.GetByProjectIdAsync(ProjectId);
                    
                    // 默认选中第一个环境
                    if (environments.Count > 0)
                    {
                        selectedEnvironmentId = environments[0].Id;
                    }
                    
                    // 如果没有从查询参数获取到选中的用例，则默认选中所有用例
                    if (!selectedTestCaseIds.Any())
                    {
                        selectedTestCaseIds = testCases.Select(tc => tc.Id).ToHashSet();
                    }
                }
            }
            else
            {
                // 单个模式：加载指定测试用例
                testCase = await ProjectCaseService.GetByIdAsync(TestCaseId);
                
                if (testCase != null)
                {
                    // 加载环境列表
                    environments = await EnvironmentService.GetByProjectIdAsync(testCase.ProjectId);
                    
                    // 默认选中第一个环境
                    if (environments.Count > 0)
                    {
                        selectedEnvironmentId = environments[0].Id;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"加载数据失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
    
    private async Task StartExecution()
    {
        if (string.IsNullOrEmpty(selectedEnvironmentId))
            return;
            
        if (IsBatchMode && !selectedTestCaseIds.Any())
            return;
            
        if (!IsBatchMode && testCase == null)
            return;
            
        try
        {
            isExecuting = true;
            cancellationTokenSource = new CancellationTokenSource();
            executionRecords.Clear();
            currentExecutionRecords.Clear();
            
            if (IsBatchMode)
            {
                // 批量执行
                var batchSettings = new BatchExecutionSettings
                {
                    SelectedTestCaseIds = selectedTestCaseIds.ToList(),
                    PerformanceSettings = performanceSettings,
                    IsParallelExecution = false, // 可以后续添加并行执行选项
                    ContinueOnFailure = true // 可以后续添加失败时是否继续的选项
                };
                
                try
                {
                    var batchResult = await BatchExecutionService.ExecuteBatchAsync(
                        batchSettings, 
                        selectedEnvironmentId, 
                        cancellationTokenSource.Token);
                    
                    // 更新执行记录
                    executionRecords.AddRange(batchResult.ExecutionRecords);
                    foreach (var record in batchResult.ExecutionRecords)
                    {
                        currentExecutionRecords[record.TestCaseId] = record;
                    }
                    
                    StateHasChanged();
                    
                    // 显示批量执行结果
                    var message = $"批量执行完成！\n" +
                                 $"总用例数: {batchResult.TotalTestCases}\n" +
                                 $"成功: {batchResult.SuccessfulTestCases}\n" +
                                 $"失败: {batchResult.FailedTestCases}\n" +
                                 $"执行时间: {batchResult.Duration:hh\\:mm\\:ss}";
                    
                    if (performanceSettings.IsPerformanceTestEnabled)
                    {
                        message += $"\n总执行次数: {batchResult.TotalExecutions}\n" +
                                  $"成功率: {batchResult.SuccessRate:F2}%\n" +
                                  $"错误率: {batchResult.ErrorRate:F2}%\n" +
                                  $"平均执行时间: {batchResult.AverageExecutionTime.TotalMilliseconds:F0}ms";
                    }
                    
                    await JSRuntime.InvokeVoidAsync("alert", message);
                }
                catch (Exception ex)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"批量执行失败: {ex.Message}");
                }
            }
            else
            {
                // 单个执行
                // 初始化执行记录
                var initialRecord = new ExecutionRecordDto
                {
                    Id = Guid.NewGuid().ToString(),
                    TestCaseId = testCase!.Id,
                    TestCaseName = testCase.Name,
                    Status = ExecutionStatus.Running,
                    StartTime = DateTime.Now,
                    TotalSteps = testCase.Steps.Count,
                    SuccessSteps = 0,
                    FailedSteps = 0,
                    SkippedSteps = 0,
                    StepRecords = new List<StepExecutionRecord>()
                };
                
                currentExecutionRecords[testCase.Id] = initialRecord;
                executionRecords.Add(initialRecord);
                StateHasChanged();
                
                var record = await ExecutionEngine.ExecuteTestCaseAsync(
                    testCase!, 
                    selectedEnvironmentId, 
                    cancellationTokenSource.Token);
                
                // 最终更新记录
                var index = executionRecords.FindIndex(r => r.TestCaseId == testCase.Id);
                if (index >= 0)
                {
                    executionRecords[index] = record;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"执行失败: {ex.Message}");
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }
    
    private void GoBack()
    {
        if (IsBatchMode)
        {
            // 批量模式：返回到项目的测试用例页面
            if (!string.IsNullOrEmpty(ProjectId))
            {
                Navigation.NavigateTo($"/autotest/project-cases/{ProjectId}");
            }
            else
            {
                Navigation.NavigateTo("/autotest/project-cases");
            }
        }
        else
        {
            // 单个模式：获取当前测试用例的项目ID，返回时保持项目选择
            if (testCase != null && !string.IsNullOrEmpty(testCase.ProjectId))
            {
                Navigation.NavigateTo($"/autotest/project-cases/{testCase.ProjectId}");
            }
            else
            {
                Navigation.NavigateTo("/autotest/project-cases");
            }
        }
    }
    
    private void CancelExecution()
    {
        cancellationTokenSource?.Cancel();
    }
    
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var selected = (bool)e.Value!;
        if (selected)
        {
            selectedTestCaseIds = testCases.Select(tc => tc.Id).ToHashSet();
        }
        else
        {
            selectedTestCaseIds.Clear();
        }
        StateHasChanged();
    }
    
    private void ToggleTestCaseSelection(string testCaseId, bool selected)
     {
         if (selected)
         {
             selectedTestCaseIds.Add(testCaseId);
         }
         else
         {
             selectedTestCaseIds.Remove(testCaseId);
         }
         StateHasChanged();
     }
     
     private void TogglePerformanceSettings()
     {
         showPerformanceSettings = !showPerformanceSettings;
         StateHasChanged();
     }
     
     private bool IsAllSelected => testCases.Any() && selectedTestCaseIds.Count == testCases.Count;
     private bool IsPartialSelected => selectedTestCaseIds.Any() && selectedTestCaseIds.Count < testCases.Count;
     
     // 批量执行统计
     private int TotalSelectedCases => selectedTestCaseIds.Count;
     private int CompletedCases => executionRecords.Count;
     private int SuccessfulCases => executionRecords.Count(r => r.Status == ExecutionStatus.Success);
     private int FailedCases => executionRecords.Count(r => r.Status == ExecutionStatus.Failed);
     private int ExecutingCases => isExecuting ? 1 : 0;
     
     // 批量执行进度
     private double BatchProgress => TotalSelectedCases > 0 ? (double)CompletedCases / TotalSelectedCases * 100 : 0;
    
