@page "/autotest/project-cases"  
@page "/autotest/project-cases/{ProjectId}"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@inject IProjectAppService ProjectService
@inject IProjectCaseCategoryAppService ProjectCaseCategoryAppService
@inject IProjectCaseAppService ProjectCaseService
@inject IBatchExecutionAppService BatchExecutionAppService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>测试用例管理</PageTitle>

<!-- 项目选择、统计信息和操作按钮区域 -->
<div style="margin-bottom: 16px;">
    <AntDesign.Row Gutter="16" Style="margin-bottom: 16px; align-items: center;">
        <!-- 左侧：项目选择 -->
        <AntDesign.Col Span="6">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>选择项目:</span>
                <AntDesign.Select TItemValue="string" TItem="string" 
                                  Style="width: 200px;" 
                                  @bind-Value="selectedProjectId" 
                                  OnChange="OnProjectChanged"
                                  Placeholder="请选择项目">
                    @foreach (var project in projects)
                    {
                        <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@project.Id" Label="@project.Name" />
                    }
                </AntDesign.Select>
            </div>
        </AntDesign.Col>
        
        <!-- 中间：项目统计 -->
        <AntDesign.Col Span="12">
            <AntDesign.Row Gutter="16" Style="justify-content: space-around;">
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #1890ff; font-weight: 500;">@filteredTestCases.Count</div>
                        <div style="color: #999; font-size: 12px;">总用例</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #ff4d4f; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T0"))</div>
                        <div style="color: #999; font-size: 12px;">T0级别</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #faad14; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T1"))</div>
                        <div style="color: #999; font-size: 12px;">T1级别</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #52c41a; font-weight: 500;">@selectedTestCases.Count</div>
                        <div style="color: #999; font-size: 12px;">已选中</div>
                    </div>
                </AntDesign.Col>
            </AntDesign.Row>
        </AntDesign.Col>
        
        <!-- 右侧：操作按钮 -->
        <AntDesign.Col Span="6">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <AntDesign.Button Type="@ButtonType.Default" 
                                  Style="background-color: #52c41a; border-color: #52c41a; color: white;"
                                  @onclick="ExecuteSelectedTests" 
                                  Disabled="@(!selectedTestCases.Any() || string.IsNullOrEmpty(selectedProjectId))">
                    ▶ 执行选中
                </AntDesign.Button>
                <AntDesign.Button Type="@ButtonType.Primary" @onclick="CreateNewTestCase">
                    ➕ 新建用例
                </AntDesign.Button>
            </div>
        </AntDesign.Col>
    </AntDesign.Row>
</div>

@if (!string.IsNullOrEmpty(selectedProjectId))
{
    <!-- 主体内容区域 -->
    <div style="height: calc(100vh - 155px);">
        <AntDesign.Row Gutter="16" Style="height: 100%;">
            <!-- 左侧分类栏 -->
            <AntDesign.Col Span="6" Style="height: 100%;">
                <AntDesign.Card Style="height: 100%; display: flex; flex-direction: column;">
                    <ChildContent>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span style="font-weight: 500;">📁 分类</span>
                            <AntDesign.Button Type="@ButtonType.Primary" Shape="@ButtonShape.Circle" Size="@ButtonSize.Small" @onclick="ShowAddCategoryModal">
                                ➕
                            </AntDesign.Button>
                        </div>
                        <div style="flex: 1; overflow-y: auto;">
                            <div class="list-group list-group-flush">
                                <button class="list-group-item list-group-item-action py-2 @(string.IsNullOrEmpty(selectedCategoryId) ? "active" : "")"
                                        @onclick="() => SelectCategory(null)" style="cursor: pointer;">
                                    <small><i class="oi oi-list"></i> 全部 (@filteredTestCases.Count)</small>
                                </button>
                                
                                @foreach (var rootCategory in GetRootCategories())
                                {
                                    @RenderCategoryItem(rootCategory, 0)
                                }
                                
                                @if (!categories.Any())
                                {
                                    <div class="text-center text-muted py-2">
                                        <small>暂无分类</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </AntDesign.Card>
            </AntDesign.Col>
            
            <!-- 右侧：测试用例列表 -->
            <AntDesign.Col Span="18" Style="height: 100%;">
                <AntDesign.Card Style="height: 100%; display: flex; flex-direction: column;">
                    <ChildContent>
                        <!-- 搜索框 -->
                        <div style="margin-bottom: 12px;">
                            <AntDesign.Input Search="true" 
                                           Placeholder="搜索用例..." 
                                           @bind-Value="searchTerm" 
                                           OnSearch="SearchTestCases" 
                                           Style="width: 300px;" />
                        </div>
                        
                        <!-- 表格 -->
                        <div style="flex: 1; overflow-y: auto;">
                            @if (loading)
                            {
                                <div style="text-align: center; padding: 40px;">
                                    <AntDesign.Spin Tip="加载中..." />
                                </div>
                            }
                            else if (displayTestCases.Any())
                            {
                                <AntDesign.Table DataSource="displayTestCases" 
                                               TItem="ProjectCaseDto" 
                                               Bordered="true"
                                               Size="@TableSize.Small"
                                               RowKey="context => context.Id"
                                               PageSize="20">
                                    <AntDesign.Column TData="bool" Title="" Width="50px">
                                        <HeaderTemplate>
                                            <input type="checkbox" class="form-check-input" @onchange="ToggleSelectAll">
                                        </HeaderTemplate>
                                        <Cell>
                                            <input type="checkbox" 
                                                   class="form-check-input" 
                                                   checked="@selectedTestCases.Contains(context.Id)" 
                                                   @onchange="@(e => ToggleTestCaseSelection(context.Id, (bool)e.Value!))">
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="string" Title="用例编号" Width="100px">
                                        <Cell>
                                            <span style="color: #999;">@(string.IsNullOrEmpty(context.CaseNumber) ? "-" : context.CaseNumber)</span>
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="string" Title="用例名称">
                                        <Cell>
                                            <div>
                                                <strong>@context.Name</strong>
                                                @if (context.IsTemplate)
                                                {
                                                    <AntDesign.Tag Color="@TagColor.Blue" style="margin-left: 8px;">模板</AntDesign.Tag>
                                                }
                                                @if (!string.IsNullOrEmpty(context.TemplateId))
                                                {
                                                    <AntDesign.Tag Color="@TagColor.Default" style="margin-left: 4px;">继承</AntDesign.Tag>
                                                }
                                                @if (!string.IsNullOrEmpty(context.Description))
                                                {
                                                    <div style="color: #999; font-size: 12px; margin-top: 4px;">@context.Description</div>
                                                }
                                            </div>
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="string" Title="级别" Width="120px">
                                        <Cell>
                                            @if (context.Levels.Any())
                                            {
                                                @foreach (var level in context.Levels.Take(3))
                                                {
                                                    <AntDesign.Tag Color="@GetLevelTagColor(level)" style="margin-right: 4px;">@level</AntDesign.Tag>
                                                }
                                                @if (context.Levels.Count > 3)
                                                {
                                                    <span style="color: #999; font-size: 12px;">+@(context.Levels.Count - 3)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #999;">无</span>
                                            }
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="int" Title="步骤数" Width="60px">
                                        <Cell>
                                            @context.Steps.Count
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="string" Title="执行结果" Width="100px">
                                        <Cell>
                                            @if (context.LastExecutionResult.HasValue)
                                            {
                                                <AntDesign.Tag Color="@GetExecutionResultTagColor(context.LastExecutionResult.Value)">
                                                    @GetExecutionResultText(context.LastExecutionResult.Value)
                                                </AntDesign.Tag>
                                                @if (context.LastExecutionTime.HasValue)
                                                {
                                                    <div style="color: #999; font-size: 12px; margin-top: 4px;">@context.LastExecutionTime.Value.ToString("MM-dd HH:mm")</div>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #999;">未执行</span>
                                            }
                                        </Cell>
                                    </AntDesign.Column>
                                    
                                    <AntDesign.Column TData="string" Title="操作" Width="140px">
                                        <Cell>
                                            <div style="display: flex; gap: 4px;">
                                                <AntDesign.Button Type="@ButtonType.Default" 
                                                                Shape="@ButtonShape.Circle" 
                                                                Size="@ButtonSize.Small" 
                                                                @onclick="() => ExecuteSingleTest(context)" 
                                                                Style="color: #52c41a; border-color: #52c41a;" 
                                                                Title="执行测试">
                                                    ▶
                                                </AntDesign.Button>
                                                
                                                <AntDesign.Button Type="@ButtonType.Default" 
                                                                Shape="@ButtonShape.Circle" 
                                                                Size="@ButtonSize.Small" 
                                                                @onclick="() => EditTestCaseSteps(context)" 
                                                                Style="color: #1890ff; border-color: #1890ff;" 
                                                                Title="测试步骤">
                                                    📝
                                                </AntDesign.Button>
                                                
                                                <AntDesign.Dropdown Trigger="new[] { AntDesign.Trigger.Click }">
                                                    <ChildContent>
                                                        <AntDesign.Button Type="@ButtonType.Default" 
                                                                        Shape="@ButtonShape.Circle" 
                                                                        Size="@ButtonSize.Small" 
                                                                        Title="更多操作">
                                                            ⋯
                                                        </AntDesign.Button>
                                                    </ChildContent>
                                                    <Overlay>
                                                        <AntDesign.Menu>
                                                            <AntDesign.MenuItem @onclick="() => ShowTemplateSettingsModal(context)">
                                                                ⚙️ 模板设置
                                                            </AntDesign.MenuItem>
                                                            <AntDesign.MenuItem @onclick="() => ViewExecutionHistory(context)">
                                                                🕒 测试报告
                                                            </AntDesign.MenuItem>
                                                            <AntDesign.MenuItem @onclick="() => CopyTestCase(context)">
                                                                📄 复制
                                                            </AntDesign.MenuItem>
                                                            <AntDesign.MenuItem @onclick="() => ShowEditBasicInfoModal(context)">
                                                                ✏️ 编辑
                                                            </AntDesign.MenuItem>
                                                            <AntDesign.MenuItem Divider="true" />
                                                            <AntDesign.MenuItem @onclick="() => DeleteTestCase(context.Id)" Style="color: #ff4d4f;">
                                                                🗑️ 删除
                                                            </AntDesign.MenuItem>
                                                        </AntDesign.Menu>
                                                    </Overlay>
                                                </AntDesign.Dropdown>
                                            </div>
                                        </Cell>
                                    </AntDesign.Column>
                                </AntDesign.Table>
                            }
                            else
                            {
                                <div style="text-align: center; padding: 40px; color: #999;">
                                    <AntDesign.Empty Description="@("暂无测试用例数据")" />
                                </div>
                            }
                        </div>
                    </ChildContent>
                </AntDesign.Card>
            </AntDesign.Col>
        </AntDesign.Row>
    </div>
}
else
{
    <AntDesign.Alert Type="@AlertType.Warning" ShowIcon="true" Style="text-align: center;">
        ⚠️ 请先选择一个项目来管理测试用例
    </AntDesign.Alert>
}

<!-- 添加/编辑分类模态框 -->
@{
    var categoryModalTitle = isEditingCategory ? "编辑分类" : "新建分类";
}
<AntDesign.Modal @bind-Visible="showCategoryModal" 
                 Title="@categoryModalTitle" 
                 Width="@("600px")" 
                 OnOk="SaveCategory" 
                 OnCancel="HideCategoryModal">
    <EditForm Model="currentCategory" OnValidSubmit="SaveCategory">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <AntDesign.FormItem Label="分类名称" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <InputText class="form-control" @bind-Value="currentCategory.Name" />
            <ValidationMessage For="() => currentCategory.Name" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="描述" LabelColSpan="5" WrapperColSpan="19">
            <InputTextArea class="form-control" rows="2" @bind-Value="currentCategory.Description" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="父级分类" LabelColSpan="5" WrapperColSpan="19">
            <TreeSelectDropdown Categories="GetAvailableParentCategories()" 
                               SelectedValue="currentCategory.ParentId" 
                               EmptyOptionText="无(根分类)" 
                               Placeholder="请选择父级分类" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="排序" LabelColSpan="5" WrapperColSpan="19">
            <Microsoft.AspNetCore.Components.Forms.InputNumber class="form-control" @bind-Value="currentCategory.Order" />
        </AntDesign.FormItem>
    </EditForm>
</AntDesign.Modal>

<!-- 模板设置模态框 -->
<AntDesign.Modal @bind-Visible="showTemplateSettingsModal" 
                 Title="@($"模板设置 - {editingTestCase.Name}")" 
                 Width="@("600px")" 
                 OnOk="SaveTemplateSettings" 
                 OnCancel="HideTemplateSettingsModal">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px;">
            <AntDesign.Switch @bind-Checked="editingTestCase.IsTemplate" />
            <span Style="margin-left: 8px;">设为测试模板</span>
            <div Style="color: #999; font-size: 12px; margin-top: 4px;">将此用例设为模板，供其他用例继承。</div>
        </div>
        
        @if (!editingTestCase.IsTemplate)
        {
            <div Style="margin-bottom: 16px;">
                <label Style="display: block; margin-bottom: 8px;">继承模板</label>
                <AntDesign.Select TItemValue="string" TItem="string" 
                                  Style="width: 100%;" 
                                  @bind-Value="editingTestCase.TemplateId"
                                  Placeholder="无(独立用例)">
                    @foreach (var template in availableTemplates)
                    {
                        <AntDesign.SelectOption TItemValue="string" TItem="string" 
                                              Value="@template.Id" 
                                              Label="@(template.Name + (string.IsNullOrEmpty(template.CaseNumber) ? "" : $"({template.CaseNumber})"))" />
                    }
                </AntDesign.Select>
                <div Style="color: #999; font-size: 12px; margin-top: 4px;">
                    选择模板后，此用例将自动使用模板中的步骤。您只需在此处维护测试数据。
                    <br>
                    <span Style="color: #ff4d4f;">注意：继承模板后，当前用例的步骤将被覆盖且不可编辑。</span>
                </div>
            </div>
        }
    </div>
</AntDesign.Modal>

<!-- 测试用例基本信息编辑弹窗 -->
<ProjectCaseBasicInfoModal ShowModal="showBasicInfoModal" 
                        CurrentTestCase="currentTestCase" 
                        Categories="categories" 
                        IsEditing="isEditingBasicInfo" 
                        OnClose="HideBasicInfoModal" 
                        OnSave="SaveBasicInfo" 
                        OnSaveOnly="SaveBasicInfoOnly" />

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    
    private List<ProjectDto> projects = new();
    private List<ProjectCaseDto> testCases = new();
    private List<ProjectCaseDto> filteredTestCases = new();
    private List<ProjectCaseDto> displayTestCases = new();
    private List<ProjectCaseCategory> categories = new();
    private HashSet<string> selectedTestCases = new();
    
    private ProjectCaseDto currentTestCase = new();
    private ProjectCaseDto editingTestCase = new();
    private ProjectCaseCategory currentCategory = new();
    
    private bool loading = true;
    private bool showCategoryModal = false;
    private bool showTemplateSettingsModal = false;
    private List<ProjectCaseDto> availableTemplates = new();
    private bool isEditingCategory = false;
    private string selectedProjectId = "";
    private string selectedCategoryId = "";
    private string searchTerm = "";
    
    // 基本信息编辑相关
    private bool showBasicInfoModal = false;
    private bool isEditingBasicInfo = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ProjectId))
        {
            selectedProjectId = ProjectId;
        }
        await LoadData();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 如果 URL 中没有指定项目，且当前没有选中项目，尝试从 localStorage 恢复
            if (string.IsNullOrEmpty(ProjectId) && string.IsNullOrEmpty(selectedProjectId) && projects.Any())
            {
                var lastSelectedProjectId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "lastSelectedProjectId");
                
                if (!string.IsNullOrEmpty(lastSelectedProjectId) && projects.Any(p => p.Id == lastSelectedProjectId))
                {
                    selectedProjectId = lastSelectedProjectId;
                    await LoadProjectData();
                    StateHasChanged();
                }
                else if (!string.IsNullOrEmpty(selectedProjectId))
                {
                    // 如果 LoadData 已经默认选中了第一个项目，保存下来
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", selectedProjectId);
                }
            }
            
            // 恢复选中的分类
            if (!string.IsNullOrEmpty(selectedProjectId))
            {
                var savedCategoryId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"selectedCategoryId_{selectedProjectId}");
                if (!string.IsNullOrEmpty(savedCategoryId))
                {
                    selectedCategoryId = savedCategoryId;
                    FilterTestCases();
                    StateHasChanged();
                }
            }
        }
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ProjectId) && selectedProjectId != ProjectId)
        {
            selectedProjectId = ProjectId;
            await LoadProjectData();
        }
    }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();
        testCases = await ProjectCaseService.GetAllAsync();
        
        // 如果已有选中项目，加载项目数据
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            await LoadProjectData();
        }
        else if (projects.Any())
        {
            // 默认选中第一个项目
            selectedProjectId = projects.First().Id;
            await LoadProjectData();
        }
        
        loading = false;
        StateHasChanged();
    }
    
    private async Task LoadProjectData()
    {
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            testCases = await ProjectCaseService.GetAllAsync();
            categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            
            filteredTestCases = testCases.Where(tc => tc.ProjectId == selectedProjectId).ToList();
            FilterTestCases();
        }
        else
        {
            categories.Clear();
            filteredTestCases.Clear();
            displayTestCases.Clear();
        }
        
        selectedTestCases.Clear();
    }

    private RenderFragment RenderCategoryItem(ProjectCaseCategory category, int level) => __builder =>
    {
        var indentStyle = $"padding-left: {(level * 20 + 12)}px;";
        var hasChildren = HasChildCategories(category.Id);
        
        __builder.OpenElement(0, "button");
        __builder.AddAttribute(1, "class", $"list-group-item list-group-item-action py-2 {(selectedCategoryId == category.Id ? "active" : "")}");
        __builder.AddAttribute(2, "style", $"{indentStyle} cursor: pointer;");
        __builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => SelectCategory(category.Id)));
        
        __builder.OpenElement(4, "small");
        
        if (hasChildren)
        {
            __builder.AddMarkupContent(5, "<i class=\"oi oi-chevron-right me-2\" style=\"font-size: 0.7em;\"></i>");
        }
        else
        {
            __builder.AddMarkupContent(5, "<span style=\"display: inline-block; width: 12px; margin-right: 8px;\"></span>");
        }
        
        __builder.AddContent(6, $"{category.Name} ({GetCategoryTestCount(category.Id)})");
        __builder.CloseElement();
        __builder.CloseElement();
        
        var children = GetChildCategories(category.Id);
        foreach (var child in children)
        {
            __builder.AddContent(7, RenderCategoryItem(child, level + 1));
        }
    };

    private async Task OnProjectChanged(string? projectId)
    {
        selectedProjectId = projectId ?? "";
        selectedCategoryId = "";
        
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", selectedProjectId);
            Navigation.NavigateTo($"/autotest/project-cases/{selectedProjectId}", false);
            
            // 加载项目数据
            await LoadProjectData();
            StateHasChanged();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "lastSelectedProjectId");
            Navigation.NavigateTo("/autotest/project-cases", false);
        }
    }

    private async Task SelectCategory(string? categoryId)
    {
        selectedCategoryId = categoryId ?? "";
        
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            if (string.IsNullOrEmpty(selectedCategoryId))
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"selectedCategoryId_{selectedProjectId}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"selectedCategoryId_{selectedProjectId}", selectedCategoryId);
            }
        }
        
        FilterTestCases();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterTestCases();
    }

    private Task SearchTestCases()
    {
        FilterTestCases();
        return Task.CompletedTask;
    }

    private void FilterTestCases()
    {
        displayTestCases = filteredTestCases.Where(tc =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                               tc.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               tc.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            
            var matchesCategory = string.IsNullOrEmpty(selectedCategoryId) ||
                                 GetAllCategoryIds(selectedCategoryId).Contains(tc.CategoryId);
            
            return matchesSearch && matchesCategory;
        })
        .OrderBy(tc => string.IsNullOrEmpty(tc.CaseNumber) ? "zzz" : tc.CaseNumber)
        .ThenBy(tc => tc.Order)
        .ThenBy(tc => tc.CreatedAt)
        .ToList();
        
        StateHasChanged();
    }
    
    private HashSet<string> GetAllCategoryIds(string categoryId)
    {
        var categoryIds = new HashSet<string> { categoryId };
        AddAllChildCategoryIds(categoryId, categoryIds);
        return categoryIds;
    }
    
    private void AddAllChildCategoryIds(string parentId, HashSet<string> categoryIds)
    {
        var children = categories.Where(c => c.ParentId == parentId).ToList();
        foreach (var child in children)
        {
            categoryIds.Add(child.Id);
            AddAllChildCategoryIds(child.Id, categoryIds);
        }
    }

    private int GetCategoryTestCount(string categoryId)
    {
        var categoryIds = GetAllCategoryIds(categoryId);
        return filteredTestCases.Count(tc => categoryIds.Contains(tc.CategoryId));
    }
    
    private List<ProjectCaseCategory> GetRootCategories()
    {
        return categories.Where(c => string.IsNullOrEmpty(c.ParentId)).OrderBy(c => c.Order).ToList();
    }
    
    private List<ProjectCaseCategory> GetChildCategories(string parentId)
    {
        return categories.Where(c => c.ParentId == parentId).OrderBy(c => c.Order).ToList();
    }
    
    private bool HasChildCategories(string categoryId)
    {
        return categories.Any(c => c.ParentId == categoryId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = (bool)e.Value!;
        if (isChecked)
        {
            selectedTestCases = displayTestCases.Select(tc => tc.Id).ToHashSet();
        }
        else
        {
            selectedTestCases.Clear();
        }
        StateHasChanged();
    }

    private void ToggleTestCaseSelection(string testCaseId, bool isSelected)
    {
        if (isSelected)
        {
            selectedTestCases.Add(testCaseId);
        }
        else
        {
            selectedTestCases.Remove(testCaseId);
        }
        StateHasChanged();
    }

