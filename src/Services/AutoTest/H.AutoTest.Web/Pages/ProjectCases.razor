@page "/autotest/project-cases"

@namespace H.AutoTest.Web
@layout AutoTestLayout

<link href="_content/H.AutoTest.Web/css/category-tree.css" rel="stylesheet" />

@inject IProjectAppService ProjectService
@inject IProjectCaseCategoryAppService ProjectCaseCategoryAppService
@inject IProjectCaseAppService ProjectCaseService
@inject IBatchExecutionAppService BatchExecutionAppService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>测试用例管理</PageTitle>

<!-- 项目选择、统计信息和操作按钮区域 -->
<div style="margin-bottom: 16px;">
    <AntDesign.Row Gutter="16" Style="margin-bottom: 16px; align-items: center;">
        <!-- 左侧：项目选择 -->
        <AntDesign.Col Span="6">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>选择项目:</span>
                <AntDesign.Select TItemValue="string" TItem="string" 
                                  Style="width: 200px;" 
                                  Value="selectedProjectId" 
                                  ValueChanged="OnProjectChanged"
                                  Placeholder="请选择项目">
                    @foreach (var project in projects)
                    {
                        <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@project.Id" Label="@project.Name" />
                    }
                </AntDesign.Select>
            </div>
        </AntDesign.Col>
        
        <!-- 中间：项目统计 -->
        <AntDesign.Col Span="12">
            <AntDesign.Row Gutter="16" Style="justify-content: space-around;">
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #1890ff; font-weight: 500;">@filteredTestCases.Count</div>
                        <div style="color: #999; font-size: 12px;">总用例</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #ff4d4f; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T0"))</div>
                        <div style="color: #999; font-size: 12px;">T0级别</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #faad14; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T1"))</div>
                        <div style="color: #999; font-size: 12px;">T1级别</div>
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <div style="text-align: center;">
                        <div style="font-size: 24px; color: #52c41a; font-weight: 500;">@selectedTestCases.Count</div>
                        <div style="color: #999; font-size: 12px;">已选中</div>
                    </div>
                </AntDesign.Col>
            </AntDesign.Row>
        </AntDesign.Col>
        
        <!-- 右侧：操作按钮 -->
        <AntDesign.Col Span="6">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <AntDesign.Button Type="@ButtonType.Default" 
                                  Style="background-color: #52c41a; border-color: #52c41a; color: white;"
                                  @onclick="ExecuteSelectedTests" 
                                  Disabled="@(!selectedTestCases.Any() || string.IsNullOrEmpty(selectedProjectId))">
                    ▶ 执行选中
                </AntDesign.Button>
                <AntDesign.Button Type="@ButtonType.Primary" @onclick="CreateNewTestCase">
                    ➕ 新建用例
                </AntDesign.Button>
            </div>
        </AntDesign.Col>
    </AntDesign.Row>
</div>

<!-- 主体内容区域 -->
<div style="height: calc(100vh - 155px);">
    <AntDesign.Row Gutter="16" Style="height: 100%;">
        <!-- 左侧分类栏 -->
        <AntDesign.Col Span="5" Style="height: 100%;">
            <AntDesign.Card Style="height: 100%; display: flex; flex-direction: column;">
                <ChildContent>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-weight: 500;">📁 分类</span>
                        <AntDesign.Button Type="@ButtonType.Primary" Shape="@ButtonShape.Circle" Size="@ButtonSize.Small" @onclick="ShowAddCategoryModal">
                            ➕
                        </AntDesign.Button>
                    </div>
                    <div style="flex: 1; overflow-y: auto;">
                        <button class="tree-node-row py-2 @(string.IsNullOrEmpty(selectedCategoryId) ? "selected" : "")"
                                @onclick="() => SelectCategory(null)" 
                                style="cursor: pointer; width: 100%; border: none; border-radius: 4px; margin-bottom: 2px;">
                            <span class="tree-node-expand-icon placeholder"></span>
                            <span class="tree-node-title"><small><i class="oi oi-list"></i> 全部 (@testCases.Count)</small></span>
                        </button>
                        <CategoryTree Categories="categories"
                                     SelectedCategoryId="selectedCategoryId"
                                     OnCategorySelected="SelectCategory"
                                     OnAddChild="ShowAddChildCategoryModal"
                                     OnEdit="ShowEditCategoryModal"
                                     OnDelete="HandleDeleteCategory"
                                     TestCaseCounts="categoryTestCaseCounts" />
                    </div>
                </ChildContent>
            </AntDesign.Card>
        </AntDesign.Col>

        <!-- 右侧：测试用例列表 -->
        <AntDesign.Col Span="18" Style="height: 100%;">
            <AntDesign.Card Style="height: 100%; display: flex; flex-direction: column;">
                <ChildContent>
                    <!-- 搜索框 -->
                    <div style="margin-bottom: 12px;">
                        <AntDesign.Input Placeholder="搜索用例..."
                                         @bind-Value="searchTerm"
                                         Style="width: 300px;" />
                    </div>

                    <!-- 表格 -->
                    <div style="flex: 1; overflow-y: auto;">
                        @if (loading)
                        {
                            <div style="text-align: center; padding: 40px;">
                                <AntDesign.Spin Tip="加载中..." />
                            </div>
                        }
                        else if (displayTestCases.Any())
                        {
                            <AntDesign.Table DataSource="displayTestCases"
                                             TItem="ProjectCaseDto"
                                             Bordered="true"
                                             Size="@TableSize.Small"
                                             RowKey="context => context.Id"
                                             PageSize="20"
                                             HidePagination="false">
                                <!-- 复选框列 -->
                                @* <AntDesign.Column TData="bool" Width="50px">
                                    <AntDesign.Checkbox @checked="selectedTestCases.Contains(context.Id)"
                                                        @onchange="@(e => ToggleTestCaseSelection(context.Id, e.Value as bool?))" />
                                </AntDesign.Column> *@

                                <AntDesign.Column TData="string" Title="用例编号" Width="100px">
                                    <span style="color: #999;">@context.CaseNumber</span>
                                </AntDesign.Column>

                                <AntDesign.Column TData="string" Title="用例名称">
                                    <div>
                                        <strong>@context.Name</strong>
                                        @if (context.IsTemplate)
                                        {
                                            <AntDesign.Tag Color="@TagColor.Blue" style="margin-left: 8px;">模板</AntDesign.Tag>
                                        }
                                        @if (!string.IsNullOrEmpty(context.TemplateId))
                                        {
                                            <AntDesign.Tag Color="@TagColor.Default" style="margin-left: 4px;">继承</AntDesign.Tag>
                                        }
                                        @if (!string.IsNullOrEmpty(context.Description))
                                        {
                                            <div style="color: #999; font-size: 12px; margin-top: 4px;">@context.Description</div>
                                        }
                                    </div>
                                </AntDesign.Column>

                                <AntDesign.Column TData="string" Title="级别" Width="120px">
                                    @if (context.Levels.Any())
                                    {
                                        @foreach (var level in context.Levels.Take(3))
                                        {
                                            <AntDesign.Tag Color="@GetLevelTagColor(level)" style="margin-right: 4px;">@level</AntDesign.Tag>
                                        }
                                        @if (context.Levels.Count > 3)
                                        {
                                            <span style="color: #999; font-size: 12px;">+@(context.Levels.Count - 3)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #999;">无</span>
                                    }
                                </AntDesign.Column>

                                <AntDesign.Column TData="int" Title="步骤数" Width="60px">
                                    @context.Steps.Count
                                </AntDesign.Column>

                                <AntDesign.Column TData="string" Title="执行结果" Width="100px">
                                    @if (context.LastExecutionResult.HasValue)
                                    {
                                        <AntDesign.Tag Color="@GetExecutionResultTagColor(context.LastExecutionResult.Value)">
                                            @GetExecutionResultText(context.LastExecutionResult.Value)
                                        </AntDesign.Tag>
                                        @if (context.LastExecutionTime.HasValue)
                                        {
                                            <div style="color: #999; font-size: 12px; margin-top: 4px;">@context.LastExecutionTime.Value.ToString("MM-dd HH:mm")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #999;">未执行</span>
                                    }
                                </AntDesign.Column>

                                <!-- 操作列 -->
                                <AntDesign.Column TData="string" Title="操作" Width="180px">
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <AntDesign.Button Type="@ButtonType.Link"
                                                          Size="@ButtonSize.Small"
                                                          @onclick="() => ExecuteSingleTest(context)"
                                                          Style="color: #52c41a; padding: 0;">
                                            <i class="anticon anticon-play-circle" style="margin-right: 4px;"></i>执行测试
                                        </AntDesign.Button>

                                        <AntDesign.Button Type="@ButtonType.Link"
                                                          Size="@ButtonSize.Small"
                                                          @onclick="() => EditTestCaseSteps(context)"
                                                          Style="color: #1890ff; padding: 0;">
                                            <i class="anticon anticon-edit" style="margin-right: 4px;"></i>测试步骤
                                        </AntDesign.Button>

                                        <AntDesign.Dropdown Trigger="new[] { AntDesign.Trigger.Click }">
                                            <ChildContent>
                                                <AntDesign.Button Type="@ButtonType.Link"
                                                                  Size="@ButtonSize.Small"
                                                                  Style="color: #666; padding: 0;">
                                                    <i class="anticon anticon-ellipsis" style="margin-right: 4px;"></i>更多
                                                </AntDesign.Button>
                                            </ChildContent>
                                            <Overlay>
                                                <AntDesign.Menu>
                                                    <AntDesign.MenuItem @onclick="() => ShowTemplateSettingsModal(context)">
                                                        <i class="anticon anticon-setting" style="margin-right: 8px;"></i>模板设置
                                                    </AntDesign.MenuItem>
                                                    <AntDesign.MenuItem @onclick="() => ViewExecutionHistory(context)">
                                                        <i class="anticon anticon-history" style="margin-right: 8px;"></i>测试报告
                                                    </AntDesign.MenuItem>
                                                    <AntDesign.MenuItem @onclick="() => CopyTestCase(context)">
                                                        <i class="anticon anticon-copy" style="margin-right: 8px;"></i>复制
                                                    </AntDesign.MenuItem>
                                                    <AntDesign.MenuItem @onclick="() => ShowEditBasicInfoModal(context)">
                                                        <i class="anticon anticon-edit" style="margin-right: 8px;"></i>编辑
                                                    </AntDesign.MenuItem>
                                                    <AntDesign.MenuItem Divider="true" />
                                                    <AntDesign.MenuItem @onclick="() => DeleteTestCase(context.Id)" Style="color: #ff4d4f;">
                                                        <i class="anticon anticon-delete" style="margin-right: 8px;"></i>删除
                                                    </AntDesign.MenuItem>
                                                </AntDesign.Menu>
                                            </Overlay>
                                        </AntDesign.Dropdown>
                                    </div>
                                </AntDesign.Column>
                            </AntDesign.Table>
                        }
                        else
                        {
                            <div style="text-align: center; padding: 40px; color: #999;">
                                <AntDesign.Empty Description="@("暂无测试用例数据")" />
                            </div>
                        }
                    </div>
                </ChildContent>
            </AntDesign.Card>
        </AntDesign.Col>
    </AntDesign.Row>
</div>

<!-- 添加/编辑分类模态框 -->
@{
    var categoryModalTitle = isEditingCategory ? "编辑分类" : "新建分类";
}
<AntDesign.Modal @bind-Visible="showCategoryModal" 
                 Title="@categoryModalTitle" 
                 Width="@("600px")" 
                 OnOk="SaveCategory" 
                 OnCancel="HideCategoryModal">
    <EditForm Model="currentCategory" OnValidSubmit="SaveCategory">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <AntDesign.FormItem Label="分类名称" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <InputText class="form-control" @bind-Value="currentCategory.Name" />
            <ValidationMessage For="() => currentCategory.Name" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="父级分类" LabelColSpan="5" WrapperColSpan="19">
            <TreeSelectDropdown Categories="GetAvailableParentCategories()" 
                               SelectedValue="currentCategory.ParentId" 
                               EmptyOptionText="无(根分类)" 
                               Placeholder="请选择父级分类" />
        </AntDesign.FormItem>
        
        <AntDesign.FormItem Label="排序" LabelColSpan="5" WrapperColSpan="19">
            <Microsoft.AspNetCore.Components.Forms.InputNumber class="form-control" @bind-Value="currentCategory.Order" />
        </AntDesign.FormItem>
    </EditForm>
</AntDesign.Modal>

<!-- 模板设置模态框 -->
<AntDesign.Modal @bind-Visible="showTemplateSettingsModal" 
                 Title="@($"模板设置 - {editingTestCase.Name}")" 
                 Width="@("600px")" 
                 OnOk="SaveTemplateSettings" 
                 OnCancel="HideTemplateSettingsModal">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px;">
            <AntDesign.Switch @bind-Checked="editingTestCase.IsTemplate" />
            <span Style="margin-left: 8px;">设为测试模板</span>
            <div Style="color: #999; font-size: 12px; margin-top: 4px;">将此用例设为模板，供其他用例继承。</div>
        </div>
        
        @if (!editingTestCase.IsTemplate)
        {
            <div Style="margin-bottom: 16px;">
                <label Style="display: block; margin-bottom: 8px;">继承模板</label>
                <AntDesign.Select TItemValue="string" TItem="string" 
                                  Style="width: 100%;" 
                                  @bind-Value="editingTestCase.TemplateId"
                                  Placeholder="无(独立用例)">
                    @foreach (var template in availableTemplates)
                    {
                        <AntDesign.SelectOption TItemValue="string" TItem="string" 
                                              Value="@template.Id" 
                                              Label="@(template.Name + (string.IsNullOrEmpty(template.CaseNumber) ? "" : $"({template.CaseNumber})"))" />
                    }
                </AntDesign.Select>
                <div Style="color: #999; font-size: 12px; margin-top: 4px;">
                    选择模板后，此用例将自动使用模板中的步骤。您只需在此处维护测试数据。
                    <br>
                    <span Style="color: #ff4d4f;">注意：继承模板后，当前用例的步骤将被覆盖且不可编辑。</span>
                </div>
            </div>
        }
    </div>
</AntDesign.Modal>

<!-- 测试用例基本信息编辑弹窗 -->
<ProjectCaseBasicInfoModal ShowModal="showBasicInfoModal" 
                        CurrentTestCase="currentTestCase" 
                        Categories="categories" 
                        IsEditing="isEditingBasicInfo" 
                        OnClose="HideBasicInfoModal" 
                        OnSave="SaveBasicInfo" 
                        OnSaveOnly="SaveBasicInfoOnly" />

@code {
    private List<ProjectDto> projects = new();
    private List<ProjectCaseDto> testCases = new();
    private List<ProjectCaseDto> filteredTestCases = new();
    private List<ProjectCaseDto> displayTestCases = new();
    private List<ProjectCaseCategory> categories = new();
    private HashSet<string> selectedTestCases = new();

    private ProjectCaseDto currentTestCase = new();
    private ProjectCaseDto editingTestCase = new();
    private ProjectCaseCategory currentCategory = new();

    private bool loading = true;
    private bool showCategoryModal = false;
    private bool showTemplateSettingsModal = false;
    private List<ProjectCaseDto> availableTemplates = new();
    private bool isEditingCategory = false;
    private string selectedProjectId = "";
    private string selectedCategoryId = "";
    private string searchTerm = "";

    // 基本信息编辑相关
    private bool showBasicInfoModal = false;
    private bool isEditingBasicInfo = false;

    // 分类树展开/折叠状态
    private HashSet<string> expandedCategories = new();

    // 分类用例数量统计
    private Dictionary<string, int> categoryTestCaseCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();

        // 默认选中第一个项目
        if (projects.Any())
        {
            selectedProjectId = projects.First().Id;
        }

        await LoadProjectData();

        loading = false;
        StateHasChanged();
    }

    private async Task LoadProjectData()
    {
        Console.WriteLine($"============== renderMode={RendererInfo.Name}, selectedProjectId={selectedProjectId}");
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            testCases = await ProjectCaseService.GetByProjectIdAsync(selectedProjectId);

            filteredTestCases = testCases;
            CalculateCategoryTestCaseCounts();
            FilterTestCases();
        }
        else
        {
            categories = new List<ProjectCaseCategory>();
            filteredTestCases.Clear();
            displayTestCases.Clear();
            categoryTestCaseCounts.Clear();
        }

        selectedTestCases.Clear();
        StateHasChanged();
    }

    private async Task OnProjectChanged(string projectId)
    {
        // 忽略空值（Select 初始化时会传递空值）
        if (string.IsNullOrEmpty(projectId))
        {
            return;
        }
        
        // 忽略相同值，防止不必要的刷新
        if (projectId == selectedProjectId)
        {
            return;
        }

        selectedProjectId = projectId;
        selectedCategoryId = "";

        // 加载项目数据
        await LoadProjectData();
        StateHasChanged();
    }

    private async Task SelectCategory(string? categoryId)
    {
        selectedCategoryId = categoryId ?? "";
        
        if (!string.IsNullOrEmpty(selectedProjectId))
        {
            if (string.IsNullOrEmpty(selectedCategoryId))
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"selectedCategoryId_{selectedProjectId}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"selectedCategoryId_{selectedProjectId}", selectedCategoryId);
            }
        }
        
        FilterTestCases();
        StateHasChanged();
    }

    private void FilterTestCases()
    {
        displayTestCases = filteredTestCases.Where(tc =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                               tc.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               tc.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            
            var matchesCategory = string.IsNullOrEmpty(selectedCategoryId) ||
                                 GetAllCategoryIds(selectedCategoryId).Contains(tc.CategoryId);
            
            return matchesSearch && matchesCategory;
        })
        .OrderBy(tc => string.IsNullOrEmpty(tc.CaseNumber) ? "zzz" : tc.CaseNumber)
        .ThenBy(tc => tc.Order)
        .ThenBy(tc => tc.CreatedAt)
        .ToList();
        
        StateHasChanged();
    }
    
    private HashSet<string> GetAllCategoryIds(string categoryId)
    {
        var categoryIds = new HashSet<string> { categoryId };
        AddAllChildCategoryIds(categoryId, categoryIds);
        return categoryIds;
    }
    
    private void AddAllChildCategoryIds(string categoryId, HashSet<string> categoryIds)
    {
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                categoryIds.Add(child.Id);
                AddAllChildCategoryIds(child.Id, categoryIds);
            }
        }
    }
    
    private List<ProjectCaseCategory> GetRootCategories()
    {
        // 根分类是没有父级的分类，即不在任何其他分类的 Childrens 中
        var allChildIds = new HashSet<string>();
        foreach (var category in categories)
        {
            if (category.Childrens != null)
            {
                foreach (var child in category.Childrens)
                {
                    allChildIds.Add(child.Id);
                }
            }
        }
        return categories.Where(c => !allChildIds.Contains(c.Id)).OrderBy(c => c.Order).ToList();
    }
    
    private async Task OnTreeNodeClick(TreeEventArgs<ProjectCaseCategory> args)
    {
        if (args.Node?.DataItem != null)
        {
            await SelectCategory(args.Node.DataItem.Id);
        }
    }

    private void CalculateCategoryTestCaseCounts()
    {
        categoryTestCaseCounts.Clear();
        
        foreach (var category in categories)
        {
            // 获取该分类及其所有子分类的用例数量
            var categoryIds = GetAllCategoryIds(category.Id);
            var count = testCases.Count(tc => categoryIds.Contains(tc.CategoryId));
            categoryTestCaseCounts[category.Id] = count;
        }
    }

    private void ShowAddChildCategoryModal(ProjectCaseCategory parentCategory)
    {
        currentCategory = new ProjectCaseCategory 
        { 
            ProjectId = selectedProjectId
        };
        
        // 将新分类添加到父分类的 Childrens 中
        if (parentCategory.Childrens == null)
        {
            parentCategory.Childrens = Array.Empty<ProjectCaseCategory>();
        }
        
        isEditingCategory = false;
        showCategoryModal = true;
    }

    private async Task HandleDeleteCategory(ProjectCaseCategory category)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除分类 '{category.Name}' 吗?其子分类也会被删除。");
        if (confirmed)
        {
            await DeleteCategory(category.Id);
            CalculateCategoryTestCaseCounts();
        }
    }

    private void ToggleTestCaseSelection(string testCaseId, bool? isSelected)
    {
        if (isSelected == true)
        {
            selectedTestCases.Add(testCaseId);
        }
        else
        {
            selectedTestCases.Remove(testCaseId);
        }
        StateHasChanged();
    }

    private async Task ExecuteSelectedTests()
    {
        if (!selectedTestCases.Any()) return;
        
        var selectedIds = string.Join(",", selectedTestCases);
        Navigation.NavigateTo($"/autotest/test-execution/batch/{selectedProjectId}?selectedIds={selectedIds}");
    }

    private async Task ExecuteSingleTest(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/autotest/test-execution/{testCase.Id}");
    }
    
    private void ViewExecutionHistory(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/autotest/execution-history/{testCase.Id}?returnProjectId={selectedProjectId}");
    }
    
    private void EditTestCase(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/autotest/project-cases/{testCase.Id}/edit");
    }
    
    private void CreateNewTestCase()
    {
        if (string.IsNullOrEmpty(selectedProjectId))
        {
            JSRuntime.InvokeVoidAsync("alert", "请先选择一个项目");
            return;
        }
        
        currentTestCase = new ProjectCaseDto 
        { 
            ProjectId = selectedProjectId,
            CategoryId = selectedCategoryId
        };
        isEditingBasicInfo = false;
        showBasicInfoModal = true;
    }

    private async Task DeleteTestCase(string id)
    {
        await ProjectCaseService.DeleteAsync(id);
        await LoadProjectData();
    }

    private async Task CopyTestCase(ProjectCaseDto testCase)
    {
        try
        {
            var copiedId = await ProjectCaseService.CopyAsync(testCase.Id);
            await JSRuntime.InvokeVoidAsync("alert", $"测试用例 '{testCase.Name}' 复制成功！");
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"复制失败: {ex.Message}");
        }
    }

    private void ShowTemplateSettingsModal(ProjectCaseDto testCase)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(testCase);
        editingTestCase = System.Text.Json.JsonSerializer.Deserialize<ProjectCaseDto>(json)!;
        availableTemplates = testCases.Where(c => c.IsTemplate && c.Id != editingTestCase.Id).ToList();
        showTemplateSettingsModal = true;
    }

    private void HideTemplateSettingsModal()
    {
        showTemplateSettingsModal = false;
    }

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        editingTestCase.TemplateId = e.Value?.ToString();
    }

    private async Task SaveTemplateSettings()
    {
        try
        {
            if (!string.IsNullOrEmpty(editingTestCase.TemplateId))
            {
                editingTestCase.Steps.Clear();
            }

            await ProjectCaseService.UpdateAsync(editingTestCase.Id, editingTestCase);
            await LoadProjectData();
            showTemplateSettingsModal = false;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }

    private void ShowAddCategoryModal()
    {
        currentCategory = new ProjectCaseCategory { ProjectId = selectedProjectId };
        isEditingCategory = false;
        showCategoryModal = true;
    }

    private void ShowEditCategoryModal(ProjectCaseCategory category)
    {
        currentCategory = new ProjectCaseCategory
        {
            Id = category.Id,
            Name = category.Name,
            ProjectId = category.ProjectId,
            Order = category.Order,
            Childrens = category.Childrens
        };
        isEditingCategory = true;
        showCategoryModal = true;
    }

    private void HideCategoryModal()
    {
        showCategoryModal = false;
        currentCategory = new ProjectCaseCategory();
        isEditingCategory = false;
    }

    private async Task SaveCategory()
    {
        try
        {
            if (isEditingCategory)
            {
                await ProjectCaseCategoryAppService.UpdateAsync(currentCategory.Id, currentCategory);
            }
            else
            {
                await ProjectCaseCategoryAppService.CreateAsync(currentCategory);
            }
            
            categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            HideCategoryModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }

    private List<ProjectCaseCategory> GetAvailableParentCategories()
    {
        if (isEditingCategory)
        {
            var excludeIds = new HashSet<string> { currentCategory.Id };
            AddChildCategoryIds(currentCategory.Id, excludeIds);
            return categories.Where(c => !excludeIds.Contains(c.Id)).ToList();
        }
        else
        {
            return new List<ProjectCaseCategory>(categories);
        }
    }

    private void AddChildCategoryIds(string categoryId, HashSet<string> excludeIds)
    {
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                excludeIds.Add(child.Id);
                AddChildCategoryIds(child.Id, excludeIds);
            }
        }
    }

    private void AddChildCategory(ProjectCaseCategory parentCategory)
    {
        currentCategory = new ProjectCaseCategory 
        { 
            ProjectId = selectedProjectId
        };
        
        // 将新分类添加到父分类的 Childrens 中
        if (parentCategory.Childrens == null)
        {
            parentCategory.Childrens = Array.Empty<ProjectCaseCategory>();
        }
        
        isEditingCategory = false;
        showCategoryModal = true;
    }
    
    private void ToggleCategoryExpand(string categoryId)
    {
        if (expandedCategories.Contains(categoryId))
        {
            expandedCategories.Remove(categoryId);
        }
        else
        {
            expandedCategories.Add(categoryId);
        }
        StateHasChanged();
    }

    private async Task DeleteCategory(string categoryId)
    {
        await DeleteChildCategories(categoryId);
        await ProjectCaseCategoryAppService.DeleteAsync(selectedProjectId, categoryId);
        categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
        StateHasChanged();
    }

    private async Task DeleteChildCategories(string categoryId)
    {
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                await DeleteChildCategories(child.Id);
                await ProjectCaseCategoryAppService.DeleteAsync(selectedProjectId, child.Id);
            }
        }
    }

    private void ShowEditBasicInfoModal(ProjectCaseDto testCase)
    {
        currentTestCase = new ProjectCaseDto
        {
            Id = testCase.Id,
            CaseNumber = testCase.CaseNumber,
            Name = testCase.Name,
            Description = testCase.Description,
            ProjectId = testCase.ProjectId,
            CategoryId = testCase.CategoryId,
            Levels = new List<string>(testCase.Levels),
            Order = testCase.Order,
            Status = testCase.Status,
            Tags = new List<string>(testCase.Tags),
            Steps = testCase.Steps,
            CreatedAt = testCase.CreatedAt,
            CreatedBy = testCase.CreatedBy
        };
        
        isEditingBasicInfo = true;
        showBasicInfoModal = true;
    }
    
    private void EditTestCaseSteps(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/autotest/project-cases/{testCase.Id}/steps");
    }
    
    private Task HideBasicInfoModal()
    {
        showBasicInfoModal = false;
        currentTestCase = new ProjectCaseDto();
        isEditingBasicInfo = false;
        return Task.CompletedTask;
    }
    
    private async Task SaveBasicInfo(ProjectCaseDto testCase)
    {
        try
        {
            if (isEditingBasicInfo)
            {
                await ProjectCaseService.UpdateAsync(testCase.Id, testCase);
                await JSRuntime.InvokeVoidAsync("alert", "测试用例基本信息更新成功！");
            }
            else
            {
                await ProjectCaseService.CreateAsync(testCase);
                await JSRuntime.InvokeVoidAsync("alert", "测试用例创建成功！");
                Navigation.NavigateTo($"/autotest/project-cases/{testCase.Id}/steps");
                return;
            }
            
            await HideBasicInfoModal();
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }
    
    private async Task SaveBasicInfoOnly(ProjectCaseDto testCase)
    {
        try
        {
            await ProjectCaseService.CreateAsync(testCase);
            await JSRuntime.InvokeVoidAsync("alert", "测试用例保存成功！");
            
            await HideBasicInfoModal();
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }
    
    private string GetLevelTagColor(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        "P3" => "default",
        _ => "default"
    };
    
    private string GetExecutionResultTagColor(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "green",
        ExecutionStatus.Failed => "red",
        ExecutionStatus.Running => "blue",
        ExecutionStatus.Pending => "orange",
        _ => "default"
    };
    
    private string GetExecutionResultText(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "运行中",
        ExecutionStatus.Pending => "等待中",
        _ => "未知"
    };
    
    private void NavigateToProjectManagement()
    {
        if (string.IsNullOrEmpty(selectedProjectId))
            return;
            
        Navigation.NavigateTo($"/project-management");
    }

    private string GetEnvironmentTypeDisplayName(EnvironmentType type) => type switch
    {
        EnvironmentType.Development => "开发环境",
        EnvironmentType.Testing => "测试环境",
        EnvironmentType.Staging => "预发环境",
        EnvironmentType.Production => "生产环境",
        _ => "未知环境"
    };

    private string GetTestCaseName(string testCaseId)
    {
        var testCase = testCases.FirstOrDefault(tc => tc.Id == testCaseId);
        return testCase?.Name ?? "未知用例";
    }
