        ExecutionStatus.Failed => "bg-danger",       // 失败：红色
        ExecutionStatus.Running => "bg-primary",     // 运行中：蓝色
        ExecutionStatus.Pending => "bg-warning",     // 等待中：黄色
        _ => "bg-secondary"                           // 其他：灰色
    };
    
    private string GetExecutionResultText(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
