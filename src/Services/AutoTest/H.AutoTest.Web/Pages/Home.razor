@page "/autotest"

@namespace H.AutoTest.Web
@inject IProjectAppService ProjectService
@inject IProjectCaseAppService ProjectCaseService
@inject NavigationManager NavigationManager
@layout AutoTestLayout

<PageTitle>自动化测试</PageTitle>

<!-- 统计卡片 -->
<AntDesign.Row Gutter="16">
    <AntDesign.Col Span="12">
        <AntDesign.Statistic Title="项目数量" Value="@projectCount">
            <Prefix>
                <span style="font-size: 24px;">📁</span>
            </Prefix>
        </AntDesign.Statistic>
    </AntDesign.Col>
    <AntDesign.Col Span="12">
        <AntDesign.Statistic Title="测试用例" Value="@projectCaseCount">
            <Prefix>
                <span style="font-size: 24px;">📋</span>
            </Prefix>
        </AntDesign.Statistic>
    </AntDesign.Col>
</AntDesign.Row>

<!-- 功能快捷方式 -->
<AntDesign.Row Gutter="16" Style="margin-top: 20px;">
    <AntDesign.Col Span="12">
        <div @onclick="@(() => NavigationManager.NavigateTo("/autotest/projects"))" style="cursor: pointer;">
            <AntDesign.Card Title="📁 项目管理" Style="text-align: center;">
                <div Style="font-size: 48px; margin: 20px 0;">📁</div>
                <p>管理项目、配置项目环境</p>
            </AntDesign.Card>
        </div>
    </AntDesign.Col>
    <AntDesign.Col Span="12">
        <div @onclick="@(() => NavigationManager.NavigateTo("/autotest/project-cases"))" style="cursor: pointer;">
            <AntDesign.Card Title="📋 测试用例" Style="text-align: center;">
                <div Style="font-size: 48px; margin: 20px 0;">📋</div>
                <p>设计和管理 API 和 UI 测试用例</p>
            </AntDesign.Card>
        </div>
    </AntDesign.Col>
</AntDesign.Row>

@code {
    private int projectCount = 0;
    private int projectCaseCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // 加载各种统计数据
            var projects = await ProjectService.GetAllAsync();
            projectCount = projects.Count;

            var projectCases = await ProjectCaseService.GetAllAsync();
            projectCaseCount = projectCases.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载数据失败: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }
}
