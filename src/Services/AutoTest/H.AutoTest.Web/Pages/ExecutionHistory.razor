@page "/autotest/execution-history/{testCaseId}"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@inject IProjectCaseAppService ProjectCaseService
@inject IExecutionRecordAppService ExecutionRecordService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>执行历史记录</PageTitle>

<AntDesign.Row Justify="RowJustify.SpaceBetween" Align="RowAlign.Middle" Style="margin-bottom: 16px;">
    <AntDesign.Col>
        <div style="font-size: 18px; font-weight: 600; margin-bottom: 4px;">📊 执行历史记录</div>
        <AntDesign.Breadcrumb>
            <AntDesign.BreadcrumbItem>
                <a href="/autotest/project-cases">测试用例</a>
            </AntDesign.BreadcrumbItem>
            <AntDesign.BreadcrumbItem>执行历史</AntDesign.BreadcrumbItem>
        </AntDesign.Breadcrumb>
    </AntDesign.Col>
    <AntDesign.Col>
        <AntDesign.Space>
            <SpaceItem>
                <AntDesign.Button OnClick="RefreshData">🔄 刷新</AntDesign.Button>
            </SpaceItem>
            <SpaceItem>
                <AntDesign.Button OnClick="GoBack">← 返回</AntDesign.Button>
            </SpaceItem>
        </AntDesign.Space>
    </AntDesign.Col>
</AntDesign.Row>

@if (loading)
{
    <div style="text-align: center; padding: 60px 0;">
        <AntDesign.Spin Size="@SpinSize.Large" Tip="正在加载执行历史..." />
    </div>
}
else if (testCase == null)
{
    <AntDesign.Alert Type="@AlertType.Error" ShowIcon="true" Message="未找到指定的测试用例" />
}
else
{
    <AntDesign.Row Gutter="16">
        <!-- 左侧：测试用例信息和统计 -->
        <AntDesign.Col Span="8">
            <AntDesign.Card Size="@CardSize.Small" Style="margin-bottom: 16px;">
                <TitleTemplate>📋 测试用例信息</TitleTemplate>
                <Body>
                    <AntDesign.Descriptions Column="1" Size="@DescriptionsSize.Small">
                        <AntDesign.DescriptionsItem Title="用例名称">@testCase.Name</AntDesign.DescriptionsItem>
                        <AntDesign.DescriptionsItem Title="描述">
                            @(string.IsNullOrEmpty(testCase.Description) ? "无" : testCase.Description)
                        </AntDesign.DescriptionsItem>
                        <AntDesign.DescriptionsItem Title="步骤数量">@testCase.Steps.Count</AntDesign.DescriptionsItem>
                        <AntDesign.DescriptionsItem Title="测试级别">
                            @if (testCase.Levels.Any())
                            {
                                @foreach (var level in testCase.Levels)
                                {
                                    <AntDesign.Tag Color="@GetLevelTagColor(level)">@level</AntDesign.Tag>
                                }
                            }
                            else
                            {
                                <span style="color: #999;">无</span>
                            }
                        </AntDesign.DescriptionsItem>
                    </AntDesign.Descriptions>
                </Body>
            </AntDesign.Card>

            <AntDesign.Card Size="@CardSize.Small">
                <TitleTemplate>📈 执行统计</TitleTemplate>
                <Body>
                    <AntDesign.Row Gutter="8">
                        <AntDesign.Col Span="12">
                            <AntDesign.Statistic Title="总执行次数" Value="@executionRecords.Count"
                                                 ValueStyle="color: #1890ff;" />
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <AntDesign.Statistic Title="成功次数"
                                                 Value="@executionRecords.Count(r => r.Status == ExecutionStatus.Success)"
                                                 ValueStyle="color: #52c41a;" />
                        </AntDesign.Col>
                    </AntDesign.Row>
                    <AntDesign.Row Gutter="8" Style="margin-top: 16px;">
                        <AntDesign.Col Span="12">
                            <AntDesign.Statistic Title="失败次数"
                                                 Value="@executionRecords.Count(r => r.Status == ExecutionStatus.Failed)"
                                                 ValueStyle="color: #ff4d4f;" />
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            @{
                                var successRate = executionRecords.Count > 0
                                    ? (double)executionRecords.Count(r => r.Status == ExecutionStatus.Success) / executionRecords.Count * 100
                                    : 0;
                                var successRateColor = successRate >= 80 ? "#52c41a" : successRate >= 60 ? "#faad14" : "#ff4d4f";
                            }
                            <AntDesign.Statistic Title="成功率"
                                                 Value="@successRate"
                                                 Precision="1"
                                                 Suffix="%"
                                                 ValueStyle="@($"color: {successRateColor};")" />
                        </AntDesign.Col>
                    </AntDesign.Row>

                    @if (executionRecords.Any())
                    {
                        var avgDuration = executionRecords
                            .Where(r => r.Duration > 0)
                            .Select(r => (double)r.Duration)
                            .DefaultIfEmpty(0)
                            .Average();
                        <div style="margin-top: 16px; text-align: center; padding-top: 12px; border-top: 1px solid #f0f0f0;">
                            <div style="font-size: 16px; color: #13c2c2;">@(avgDuration.ToString("F0"))ms</div>
                            <small style="color: #999;">平均执行时间</small>
                        </div>
                    }
                </Body>
            </AntDesign.Card>
        </AntDesign.Col>

        <!-- 右侧：执行记录列表 -->
        <AntDesign.Col Span="16">
            <AntDesign.Card Size="@CardSize.Small">
                <TitleTemplate>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span>🕒 执行记录列表</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 13px; font-weight: normal;">筛选状态:</span>
                            <AntDesign.Select TItemValue="string" TItem="string"
                                              @bind-Value="statusFilter"
                                              OnSelectedItemChanged="@((string _) => ApplyFilter())"
                                              Style="width: 120px;">
                                <SelectOptions>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("")" Label="全部" />
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("Success")" Label="成功" />
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("Failed")" Label="失败" />
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("Running")" Label="执行中" />
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("Cancelled")" Label="已取消" />
                                </SelectOptions>
                            </AntDesign.Select>
                        </div>
                    </div>
                </TitleTemplate>
                <Body>
                    @if (!filteredRecords.Any())
                    {
                        <AntDesign.Empty Description="@("暂无执行记录")" />
                    }
                    else
                    {
                        <div style="max-height: 600px; overflow-y: auto;">
                            @foreach (var record in filteredRecords.Take(20))
                            {
                                var isSelected = selectedRecordId == record.Id;
                                <div style="@($"padding: 12px; border: 1px solid {(isSelected ? "#1890ff" : "#f0f0f0")}; border-radius: 4px; margin-bottom: 8px; cursor: pointer; background: {(isSelected ? "#e6f7ff" : "#fff")};")"
                                     @onclick="() => SelectRecord(record.Id)">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                        <div style="flex: 1;">
                                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                                <AntDesign.Tag Color="@GetExecutionStatusTagColor(record.Status)">@GetExecutionStatusDisplayName(record.Status)</AntDesign.Tag>
                                                <strong>@record.EnvironmentName</strong>
                                                <span style="color: #999; font-size: 12px;">@record.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                            </div>
                                            <div style="color: #666; font-size: 12px;">
                                                步骤: @record.SuccessSteps 成功 / @record.FailedSteps 失败 / @record.SkippedSteps 跳过
                                                @if (record.Duration > 0)
                                                {
                                                    <span style="margin-left: 8px;">耗时: @(record.Duration)ms</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(record.ErrorMessage))
                                            {
                                                <div style="color: #ff4d4f; font-size: 12px; margin-top: 4px;">
                                                    ⚠ @record.ErrorMessage
                                                </div>
                                            }
                                        </div>
                                        <AntDesign.Space>
                                            <SpaceItem>
                                                <AntDesign.Button Size="@ButtonSize.Small"
                                                                  Type="@ButtonType.Primary"
                                                                  OnClick="@(async (MouseEventArgs e) => { await JSRuntime.InvokeVoidAsync("event.stopPropagation"); SelectRecord(record.Id); })">
                                                    👁 查看详情
                                                </AntDesign.Button>
                                            </SpaceItem>
                                            <SpaceItem>
                                                <AntDesign.Button Size="@ButtonSize.Small"
                                                                  Danger="true"
                                                                  OnClick="@(async (MouseEventArgs e) => await DeleteRecord(record.Id))">
                                                    🗑 删除
                                                </AntDesign.Button>
                                            </SpaceItem>
                                        </AntDesign.Space>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (filteredRecords.Count > 20)
                        {
                            <div style="padding: 12px; text-align: center; color: #999;">
                                显示前 20 条记录，共 @filteredRecords.Count 条
                            </div>
                        }
                    }
                </Body>
            </AntDesign.Card>
        </AntDesign.Col>
    </AntDesign.Row>

    <!-- 执行详情模态框 -->
    <AntDesign.Modal Visible="@(selectedRecord != null)"
                     Title="@($"执行详情 - {selectedRecord?.StartTime.ToString("yyyy-MM-dd HH:mm:ss")}")"
                     Width="1000"
                     OnCancel="CloseModal"
                     Footer="null"
                     DestroyOnClose="true">
        @if (selectedRecord != null)
        {
            <div style="margin-bottom: 16px;">
                <AntDesign.Tag Color="@GetExecutionStatusTagColor(selectedRecord.Status)">
                    @GetExecutionStatusDisplayName(selectedRecord.Status)
                </AntDesign.Tag>
            </div>

            <!-- 执行概要 -->
            <AntDesign.Row Gutter="16" Style="margin-bottom: 16px;">
                <AntDesign.Col Span="6">
                    <AntDesign.Statistic Title="总步骤" Value="@selectedRecord.TotalSteps"
                                         ValueStyle="color: #1890ff;" />
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <AntDesign.Statistic Title="成功" Value="@selectedRecord.SuccessSteps"
                                         ValueStyle="color: #52c41a;" />
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <AntDesign.Statistic Title="失败" Value="@selectedRecord.FailedSteps"
                                         ValueStyle="color: #ff4d4f;" />
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <AntDesign.Statistic Title="执行时间" Value="@selectedRecord.Duration" Suffix="ms"
                                         ValueStyle="color: #13c2c2;" />
                </AntDesign.Col>
            </AntDesign.Row>

            <!-- 环境信息 -->
            <AntDesign.Card Size="@CardSize.Small" Title="环境信息" Style="margin-bottom: 16px;">
                <AntDesign.Descriptions Column="2" Size="@DescriptionsSize.Small">
                    <AntDesign.DescriptionsItem Title="环境名称">@selectedRecord.EnvironmentName</AntDesign.DescriptionsItem>
                    <AntDesign.DescriptionsItem Title="环境ID">@selectedRecord.EnvironmentId</AntDesign.DescriptionsItem>
                </AntDesign.Descriptions>
            </AntDesign.Card>

            <!-- 错误信息 -->
            @if (!string.IsNullOrEmpty(selectedRecord.ErrorMessage))
            {
                <AntDesign.Alert Type="@AlertType.Error"
                                 ShowIcon="true"
                                 Message="错误信息"
                                 Description="@selectedRecord.ErrorMessage"
                                 Style="margin-bottom: 16px;" />
            }

            <!-- 步骤执行详情 -->
            @if (selectedRecord.StepRecords.Any())
            {
                <div style="font-weight: 600; margin-bottom: 8px;">步骤执行详情</div>
                <AntDesign.Collapse>
                    @foreach (var stepRecord in selectedRecord.StepRecords.OrderBy(s => s.Order))
                    {
                        <AntDesign.Panel Key="@stepRecord.Id">
                            <HeaderTemplate>
                                <div style="display: flex; align-items: center; gap: 8px; width: 100%;">
                                    <AntDesign.Tag Color="@GetStepStatusTagColor(stepRecord.Status)">@stepRecord.Order</AntDesign.Tag>
                                    <strong>@stepRecord.StepName</strong>
                                    <AntDesign.Tag Color="@TagColor.Default">@stepRecord.StepType</AntDesign.Tag>
                                    <AntDesign.Tag Color="@GetStepStatusTagColor(stepRecord.Status)">@GetStepStatusDisplayName(stepRecord.Status)</AntDesign.Tag>
                                    @if (stepRecord.Duration > 0)
                                    {
                                        <span style="color: #999; font-size: 12px; margin-left: auto;">@(stepRecord.Duration)ms</span>
                                    }
                                </div>
                            </HeaderTemplate>
                            <ChildContent>
                                @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                                {
                                    <AntDesign.Alert Type="@AlertType.Error"
                                                     ShowIcon="true"
                                                     Message="错误"
                                                     Description="@stepRecord.ErrorMessage"
                                                     Style="margin-bottom: 12px;" />
                                }

                                @if (!string.IsNullOrEmpty(stepRecord.RequestData))
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">请求数据</div>
                                        <pre style="background: #fafafa; padding: 8px; border-radius: 4px; border: 1px solid #f0f0f0; white-space: pre-wrap; word-break: break-all;"><code>@stepRecord.RequestData</code></pre>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(stepRecord.ResponseData))
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">响应数据</div>
                                        <pre style="background: #fafafa; padding: 8px; border-radius: 4px; border: 1px solid #f0f0f0; white-space: pre-wrap; word-break: break-all;"><code>@stepRecord.ResponseData</code></pre>
                                    </div>
                                }

                                @if (stepRecord.AssertionResults.Any())
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">断言结果</div>
                                        @foreach (var assertion in stepRecord.AssertionResults)
                                        {
                                            <div style="display: flex; align-items: center; margin-bottom: 4px; gap: 8px;">
                                                <AntDesign.Tag Color="@(assertion.Passed ? TagColor.Green : TagColor.Red)">
                                                    @(assertion.Passed ? "✓" : "✗")
                                                </AntDesign.Tag>
                                                <span>@assertion.Expression</span>
                                                <span>@assertion.Operator</span>
                                                <span>@assertion.Expected</span>
                                                @if (!assertion.Passed)
                                                {
                                                    <span style="color: #ff4d4f;">(实际: @assertion.Actual)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (stepRecord.ExtractedVariables.Any())
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">提取的变量</div>
                                        @foreach (var variable in stepRecord.ExtractedVariables)
                                        {
                                            <div style="margin-bottom: 2px;">
                                                <strong>@variable.Key:</strong> @variable.Value
                                            </div>
                                        }
                                    </div>
                                }

                                @if (stepRecord.Logs.Any())
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">执行日志</div>
                                        <div style="background: #1e1e1e; color: #d4d4d4; padding: 8px; border-radius: 4px; max-height: 200px; overflow-y: auto; font-family: monospace; font-size: 12px;">
                                            @foreach (var log in stepRecord.Logs)
                                            {
                                                <div>@log</div>
                                            }
                                        </div>
                                    </div>
                                }

                                @{
                                    var screenshotPaths = GetScreenshotPaths(testCase.ProjectId, testCase.Id, stepRecord.StepId);
                                }
                                @if (screenshotPaths.Any())
                                {
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-weight: 600; margin-bottom: 4px;">截图</div>
                                        <AntDesign.Row Gutter="8">
                                            @foreach (var screenshotPath in screenshotPaths)
                                            {
                                                <AntDesign.Col Span="12" Style="margin-bottom: 8px;">
                                                    <AntDesign.Card Size="@CardSize.Small">
                                                        <img src="@GetRelativeScreenshotPath(screenshotPath)" alt="截图"
                                                             style="width: 100%; max-height: 200px; object-fit: contain;" />
                                                        <div style="padding: 4px; font-size: 12px; color: #999;">
                                                            @Path.GetFileName(screenshotPath)
                                                        </div>
                                                    </AntDesign.Card>
                                                </AntDesign.Col>
                                            }
                                        </AntDesign.Row>
                                    </div>
                                }
                            </ChildContent>
                        </AntDesign.Panel>
                    }
                </AntDesign.Collapse>
            }

            <div style="text-align: right; margin-top: 16px; padding-top: 12px; border-top: 1px solid #f0f0f0;">
                <AntDesign.Button OnClick="CloseModal">关闭</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>
}

@code {
    [Parameter] public string TestCaseId { get; set; } = string.Empty;

    private ProjectCaseDto? testCase;
    private List<ExecutionRecordDto> executionRecords = new();
    private List<ExecutionRecordDto> filteredRecords = new();
    private bool loading = true;
    private string statusFilter = string.Empty;
    private string selectedRecordId = string.Empty;
    private ExecutionRecordDto? selectedRecord;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;

            testCase = await ProjectCaseService.GetByIdAsync(TestCaseId);

            if (testCase != null)
            {
                executionRecords = await ExecutionRecordService.GetByTestCaseIdAsync(testCase.ProjectId, TestCaseId);
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"加载数据失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(statusFilter))
        {
            filteredRecords = executionRecords.OrderByDescending(r => r.StartTime).ToList();
        }
        else
        {
            if (Enum.TryParse<ExecutionStatus>(statusFilter, out var status))
            {
                filteredRecords = executionRecords
                    .Where(r => r.Status == status)
                    .OrderByDescending(r => r.StartTime)
                    .ToList();
            }
        }
        StateHasChanged();
    }

    private void SelectRecord(string recordId)
    {
        selectedRecordId = recordId;
        selectedRecord = executionRecords.FirstOrDefault(r => r.Id == recordId);
        StateHasChanged();
    }

    private async Task DeleteRecord(string recordId)
    {
        if (testCase == null) return;

        try
        {
            var success = await ExecutionRecordService.DeleteAsync(testCase.ProjectId, recordId);
            if (success)
            {
                if (selectedRecordId == recordId)
                {
                    selectedRecordId = string.Empty;
                    selectedRecord = null;
                }

                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "删除失败");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"删除出错: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        selectedRecordId = string.Empty;
        selectedRecord = null;
        StateHasChanged();
    }

    private void GoBack()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnProjectId = queryParameters["returnProjectId"];

        if (!string.IsNullOrEmpty(returnProjectId))
        {
            Navigation.NavigateTo($"/autotest/project-cases/{returnProjectId}");
        }
        else
        {
            Navigation.NavigateTo("/autotest/project-cases");
        }
    }

    private List<string> GetScreenshotPaths(string projectId, string testCaseId, string stepId)
    {
        var screenshotPaths = new List<string>();

        var screenshotDir = Path.Combine("data", projectId, "screenshots", testCaseId);

        if (Directory.Exists(screenshotDir))
        {
            var screenshotFiles = Directory.GetFiles(screenshotDir, $"*{stepId}*.png");
            screenshotPaths.AddRange(screenshotFiles);
        }

        return screenshotPaths;
    }

    private string GetRelativeScreenshotPath(string fullPath)
    {
        var relativePath = fullPath.Replace("\\", "/").Replace(Directory.GetCurrentDirectory(), "");
        if (relativePath.StartsWith("/"))
        {
            relativePath = relativePath.Substring(1);
        }
        return $"/{relativePath}";
    }

    private string GetLevelTagColor(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        "P3" => "default",
        _ => "default"
    };

    private string GetExecutionStatusTagColor(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "green",
        ExecutionStatus.Failed => "red",
        ExecutionStatus.Running => "blue",
        ExecutionStatus.Cancelled => "orange",
        _ => "default"
    };

    private string GetExecutionStatusDisplayName(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "执行中",
        ExecutionStatus.Cancelled => "已取消",
        _ => "未知"
    };

    private string GetStepStatusTagColor(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "green",
        StepExecutionStatus.Failed => "red",
        StepExecutionStatus.Running => "blue",
        StepExecutionStatus.Skipped => "orange",
        _ => "default"
    };

    private string GetStepStatusDisplayName(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "成功",
        StepExecutionStatus.Failed => "失败",
        StepExecutionStatus.Running => "执行中",
        StepExecutionStatus.Skipped => "跳过",
        _ => "未知"
    };
}
