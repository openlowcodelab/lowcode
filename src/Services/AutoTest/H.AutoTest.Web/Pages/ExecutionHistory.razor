@page "/autotest/execution-history/{testCaseId}"

@namespace H.AutoTest.Web
@layout AutoTestLayout

@inject IProjectCaseAppService ProjectCaseService
@inject IExecutionRecordAppService ExecutionRecordService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>执行历史记录</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1">📊 执行历史记录</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/autotest/project-cases">测试用例</a></li>
                            <li class="breadcrumb-item active">执行历史</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <button class="btn btn-outline-secondary me-2" @onclick="RefreshData">
                        <i class="oi oi-reload"></i> 刷新
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="GoBack">
                        <i class="oi oi-arrow-left"></i> 返回
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
            <p class="mt-2">正在加载执行历史...</p>
        </div>
    }
    else if (testCase == null)
    {
        <div class="alert alert-danger">
            <i class="oi oi-warning"></i> 未找到指定的测试用例
        </div>
    }
    else
    {
        <div class="row">
            <!-- 左侧：测试用例信息和统计 -->
            <div class="col-md-4">
                <!-- 测试用例信息 -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0">📋 测试用例信息</h6>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">用例名称:</dt>
                            <dd class="col-sm-8">@testCase.Name</dd>
                            
                            <dt class="col-sm-4">描述:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(testCase.Description) ? "无" : testCase.Description)</dd>
                            
                            <dt class="col-sm-4">步骤数量:</dt>
                            <dd class="col-sm-8">@testCase.Steps.Count</dd>
                            
                            <dt class="col-sm-4">测试级别:</dt>
                            <dd class="col-sm-8">
                                @if (testCase.Levels.Any())
                                {
                                    @foreach (var level in testCase.Levels)
                                    {
                                        <span class="badge @GetLevelBadgeClass(level) me-1">@level</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">无</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
                
                <!-- 执行统计 -->
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">📈 执行统计</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="h4 text-primary mb-0">@executionRecords.Count</div>
                                <small class="text-muted">总执行次数</small>
                            </div>
                            <div class="col-6">
                                <div class="h4 text-success mb-0">@executionRecords.Count(r => r.Status == ExecutionStatus.Success)</div>
                                <small class="text-muted">成功次数</small>
                            </div>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-6">
                                <div class="h4 text-danger mb-0">@executionRecords.Count(r => r.Status == ExecutionStatus.Failed)</div>
                                <small class="text-muted">失败次数</small>
                            </div>
                            <div class="col-6">
                                @{
                                    var successRate = executionRecords.Count > 0 
                                        ? (double)executionRecords.Count(r => r.Status == ExecutionStatus.Success) / executionRecords.Count * 100 
                                        : 0;
                                }
                                <div class="h4 @(successRate >= 80 ? "text-success" : successRate >= 60 ? "text-warning" : "text-danger") mb-0">@(successRate.ToString("F1"))%</div>
                                <small class="text-muted">成功率</small>
                            </div>
                        </div>
                        
                        @if (executionRecords.Any())
                        {
                            var avgDuration = executionRecords
                                .Where(r => r.Duration > 0)
                                .Select(r => (double)r.Duration)
                                .DefaultIfEmpty(0)
                                .Average();
                            <div class="mt-3 text-center">
                                <div class="h6 text-info mb-0">@(avgDuration.ToString("F0"))ms</div>
                                <small class="text-muted">平均执行时间</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- 右侧：执行记录列表 -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">🕒 执行记录列表</h6>
                            <div class="d-flex align-items-center">
                                <label class="form-label me-2 mb-0">筛选状态:</label>
                                <select class="form-select form-select-sm" style="width: auto;" @bind="statusFilter" @bind:after="ApplyFilter">
                                    <option value="">全部</option>
                                    <option value="Success">成功</option>
                                    <option value="Failed">失败</option>
                                    <option value="Running">执行中</option>
                                    <option value="Cancelled">已取消</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (!filteredRecords.Any())
                        {
                            <div class="text-center p-4">
                                <i class="oi oi-info"></i> 暂无执行记录
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var record in filteredRecords.Take(20)) // 限制显示数量
                                {
                                    <div class="list-group-item @(selectedRecordId == record.Id ? "active" : "")" 
                                         style="cursor: pointer;" 
                                         @onclick="() => SelectRecord(record.Id)">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center mb-1">
                                                    <span class="badge @GetExecutionStatusBadgeClass(record.Status) me-2">@GetExecutionStatusDisplayName(record.Status)</span>
                                                    <strong>@record.EnvironmentName</strong>
                                                    <span class="text-muted ms-2">@record.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                                </div>
                                                <div class="small text-muted">
                                                    步骤: @record.SuccessSteps 成功 / @record.FailedSteps 失败 / @record.SkippedSteps 跳过
                                                    @if (record.Duration > 0)
                                                    {
                                                        <span class="ms-2">耗时: @(record.Duration)ms</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(record.ErrorMessage))
                                                {
                                                    <div class="small text-danger mt-1">
                                                        <i class="oi oi-warning"></i> @record.ErrorMessage
                                                    </div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => SelectRecord(record.Id)" @onclick:stopPropagation="true">
                                                    <i class="oi oi-eye"></i> 查看详情
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm ms-2" @onclick="() => DeleteRecord(record.Id)" @onclick:stopPropagation="true">
                                                    <i class="oi oi-trash"></i> 删除
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            @if (filteredRecords.Count > 20)
                            {
                                <div class="p-3 text-center text-muted">
                                    显示前20条记录，共 @filteredRecords.Count 条
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 执行详情模态框 -->
        @if (selectedRecord != null)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                执行详情 - @selectedRecord.StartTime.ToString("yyyy-MM-dd HH:mm:ss")
                                <span class="badge @GetExecutionStatusBadgeClass(selectedRecord.Status) ms-2">@GetExecutionStatusDisplayName(selectedRecord.Status)</span>
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseModal"></button>
                        </div>
                        <div class="modal-body">
                            <!-- 执行概要 -->
                            <div class="row mb-4">
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <div class="h5 text-primary mb-0">@selectedRecord.TotalSteps</div>
                                        <small class="text-muted">总步骤</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <div class="h5 text-success mb-0">@selectedRecord.SuccessSteps</div>
                                        <small class="text-muted">成功</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <div class="h5 text-danger mb-0">@selectedRecord.FailedSteps</div>
                                        <small class="text-muted">失败</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <div class="h5 text-info mb-0">@(selectedRecord.Duration)ms</div>
                                        <small class="text-muted">执行时间</small>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- 环境信息 -->
                            <div class="mb-4">
                                <h6>环境信息</h6>
                                <div class="bg-light p-3 rounded">
                                    <strong>环境名称:</strong> @selectedRecord.EnvironmentName<br>
                                    <strong>环境ID:</strong> @selectedRecord.EnvironmentId
                                </div>
                            </div>
                            
                            <!-- 错误信息 -->
                            @if (!string.IsNullOrEmpty(selectedRecord.ErrorMessage))
                            {
                                <div class="mb-4">
                                    <h6>错误信息</h6>
                                    <div class="alert alert-danger">
                                        @selectedRecord.ErrorMessage
                                    </div>
                                </div>
                            }
                            
                            <!-- 步骤执行详情 -->
                            @if (selectedRecord.StepRecords.Any())
                            {
                                <div class="mb-4">
                                    <h6>步骤执行详情</h6>
                                    <div class="accordion" id="stepAccordion">
                                        @foreach (var stepRecord in selectedRecord.StepRecords.OrderBy(s => s.Order))
                                        {
                                            var accordionId = $"step-{stepRecord.Id}";
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="@($"heading-{stepRecord.Id}")">
                                                    <button class="accordion-button collapsed" type="button" 
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="@($"#{accordionId}")"
                                                            aria-expanded="false" 
                                                            aria-controls="@accordionId">
                                                        <div class="d-flex align-items-center w-100">
                                                            <span class="badge @GetStepStatusBadgeClass(stepRecord.Status) me-2">@stepRecord.Order</span>
                                                            <strong class="me-2">@stepRecord.StepName</strong>
                                                            <span class="badge bg-secondary me-2">@stepRecord.StepType</span>
                                                            <span class="badge @GetStepStatusBadgeClass(stepRecord.Status) me-auto">@GetStepStatusDisplayName(stepRecord.Status)</span>
                                                            @if (stepRecord.Duration > 0)
                                                            {
                                                                <small class="text-muted">@(stepRecord.Duration)ms</small>
                                                            }
                                                        </div>
                                                    </button>
                                                </h2>
                                                <div id="@accordionId" class="accordion-collapse collapse" 
                                                     aria-labelledby="@($"heading-{stepRecord.Id}")" 
                                                     data-bs-parent="#stepAccordion">
                                                    <div class="accordion-body">
                                                        <!-- 错误信息 -->
                                                        @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                                                        {
                                                            <div class="alert alert-danger">
                                                                <strong>错误:</strong> @stepRecord.ErrorMessage
                                                            </div>
                                                        }
                                                        
                                                        <!-- 请求数据 -->
                                                        @if (!string.IsNullOrEmpty(stepRecord.RequestData))
                                                        {
                                                            <div class="mb-3">
                                                                <h6>请求数据</h6>
                                                                <pre class="bg-light p-2 rounded"><code>@stepRecord.RequestData</code></pre>
                                                            </div>
                                                        }
                                                        
                                                        <!-- 响应数据 -->
                                                        @if (!string.IsNullOrEmpty(stepRecord.ResponseData))
                                                        {
                                                            <div class="mb-3">
                                                                <h6>响应数据</h6>
                                                                <pre class="bg-light p-2 rounded"><code>@stepRecord.ResponseData</code></pre>
                                                            </div>
                                                        }
                                                        
                                                        <!-- 断言结果 -->
                                                        @if (stepRecord.AssertionResults.Any())
                                                        {
                                                            <div class="mb-3">
                                                                <h6>断言结果</h6>
                                                                @foreach (var assertion in stepRecord.AssertionResults)
                                                                {
                                                                    <div class="d-flex align-items-center mb-2">
                                                                        <span class="badge @(assertion.Passed ? "bg-success" : "bg-danger") me-2">
                                                                            @(assertion.Passed ? "✓" : "✗")
                                                                        </span>
                                                                        <span class="me-2">@assertion.Expression</span>
                                                                        <span class="me-2">@assertion.Operator</span>
                                                                        <span class="me-2">@assertion.Expected</span>
                                                                        @if (!assertion.Passed)
                                                                        {
                                                                            <span class="text-danger">(实际: @assertion.Actual)</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        
                                                        <!-- 提取的变量 -->
                                                        @if (stepRecord.ExtractedVariables.Any())
                                                        {
                                                            <div class="mb-3">
                                                                <h6>提取的变量</h6>
                                                                @foreach (var variable in stepRecord.ExtractedVariables)
                                                                {
                                                                    <div class="mb-1">
                                                                        <strong>@variable.Key:</strong> @variable.Value
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        
                                                        <!-- 执行日志 -->
                                                        @if (stepRecord.Logs.Any())
                                                        {
                                                            <div class="mb-3">
                                                                <h6>执行日志</h6>
                                                                <div class="bg-dark text-light p-2 rounded" style="max-height: 200px; overflow-y: auto;">
                                                                    @foreach (var log in stepRecord.Logs)
                                                                    {
                                                                        <div class="small">@log</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        
                                                        <!-- 截图展示 -->
                                                        @{
                                                            var screenshotPaths = GetScreenshotPaths(testCase.ProjectId, testCase.Id, stepRecord.StepId);
                                                        }
                                                        @if (screenshotPaths.Any())
                                                        {
                                                            <div class="mb-3">
                                                                <h6>截图</h6>
                                                                <div class="row">
                                                                    @foreach (var screenshotPath in screenshotPaths)
                                                                    {
                                                                        <div class="col-md-6 mb-2">
                                                                            <div class="card">
                                                                                <img src="@GetRelativeScreenshotPath(screenshotPath)" class="card-img-top" alt="截图" style="max-height: 200px; object-fit: contain;">
                                                                                <div class="card-body p-2">
                                                                                    <small class="text-muted">@Path.GetFileName(screenshotPath)</small>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">关闭</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string TestCaseId { get; set; } = string.Empty;
    
    private ProjectCaseDto? testCase;
    private List<ExecutionRecordDto> executionRecords = new();
    private List<ExecutionRecordDto> filteredRecords = new();
    private bool loading = true;
    private string statusFilter = string.Empty;
    private string selectedRecordId = string.Empty;
    private ExecutionRecordDto? selectedRecord;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    
    private async Task LoadData()
    {
        try
        {
            loading = true;
            
            // 加载测试用例
            testCase = await ProjectCaseService.GetByIdAsync(TestCaseId);
            
            if (testCase != null)
            {
                // 加载执行记录
                executionRecords = await ExecutionRecordService.GetByTestCaseIdAsync(testCase.ProjectId, TestCaseId);
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"加载数据失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
    
    private async Task RefreshData()
    {
        await LoadData();
    }
    
    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(statusFilter))
        {
            filteredRecords = executionRecords.OrderByDescending(r => r.StartTime).ToList();
        }
        else
        {
            if (Enum.TryParse<ExecutionStatus>(statusFilter, out var status))
            {
                filteredRecords = executionRecords
                    .Where(r => r.Status == status)
                    .OrderByDescending(r => r.StartTime)
                    .ToList();
            }
        }
        StateHasChanged();
    }
    
    private void SelectRecord(string recordId)
    {
        selectedRecordId = recordId;
        selectedRecord = executionRecords.FirstOrDefault(r => r.Id == recordId);
        StateHasChanged();
    }
    
    private async Task DeleteRecord(string recordId)
    {
        if (testCase == null) return;
        
        try
        {
            var success = await ExecutionRecordService.DeleteAsync(testCase.ProjectId, recordId);
            if (success)
            {
                // 如果删除的是当前选中的记录，清空选中状态
                if (selectedRecordId == recordId)
                {
                    selectedRecordId = string.Empty;
                    selectedRecord = null;
                }
                
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "删除失败");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"删除出错: {ex.Message}");
        }
    }
    
    private void CloseModal()
    {
        selectedRecordId = string.Empty;
        selectedRecord = null;
        StateHasChanged();
    }
    
    private void GoBack()
    {
        // 从查询字符串中获取返回的项目ID
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnProjectId = queryParameters["returnProjectId"];
        
        if (!string.IsNullOrEmpty(returnProjectId))
        {
            Navigation.NavigateTo($"/autotest/project-cases/{returnProjectId}");
        }
        else
        {
            Navigation.NavigateTo("/autotest/project-cases");
        }
    }
    
    // 获取截图路径
    private List<string> GetScreenshotPaths(string projectId, string testCaseId, string stepId)
    {
        var screenshotPaths = new List<string>();
        
        // 截图目录路径
        var screenshotDir = Path.Combine("data", projectId, "screenshots", testCaseId);
        
        // 检查目录是否存在
        if (Directory.Exists(screenshotDir))
        {
            // 查找与步骤ID相关的截图文件
            var screenshotFiles = Directory.GetFiles(screenshotDir, $"*{stepId}*.png");
            screenshotPaths.AddRange(screenshotFiles);
        }
        
        return screenshotPaths;
    }
    
    // 获取相对路径用于前端展示
    private string GetRelativeScreenshotPath(string fullPath)
    {
        // 将文件路径转换为相对路径，以便在浏览器中展示
        var relativePath = fullPath.Replace("\\", "/").Replace(Directory.GetCurrentDirectory(), "");
        if (relativePath.StartsWith("/"))
        {
            relativePath = relativePath.Substring(1);
        }
        return $"/{relativePath}";
    }
    
    private string GetLevelBadgeClass(string level) => level switch
    {
        "P0" => "bg-danger",
        "P1" => "bg-warning",
        "P2" => "bg-primary",
        "P3" => "bg-secondary",
        _ => "bg-light"
    };
    
    private string GetExecutionStatusBadgeClass(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "bg-success",
        ExecutionStatus.Failed => "bg-danger",
        ExecutionStatus.Running => "bg-primary",
        ExecutionStatus.Cancelled => "bg-warning",
        _ => "bg-secondary"
    };
    
    private string GetExecutionStatusDisplayName(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "执行中",
        ExecutionStatus.Cancelled => "已取消",
        _ => "未知"
    };
    
    private string GetStepStatusBadgeClass(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "bg-success",
        StepExecutionStatus.Failed => "bg-danger",
        StepExecutionStatus.Running => "bg-primary",
        StepExecutionStatus.Skipped => "bg-warning",
        _ => "bg-secondary"
    };
    
    private string GetStepStatusDisplayName(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "成功",
        StepExecutionStatus.Failed => "失败",
        StepExecutionStatus.Running => "执行中",
        StepExecutionStatus.Skipped => "跳过",
        _ => "未知"
    };
}