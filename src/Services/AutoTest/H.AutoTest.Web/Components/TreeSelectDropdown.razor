@namespace H.AutoTest.Web

<AntDesign.Select TItemValue="string"
                  TItem="FlatCategoryItem"
                  DataSource="GetFlatItems()"
                  LabelName="@nameof(FlatCategoryItem.DisplayName)"
                  ValueName="@nameof(FlatCategoryItem.Id)"
                  Value="@(Value ?? SelectedValue ?? string.Empty)"
                  ValueChanged="OnValueChanged"
                  Placeholder="@Placeholder"
                  AllowClear="true"
                  Style="width: 100%;" />

@code {
    [Parameter] public List<ProjectCaseCategory> Categories { get; set; } = new();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    // 兼容旧的 SelectedValue 属性
    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string?> SelectedValueChanged { get; set; }

    [Parameter] public bool ShowEmptyOption { get; set; } = true;
    [Parameter] public string EmptyOptionText { get; set; } = "无分类";
    [Parameter] public string Placeholder { get; set; } = "请选择分类";

    public class FlatCategoryItem
    {
        public string Id { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
    }

    private List<FlatCategoryItem> GetFlatItems()
    {
        var items = new List<FlatCategoryItem>();
        if (ShowEmptyOption)
        {
            items.Add(new FlatCategoryItem { Id = string.Empty, DisplayName = EmptyOptionText });
        }
        foreach (var root in Categories.OrderBy(c => c.Order))
        {
            AppendCategory(items, root, 0);
        }
        return items;
    }

    private void AppendCategory(List<FlatCategoryItem> items, ProjectCaseCategory category, int level)
    {
        var prefix = level == 0 ? string.Empty : new string('\u3000', level) + "└ ";
        items.Add(new FlatCategoryItem
        {
            Id = category.Id,
            DisplayName = prefix + category.Name
        });
        if (category.Childrens is { Length: > 0 })
        {
            foreach (var child in category.Childrens.OrderBy(c => c.Order))
            {
                AppendCategory(items, child, level + 1);
            }
        }
    }

    private async Task OnValueChanged(string newValue)
    {
        var normalized = string.IsNullOrEmpty(newValue) ? null : newValue;
        Value = normalized;
        SelectedValue = normalized;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(normalized);
        }
        if (SelectedValueChanged.HasDelegate)
        {
            await SelectedValueChanged.InvokeAsync(normalized);
        }
    }
}
