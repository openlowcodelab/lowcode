@namespace H.AutoTest.Web

<AntDesign.Modal Visible="ShowModal"
                 Title="@(IsEditing ? "编辑测试用例" : "新建测试用例")"
                 Width="720"
                 OnCancel="HideModal"
                 Footer="null"
                 DestroyOnClose="true">
    <EditForm Model="CurrentTestCase" OnValidSubmit="SaveTestCase">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: #ff4d4f;" />

        <AntDesign.FormItem Label="用例编号" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="CurrentTestCase.CaseNumber" Placeholder="如：TC001, TEST_01等" />
            <div style="color: #999; font-size: 12px; margin-top: 4px;">可选字段，3-12 位字母、数字、下划线组合</div>
            <ValidationMessage For="() => CurrentTestCase.CaseNumber" />
        </AntDesign.FormItem>

        <AntDesign.FormItem Label="用例名称" Required="true" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.Input @bind-Value="CurrentTestCase.Name" />
            <ValidationMessage For="() => CurrentTestCase.Name" />
        </AntDesign.FormItem>

        <AntDesign.FormItem Label="用例描述" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.TextArea Rows="3"
                                @bind-Value="CurrentTestCase.Description" />
        </AntDesign.FormItem>

        <AntDesign.FormItem Label="用例级别" LabelColSpan="5" WrapperColSpan="19">
            <div style="display: flex; flex-wrap: wrap; gap: 12px; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;">
                @foreach (var level in AvailableLevels)
                {
                    var checkedValue = CurrentTestCase.Levels.Contains(level);
                    <AntDesign.Checkbox Checked="@checkedValue"
                                        CheckedChange="@((bool isChecked) => ToggleLevel(level, isChecked))">
                        <AntDesign.Tag Color="@GetLevelTagColor(level)">@level</AntDesign.Tag>
                    </AntDesign.Checkbox>
                }
            </div>
            <div style="color: #999; font-size: 12px; margin-top: 4px;">可多选，P0 为最高级别</div>
        </AntDesign.FormItem>

        <AntDesign.FormItem Label="分类" LabelColSpan="5" WrapperColSpan="19">
            <TreeSelectDropdown Categories="Categories"
                                Value="CurrentTestCase.CategoryId"
                                ValueChanged="OnCategoryChanged"
                                EmptyOptionText="无分类"
                                Placeholder="请选择分类" />
        </AntDesign.FormItem>

        <AntDesign.FormItem Label="排序" LabelColSpan="5" WrapperColSpan="19">
            <AntDesign.InputNumber TValue="int" @bind-Value="CurrentTestCase.Order" Style="width: 200px;" />
            <div style="color: #999; font-size: 12px; margin-top: 4px;">数值越小排序越靠前，默认为 0</div>
        </AntDesign.FormItem>

        <div style="text-align: right; margin-top: 16px; padding-top: 12px; border-top: 1px solid #f0f0f0;">
            <AntDesign.Space>
                <SpaceItem>
                    <AntDesign.Button OnClick="HideModal">取消</AntDesign.Button>
                </SpaceItem>
                @if (!IsEditing)
                {
                    <SpaceItem>
                        <AntDesign.Button Type="@ButtonType.Default"
                                          Style="background-color: #52c41a; border-color: #52c41a; color: white;"
                                          OnClick="SaveOnly">
                            仅保存
                        </AntDesign.Button>
                    </SpaceItem>
                }
                <SpaceItem>
                    <AntDesign.Button Type="@ButtonType.Primary" HtmlType="submit">
                        @(IsEditing ? "更新" : "保存并继续编辑步骤")
                    </AntDesign.Button>
                </SpaceItem>
            </AntDesign.Space>
        </div>
    </EditForm>
</AntDesign.Modal>

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public ProjectCaseDto CurrentTestCase { get; set; } = new();
    [Parameter] public List<ProjectCaseCategory> Categories { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ProjectCaseDto> OnSave { get; set; }
    [Parameter] public EventCallback<ProjectCaseDto> OnSaveOnly { get; set; }

    private readonly List<string> AvailableLevels = new() { "P0", "P1", "P2", "P3" };

    private void ToggleLevel(string level, bool isChecked)
    {
        if (isChecked)
        {
            if (!CurrentTestCase.Levels.Contains(level))
            {
                CurrentTestCase.Levels.Add(level);
            }
        }
        else
        {
            CurrentTestCase.Levels.Remove(level);
        }
        CurrentTestCase.Levels = CurrentTestCase.Levels.OrderBy(l => l).ToList();
    }

    private async Task OnCategoryChanged(string? categoryId)
    {
        CurrentTestCase.CategoryId = categoryId;
        await Task.CompletedTask;
    }

    private async Task SaveTestCase()
    {
        await OnSave.InvokeAsync(CurrentTestCase);
    }

    private async Task SaveOnly()
    {
        await OnSaveOnly.InvokeAsync(CurrentTestCase);
    }

    private async Task HideModal()
    {
        await OnClose.InvokeAsync();
    }

    private string GetLevelTagColor(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        "P3" => "default",
        _ => "default"
    };
}
