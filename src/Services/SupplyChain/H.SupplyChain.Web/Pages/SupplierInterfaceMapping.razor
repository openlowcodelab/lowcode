@page "/supply-chain/supplier-interface-mapping"
@layout SupplyChainLayout
@inject ISupplierInterfaceMappingAppService MappingService
@inject ISupplyChainSupplierAppService SupplierService
@inject IApiInterfaceAppService InterfaceService
@inject IJSRuntime JS

<HCard Title="供应商接口映射管理">
    <div class="h-toolbar">
        <select @bind="@supplierIdFilter" class="h-input" style="width:auto">
            <option value="">全部供应商</option>
            @foreach (var s in suppliers)
            {
                <option value="@s.Id">@s.Code - @s.Name</option>
            }
        </select>
        <select @bind="@interfaceIdFilter" class="h-input" style="width:auto">
            <option value="">全部接口</option>
            @foreach (var i in interfaces)
            {
                <option value="@i.Id">@i.Code - @i.Name</option>
            }
        </select>
        <button class="h-btn h-btn-primary" @onclick="@LoadData">查询</button>
        <button class="h-btn h-btn-primary" @onclick="@ShowCreate">新增映射</button>
        <button class="h-btn" @onclick="@LoadData">刷新</button>
    </div>
    <HTable Loading="@loading" ShowEmpty="@(!loading && !mappings.Any())">
        <thead>
            <tr>
                <th>供应商</th>
                <th>接口</th>
                <th>供应商接口地址</th>
                <th>请求参数映射</th>
                <th>返回值字段映射</th>
                <th>启用</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in mappings)
            {
                <tr>
                    <td>@m.SupplierCode</td>
                    <td>@m.InterfaceCode</td>
                    <td>@(m.SupplierApiUrl ?? "-")</td>
                    <td style="max-width:240px;"><pre style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(m.RequestMappingJson) ? "[]" : m.RequestMappingJson)</pre></td>
                    <td style="max-width:240px;"><pre style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(m.ResponseMappingJson) ? "[]" : m.ResponseMappingJson)</pre></td>
                    <td>
                        @if (m.IsEnabled) { <span class="h-tag h-tag-green">启用</span> }
                        else { <span class="h-tag h-tag-red">禁用</span> }
                    </td>
                    <td>
                        <span class="h-space">
                            <button class="h-btn h-btn-primary h-btn-sm" @onclick="@(() => Edit(m))">编辑</button>
                            <button class="h-btn h-btn-danger h-btn-sm" @onclick="@(() => Delete(m.Id))">删除</button>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </HTable>
</HCard>

<HModal Title="@(isEdit ? "编辑供应商接口映射" : "新增供应商接口映射")" Visible="@showModal" OnOk="@Save" OnCancel="@CloseModal" ConfirmLoading="@saving" Style="width:820px;">
    @if (!isEdit)
    {
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">供应商</label>
            <div class="h-form-control">
                <select @bind="@current.SupplierId" class="h-input" style="width:auto">
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Code - @s.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">接口定义</label>
            <div class="h-form-control">
                <select @bind="@current.InterfaceId" class="h-input" style="width:auto">
                    @foreach (var i in interfaces)
                    {
                        <option value="@i.Id">@i.Code - @i.Name</option>
                    }
                </select>
            </div>
        </div>
    }
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">供应商接口地址</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@current.SupplierApiUrl" class="h-input" placeholder="为空则使用供应商默认 ApiUrl" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">请求参数映射 (JSON)</label>
        <div class="h-form-control">
            <textarea @bind="@current.RequestMappingJson" rows="6" class="h-textarea" placeholder='[{"sourceField":"skuCode","targetField":"productCode","isRequired":true},{"sourceField":"quantity","targetField":"qty"}]'></textarea>
            <div style="color:#888;font-size:12px;">sourceField=标准字段，targetField=供应商侧字段，defaultValue=源缺失时取值</div>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">返回值字段映射 (JSON)</label>
        <div class="h-form-control">
            <textarea @bind="@current.ResponseMappingJson" rows="6" class="h-textarea" placeholder='[{"sourceField":"data.orderNo","targetField":"supplierOrderNo"}]'></textarea>
            <div style="color:#888;font-size:12px;">sourceField=供应商应答 JSON 路径，targetField=标准字段</div>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">启用</label>
        <div class="h-form-control">
            <label class="h-switch">
                <input type="checkbox" @bind="@current.IsEnabled" />
                <span class="h-switch-slider"></span>
            </label>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea @bind="@current.Remark" rows="2" class="h-textarea"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<SupplierInterfaceMappingDto> mappings = new();
    private List<SupplierDto> suppliers = new();
    private List<ApiInterfaceDto> interfaces = new();
    private bool loading;
    private Guid? supplierIdFilter;
    private Guid? interfaceIdFilter;

    private bool showModal;
    private bool saving;
    private bool isEdit;
    private Guid? editId;
    private CreateSupplierInterfaceMappingDto current = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOptions();
        await LoadData();
    }

    private async Task LoadOptions()
    {
        try
        {
            var sr = await SupplierService.GetListAsync(new SupplierQueryDto { MaxResultCount = 200 });
            suppliers = sr.Items.ToList();
            var ir = await InterfaceService.GetListAsync(new ApiInterfaceQueryDto { MaxResultCount = 200 });
            interfaces = ir.Items.ToList();
        }
        catch { }
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var input = new SupplierInterfaceMappingQueryDto { MaxResultCount = 100 };
            input.SupplierId = supplierIdFilter;
            input.InterfaceId = interfaceIdFilter;
            var result = await MappingService.GetListAsync(input);
            mappings = result.Items.ToList();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"加载失败：{ex.Message}"); }
        finally { loading = false; }
    }

    private void ShowCreate()
    {
        current = new CreateSupplierInterfaceMappingDto { IsEnabled = true, RequestMappingJson = "[]", ResponseMappingJson = "[]" };
        if (suppliers.Any()) current.SupplierId = suppliers[0].Id;
        if (interfaces.Any()) current.InterfaceId = interfaces[0].Id;
        isEdit = false;
        editId = null;
        showModal = true;
    }

    private void Edit(SupplierInterfaceMappingDto m)
    {
        current = new CreateSupplierInterfaceMappingDto
        {
            SupplierId = m.SupplierId,
            InterfaceId = m.InterfaceId,
            SupplierApiUrl = m.SupplierApiUrl,
            RequestMappingJson = m.RequestMappingJson,
            ResponseMappingJson = m.ResponseMappingJson,
            IsEnabled = m.IsEnabled,
            Remark = m.Remark
        };
        isEdit = true;
        editId = m.Id;
        showModal = true;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            if (current.SupplierId == Guid.Empty || current.InterfaceId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "供应商和接口不能为空");
                return;
            }

            if (isEdit && editId.HasValue)
            {
                await MappingService.UpdateAsync(editId.Value, new UpdateSupplierInterfaceMappingDto
                {
                    SupplierApiUrl = current.SupplierApiUrl,
                    RequestMappingJson = current.RequestMappingJson,
                    ResponseMappingJson = current.ResponseMappingJson,
                    IsEnabled = current.IsEnabled,
                    Remark = current.Remark
                });
                await JS.InvokeVoidAsync("alert", "更新成功");
            }
            else
            {
                await MappingService.CreateAsync(current);
                await JS.InvokeVoidAsync("alert", "创建成功");
            }

            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"保存失败：{ex.Message}"); }
        finally { saving = false; }
    }

    private void CloseModal() { showModal = false; current = new(); editId = null; isEdit = false; }

    private async Task Delete(Guid id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "确定删除该映射？");
        if (!ok) return;
        try
        {
            await MappingService.DeleteAsync(id);
            await JS.InvokeVoidAsync("alert", "已删除");
            await LoadData();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"删除失败：{ex.Message}"); }
    }
}