@page "/supply-chain/product-sku"
@layout SupplyChainLayout
@inject IProductSkuAppService SkuService
@inject IProductAppService ProductService
@inject IJSRuntime JS

<HCard Title="商品 SKU 管理">
    <div class="h-toolbar">
        <select @bind="@productIdFilter" class="h-input" style="width:auto">
            <option value="">全部商品</option>
            @foreach (var p in products)
            {
                <option value="@p.Id">@p.ProductCode - @p.Name</option>
            }
        </select>
        <input type="text" @bind-value="@filter" placeholder="SKU 编码或名称" class="h-input" style="width:200px;" />
        <button class="h-btn h-btn-primary" @onclick="@LoadData">查询</button>
        <button class="h-btn h-btn-primary" @onclick="@ShowCreate">新增 SKU</button>
        <button class="h-btn" @onclick="@LoadData">刷新</button>
    </div>
    <HTable Loading="@loading" ShowEmpty="@(!loading && !skus.Any())">
        <thead>
            <tr>
                <th>SKU 编码</th>
                <th>SKU 名称</th>
                <th>所属商品</th>
                <th>规格</th>
                <th>售价</th>
                <th>库存</th>
                <th>启用</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in skus)
            {
                <tr>
                    <td>@s.SkuCode</td>
                    <td>@s.SkuName</td>
                    <td>@(productNames.GetValueOrDefault(s.ProductId) ?? "-")</td>
                    <td style="max-width:200px;"><pre style="white-space:pre-wrap;">@(s.SpecsJson ?? "-")</pre></td>
                    <td>@s.Price.ToString("F2")</td>
                    <td>@s.Stock</td>
                    <td>
                        @if (s.IsEnabled) { <span class="h-tag h-tag-green">启用</span> }
                        else { <span class="h-tag h-tag-red">禁用</span> }
                    </td>
                    <td>
                        <span class="h-space">
                            <button class="h-btn h-btn-primary h-btn-sm" @onclick="@(() => Edit(s))">编辑</button>
                            <button class="h-btn h-btn-danger h-btn-sm" @onclick="@(() => Delete(s.Id))">删除</button>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </HTable>
</HCard>

<HModal Title="@(isEdit ? "编辑 SKU" : "新增 SKU")" Visible="@showModal" OnOk="@Save" OnCancel="@CloseModal" ConfirmLoading="@saving" Style="width:720px;">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">所属商品</label>
        <div class="h-form-control">
            <select @bind="@current.ProductId" class="h-input" style="width:auto" disabled="@isEdit">
                @foreach (var p in products)
                {
                    <option value="@p.Id">@p.ProductCode - @p.Name</option>
                }
            </select>
        </div>
    </div>
    @if (!isEdit)
    {
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">SKU 编码</label>
            <div class="h-form-control">
                <input type="text" @bind-value="@current.SkuCode" class="h-input" />
            </div>
        </div>
    }
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">SKU 名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@current.SkuName" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">规格 (JSON)</label>
        <div class="h-form-control">
            <textarea @bind="@current.SpecsJson" rows="3" class="h-textarea" placeholder='{"color":"red","size":"XL"}'></textarea>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">售价</label>
        <div class="h-form-control">
            <input type="number" @bind-value="@current.Price" class="h-input" style="width:180px;" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">库存</label>
        <div class="h-form-control">
            <input type="number" @bind-value="@current.Stock" class="h-input" style="width:180px;" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">启用</label>
        <div class="h-form-control">
            <label class="h-switch">
                <input type="checkbox" @bind="@current.IsEnabled" />
                <span class="h-switch-slider"></span>
            </label>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea @bind="@current.Remark" rows="2" class="h-textarea"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<ProductSkuDto> skus = new();
    private List<ProductDto> products = new();
    private Dictionary<Guid, string> productNames = new();
    private bool loading;
    private string filter = string.Empty;
    private Guid? productIdFilter;

    private bool showModal;
    private bool saving;
    private bool isEdit;
    private Guid? editId;
    private CreateProductSkuDto current = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        await LoadData();
    }

    private async Task LoadProducts()
    {
        try
        {
            var r = await ProductService.GetListAsync(new ProductQueryDto { MaxResultCount = 200 });
            products = r.Items.ToList();
            productNames = products.ToDictionary(p => p.Id, p => $"{p.ProductCode} - {p.Name}");
        }
        catch { }
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var input = new ProductSkuQueryDto { MaxResultCount = 100, Filter = string.IsNullOrWhiteSpace(filter) ? null : filter };
            input.ProductId = productIdFilter;
            var result = await SkuService.GetListAsync(input);
            skus = result.Items.ToList();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"加载失败：{ex.Message}"); }
        finally { loading = false; }
    }

    private void ShowCreate()
    {
        current = new CreateProductSkuDto
        {
            ProductId = productIdFilter ?? Guid.Empty,
            IsEnabled = true
        };
        if (current.ProductId == Guid.Empty && products.Any())
        {
            current.ProductId = products[0].Id;
        }
        isEdit = false;
        editId = null;
        showModal = true;
    }

    private void Edit(ProductSkuDto s)
    {
        current = new CreateProductSkuDto
        {
            ProductId = s.ProductId,
            SkuCode = s.SkuCode,
            SkuName = s.SkuName,
            SpecsJson = s.SpecsJson,
            Price = s.Price,
            Stock = s.Stock,
            IsEnabled = s.IsEnabled,
            Remark = s.Remark
        };
        isEdit = true;
        editId = s.Id;
        showModal = true;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            if (current.ProductId == Guid.Empty || string.IsNullOrWhiteSpace(current.SkuCode) || string.IsNullOrWhiteSpace(current.SkuName))
            {
                await JS.InvokeVoidAsync("alert", "商品、SKU 编码、名称不能为空");
                return;
            }

            if (isEdit && editId.HasValue)
            {
                await SkuService.UpdateAsync(editId.Value, new UpdateProductSkuDto
                {
                    SkuName = current.SkuName,
                    SpecsJson = current.SpecsJson,
                    Price = current.Price,
                    Stock = current.Stock,
                    IsEnabled = current.IsEnabled,
                    Remark = current.Remark
                });
                await JS.InvokeVoidAsync("alert", "更新成功");
            }
            else
            {
                await SkuService.CreateAsync(current);
                await JS.InvokeVoidAsync("alert", "创建成功");
            }

            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"保存失败：{ex.Message}"); }
        finally { saving = false; }
    }

    private void CloseModal() { showModal = false; current = new(); editId = null; isEdit = false; }

    private async Task Delete(Guid id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "确定删除该 SKU？");
        if (!ok) return;
        try
        {
            await SkuService.DeleteAsync(id);
            await JS.InvokeVoidAsync("alert", "已删除");
            await LoadData();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"删除失败：{ex.Message}"); }
    }
}