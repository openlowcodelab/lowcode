@namespace H.Testing.Web

<link href="_content/H.Testing.Web/css/category-tree.css" rel="stylesheet" />

<div class="category-tree">
    @if (Categories != null && Categories.Any())
    {
        @foreach (var category in GetRootCategories())
        {
            @RenderTreeNode(category, 0)
        }
    }
    else
    {
        <div style="padding: 20px; text-align: center; color: #999;">
            <small>暂无分类数据</small>
        </div>
    }
</div>

@code {
    [Parameter] public List<ProjectCaseCategory> Categories { get; set; } = new();
    [Parameter] public long? SelectedCategoryId { get; set; }
    [Parameter] public EventCallback<long?> OnCategorySelected { get; set; }
    [Parameter] public EventCallback<ProjectCaseCategory> OnAddChild { get; set; }
    [Parameter] public EventCallback<ProjectCaseCategory> OnEdit { get; set; }
    [Parameter] public EventCallback<ProjectCaseCategory> OnDelete { get; set; }
    [Parameter] public Dictionary<long, int> TestCaseCounts { get; set; } = new();

    private HashSet<long> expandedCategories = new();
    private long? openDropdownId = null;

    private List<ProjectCaseCategory> GetRootCategories()
    {
        return Categories.OrderBy(c => c.Order).ToList();
    }

    private ProjectCaseCategory? FindCategoryInTree(long id, IEnumerable<ProjectCaseCategory> nodes)
    {
        foreach (var n in nodes)
        {
            if (n.Id == id) return n;
            if (n.Childrens is { Length: > 0 })
            {
                var hit = FindCategoryInTree(id, n.Childrens);
                if (hit != null) return hit;
            }
        }
        return null;
    }

    private List<ProjectCaseCategory> GetChildCategories(long categoryId)
    {
        var category = FindCategoryInTree(categoryId, Categories);
        return category?.Childrens?.OrderBy(c => c.Order).ToList() ?? new List<ProjectCaseCategory>();
    }

    private bool HasChildren(long categoryId)
    {
        var children = GetChildCategories(categoryId);
        return children.Any();
    }

    private bool IsExpanded(long categoryId)
    {
        return expandedCategories.Contains(categoryId);
    }

    private async Task ToggleExpand(long categoryId)
    {
        if (expandedCategories.Contains(categoryId))
        {
            expandedCategories.Remove(categoryId);
        }
        else
        {
            expandedCategories.Add(categoryId);
        }
        await Task.CompletedTask;
    }

    private async Task SelectCategory(long categoryId)
    {
        await OnCategorySelected.InvokeAsync(categoryId);
    }

    private int GetTestCaseCount(long categoryId)
    {
        if (TestCaseCounts.ContainsKey(categoryId))
        {
            return TestCaseCounts[categoryId];
        }
        return 0;
    }

    private void ToggleDropdown(long categoryId)
    {
        openDropdownId = openDropdownId == categoryId ? null : categoryId;
    }

    private void CloseDropdown()
    {
        openDropdownId = null;
    }

    private RenderFragment RenderTreeNode(ProjectCaseCategory category, int level) => __builder =>
    {
        var isSelected = SelectedCategoryId == category.Id;
        var hasChildren = HasChildren(category.Id);
        var isExpanded = IsExpanded(category.Id);
        var paddingLeft = level * 20;
        var testCaseCount = GetTestCaseCount(category.Id);

        <div class="tree-node">
            <div class="tree-node-row @(isSelected ? "selected" : "")" style="padding-left: @(paddingLeft)px;">
                @if (hasChildren)
                {
                    <span class="tree-node-expand-icon" @onclick="() => ToggleExpand(category.Id)">
                        @(isExpanded ? "▼" : "▶")
                    </span>
                }
                else
                {
                    <span class="tree-node-expand-icon placeholder"></span>
                }

                <span class="tree-node-title" @onclick="() => SelectCategory(category.Id)">
                    @category.Name
                </span>

                <span class="tree-node-badge">
                    @testCaseCount
                </span>

                <div class="tree-node-actions" style="position: relative;">
                    <button type="button" class="btn btn-sm btn-link tree-node-action-btn" @onclick="() => ToggleDropdown(category.Id)" @onclick:stopPropagation>⋯</button>
                    @if (openDropdownId == category.Id)
                    {
                        <div style="position: absolute; right: 0; top: 100%; z-index: 100; background: #fff; border: 1px solid #d9d9d9; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); min-width: 120px;">
                            <div style="padding: 6px 12px; cursor: pointer; white-space: nowrap;" @onclick="async () => { CloseDropdown(); await OnAddChild.InvokeAsync(category); }">
                                添加子分类
                            </div>
                            <div style="padding: 6px 12px; cursor: pointer; white-space: nowrap;" @onclick="async () => { CloseDropdown(); await OnEdit.InvokeAsync(category); }">
                                编辑
                            </div>
                            <div style="border-top: 1px solid #f0f0f0;"></div>
                            <div style="padding: 6px 12px; cursor: pointer; white-space: nowrap; color: #ff4d4f;" @onclick="async () => { CloseDropdown(); await OnDelete.InvokeAsync(category); }">
                                删除
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (hasChildren && isExpanded)
            {
                var children = GetChildCategories(category.Id);
                foreach (var child in children)
                {
                    @RenderTreeNode(child, level + 1)
                }
            }
        </div>
    };
}
