@namespace H.Testing.Web

@inject IPlaywrightRecorderAppService PlaywrightRecorderAppService
@inject NavigationManager NavigationManager

<!-- Playwright 录制模态框 -->
@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="oi oi-video me-2"></i>Playwright 录制器
                    </h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body">
                    @if (!isRecording && !isProcessing && recordedSteps.Count == 0)
                    {
                        <!-- 录制前配置 -->
                        <div class="mb-4">
                            <h6 class="mb-3">📋 录制配置</h6>
                            <div class="mb-3">
                                <label class="form-label">起始URL（可选）</label>
                                <input type="url" class="form-control" @bind="startUrl" 
                                       placeholder="https://example.com" />
                                <div class="form-text">
                                    如果不填写，录制器将打开空白页面，您可以手动导航到目标网站
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-info">
                            <h6 class="alert-heading">📝 录制说明</h6>
                            <ul class="mb-0">
                                <li>点击"开始录制"后，将打开 Playwright 录制器窗口</li>
                                <li>在录制器中进行您的操作（点击、输入、导航等）</li>
                                <li>完成操作后，点击"停止录制"</li>
                                <li>系统将自动解析录制内容并生成测试步骤</li>
                            </ul>
                        </div>
                    }
                    else if (isRecording)
                    {
                        <!-- 录制中状态 -->
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">录制中...</span>
                            </div>
                            <h5 class="text-primary">🎬 正在录制中</h5>
                            <p class="text-muted mb-4">
                                请在 Playwright 录制器窗口中进行您的操作<br>
                                完成后点击下方"停止录制"按钮
                            </p>
                            <div class="alert alert-warning">
                                <strong>注意：</strong>请不要关闭录制器窗口，操作完成后使用下方按钮停止录制
                            </div>
                        </div>
                    }
                    else if (isProcessing)
                    {
                        <!-- 处理中状态 -->
                        <div class="text-center py-4">
                            <div class="spinner-border text-success mb-3" role="status">
                                <span class="visually-hidden">处理中...</span>
                            </div>
                            <h5 class="text-success">⚙️ 正在处理录制结果</h5>
                            <p class="text-muted">正在解析录制内容并生成测试步骤...</p>
                        </div>
                    }
                    else if (recordedSteps.Count > 0)
                    {
                        <!-- 录制结果展示 -->
                        <div class="mb-4">
                            <h6 class="mb-3">
                                ✅ 录制完成 
                                <span class="badge bg-success">共 @recordedSteps.Count 个步骤</span>
                            </h6>
                            
                            <div class="alert alert-success">
                                录制成功！以下是解析出的测试步骤，您可以选择需要的步骤添加到测试用例中。
                            </div>
                            
                            <!-- 步骤列表 -->
                            <div style="max-height: 400px; overflow-y: auto;">
                                @for (int i = 0; i < recordedSteps.Count; i++)
                                {
                                    var step = recordedSteps[i];
                                    var index = i;
                                    
                                    <div class="card mb-2 @(selectedStepIndices.Contains(index) ? "border-primary" : "")">
                                        <div class="card-body py-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" 
                                                       checked="@selectedStepIndices.Contains(index)"
                                                       @onchange="@(e => ToggleStepSelection(index, (bool)e.Value!))" />
                                                <label class="form-check-label w-100">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <strong>@step.Name</strong>
                                                            <small class="text-muted ms-2">@GetStepTypeDisplayName(step.Type)</small>
                                                            <br>
                                                            @if (step.UiConfig != null)
                                                            {
                                                                <small class="text-muted">
                                                                    @step.UiConfig.Action
                                                                    @if (!string.IsNullOrEmpty(step.UiConfig.Selector))
                                                                    {
                                                                        <span> → @step.UiConfig.Selector</span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(step.UiConfig.Value))
                                                                    {
                                                                        <span> = "@step.UiConfig.Value"</span>
                                                                    }
                                                                </small>
                                                            }
                                                        </div>
                                                        <span class="badge bg-secondary">@(index + 1)</span>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <!-- 全选/全不选 -->
                            <div class="mt-3">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAllSteps">
                                    全选
                                </button>
                                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="DeselectAllSteps">
                                    全不选
                                </button>
                                <span class="text-muted ms-3">
                                    已选择 @selectedStepIndices.Count / @recordedSteps.Count 个步骤
                                </span>
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <strong>错误：</strong>@errorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (!isRecording && !isProcessing && recordedSteps.Count == 0)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="HideModal">取消</button>
                        <button type="button" class="btn btn-primary" @onclick="StartRecording" disabled="@isProcessing">
                            <i class="oi oi-media-record me-2"></i>开始录制
                        </button>
                    }
                    else if (isRecording)
                    {
                        <button type="button" class="btn btn-danger" @onclick="StopRecording">
                            <i class="oi oi-media-stop me-2"></i>停止录制
                        </button>
                    }
                    else if (recordedSteps.Count > 0)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="ResetRecording">
                            <i class="oi oi-reload me-2"></i>重新录制
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="AddSelectedSteps" 
                                disabled="@(selectedStepIndices.Count == 0)">
                            <i class="oi oi-plus me-2"></i>添加选中步骤 (@selectedStepIndices.Count)
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public EventCallback OnHide { get; set; }
    [Parameter] public EventCallback<List<CaseStepDto>> OnStepsGenerated { get; set; }

    private string startUrl = "";
    private bool isRecording = false;
    private bool isProcessing = false;
    private string currentSessionId = "";
    private List<CaseStepDto> recordedSteps = new();
    private HashSet<int> selectedStepIndices = new();
    private string errorMessage = "";

    protected override void OnParametersSet()
    {
        if (ShowModal)
        {
            ResetState();
        }
    }

    private void ResetState()
    {
        startUrl = "";
        isRecording = false;
        isProcessing = false;
        currentSessionId = "";
        recordedSteps.Clear();
        selectedStepIndices.Clear();
        errorMessage = "";
    }

    private async Task StartRecording()
    {
        try
        {
            errorMessage = "";
            isProcessing = true;
            StateHasChanged();

            var resp = (await PlaywrightRecorderAppService.StartRecordingAsync("/")).Data!;
            currentSessionId = resp.SessionId;            
        }
        catch (Exception ex)
        {
            errorMessage = $"启动录制失败: {ex.Message}";
            isProcessing = false;
        }
        
        StateHasChanged();
    }

    private async Task StopRecording()
    {
        try
        {
            errorMessage = "";
            isRecording = false;
            isProcessing = true;
            StateHasChanged();

            var resp = (await PlaywrightRecorderAppService.StopRecordingAsync(currentSessionId)).Data!;
                
            if (resp.IsSuccess)
            {
                await ParseRecordedCode(resp.RecordedCode);
            }
            else
            {
                errorMessage = resp.Message ?? "停止录制失败";
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"停止录制失败: {ex.Message}";
            isProcessing = false;
        }
        
        StateHasChanged();
    }

    private async Task ParseRecordedCode(string recordedCode)
    {
        try
        {
            
        }
        catch (Exception ex)
        {
            errorMessage = $"解析录制代码失败: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ToggleStepSelection(int index, bool isSelected)
    {
        if (isSelected)
        {
            selectedStepIndices.Add(index);
        }
        else
        {
            selectedStepIndices.Remove(index);
        }
    }

    private void SelectAllSteps()
    {
        selectedStepIndices = Enumerable.Range(0, recordedSteps.Count).ToHashSet();
    }

    private void DeselectAllSteps()
    {
        selectedStepIndices.Clear();
    }

    private async Task AddSelectedSteps()
    {
        var selectedSteps = selectedStepIndices
            .OrderBy(i => i)
            .Select(i => recordedSteps[i])
            .ToList();

        await OnStepsGenerated.InvokeAsync(selectedSteps);
        await HideModal();
    }

    private async Task ResetRecording()
    {
        ResetState();
        StateHasChanged();
    }

    private async Task HideModal()
    {
        ShowModal = false;
        ResetState();
        await OnHide.InvokeAsync();
    }

    private string GetStepTypeDisplayName(StepType stepType)
    {
        return stepType switch
        {
            StepType.Navigate => "页面导航",
            StepType.Click => "点击操作",
            StepType.Input => "输入文本",
            StepType.Select => "选择操作",
            StepType.Wait => "等待操作",
            StepType.Assert => "断言验证",
            StepType.Screenshot => "截图",
            StepType.Scroll => "滚动操作",
            StepType.Hover => "悬停操作",
            StepType.KeyPress => "按键操作",
            _ => stepType.ToString()
        };
    }

    // 响应模型类（与控制器中的模型保持一致）
    private class StartRecordingResponse
    {
        public string SessionId { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private class StopRecordingResponse
    {
        public string SessionId { get; set; } = string.Empty;
        public string RecordedCode { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private class ParseRecordingResponse
    {
        public List<CaseStepDto> Steps { get; set; } = new();
        public bool IsSuccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}