@namespace H.Testing.Web

@inject ICaseAppService CaseService
@inject ITestDatasetAppService DatasetService
@inject H.Util.Blazor.HToastService Toast
@inject IJSRuntime JSRuntime

<HModal Visible="ShowModal"
        Title="🧪 数据集"
        OnCancel="CloseModal"
        ShowFooter="false"
        Style="width:900px;">
    @if (Case == null || Case.ProjectId == 0)
    {
        <div class="h-empty" style="padding:40px 0;">请先保存测试用例后再管理数据集</div>
    }
    else
    {
        <div style="display:flex;gap:4px;border-bottom:1px solid #F2F3F5;margin-bottom:12px;">
            <button class="h-btn" style="@GetTabStyle("link")" @onclick="ShowLinkTab">
                关联数据集@(Case.Id > 0 && Case.DatasetIds.Count > 0 ? $"（{Case.DatasetIds.Count}）" : "")
            </button>
            <button class="h-btn" style="@GetTabStyle("manage")" @onclick="ShowManageTab">
                管理数据集
            </button>
        </div>

        @if (activeDatasetTab == "link")
        {
            @if (Case.Id == 0)
            {
                <div class="h-empty" style="padding:40px 0;">当前用例尚未保存，请先点击「✓ 保存」保存用例后再关联数据集</div>
            }
            else if (loadingLinkDatasets)
            {
                <div class="h-empty" style="padding:40px 0;">
                    <span class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></span>
                </div>
            }
            else if (!linkDatasets.Any())
            {
                <div class="h-empty" style="padding:40px 0;">暂无数据集，请先切换到「管理数据集」页签创建</div>
            }
            else
            {
                <div style="color:#86909C;font-size:12px;margin-bottom:8px;">
                    勾选将数据集关联到当前用例（即时生效）；执行页勾选该用例后，数据集下拉框会标记「★已关联」
                </div>

                <div style="max-height:420px;overflow:auto;border:1px solid #F2F3F5;border-radius:4px;">
                    <table class="h-table">
                        <thead>
                            <tr>
                                <th style="width:56px;">关联</th>
                                <th style="width:160px;">名称</th>
                                <th>变量（列名）</th>
                                <th style="width:60px;">行数</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dataset in linkDatasets)
                            {
                                var associated = Case.DatasetIds.Contains(dataset.Id);
                                <tr style="@(associated ? "background:#E8F3FF;" : "")">
                                    <td style="text-align:center;">
                                        <input type="checkbox" checked="@associated" disabled="@linking"
                                               @onchange="e => ToggleAssociation(dataset, (bool)(e.Value ?? false))" />
                                    </td>
                                    <td>@dataset.Name</td>
                                    <td>
                                        @if (dataset.Columns.Count == 0)
                                        {
                                            <span style="color:#86909C;font-size:12px;">无数据列</span>
                                        }
                                        else
                                        {
                                            foreach (var column in dataset.Columns.Take(6))
                                            {
                                                <span class="h-tag h-tag-blue" style="cursor:pointer;margin:1px 4px 1px 0;"
                                                      title="点击复制变量 @ToVariable(column)"
                                                      @onclick="() => CopyVariable(column)">@ToVariable(column)</span>
                                            }
                                            @if (dataset.Columns.Count > 6)
                                            {
                                                <span style="color:#86909C;font-size:12px;">+@(dataset.Columns.Count - 6)</span>
                                            }
                                        }
                                    </td>
                                    <td>@dataset.RowCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <Datasets ProjectId="Case.ProjectId" />
        }
    }
</HModal>

@code {
    /// <summary>当前用例（步骤编辑页传入的实时对象；关联变更会同步回该对象的 DatasetIds）</summary>
    [Parameter] public CaseDto? Case { get; set; }
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeDatasetTab = "link";    private bool loadingLinkDatasets;
    private bool linking;
    private List<TestDatasetDto> linkDatasets = new();

    private bool lastShowModal;

    private void CloseModal() => OnClose.InvokeAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (ShowModal && !lastShowModal)
        {
            activeDatasetTab = "link";
            await LoadLinkDatasetsAsync();
        }
        lastShowModal = ShowModal;
    }

    private string GetTabStyle(string tab)
    {
        var active = activeDatasetTab == tab;
        return "border:none;background:none;box-shadow:none;padding:8px 12px;"
               + $"border-bottom:2px solid {(active ? "#165DFF" : "transparent")};border-radius:0;"
               + (active ? "color:#165DFF;font-weight:600;" : "color:rgba(0,0,0,.65);");
    }

    private async Task ShowLinkTab()
    {
        activeDatasetTab = "link";
        await LoadLinkDatasetsAsync();
    }

    private void ShowManageTab() => activeDatasetTab = "manage";

    private async Task LoadLinkDatasetsAsync()
    {
        if (Case == null || Case.ProjectId == 0)
        {
            linkDatasets = [];
            return;
        }

        try
        {
            loadingLinkDatasets = true;
            linkDatasets = (await DatasetService.GetByProjectIdAsync(Case.ProjectId)).Data ?? [];
        }
        catch (Exception ex)
        {
            Toast.Error($"加载数据集失败: {ex.Message}");
        }
        finally
        {
            loadingLinkDatasets = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 切换用例与数据集的关联关系；以服务端最新用例为基准保存，避免覆盖其他字段，并同步回传入的用例对象
    /// </summary>
    private async Task ToggleAssociation(TestDatasetDto dataset, bool associated)
    {
        if (Case?.Id == 0 || linking)
        {
            return;
        }

        try
        {
            linking = true;

            var serverCase = (await CaseService.GetByIdAsync(Case!.Id)).Data;
            if (serverCase == null)
            {
                Toast.Error("用例不存在或已被删除");
                return;
            }

            if (associated && !serverCase.DatasetIds.Contains(dataset.Id))
            {
                serverCase.DatasetIds.Add(dataset.Id);
            }
            if (!associated)
            {
                serverCase.DatasetIds.Remove(dataset.Id);
            }

            var updated = await CaseService.UpdateAsync(Case.Id, serverCase);
            if (updated.Success && updated.Data)
            {
                if (associated && !Case.DatasetIds.Contains(dataset.Id))
                {
                    Case.DatasetIds.Add(dataset.Id);
                }
                if (!associated)
                {
                    Case.DatasetIds.Remove(dataset.Id);
                }

                Toast.Success(associated ? $"已关联数据集「{dataset.Name}」" : $"已取消关联「{dataset.Name}」");
            }
            else
            {
                Toast.Error(updated.Message ?? "保存失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            linking = false;
            StateHasChanged();
        }
    }

    private async Task CopyVariable(string column)
    {
        var variable = ToVariable(column);
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", variable);
            Toast.Success($"已复制变量 {variable}");
        }
        catch (Exception)
        {
            Toast.Error("复制失败，请手动复制：" + variable);
        }
    }

    private static string ToVariable(string column) => $"{{{{{column}}}}}";
}
