    private List<CaseCategoryDto> GetAvailableParentCategories()
    {
        if (!isEditingCategory)
        {
            return categories.OrderBy(c => c.Order).ToList();
        }

        var excludeIds = new HashSet<long> { currentCategory.Id };
        AddChildCategoryIds(currentCategory.Id, excludeIds);
        return FilterCategoryTree(categories, excludeIds);
    }

    private List<CaseCategoryDto> FilterCategoryTree(IEnumerable<CaseCategoryDto> nodes, HashSet<long> excludeIds)
    {
        var result = new List<CaseCategoryDto>();
        foreach (var node in nodes.OrderBy(c => c.Order))
        {
            if (excludeIds.Contains(node.Id))
            {
                continue;
            }

            result.Add(new CaseCategoryDto
            {
                Id = node.Id,
                Name = node.Name,
                Description = node.Description,
                ProjectId = node.ProjectId,
                ParentId = node.ParentId,
                Order = node.Order,
                Childrens = FilterCategoryTree(node.Childrens ?? [], excludeIds).ToArray()
            });
        }
        return result;
    }

    private void AddChildCategoryIds(long categoryId, HashSet<long> excludeIds)
    {
        var category = FindCategoryInTree(categoryId, categories);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                excludeIds.Add(child.Id);
                AddChildCategoryIds(child.Id, excludeIds);
            }
        }
    }

