@page "/testing/project-cases"
@page "/testing/project-cases/{ProjectId:long}"

@namespace H.Testing.Web
@layout TestingLayout

<link href="_content/H.Testing.Web/css/category-tree.css" rel="stylesheet" />

@inject IProjectAppService ProjectService
@inject IProjectCaseCategoryAppService ProjectCaseCategoryAppService
@inject IProjectCaseAppService ProjectCaseService
@inject IBatchExecutionAppService BatchExecutionAppService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>测试用例管理</PageTitle>

<div class="cases-page">
<div class="page-fill" style="flex-shrink: 0; padding: 12px 16px;">
    <div style="display: flex; gap: 16px; align-items: center;">
        <div style="flex: 0 0 25%;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>选择项目:</span>
                <select class="h-select" style="width: 200px;" value="@selectedProjectId" @onchange="@(async e => await OnProjectChanged(e.Value?.ToString() ?? ""))">
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </div>
        </div>
        
        <div style="flex: 1;">
            <div style="display: flex; justify-content: space-around;">
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #165DFF; font-weight: 500;">@filteredTestCases.Count</div>
                    <div style="color: #86909C; font-size: 12px;">总用例</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #F53F3F; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T0"))</div>
                    <div style="color: #86909C; font-size: 12px;">T0级别</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #FF7D00; font-weight: 500;">@filteredTestCases.Count(tc => tc.Levels.Contains("T1"))</div>
                    <div style="color: #86909C; font-size: 12px;">T1级别</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #00B42A; font-weight: 500;">@selectedTestCases.Count</div>
                    <div style="color: #86909C; font-size: 12px;">已选中</div>
                </div>
            </div>
        </div>
        
        <div style="flex: 0 0 25%;">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button class="h-btn" 
                        style="background-color: #00B42A; border-color: #00B42A; color: white;"
                        @onclick="ExecuteSelectedTests" 
                        disabled="@(!selectedTestCases.Any() || selectedProjectId == 0)">
                    ▶ 执行选中
                </button>
                <button class="h-btn h-btn-primary" @onclick="CreateNewTestCase">
                    ➕ 新建用例
                </button>
            </div>
        </div>
    </div>
</div>

<div class="cases-body">
        <div class="cases-tree-panel">
            <HCard>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-weight: 500;">📁 分类</span>
                    <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowAddCategoryModal">➕</button>
                </div>
                <div class="cases-scroll">
                    <button class="tree-node-row py-2 @(selectedCategoryId == 0 ? "selected" : "")"
                            @onclick="() => SelectCategory(null)" 
                            style="cursor: pointer; width: 100%; border: none; border-radius: 4px; margin-bottom: 2px;">
                        <span class="tree-node-expand-icon placeholder"></span>
                        <span class="tree-node-title"><small><i class="oi oi-list"></i> 全部 (@testCases.Count)</small></span>
                    </button>
                    <CategoryTree Categories="categories"
                                 SelectedCategoryId="selectedCategoryId"
                                 OnCategorySelected="SelectCategory"
                                 OnAddChild="ShowAddChildCategoryModal"
                                 OnEdit="ShowEditCategoryModal"
                                 OnDelete="HandleDeleteCategory"
                                 TestCaseCounts="categoryTestCaseCounts" />
                </div>
            </HCard>
        </div>

        <div class="cases-list-panel">
            <HCard>
                <div style="margin-bottom: 12px;">
                    <input class="h-input" Placeholder="搜索用例..."
                                     @bind-value="searchTerm" @bind-value:event="oninput"
                                     Style="width: 300px;" />
                </div>

                <div class="cases-scroll">
                    @if (loading)
                    {
                        <div style="text-align: center; padding: 40px;">
                            <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
                        </div>
                    }
                    else if (displayTestCases.Any())
                    {
                        <HTable>
                            <thead>
                                <tr>
                                    <th style="width: 100px;">用例编号</th>
                                    <th>用例名称</th>
                                    <th style="width: 120px;">级别</th>
                                    <th style="width: 60px;">步骤数</th>
                                    <th style="width: 100px;">执行结果</th>
                                    <th style="width: 180px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var context in displayTestCases)
                                {
                                    <tr>
                                        <td>
                                            <span style="color: #86909C;">@context.CaseNumber</span>
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@context.Name</strong>
                                                @if (context.IsTemplate)
                                                {
                                                    <span class="h-tag h-tag-blue" style="margin-left: 8px;">模板</span>
                                                }
                                                @if (context.TemplateId.HasValue)
                                                {
                                                    <span class="h-tag h-tag-default" style="margin-left: 4px;">继承</span>
                                                }
                                                @if (!string.IsNullOrEmpty(context.Description))
                                                {
                                                    <div style="color: #86909C; font-size: 12px; margin-top: 4px;">@context.Description</div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (context.Levels.Any())
                                            {
                                                @foreach (var level in context.Levels.Take(3))
                                                {
                                                    <span class="h-tag h-tag-@GetLevelTagClass(level)" style="margin-right: 4px;">@level</span>
                                                }
                                                @if (context.Levels.Count > 3)
                                                {
                                                    <span style="color: #86909C; font-size: 12px;">+@(context.Levels.Count - 3)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #86909C;">无</span>
                                            }
                                        </td>
                                        <td>
                                            @context.Steps.Count
                                        </td>
                                        <td>
                                            @if (context.LastExecutionResult.HasValue)
                                            {
                                                <span class="h-tag h-tag-@GetExecutionResultTagClass(context.LastExecutionResult.Value)">
                                                    @GetExecutionResultText(context.LastExecutionResult.Value)
                                                </span>
                                                @if (context.LastExecutionTime.HasValue)
                                                {
                                                    <div style="color: #86909C; font-size: 12px; margin-top: 4px;">@context.LastExecutionTime.Value.ToString("MM-dd HH:mm")</div>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #86909C;">未执行</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="row-actions">
                                                <a class="link-action" style="color: #00B42A;" @onclick="() => ExecuteSingleTest(context)">执行</a>
                                                <a class="link-action" @onclick="() => EditTestCaseSteps(context)">测试步骤</a>
                                                <a class="link-action link-action-muted" @onclick="e => ToggleTestCaseDropdown(context.Id, e)">更多 ▾</a>
                                                @if (openTestCaseDropdownId == context.Id)
                                                {
                                                    <div class="h-dropdown-mask" @onclick="() => openTestCaseDropdownId = null"></div>
                                                    <div class="h-dropdown-panel h-dropdown-panel-fixed" style="@GetDropdownPanelStyle()">
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ShowTemplateSettingsModal(context); }">模板设置</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ViewExecutionHistory(context); }">测试报告</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; CopyTestCase(context); }">复制</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ShowEditBasicInfoModal(context); }">编辑</div>
                                                        <div class="h-dropdown-divider"></div>
                                                        <div class="h-dropdown-item danger" @onclick="() => { openTestCaseDropdownId = null; DeleteTestCase(context.Id); }">删除</div>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </HTable>
                    }
                    else
                    {
                        <div class="h-empty">暂无测试用例数据</div>
                    }
                </div>
            </HCard>
        </div>
    </div>
</div>

@{
    var categoryModalTitle = isEditingCategory ? "编辑分类" : "新建分类";
}
<HModal Visible="showCategoryModal" 
        Title="@categoryModalTitle" 
        OnOk="SaveCategory" 
        OnCancel="HideCategoryModal"
        Style="width: 600px;">
    <EditForm Model="currentCategory" OnValidSubmit="SaveCategory">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">分类名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentCategory.Name" />
                <ValidationMessage For="() => currentCategory.Name" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">父级分类</label>
            <div class="h-form-control" style="flex: 1;">
                <TreeSelectDropdown Categories="GetAvailableParentCategories()" 
                                   SelectedValue="currentCategory.ParentId" 
                                   SelectedValueChanged="@(v => currentCategory.ParentId = v)"
                                   EmptyOptionText="无(根分类)" 
                                   Placeholder="请选择父级分类" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">排序</label>
            <div class="h-form-control" style="flex: 1;">
                <Microsoft.AspNetCore.Components.Forms.InputNumber class="h-input" @bind-Value="currentCategory.Order" />
            </div>
        </div>
    </EditForm>
</HModal>

<HModal Visible="showTemplateSettingsModal" 
        Title="@($"模板设置 - {editingTestCase.Name}")" 
        OnOk="SaveTemplateSettings" 
        OnCancel="HideTemplateSettingsModal"
        Style="width: 600px;">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px;">
            <label class="h-switch">
                <input type="checkbox" @bind="editingTestCase.IsTemplate" />
                <span class="h-switch-slider"></span>
            </label>
            <span Style="margin-left: 8px;">设为测试模板</span>
            <div Style="color: #86909C; font-size: 12px; margin-top: 4px;">将此用例设为模板，供其他用例继承。</div>
        </div>
        
        @if (!editingTestCase.IsTemplate)
        {
            <div Style="margin-bottom: 16px;">
                <label Style="display: block; margin-bottom: 8px;">继承模板</label>
                <select class="h-select" style="width: 100%;" value="@(editingTestCase.TemplateId?.ToString() ?? "")" @onchange="OnTemplateChanged">
                    <option value="">无(独立用例)</option>
                    @foreach (var template in availableTemplates)
                    {
                        <option value="@template.Id">@(template.Name + (string.IsNullOrEmpty(template.CaseNumber) ? "" : $"({template.CaseNumber})"))</option>
                    }
                </select>
                <div Style="color: #86909C; font-size: 12px; margin-top: 4px;">
                    选择模板后，此用例将自动使用模板中的步骤。您只需在此处维护测试数据。
                    <br>
                    <span Style="color: #F53F3F;">注意：继承模板后，当前用例的步骤将被覆盖且不可编辑。</span>
                </div>
            </div>
        }
    </div>
</HModal>

<ProjectCaseBasicInfoModal ShowModal="showBasicInfoModal" 
                        CurrentTestCase="currentTestCase" 
                        Categories="categories" 
                        IsEditing="isEditingBasicInfo" 
                        OnClose="HideBasicInfoModal" 
                        OnSave="SaveBasicInfo" 
                        OnSaveOnly="SaveBasicInfoOnly" />

@code {
    private List<ProjectDto> projects = new();
    private List<ProjectCaseDto> testCases = new();
    private List<ProjectCaseDto> filteredTestCases = new();
    private List<ProjectCaseDto> displayTestCases = new();
    private List<ProjectCaseCategory> categories = new();
    private HashSet<long> selectedTestCases = new();

    private ProjectCaseDto currentTestCase = new();
    private ProjectCaseDto editingTestCase = new();
    private ProjectCaseCategory currentCategory = new();

    private bool loading = true;
    private bool showCategoryModal = false;
    private bool showTemplateSettingsModal = false;
    private List<ProjectCaseDto> availableTemplates = new();
    private bool isEditingCategory = false;

    [Parameter]
    public long? ProjectId { get; set; }

    private long selectedProjectId = 0;
    private long selectedCategoryId = 0;
    private string searchTerm = "";
    private long? openTestCaseDropdownId = null;
    private (double X, double Y) testCaseDropdownPosition;

    private bool showBasicInfoModal = false;
    private bool isEditingBasicInfo = false;

    private HashSet<long> expandedCategories = new();

    private Dictionary<long, int> categoryTestCaseCounts = new();

    private void ToggleTestCaseDropdown(long testCaseId, MouseEventArgs e)
    {
        if (openTestCaseDropdownId == testCaseId)
        {
            openTestCaseDropdownId = null;
            return;
        }

        testCaseDropdownPosition = (e.ClientX, e.ClientY);
        openTestCaseDropdownId = testCaseId;
    }

    // 面板用 fixed 定位脱离表格滚动容器, 避免展开时计入滚动溢出导致出现滚动条;
    // 右对齐到点击位置, 并限制最大高度防止超出视口底部
    private string GetDropdownPanelStyle()
    {
        var (x, y) = testCaseDropdownPosition;
        var top = y + 4;
        return FormattableString.Invariant(
            $"left: {x}px; top: {top}px; transform: translateX(-100%); max-height: calc(100vh - {top}px - 8px); overflow-y: auto;");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();

        if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
        {
            selectedProjectId = ProjectId.Value;
        }
        else if (projects.Any())
        {
            selectedProjectId = projects.First().Id;
        }
        else
        {
            selectedProjectId = 0;
        }

        await LoadProjectData();

        loading = false;
        StateHasChanged();
    }

    private async Task LoadProjectData()
    {
        if (selectedProjectId != 0)
        {
            categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            testCases = await ProjectCaseService.GetByProjectIdAsync(selectedProjectId);

            filteredTestCases = testCases;
            CalculateCategoryTestCaseCounts();
            FilterTestCases();
        }
        else
        {
            categories = new List<ProjectCaseCategory>();
            filteredTestCases.Clear();
            displayTestCases.Clear();
            categoryTestCaseCounts.Clear();
        }

        selectedTestCases.Clear();
        StateHasChanged();
    }

    private async Task OnProjectChanged(string? projectIdStr)
    {
        if (string.IsNullOrEmpty(projectIdStr) || !long.TryParse(projectIdStr, out var projectId))
        {
            return;
        }

        if (projectId == selectedProjectId)
        {
            return;
        }

        selectedProjectId = projectId;
        selectedCategoryId = 0;

        await LoadProjectData();
        StateHasChanged();
    }

    private async Task SelectCategory(long? categoryId)
    {
        selectedCategoryId = categoryId ?? 0;
        
        if (selectedProjectId != 0)
        {
            if (selectedCategoryId == 0)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"selectedCategoryId_{selectedProjectId}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"selectedCategoryId_{selectedProjectId}", selectedCategoryId.ToString());
            }
        }
        
        FilterTestCases();
        StateHasChanged();
    }

    private void FilterTestCases()
    {
        displayTestCases = filteredTestCases.Where(tc =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                               tc.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               tc.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            
            var matchesCategory = selectedCategoryId == 0 ||
                                 (tc.CategoryId.HasValue && GetAllCategoryIds(selectedCategoryId).Contains(tc.CategoryId.Value));
            
            return matchesSearch && matchesCategory;
        })
        .OrderBy(tc => string.IsNullOrEmpty(tc.CaseNumber) ? "zzz" : tc.CaseNumber)
        .ThenBy(tc => tc.Order)
        .ThenBy(tc => tc.CreatedAt)
        .ToList();
        
        StateHasChanged();
    }
    
    private HashSet<long> GetAllCategoryIds(long categoryId)
    {
        var categoryIds = new HashSet<long> { categoryId };
        AddAllChildCategoryIds(categoryId, categoryIds);
        return categoryIds;
    }
    
    private void AddAllChildCategoryIds(long categoryId, HashSet<long> categoryIds)
    {
        var category = FindCategoryInTree(categoryId, categories);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                categoryIds.Add(child.Id);
                AddAllChildCategoryIds(child.Id, categoryIds);
            }
        }
    }

    private ProjectCaseCategory? FindCategoryInTree(long id, IEnumerable<ProjectCaseCategory> nodes)
    {
        foreach (var n in nodes)
        {
            if (n.Id == id) return n;
            if (n.Childrens is { Length: > 0 })
            {
                var hit = FindCategoryInTree(id, n.Childrens);
                if (hit != null) return hit;
            }
        }
        return null;
    }

    private IEnumerable<ProjectCaseCategory> FlattenCategories(IEnumerable<ProjectCaseCategory> nodes)
    {
        foreach (var n in nodes)
        {
            yield return n;
            if (n.Childrens is { Length: > 0 })
            {
                foreach (var c in FlattenCategories(n.Childrens))
                {
                    yield return c;
                }
            }
        }
    }
    
    private List<ProjectCaseCategory> GetRootCategories()
    {
        return categories.OrderBy(c => c.Order).ToList();
    }
    


    private void CalculateCategoryTestCaseCounts()
    {
        categoryTestCaseCounts.Clear();
        
        foreach (var category in FlattenCategories(categories))
        {
            var categoryIds = GetAllCategoryIds(category.Id);
            var count = testCases.Count(tc => tc.CategoryId.HasValue && categoryIds.Contains(tc.CategoryId.Value));
            categoryTestCaseCounts[category.Id] = count;
        }
    }

    private void ShowAddChildCategoryModal(ProjectCaseCategory parentCategory)
    {
        currentCategory = new ProjectCaseCategory 
        { 
            ProjectId = selectedProjectId
        };
        
        if (parentCategory.Childrens == null)
        {
            parentCategory.Childrens = Array.Empty<ProjectCaseCategory>();
        }
        
        isEditingCategory = false;
        showCategoryModal = true;
    }

    private async Task HandleDeleteCategory(ProjectCaseCategory category)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除分类 '{category.Name}' 吗?其子分类也会被删除。");
        if (confirmed)
        {
            await DeleteCategory(category.Id);
            CalculateCategoryTestCaseCounts();
        }
    }

    private void ToggleTestCaseSelection(long testCaseId, bool? isSelected)
    {
        if (isSelected == true)
        {
            selectedTestCases.Add(testCaseId);
        }
        else
        {
            selectedTestCases.Remove(testCaseId);
        }
        StateHasChanged();
    }

    private async Task ExecuteSelectedTests()
    {
        if (!selectedTestCases.Any()) return;
        
        var selectedIds = string.Join(",", selectedTestCases);
        Navigation.NavigateTo($"/testing/test-execution/batch/{selectedProjectId}?selectedIds={selectedIds}");
    }

    private async Task ExecuteSingleTest(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/testing/test-execution/{testCase.Id}");
    }
    
    private void ViewExecutionHistory(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/testing/execution-history/{testCase.Id}?returnProjectId={selectedProjectId}");
    }
    
    private void EditTestCase(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/testing/project-cases/{testCase.Id}/edit");
    }
    
    private void CreateNewTestCase()
    {
        if (selectedProjectId == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "请先选择一个项目");
            return;
        }
        
        currentTestCase = new ProjectCaseDto 
        { 
            ProjectId = selectedProjectId,
            CategoryId = selectedCategoryId == 0 ? (long?)null : selectedCategoryId
        };
        isEditingBasicInfo = false;
        showBasicInfoModal = true;
    }

    private async Task DeleteTestCase(long id)
    {
        await ProjectCaseService.DeleteAsync(id);
        await LoadProjectData();
    }

    private async Task CopyTestCase(ProjectCaseDto testCase)
    {
        try
        {
            var copiedId = await ProjectCaseService.CopyAsync(testCase.Id);
            await JSRuntime.InvokeVoidAsync("alert", $"测试用例 '{testCase.Name}' 复制成功！");
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"复制失败: {ex.Message}");
        }
    }

    private void ShowTemplateSettingsModal(ProjectCaseDto testCase)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(testCase);
        editingTestCase = System.Text.Json.JsonSerializer.Deserialize<ProjectCaseDto>(json)!;
        availableTemplates = testCases.Where(c => c.IsTemplate && c.Id != editingTestCase.Id).ToList();
        showTemplateSettingsModal = true;
    }

    private void HideTemplateSettingsModal()
    {
        showTemplateSettingsModal = false;
    }

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        editingTestCase.TemplateId = string.IsNullOrEmpty(val) ? null : (long.TryParse(val, out var v) ? v : null);
    }

    private async Task SaveTemplateSettings()
    {
        try
        {
            if (editingTestCase.TemplateId.HasValue)
            {
                editingTestCase.Steps.Clear();
            }

            await ProjectCaseService.UpdateAsync(editingTestCase.Id, editingTestCase);
            await LoadProjectData();
            showTemplateSettingsModal = false;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }

    private void ShowAddCategoryModal()
    {
        currentCategory = new ProjectCaseCategory { ProjectId = selectedProjectId };
        isEditingCategory = false;
        showCategoryModal = true;
    }

    private void ShowEditCategoryModal(ProjectCaseCategory category)
    {
        currentCategory = new ProjectCaseCategory
        {
            Id = category.Id,
            Name = category.Name,
            ProjectId = category.ProjectId,
            ParentId = category.ParentId,
            Order = category.Order,
            Childrens = category.Childrens
        };
        isEditingCategory = true;
        showCategoryModal = true;
    }

    private void HideCategoryModal()
    {
        showCategoryModal = false;
        currentCategory = new ProjectCaseCategory();
        isEditingCategory = false;
    }

    private async Task SaveCategory()
    {
        try
        {
            if (isEditingCategory)
            {
                await ProjectCaseCategoryAppService.UpdateAsync(currentCategory.Id, currentCategory);
            }
            else
            {
                await ProjectCaseCategoryAppService.CreateAsync(currentCategory);
            }
            
            categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            HideCategoryModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }

    private List<ProjectCaseCategory> GetAvailableParentCategories()
    {
        if (!isEditingCategory)
        {
            return categories.OrderBy(c => c.Order).ToList();
        }

        var excludeIds = new HashSet<long> { currentCategory.Id };
        AddChildCategoryIds(currentCategory.Id, excludeIds);
        return FilterCategoryTree(categories, excludeIds);
    }

    private List<ProjectCaseCategory> FilterCategoryTree(IEnumerable<ProjectCaseCategory> nodes, HashSet<long> excludeIds)
    {
        var result = new List<ProjectCaseCategory>();
        foreach (var node in nodes.OrderBy(c => c.Order))
        {
            if (excludeIds.Contains(node.Id))
            {
                continue;
            }

            result.Add(new ProjectCaseCategory
            {
                Id = node.Id,
                Name = node.Name,
                Description = node.Description,
                ProjectId = node.ProjectId,
                ParentId = node.ParentId,
                Order = node.Order,
                Childrens = FilterCategoryTree(node.Childrens ?? [], excludeIds).ToArray()
            });
        }
        return result;
    }

    private void AddChildCategoryIds(long categoryId, HashSet<long> excludeIds)
    {
        var category = FindCategoryInTree(categoryId, categories);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                excludeIds.Add(child.Id);
                AddChildCategoryIds(child.Id, excludeIds);
            }
        }
    }

    private void AddChildCategory(ProjectCaseCategory parentCategory)
    {
        currentCategory = new ProjectCaseCategory 
        { 
            ProjectId = selectedProjectId
        };
        
        if (parentCategory.Childrens == null)
        {
            parentCategory.Childrens = Array.Empty<ProjectCaseCategory>();
        }
        
        isEditingCategory = false;
        showCategoryModal = true;
    }
    
    private void ToggleCategoryExpand(long categoryId)
    {
        if (expandedCategories.Contains(categoryId))
        {
            expandedCategories.Remove(categoryId);
        }
        else
        {
            expandedCategories.Add(categoryId);
        }
        StateHasChanged();
    }

    private async Task DeleteCategory(long categoryId)
    {
        await DeleteChildCategories(categoryId);
        await ProjectCaseCategoryAppService.DeleteAsync(selectedProjectId, categoryId);
        categories = await ProjectCaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
        StateHasChanged();
    }

    private async Task DeleteChildCategories(long categoryId)
    {
        var category = FindCategoryInTree(categoryId, categories);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                await DeleteChildCategories(child.Id);
                await ProjectCaseCategoryAppService.DeleteAsync(selectedProjectId, child.Id);
            }
        }
    }

    private void ShowEditBasicInfoModal(ProjectCaseDto testCase)
    {
        currentTestCase = new ProjectCaseDto
        {
            Id = testCase.Id,
            CaseNumber = testCase.CaseNumber,
            Name = testCase.Name,
            Description = testCase.Description,
            ProjectId = testCase.ProjectId,
            CategoryId = testCase.CategoryId,
            Levels = new List<string>(testCase.Levels),
            Order = testCase.Order,
            Status = testCase.Status,
            Tags = new List<string>(testCase.Tags),
            Steps = testCase.Steps,
            CreatedAt = testCase.CreatedAt,
            CreatedBy = testCase.CreatedBy
        };
        
        isEditingBasicInfo = true;
        showBasicInfoModal = true;
    }
    
    private void EditTestCaseSteps(ProjectCaseDto testCase)
    {
        Navigation.NavigateTo($"/testing/project-cases/{testCase.Id}/steps");
    }
    
    private Task HideBasicInfoModal()
    {
        showBasicInfoModal = false;
        currentTestCase = new ProjectCaseDto();
        isEditingBasicInfo = false;
        return Task.CompletedTask;
    }
    
    private async Task SaveBasicInfo(ProjectCaseDto testCase)
    {
        try
        {
            if (isEditingBasicInfo)
            {
                await ProjectCaseService.UpdateAsync(testCase.Id, testCase);
                await JSRuntime.InvokeVoidAsync("alert", "测试用例基本信息更新成功！");
            }
            else
            {
                await ProjectCaseService.CreateAsync(testCase);
                await JSRuntime.InvokeVoidAsync("alert", "测试用例创建成功！");
                Navigation.NavigateTo($"/testing/project-cases/{testCase.Id}/steps");
                return;
            }
            
            await HideBasicInfoModal();
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }
    
    private async Task SaveBasicInfoOnly(ProjectCaseDto testCase)
    {
        try
        {
            await ProjectCaseService.CreateAsync(testCase);
            await JSRuntime.InvokeVoidAsync("alert", "测试用例保存成功！");
            
            await HideBasicInfoModal();
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }
    
