@page "/testing/project-cases"
@page "/testing/project-cases/{ProjectId:long}"

@namespace H.Testing.Web
@layout TestingLayout

<link href="_content/H.Testing.Web/css/category-tree.css" rel="stylesheet" />

@inject IProjectAppService ProjectService
@inject ICaseCategoryAppService CaseCategoryAppService
@inject ICaseAppService ProjectCaseService
@inject IAiGenerateAppService TestingAiService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>测试用例</PageTitle>

<div class="cases-page">
<div class="page-fill" style="flex-shrink: 0; padding: 12px 16px;">
    <div style="display: flex; gap: 16px; align-items: center;">
        <div style="flex: 0 0 25%;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>选择项目:</span>
                <select class="h-select" style="width: 200px;" value="@selectedProjectId" @onchange="@(async e => await OnProjectChanged(e.Value?.ToString() ?? ""))">
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </div>
        </div>
        
        <div style="flex: 1;">
            <div style="display: flex; justify-content: space-around;">
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #165DFF; font-weight: 500;">@filteredTestCases.Count</div>
                    <div style="color: #86909C; font-size: 12px;">总用例</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #F53F3F; font-weight: 500;">@filteredTestCases.Count(tc => tc.Level == CaseLevel.P0)</div>
                    <div style="color: #86909C; font-size: 12px;">P0级别</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #FF7D00; font-weight: 500;">@filteredTestCases.Count(tc => tc.Level == CaseLevel.P1)</div>
                    <div style="color: #86909C; font-size: 12px;">P1级别</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 24px; color: #00B42A; font-weight: 500;">@selectedTestCases.Count</div>
                    <div style="color: #86909C; font-size: 12px;">已选中</div>
                </div>
            </div>
        </div>
        
        <div style="flex: 0 0 25%;">
            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button class="h-btn" 
                        style="background-color: #00B42A; border-color: #00B42A; color: white;"
                        @onclick="ExecuteSelectedTests" 
                        disabled="@(!selectedTestCases.Any() || selectedProjectId == 0)">
                    ▶ 执行选中
                </button>
                <button class="h-btn"
                        style="background-color: #722ED1; border-color: #722ED1; color: #fff;"
                        @onclick="ShowAiModal"
                        disabled="@(selectedProjectId == 0 || aiGenerating)">
                    ✨ AI 生成
                </button>
                <button class="h-btn h-btn-primary" @onclick="CreateNewTestCase">
                    ➕ 新建用例
                </button>
            </div>
        </div>
    </div>
</div>

<div class="cases-body">
        <div class="cases-tree-panel">
            <HCard>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <span style="font-weight: 500;">📁 分类</span>
                    <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowAddCategoryModal">➕</button>
                </div>
                <div class="cases-scroll">
                    <button class="tree-node-row py-2 @(selectedCategoryId == 0 ? "selected" : "")"
                            @onclick="() => SelectCategory(null)" 
                            style="cursor: pointer; width: 100%; border: none; border-radius: 4px;">
                        <span class="tree-node-expand-icon placeholder" style="width: 8px;"></span>
                        <span class="tree-node-title">全部 (@testCases.Count)</span>
                    </button>
                    <CategoryTree Categories="categories"
                                 SelectedCategoryId="selectedCategoryId"
                                 OnCategorySelected="SelectCategory"
                                 OnAddChild="ShowAddChildCategoryModal"
                                 OnEdit="ShowEditCategoryModal"
                                 OnDelete="HandleDeleteCategory"
                                 TestCaseCounts="categoryTestCaseCounts" />
                </div>
            </HCard>
        </div>

        <div class="cases-list-panel">
            <HCard>
                <div style="margin-bottom: 12px;">
                    <input class="h-input" Placeholder="搜索用例..."
                                     @bind-value="searchTerm" @bind-value:event="oninput"
                                     Style="width: 300px;" />
                </div>

                <div class="cases-scroll">
                    @if (loading)
                    {
                        <div style="text-align: center; padding: 40px;">
                            <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
                        </div>
                    }
                    else if (displayTestCases.Any())
                    {
                        <HTable>
                            <thead>
                                <tr>
                                    <th style="width: 100px;">用例编号</th>
                                    <th>用例名称</th>
                                    <th style="width: 120px;">级别</th>
                                    <th style="width: 100px;">上次执行</th>
                                    <th style="width: 180px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var context in displayTestCases)
                                {
                                    <tr>
                                        <td>
                                            <span style="color: #86909C;">@context.Id</span>
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@context.Name</strong>
                                                @if (context.IsTemplate)
                                                {
                                                    <span class="h-tag h-tag-blue" style="margin-left: 8px;">模板</span>
                                                }
                                                @if (context.TemplateId.HasValue)
                                                {
                                                    <span class="h-tag h-tag-default" style="margin-left: 4px;">继承</span>
                                                }
                                                @if (!string.IsNullOrEmpty(context.Description))
                                                {
                                                    <div style="color: #86909C; font-size: 12px; margin-top: 4px;">@context.Description</div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="h-tag h-tag-@GetLevelTagClass(context.Level.ToString())">@context.Level</span>
                                        </td>
                                        <td>
                                            @if (context.LastExecutionResult.HasValue)
                                            {
                                                <span class="h-tag h-tag-@GetExecutionResultTagClass(context.LastExecutionResult.Value)">
                                                    @GetExecutionResultText(context.LastExecutionResult.Value)
                                                </span>
                                                @if (context.LastExecutionTime.HasValue)
                                                {
                                                    <div style="color: #86909C; font-size: 12px; margin-top: 4px;">@context.LastExecutionTime.Value.ToString("MM-dd HH:mm")</div>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #86909C;">未执行</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="row-actions">
                                                <a class="link-action" style="color: #00B42A;" @onclick="() => ExecuteSingleTest(context)">执行</a>
                                                <a class="link-action" @onclick="() => EditTestCaseSteps(context)">测试步骤</a>
                                                <a class="link-action link-action-muted" @onclick="e => ToggleTestCaseDropdown(context.Id, e)">更多 ▾</a>
                                                @if (openTestCaseDropdownId == context.Id)
                                                {
                                                    <div class="h-dropdown-mask" @onclick="() => openTestCaseDropdownId = null"></div>
                                                    <div class="h-dropdown-panel h-dropdown-panel-fixed" style="@GetDropdownPanelStyle()">
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ShowTemplateSettingsModal(context); }">模板设置</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ViewExecutionHistory(context); }">测试报告</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; CopyTestCase(context); }">复制</div>
                                                        <div class="h-dropdown-item" @onclick="() => { openTestCaseDropdownId = null; ShowEditBasicInfoModal(context); }">编辑</div>
                                                        <div class="h-dropdown-divider"></div>
                                                        <div class="h-dropdown-item danger" @onclick="() => { openTestCaseDropdownId = null; DeleteTestCase(context.Id); }">删除</div>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </HTable>
                    }
                    else
                    {
                        <div class="h-empty">暂无测试用例数据</div>
                    }
                </div>
            </HCard>
        </div>
    </div>
</div>

@{
    var categoryModalTitle = isEditingCategory ? "编辑分类" : "新建分类";
}
<HModal Visible="showCategoryModal" 
        Title="@categoryModalTitle" 
        OnOk="SaveCategory" 
        OnCancel="HideCategoryModal"
        Style="width: 600px;">
    <EditForm Model="currentCategory" OnValidSubmit="SaveCategory">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">分类名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentCategory.Name" />
                <ValidationMessage For="() => currentCategory.Name" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">父级分类</label>
            <div class="h-form-control" style="flex: 1;">
                <TreeSelectDropdown Categories="GetAvailableParentCategories()" 
                                   SelectedValue="currentCategory.ParentId" 
                                   SelectedValueChanged="@(v => currentCategory.ParentId = v)"
                                   EmptyOptionText="无(根分类)" 
                                   Placeholder="请选择父级分类" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">排序</label>
            <div class="h-form-control" style="flex: 1;">
                <Microsoft.AspNetCore.Components.Forms.InputNumber class="h-input" @bind-Value="currentCategory.Order" />
            </div>
        </div>
    </EditForm>
</HModal>

<HModal Visible="showTemplateSettingsModal" 
        Title="@($"模板设置 - {editingTestCase.Name}")" 
        OnOk="SaveTemplateSettings" 
        OnCancel="HideTemplateSettingsModal"
        Style="width: 600px;">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px;">
            <label class="h-switch">
                <input type="checkbox" @bind="editingTestCase.IsTemplate" />
                <span class="h-switch-slider"></span>
            </label>
            <span Style="margin-left: 8px;">设为测试模板</span>
            <div Style="color: #86909C; font-size: 12px; margin-top: 4px;">将此用例设为模板，供其他用例继承。</div>
        </div>
        
        @if (!editingTestCase.IsTemplate)
        {
            <div Style="margin-bottom: 16px;">
                <label Style="display: block; margin-bottom: 8px;">继承模板</label>
                <select class="h-select" style="width: 100%;" value="@(editingTestCase.TemplateId?.ToString() ?? "")" @onchange="OnTemplateChanged">
                    <option value="">无(独立用例)</option>
                    @foreach (var template in availableTemplates)
                    {
                        <option value="@template.Id">@(template.Name + $"({template.Id})")</option>
                    }
                </select>
                <div Style="color: #86909C; font-size: 12px; margin-top: 4px;">
                    选择模板后，此用例将自动使用模板中的步骤。您只需在此处维护测试数据。
                    <br>
                    <span Style="color: #F53F3F;">注意：继承模板后，当前用例的步骤将被覆盖且不可编辑。</span>
                </div>
            </div>
        }
    </div>
</HModal>

<HModal Visible="showAiModal" Title="✨ AI 新增/修改分类与用例" OnCancel="HideAiModal" ShowFooter="false" Style="width: 800px;">
    @if (aiPlan == null)
    {
        <div Style="padding: 8px 0;">
            <label Style="display: block; margin-bottom: 8px; font-weight: 500;">用口语描述你想新增或修改的内容</label>
            <textarea class="h-textarea" rows="6" @bind="aiDescription" disabled="@aiGenerating"
                      placeholder="例如：在登录模块下加一个异常场景分类，补充密码错误和账号锁定两个用例；把支付分类的名字改成订单支付"></textarea>
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
            <div Style="color: #86909C; font-size: 12px; margin-top: 8px;">AI 将基于当前项目的分类、用例与知识库内容生成变更计划，预览确认后生效。</div>
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="HideAiModal" Style="margin-right: 8px;">取消</button>
            <button class="h-btn" style="background-color: #722ED1; border-color: #722ED1; color: #fff;" @onclick="GenerateAiPlan" disabled="@aiGenerating">
                @(aiGenerating ? "⏳ AI 生成中..." : "✨ 生成")
            </button>
        </div>
    }
    else
    {
        <div Style="padding: 8px 0; max-height: 480px; overflow-y: auto;">
            @if (!aiPlan.AddCategories.Any() && !aiPlan.UpdateCategories.Any() && !aiPlan.AddCases.Any() && !aiPlan.UpdateCases.Any())
            {
                <div Style="text-align: center; color: #86909C; padding: 24px;">AI 判断无需变更，请补充需求描述后重试</div>
            }
            @if (aiPlan.AddCategories.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">📁 新增分类</div>
                    @foreach (var cat in aiPlan.AddCategories)
                    {
                        <div Style="padding-left: 16px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            @cat.Name <span Style="color: #86909C;">(父分类：@GetAiRefName(cat.ParentRef))</span>
                            @if (!string.IsNullOrEmpty(cat.Description))
                            {
                                <div Style="color: #86909C; font-size: 12px;">@cat.Description</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (aiPlan.UpdateCategories.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">✏️ 修改分类</div>
                    @foreach (var cat in aiPlan.UpdateCategories)
                    {
                        <div Style="padding-left: 16px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            @GetAiCategoryName(cat.Id)
                            @if (!string.IsNullOrEmpty(cat.Name)) { <span>→ @cat.Name</span> }
                            @if (!string.IsNullOrEmpty(cat.Description)) { <div Style="color: #86909C; font-size: 12px;">描述：@cat.Description</div> }
                        </div>
                    }
                </div>
            }
            @if (aiPlan.AddCases.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">📝 新增用例</div>
                    @foreach (var aiCase in aiPlan.AddCases)
                    {
                        <div Style="padding-left: 16px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            @aiCase.Name
                            <span Style="color: #86909C;">(分类：@GetAiRefName(aiCase.CategoryRef))</span>
                            @if (!string.IsNullOrEmpty(aiCase.Level))
                            {
                                <span class="h-tag h-tag-blue" style="margin-left: 4px;">@aiCase.Level</span>
                            }
                            @if (!string.IsNullOrEmpty(aiCase.Description))
                            {
                                <div Style="color: #86909C; font-size: 12px;">@aiCase.Description</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (aiPlan.UpdateCases.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">✏️ 修改用例</div>
                    @foreach (var aiCase in aiPlan.UpdateCases)
                    {
                        <div Style="padding-left: 16px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            @GetAiCaseName(aiCase.Id)
                            @if (!string.IsNullOrEmpty(aiCase.Name)) { <span>→ @aiCase.Name</span> }
                            @if (!string.IsNullOrEmpty(aiCase.Level))
                            {
                                <span class="h-tag h-tag-blue" style="margin-left: 4px;">@aiCase.Level</span>
                            }
                            @if (!string.IsNullOrEmpty(aiCase.Description))
                            {
                                <div Style="color: #86909C; font-size: 12px;">描述：@aiCase.Description</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="BackToAiInput" Style="margin-right: 8px;" disabled="@aiApplying">返回修改</button>
            <button class="h-btn h-btn-primary" @onclick="ConfirmApplyAiPlan" disabled="@aiApplying">@(aiApplying ? "⏳ 应用中..." : "确认应用")</button>
        </div>
    }
</HModal>

<ProjectCaseBasicInfoModal ShowModal="showBasicInfoModal" 
                        CurrentTestCase="currentTestCase" 
                        Categories="categories" 
                        IsEditing="isEditingBasicInfo" 
                        OnClose="HideBasicInfoModal" 
                        OnSave="SaveBasicInfo" 
                        OnSaveOnly="SaveBasicInfoOnly" />

@code {
    private List<ProjectDto> projects = new();
    private List<CaseDto> testCases = new();
    private List<CaseDto> filteredTestCases = new();
    private List<CaseDto> displayTestCases = new();
    private List<CaseCategoryDto> categories = new();
    private HashSet<long> selectedTestCases = new();

    private CaseDto currentTestCase = new();
    private CaseDto editingTestCase = new();
    private CaseCategoryDto currentCategory = new();

    private bool loading = true;
    private bool showCategoryModal = false;
    private bool showTemplateSettingsModal = false;
    private List<CaseDto> availableTemplates = new();
    private bool isEditingCategory = false;

    [Parameter]
    public long? ProjectId { get; set; }

    private long selectedProjectId = 0;
    private long selectedCategoryId = 0;
    private string searchTerm = "";
    private long? openTestCaseDropdownId = null;
    private (double X, double Y) testCaseDropdownPosition;

    private bool showBasicInfoModal = false;
    private bool isEditingBasicInfo = false;

    private HashSet<long> expandedCategories = new();

    private Dictionary<long, int> categoryTestCaseCounts = new();

    // === AI 生成 ===
    private bool showAiModal = false;
    private string aiDescription = "";
    private bool aiGenerating = false;
    private bool aiApplying = false;
    private string? aiError;
    private AiModificationPlanDto? aiPlan;

    private void ShowAiModal()
    {
        if (selectedProjectId == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "请先选择一个项目");
            return;
        }

        aiDescription = "";
        aiPlan = null;
        aiError = null;
        showAiModal = true;
    }

    private void HideAiModal() { showAiModal = false; }

    private void BackToAiInput() { aiPlan = null; aiError = null; }

    private async Task GenerateAiPlan()
    {
        if (string.IsNullOrWhiteSpace(aiDescription))
        {
            aiError = "请输入需求描述";
            return;
        }

        aiGenerating = true;
        aiError = null;
        StateHasChanged();

        try
        {
            aiPlan = await TestingAiService.GenerateModificationAsync(selectedProjectId, new AiGenerateInputDto { Description = aiDescription });
        }
        catch (Exception ex)
        {
            aiError = $"生成失败: {ex.Message}";
        }
        finally
        {
            aiGenerating = false;
        }
    }

    private async Task ConfirmApplyAiPlan()
    {
        if (aiPlan == null) return;

        aiApplying = true;
        aiError = null;
        StateHasChanged();

        try
        {
            await TestingAiService.ApplyModificationAsync(selectedProjectId, aiPlan);
            showAiModal = false;
            await LoadProjectData();
        }
        catch (Exception ex)
        {
            aiError = $"应用失败: {ex.Message}";
        }
        finally
        {
            aiApplying = false;
        }
    }

    /// <summary>
    /// 解析分类引用名称：新增分类的 TempId 或已有分类 ID
    /// </summary>
    private string GetAiRefName(string? reference)
    {
        if (string.IsNullOrWhiteSpace(reference)) return "无";

        var newCategory = aiPlan?.AddCategories.FirstOrDefault(c => c.TempId == reference);
        if (newCategory != null) return $"{newCategory.Name}(新增)";

        if (long.TryParse(reference, out var id))
        {
            var existing = FlattenCategories(categories).FirstOrDefault(c => c.Id == id);
            if (existing != null) return existing.Name;
        }

        return reference;
    }

    private string GetAiCategoryName(long id) => FlattenCategories(categories).FirstOrDefault(c => c.Id == id)?.Name ?? id.ToString();

    private string GetAiCaseName(long id) => testCases.FirstOrDefault(c => c.Id == id)?.Name ?? id.ToString();

    private void ToggleTestCaseDropdown(long testCaseId, MouseEventArgs e)
    {
        if (openTestCaseDropdownId == testCaseId)
        {
            openTestCaseDropdownId = null;
            return;
        }

        testCaseDropdownPosition = (e.ClientX, e.ClientY);
        openTestCaseDropdownId = testCaseId;
    }

    // 面板用 fixed 定位脱离表格滚动容器, 避免展开时计入滚动溢出导致出现滚动条;
    // 右对齐到点击位置, 并限制最大高度防止超出视口底部
    private string GetDropdownPanelStyle()
    {
        var (x, y) = testCaseDropdownPosition;
        var top = y + 4;
        return FormattableString.Invariant(
            $"left: {x}px; top: {top}px; transform: translateX(-100%); max-height: calc(100vh - {top}px - 8px); overflow-y: auto;");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();

        if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
        {
            selectedProjectId = ProjectId.Value;
        }
        else if (projects.Any())
        {
            selectedProjectId = projects.First().Id;
        }
        else
        {
            selectedProjectId = 0;
        }

        await LoadProjectData();

        loading = false;
        StateHasChanged();
    }

    private async Task LoadProjectData()
    {
        if (selectedProjectId != 0)
        {
            categories = await CaseCategoryAppService.GetByProjectIdAsync(selectedProjectId);
            testCases = await ProjectCaseService.GetByProjectIdAsync(selectedProjectId);

            filteredTestCases = testCases;
            CalculateCategoryTestCaseCounts();
            FilterTestCases();
        }
        else
        {
            categories = new List<CaseCategoryDto>();
            filteredTestCases.Clear();
            displayTestCases.Clear();
            categoryTestCaseCounts.Clear();
        }

        selectedTestCases.Clear();
        StateHasChanged();
    }

    private async Task OnProjectChanged(string? projectIdStr)
    {
        if (string.IsNullOrEmpty(projectIdStr) || !long.TryParse(projectIdStr, out var projectId))
        {
            return;
        }

        if (projectId == selectedProjectId)
        {
            return;
        }

        selectedProjectId = projectId;
        selectedCategoryId = 0;

        await LoadProjectData();
        StateHasChanged();
    }

    private async Task SelectCategory(long? categoryId)
    {
        selectedCategoryId = categoryId ?? 0;
        
        if (selectedProjectId != 0)
        {
            if (selectedCategoryId == 0)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"selectedCategoryId_{selectedProjectId}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"selectedCategoryId_{selectedProjectId}", selectedCategoryId.ToString());
            }
        }
        
        FilterTestCases();
        StateHasChanged();
    }

    private void FilterTestCases()
    {
        displayTestCases = filteredTestCases.Where(tc =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                               tc.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               tc.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            
            var matchesCategory = selectedCategoryId == 0 ||
                                 (tc.CategoryId.HasValue && GetAllCategoryIds(selectedCategoryId).Contains(tc.CategoryId.Value));
            
            return matchesSearch && matchesCategory;
        })
        .OrderBy(tc => tc.Id)
        .ThenBy(tc => tc.Order)
        .ToList();
        
        StateHasChanged();
    }
    
    private HashSet<long> GetAllCategoryIds(long categoryId)
    {
        var categoryIds = new HashSet<long> { categoryId };
        AddAllChildCategoryIds(categoryId, categoryIds);
        return categoryIds;
    }
    
    private void AddAllChildCategoryIds(long categoryId, HashSet<long> categoryIds)
    {
        var category = FindCategoryInTree(categoryId, categories);
        if (category?.Childrens != null)
        {
            foreach (var child in category.Childrens)
            {
                categoryIds.Add(child.Id);
                AddAllChildCategoryIds(child.Id, categoryIds);
            }
        }
    }

    private CaseCategoryDto? FindCategoryInTree(long id, IEnumerable<CaseCategoryDto> nodes)
    {
        foreach (var n in nodes)
        {
            if (n.Id == id) return n;
            if (n.Childrens is { Length: > 0 })
            {
                var hit = FindCategoryInTree(id, n.Childrens);
                if (hit != null) return hit;
            }
        }
        return null;
    }

    private IEnumerable<CaseCategoryDto> FlattenCategories(IEnumerable<CaseCategoryDto> nodes)
    {
        foreach (var n in nodes)
        {
            yield return n;
            if (n.Childrens is { Length: > 0 })
            {
                foreach (var c in FlattenCategories(n.Childrens))
                {
                    yield return c;
                }
            }
        }
    }
    
    private List<CaseCategoryDto> GetRootCategories()
    {
        return categories.OrderBy(c => c.Order).ToList();
    }
    


    private void CalculateCategoryTestCaseCounts()
    {
        categoryTestCaseCounts.Clear();
        
        foreach (var category in FlattenCategories(categories))
        {
            var categoryIds = GetAllCategoryIds(category.Id);
            var count = testCases.Count(tc => tc.CategoryId.HasValue && categoryIds.Contains(tc.CategoryId.Value));
            categoryTestCaseCounts[category.Id] = count;
        }
    }

