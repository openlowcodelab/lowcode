@page "/testing"

@namespace H.Testing.Web
@layout TestingLayout
@inject IProjectAppService ProjectService
@inject IProjectCaseAppService ProjectCaseService
@inject NavigationManager NavigationManager

<PageTitle>自动化测试</PageTitle>

<div style="display: flex; gap: 16px; margin-bottom: 20px;">
    <div style="flex: 1;">
        <HCard>
            <div style="text-align: center; padding: 16px;">
                <span style="font-size: 24px;">📁</span>
                <div style="font-size: 28px; font-weight: 600; color: #1890ff; margin: 8px 0;">@projectCount</div>
                <div style="color: #999;">项目数量</div>
            </div>
        </HCard>
    </div>
    <div style="flex: 1;">
        <HCard>
            <div style="text-align: center; padding: 16px;">
                <span style="font-size: 24px;">📋</span>
                <div style="font-size: 28px; font-weight: 600; color: #1890ff; margin: 8px 0;">@projectCaseCount</div>
                <div style="color: #999;">测试用例</div>
            </div>
        </HCard>
    </div>
</div>

<div style="display: flex; gap: 16px;">
    <div style="flex: 1;">
        <div @onclick="@(() => NavigationManager.NavigateTo("/testing/projects"))" style="cursor: pointer;">
            <HCard Title="📁 项目管理">
                <div style="text-align: center;">
                    <div Style="font-size: 48px; margin: 20px 0;">📁</div>
                    <p>管理项目、配置项目环境</p>
                </div>
            </HCard>
        </div>
    </div>
    <div style="flex: 1;">
        <div @onclick="@(() => NavigationManager.NavigateTo("/testing/project-cases"))" style="cursor: pointer;">
            <HCard Title="📋 测试用例">
                <div style="text-align: center;">
                    <div Style="font-size: 48px; margin: 20px 0;">📋</div>
                    <p>设计和管理 API 和 UI 测试用例</p>
                </div>
            </HCard>
        </div>
    </div>
</div>

@code {
    private int projectCount = 0;
    private int projectCaseCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // 加载各种统计数据
            var projects = await ProjectService.GetAllAsync();
            projectCount = projects.Count;

            var projectCases = await ProjectCaseService.GetAllAsync();
            projectCaseCount = projectCases.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载数据失败: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }
}
