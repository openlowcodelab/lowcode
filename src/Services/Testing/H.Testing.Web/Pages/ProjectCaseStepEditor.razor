    // 断言配置验证方法
    private bool ValidateAssertion(ApiAssertion assertion, out string errorMessage)
    {
        errorMessage = string.Empty;
        
        // 验证断言类型
        if (string.IsNullOrWhiteSpace(assertion.Type))
        {
            errorMessage = "断言类型不能为空";
            return false;
        }
        
        // 验证期望值
        if (string.IsNullOrWhiteSpace(assertion.ExpectedValue))
        {
            errorMessage = "期望值不能为空";
            return false;
        }
        
        // 根据断言类型进行特定验证
        switch (assertion.Type)
        {
            case "status_code":
                if (!int.TryParse(assertion.ExpectedValue, out var statusCode) || statusCode < 100 || statusCode > 599)
                {
                    errorMessage = "状态码必须是100-599之间的整数";
                    return false;
                }
                break;
                
            case "response_time":
                if (!int.TryParse(assertion.ExpectedValue, out var responseTime) || responseTime <= 0)
                {
                    errorMessage = "响应时间必须是大于0的整数（毫秒）";
                    return false;
                }
                break;
                
            case "json_path":
                if (string.IsNullOrWhiteSpace(assertion.Target))
                {
                    errorMessage = "JSON路径不能为空";
                    return false;
                }
                if (!assertion.Target.StartsWith("$"))
                {
                    errorMessage = "JSON路径必须以$开头";
                    return false;
                }
                break;
                
            case "header":
                if (string.IsNullOrWhiteSpace(assertion.Target))
                {
                    errorMessage = "响应头名称不能为空";
                    return false;
                }
                break;
        }
        
        // 验证操作符
        var validOperators = new[] { "equals", "contains", "not_equals", "greater_than", "less_than", "startswith", "endswith" };
        if (!validOperators.Contains(assertion.Operator))
        {
            errorMessage = "无效的操作符";
            return false;
        }
        
        return true;
    }
    
    // 验证所有断言配置
    private bool ValidateAllAssertions(CaseStepDto step, out List<string> errorMessages)
    {
        errorMessages = new List<string>();
        
        if (step.ApiConfig?.Assertions == null || !step.ApiConfig.Assertions.Any())
        {
            return true; // 没有断言配置是允许的
        }
        
        for (int i = 0; i < step.ApiConfig.Assertions.Count; i++)
        {
            var assertion = step.ApiConfig.Assertions[i];
            if (!ValidateAssertion(assertion, out var errorMessage))
            {
                errorMessages.Add($"断言 {i + 1}: {errorMessage}");
            }
        }
        
        return !errorMessages.Any();
    }
    
    // 变量提取操作
    private void AddVariableExtraction(CaseStepDto step)
    {
        if (!string.IsNullOrWhiteSpace(newVariableName) && !string.IsNullOrWhiteSpace(newVariablePath))
        {
            step.ApiConfig.VariableExtractions[newVariableName] = newVariablePath;
            newVariableName = "";
            newVariablePath = "";
            StateHasChanged();
        }
    }
    
    private void RemoveVariableExtraction(CaseStepDto step, string variableName)
    {
        if (step.ApiConfig.VariableExtractions.ContainsKey(variableName))
        {
            step.ApiConfig.VariableExtractions.Remove(variableName);
            StateHasChanged();
        }
    }
    
    private void UpdateVariableExtraction(CaseStepDto step, string oldName, string newName, string newPath)
    {
        if (step.ApiConfig.VariableExtractions.ContainsKey(oldName))
        {
            step.ApiConfig.VariableExtractions.Remove(oldName);
        }
        if (!string.IsNullOrWhiteSpace(newName) && !string.IsNullOrWhiteSpace(newPath))
        {
            step.ApiConfig.VariableExtractions[newName] = newPath;
        }
        StateHasChanged();
    }
    
    private void ParseVariableExtractions(ApiStepConfig config, string extractionsText)
    {
        config.VariableExtractions.Clear();
        if (string.IsNullOrWhiteSpace(extractionsText)) return;
        
        var lines = extractionsText.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            var parts = line.Split('=', 2, StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                config.VariableExtractions[parts[0]] = parts[1];
            }
        }
    }
}

