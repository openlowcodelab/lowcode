<!-- Playwright 录制模态框 -->
<Testing.Components.PlaywrightRecorderModal 
    ShowModal="@showRecorderModal" 
    OnHide="@HideRecorderModal"
    OnStepsGenerated="@OnRecordedStepsGenerated" />

@code {
    private bool showRecorderModal = false;

    private void ShowRecorderModal()
    {
        showRecorderModal = true;
        StateHasChanged();
    }

    private void HideRecorderModal()
    {
        showRecorderModal = false;
        StateHasChanged();
    }

    private async Task OnRecordedStepsGenerated(List<CaseStepDto> recordedSteps)
    {
        if (recordedSteps?.Any() == true)
        {
            // 获取当前最大的 Order 值
            int maxOrder = steps.Any() ? steps.Max(s => s.Order) : 0;
            
            // 为录制的步骤分配新的 Order 值
            foreach (var step in recordedSteps)
            {
                step.Order = ++maxOrder;
                steps.Add(step);
            }
            
            // 选中第一个新添加的步骤
            if (recordedSteps.Count > 0)
            {
                selectedStep = recordedSteps[0];
            }
            
            StateHasChanged();
            
            // 显示成功消息
            await JSRuntime.InvokeVoidAsync("alert", $"成功添加了 {recordedSteps.Count} 个录制步骤！");
        }
    }
}
