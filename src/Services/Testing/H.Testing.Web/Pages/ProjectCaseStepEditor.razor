@page "/testing/project-cases/{testCaseId:long}/steps"
@page "/testing/project-cases/new/{projectId:long}/steps"

@namespace H.Testing.Web
@layout TestingLayout

@inject ICaseAppService ProjectCaseService
@inject ICaseStepAppService CaseStepService
@inject IProjectAppService ProjectService
@inject ICaseCategoryAppService CategoryService
@inject IProjectServiceConfigAppService ProjectServiceConfigService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<style>
    .testing-step-editor .card { background: #fff; border: 1px solid #F2F3F5; border-radius: 6px; margin-bottom: 16px; }
    .testing-step-editor .card-header { padding: 10px 16px; background: #F7F8FA; border-bottom: 1px solid #F2F3F5; border-radius: 6px 6px 0 0; font-weight: 600; }
    .testing-step-editor .card-header h6 { margin: 0; font-size: 14px; }
    .testing-step-editor .card-body { padding: 16px; }
    .testing-step-editor .row { display: flex; flex-wrap: wrap; margin-left: -8px; margin-right: -8px; }
    .testing-step-editor .row > [class*="col-"] { padding-left: 8px; padding-right: 8px; box-sizing: border-box; }
    .testing-step-editor .col-md-1 { flex: 0 0 8.333%; max-width: 8.333%; }
    .testing-step-editor .col-md-2 { flex: 0 0 16.666%; max-width: 16.666%; }
    .testing-step-editor .col-md-3 { flex: 0 0 25%; max-width: 25%; }
    .testing-step-editor .col-md-4 { flex: 0 0 33.333%; max-width: 33.333%; }
    .testing-step-editor .col-md-6 { flex: 0 0 50%; max-width: 50%; }
    .testing-step-editor .col-md-7 { flex: 0 0 58.333%; max-width: 58.333%; }
    .testing-step-editor .form-label { display: block; margin-bottom: 4px; font-size: 13px; color: rgba(0,0,0,.85); }
    .testing-step-editor .form-control, .testing-step-editor .form-select { display: block; width: 100%; height: 32px; padding: 4px 11px; font-size: 14px; line-height: 1.5715; color: rgba(0,0,0,.85); background: #fff; border: 1px solid #E5E6EB; border-radius: 2px; box-sizing: border-box; transition: all .3s; }
    .testing-step-editor .form-control:focus, .testing-step-editor .form-select:focus { outline: none; border-color: #4080FF; box-shadow: 0 0 0 2px rgba(22,93,255,.2); }
    .testing-step-editor textarea.form-control { height: auto; min-height: 64px; }
    .testing-step-editor .form-control-sm, .testing-step-editor .form-select-sm { height: 28px; padding: 2px 8px; font-size: 12px; }
    .testing-step-editor .form-check { display: inline-flex; align-items: center; gap: 6px; }
    .testing-step-editor .form-check-input { width: 14px; height: 14px; margin: 0; }
    .testing-step-editor .form-check-label { font-size: 13px; }
    .testing-step-editor .btn { display: inline-flex; align-items: center; justify-content: center; padding: 4px 15px; height: 32px; font-size: 14px; line-height: 1.5715; border: 1px solid transparent; border-radius: 2px; cursor: pointer; transition: all .3s; white-space: nowrap; background: #fff; color: rgba(0,0,0,.85); border-color: #E5E6EB; }
    .testing-step-editor .btn:hover { color: #4080FF; border-color: #4080FF; }
    .testing-step-editor .btn-sm { height: 24px; padding: 0 7px; font-size: 12px; }
    .testing-step-editor .btn-outline-primary { color: #165DFF; border-color: #165DFF; }
    .testing-step-editor .btn-outline-primary:hover { background: #165DFF; color: #fff; }
    .testing-step-editor .btn-outline-danger { color: #F53F3F; border-color: #F53F3F; }
    .testing-step-editor .btn-outline-danger:hover { background: #F53F3F; color: #fff; }
    .testing-step-editor .nav-tabs { display: flex; list-style: none; padding: 0; margin: 0 0 16px 0; border-bottom: 1px solid #F2F3F5; gap: 2px; }
    .testing-step-editor .nav-tabs .nav-item { list-style: none; margin: 0; }
    .testing-step-editor .nav-tabs .nav-link { background: transparent; border: none; padding: 8px 16px; font-size: 14px; color: rgba(0,0,0,.65); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .testing-step-editor .nav-tabs .nav-link:hover { color: #4080FF; }
    .testing-step-editor .nav-tabs .nav-link.active { color: #165DFF; border-bottom-color: #165DFF; font-weight: 600; }
    .testing-step-editor .tab-content { padding-top: 8px; }
    .testing-step-editor .tab-pane { display: none; }
    .testing-step-editor .tab-pane.show.active { display: block; }
    .testing-step-editor .badge { display: inline-block; padding: 0 7px; font-size: 12px; line-height: 18px; color: #fff; border-radius: 10px; margin-left: 4px; }
    .testing-step-editor .bg-primary { background: #165DFF; }
    .testing-step-editor .bg-info { background: #13c2c2; }
    .testing-step-editor .bg-success { background: #00B42A; }
    .testing-step-editor .alert { padding: 8px 15px; border-radius: 2px; margin-bottom: 12px; font-size: 13px; }
    .testing-step-editor .alert-info { background: #E8F3FF; border: 1px solid #94BFFF; color: rgba(0,0,0,.85); }
    .testing-step-editor .table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .testing-step-editor .table th, .testing-step-editor .table td { padding: 8px 12px; border-bottom: 1px solid #F2F3F5; text-align: left; }
    .testing-step-editor .table thead th { background: #F7F8FA; font-weight: 600; }
    .testing-step-editor .table-sm th, .testing-step-editor .table-sm td { padding: 6px 10px; }
    .testing-step-editor .table-responsive { overflow-x: auto; }
    .testing-step-editor .text-muted { color: rgba(0,0,0,.45); }
    .testing-step-editor .small { font-size: 12px; }
    .testing-step-editor .border { border: 1px solid #F2F3F5; }
    .testing-step-editor .rounded { border-radius: 4px; }
    .testing-step-editor .p-3 { padding: 12px; }
    .testing-step-editor .mb-0 { margin-bottom: 0 !important; }
    .testing-step-editor .mb-2 { margin-bottom: 8px; }
    .testing-step-editor .mb-3 { margin-bottom: 12px; }
    .testing-step-editor .mt-3 { margin-top: 12px; }
    .testing-step-editor .ms-1 { margin-left: 4px; }
</style>

<div class="testing-step-editor" style="display: flex; gap: 2px; height: 100%;">
    <!-- 左侧：步骤列表 -->
    <div class="page-fill" style="width: 400px; height: 100%; overflow-y: auto; padding: 12px;">
        <div style="margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <div>
                    <div style="font-size: 15px; font-weight: 600; margin-bottom: 4px;">📋 测试步骤</div>
                    <small style="color: #86909C;">@(isNewTestCase ? "新建测试用例" : currentTestCase.Name)</small>
                </div>
                <button class="h-btn h-btn-sm" @onclick="GoBack">← 返回</button>
            </div>
            <span class="h-space" style="flex-wrap:wrap;justify-content:flex-end;width:100%;display:flex;">
                <button class="h-btn h-btn-sm h-btn-primary"
                        disabled="@(currentTestCase.TemplateId.HasValue)"
                        @onclick="AddStep">
                    ➕ 添加
                </button>
                <button class="h-btn h-btn-sm"
                        style="background-color:#00B42A;border-color:#00B42A;color:#fff;"
                        disabled="@(currentTestCase.TemplateId.HasValue)"
                        @onclick="ShowRecorderModal">
                    🎥 录制
                </button>
                <button class="h-btn h-btn-sm" @onclick="SaveTestCase">✓ 保存</button>
            </span>
        </div>

        @if (steps.Any())
        {
            <div>
                @foreach (var step in steps.OrderBy(s => s.Order))
                {
                    var isSelected = selectedStep?.Id == step.Id;
                    <div style="@($"padding: 10px 12px; border: 1px solid {(isSelected ? "#165DFF" : "#F2F3F5")}; border-radius: 4px; margin-bottom: 6px; cursor: pointer; background: {(isSelected ? "#E8F3FF" : "#fff")};")"
                         @onclick="() => SelectStep(step)">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                                    <span class="h-tag h-tag-default">@step.Order</span>
                                    <span style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@step.Name</span>
                                    @if (!step.IsEnabled)
                                    {
                                        <span class="h-tag h-tag-orange">禁用</span>
                                    }
                                </div>
                                <small style="color: #86909C;">@GetStepTypeDisplayName(step.Type)</small>
                            </div>
                            <span class="h-space">
                                <button class="h-btn h-btn-sm"
                                        disabled="@(step.Order <= 1 || currentTestCase.TemplateId.HasValue)"
                                        @onclick="@(async () => { await Task.CompletedTask; MoveStepUp(step); })"
                                        @onclick:stopPropagation>↑</button>
                                <button class="h-btn h-btn-sm"
                                        disabled="@(step.Order >= steps.Count || currentTestCase.TemplateId.HasValue)"
                                        @onclick="@(async () => { await Task.CompletedTask; MoveStepDown(step); })"
                                        @onclick:stopPropagation>↓</button>
                                <button class="h-btn h-btn-sm" style="color:#F53F3F;border-color:#F53F3F;"
                                        disabled="@(currentTestCase.TemplateId.HasValue)"
                                        @onclick="@(async () => { await Task.CompletedTask; DeleteStep(step.Id); })"
                                        @onclick:stopPropagation>🗑</button>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px 0;">
                <div class="h-empty">暂无测试步骤</div>
                <div style="color: #86909C; margin-top: 12px; margin-bottom: 12px;">点击上方按钮添加第一个测试步骤</div>
                <button class="h-btn h-btn-sm h-btn-primary" @onclick="AddStep">➕ 添加步骤</button>
            </div>
        }
    </div>

    <!-- 右侧：步骤详情编辑 -->
    <div class="page-fill" style="flex: 1; height: 100%; overflow-y: auto; padding: 8px;">
        @if (selectedStep != null)
        {
            <div style="padding: 12px;">
                <!-- 基本信息 -->
                <div style="margin-bottom:16px;">
                <HCard Title="基本信息">
                    <ChildContent>
                    <div style="display:flex;gap:16px;">
                        <div style="flex:2;">
                            <div style="margin-bottom: 12px;">
                                <div style="margin-bottom: 4px;">步骤名称 <span style="color: #F53F3F;">*</span></div>
                                <input class="h-input" @bind-value="selectedStep.Name" />
                            </div>
                        </div>
                        <div style="flex:1;">
                            <div style="margin-bottom: 12px;">
                                <div style="margin-bottom: 4px;">步骤类型</div>
                                <select class="h-select" style="width: 100%; height: 32px;"
                                        value="@selectedStep.Type" @onchange="OnStepTypeChanged">
                                    <optgroup label="API测试步骤">
                                        <option value="@StepType.HttpRequest">HTTP请求</option>
                                        <option value="@StepType.ApiAssertion">API断言</option>
                                        <option value="@StepType.VariableExtraction">变量提取</option>
                                    </optgroup>
                                    <optgroup label="UI测试步骤">
                                        <option value="@StepType.Navigate">页面导航</option>
                                        <option value="@StepType.Click">点击操作</option>
                                        <option value="@StepType.Input">输入文本</option>
                                        <option value="@StepType.Select">选择操作</option>
                                        <option value="@StepType.Wait">等待操作</option>
                                        <option value="@StepType.Assert">UI断言</option>
                                        <option value="@StepType.Screenshot">截图</option>
                                    </optgroup>
                                    <optgroup label="通用步骤">
                                        <option value="@StepType.Script">脚本执行</option>
                                        <option value="@StepType.Delay">延时等待</option>
                                        <option value="@StepType.SetVariable">设置变量</option>
                                    </optgroup>
                                    <optgroup label="脚本步骤">
                                        <option value="@StepType.JavascriptScript">JavaScript脚本</option>
                                        <option value="@StepType.CSharpScript">C#脚本</option>
                                    </optgroup>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="display:flex;gap:16px;">
                        <div style="flex:5;">
                            <div style="margin-bottom: 12px;">
                                <div style="margin-bottom: 4px;">期望结果</div>
                                <textarea class="h-textarea" rows="2" @bind="selectedStep.ExpectedResult" placeholder="描述此步骤的期望结果"></textarea>
                            </div>
                        </div>
                        <div style="flex:1;">
                            <div style="margin-bottom: 12px;">
                                <div style="margin-bottom: 4px;">启用状态</div>
                                <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                                    <input type="checkbox" @bind="selectedStep.IsEnabled" />
                                    @(selectedStep.IsEnabled ? "启用" : "禁用")
                                </label>
                            </div>
                        </div>
                    </div>
                    </ChildContent>
                </HCard>
                </div>

                <!-- 步骤配置 -->
                @if (selectedStep != null)
                {
                    @if (IsApiStep(selectedStep.Type))
                    {
                        @RenderApiStepConfig(selectedStep)
                    }
                    else if (IsUiStep(selectedStep.Type))
                    {
                        @RenderUiStepConfig(selectedStep)
                    }
                    else if (IsScriptStep(selectedStep.Type))
                    {
                        @RenderScriptStepConfig(selectedStep)
                    }
                    else
                    {
                        @RenderGeneralStepConfig(selectedStep)
                    }
                }
            </div>
        }
        else
        {
            <div style="display: flex; align-items: center; justify-content: center; min-height: 400px;">
                <div style="text-align: center;">
                    <div class="h-empty">请从左侧列表中选择一个步骤来编辑详情</div>
                    @if (!steps.Any())
                    {
                        <div style="margin-top: 16px;">
                            <button class="h-btn h-btn-primary" @onclick="AddStep">➕ 创建第一个步骤</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public long? TestCaseId { get; set; }
    [Parameter] public long? ProjectId { get; set; }
    
    private CaseDto currentTestCase = new();
    private CaseStepDto? selectedStep;
    private bool isNewTestCase = false;
    private List<H.Testing.Application.Contracts.ProjectServiceDto> projectServices = new();
    private string activeApiTab = "Params"; // 当前活动的API配置tab页
    
    // 用于存储新添加项的临时变量，确保切换tab时值不丢失
    private string newParamKey = "";
    private string newParamValue = "";
    private string newHeaderKey = "";
    private string newHeaderValue = "";
    private string newCookieKey = "";
    private string newCookieValue = "";
    private string newVariableName = "";
    private string newVariablePath = "";
    
    // 断言配置相关变量
    private string newAssertionType = "JsonPath";
    private string newAssertionTarget = "";
    private string newAssertionOperator = "equals";
    private string newAssertionExpectedValue = "";

    // 模板相关
    private List<CaseDto> availableTemplates = new();
    private bool showSettingsModal = false;

    // 当前用例的步骤列表（独立于用例基本信息存储）
    private List<CaseStepDto> steps = new();
    
    protected override async Task OnInitializedAsync()
    {
        if (TestCaseId.HasValue)
        {
            // 编辑现有测试用例
            var testCase = (await ProjectCaseService.GetByIdAsync(TestCaseId.Value)).Data;
            if (testCase != null)
            {
                currentTestCase = testCase;
                steps = (await CaseStepService.GetByCaseIdAsync(testCase.Id)).Data ?? [];
            }
            else
            {
                Navigation.NavigateTo("/testing/project-cases");
                return;
            }
        }
        else if (ProjectId.HasValue)
        {
            // 创建新测试用例
            isNewTestCase = true;
            currentTestCase = new CaseDto { ProjectId = ProjectId.Value };
        }
        else
        {
            Navigation.NavigateTo("/testing/project-cases");
            return;
        }
        
        // 加载项目服务列表
        var projectId = currentTestCase.ProjectId;
        if (projectId != 0)
        {
            projectServices = (await ProjectServiceConfigService.GetProjectServicesAsync(projectId)).Data ?? [];
            
            // 加载可用模板
            var allCases = (await ProjectCaseService.GetByProjectIdAsync(projectId)).Data ?? [];
            availableTemplates = allCases.Where(c => c.IsTemplate && c.Id != currentTestCase.Id).ToList();
        }
        
        // 如果关联了模板，加载模板步骤
        if (currentTestCase.TemplateId.HasValue)
        {
            await LoadTemplateSteps(currentTestCase.TemplateId.Value);
        }

        // 默认选中第一个步骤
        if (steps.Any())
        {
            var firstStep = steps.OrderBy(s => s.Order).First();
            SelectStep(firstStep);
        }
    }
    
    private async Task LoadTemplateSteps(long templateId)
    {
        // 深拷贝模板步骤列表用于显示
        var templateSteps = (await CaseStepService.GetByCaseIdAsync(templateId)).Data ?? [];
        var json = System.Text.Json.JsonSerializer.Serialize(templateSteps);
        steps = System.Text.Json.JsonSerializer.Deserialize<List<CaseStepDto>>(json) ?? new List<CaseStepDto>();

        // 如果当前选中的步骤不在新列表中，取消选中
        if (selectedStep != null && !steps.Any(s => s.Id == selectedStep.Id))
        {
            selectedStep = null;
        }
        StateHasChanged();
    }

    private void SelectStep(CaseStepDto step)
    {
        selectedStep = step;
        
        // 确保步骤有正确的配置对象
        if (IsApiStep(step.Type) && step.ApiConfig == null)
        {
            step.ApiConfig = new ApiStepConfig();
        }
        else if (IsUiStep(step.Type) && step.UiConfig == null)
        {
            step.UiConfig = new UiStepConfig();
        }
        else if (IsScriptStep(step.Type) && step.ScriptConfig == null)
        {
            step.ScriptConfig = new ScriptStepConfig();
        }
        
        StateHasChanged();
    }
    
    private void AddStep()
    {
        var newStep = new CaseStepDto
        {
            Name = $"步骤 {steps.Count + 1}",
            Order = steps.Count + 1,
            Type = StepType.HttpRequest,
            ApiConfig = new ApiStepConfig()
        };
        
        steps.Add(newStep);
        selectedStep = newStep;
        StateHasChanged();
    }
    
    private async Task DeleteStep(string stepId)
    {
        var stepToRemove = steps.FirstOrDefault(s => s.Id == stepId);
        if (stepToRemove != null)
        {
            steps.Remove(stepToRemove);
            
            // 重新排序
            for (int i = 0; i < steps.Count; i++)
            {
                steps[i].Order = i + 1;
            }
            
            // 如果删除的是当前选中的步骤，清除选择
            if (selectedStep?.Id == stepId)
            {
                selectedStep = null;
            }
            
            StateHasChanged();
        }
    }
    
    private void MoveStepUp(CaseStepDto step)
    {
        if (step.Order > 1)
        {
            var prevStep = steps.FirstOrDefault(s => s.Order == step.Order - 1);
            if (prevStep != null)
            {
                prevStep.Order++;
                step.Order--;
                StateHasChanged();
            }
        }
    }
    
    private void MoveStepDown(CaseStepDto step)
    {
        if (step.Order < steps.Count)
        {
            var nextStep = steps.FirstOrDefault(s => s.Order == step.Order + 1);
            if (nextStep != null)
            {
                nextStep.Order--;
                step.Order++;
                StateHasChanged();
            }
        }
    }
    
    private void OnStepTypeChanged(ChangeEventArgs e)
    {
        if (selectedStep != null && Enum.TryParse<StepType>(e.Value?.ToString(), out var stepType))
        {
            selectedStep.Type = stepType;
            
            // 根据步骤类型初始化相应的配置
            if (IsApiStep(stepType))
            {
                selectedStep.ApiConfig = selectedStep.ApiConfig ?? new ApiStepConfig();
                selectedStep.UiConfig = null;
                selectedStep.ScriptConfig = null;
            }
            else if (IsUiStep(stepType))
            {
                selectedStep.UiConfig = selectedStep.UiConfig ?? new UiStepConfig();
                selectedStep.ApiConfig = null;
                selectedStep.ScriptConfig = null;
            }
            else if (IsScriptStep(stepType))
            {
                selectedStep.ScriptConfig = selectedStep.ScriptConfig ?? new ScriptStepConfig();
                selectedStep.ApiConfig = null;
                selectedStep.UiConfig = null;
            }
            else
            {
                selectedStep.ApiConfig = null;
                selectedStep.UiConfig = null;
                selectedStep.ScriptConfig = null;
            }
            
            StateHasChanged();
        }
    }
    
    private async Task SaveTestCase()
    {
        try
        {
            if (isNewTestCase)
            {
                var newId = (await ProjectCaseService.CreateAsync(currentTestCase)).Data;
                // 如果是新建，更新当前对象的ID，防止重复创建
                currentTestCase.Id = newId;
                isNewTestCase = false;
                await JSRuntime.InvokeVoidAsync("alert", "测试用例创建成功！");
            }
            else
            {
                await ProjectCaseService.UpdateAsync(currentTestCase.Id, currentTestCase);
                await JSRuntime.InvokeVoidAsync("alert", "测试用例保存成功！");
            }

            // 如果使用了模板，不保存步骤（步骤由模板定义）
            if (!currentTestCase.TemplateId.HasValue)
            {
                await CaseStepService.SyncAsync(currentTestCase.Id, steps);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}");
        }
    }
    
    private void GoBack()
    {
        // 返回测试用例页面，并保留项目ID
        if (currentTestCase.ProjectId != 0)
        {
            Navigation.NavigateTo($"/testing/project-cases/{currentTestCase.ProjectId}");
        }
        else
        {
            Navigation.NavigateTo("/testing/project-cases");
        }
    }
    
    // 辅助方法
    private bool IsApiStep(StepType type) => type == StepType.HttpRequest || type == StepType.ApiAssertion || type == StepType.VariableExtraction;
    
    private bool IsUiStep(StepType type) => type >= StepType.Navigate && type <= StepType.KeyPress;
    
    private bool IsScriptStep(StepType type) => type == StepType.JavascriptScript || type == StepType.CSharpScript;
    
    private string GetStepTypeDisplayName(StepType type) => type switch
    {
        StepType.HttpRequest => "HTTP请求",
        StepType.ApiAssertion => "API断言",
        StepType.VariableExtraction => "变量提取",
        StepType.Navigate => "页面导航",
        StepType.Click => "点击操作",
        StepType.Input => "输入文本",
        StepType.Select => "选择操作",
        StepType.Wait => "等待操作",
        StepType.Assert => "UI断言",
        StepType.Screenshot => "截图",
        StepType.Script => "脚本执行",
        StepType.Delay => "延时等待",
        StepType.SetVariable => "设置变量",
        StepType.JavascriptScript => "JavaScript脚本",
        StepType.CSharpScript => "C#脚本",
        _ => "未知"
    };
    
    // API配置辅助方法
    private void ParseHeaders(ApiStepConfig config, string headersText)
    {
        config.Headers.Clear();
        if (string.IsNullOrWhiteSpace(headersText)) return;
        
        var lines = headersText.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            var parts = line.Split(':', 2, StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                config.Headers[parts[0]] = parts[1];
            }
        }
    }
    
