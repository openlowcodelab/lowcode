    /// <summary>
    /// 切换创建方式（切回空白时清除模板选择）
    /// </summary>
    private void SetCreateMode(string mode) { createMode = mode; if (mode == "blank") selectedTemplateId = null; }

    private async Task SaveProject()
    {
        try
        {
            if (!isEditingProject && createMode == "template" && selectedTemplateId == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "请先选择一个模板");
                return;
            }
            if (isEditingProject)
            {
                await ProjectService.UpdateAsync(currentProject.Id, currentProject);
                HideProjectModal();
                await LoadData();
            }
            else if (selectedTemplateId != null)
            {
                var projectId = await ProjectTemplateService.CreateProjectFromTemplateAsync(selectedTemplateId, currentProject.Name, currentProject.Description);
                HideProjectModal();
                await LoadData();
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", projectId.ToString());
                NavigationManager.NavigateTo($"/testing/project-cases/{projectId}");
            }
            else
            {
                await ProjectService.CreateProjectAsync(currentProject);
                HideProjectModal();
                await LoadData();
            }
        }
        catch (InvalidOperationException ex) { await JSRuntime.InvokeVoidAsync("alert", ex.Message); }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"保存项目时发生错误: {ex.Message}"); }
    }

