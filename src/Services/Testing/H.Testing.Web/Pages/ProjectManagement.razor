        aiGenerated?.Services.FirstOrDefault(s => s.TempId == tempId)?.Name ?? tempId ?? "";

    /// <summary>
    /// 将 AI 生成的平铺分类转为带层级的展示列表
    /// </summary>
    private List<(AiGeneratedCategoryDto Category, int Depth)> GetAiCategoryDisplayList()
    {
        var result = new List<(AiGeneratedCategoryDto, int)>();
        if (aiGenerated == null) return result;

        var tempIds = aiGenerated.Categories.Select(c => c.TempId).ToHashSet();
        var visited = new HashSet<string>();

        void Add(AiGeneratedCategoryDto category, int depth)
        {
            if (!visited.Add(category.TempId)) return;
            result.Add((category, depth));
            foreach (var child in aiGenerated.Categories.Where(c => c.ParentTempId == category.TempId))
            {
                Add(child, depth + 1);
            }
        }

        foreach (var root in aiGenerated.Categories.Where(c => string.IsNullOrEmpty(c.ParentTempId) || !tempIds.Contains(c.ParentTempId!)))
        {
            Add(root, 0);
        }

        return result;
    }

