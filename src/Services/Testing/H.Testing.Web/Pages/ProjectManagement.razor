    }

    /// <summary>
    /// 将知识库树平铺为带层级的展示列表
    /// </summary>
    private List<(ProjectKnowledgeNodeDto Node, int Depth)> GetKnowledgeDisplayList()
    {
        var result = new List<(ProjectKnowledgeNodeDto, int)>();
        void Add(ProjectKnowledgeNodeDto node, int depth)
        {
            result.Add((node, depth));
            foreach (var child in node.Children) Add(child, depth + 1);
        }
        foreach (var node in knowledgeTreeNodes) Add(node, 0);
        return result;
    }

    private async Task SelectKnowledgeNode(ProjectKnowledgeNodeDto node)
    {
        if (node.NodeType != "Document") return;
        selectedKnowledgeNode = node;
        docContent = await ProjectKnowledgeService.GetDocumentContentAsync(node.Id);
        StateHasChanged();
    }

    private Task AddKnowledgeDirectory() => AddKnowledgeNode("Directory");
    private Task AddKnowledgeDocument() => AddKnowledgeNode("Document");

    private async Task AddKnowledgeNode(string nodeType)
    {
        if (knowledgeProject == null) return;
        try
        {
            var title = nodeType == "Directory" ? "新建目录" : "新建文档";
            var created = await ProjectKnowledgeService.CreateNodeAsync(knowledgeProject.Id, new CreateProjectKnowledgeNodeInput { Title = title, NodeType = nodeType });
            await LoadKnowledgeTree();
            if (created.NodeType == "Document") await SelectKnowledgeNode(created);
            renamingNodeId = created.Id;
            renamingTitle = created.Title;
            StateHasChanged();
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"创建失败: {ex.Message}"); }
    }

    private void StartRenameKnowledgeNode(ProjectKnowledgeNodeDto node) { renamingNodeId = node.Id; renamingTitle = node.Title; }
    private void CancelRenameKnowledgeNode() { renamingNodeId = null; renamingTitle = ""; }

    private async Task SaveRenameKnowledgeNode()
    {
        if (renamingNodeId == null) return;
        var id = renamingNodeId.Value;
        renamingNodeId = null;
        if (string.IsNullOrWhiteSpace(renamingTitle)) { StateHasChanged(); return; }
        try
        {
            await ProjectKnowledgeService.RenameNodeAsync(id, renamingTitle.Trim());
            await LoadKnowledgeTree();
            if (selectedKnowledgeNode?.Id == id) selectedKnowledgeNode = FindKnowledgeNode(id);
            StateHasChanged();
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"重命名失败: {ex.Message}"); }
    }

    private ProjectKnowledgeNodeDto? FindKnowledgeNode(Guid id) =>
        GetKnowledgeDisplayList().Select(t => t.Node).FirstOrDefault(n => n.Id == id);

    private async Task DeleteKnowledgeNode(ProjectKnowledgeNodeDto node)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除 '{node.Title}' 吗？")) return;
        await ProjectKnowledgeService.DeleteNodeAsync(node.Id);
        if (selectedKnowledgeNode?.Id == node.Id) { selectedKnowledgeNode = null; docContent = ""; }
        await LoadKnowledgeTree();
        StateHasChanged();
    }

    private async Task SaveKnowledgeDocument()
    {
        if (selectedKnowledgeNode == null) return;
        docSaving = true;
        StateHasChanged();
        try
        {
            await ProjectKnowledgeService.SaveDocumentAsync(selectedKnowledgeNode.Id, docContent);
            await JSRuntime.InvokeVoidAsync("alert", "文档已保存");
