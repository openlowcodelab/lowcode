    private void OnSearchChanged(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; FilterProjects(); }
    private Task SearchProjects() { FilterProjects(); return Task.CompletedTask; }
    private void FilterByStatus(ChangeEventArgs e) { selectedStatus = e.Value?.ToString() ?? ""; FilterProjects(); }
    private void OnStatusChanged(string value) { selectedStatus = value; FilterProjects(); }

    private void FilterProjects()
    {
        filteredProjects = projects.Where(p =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            var matchesStatus = string.IsNullOrEmpty(selectedStatus) || ((int)p.Status).ToString() == selectedStatus;
            return matchesSearch && matchesStatus;
        }).ToList();
        StateHasChanged();
    }

