    private async Task GenerateKbWithAi()
    {
        if (knowledgeProject == null) return;
        if (string.IsNullOrWhiteSpace(aiKbDescription)) { aiKbError = "请输入需求描述"; return; }
        aiKbGenerating = true;
        aiKbError = null;
        StateHasChanged();
        try
        {
            aiKbGenerated = await ProjectKnowledgeService.GenerateWithAiAsync(knowledgeProject.Id, aiKbDescription);
        }
        catch (Exception ex) { aiKbError = $"生成失败: {ex.Message}"; }
        finally { aiKbGenerating = false; }
    }

    private void DiscardAiKnowledge() { aiKbGenerated = null; }

    private async Task SaveAiKnowledgeDocument()
    {
        if (knowledgeProject == null || aiKbGenerated == null) return;
        aiKbSaving = true;
        StateHasChanged();
        try
        {
            var title = string.IsNullOrWhiteSpace(aiKbGenerated.Title) ? "AI 生成知识" : aiKbGenerated.Title;
            var created = await ProjectKnowledgeService.CreateNodeAsync(knowledgeProject.Id, new CreateProjectKnowledgeNodeInput { Title = title, NodeType = "Document" });
            await ProjectKnowledgeService.SaveDocumentAsync(created.Id, aiKbGenerated.Content);
            await LoadKnowledgeTree();
            selectedKnowledgeNode = FindKnowledgeNode(created.Id);
            docContent = aiKbGenerated.Content;
            aiKbGenerated = null;
            aiKbDescription = "";
            StateHasChanged();
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"保存失败: {ex.Message}"); }
        finally { aiKbSaving = false; }
    }
