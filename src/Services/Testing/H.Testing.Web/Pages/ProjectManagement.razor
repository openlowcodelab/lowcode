@page "/testing"
@page "/testing/projects"

@namespace H.Testing.Web
@layout TestingLayout

@inject IProjectAppService ProjectService
@inject IProjectEnvironmentAppService ProjectEnvironmentService
@inject IProjectServiceConfigAppService ProjectServiceConfigService
@inject ITestingAiAppService TestingAiService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>项目管理</PageTitle>

<style>
    .environment-item-selected {
        font-weight: 500;
        border-left: 3px solid #0d6efd !important;
    }
</style>

<div class="page-fill">
<div style="display: flex; gap: 16px; margin-bottom: 16px; align-items: center;">
    <div style="flex: 0 0 33%;">
        <input class="h-input" @bind-value="searchTerm" @bind-value:event="oninput" placeholder="搜索项目..." @onkeyup="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchProjects(); })" />
    </div>
    <div style="flex: 0 0 16%;">
        <select class="h-select" style="width: 100%;" value="@selectedStatus" @onchange="FilterByStatus">
            <option value="">全部状态</option>
            <option value="1">活跃</option>
            <option value="2">未激活</option>
            <option value="3">已完成</option>
            <option value="4">已取消</option>
            <option value="5">暂停</option>
        </select>
    </div>
    <div style="flex: 1; text-align: right;">
        <button class="h-btn" style="background-color: #722ED1; border-color: #722ED1; color: #fff; margin-right: 8px;" @onclick="ShowAiModal" disabled="@aiGenerating">✨ AI 创建</button>
        <button class="h-btn h-btn-primary" @onclick="ShowAddProjectModal">➕ 新建项目</button>
    </div>
</div>

@if (loading)
{
    <div style="text-align: center; padding: 40px;">
        <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
    </div>
}
else if (filteredProjects.Any())
{
    <div style="display: flex; flex-wrap: wrap; gap: 16px;">
        @foreach (var project in filteredProjects)
        {
            <div style="flex: 0 0 calc(25% - 12px); min-width: 280px; margin-bottom: 16px;">
                <HCard>
                    <Extra>
                        <div style="position: relative; display: inline-block;">
                            <button class="h-btn h-btn-sm h-btn-ghost" @onclick="() => ToggleProjectDropdown(project.Id)" @onclick:stopPropagation>⋯</button>
                            @if (openProjectDropdownId == project.Id)
                            {
                                <div class="h-dropdown-mask" @onclick="() => openProjectDropdownId = null" @onclick:stopPropagation></div>
                                <div class="h-dropdown-panel">
                                    <div class="h-dropdown-item" @onclick="() => { openProjectDropdownId = null; ShowEditProjectModal(project); }">编辑</div>
                                    <div class="h-dropdown-divider"></div>
                                    <div class="h-dropdown-item danger" @onclick="() => { openProjectDropdownId = null; DeleteProject(project.Id); }">删除</div>
                                </div>
                            }
                        </div>
                    </Extra>
                    <ChildContent>
                    <div @onclick="async () => await NavigateToProjectCases(project.Id)" style="cursor: pointer;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <strong style="font-size: 16px;">@project.Name</strong>
                            <span class="h-tag h-tag-@GetStatusTagClass(project.Status)">@GetStatusDisplayName(project.Status)</span>
                        </div>
                        <p style="color: #4E5969; margin-bottom: 12px; min-height: 40px;">@(string.IsNullOrEmpty(project.Description) ? "暂无描述" : project.Description)</p>
                        <div style="color: #86909C; font-size: 13px; margin-bottom: 12px;">🌍 环境数量：@GetProjectEnvironments(project.Id).Count 个</div>
                    </div>
                    <div style="display: flex; gap: 8px; padding-top: 12px; border-top: 1px solid #F2F3F5;">
                        <button class="h-btn h-btn-sm" @onclick="() => ManageProjectServices(project)">⚙️ 服务</button>
                        <button class="h-btn h-btn-sm" @onclick="async () => await ManageEnvironments(project)">🌐 环境</button>
                        <button class="h-btn h-btn-sm h-btn-primary" @onclick="async () => await NavigateToProjectCases(project.Id)">📝 用例</button>
                    </div>
                    </ChildContent>
                </HCard>
            </div>
        }
    </div>
}
else
{
    <div style="text-align: center; padding: 60px 20px; color: #86909C;">
        <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
        <h3>暂无项目数据</h3>
        <p>点击「新建项目」按钮创建您的第一个项目</p>
    </div>
}
</div>

@{
    var projectModalTitle = isEditingProject ? "编辑项目" : "新建项目";
}
<HModal Visible="showProjectModal" Title="@projectModalTitle" OnCancel="HideProjectModal" ShowFooter="false" Style="width: 700px;">
    <div Style="padding: 20px 0;">
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;"><span Style="color: red;">*</span> 项目名称</label>
            <div Style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentProject.Name" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: start;">
            <label Style="width: 100px; text-align: right; margin-right: 16px; margin-top: 6px;">项目描述</label>
            <div Style="flex: 1;">
                <InputTextArea class="h-textarea" rows="4" @bind-Value="currentProject.Description" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;">状态</label>
            <div Style="flex: 1;">
                <select class="h-select" style="width: 100%;" value="@((int)currentProject.Status)" @onchange="@(e => currentProject.Status = (ProjectStatus)int.Parse(e.Value?.ToString() ?? "0"))">
                    <option value="@((int)ProjectStatus.Active)">活跃</option>
                    <option value="@((int)ProjectStatus.Inactive)">未激活</option>
                    <option value="@((int)ProjectStatus.Completed)">已完成</option>
                    <option value="@((int)ProjectStatus.Cancelled)">已取消</option>
                    <option value="@((int)ProjectStatus.OnHold)">暂停</option>
                </select>
            </div>
        </div>
    </div>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideProjectModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveProject">@(isEditingProject ? "更新" : "保存")</button>
    </div>
</HModal>

<HModal Visible="showAiModal" Title="✨ AI 创建测试项目" OnCancel="HideAiModal" ShowFooter="false" Style="width: 800px;">
    @if (aiGenerated == null)
    {
        <div Style="padding: 8px 0;">
            <label Style="display: block; margin-bottom: 8px; font-weight: 500;">用口语描述你想创建的测试项目</label>
            <textarea class="h-textarea" rows="6" @bind="aiDescription" disabled="@aiGenerating"
                      placeholder="例如：帮我创建一个电商网站的自动化测试项目，要覆盖登录注册、商品搜索、购物车和下单支付，重点关注支付异常和库存边界场景"></textarea>
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
            <div Style="color: #86909C; font-size: 12px; margin-top: 8px;">AI 将根据描述自动生成项目、用例分类与测试用例，生成后可预览确认。</div>
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="HideAiModal" Style="margin-right: 8px;">取消</button>
            <button class="h-btn" style="background-color: #722ED1; border-color: #722ED1; color: #fff;" @onclick="GenerateAiProject" disabled="@aiGenerating">
                @(aiGenerating ? "⏳ AI 生成中..." : "✨ 生成")
            </button>
        </div>
    }
    else
    {
        <div Style="padding: 8px 0; max-height: 480px; overflow-y: auto;">
            <div Style="margin-bottom: 12px;">
                <strong Style="font-size: 16px;">@aiGenerated.Name</strong>
                @if (!string.IsNullOrEmpty(aiGenerated.Description))
                {
                    <div Style="color: #4E5969; margin-top: 4px;">@aiGenerated.Description</div>
                }
            </div>
            @if (aiGenerated.Services.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">⚙️ 被测服务 (@aiGenerated.Services.Count)</div>
                    @foreach (var service in aiGenerated.Services)
                    {
                        <div Style="padding-left: 24px; color: #4E5969; font-size: 13px; margin-top: 2px;">
                            @service.Name
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <span Style="color: #86909C;">- @service.Description</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (aiGenerated.Environments.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">🌐 测试环境 (@aiGenerated.Environments.Count)</div>
                    @foreach (var env in aiGenerated.Environments)
                    {
                        <div Style="padding-left: 24px; color: #4E5969; font-size: 13px; margin-top: 2px;">
                            @env.Name <span class="h-tag h-tag-blue" style="margin-left: 4px;">@GetAiEnvTypeName(env.Type)</span>
                            @foreach (var config in env.ServiceConfigs)
                            {
                                <span Style="color: #86909C; margin-left: 8px;">@GetAiServiceName(config.ServiceTempId): @config.BaseUrl</span>
                            }
                        </div>
                    }
                </div>
            }
            @foreach (var (category, depth) in GetAiCategoryDisplayList())
            {
                <div Style="padding: 6px 0; border-bottom: 1px solid #F2F3F5;">
                    <div Style="padding-left: @(depth * 20)px; font-weight: 500;">📁 @category.Name <span Style="color: #86909C; font-size: 12px; font-weight: normal;">(@(category.Cases.Count) 个用例)</span></div>
                    @foreach (var aiCase in category.Cases)
                    {
                        <div Style="padding-left: @(depth * 20 + 24)px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            📝 @aiCase.Name
                            @foreach (var level in aiCase.Levels)
                            {
                                <span class="h-tag h-tag-blue" style="margin-left: 4px;">@level</span>
                            }
                            @if (aiCase.Steps.Any())
                            {
                                <span Style="color: #86909C; font-size: 12px; margin-left: 4px;">(@aiCase.Steps.Count 个步骤)</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="BackToAiInput" Style="margin-right: 8px;" disabled="@aiApplying">返回修改</button>
            <button class="h-btn h-btn-primary" @onclick="ConfirmCreateAiProject" disabled="@aiApplying">@(aiApplying ? "⏳ 创建中..." : "确认创建")</button>
        </div>
    }
</HModal>

@{
    var envModalTitle = $"环境管理 - {selectedProject?.Name}";
}
<HModal Visible="showEnvironmentModal" Title="@envModalTitle" OnCancel="HideEnvironmentModal" ShowFooter="false" Style="width: 1100px;">
    <div Style="display: flex; min-height: 600px;">
        <div Style="width: 280px; border-right: 1px solid #F2F3F5; padding: 16px; background-color: #F7F8FA;">
            <div Style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span Style="font-weight: 500;">环境列表</span>
                <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowAddEnvironmentModal">➕</button>
            </div>
            
            @if (projectEnvironments.Any())
            {
                <div Style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var env in projectEnvironments)
                    {
                        var isSelected = selectedEnvironment?.Id == env.Id;
                        var bgColor = isSelected ? "#165DFF" : "#fff";
                        var textColor = isSelected ? "#fff" : "#1D2129";
                        var subTextColor = isSelected ? "rgba(255,255,255,0.8)" : "#86909C";
                        var borderColor = isSelected ? "#165DFF" : "#E5E6EB";
                        
                        <div @onclick="() => SelectEnvironment(env)" 
                             Style="padding: 12px; border-radius: 4px; cursor: pointer; background-color: @bgColor; color: @textColor; border: 1px solid @borderColor;">
                            <div Style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div Style="font-weight: 600; margin-bottom: 4px;">@env.Name</div>
                                    <div Style="font-size: 12px; color: @subTextColor;">@GetEnvironmentTypeDisplayName(env.Type)</div>
                                </div>
                                <div style="position: relative;">
                                    <button class="h-btn h-btn-sm" style="background: transparent; border: none; color: inherit;" @onclick:stopPropagation @onclick="() => ToggleEnvDropdown(env.Id)">⋯</button>
                                    @if (openEnvDropdownId == env.Id)
                                    {
                                        <div class="h-dropdown-mask" @onclick="() => openEnvDropdownId = null" @onclick:stopPropagation></div>
                                        <div class="h-dropdown-panel">
                                            <div class="h-dropdown-item" @onclick="() => { openEnvDropdownId = null; EditEnvironment(env); }">编辑</div>
                                            <div class="h-dropdown-divider"></div>
                                            <div class="h-dropdown-item danger" @onclick="() => { openEnvDropdownId = null; DeleteEnvironment(env.Id); }">删除</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div Style="text-align: center; padding: 40px 20px; color: #86909C;">
                    <p>暂无环境</p>
                    <button class="h-btn h-btn-sm h-btn-default" @onclick="ShowAddEnvironmentModal">添加环境</button>
                </div>
            }
        </div>
        
        <div Style="flex: 1; padding: 16px;">
            @if (selectedEnvironment != null)
            {
                <div>
                    <div Style="margin-bottom: 24px; border: 1px solid #E5E6EB; border-radius: 4px;">
                        <div Style="padding: 12px 16px; background-color: #F7F8FA; border-bottom: 1px solid #E5E6EB; font-weight: 500;">
                            💻 服务配置
                        </div>
                        <div Style="padding: 16px;">
                            @if (serviceConfigViews.Any())
                            {
                                <table class="table" Style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr Style="background-color: #F7F8FA; border-bottom: 1px solid #E5E6EB;">
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">服务名称</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">基础URL</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500; width: 120px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var config in serviceConfigViews)
                                        {
                                            <tr Style="border-bottom: 1px solid #F2F3F5;">
                                                <td Style="padding: 12px 16px;"><strong>@config.ProjectService.Name</strong></td>
                                                <td Style="padding: 12px 16px;">
                                                    @if (config.EnvironmentConfig != null)
                                                    {
                                                        <a href="@config.EnvironmentConfig.BaseUrl" target="_blank" Style="color: #165DFF;">@config.EnvironmentConfig.BaseUrl</a>
                                                    }
                                                    else
                                                    {
                                                        <span Style="color: #86909C;">未配置</span>
                                                    }
                                                </td>
                                                <td Style="padding: 12px 16px;">
                                                    @if (config.EnvironmentConfig != null)
                                                    {
                                                        <div class="row-actions">
                                                            <a class="link-action" @onclick="() => EditServiceConfig(config.EnvironmentConfig!)">编辑</a>
                                                            <a class="link-action-danger" @onclick="() => DeleteServiceConfig(config.EnvironmentConfig!.Id)">删除</a>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <a class="link-action" @onclick="() => AddServiceConfig(config.ProjectService)">配置</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div Style="text-align: center; padding: 20px; color: #86909C;">暂无服务配置</div>
                            }
                        </div>
                    </div>
                    
                    <div Style="border: 1px solid #E5E6EB; border-radius: 4px;">
                        <div Style="padding: 12px 16px; background-color: #F7F8FA; border-bottom: 1px solid #E5E6EB; display: flex; justify-content: space-between; align-items: center;">
                            <span Style="font-weight: 500;">📊 环境变量</span>
                            <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowAddVariableModal">➕ 添加变量</button>
                        </div>
                        <div Style="padding: 16px;">
                            @if (selectedEnvironment?.Variables != null && selectedEnvironment.Variables.Any())
                            {
                                <table class="table" Style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr Style="background-color: #F7F8FA; border-bottom: 1px solid #E5E6EB;">
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">变量名</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500;">变量值</th>
                                            <th Style="padding: 12px 16px; text-align: left; font-weight: 500; width: 100px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kvp in selectedEnvironment.Variables)
                                        {
                                            <tr Style="border-bottom: 1px solid #F2F3F5;">
                                                <td Style="padding: 12px 16px;"><strong>@kvp.Key</strong></td>
                                                <td Style="padding: 12px 16px;"><span Style="color: #165DFF; word-break: break-all;">@kvp.Value</span></td>
                                                <td Style="padding: 12px 16px;">
                                                    <div class="row-actions">
                                                        <a class="link-action" @onclick="() => EditVariable(kvp.Key, kvp.Value)">编辑</a>
                                                        <a class="link-action-danger" @onclick="() => DeleteVariable(kvp.Key)">删除</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div Style="text-align: center; padding: 20px; color: #86909C;">暂无环境变量</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div Style="display: flex; align-items: center; justify-content: center; height: 100%; color: #86909C;">
                    <div Style="text-align: center;">
                        <h4 Style="margin-bottom: 16px;">选择一个环境</h4>
                        <p>请从左侧列表中选择一个环境来查看详情</p>
                    </div>
                </div>
            }
        </div>
    </div>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideEnvironmentModal" Style="margin-right: 8px;">关闭</button>
        @if (selectedEnvironment != null)
        {
            <button class="h-btn" @onclick="SaveEnvironmentChanges" Style="background-color: #00B42A; border-color: #00B42A; color: #fff;">保存更改</button>
        }
    </div>
</HModal>

<HModal Visible="showAddEnvironmentModal" Title="新建环境" OnCancel="HideAddEnvironmentModal" ShowFooter="false" Style="width: 600px;">
    <EditForm Model="currentEnvironment" OnValidSubmit="SaveEnvironment">
        <DataAnnotationsValidator />
        <ValidationSummary Style="color: red;" />
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">环境名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentEnvironment.Name" />
                <ValidationMessage For="() => currentEnvironment.Name" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">环境类型</label>
            <div class="h-form-control" style="flex: 1;">
                <select class="h-select" style="width: 100%;" value="@((int)currentEnvironment.Type)" @onchange="@(e => currentEnvironment.Type = (EnvironmentType)int.Parse(e.Value?.ToString() ?? "0"))">
                    <option value="@((int)EnvironmentType.Development)">开发环境</option>
                    <option value="@((int)EnvironmentType.Testing)">项目环境</option>
                    <option value="@((int)EnvironmentType.Staging)">预发环境</option>
                    <option value="@((int)EnvironmentType.Production)">生产环境</option>
                </select>
            </div>
        </div>
        
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
            <button class="h-btn h-btn-default" @onclick="HideAddEnvironmentModal" Style="margin-right: 8px;">取消</button>
            <button class="h-btn h-btn-primary" @onclick="SaveEnvironment">保存</button>
        </div>
    </EditForm>
</HModal>

<HModal Visible="showAddVariableModal" Title="添加环境变量" OnCancel="HideAddVariableModal" ShowFooter="false" Style="width: 500px;">
    <div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">变量名</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="newVariableName" placeholder="请输入变量名" />
            </div>
        </div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">变量值</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="newVariableValue" placeholder="请输入变量值" />
            </div>
        </div>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideAddVariableModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveNewVariable">保存</button>
    </div>
</HModal>

<HModal Visible="showEditVariableModal" Title="编辑环境变量" OnCancel="HideEditVariableModal" ShowFooter="false" Style="width: 500px;">
    <div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">变量名</label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="editVariableName" readonly />
            </div>
        </div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">变量值</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="editVariableValue" placeholder="请输入变量值" />
            </div>
        </div>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideEditVariableModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveEditVariable">保存</button>
    </div>
</HModal>

@{
    var serviceModalTitle = selectedProjectForServices != null ? $"{selectedProjectForServices.Name} - 服务管理" : "服务管理";
}
<HModal Visible="showProjectServiceManagementModal" Title="@serviceModalTitle" OnCancel="HideProjectServiceManagementModal" ShowFooter="false" Style="width: 900px;">
    <div Style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
        <span Style="font-weight: 500;">项目服务列表</span>
        <button class="h-btn h-btn-primary" @onclick="ShowAddProjectServiceModal">添加服务</button>
    </div>
    
    @if (projectServices.Any())
    {
        <HTable>
            <thead>
                <tr>
                    <th>服务名称</th>
                    <th>创建时间</th>
                    <th style="width: 150px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var svc in projectServices)
                {
                    <tr>
                        <td>
                            <strong>@svc.Name</strong>
                            @if (!string.IsNullOrEmpty(svc.Description))
                            {
                                <br /><span Style="color: #86909C; font-size: 12px;">@svc.Description</span>
                            }
                        </td>
                        <td>@svc.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="row-actions">
                                <a class="link-action" @onclick="() => EditProjectService(svc)">编辑</a>
                                <a class="link-action-danger" @onclick="() => DeleteProjectService(svc.Id)">删除</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </HTable>
    }
    else
    {
        <div Style="text-align: center; padding: 40px; color: #86909C;">
            <p>暂无服务配置</p>
            <button class="h-btn h-btn-primary" @onclick="ShowAddProjectServiceModal">添加第一个服务</button>
        </div>
    }
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideProjectServiceManagementModal">关闭</button>
    </div>
</HModal>

@{
    var serviceEditModalTitle = isEditingProjectService ? "编辑项目服务" : "添加项目服务";
}
<HModal Visible="showProjectServiceModal" Title="@serviceEditModalTitle" OnCancel="HideProjectServiceModal" ShowFooter="false" Style="width: 500px;">
    <EditForm Model="currentProjectService" OnValidSubmit="SaveProjectService">
        <DataAnnotationsValidator />
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 120px;"><span class="h-required">服务名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentProjectService.Name" Placeholder="请输入服务名称" />
                <ValidationMessage For="() => currentProjectService.Name" />
            </div>
        </div>
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 120px;">服务描述</label>
            <div class="h-form-control" style="flex: 1;">
                <InputTextArea class="h-textarea" @bind-Value="currentProjectService.Description" Placeholder="请输入服务描述" rows="3" />
            </div>
        </div>
        
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
            <button class="h-btn h-btn-default" @onclick="HideProjectServiceModal" Style="margin-right: 8px;">取消</button>
            <button class="h-btn h-btn-primary" @onclick="SaveProjectService">@(isEditingProjectService ? "更新" : "保存")</button>
        </div>
    </EditForm>
</HModal>

@{
    var serviceConfigModalTitle = isEditingServiceConfig ? "编辑服务配置" : "添加服务配置";
}
<HModal Visible="showServiceConfigModal" Title="@serviceConfigModalTitle" OnCancel="HideServiceConfigModal" ShowFooter="false" Style="width: 500px;">
    <EditForm Model="currentServiceConfig" OnValidSubmit="SaveServiceConfig">
        <DataAnnotationsValidator />
        
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">基础URL</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="currentServiceConfig.BaseUrl" placeholder="请输入基础URL，如：http://127.0.0.1:8080" />
                <ValidationMessage For="() => currentServiceConfig.BaseUrl" />
            </div>
        </div>
    </EditForm>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideServiceConfigModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveServiceConfig">@(isEditingServiceConfig ? "更新" : "添加")</button>
    </div>
</HModal>

@code {
    private List<ProjectDto> projects = new();
    private List<ProjectDto> filteredProjects = new();
    private List<ProjectEnvironmentDto> environments = new();
    private List<ProjectEnvironmentDto> projectEnvironments = new();
    private ProjectDto currentProject = new();
    private ProjectEnvironmentDto currentEnvironment = new();
    private ProjectEnvironmentDto? selectedEnvironment;
    private ProjectDto? selectedProject;
    private bool loading = true;
    private bool showProjectModal = false;
    private bool showEnvironmentModal = false;
    private bool showAddEnvironmentModal = false;
    private bool showAddVariableModal = false;
    private bool showEditVariableModal = false;
    private bool showProjectServiceModal = false;
    private bool showProjectServiceManagementModal = false;
    private bool isEditingProject = false;
    private bool isEditingProjectService = false;
    private string searchTerm = "";
    private string selectedStatus = "";
    private string newVariableName = "";
    private string newVariableValue = "";
    private string editVariableName = "";
    private string editVariableValue = "";
    private List<ProjectServiceDto> projectServices = new();
    private List<ServiceConfigView> serviceConfigViews = new();
    private ProjectServiceDto currentProjectService = new();
    private ProjectDto? selectedProjectForServices;
    private EnvironmentServiceConfigDto currentServiceConfig = new();
    private bool showServiceConfigModal = false;
    private bool isEditingServiceConfig = false;
    private long? openProjectDropdownId = null;
    private long? openEnvDropdownId = null;

    // === AI 创建 ===
    private bool showAiModal = false;
    private string aiDescription = "";
    private bool aiGenerating = false;
    private bool aiApplying = false;
    private string? aiError;
    private AiGeneratedProjectDto? aiGenerated;

    private void ShowAiModal()
    {
        aiDescription = "";
        aiGenerated = null;
        aiError = null;
        showAiModal = true;
    }

    private void HideAiModal() { showAiModal = false; }

    private void BackToAiInput() { aiGenerated = null; aiError = null; }

    private async Task GenerateAiProject()
    {
        if (string.IsNullOrWhiteSpace(aiDescription))
        {
            aiError = "请输入需求描述";
            return;
        }

        aiGenerating = true;
        aiError = null;
        StateHasChanged();

        try
        {
            aiGenerated = await TestingAiService.GenerateProjectAsync(new AiGenerateInputDto { Description = aiDescription });
        }
        catch (Exception ex)
        {
            aiError = $"生成失败: {ex.Message}";
        }
        finally
        {
            aiGenerating = false;
        }
    }

    private async Task ConfirmCreateAiProject()
    {
        if (aiGenerated == null) return;

        aiApplying = true;
        aiError = null;
        StateHasChanged();

        try
        {
            var projectId = await TestingAiService.CreateProjectFromAiAsync(aiGenerated);
            showAiModal = false;
            await LoadData();
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", projectId.ToString());
            NavigationManager.NavigateTo($"/testing/project-cases/{projectId}");
        }
        catch (Exception ex)
        {
            aiError = $"创建失败: {ex.Message}";
        }
        finally
        {
            aiApplying = false;
        }
    }

    /// <summary>
    /// AI 环境类型中文名
    /// </summary>
    private static string GetAiEnvTypeName(string? type) => (type ?? "").Trim().ToLowerInvariant() switch
    {
        "testing" or "test" => "测试",
        "staging" => "预发布",
        "production" or "prod" => "生产",
        _ => "开发"
    };

    /// <summary>
    /// 根据服务 TempId 获取服务名称
    /// </summary>
    private string GetAiServiceName(string? tempId) =>
        aiGenerated?.Services.FirstOrDefault(s => s.TempId == tempId)?.Name ?? tempId ?? "";

    /// <summary>
    /// 将 AI 生成的平铺分类转为带层级的展示列表
    /// </summary>
    private List<(AiGeneratedCategoryDto Category, int Depth)> GetAiCategoryDisplayList()
    {
        var result = new List<(AiGeneratedCategoryDto, int)>();
        if (aiGenerated == null) return result;

        var tempIds = aiGenerated.Categories.Select(c => c.TempId).ToHashSet();
        var visited = new HashSet<string>();

        void Add(AiGeneratedCategoryDto category, int depth)
        {
            if (!visited.Add(category.TempId)) return;
            result.Add((category, depth));
            foreach (var child in aiGenerated.Categories.Where(c => c.ParentTempId == category.TempId))
            {
                Add(child, depth + 1);
            }
        }

        foreach (var root in aiGenerated.Categories.Where(c => string.IsNullOrEmpty(c.ParentTempId) || !tempIds.Contains(c.ParentTempId!)))
        {
            Add(root, 0);
        }

        return result;
    }

    private void ToggleProjectDropdown(long projectId)
    {
        openProjectDropdownId = openProjectDropdownId == projectId ? null : projectId;
    }

    private void ToggleEnvDropdown(long envId)
    {
        openEnvDropdownId = openEnvDropdownId == envId ? null : envId;
    }

    protected override async Task OnInitializedAsync() { await LoadData(); }

    private async Task LoadData()
    {
        loading = true;
        projects = await ProjectService.GetAllAsync();
        environments = await ProjectEnvironmentService.GetAllAsync();
        filteredProjects = projects.ToList();
        loading = false;
        StateHasChanged();
    }

    private List<ProjectEnvironmentDto> GetProjectEnvironments(long projectId) => environments.Where(e => e.ProjectId == projectId).ToList();

    private void ShowAddProjectModal() { currentProject = new ProjectDto(); isEditingProject = false; showProjectModal = true; }

    private void ShowEditProjectModal(ProjectDto project)
    {
        currentProject = new ProjectDto { Id = project.Id, Name = project.Name, Description = project.Description, Status = project.Status, Metadata = new Dictionary<string, object>(project.Metadata), CreatedAt = project.CreatedAt, CreatedBy = project.CreatedBy };
        isEditingProject = true;
        showProjectModal = true;
    }

    private void HideProjectModal() { showProjectModal = false; currentProject = new ProjectDto(); }

    private async Task SaveProject()
    {
        try
        {
            if (isEditingProject) await ProjectService.UpdateAsync(currentProject.Id, currentProject);
            else await ProjectService.CreateProjectAsync(currentProject);
            HideProjectModal();
            await LoadData();
        }
        catch (InvalidOperationException ex) { await JSRuntime.InvokeVoidAsync("alert", ex.Message); }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"保存项目时发生错误: {ex.Message}"); }
    }

    private async Task DeleteProject(long id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "确定要删除此项目吗？"))
        {
            await ProjectService.DeleteAsync(id);
            await LoadData();
        }
    }

    private async Task NavigateToProjectCases(long projectId)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastSelectedProjectId", projectId.ToString());
        NavigationManager.NavigateTo($"/testing/project-cases/{projectId}");
    }

    private async Task ManageEnvironments(ProjectDto project)
    {
        selectedProject = project;
        projectEnvironments = GetProjectEnvironments(project.Id);
        selectedEnvironment = projectEnvironments.FirstOrDefault();
        if (selectedEnvironment != null) await LoadEnvironmentServiceConfigs();
        showEnvironmentModal = true;
        StateHasChanged();
    }
    
    private void HideEnvironmentModal() { showEnvironmentModal = false; selectedProject = null; selectedEnvironment = null; }
    
    private async Task SelectEnvironment(ProjectEnvironmentDto environment)
    {
        selectedEnvironment = environment;
        if (selectedEnvironment != null && selectedProject != null) await LoadEnvironmentServiceConfigs();
        StateHasChanged();
    }
    
    private void ShowAddEnvironmentModal() { currentEnvironment = new ProjectEnvironmentDto { ProjectId = selectedProject?.Id ?? 0 }; showAddEnvironmentModal = true; }
    private void HideAddEnvironmentModal() { showAddEnvironmentModal = false; currentEnvironment = new ProjectEnvironmentDto(); }
    
    private async Task SaveEnvironment()
    {
        await ProjectEnvironmentService.CreateAsync(currentEnvironment);
        environments = await ProjectEnvironmentService.GetAllAsync();
        if (selectedProject != null) projectEnvironments = GetProjectEnvironments(selectedProject.Id);
        HideAddEnvironmentModal();
        StateHasChanged();
    }
    
    private void EditEnvironment(ProjectEnvironmentDto environment)
    {
        currentEnvironment = new ProjectEnvironmentDto { Id = environment.Id, Name = environment.Name, ProjectId = environment.ProjectId, Type = environment.Type, Variables = new Dictionary<string, string>(environment.Variables), Headers = new Dictionary<string, string>(environment.Headers) };
        showAddEnvironmentModal = true;
    }
    
    private async Task DeleteEnvironment(long environmentId)
    {
        await ProjectEnvironmentService.DeleteAsync(environmentId);
        environments = await ProjectEnvironmentService.GetAllAsync();
        if (selectedProject != null)
        {
            projectEnvironments = GetProjectEnvironments(selectedProject.Id);
            if (selectedEnvironment?.Id == environmentId) selectedEnvironment = null;
        }
        StateHasChanged();
    }

    private void ShowAddVariableModal() { newVariableName = ""; newVariableValue = ""; showAddVariableModal = true; }
    private void HideAddVariableModal() { showAddVariableModal = false; newVariableName = ""; newVariableValue = ""; }
    
    private async Task SaveNewVariable()
    {
        if (selectedEnvironment != null && !string.IsNullOrWhiteSpace(newVariableName) && !string.IsNullOrWhiteSpace(newVariableValue))
        {
            selectedEnvironment.Variables[newVariableName] = newVariableValue;
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            HideAddVariableModal();
            StateHasChanged();
        }
    }
    
    private void EditVariable(string key, string value) { editVariableName = key; editVariableValue = value; showEditVariableModal = true; }
    private void HideEditVariableModal() { showEditVariableModal = false; editVariableName = ""; editVariableValue = ""; }
    
    private async Task SaveEditVariable()
    {
        if (selectedEnvironment != null && !string.IsNullOrWhiteSpace(editVariableName) && !string.IsNullOrWhiteSpace(editVariableValue))
        {
            selectedEnvironment.Variables[editVariableName] = editVariableValue;
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            HideEditVariableModal();
            StateHasChanged();
        }
    }
    
    private async Task DeleteVariable(string key)
    {
        if (selectedEnvironment != null)
        {
            selectedEnvironment.Variables.Remove(key);
            await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment);
            environments = await ProjectEnvironmentService.GetAllAsync();
            if (selectedProject != null) { projectEnvironments = GetProjectEnvironments(selectedProject.Id); selectedEnvironment = projectEnvironments.FirstOrDefault(e => e.Id == selectedEnvironment.Id); }
            StateHasChanged();
        }
    }

    private async Task SaveEnvironmentChanges()
    {
        if (selectedEnvironment != null) { await ProjectEnvironmentService.UpdateAsync(selectedEnvironment.Id, selectedEnvironment); await JSRuntime.InvokeVoidAsync("alert", "环境修改已保存"); }
    }

    private void OnSearchChanged(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? ""; FilterProjects(); }
    private Task SearchProjects() { FilterProjects(); return Task.CompletedTask; }
    private void FilterByStatus(ChangeEventArgs e) { selectedStatus = e.Value?.ToString() ?? ""; FilterProjects(); }
    private void OnStatusChanged(string value) { selectedStatus = value; FilterProjects(); }

    private void FilterProjects()
    {
        filteredProjects = projects.Where(p =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            var matchesStatus = string.IsNullOrEmpty(selectedStatus) || ((int)p.Status).ToString() == selectedStatus;
            return matchesSearch && matchesStatus;
        }).ToList();
        StateHasChanged();
    }

    private string GetStatusDisplayName(ProjectStatus status) => status switch { ProjectStatus.Active => "活跃", ProjectStatus.Inactive => "未激活", ProjectStatus.Completed => "已完成", ProjectStatus.Cancelled => "已取消", ProjectStatus.OnHold => "暂停", _ => "未知" };
    private string GetStatusTagColor(ProjectStatus status) => status switch 
    { 
        ProjectStatus.Active => "green", 
        ProjectStatus.Inactive => "orange", 
        ProjectStatus.Completed => "blue", 
        ProjectStatus.Cancelled => "red", 
        ProjectStatus.OnHold => "default", 
        _ => "default" 
    };
    private string GetStatusTagClass(ProjectStatus status) => status switch 
    { 
        ProjectStatus.Active => "green", 
        ProjectStatus.Inactive => "default", 
        ProjectStatus.Completed => "blue", 
        ProjectStatus.Cancelled => "red", 
        ProjectStatus.OnHold => "default", 
        _ => "default" 
    };
    private string GetEnvironmentTypeDisplayName(EnvironmentType type) => type switch { EnvironmentType.Development => "开发环境", EnvironmentType.Testing => "集成环境", EnvironmentType.Staging => "预发环境", EnvironmentType.Production => "生产环境", _ => "未知" };
    
    private async Task ManageProjectServices(ProjectDto project) { selectedProjectForServices = project; projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(project.Id); showProjectServiceManagementModal = true; }
    private void HideProjectServiceManagementModal() { showProjectServiceManagementModal = false; selectedProjectForServices = null; projectServices.Clear(); }
    private void ShowAddProjectServiceModal() { currentProjectService = new ProjectServiceDto { ProjectId = selectedProjectForServices?.Id ?? 0 }; isEditingProjectService = false; showProjectServiceModal = true; }
    
    private void EditProjectService(ProjectServiceDto service)
    {
        currentProjectService = new ProjectServiceDto { Id = service.Id, Name = service.Name, Description = service.Description, ProjectId = service.ProjectId, CreatedAt = service.CreatedAt, CreatedBy = service.CreatedBy };
        isEditingProjectService = true;
        showProjectServiceModal = true;
    }
    
    private void HideProjectServiceModal() { showProjectServiceModal = false; currentProjectService = new ProjectServiceDto(); isEditingProjectService = false; }
    
    private async Task SaveProjectService()
    {
        if (selectedProjectForServices != null)
        {
            if (isEditingProjectService) await ProjectServiceConfigService.UpdateProjectServiceAsync(currentProjectService.Id, currentProjectService);
            else await ProjectServiceConfigService.CreateProjectServiceAsync(currentProjectService);
            projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(selectedProjectForServices.Id);
            HideProjectServiceModal();
            StateHasChanged();
        }
    }
    
    private async Task DeleteProjectService(long serviceId)
    {
        await ProjectServiceConfigService.DeleteProjectServiceAsync(selectedProjectForServices.Id, serviceId);
        await ProjectServiceConfigService.DeleteEnvironmentServiceConfigAsync(serviceId);
        projectServices = await ProjectServiceConfigService.GetProjectServicesAsync(selectedProjectForServices.Id);
        await LoadEnvironmentServiceConfigs();
        StateHasChanged();
    }
    
    private async Task LoadEnvironmentServiceConfigs()
    {
        if (selectedEnvironment != null && selectedProject != null) { serviceConfigViews = await ProjectServiceConfigService.GetServiceConfigViewsAsync(selectedEnvironment.Id, selectedProject.Id); StateHasChanged(); }
    }
    
    private async Task DeleteServiceConfig(long configId) { await ProjectServiceConfigService.DeleteEnvironmentServiceConfigAsync(configId); await LoadEnvironmentServiceConfigs(); }
    
    private void EditServiceConfig(EnvironmentServiceConfigDto config)
    {
        currentServiceConfig = new EnvironmentServiceConfigDto { Id = config.Id, EnvironmentId = config.EnvironmentId, ProjectServiceId = config.ProjectServiceId, BaseUrl = config.BaseUrl, CreatedAt = config.CreatedAt, CreatedBy = config.CreatedBy };
        isEditingServiceConfig = true;
        showServiceConfigModal = true;
    }
    
    private void AddServiceConfig(ProjectServiceDto service)
    {
        currentServiceConfig = new EnvironmentServiceConfigDto { EnvironmentId = selectedEnvironment?.Id ?? 0, ProjectServiceId = service.Id, BaseUrl = "" };
        isEditingServiceConfig = false;
        showServiceConfigModal = true;
    }
    
    private void HideServiceConfigModal() { showServiceConfigModal = false; currentServiceConfig = new EnvironmentServiceConfigDto(); isEditingServiceConfig = false; }
    
    private async Task SaveServiceConfig()
    {
        if (selectedEnvironment != null)
        {
            if (isEditingServiceConfig) await ProjectServiceConfigService.UpdateEnvironmentServiceConfigAsync(currentServiceConfig);
            else await ProjectServiceConfigService.CreateEnvironmentServiceConfigAsync(currentServiceConfig);
            await LoadEnvironmentServiceConfigs();
            HideServiceConfigModal();
            StateHasChanged();
        }
    }
}
