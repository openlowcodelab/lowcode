@page "/testing"
@page "/testing/projects"

@layout TestingLayout

@inject IProjectAppService ProjectService
@inject IProjectEnvAppService ProjectEnvAppService
@inject IProjectServiceConfigAppService ProjectServiceConfigService
@inject IProjectTemplateAppService ProjectTemplateService
@inject IAiGenerateAppService TestingAiService
@inject IProjectKnowledgeAppService ProjectKnowledgeService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>项目管理</PageTitle>

<style>
    .environment-item-selected {
        font-weight: 500;
        border-left: 3px solid #0d6efd !important;
    }

    .tpl-card {
        border: 1px solid #E5E6EB;
        border-radius: 8px;
        padding: 12px;
        cursor: pointer;
        transition: all .2s;
        background: #fff;
    }

    .tpl-card:hover {
        border-color: #4080FF;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .tpl-card-selected {
        border-color: #0d6efd !important;
        background: #F0F5FF;
        box-shadow: 0 2px 8px rgba(13,110,253,.15);
    }

    .kb-node-row {
        display: flex;
        align-items: center;
        padding: 6px 8px;
        border-radius: 4px;
        cursor: pointer;
        gap: 4px;
    }

    .kb-node-row:hover .kb-node-actions {
        visibility: visible;
    }

    .kb-node-actions {
        visibility: hidden;
        margin-left: auto;
        white-space: nowrap;
    }
</style>

<div class="page-fill">
<div style="display: flex; gap: 16px; margin-bottom: 16px; align-items: center;">
    <div style="flex: 0 0 33%;">
        <input class="h-input" @bind-value="searchTerm" @bind-value:event="oninput" placeholder="搜索项目..." @onkeyup="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchProjects(); })" />
    </div>
    <div style="flex: 0 0 16%;">
        <select class="h-select" style="width: 100%;" value="@selectedStatus" @onchange="FilterByStatus">
            <option value="">全部状态</option>
            <option value="1">活跃</option>
            <option value="2">未激活</option>
            <option value="3">已完成</option>
            <option value="4">已取消</option>
            <option value="5">暂停</option>
        </select>
    </div>
    <div style="flex: 1; text-align: right;">
        <button class="h-btn" style="margin-right: 8px;" @onclick="ShowTemplateManagementModal">📦 模板</button>
        <button class="h-btn" style="background-color: #722ED1; border-color: #722ED1; color: #fff; margin-right: 8px;" @onclick="ShowAiModal" disabled="@aiGenerating">✨ AI 创建</button>
        <button class="h-btn h-btn-primary" @onclick="ShowAddProjectModal">➕ 新建项目</button>
    </div>
</div>

@if (loading)
{
    <div style="text-align: center; padding: 40px;">
        <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
    </div>
}
else if (filteredProjects.Any())
{
    <div style="display: flex; flex-wrap: wrap; gap: 16px;">
        @foreach (var project in filteredProjects)
        {
            <div style="flex: 0 0 calc(25% - 12px); min-width: 280px; margin-bottom: 16px;">
                <HCard>
                    <Extra>
                        <div style="position: relative; display: inline-block;">
                            <button class="h-btn h-btn-sm h-btn-ghost" @onclick="() => ToggleProjectDropdown(project.Id)" @onclick:stopPropagation>⋯</button>
                            @if (openProjectDropdownId == project.Id)
                            {
                                <div class="h-dropdown-mask" @onclick="() => openProjectDropdownId = null" @onclick:stopPropagation></div>
                                <div class="h-dropdown-panel">
                                    <div class="h-dropdown-item" @onclick="() => { openProjectDropdownId = null; ShowEditProjectModal(project); }">编辑</div>
                                    <div class="h-dropdown-item" @onclick="() => { openProjectDropdownId = null; ShowSaveAsTemplateModal(project); }">另存为模板</div>
                                    <div class="h-dropdown-divider"></div>
                                    <div class="h-dropdown-item danger" @onclick="() => { openProjectDropdownId = null; DeleteProject(project.Id); }">删除</div>
                                </div>
                            }
                        </div>
                    </Extra>
                    <ChildContent>
                    <div @onclick="async () => await NavigateToProjectCases(project.Id)" style="cursor: pointer;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <strong style="font-size: 16px;">@project.Name</strong>
                            <span class="h-tag h-tag-@GetStatusTagClass(project.Status)">@GetStatusDisplayName(project.Status)</span>
                        </div>
                        <p style="color: #4E5969; margin-bottom: 12px; min-height: 40px;">@(string.IsNullOrEmpty(project.Description) ? "暂无描述" : project.Description)</p>
                        <div style="color: #86909C; font-size: 13px; margin-bottom: 12px;">🌍 环境数量：@GetProjectEnvironments(project.Id).Count 个</div>
                    </div>
                    <div style="display: flex; gap: 8px; padding-top: 12px; border-top: 1px solid #F2F3F5;">
                        <button class="h-btn h-btn-sm" @onclick="() => ManageProjectServices(project)">⚙️ 服务</button>
                        <button class="h-btn h-btn-sm" @onclick="async () => await ManageEnvironments(project)">🌐 环境</button>
                        <button class="h-btn h-btn-sm" @onclick="async () => await ManageKnowledge(project)">📚 知识库</button>
                        <button class="h-btn h-btn-sm h-btn-primary" @onclick="async () => await NavigateToProjectCases(project.Id)">📝 用例</button>
                    </div>
                    </ChildContent>
                </HCard>
            </div>
        }
    </div>
}
else
{
    <div style="text-align: center; padding: 60px 20px; color: #86909C;">
        <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
        <h3>暂无项目数据</h3>
        <p>点击「新建项目」按钮创建您的第一个项目</p>
    </div>
}
</div>

@{
    var projectModalTitle = isEditingProject ? "编辑项目" : "新建项目";
}
<HModal Visible="showProjectModal" Title="@projectModalTitle" OnCancel="HideProjectModal" ShowFooter="false" Style="width: 700px;">
    <div Style="padding: 20px 0;">
        @if (!isEditingProject)
        {
            <div Style="margin-bottom: 16px; display: flex; align-items: start;">
                <label Style="width: 100px; text-align: right; margin-right: 16px; margin-top: 6px;">创建方式</label>
                <div Style="flex: 1;">
                    <div style="display: inline-flex; border: 1px solid #E5E6EB; border-radius: 6px; overflow: hidden; margin-bottom: 12px;">
                        <div style="padding: 6px 20px; cursor: pointer; font-size: 14px; background: @(createMode == "blank" ? "#0d6efd" : "#fff"); color: @(createMode == "blank" ? "#fff" : "#4E5969");"
                             @onclick='() => SetCreateMode("blank")'>📄 从空白新建</div>
                        <div style="padding: 6px 20px; cursor: pointer; font-size: 14px; background: @(createMode == "template" ? "#0d6efd" : "#fff"); color: @(createMode == "template" ? "#fff" : "#4E5969"); border-left: 1px solid #E5E6EB;"
                             @onclick='() => SetCreateMode("template")'>📦 从模板新建</div>
                    </div>
                    @if (createMode == "template")
                    {
                        @if (templates.Any())
                        {
                            <div style="display: flex; flex-wrap: wrap; gap: 12px; max-height: 260px; overflow-y: auto;">
                                @foreach (var tpl in templates)
                                {
                                    <div class="tpl-card @(selectedTemplateId == tpl.Id ? "tpl-card-selected" : "")" style="flex: 0 0 calc(50% - 6px); box-sizing: border-box;"
                                         @onclick="() => SelectCreateTemplate(tpl)">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                            <strong style="font-size: 14px;">@tpl.Name</strong>
                                            @if (selectedTemplateId == tpl.Id)
                                            {
                                                <span style="color: #0d6efd; font-size: 12px;">✓ 已选</span>
                                            }
                                        </div>
                                        <p style="color: #4E5969; font-size: 12px; margin-bottom: 8px; min-height: 32px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @(string.IsNullOrEmpty(tpl.Description) ? "暂无描述" : tpl.Description)
                                        </p>
                                        <div style="color: #86909C; font-size: 12px;">
                                            🔧 @tpl.ServiceCount 服务 · 🌍 @tpl.EnvironmentCount 环境 · 📂 @tpl.CategoryCount 分类 · 📝 @tpl.CaseCount 用例
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="text-align: center; padding: 24px 0; color: #86909C; font-size: 13px;">暂无可用模板，可在项目列表中将已有项目「另存为模板」</div>
                        }
                    }
                </div>
            </div>
        }

        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;"><span Style="color: red;">*</span> 项目名称</label>
            <div Style="flex: 1;">
                <InputText class="h-input" @bind-Value="currentProject.Name" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: start;">
            <label Style="width: 100px; text-align: right; margin-right: 16px; margin-top: 6px;">项目描述</label>
            <div Style="flex: 1;">
                <InputTextArea class="h-textarea" rows="4" @bind-Value="currentProject.Description" />
            </div>
        </div>
        
        <div Style="margin-bottom: 16px; display: flex; align-items: center;">
            <label Style="width: 100px; text-align: right; margin-right: 16px;">状态</label>
            <div Style="flex: 1;">
                <select class="h-select" style="width: 100%;" value="@((int)currentProject.Status)" @onchange="@(e => currentProject.Status = (ProjectStatus)int.Parse(e.Value?.ToString() ?? "0"))">
                    <option value="@((int)ProjectStatus.Active)">活跃</option>
                    <option value="@((int)ProjectStatus.Inactive)">未激活</option>
                    <option value="@((int)ProjectStatus.Completed)">已完成</option>
                    <option value="@((int)ProjectStatus.Cancelled)">已取消</option>
                    <option value="@((int)ProjectStatus.OnHold)">暂停</option>
                </select>
            </div>
        </div>
    </div>
    
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideProjectModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveProject">@(isEditingProject ? "更新" : "保存")</button>
    </div>
</HModal>

<HModal Visible="showSaveAsTemplateModal" Title="另存为模板" OnCancel="HideSaveAsTemplateModal" ShowFooter="false" Style="width: 500px;">
    <div Style="padding: 8px 0;">
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">模板名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="saveTemplateInfo.Name" placeholder="请输入模板名称" />
            </div>
        </div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">模板描述</label>
            <div class="h-form-control" style="flex: 1;">
                <textarea class="h-textarea" rows="3" @bind="saveTemplateInfo.Description" placeholder="请输入模板描述"></textarea>
            </div>
        </div>
        <div Style="color: #86909C; font-size: 12px;">将项目 @(saveAsTemplateProject?.Name) 的服务、环境、用例分类与用例保存为可复用模板（不包含执行记录）</div>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideSaveAsTemplateModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveAsTemplate" disabled="@templateSaving">@(templateSaving ? "保存中..." : "保存")</button>
    </div>
</HModal>

<HModal Visible="showTemplateManagementModal" Title="📦 模板管理" OnCancel="HideTemplateManagementModal" ShowFooter="false" Style="width: 800px;">
    @if (templates.Any())
    {
        <HTable>
            <thead>
                <tr>
                    <th>模板名称</th>
                    <th>内容</th>
                    <th>更新时间</th>
                    <th style="width: 150px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tpl in templates)
                {
                    <tr>
                        <td>
                            <strong>@tpl.Name</strong>
                            @if (!string.IsNullOrEmpty(tpl.Description))
                            {
                                <br /><span Style="color: #86909C; font-size: 12px;">@tpl.Description</span>
                            }
                        </td>
                        <td Style="color: #4E5969; font-size: 13px;">@tpl.ServiceCount 服务 / @tpl.EnvironmentCount 环境 / @tpl.CategoryCount 分类 / @tpl.CaseCount 用例</td>
                        <td>@(tpl.ModificationTime.HasValue ? tpl.ModificationTime.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                        <td>
                            <div class="row-actions">
                                <a class="link-action" @onclick="() => ShowEditTemplateModal(tpl)">编辑</a>
                                <a class="link-action-danger" @onclick="() => DeleteTemplate(tpl)">删除</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </HTable>
    }
    else
    {
        <div Style="text-align: center; padding: 40px; color: #86909C;">
            <p>暂无模板，可在项目卡片的「⋯」菜单中将已有项目另存为模板</p>
        </div>
    }

    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideTemplateManagementModal">关闭</button>
    </div>
</HModal>

<HModal Visible="showEditTemplateModal" Title="编辑模板" OnCancel="HideEditTemplateModal" ShowFooter="false" Style="width: 500px;">
    <div Style="padding: 8px 0;">
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;"><span class="h-required">模板名称</span></label>
            <div class="h-form-control" style="flex: 1;">
                <input class="h-input" @bind-value="editTemplateInfo.Name" placeholder="请输入模板名称" />
            </div>
        </div>
        <div class="h-form-item">
            <label class="h-form-label" style="width: 100px;">模板描述</label>
            <div class="h-form-control" style="flex: 1;">
                <textarea class="h-textarea" rows="3" @bind="editTemplateInfo.Description" placeholder="请输入模板描述"></textarea>
            </div>
        </div>
    </div>
    <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 24px;">
        <button class="h-btn h-btn-default" @onclick="HideEditTemplateModal" Style="margin-right: 8px;">取消</button>
        <button class="h-btn h-btn-primary" @onclick="SaveEditTemplate">保存</button>
    </div>
</HModal>

<HModal Visible="showAiModal" Title="✨ AI 创建测试项目" OnCancel="HideAiModal" ShowFooter="false" Style="width: 800px;">
    @if (aiGenerated == null)
    {
        <div Style="padding: 8px 0;">
            <label Style="display: block; margin-bottom: 8px; font-weight: 500;">用口语描述你想创建的测试项目</label>
            <textarea class="h-textarea" rows="6" @bind="aiDescription" disabled="@aiGenerating"
                      placeholder="例如：帮我创建一个电商网站的测试项目，要覆盖登录注册、商品搜索、购物车和下单支付，重点关注支付异常和库存边界场景"></textarea>
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
            <div Style="color: #86909C; font-size: 12px; margin-top: 8px;">AI 将根据描述自动生成项目、用例分类与测试用例，生成后可预览确认。</div>
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="HideAiModal" Style="margin-right: 8px;">取消</button>
            <button class="h-btn" style="background-color: #722ED1; border-color: #722ED1; color: #fff;" @onclick="GenerateAiProject" disabled="@aiGenerating">
                @(aiGenerating ? "⏳ AI 生成中..." : "✨ 生成")
            </button>
        </div>
    }
    else
    {
        <div Style="padding: 8px 0; max-height: 480px; overflow-y: auto;">
            <div Style="margin-bottom: 12px;">
                <strong Style="font-size: 16px;">@aiGenerated.Name</strong>
                @if (!string.IsNullOrEmpty(aiGenerated.Description))
                {
                    <div Style="color: #4E5969; margin-top: 4px;">@aiGenerated.Description</div>
                }
            </div>
            @if (aiGenerated.Services.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">⚙️ 被测服务 (@aiGenerated.Services.Count)</div>
                    @foreach (var service in aiGenerated.Services)
                    {
                        <div Style="padding-left: 24px; color: #4E5969; font-size: 13px; margin-top: 2px;">
                            @service.Name
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <span Style="color: #86909C;">- @service.Description</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (aiGenerated.Environments.Any())
            {
                <div Style="margin-bottom: 12px;">
                    <div Style="font-weight: 500; margin-bottom: 6px;">🌐 测试环境 (@aiGenerated.Environments.Count)</div>
                    @foreach (var env in aiGenerated.Environments)
                    {
                        <div Style="padding-left: 24px; color: #4E5969; font-size: 13px; margin-top: 2px;">
                            @env.Name <span class="h-tag h-tag-blue" style="margin-left: 4px;">@GetAiEnvTypeName(env.Type)</span>
                            @foreach (var config in env.ServiceConfigs)
                            {
                                <span Style="color: #86909C; margin-left: 8px;">@GetAiServiceName(config.ServiceTempId): @config.BaseUrl</span>
                            }
                        </div>
                    }
                </div>
            }
            @foreach (var (category, depth) in GetAiCategoryDisplayList())
            {
                <div Style="padding: 6px 0; border-bottom: 1px solid #F2F3F5;">
                    <div Style="padding-left: @(depth * 20)px; font-weight: 500;">📁 @category.Name <span Style="color: #86909C; font-size: 12px; font-weight: normal;">(@(category.Cases.Count) 个用例)</span></div>
                    @foreach (var aiCase in category.Cases)
                    {
                        <div Style="padding-left: @(depth * 20 + 24)px; color: #4E5969; font-size: 13px; margin-top: 4px;">
                            📝 @aiCase.Name
                            @if (!string.IsNullOrEmpty(aiCase.Level))
                            {
                                <span class="h-tag h-tag-blue" style="margin-left: 4px;">@aiCase.Level</span>
                            }
                            @if (aiCase.Steps.Any())
                            {
                                <span Style="color: #86909C; font-size: 12px; margin-left: 4px;">(@aiCase.Steps.Count 个步骤)</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(aiError))
            {
                <div Style="color: #F53F3F; margin-top: 8px;">@aiError</div>
            }
        </div>
        <div Style="text-align: right; padding-top: 16px; border-top: 1px solid #F2F3F5; margin-top: 16px;">
            <button class="h-btn h-btn-default" @onclick="BackToAiInput" Style="margin-right: 8px;" disabled="@aiApplying">返回修改</button>
            <button class="h-btn h-btn-primary" @onclick="ConfirmCreateAiProject" disabled="@aiApplying">@(aiApplying ? "⏳ 创建中..." : "确认创建")</button>
        </div>
    }
</HModal>

@{
    var envModalTitle = $"环境管理 - {selectedProject?.Name}";
}
<HModal Visible="showEnvironmentModal" Title="@envModalTitle" OnCancel="HideEnvironmentModal" ShowFooter="false" Style="width: 1100px;">
    <div Style="display: flex; min-height: 600px;">
        <div Style="width: 280px; border-right: 1px solid #F2F3F5; padding: 16px; background-color: #F7F8FA;">
            <div Style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span Style="font-weight: 500;">环境列表</span>
                <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowAddEnvironmentModal">➕</button>
            </div>
            
            @if (projectEnvironments.Any())
            {
                <div Style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var env in projectEnvironments)
                    {
                        var isSelected = selectedEnvironment?.Id == env.Id;
                        var bgColor = isSelected ? "#165DFF" : "#fff";
                        var textColor = isSelected ? "#fff" : "#1D2129";
                        var subTextColor = isSelected ? "rgba(255,255,255,0.8)" : "#86909C";
                        var borderColor = isSelected ? "#165DFF" : "#E5E6EB";
                        
                        <div @onclick="() => SelectEnvironment(env)" 
                             Style="padding: 12px; border-radius: 4px; cursor: pointer; background-color: @bgColor; color: @textColor; border: 1px solid @borderColor;">
                            <div Style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div Style="font-weight: 600; margin-bottom: 4px;">@env.Name</div>
                                    <div Style="font-size: 12px; color: @subTextColor;">@GetEnvironmentTypeDisplayName(env.Type)</div>
                                </div>
                                <div style="position: relative;">
                                    <button class="h-btn h-btn-sm" style="background: transparent; border: none; color: inherit;" @onclick:stopPropagation @onclick="() => ToggleEnvDropdown(env.Id)">⋯</button>
                                    @if (openEnvDropdownId == env.Id)
                                    {
                                        <div class="h-dropdown-mask" @onclick="() => openEnvDropdownId = null" @onclick:stopPropagation></div>
                                        <div class="h-dropdown-panel">
                                            <div class="h-dropdown-item" @onclick="() => { openEnvDropdownId = null; EditEnvironment(env); }">编辑</div>
                                            <div class="h-dropdown-divider"></div>
                                            <div class="h-dropdown-item danger" @onclick="() => { openEnvDropdownId = null; DeleteEnvironment(env.Id); }">删除</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div Style="text-align: center; padding: 40px 20px; color: #86909C;">
                    <p>暂无环境</p>
                    <button class="h-btn h-btn-sm h-btn-default" @onclick="ShowAddEnvironmentModal">添加环境</button>
                </div>
            }
        </div>
        
        <div Style="flex: 1; padding: 16px;">
            @if (selectedEnvironment != null)
            {
                <div>
                    <div Style="margin-bottom: 24px; border: 1px solid #E5E6EB; border-radius: 4px;">
