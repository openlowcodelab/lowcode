@page "/testing/datasets"
@page "/testing/datasets/{projectId:long}"

@using Microsoft.AspNetCore.Components.Forms
@namespace H.Testing.Web
@layout TestingLayout

@inject IProjectAppService ProjectService
@inject ITestDatasetAppService DatasetService
@inject NavigationManager Navigation
@inject H.Util.Blazor.HToastService Toast

<PageTitle>数据集</PageTitle>

<div class="datasets-page">
    <div class="page-fill" style="flex-shrink:0;padding:12px 16px;">
        <div style="display:flex;gap:16px;align-items:center;">
            <div style="display:flex;align-items:center;gap:8px;">
                <span>选择项目:</span>
                <select class="h-select" style="width:200px;" value="@selectedProjectId" @onchange="OnProjectChanged">
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </div>
            <button class="h-btn" disabled="@(selectedProjectId == 0)" @onclick="OpenCreateModal">＋ 新建数据集</button>
            <span style="color:#86909C;font-size:12px;">数据驱动测试：执行时为每一行数据运行一次用例，行内列值注入为执行变量</span>
            @if (loading)
            {
                <span class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></span>
            }
        </div>
    </div>

    <div class="datasets-body">
        <div class="page-fill">
            <HCard Title="🧪 数据集列表">
                <Body>
                    @if (selectedProjectId == 0)
                    {
                        <div class="h-empty" style="padding:60px 0;">暂无项目，请先创建测试项目</div>
                    }
                    else if (!datasets.Any())
                    {
                        <div class="h-empty" style="padding:60px 0;">
                            暂无数据集。创建数据集（支持 CSV 粘贴/导入）后，可在执行页选择数据集进行数据驱动执行
                        </div>
                    }
                    else
                    {
                        <table class="h-table">
                            <thead>
                                <tr>
                                    <th>名称</th>
                                    <th style="width:260px;">数据列</th>
                                    <th style="width:80px;">行数</th>
                                    <th style="width:120px;">创建时间</th>
                                    <th style="width:110px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dataset in datasets)
                                {
                                    <tr>
                                        <td>@dataset.Name</td>
                                        <td style="color:#86909C;font-size:12px;">@string.Join(", ", dataset.Columns.Take(6))@(dataset.Columns.Count > 6 ? " ..." : "")</td>
                                        <td>@dataset.RowCount</td>
                                        <td style="color:#86909C;font-size:12px;">@dataset.CreationTime.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="row-actions">
                                                <a class="link-action" @onclick="() => OpenEditModal(dataset.Id)">编辑</a>
                                                <a class="link-action-danger" @onclick="() => DeleteDataset(dataset.Id)">删除</a>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </Body>
            </HCard>
        </div>
    </div>
</div>

<HModal Visible="@showModal"
        Title="@(editingDatasetId == 0 ? "新建数据集" : "编辑数据集")"
        OnCancel="CloseModal"
        ShowFooter="false"
        Style="width:760px;">
    <div style="margin-bottom:12px;">
        <div style="margin-bottom:4px;">数据集名称 <span style="color:#F53F3F;">*</span></div>
        <input class="h-input" style="width:100%;" @bind="formName" maxlength="50" placeholder="如：登录账号数据集" />
    </div>

    <div style="margin-bottom:8px;">
        <div style="margin-bottom:4px;">CSV 数据（首行为列名，支持选择文件或直接粘贴）</div>
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
            <InputFile OnChange="OnFileSelected" style="font-size:12px;" />
            <button class="h-btn h-btn-sm" @onclick="ParseCsv">解析预览</button>
            <span style="color:#86909C;font-size:12px;">示例：username,password</span>
        </div>
        <textarea class="h-input" style="width:100%;min-height:120px;resize:vertical;font-family:monospace;font-size:12px;"
                  @bind="csvText" placeholder="username,password&#10;user1,pass1&#10;user2,pass2"></textarea>
    </div>

    @if (previewRows.Count > 0)
    {
        <div style="margin-bottom:12px;">
            <div style="margin-bottom:4px;font-weight:500;">解析预览（@previewRows.Count 行）</div>
            <div style="max-height:200px;overflow:auto;border:1px solid #F2F3F5;border-radius:4px;">
                <table class="h-table">
                    <thead>
                        <tr>
                            @foreach (var col in previewColumns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in previewRows.Take(20))
                        {
                            <tr>
                                @foreach (var col in previewColumns)
                                {
                                    <td style="font-size:12px;">@(row.GetValueOrDefault(col, ""))</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (previewRows.Count > 20)
            {
                <div style="color:#86909C;font-size:12px;margin-top:4px;">预览前 20 行，共 @previewRows.Count 行</div>
            }
        </div>
    }
    else if (previewAttempted)
    {
        <div class="h-alert h-alert-error" style="margin-bottom:12px;">未能解析出数据，请检查 CSV 格式（首行为列名，至少两行）</div>
    }

    <div style="text-align:right;padding-top:12px;border-top:1px solid #F2F3F5;">
        <button class="h-btn" style="margin-right:8px;" @onclick="CloseModal">取消</button>
        <button class="h-btn" style="background-color:#165DFF;border-color:#165DFF;color:white;" disabled="@saving" @onclick="SaveDataset">
            @(saving ? "保存中..." : "保存")
        </button>
    </div>
</HModal>

@code {
    [Parameter] public long ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private long selectedProjectId;
    private List<TestDatasetDto> datasets = new();
    private bool loading = true;

    private bool showModal;
    private bool saving;
    private long editingDatasetId;
    private string formName = string.Empty;
    private string csvText = string.Empty;
    private bool previewAttempted;
    private List<string> previewColumns = new();
    private List<Dictionary<string, string>> previewRows = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        try
        {
            projects = (await ProjectService.GetAllAsync()).Data ?? [];

            if (projects.Count == 0)
            {
                loading = false;
                return;
            }

            selectedProjectId = ProjectId != 0 && projects.Any(p => p.Id == ProjectId)
                ? ProjectId
                : projects[0].Id;

            await LoadDatasets();
        }
        catch (Exception ex)
        {
            Toast.Error($"加载项目失败: {ex.Message}");
            loading = false;
        }
    }

    private async Task LoadDatasets()
    {
        if (selectedProjectId == 0)
        {
            datasets = new List<TestDatasetDto>();
            loading = false;
            return;
        }

        try
        {
            loading = true;
            datasets = (await DatasetService.GetByProjectIdAsync(selectedProjectId)).Data ?? [];
        }
        catch (Exception ex)
        {
            Toast.Error($"加载数据集失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var projectId))
        {
            selectedProjectId = projectId;
            await LoadDatasets();
        }
    }

    private void OpenCreateModal()
    {
        editingDatasetId = 0;
        formName = string.Empty;
        csvText = string.Empty;
        ResetPreview();
        showModal = true;
    }

    private async Task OpenEditModal(long datasetId)
    {
        try
        {
            var detail = (await DatasetService.GetByIdAsync(datasetId)).Data;
            if (detail == null)
            {
                Toast.Error("数据集不存在");
                return;
            }

            editingDatasetId = datasetId;
            formName = detail.Name;
            csvText = ToCsv(detail.Columns, detail.Rows);
            ResetPreview();
            ParseCsv();
            showModal = true;
        }
        catch (Exception ex)
        {
            Toast.Error($"加载数据集失败: {ex.Message}");
        }
    }

    private void CloseModal() => showModal = false;

    private void ResetPreview()
    {
        previewAttempted = false;
        previewColumns = new List<string>();
        previewRows = new List<Dictionary<string, string>>();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 2 * 1024 * 1024)
            {
                Toast.Error("文件过大，请选择不超过 2MB 的 CSV 文件");
                return;
            }

            using var reader = new StreamReader(file.OpenReadStream(2 * 1024 * 1024));
            csvText = await reader.ReadToEndAsync();
            ParseCsv();
        }
        catch (Exception ex)
        {
            Toast.Error($"读取文件失败: {ex.Message}");
        }
    }

    private void ParseCsv()
    {
        previewAttempted = true;
        previewColumns = new List<string>();
        previewRows = new List<Dictionary<string, string>>();

        var lines = csvText.Replace("\r", "").Split('\n')
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        if (lines.Count < 2)
        {
            return;
        }

        previewColumns = ParseCsvLine(lines[0]);
        if (previewColumns.Count == 0)
        {
            return;
        }

        foreach (var line in lines.Skip(1))
        {
            var values = ParseCsvLine(line);
            var row = new Dictionary<string, string>();
            for (var i = 0; i < previewColumns.Count; i++)
            {
                row[previewColumns[i]] = i < values.Count ? values[i] : string.Empty;
            }
            previewRows.Add(row);
        }
    }

    /// <summary>
    /// 简易 CSV 行解析（支持双引号包裹与引号转义）
    /// </summary>
    private static List<string> ParseCsvLine(string line)
    {
        var fields = new List<string>();
        var current = new System.Text.StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];

            if (inQuotes)
            {
                if (ch == '"')
                {
                    if (i + 1 < line.Length && line[i + 1] == '"')
                    {
                        current.Append('"');
                        i++;
                    }
                    else
                    {
                        inQuotes = false;
                    }
                }
                else
                {
                    current.Append(ch);
                }
            }
            else if (ch == '"')
            {
                inQuotes = true;
            }
            else if (ch == ',')
            {
                fields.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(ch);
            }
        }

        fields.Add(current.ToString());
        return fields;
    }

    private static string ToCsv(List<string> columns, List<Dictionary<string, string>> rows)
    {
        var lines = new List<string> { string.Join(",", columns.Select(EscapeCsv)) };
        foreach (var row in rows)
        {
            lines.Add(string.Join(",", columns.Select(c => EscapeCsv(row.GetValueOrDefault(c, "")))));
        }
        return string.Join("\n", lines);
    }

    private static string EscapeCsv(string value)
        => value.Contains(',') || value.Contains('"') || value.Contains('\n')
            ? "\"" + value.Replace("\"", "\"\"") + "\""
            : value;

    private async Task SaveDataset()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            Toast.Error("请输入数据集名称");
            return;
        }

        if (!previewAttempted || previewRows.Count == 0)
        {
            ParseCsv();
            if (previewRows.Count == 0)
            {
                Toast.Error("请先填写并解析 CSV 数据");
                return;
            }
        }

        var dto = new TestDatasetDto
        {
            ProjectId = selectedProjectId,
            Name = formName.Trim(),
            Columns = previewColumns,
            Rows = previewRows
        };

        try
        {
            saving = true;

            if (editingDatasetId == 0)
            {
                var created = await DatasetService.CreateAsync(dto);
                if (created.Success)
                {
                    Toast.Success($"数据集创建成功（{previewRows.Count} 行）");
                    showModal = false;
                    await LoadDatasets();
                }
                else
                {
                    Toast.Error(created.Message ?? "创建失败");
                }
            }
            else
            {
                var updated = await DatasetService.UpdateAsync(editingDatasetId, dto);
                if (updated.Success && updated.Data)
                {
                    Toast.Success("数据集已更新");
                    showModal = false;
                    await LoadDatasets();
                }
                else
                {
                    Toast.Error(updated.Message ?? "更新失败");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteDataset(long datasetId)
    {
        try
        {
            var result = await DatasetService.DeleteAsync(datasetId);
            if (result.Success && result.Data)
            {
                Toast.Success("数据集已删除");
                await LoadDatasets();
            }
            else
            {
                Toast.Error(result.Message ?? "删除失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"删除失败: {ex.Message}");
        }
    }
}
