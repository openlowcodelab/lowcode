@page "/testing/execution-history/{testCaseId:long}"

@namespace H.Testing.Web
@layout TestingLayout

@inject ICaseAppService ProjectCaseService
@inject IExecutionRecordAppService ExecutionRecordService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>执行历史记录</PageTitle>

<div style="display:flex;gap:16px;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <div>
        <div style="font-size:18px;font-weight:600;margin-bottom:4px;">📊 执行历史记录</div>
        <nav style="margin-bottom:0;"><a href="/testing/project-cases" style="color:#165DFF;">测试用例</a> / <span>执行历史</span></nav>
    </div>
    <span class="h-space">
        <button class="h-btn h-btn-default" @onclick="RefreshData">🔄 刷新</button>
        <button class="h-btn h-btn-default" @onclick="GoBack">← 返回</button>
    </span>
</div>

@if (loading)
{
    <div style="text-align:center;padding:60px 0;">
        <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">正在加载执行历史...</span></div>
    </div>
}
else if (testCase == null)
{
    <div class="h-alert h-alert-error">未找到指定的测试用例</div>
}
else
{
    <div style="display:flex;gap:16px;">
        <div style="flex:0 0 33.33%;">
            <HCard Title="📋 测试用例信息" Style="margin-bottom:16px;">
                <Body>
                    <table class="h-descriptions">
                        <tr><th>用例名称</th><td>@testCase.Name</td></tr>
                        <tr><th>描述</th><td>@(string.IsNullOrEmpty(testCase.Description) ? "无" : testCase.Description)</td></tr>
                        <tr><th>步骤数量</th><td>@testCase.Steps.Count</td></tr>
                        <tr>
                            <th>测试级别</th>
                            <td>
                                @if (testCase.Levels.Any())
                                {
                                    @foreach (var level in testCase.Levels)
                                    {
                                        <span class="h-tag h-tag-@GetLevelTagClass(level)" style="margin-right:4px;">@level</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:#86909C;">无</span>
                                }
                            </td>
                        </tr>
                    </table>
                </Body>
            </HCard>

            <HCard Title="📈 执行统计">
                <Body>
                    <div style="display:flex;gap:8px;">
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#165DFF;font-weight:500;">@executionRecords.Count</div>
                            <div style="color:#86909C;font-size:12px;">总执行次数</div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#00B42A;font-weight:500;">@executionRecords.Count(r => r.Status == ExecutionStatus.Success)</div>
                            <div style="color:#86909C;font-size:12px;">成功次数</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-top:16px;">
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#F53F3F;font-weight:500;">@executionRecords.Count(r => r.Status == ExecutionStatus.Failed)</div>
                            <div style="color:#86909C;font-size:12px;">失败次数</div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            @{
                                var successRate = executionRecords.Count > 0
                                    ? (double)executionRecords.Count(r => r.Status == ExecutionStatus.Success) / executionRecords.Count * 100
                                    : 0;
                                var successRateColor = successRate >= 80 ? "#00B42A" : successRate >= 60 ? "#FF7D00" : "#F53F3F";
                            }
                            <div style="font-size:24px;color:@successRateColor;font-weight:500;">@successRate.ToString("F1")%</div>
                            <div style="color:#86909C;font-size:12px;">成功率</div>
                        </div>
                    </div>

                    @if (executionRecords.Any())
                    {
                        var avgDuration = executionRecords
                            .Where(r => r.Duration > 0)
                            .Select(r => (double)r.Duration)
                            .DefaultIfEmpty(0)
                            .Average();
                        <div style="margin-top:16px;text-align:center;padding-top:12px;border-top:1px solid #F2F3F5;">
                            <div style="font-size:16px;color:#13c2c2;">@(avgDuration.ToString("F0"))ms</div>
                            <small style="color:#86909C;">平均执行时间</small>
                        </div>
                    }
                </Body>
            </HCard>
        </div>

        <div style="flex:1;">
            <HCard>
                <TitleTemplate>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span>🕒 执行记录列表</span>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="font-size:13px;font-weight:normal;">筛选状态:</span>
                            <select class="h-select" style="width:120px;" value="@statusFilter" @onchange="HandleStatusFilterChange">
                                <option value="">全部</option>
                                <option value="Success">成功</option>
                                <option value="Failed">失败</option>
                                <option value="Running">执行中</option>
                                <option value="Cancelled">已取消</option>
                            </select>
                        </div>
                    </div>
                </TitleTemplate>
                <Body>
                    @if (!filteredRecords.Any())
                    {
                        <div class="h-empty">暂无执行记录</div>
                    }
                    else
                    {
                        <div style="max-height:600px;overflow-y:auto;">
                            @foreach (var record in filteredRecords.Take(20))
                            {
                                var isSelected = selectedRecordId == record.Id;
                                <div style="@($"padding:12px;border:1px solid {(isSelected ? "#165DFF" : "#F2F3F5")};border-radius:4px;margin-bottom:8px;cursor:pointer;background:{(isSelected ? "#E8F3FF" : "#fff")};")"
                                     @onclick="() => SelectRecord(record.Id)">
                                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                                        <div style="flex:1;">
                                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                                                <span class="h-tag h-tag-@GetExecutionStatusTagClass(record.Status)">@GetExecutionStatusDisplayName(record.Status)</span>
                                                <strong>@record.EnvironmentName</strong>
                                                <span style="color:#86909C;font-size:12px;">@record.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                            </div>
                                            <div style="color:#4E5969;font-size:12px;">
                                                步骤: @record.SuccessSteps 成功 / @record.FailedSteps 失败 / @record.SkippedSteps 跳过
                                                @if (record.Duration > 0)
                                                {
                                                    <span style="margin-left:8px;">耗时: @(record.Duration)ms</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(record.ErrorMessage))
                                            {
                                                <div style="color:#F53F3F;font-size:12px;margin-top:4px;">
                                                    ⚠ @record.ErrorMessage
                                                </div>
                                            }
                                        </div>
                                        <span class="row-actions">
                                            <a class="link-action"
                                               @onclick="@(async (MouseEventArgs e) => { await JSRuntime.InvokeVoidAsync("event.stopPropagation"); SelectRecord(record.Id); })">
                                                查看详情
                                            </a>
                                            <a class="link-action-danger"
                                               @onclick="@(async (MouseEventArgs e) => await DeleteRecord(record.Id))">
                                                删除
                                            </a>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (filteredRecords.Count > 20)
                        {
                            <div style="padding:12px;text-align:center;color:#86909C;">
                                显示前 20 条记录，共 @filteredRecords.Count 条
                            </div>
                        }
                    }
                </Body>
            </HCard>
        </div>
    </div>

    <HModal Visible="@(selectedRecord != null)"
            Title="@($"执行详情 - {selectedRecord?.StartTime.ToString("yyyy-MM-dd HH:mm:ss")}")"
            OnCancel="CloseModal"
            ShowFooter="false"
            Style="width:1000px;">
        @if (selectedRecord != null)
        {
            <div style="margin-bottom:16px;">
                <span class="h-tag h-tag-@GetExecutionStatusTagClass(selectedRecord.Status)">
                    @GetExecutionStatusDisplayName(selectedRecord.Status)
                </span>
            </div>

            <div style="display:flex;gap:16px;margin-bottom:16px;">
                <div style="flex:1;text-align:center;">
                    <div style="font-size:24px;color:#165DFF;font-weight:500;">@selectedRecord.TotalSteps</div>
                    <div style="color:#86909C;font-size:12px;">总步骤</div>
                </div>
                <div style="flex:1;text-align:center;">
                    <div style="font-size:24px;color:#00B42A;font-weight:500;">@selectedRecord.SuccessSteps</div>
                    <div style="color:#86909C;font-size:12px;">成功</div>
                </div>
                <div style="flex:1;text-align:center;">
                    <div style="font-size:24px;color:#F53F3F;font-weight:500;">@selectedRecord.FailedSteps</div>
                    <div style="color:#86909C;font-size:12px;">失败</div>
                </div>
                <div style="flex:1;text-align:center;">
                    <div style="font-size:24px;color:#13c2c2;font-weight:500;">@selectedRecord.Duration</div>
                    <div style="color:#86909C;font-size:12px;">执行时间 (ms)</div>
                </div>
            </div>

            <HCard Title="环境信息" Style="margin-bottom:16px;">
                <Body>
                    <table class="h-descriptions">
                        <tr><th>环境名称</th><td>@selectedRecord.EnvironmentName</td></tr>
                        <tr><th>环境ID</th><td>@selectedRecord.EnvironmentId</td></tr>
                    </table>
                </Body>
            </HCard>

            @if (!string.IsNullOrEmpty(selectedRecord.ErrorMessage))
            {
                <div class="h-alert h-alert-error" style="margin-bottom:16px;">
                    <strong>错误信息</strong>
                    <div>@selectedRecord.ErrorMessage</div>
                </div>
            }

            @if (selectedRecord.StepRecords.Any())
            {
                <div style="font-weight:600;margin-bottom:8px;">步骤执行详情</div>
                @foreach (var stepRecord in selectedRecord.StepRecords.OrderBy(s => s.Order))
                {
                    <details style="border:1px solid #F2F3F5;border-radius:4px;margin-bottom:8px;">
                        <summary style="padding:10px 12px;cursor:pointer;display:flex;align-items:center;gap:8px;">
                            <span class="h-tag h-tag-@GetStepStatusTagClass(stepRecord.Status)">@stepRecord.Order</span>
                            <strong>@stepRecord.StepName</strong>
                            <span class="h-tag">@stepRecord.StepType</span>
                            <span class="h-tag h-tag-@GetStepStatusTagClass(stepRecord.Status)">@GetStepStatusDisplayName(stepRecord.Status)</span>
                            @if (stepRecord.Duration > 0)
                            {
                                <span style="color:#86909C;font-size:12px;margin-left:auto;">@(stepRecord.Duration)ms</span>
                            }
                        </summary>
                        <div style="padding:0 12px 12px;">
                            @if (!string.IsNullOrEmpty(stepRecord.ErrorMessage))
                            {
                                <div class="h-alert h-alert-error" style="margin-bottom:12px;">
                                    <strong>错误</strong>
                                    <div>@stepRecord.ErrorMessage</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(stepRecord.RequestData))
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">请求数据</div>
                                    <pre style="background:#F7F8FA;padding:8px;border-radius:4px;border:1px solid #F2F3F5;white-space:pre-wrap;word-break:break-all;"><code>@stepRecord.RequestData</code></pre>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(stepRecord.ResponseData))
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">响应数据</div>
                                    <pre style="background:#F7F8FA;padding:8px;border-radius:4px;border:1px solid #F2F3F5;white-space:pre-wrap;word-break:break-all;"><code>@stepRecord.ResponseData</code></pre>
                                </div>
                            }

                            @if (stepRecord.AssertionResults.Any())
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">断言结果</div>
                                    @foreach (var assertion in stepRecord.AssertionResults)
                                    {
                                        <div style="display:flex;align-items:center;margin-bottom:4px;gap:8px;">
                                            <span class="h-tag h-tag-@(assertion.Passed ? "green" : "red")">
                                                @(assertion.Passed ? "✓" : "✗")
                                            </span>
                                            <span>@assertion.Expression</span>
                                            <span>@assertion.Operator</span>
                                            <span>@assertion.Expected</span>
                                            @if (!assertion.Passed)
                                            {
                                                <span style="color:#F53F3F;">(实际: @assertion.Actual)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (stepRecord.ExtractedVariables.Any())
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">提取的变量</div>
                                    @foreach (var variable in stepRecord.ExtractedVariables)
                                    {
                                        <div style="margin-bottom:2px;">
                                            <strong>@variable.Key:</strong> @variable.Value
                                        </div>
                                    }
                                </div>
                            }

                            @if (stepRecord.Logs.Any())
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">执行日志</div>
                                    <div style="background:#1e1e1e;color:#d4d4d4;padding:8px;border-radius:4px;max-height:200px;overflow-y:auto;font-family:monospace;font-size:12px;">
                                        @foreach (var log in stepRecord.Logs)
                                        {
                                            <div>@log</div>
                                        }
                                    </div>
                                </div>
                            }

                            @{
                                var screenshotPaths = GetScreenshotPaths(testCase.ProjectId, testCase.Id, stepRecord.StepId);
                            }
                            @if (screenshotPaths.Any())
                            {
                                <div style="margin-bottom:12px;">
                                    <div style="font-weight:600;margin-bottom:4px;">截图</div>
                                    <div style="display:flex;flex-wrap:wrap;gap:8px;">
                                        @foreach (var screenshotPath in screenshotPaths)
                                        {
                                            <div style="background:#fff;border:1px solid #E5E6EB;border-radius:8px;margin-bottom:8px;flex:0 0 calc(50% - 4px);padding:8px;">
                                                <img src="@GetRelativeScreenshotPath(screenshotPath)" alt="截图"
                                                     style="width:100%;max-height:200px;object-fit:contain;" />
                                                <div style="padding:4px;font-size:12px;color:#86909C;text-align:center;">
                                                    @Path.GetFileName(screenshotPath)
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                }
            }

            <div style="text-align:right;margin-top:16px;padding-top:12px;border-top:1px solid #F2F3F5;">
                <button class="h-btn" @onclick="CloseModal">关闭</button>
            </div>
        }
    </HModal>
}

@code {
    [Parameter] public long TestCaseId { get; set; }

    private CaseDto? testCase;
    private List<CaseExecutionRecordDto> executionRecords = new();
    private List<CaseExecutionRecordDto> filteredRecords = new();
    private bool loading = true;
    private string statusFilter = string.Empty;
    private long selectedRecordId = 0;
    private CaseExecutionRecordDto? selectedRecord;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;

            testCase = await ProjectCaseService.GetByIdAsync(TestCaseId);

            if (testCase != null)
            {
                executionRecords = await ExecutionRecordService.GetByTestCaseIdAsync(testCase.ProjectId, TestCaseId);
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"加载数据失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void HandleStatusFilterChange(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(statusFilter))
        {
            filteredRecords = executionRecords.OrderByDescending(r => r.StartTime).ToList();
        }
        else
        {
            if (Enum.TryParse<ExecutionStatus>(statusFilter, out var status))
            {
                filteredRecords = executionRecords
                    .Where(r => r.Status == status)
                    .OrderByDescending(r => r.StartTime)
                    .ToList();
            }
        }
        StateHasChanged();
    }

    private void SelectRecord(long recordId)
    {
        selectedRecordId = recordId;
        selectedRecord = executionRecords.FirstOrDefault(r => r.Id == recordId);
        StateHasChanged();
    }

    private async Task DeleteRecord(long recordId)
    {
        if (testCase == null) return;

        try
        {
            var success = await ExecutionRecordService.DeleteAsync(testCase.ProjectId, recordId);
            if (success)
            {
                if (selectedRecordId == recordId)
                {
                    selectedRecordId = 0;
                    selectedRecord = null;
                }

                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "删除失败");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"删除出错: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        selectedRecordId = 0;
        selectedRecord = null;
        StateHasChanged();
    }

    private void GoBack()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParameters = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var returnProjectId = queryParameters["returnProjectId"];

        if (!string.IsNullOrEmpty(returnProjectId))
        {
            Navigation.NavigateTo($"/testing/project-cases/{returnProjectId}");
        }
        else
        {
            Navigation.NavigateTo("/testing/project-cases");
        }
    }

    private List<string> GetScreenshotPaths(long projectId, long testCaseId, string stepId)
    {
        var screenshotPaths = new List<string>();

        var screenshotDir = Path.Combine(AppContext.BaseDirectory, "testing-screenshots", projectId.ToString(), testCaseId.ToString());

        if (Directory.Exists(screenshotDir))
        {
            var screenshotFiles = Directory.GetFiles(screenshotDir, $"*{stepId}*.png");
            screenshotPaths.AddRange(screenshotFiles);
        }

        return screenshotPaths;
    }

    private string GetRelativeScreenshotPath(string fullPath)
    {
        var relativePath = fullPath.Replace("\\", "/").Replace(Directory.GetCurrentDirectory(), "");
        if (relativePath.StartsWith("/"))
        {
            relativePath = relativePath.Substring(1);
        }
        return $"/{relativePath}";
    }

    private string GetLevelTagClass(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        "P3" => "default",
        _ => "default"
    };

    private string GetExecutionStatusTagClass(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "green",
        ExecutionStatus.Failed => "red",
        ExecutionStatus.Running => "blue",
        ExecutionStatus.Cancelled => "orange",
        _ => "default"
    };

    private string GetExecutionStatusDisplayName(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "执行中",
        ExecutionStatus.Cancelled => "已取消",
        _ => "未知"
    };

    private string GetStepStatusTagClass(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "green",
        StepExecutionStatus.Failed => "red",
        StepExecutionStatus.Running => "blue",
        StepExecutionStatus.Skipped => "orange",
        _ => "default"
    };

    private string GetStepStatusDisplayName(StepExecutionStatus status) => status switch
    {
        StepExecutionStatus.Success => "成功",
        StepExecutionStatus.Failed => "失败",
        StepExecutionStatus.Running => "执行中",
        StepExecutionStatus.Skipped => "跳过",
        _ => "未知"
    };
}
