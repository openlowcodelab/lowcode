@page "/testing/plans/detail/{planId:long}"

@namespace H.Testing.Web
@layout TestingLayout

@inject ITestPlanAppService TestPlanService
@inject ICaseAppService ProjectCaseService
@inject NavigationManager Navigation
@inject H.Util.Blazor.HToastService Toast

<PageTitle>计划详情</PageTitle>

<div class="plan-detail-page">
@if (loading)
{
    <div class="page-fill" style="flex:1;text-align:center;padding:60px 20px;">
        <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">正在加载计划详情...</span></div>
    </div>
}
else if (detail == null)
{
    <div class="page-fill" style="flex:1;"><div class="h-alert h-alert-error">未找到指定的测试计划</div></div>
}
else
{
    var plan = detail.Plan;
    <div class="plan-detail-body">
        <div class="page-fill">
            <HCard>
                <TitleTemplate>
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span>🗓️ @plan.Name</span>
                            <span class="h-tag h-tag-@GetPlanStatusTagClass(plan.Status)">@GetPlanStatusDisplayName(plan.Status)</span>
                        </div>
                        <div style="display:flex;gap:8px;">
                            <button class="h-btn h-btn-sm" @onclick="GoBack">← 返回列表</button>
                            <button class="h-btn h-btn-sm" @onclick="OpenAddCasesModal">＋ 添加用例</button>
                            <button class="h-btn h-btn-sm" style="background-color:#00B42A;border-color:#00B42A;color:white;"
                                    disabled="@(!detail.Cases.Any())" @onclick="ExecutePlan">
                                ▶ 执行计划
                            </button>
                        </div>
                    </div>
                </TitleTemplate>
                <Body>
                    <div style="display:flex;gap:24px;margin-bottom:16px;flex-wrap:wrap;">
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                            <div style="color:#4E5969;flex:1;min-width:240px;">@plan.Description</div>
                        }
                        <div style="color:#86909C;">
                            起止：@(plan.StartDate?.ToString("yyyy-MM-dd") ?? "-") ~ @(plan.DueDate?.ToString("yyyy-MM-dd") ?? "-")
                        </div>
                    </div>

                    <div style="display:flex;gap:16px;margin-bottom:16px;">
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#165DFF;font-weight:500;">@plan.TotalCases</div>
                            <div style="color:#86909C;font-size:12px;">用例总数</div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#00B42A;font-weight:500;">@plan.PassedCases</div>
                            <div style="color:#86909C;font-size:12px;">已通过</div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#F53F3F;font-weight:500;">@plan.FailedCases</div>
                            <div style="color:#86909C;font-size:12px;">失败</div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            <div style="font-size:24px;color:#FF7D00;font-weight:500;">@(plan.TotalCases - plan.PassedCases - plan.FailedCases)</div>
                            <div style="color:#86909C;font-size:12px;">未开始/阻塞</div>
                        </div>
                    </div>

                    <div style="margin-bottom:8px;">
                        <div style="display:flex;justify-content:space-between;color:#86909C;font-size:12px;margin-bottom:4px;">
                            <span>通过率</span>
                            <span>@plan.PassedCases / @plan.TotalCases (@plan.PassRate.ToString("F1")%)</span>
                        </div>
                        <div style="background:#F2F3F5;border-radius:4px;height:8px;overflow:hidden;">
                            <div style="background:#00B42A;height:100%;border-radius:4px;width:@(plan.PassRate.ToString("F1"))%;transition:width 0.3s;"></div>
                        </div>
                    </div>
                </Body>
            </HCard>

            <HCard Title="计划内用例" Style="margin-top:2px;">
                <Body>
                    @if (!detail.Cases.Any())
                    {
                        <div class="h-empty" style="padding:40px 0;">计划内暂无用例，点击"添加用例"从项目中选择</div>
                    }
                    else
                    {
                        <table class="h-table">
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th>用例名称</th>
                                    <th style="width:70px;">级别</th>
                                    <th style="width:180px;">负责人</th>
                                    <th style="width:90px;">状态</th>
                                    <th style="width:160px;">最近执行时间</th>
                                    <th style="width:110px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < detail.Cases.Count; i++)
                                {
                                    var planCase = detail.Cases[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@planCase.CaseName</td>
                                        <td><span class="h-tag h-tag-@GetLevelTagClass(planCase.Level.ToString())">@planCase.Level</span></td>
                                        <td>
                                            <input class="h-input" style="width:100%;font-size:12px;" value="@planCase.Assignee"
                                                   placeholder="指派负责人"
                                                   @onchange="@((ChangeEventArgs e) => SaveAssignee(planCase, e.Value?.ToString() ?? ""))" />
                                        </td>
                                        <td>
                                            <span class="h-tag h-tag-@GetPlanCaseStatusTagClass(planCase.Status)">@GetPlanCaseStatusDisplayName(planCase.Status)</span>
                                        </td>
                                        <td style="color:#86909C;font-size:12px;">@(planCase.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                        <td>
                                            <span class="row-actions">
                                                <a class="link-action" @onclick="() => GoToCaseHistory(planCase.CaseId)">执行历史</a>
                                                <a class="link-action-danger" @onclick="() => RemovePlanCase(planCase.Id)">移除</a>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </Body>
            </HCard>
        </div>
    </div>
}
</div>

<HModal Visible="@showAddCasesModal"
        Title="添加用例到计划"
        OnCancel="CloseAddCasesModal"
        ShowFooter="false"
        Style="width:520px;">
    @if (!availableCases.Any())
    {
        <div class="h-empty" style="padding:24px 0;">项目内没有可添加的用例（均已在计划中）</div>
    }
    else
    {
        <div style="margin-bottom:8px;">
            <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                <input type="checkbox" checked="@IsAllAvailableSelected" @onchange="@((ChangeEventArgs e) => ToggleSelectAllAvailable((bool)(e.Value ?? false)))" />
                全选
            </label>
        </div>
        <div style="max-height:320px;overflow-y:auto;border:1px solid #F2F3F5;border-radius:4px;padding:8px;">
            @foreach (var testCase in availableCases)
            {
                <div style="margin-bottom:4px;">
                    <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                        <input type="checkbox" checked="@selectedCaseIds.Contains(testCase.Id)"
                               @onchange="@((ChangeEventArgs e) => ToggleCaseSelection(testCase.Id, (bool)(e.Value ?? false)))" />
                        @testCase.Name
                        <span class="h-tag h-tag-@GetLevelTagClass(testCase.Level.ToString())" style="margin-left:4px;">@testCase.Level</span>
                    </label>
                </div>
            }
        </div>
    }
    <div style="text-align:right;margin-top:12px;padding-top:12px;border-top:1px solid #F2F3F5;">
        <button class="h-btn" style="margin-right:8px;" @onclick="CloseAddCasesModal">取消</button>
        <button class="h-btn" style="background-color:#165DFF;border-color:#165DFF;color:white;"
                disabled="@(!selectedCaseIds.Any())" @onclick="AddSelectedCases">
            添加 @selectedCaseIds.Count 个用例
        </button>
    </div>
</HModal>

@code {
    [Parameter] public long PlanId { get; set; }

    private bool loading = true;
    private TestPlanDetailDto? detail;

    private bool showAddCasesModal;
    private List<CaseDto> availableCases = new();
    private HashSet<long> selectedCaseIds = new();

    private bool IsAllAvailableSelected => availableCases.Any() && selectedCaseIds.Count == availableCases.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        try
        {
            loading = true;
            detail = (await TestPlanService.GetDetailAsync(PlanId)).Data;
        }
        catch (Exception ex)
        {
            Toast.Error($"加载计划详情失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddCasesModal()
    {
        if (detail == null) return;

        try
        {
            var allCases = (await ProjectCaseService.GetByProjectIdAsync(detail.Plan.ProjectId)).Data ?? [];
            var inPlanCaseIds = detail.Cases.Select(c => c.CaseId).ToHashSet();
            availableCases = allCases.Where(c => !c.IsTemplate && !inPlanCaseIds.Contains(c.Id)).ToList();
            selectedCaseIds = new HashSet<long>();
            showAddCasesModal = true;
        }
        catch (Exception ex)
        {
            Toast.Error($"加载用例列表失败: {ex.Message}");
        }
    }

    private void CloseAddCasesModal() => showAddCasesModal = false;

    private void ToggleSelectAllAvailable(bool selected)
    {
        selectedCaseIds = selected
            ? availableCases.Select(c => c.Id).ToHashSet()
            : new HashSet<long>();
    }

    private void ToggleCaseSelection(long caseId, bool selected)
    {
        if (selected)
        {
            selectedCaseIds.Add(caseId);
        }
        else
        {
            selectedCaseIds.Remove(caseId);
        }
    }

    private async Task AddSelectedCases()
    {
        try
        {
            var result = await TestPlanService.AddCasesAsync(PlanId, selectedCaseIds.ToList());
            if (result.Success)
            {
                Toast.Success($"已添加 {result.Data} 个用例");
                showAddCasesModal = false;
                await LoadDetail();
            }
            else
            {
                Toast.Error(result.Message ?? "添加失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"添加失败: {ex.Message}");
        }
    }

    private async Task SaveAssignee(PlanCaseDto planCase, string assignee)
    {
        if (planCase.Assignee == assignee) return;

        try
        {
            var result = await TestPlanService.UpdateCaseAssigneeAsync(planCase.Id, assignee);
            if (result.Success && result.Data)
            {
                planCase.Assignee = assignee;
                Toast.Success("负责人已更新");
            }
            else
            {
                Toast.Error(result.Message ?? "更新失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"更新失败: {ex.Message}");
        }
    }

    private async Task RemovePlanCase(long planCaseId)
    {
        try
        {
            var result = await TestPlanService.RemoveCaseAsync(PlanId, planCaseId);
            if (result.Success && result.Data)
            {
                Toast.Success("已从计划移除");
                await LoadDetail();
            }
            else
            {
                Toast.Error(result.Message ?? "移除失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"移除失败: {ex.Message}");
        }
    }

    private void ExecutePlan()
    {
        if (detail == null || !detail.Cases.Any()) return;

        var projectId = detail.Plan.ProjectId;
        var selectedIds = string.Join(",", detail.Cases.Select(c => c.CaseId));
        Navigation.NavigateTo($"/testing/test-execution/batch/{projectId}?selectedIds={selectedIds}&planId={PlanId}");
    }

    private void GoToCaseHistory(long caseId)
    {
        var projectId = detail?.Plan.ProjectId ?? 0;
        Navigation.NavigateTo($"/testing/execution-history/{caseId}?returnProjectId={projectId}");
    }

    private void GoBack() => Navigation.NavigateTo($"/testing/plans/{detail?.Plan.ProjectId ?? 0}");

    private static string GetLevelTagClass(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        _ => "default"
    };

    private static string GetPlanStatusTagClass(TestPlanStatus status) => status switch
    {
        TestPlanStatus.InProgress => "blue",
        TestPlanStatus.Completed => "green",
        TestPlanStatus.Archived => "default",
        _ => "orange"
    };

    private static string GetPlanStatusDisplayName(TestPlanStatus status) => status switch
    {
        TestPlanStatus.NotStarted => "未开始",
        TestPlanStatus.InProgress => "进行中",
        TestPlanStatus.Completed => "已完成",
        TestPlanStatus.Archived => "已归档",
        _ => "未知"
    };

    private static string GetPlanCaseStatusTagClass(PlanCaseStatus status) => status switch
    {
        PlanCaseStatus.Passed => "green",
        PlanCaseStatus.Failed => "red",
        PlanCaseStatus.Blocked => "orange",
        _ => "default"
    };

    private static string GetPlanCaseStatusDisplayName(PlanCaseStatus status) => status switch
    {
        PlanCaseStatus.NotStarted => "未开始",
        PlanCaseStatus.Passed => "已通过",
        PlanCaseStatus.Failed => "失败",
        PlanCaseStatus.Blocked => "阻塞",
        _ => "未知"
    };
}
