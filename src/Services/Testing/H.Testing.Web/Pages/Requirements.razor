@page "/testing/requirements"
@page "/testing/requirements/{projectId:long}"

@namespace H.Testing.Web
@layout TestingLayout

@inject IProjectAppService ProjectService
@inject IRequirementAppService RequirementService
@inject ICaseAppService ProjectCaseService
@inject NavigationManager Navigation
@inject H.Util.Blazor.HToastService Toast

<PageTitle>需求管理</PageTitle>

<div class="requirements-page">
    <div class="page-fill" style="flex-shrink:0;padding:12px 16px;">
        <div style="display:flex;gap:16px;align-items:center;">
            <div style="display:flex;align-items:center;gap:8px;">
                <span>选择项目:</span>
                <select class="h-select" style="width:200px;" value="@selectedProjectId" @onchange="OnProjectChanged">
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </div>
            <button class="h-btn" disabled="@(selectedProjectId == 0)" @onclick="OpenCreateModal">＋ 新建需求</button>
            @if (loading)
            {
                <span class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></span>
            }
        </div>
    </div>

    <div class="requirements-body">
        <div class="page-fill">
            <HCard Title="📑 需求列表">
                <Body>
                    @if (selectedProjectId == 0)
                    {
                        <div class="h-empty" style="padding:60px 0;">暂无项目，请先创建测试项目</div>
                    }
                    else if (!requirements.Any())
                    {
                        <div class="h-empty" style="padding:60px 0;">
                            暂无需求。录入需求并关联测试用例后，可在追溯视图中查看需求对应的用例执行与缺陷情况
                        </div>
                    }
                    else
                    {
                        <table class="h-table">
                            <thead>
                                <tr>
                                    <th>需求标题</th>
                                    <th style="width:80px;">优先级</th>
                                    <th style="width:80px;">状态</th>
                                    <th style="width:90px;">关联用例</th>
                                    <th style="width:120px;">创建时间</th>
                                    <th style="width:150px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var requirement in requirements)
                                {
                                    <tr>
                                        <td>
                                            <a class="link-action" @onclick="() => OpenTraceModal(requirement.Id)">@requirement.Title</a>
                                            @if (!string.IsNullOrEmpty(requirement.Description))
                                            {
                                                <div style="color:#86909C;font-size:12px;">@requirement.Description</div>
                                            }
                                        </td>
                                        <td><span class="h-tag h-tag-@GetPriorityTagClass(requirement.Priority)">@requirement.Priority</span></td>
                                        <td><span class="h-tag h-tag-@(requirement.Status == RequirementStatus.Active ? "green" : "default")">@(requirement.Status == RequirementStatus.Active ? "进行中" : "已关闭")</span></td>
                                        <td>@requirement.LinkedCaseCount 个</td>
                                        <td style="color:#86909C;font-size:12px;">@requirement.CreationTime.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="row-actions">
                                                <a class="link-action" @onclick="() => OpenTraceModal(requirement.Id)">追溯</a>
                                                <a class="link-action" @onclick="() => OpenEditModal(requirement)">编辑</a>
                                                <a class="link-action-danger" @onclick="() => DeleteRequirement(requirement.Id)">删除</a>
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </Body>
            </HCard>
        </div>
    </div>
</div>

<HModal Visible="@showEditModal"
        Title="@(editingRequirementId == 0 ? "新建需求" : "编辑需求")"
        OnCancel="CloseEditModal"
        ShowFooter="false"
        Style="width:560px;">
    <div style="margin-bottom:12px;">
        <div style="margin-bottom:4px;">需求标题 <span style="color:#F53F3F;">*</span></div>
        <input class="h-input" style="width:100%;" @bind="form.Title" maxlength="100" placeholder="如：用户登录支持验证码" />
    </div>

    <div style="margin-bottom:12px;">
        <div style="margin-bottom:4px;">需求描述</div>
        <textarea class="h-input" style="width:100%;min-height:72px;resize:vertical;" @bind="form.Description" maxlength="500" placeholder="需求的详细说明"></textarea>
    </div>

    <div style="display:flex;gap:12px;margin-bottom:16px;">
        <div style="flex:1;">
            <div style="margin-bottom:4px;">优先级</div>
            <select class="h-select" style="width:100%;" value="@((int)form.Priority)"
                    @onchange="@((ChangeEventArgs e) => form.Priority = int.TryParse(e.Value?.ToString(), out var v) ? (RequirementPriority)v : RequirementPriority.P1)">
                <option value="1">P0</option>
                <option value="2">P1</option>
                <option value="3">P2</option>
                <option value="4">P3</option>
            </select>
        </div>
        <div style="flex:1;">
            <div style="margin-bottom:4px;">状态</div>
            <select class="h-select" style="width:100%;" value="@((int)form.Status)"
                    @onchange="@((ChangeEventArgs e) => form.Status = int.TryParse(e.Value?.ToString(), out var v) ? (RequirementStatus)v : RequirementStatus.Active)">
                <option value="1">进行中</option>
                <option value="2">已关闭</option>
            </select>
        </div>
    </div>

    <div style="text-align:right;padding-top:12px;border-top:1px solid #F2F3F5;">
        <button class="h-btn" style="margin-right:8px;" @onclick="CloseEditModal">取消</button>
        <button class="h-btn" style="background-color:#165DFF;border-color:#165DFF;color:white;" disabled="@saving" @onclick="SaveRequirement">
            @(saving ? "保存中..." : "保存")
        </button>
    </div>
</HModal>

<HModal Visible="@showTraceModal"
        Title="@($"需求追溯 - {trace?.Requirement.Title}")"
        OnCancel="CloseTraceModal"
        ShowFooter="false"
        Style="width:860px;">
    @if (traceLoading)
    {
        <div style="text-align:center;padding:40px 0;">
            <span class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载追溯数据...</span></span>
        </div>
    }
    else if (trace != null)
    {
        <div style="margin-bottom:16px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                <span class="h-tag h-tag-@GetPriorityTagClass(trace.Requirement.Priority)">@trace.Requirement.Priority</span>
                <span class="h-tag h-tag-@(trace.Requirement.Status == RequirementStatus.Active ? "green" : "default")">@(trace.Requirement.Status == RequirementStatus.Active ? "进行中" : "已关闭")</span>
            </div>
            @if (!string.IsNullOrEmpty(trace.Requirement.Description))
            {
                <div style="color:#4E5969;">@trace.Requirement.Description</div>
            }
        </div>

        <details open style="border:1px solid #F2F3F5;border-radius:4px;margin-bottom:12px;">
            <summary style="padding:10px 12px;cursor:pointer;font-weight:600;">
                关联用例（已关联 @linkedCaseIds.Count 个）
            </summary>
            <div style="padding:0 12px 12px;">
                @if (!projectCases.Any())
                {
                    <div style="color:#86909C;">该项目暂无测试用例</div>
                }
                else
                {
                    <div style="max-height:220px;overflow-y:auto;border:1px solid #F2F3F5;border-radius:4px;padding:8px;margin-bottom:8px;">
                        @foreach (var testCase in projectCases)
                        {
                            <div style="margin-bottom:4px;">
                                <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                                    <input type="checkbox" checked="@linkedCaseIds.Contains(testCase.Id)"
                                           @onchange="@((ChangeEventArgs e) => ToggleCaseLink(testCase.Id, (bool)(e.Value ?? false)))" />
                                    @testCase.Name
                                </label>
                            </div>
                        }
                    </div>
                    <button class="h-btn h-btn-sm" disabled="@savingLinks" @onclick="SaveCaseLinks">
                        @(savingLinks ? "保存中..." : "保存关联")
                    </button>
                }
            </div>
        </details>

        <div style="font-weight:600;margin-bottom:8px;">用例执行与缺陷情况</div>
        @if (!trace.Cases.Any())
        {
            <div class="h-empty" style="padding:24px 0;">尚未关联用例</div>
        }
        else
        {
            <table class="h-table" style="margin-bottom:16px;">
                <thead>
                    <tr>
                        <th>用例名称</th>
                        <th style="width:70px;">级别</th>
                        <th style="width:110px;">最近执行结果</th>
                        <th style="width:150px;">最近执行时间</th>
                        <th style="width:80px;">缺陷数</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in trace.Cases)
                    {
                        <tr>
                            <td>
                                <a class="link-action" @onclick="() => GoToCaseHistory(item.CaseId)">@item.CaseName</a>
                            </td>
                            <td><span class="h-tag h-tag-@GetLevelTagClass(item.Level.ToString())">@item.Level</span></td>
                            <td>
                                @if (item.LastExecutionResult.HasValue)
                                {
                                    <span class="h-tag h-tag-@GetExecutionStatusTagClass(item.LastExecutionResult.Value)">@GetExecutionStatusDisplayName(item.LastExecutionResult.Value)</span>
                                }
                                else
                                {
                                    <span style="color:#86909C;">未执行</span>
                                }
                            </td>
                            <td style="color:#86909C;font-size:12px;">@(item.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>
                                @if (item.DefectCount > 0)
                                {
                                    <span class="h-tag h-tag-red">@item.DefectCount</span>
                                }
                                else
                                {
                                    <span style="color:#86909C;">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div style="font-weight:600;margin-bottom:8px;">相关缺陷</div>
        @if (!trace.Defects.Any())
        {
            <div class="h-empty" style="padding:24px 0;">关联用例暂无缺陷</div>
        }
        else
        {
            <table class="h-table">
                <thead>
                    <tr>
                        <th>缺陷标题</th>
                        <th style="width:90px;">严重程度</th>
                        <th style="width:80px;">状态</th>
                        <th style="width:120px;">创建时间</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var defect in trace.Defects)
                    {
                        <tr>
                            <td>@defect.Title</td>
                            <td><span class="h-tag h-tag-@GetSeverityTagClass(defect.Severity)">@GetSeverityDisplayName(defect.Severity)</span></td>
                            <td><span class="h-tag h-tag-@GetDefectStatusTagClass(defect.Status)">@GetDefectStatusDisplayName(defect.Status)</span></td>
                            <td style="color:#86909C;font-size:12px;">@defect.CreationTime.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</HModal>

@code {
    [Parameter] public long ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private long selectedProjectId;
    private List<RequirementDto> requirements = new();
    private List<CaseDto> projectCases = new();
    private bool loading = true;

    private bool showEditModal;
    private bool saving;
    private long editingRequirementId;
    private RequirementDto form = new();

    private bool showTraceModal;
    private bool traceLoading;
    private bool savingLinks;
    private long traceRequirementId;
    private RequirementTraceDto? trace;
    private HashSet<long> linkedCaseIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        try
        {
            projects = (await ProjectService.GetAllAsync()).Data ?? [];

            if (projects.Count == 0)
            {
                loading = false;
                return;
            }

            selectedProjectId = ProjectId != 0 && projects.Any(p => p.Id == ProjectId)
                ? ProjectId
                : projects[0].Id;

            await LoadRequirements();
        }
        catch (Exception ex)
        {
            Toast.Error($"加载项目失败: {ex.Message}");
            loading = false;
        }
    }

    private async Task LoadRequirements()
    {
        if (selectedProjectId == 0)
        {
            requirements = new List<RequirementDto>();
            loading = false;
            return;
        }

        try
        {
            loading = true;
            requirements = (await RequirementService.GetByProjectIdAsync(selectedProjectId)).Data ?? [];
            projectCases = ((await ProjectCaseService.GetByProjectIdAsync(selectedProjectId)).Data ?? [])
                .Where(c => !c.IsTemplate)
                .ToList();
        }
        catch (Exception ex)
        {
            Toast.Error($"加载需求失败: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var projectId))
        {
            selectedProjectId = projectId;
            await LoadRequirements();
        }
    }

    private void OpenCreateModal()
    {
        editingRequirementId = 0;
        form = new RequirementDto { ProjectId = selectedProjectId };
        showEditModal = true;
    }

    private void OpenEditModal(RequirementDto requirement)
    {
        editingRequirementId = requirement.Id;
        form = new RequirementDto
        {
            ProjectId = requirement.ProjectId,
            Title = requirement.Title,
            Description = requirement.Description,
            Priority = requirement.Priority,
            Status = requirement.Status
        };
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private async Task SaveRequirement()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            Toast.Error("请输入需求标题");
            return;
        }

        try
        {
            saving = true;

            if (editingRequirementId == 0)
            {
                var created = await RequirementService.CreateAsync(form);
                if (created.Success)
                {
                    Toast.Success("需求创建成功");
                    showEditModal = false;
                    await LoadRequirements();
                }
                else
                {
                    Toast.Error(created.Message ?? "创建失败");
                }
            }
            else
            {
                var updated = await RequirementService.UpdateAsync(editingRequirementId, form);
                if (updated.Success && updated.Data)
                {
                    Toast.Success("需求已更新");
                    showEditModal = false;
                    await LoadRequirements();
                }
                else
                {
                    Toast.Error(updated.Message ?? "更新失败");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteRequirement(long requirementId)
    {
        try
        {
            var result = await RequirementService.DeleteAsync(requirementId);
            if (result.Success && result.Data)
            {
                Toast.Success("需求已删除");
                await LoadRequirements();
            }
            else
            {
                Toast.Error(result.Message ?? "删除失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"删除失败: {ex.Message}");
        }
    }

    private async Task OpenTraceModal(long requirementId)
    {
        traceRequirementId = requirementId;
        showTraceModal = true;
        traceLoading = true;
        trace = null;

        try
        {
            trace = (await RequirementService.GetTraceAsync(requirementId)).Data;
            linkedCaseIds = ((await RequirementService.GetLinkedCaseIdsAsync(requirementId)).Data ?? []).ToHashSet();
        }
        catch (Exception ex)
        {
            Toast.Error($"加载追溯数据失败: {ex.Message}");
        }
        finally
        {
            traceLoading = false;
            StateHasChanged();
        }
    }

    private void CloseTraceModal()
    {
        showTraceModal = false;
        trace = null;
    }

    private void ToggleCaseLink(long caseId, bool linked)
    {
        if (linked)
        {
            linkedCaseIds.Add(caseId);
        }
        else
        {
            linkedCaseIds.Remove(caseId);
        }
    }

    private async Task SaveCaseLinks()
    {
        try
        {
            savingLinks = true;
            var result = await RequirementService.SetCaseLinksAsync(traceRequirementId, linkedCaseIds.ToList());
            if (result.Success && result.Data)
            {
                Toast.Success("用例关联已保存");
                await OpenTraceModal(traceRequirementId);
            }
            else
            {
                Toast.Error(result.Message ?? "保存失败");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            savingLinks = false;
        }
    }

    private void GoToCaseHistory(long caseId)
    {
        Navigation.NavigateTo($"/testing/execution-history/{caseId}?returnProjectId={selectedProjectId}");
    }

    private static string GetPriorityTagClass(RequirementPriority priority) => priority switch
    {
        RequirementPriority.P0 => "red",
        RequirementPriority.P1 => "orange",
        RequirementPriority.P2 => "blue",
        _ => "default"
    };

    private static string GetLevelTagClass(string level) => level switch
    {
        "P0" => "red",
        "P1" => "orange",
        "P2" => "blue",
        _ => "default"
    };

    private static string GetExecutionStatusTagClass(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "green",
        ExecutionStatus.Failed => "red",
        ExecutionStatus.Running => "blue",
        ExecutionStatus.Cancelled => "orange",
        _ => "default"
    };

    private static string GetExecutionStatusDisplayName(ExecutionStatus status) => status switch
    {
        ExecutionStatus.Success => "成功",
        ExecutionStatus.Failed => "失败",
        ExecutionStatus.Running => "执行中",
        ExecutionStatus.Cancelled => "已取消",
        _ => "未知"
    };

    private static string GetSeverityTagClass(DefectSeverity severity) => severity switch
    {
        DefectSeverity.Critical => "red",
        DefectSeverity.Major => "orange",
        DefectSeverity.Minor => "blue",
        _ => "default"
    };

    private static string GetSeverityDisplayName(DefectSeverity severity) => severity switch
    {
        DefectSeverity.Critical => "致命",
        DefectSeverity.Major => "严重",
        DefectSeverity.Minor => "一般",
        DefectSeverity.Trivial => "轻微",
        _ => "未知"
    };

    private static string GetDefectStatusTagClass(DefectStatus status) => status switch
    {
        DefectStatus.Open => "red",
        DefectStatus.Resolved => "blue",
        DefectStatus.Closed => "green",
        _ => "default"
    };

    private static string GetDefectStatusDisplayName(DefectStatus status) => status switch
    {
        DefectStatus.Open => "打开",
        DefectStatus.Resolved => "已解决",
        DefectStatus.Closed => "已关闭",
        _ => "未知"
    };
}
