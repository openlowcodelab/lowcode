@page "/system/notifications"

@layout SystemManagementLayout
@inject INotificationBusinessAppService NotificationBusinessAppService
@inject INotificationMethodConfigAppService NotificationMethodConfigAppService
@inject IMessageService MessageService

<h2>通知管理</h2>

<Card>
    <div style="margin-bottom: 16px;">
        <Space>
            <SpaceItem>
                <Input Search @bind-Value="@searchFilter" Placeholder="搜索业务名称或编码" Style="width: 250px;" />
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="@LoadData">搜索</Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="@ShowCreateDialog">新增业务</Button>
            </SpaceItem>
            <SpaceItem>
                <Button OnClick="@LoadData">刷新</Button>
            </SpaceItem>
        </Space>
    </div>

    <Table TItem="NotificationBusinessDto" DataSource="@businessList" Loading="@loading" PageSize="10">
        <Column TData="string" Title="业务名称">
            @context.BusinessName
        </Column>
        <Column TData="string" Title="业务编码">
            @context.BusinessCode
        </Column>
        <Column TData="string" Title="描述">
            @(context.Description ?? "-")
        </Column>
        <Column TData="int" Title="通知方式">
            <Space>
                @foreach (var method in context.Methods)
                {
                    if (method.IsEnabled)
                    {
                        <Tag Color="@("blue")">@GetMethodTypeName(method.MethodType)</Tag>
                    }
                }
                @if (context.Methods.All(m => !m.IsEnabled))
                {
                    <Tag>未配置</Tag>
                }
            </Space>
        </Column>
        <Column TData="bool" Title="状态">
            @if (context.IsEnabled)
            {
                <Tag Color="@("green")">启用</Tag>
            }
            else
            {
                <Tag Color="@("red")">禁用</Tag>
            }
        </Column>
        <Column TData="string" Title="操作">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => EditBusiness(context))">编辑</Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="确定要删除该业务吗？关联的通知方式配置也将被删除。" OnConfirm="@(() => DeleteBusiness(context.Id))">
                        <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Column>
    </Table>
</Card>

<!-- 新增/编辑业务模态框 -->
<Modal Title="@(isEdit ? "编辑通知业务" : "新增通知业务")" Visible="@showBusinessModal" OnOk="@SaveBusiness" OnCancel="@CloseBusinessModal"
       ConfirmLoading="@saving" Width="800">
    <Form Model="@currentBusiness" LabelColSpan="6" WrapperColSpan="16">
        <FormItem Label="业务名称">
            <Input @bind-Value="@currentBusiness.BusinessName" Placeholder="请输入业务名称" />
        </FormItem>
        @if (!isEdit)
        {
            <FormItem Label="业务编码">
                <Input @bind-Value="@currentBusiness.BusinessCode" Placeholder="请输入业务编码（英文或数字）" />
            </FormItem>
        }
        <FormItem Label="描述">
            <TextArea @bind-Value="@currentBusiness.Description" Placeholder="请输入业务描述" Rows="3" />
        </FormItem>
        <FormItem Label="启用">
            <Switch @bind-Value="@currentBusiness.IsEnabled" />
        </FormItem>
    </Form>

    @if (isEdit && editBusinessId.HasValue)
    {
        <Divider Orientation="@DividerOrientation.Left">通知方式配置</Divider>
        <div style="margin-bottom: 12px;">
            <Space>
                @foreach (NotificationMethodType type in Enum.GetValues(typeof(NotificationMethodType)))
                {
                    var exists = methodConfigs.Any(m => m.MethodType == type);
                    if (!exists)
                    {
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" OnClick="@(() => AddMethodConfig(type))">
                                添加 @GetMethodTypeName(type)
                            </Button>
                        </SpaceItem>
                    }
                }
            </Space>
        </div>

        @foreach (var config in methodConfigs)
        {
            <Card Size="@CardSize.Small" Style="margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <strong>@GetMethodTypeName(config.MethodType)</strong>
                    <Space>
                        <SpaceItem>
                            <Switch @bind-Value="@config.IsEnabled" CheckedChildren="启用" UnCheckedChildren="禁用" />
                        </SpaceItem>
                        <SpaceItem>
                            <Popconfirm Title="确定要删除此通知方式吗？" OnConfirm="@(() => DeleteMethodConfig(config.Id))">
                                <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                            </Popconfirm>
                        </SpaceItem>
                    </Space>
                </div>

                @if (config.MethodType == NotificationMethodType.Webhook)
                {
                    <div style="margin-bottom: 8px;">
                        <span style="display: inline-block; width: 100px;">Webhook地址：</span>
                        <Input @bind-Value="@config.WebhookUrl" Placeholder="请输入Webhook地址" Style="width: calc(100% - 110px);" />
                    </div>
                }
                @if (config.MethodType == NotificationMethodType.Sms)
                {
                    <div style="margin-bottom: 8px;">
                        <span style="display: inline-block; width: 100px;">短信模板ID：</span>
                        <Input @bind-Value="@config.SmsTemplateId" Placeholder="请输入短信模板ID" Style="width: calc(100% - 110px);" />
                    </div>
                }
                @if (config.MethodType == NotificationMethodType.Email)
                {
                    <div style="margin-bottom: 8px;">
                        <span style="display: inline-block; width: 100px;">邮件地址：</span>
                        <Input @bind-Value="@config.EmailAddress" Placeholder="请输入邮件接收地址" Style="width: calc(100% - 110px);" />
                    </div>
                }
                @if (config.MethodType == NotificationMethodType.InApp)
                {
                    <Alert Message="站内通知无需额外配置" Type="@AlertType.Info" ShowIcon="true" />
                }
            </Card>
        }
    }
</Modal>

@code {
    private List<NotificationBusinessDto> businessList = new();
    private bool loading;
    private bool saving;
    private string searchFilter = string.Empty;

    // 业务模态框相关
    private bool showBusinessModal;
    private bool isEdit;
    private Guid? editBusinessId;
    private CreateNotificationBusinessDto currentBusiness = new();

    // 通知方式配置相关
    private List<NotificationMethodConfigDto> methodConfigs = new();
    private Dictionary<Guid, CreateNotificationMethodConfigDto> newMethodConfigs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var query = new NotificationBusinessQueryDto
            {
                MaxResultCount = 50,
                Filter = searchFilter
            };
            var result = await NotificationBusinessAppService.GetListAsync(query);
            businessList = result.Items.ToList();
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateDialog()
    {
        currentBusiness = new CreateNotificationBusinessDto { IsEnabled = true };
        isEdit = false;
        editBusinessId = null;
        methodConfigs.Clear();
        newMethodConfigs.Clear();
        showBusinessModal = true;
    }

    private async Task EditBusiness(NotificationBusinessDto business)
    {
        currentBusiness = new CreateNotificationBusinessDto
        {
            BusinessName = business.BusinessName,
            BusinessCode = business.BusinessCode,
            Description = business.Description,
            IsEnabled = business.IsEnabled
        };

        // 加载通知方式配置
        var detail = await NotificationBusinessAppService.GetAsync(business.Id);
        methodConfigs = detail.Methods;
        newMethodConfigs.Clear();

        isEdit = true;
        editBusinessId = business.Id;
        showBusinessModal = true;
    }

    private async Task SaveBusiness(MouseEventArgs e)
    {
        saving = true;
        try
        {
            Guid businessId;
            if (isEdit && editBusinessId.HasValue)
            {
                await NotificationBusinessAppService.UpdateAsync(editBusinessId.Value, new UpdateNotificationBusinessDto
                {
                    BusinessName = currentBusiness.BusinessName,
                    Description = currentBusiness.Description,
                    IsEnabled = currentBusiness.IsEnabled
                });
                businessId = editBusinessId.Value;
            }
            else
            {
                var result = await NotificationBusinessAppService.CreateAsync(currentBusiness);
                businessId = result.Id;
            }

            // 保存通知方式配置（仅编辑模式）
            if (isEdit)
            {
                // 更新现有配置
                foreach (var config in methodConfigs)
                {
                    if (config.Id != Guid.Empty)
                    {
                        await NotificationMethodConfigAppService.UpdateAsync(config.Id, new CreateNotificationMethodConfigDto
                        {
                            MethodType = config.MethodType,
                            IsEnabled = config.IsEnabled,
                            WebhookUrl = config.WebhookUrl,
                            SmsTemplateId = config.SmsTemplateId,
                            EmailAddress = config.EmailAddress
                        });
                    }
                }

                // 创建新配置
                foreach (var pair in newMethodConfigs)
                {
                    await NotificationMethodConfigAppService.CreateAsync(businessId, pair.Value);
                }
            }

            MessageService.Success($"通知业务{(isEdit ? "更新" : "创建")}成功");
            CloseBusinessModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            MessageService.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void CloseBusinessModal()
    {
        showBusinessModal = false;
        currentBusiness = new CreateNotificationBusinessDto();
        methodConfigs.Clear();
        newMethodConfigs.Clear();
        editBusinessId = null;
        isEdit = false;
    }

    private async Task DeleteBusiness(Guid id)
    {
        try
        {
            await NotificationBusinessAppService.DeleteAsync(id);
            MessageService.Success("删除成功");
            await LoadData();
        }
        catch (Exception ex)
        {
            MessageService.Error($"删除失败：{ex.Message}");
        }
    }

    // 通知方式配置相关方法
    private void AddMethodConfig(NotificationMethodType type)
    {
        var newConfig = new NotificationMethodConfigDto
        {
            Id = Guid.NewGuid(), // 临时ID用于UI展示
            BusinessId = editBusinessId ?? Guid.Empty,
            MethodType = type,
            IsEnabled = true
        };
        methodConfigs.Add(newConfig);

        newMethodConfigs[newConfig.Id] = new CreateNotificationMethodConfigDto
        {
            MethodType = type,
            IsEnabled = true
        };
    }

    private async Task DeleteMethodConfig(Guid id)
    {
        var config = methodConfigs.FirstOrDefault(m => m.Id == id);
        if (config == null) return;

        // 如果是新添加的配置（临时ID），直接从列表移除
        if (newMethodConfigs.ContainsKey(id))
        {
            methodConfigs.Remove(config);
            newMethodConfigs.Remove(id);
        }
        else
        {
            // 已存在的配置，调用API删除
            try
            {
                await NotificationMethodConfigAppService.DeleteAsync(id);
                methodConfigs.Remove(config);
                MessageService.Success("删除成功");
            }
            catch (Exception ex)
            {
                MessageService.Error($"删除失败：{ex.Message}");
            }
        }
    }

    private string GetMethodTypeName(NotificationMethodType type)
    {
        return type switch
        {
            NotificationMethodType.InApp => "站内",
            NotificationMethodType.Email => "邮件",
            NotificationMethodType.Sms => "短信",
            NotificationMethodType.Webhook => "Webhook",
            _ => type.ToString()
        };
    }
}
