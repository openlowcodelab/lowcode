@page "/order/route-rule"
@layout OrderLayout
@inject IRouteRuleAppService RouteRuleService
@inject ISupplierAppService SupplierService
@inject IJSRuntime JS
@inject H.Util.Blazor.HToastService Toast

<HCard Title="路由规则管理">
    <div class="h-toolbar">
        <button class="h-btn h-btn-primary" @onclick="@ShowCreate">新增规则</button>
        <button class="h-btn" @onclick="@LoadData">刷新</button>
    </div>
    <HTable Loading="@loading" ShowEmpty="@(!loading && !rules.Any())">
        <thead>
            <tr>
                <th>名称</th>
                <th>供应商</th>
                <th>类型</th>
                <th>优先级</th>
                <th>条件(JSON)</th>
                <th>兜底</th>
                <th>启用</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rules)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.SupplierCode</td>
                    <td>@r.RuleType</td>
                    <td>@r.Priority</td>
                    <td style="max-width:280px;"><pre style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(r.ConditionsJson) ? "[]" : r.ConditionsJson)</pre></td>
                    <td>@(r.Fallback ? "✓" : "-")</td>
                    <td>
                        @if (r.IsEnabled) { <span class="h-tag h-tag-green">启用</span> }
                        else { <span class="h-tag h-tag-red">禁用</span> }
                    </td>
                    <td>
                        <span class="row-actions">
                            <a @onclick="@(() => Edit(r))">编辑</a>
                            <a class="danger" @onclick="@(() => Delete(r.Id))">删除</a>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </HTable>
</HCard>

<HModal Title="@(isEdit ? "编辑路由规则" : "新增路由规则")" Visible="@showModal" OnOk="@Save" OnCancel="@CloseModal" ConfirmLoading="@saving" Style="width:780px;">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@current.Name" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">命中供应商编码</label>
        <div class="h-form-control">
            <select @bind="@current.SupplierCode" class="h-input" style="width:auto">
                @foreach (var s in suppliers)
                {
                    <option value="@s.Code">@s.Code - @s.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">规则类型</label>
        <div class="h-form-control">
            <select @bind="@current.RuleType" class="h-input" style="width:auto">
                @foreach (var t in Enum.GetValues<RouteRuleTypeEnum>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">优先级（越小越先）</label>
        <div class="h-form-control">
            <input type="number" @bind-value="@current.Priority" class="h-input" style="width:160px;" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">兜底规则</label>
        <div class="h-form-control">
            <label class="h-switch">
                <input type="checkbox" @bind="@current.Fallback" />
                <span class="h-switch-slider"></span>
            </label>
            <span style="margin-left:8px;color:#86909C;">勾选后无需条件即可命中，其余规则未命中时使用</span>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">启用</label>
        <div class="h-form-control">
            <label class="h-switch">
                <input type="checkbox" @bind="@current.IsEnabled" />
                <span class="h-switch-slider"></span>
            </label>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">条件 (JSON)</label>
        <div class="h-form-control">
            <textarea @bind="@current.ConditionsJson" rows="6" class="h-textarea" placeholder='[{"field":"Industry","op":"eq","value":"餐饮"},{"field":"TotalAmount","op":"between","value":"100,1000"}]'></textarea>
            <div style="color:#86909C;font-size:12px;">支持字段：Industry / ProductCategory / TotalAmount / OrderStatus；操作符：eq,ne,in,gt,lt,gte,lte,between,contains。多条件 AND 组合。</div>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea @bind="@current.Remark" rows="2" class="h-textarea"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<RouteRuleDto> rules = new();
    private List<SupplierDto> suppliers = new();
    private bool loading;
    private bool showModal;
    private bool saving;
    private bool isEdit;
    private Guid? editId;
    private CreateRouteRuleDto current = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
        await LoadData();
    }

    private async Task LoadSuppliers()
    {
        try
        {
            var r = (await SupplierService.GetListAsync(new SupplierQueryDto { MaxResultCount = 100 })).Data!;
            suppliers = r.Items.ToList();
        }
        catch { }
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var r = (await RouteRuleService.GetListAsync(new RouteRuleQueryDto { MaxResultCount = 100 })).Data!;
            rules = r.Items.OrderBy(x => x.Priority).ToList();
        }
        catch (Exception ex) { Toast.Error($"加载失败：{ex.Message}"); }
        finally { loading = false; }
    }

    private void ShowCreate()
    {
        isEdit = false;
        editId = null;
        current = new CreateRouteRuleDto { Priority = 100, IsEnabled = true, ConditionsJson = "[]" };
        showModal = true;
    }

    private void Edit(RouteRuleDto r)
    {
        isEdit = true;
        editId = r.Id;
        current = new CreateRouteRuleDto
        {
            Name = r.Name,
            SupplierCode = r.SupplierCode,
            RuleType = r.RuleType,
            Priority = r.Priority,
            IsEnabled = r.IsEnabled,
            ConditionsJson = r.ConditionsJson,
            Fallback = r.Fallback,
            Remark = r.Remark
        };
        showModal = true;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            if (string.IsNullOrWhiteSpace(current.Name) || string.IsNullOrWhiteSpace(current.SupplierCode))
            {
                Toast.Warning("名称和命中供应商不能为空");
                return;
            }

            if (isEdit && editId.HasValue)
            {
                await RouteRuleService.UpdateAsync(editId.Value, new UpdateRouteRuleDto
                {
                    Name = current.Name,
                    SupplierCode = current.SupplierCode,
                    RuleType = current.RuleType,
                    Priority = current.Priority,
                    IsEnabled = current.IsEnabled,
                    ConditionsJson = current.ConditionsJson,
                    Fallback = current.Fallback,
                    Remark = current.Remark
                });
                Toast.Success("更新成功");
            }
            else
            {
                await RouteRuleService.CreateAsync(current);
                Toast.Success("创建成功");
            }

            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { Toast.Error($"保存失败：{ex.Message}"); }
        finally { saving = false; }
    }

    private void CloseModal() { showModal = false; current = new(); editId = null; isEdit = false; }

    private async Task Delete(Guid id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "确定删除该规则？");
        if (!ok) return;
        try
        {
            await RouteRuleService.DeleteAsync(id);
            Toast.Success("已删除");
            await LoadData();
        }
        catch (Exception ex) { Toast.Error($"删除失败：{ex.Message}"); }
    }
}