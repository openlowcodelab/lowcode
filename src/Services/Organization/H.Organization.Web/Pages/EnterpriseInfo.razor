@page "/organization/enterprise"

@layout OrganizationLayout
@using System.Net.Http.Json
@inject HttpClient HttpClient

<HCard Title="基本信息">
    <div style="max-width: 640px;">
        @if (loading)
        {
            <div style="padding: 40px; color: #86909C;">加载中...</div>
        }
        else if (enterprise == null)
        {
            <div style="padding: 24px; color: #86909C;">
                未选择企业，请先选择或创建企业。
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(message))
            {
                <div style="color: #00B42A; margin-bottom: 16px; padding: 8px; background: #E8FFEA; border: 1px solid #AFF0B5; border-radius: 4px;">
                    @message
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="color: red; margin-bottom: 16px; padding: 8px; background: #FFECE8; border: 1px solid #FDCDC5; border-radius: 4px;">
                    @errorMessage
                </div>
            }

            @if (!isOwner)
            {
                <div style="margin-bottom: 16px; color: #86909C; font-size: 13px;">
                    仅企业拥有者可修改企业信息，当前为只读。
                </div>
            }

            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">企业名称 @if (isOwner) { <span style="color:red">*</span> }</label>
                <div class="h-form-control">
                    <input type="text" @bind-value="@editModel.Name" placeholder="请输入企业名称" class="h-input" disabled="@(!isOwner)" />
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">企业编码</label>
                <div class="h-form-control">
                    <input type="text" value="@enterprise.Code" class="h-input" disabled />
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">企业描述</label>
                <div class="h-form-control">
                    <textarea @bind="@editModel.Description" placeholder="请输入企业描述" class="h-input" rows="3" disabled="@(!isOwner)"></textarea>
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">联系人</label>
                <div class="h-form-control">
                    <input type="text" @bind-value="@editModel.ContactName" placeholder="请输入联系人姓名" class="h-input" disabled="@(!isOwner)" />
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">联系电话</label>
                <div class="h-form-control">
                    <input type="text" @bind-value="@editModel.ContactPhone" placeholder="请输入联系电话" class="h-input" disabled="@(!isOwner)" />
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">联系邮箱</label>
                <div class="h-form-control">
                    <input type="email" @bind-value="@editModel.ContactEmail" placeholder="请输入联系邮箱" class="h-input" disabled="@(!isOwner)" />
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">备注</label>
                <div class="h-form-control">
                    <textarea @bind="@editModel.Remark" placeholder="请输入备注" class="h-input" rows="2" disabled="@(!isOwner)"></textarea>
                </div>
            </div>

            <div style="margin: 24px 0 8px; border-top: 1px solid #F2F3F5;"></div>

            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">状态</label>
                <div class="h-form-control" style="padding-top: 6px;">
                    @if (enterprise.Status == "Active")
                    {
                        <span class="h-tag h-tag-green">已激活</span>
                    }
                    else if (enterprise.Status == "Pending")
                    {
                        <span class="h-tag" style="background:#FFF7E8;color:#ad6800;border:1px solid #FFCF8B;">待激活</span>
                    }
                    else
                    {
                        <span class="h-tag h-tag-red">已禁用</span>
                    }
                </div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">成员数量</label>
                <div class="h-form-control" style="padding-top: 6px;">@enterprise.UserCount 名成员</div>
            </div>
            <div class="h-form-item h-form-horizontal">
                <label class="h-form-label">创建时间</label>
                <div class="h-form-control" style="padding-top: 6px;">@enterprise.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
            </div>

            @if (isOwner)
            {
                <div style="margin-top: 24px;">
                    <button class="h-btn h-btn-primary" @onclick="Save" disabled="@submitting">
                        @(submitting ? "保存中..." : "保存")
                    </button>
                </div>
            }
        }
    </div>
</HCard>

@code {
    private EnterpriseInfoModel? enterprise;
    private UpdateEnterpriseModel editModel = new();
    private bool isOwner;
    private bool loading = true;
    private bool submitting;
    private string? message;
    private string? errorMessage;

    // 企业信息视图模型（通过 HttpClient 调用 /api/app/enterprise/*，不依赖 System 层 Contracts）
    private class EnterpriseInfoModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Code { get; set; }
        public string? Description { get; set; }
        public string? Logo { get; set; }
        public string? ContactName { get; set; }
        public string? ContactPhone { get; set; }
        public string? ContactEmail { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public string? Remark { get; set; }
        public int UserCount { get; set; }
    }

    private class UpdateEnterpriseModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Logo { get; set; }
        public string? ContactName { get; set; }
        public string? ContactPhone { get; set; }
        public string? ContactEmail { get; set; }
        public string? Remark { get; set; }
    }

    /// <summary>
    /// GET 并反序列化；服务端返回 null 时（204 或空 body）返回 default；
    /// string 结果兼容裸文本响应（ABP 对 string 返回值输出 text/plain）
    /// </summary>
    private async Task<T?> GetJsonOrDefaultAsync<T>(string url)
    {
        var response = await HttpClient.GetAsync(url);
        response.EnsureSuccessStatusCode();
        var content = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(content) || content == "null")
        {
            return default;
        }
        if (typeof(T) == typeof(string) && !content.StartsWith('"'))
        {
            return (T)(object)content;
        }
        return System.Text.Json.JsonSerializer.Deserialize<T>(content,
            new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            enterprise = await GetJsonOrDefaultAsync<EnterpriseInfoModel>("/api/app/enterprise/current-enterprise");
            var role = await GetJsonOrDefaultAsync<string>("/api/app/enterprise/current-enterprise-role");
            isOwner = string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase);

            if (enterprise != null)
            {
                editModel = new UpdateEnterpriseModel
                {
                    Name = enterprise.Name,
                    Description = enterprise.Description,
                    Logo = enterprise.Logo,
                    ContactName = enterprise.ContactName,
                    ContactPhone = enterprise.ContactPhone,
                    ContactEmail = enterprise.ContactEmail,
                    Remark = enterprise.Remark
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        if (!isOwner) return;

        if (string.IsNullOrWhiteSpace(editModel.Name))
        {
            errorMessage = "企业名称不能为空";
            message = null;
            return;
        }

        submitting = true;
        errorMessage = null;
        message = null;
        try
        {
            var response = await HttpClient.PutAsJsonAsync("/api/app/enterprise/current-enterprise", editModel);
            if (response.IsSuccessStatusCode)
            {
                enterprise = await response.Content.ReadFromJsonAsync<EnterpriseInfoModel>();
                message = "保存成功";
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(content);
                    errorMessage = doc.RootElement.TryGetProperty("error", out var error)
                        && error.TryGetProperty("message", out var msgProp)
                        ? msgProp.GetString() ?? "保存失败"
                        : "保存失败";
                }
                catch
                {
                    errorMessage = "保存失败";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }
}
