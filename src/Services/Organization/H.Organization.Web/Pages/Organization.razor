@page "/organization"
@layout OrganizationLayout
@inject IOrganizationService IOrganizationService
@inject IJSRuntime JS

<Card Title="组织管理">
    <div style="margin-bottom: 16px;">
        <Button Type="@ButtonType.Primary" OnClick="@ShowCreateDialog">新增部门</Button>
    </div>

    <Table TItem="OrganizationDto" DataSource="@organizations" Loading="@(organizations == null)">
        <Column TData="string" Title="部门名称">
            @context.Name
        </Column>
        <Column TData="string" Title="编码">
            @context.Code
        </Column>
        <Column TData="string" Title="负责人">
            @context.LeaderName
        </Column>
        <Column TData="string" Title="电话">
            @context.Phone
        </Column>
        <Column TData="string" Title="邮箱">
            @context.Email
        </Column>
        <Column TData="string" Title="状态">
            @if (context.IsEnabled)
            {
                <Tag Color="@("green")">启用</Tag>
            }
            else
            {
                <Tag Color="@("red")">禁用</Tag>
            }
        </Column>
        <Column TData="string" Title="操作">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => Edit(context))">编辑</Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="确定要删除这个部门吗？" OnConfirm="@(() => Delete(context.Id))">
                        <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Column>
    </Table>
</Card>

<Modal Title="@(isEdit ? "编辑部门" : "新增部门")" Visible="@showDialog" OnOk="@Save" OnCancel="@CloseDialog"
       ConfirmLoading="@isSubmitting">
    <Form Model="@currentOrg" LabelColSpan="6" WrapperColSpan="18">
        <FormItem Label="部门名称">
            <Input @bind-Value="@currentOrg.Name" Placeholder="请输入部门名称" />
        </FormItem>
        <FormItem Label="编码">
            <Input @bind-Value="@currentOrg.Code" Placeholder="请输入编码" />
        </FormItem>
        <FormItem Label="父部门">
            <Select TItem="Guid?" TItemValue="Guid?" @bind-Value="@currentOrg.ParentId" Placeholder="请选择父部门" AllowClear>
                @foreach (var org in organizations ?? new List<OrganizationDto>())
                {
                    <SelectOption Value="@((Guid?)org.Id)" Label="@org.Name" />
                }
            </Select>
        </FormItem>
        <FormItem Label="联系电话">
            <Input @bind-Value="@currentOrg.Phone" Placeholder="请输入联系电话" />
        </FormItem>
        <FormItem Label="邮箱">
            <Input @bind-Value="@currentOrg.Email" Placeholder="请输入邮箱" />
        </FormItem>
        <FormItem Label="排序">
            <AntDesign.InputNumber @bind-Value="@currentOrg.Sort" Style="width: 100%;" />
        </FormItem>
        <FormItem Label="备注">
            <TextArea @bind-Value="@currentOrg.Remark" Placeholder="请输入备注" Rows="3" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<OrganizationDto>? organizations;
    private bool showDialog;
    private bool isEdit;
    private bool isSubmitting;
    private OrganizationDto currentOrg = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await IOrganizationService.GetListAsync(new OrganizationQueryParams { PageSize = 100 });
        organizations = result.Items;
    }

    private void ShowCreateDialog()
    {
        currentOrg = new OrganizationDto();
        isEdit = false;
        showDialog = true;
    }

    private void Edit(OrganizationDto org)
    {
        currentOrg = new OrganizationDto
        {
            Id = org.Id,
            Name = org.Name,
            Code = org.Code,
            ParentId = org.ParentId,
            Phone = org.Phone,
            Email = org.Email,
            Sort = org.Sort,
            Remark = org.Remark
        };
        isEdit = true;
        showDialog = true;
    }

    private async Task Save(MouseEventArgs e)
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                await IOrganizationService.UpdateAsync(currentOrg.Id, new UpdateOrganizationDto
                {
                    Name = currentOrg.Name,
                    Code = currentOrg.Code,
                    ParentId = currentOrg.ParentId,
                    Phone = currentOrg.Phone,
                    Email = currentOrg.Email,
                    Sort = currentOrg.Sort,
                    IsEnabled = currentOrg.IsEnabled,
                    Remark = currentOrg.Remark
                });
            }
            else
            {
                await IOrganizationService.CreateAsync(new CreateOrganizationDto
                {
                    Name = currentOrg.Name,
                    Code = currentOrg.Code,
                    ParentId = currentOrg.ParentId,
                    Phone = currentOrg.Phone,
                    Email = currentOrg.Email,
                    Sort = currentOrg.Sort,
                    Remark = currentOrg.Remark
                });
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Delete(Guid id)
    {
        await IOrganizationService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog(MouseEventArgs? e = null)
    {
        showDialog = false;
    }
}
