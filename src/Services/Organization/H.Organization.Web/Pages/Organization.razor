@page "/organization"

@layout OrganizationLayout
@inject IOrganizationService IOrganizationService
@inject IJSRuntime JS

<HCard Title="组织管理">
    <div style="margin-bottom: 16px;">
        <button class="h-btn h-btn-primary" @onclick="@ShowCreateDialog">新增部门</button>
    </div>

    <HTable Loading="@(organizations == null)" ShowEmpty="@(organizations != null && !organizations.Any())">
        <thead>
            <tr>
                <th>部门名称</th>
                <th>编码</th>
                <th>负责人</th>
                <th>电话</th>
                <th>邮箱</th>
                <th>状态</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (organizations != null)
            {
                @foreach (var context in organizations)
                {
                    <tr>
                        <td>@context.Name</td>
                        <td>@context.Code</td>
                        <td>@context.LeaderName</td>
                        <td>@context.Phone</td>
                        <td>@context.Email</td>
                        <td>
                            @if (context.IsEnabled)
                            {
                                <span class="h-tag h-tag-green">启用</span>
                            }
                            else
                            {
                                <span class="h-tag h-tag-red">禁用</span>
                            }
                        </td>
                        <td>
                            <span class="h-space">
                                <button class="h-btn h-btn-primary h-btn-sm" @onclick="@(() => Edit(context))">编辑</button>
                                <button class="h-btn h-btn-danger h-btn-sm" @onclick="@(() => ConfirmDelete(context.Id))">删除</button>
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </HTable>
</HCard>

<HModal Title="@(isEdit ? "编辑部门" : "新增部门")" Visible="@showDialog" OnOk="@Save" OnCancel="@CloseDialog" ConfirmLoading="@isSubmitting">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">部门名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@currentOrg.Name" placeholder="请输入部门名称" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">编码</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@currentOrg.Code" placeholder="请输入编码" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">父部门</label>
        <div class="h-form-control">
            <select @bind="@currentOrg.ParentId" class="h-select">
                <option value="">无</option>
                @foreach (var org in organizations ?? new List<OrganizationDto>())
                {
                    <option value="@org.Id">@org.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">联系电话</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@currentOrg.Phone" placeholder="请输入联系电话" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">邮箱</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@currentOrg.Email" placeholder="请输入邮箱" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">排序</label>
        <div class="h-form-control">
            <input type="number" @bind="@currentOrg.Sort" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea @bind="@currentOrg.Remark" placeholder="请输入备注" rows="3" class="h-textarea"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<OrganizationDto>? organizations;
    private bool showDialog;
    private bool isEdit;
    private bool isSubmitting;
    private OrganizationDto currentOrg = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await IOrganizationService.GetListAsync(new OrganizationQueryParams { PageSize = 100 });
        organizations = result.Items;
    }

    private void ShowCreateDialog()
    {
        currentOrg = new OrganizationDto();
        isEdit = false;
        showDialog = true;
    }

    private void Edit(OrganizationDto org)
    {
        currentOrg = new OrganizationDto
        {
            Id = org.Id,
            Name = org.Name,
            Code = org.Code,
            ParentId = org.ParentId,
            Phone = org.Phone,
            Email = org.Email,
            Sort = org.Sort,
            Remark = org.Remark
        };
        isEdit = true;
        showDialog = true;
    }

    private async Task Save()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                await IOrganizationService.UpdateAsync(currentOrg.Id, new UpdateOrganizationDto
                {
                    Name = currentOrg.Name,
                    Code = currentOrg.Code,
                    ParentId = currentOrg.ParentId,
                    Phone = currentOrg.Phone,
                    Email = currentOrg.Email,
                    Sort = currentOrg.Sort,
                    IsEnabled = currentOrg.IsEnabled,
                    Remark = currentOrg.Remark
                });
            }
            else
            {
                await IOrganizationService.CreateAsync(new CreateOrganizationDto
                {
                    Name = currentOrg.Name,
                    Code = currentOrg.Code,
                    ParentId = currentOrg.ParentId,
                    Phone = currentOrg.Phone,
                    Email = currentOrg.Email,
                    Sort = currentOrg.Sort,
                    Remark = currentOrg.Remark
                });
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "确定要删除这个部门吗？");
        if (confirmed)
        {
            await Delete(id);
        }
    }

    private async Task Delete(Guid id)
    {
        await IOrganizationService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
    }
}
