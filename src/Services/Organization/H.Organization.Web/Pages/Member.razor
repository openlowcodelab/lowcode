@page "/organization/member"

@layout OrganizationLayout
@inject IMemberService IMemberService
@inject IOrganizationService IOrganizationService
@inject IJSRuntime JS

<Card Title="成员管理">
    <div style="margin-bottom: 16px;">
        <Button Type="@ButtonType.Primary" OnClick="@ShowCreateDialog">添加成员</Button>
    </div>

    <Table TItem="MemberDto" DataSource="@members" Loading="@(members == null)">
        <Column TData="string" Title="用户名">
            @context.UserName
        </Column>
        <Column TData="string" Title="邮箱">
            @context.Email
        </Column>
        <Column TData="string" Title="手机号">
            @context.PhoneNumber
        </Column>
        <Column TData="string" Title="所属部门">
            @context.OrganizationName
        </Column>
        <Column TData="string" Title="成员类型">
            @context.MemberTypeName
        </Column>
        <Column TData="string" Title="主部门">
            @if (context.IsMain)
            {
                <Tag Color="@("blue")">是</Tag>
            }
            else
            {
                <Tag>否</Tag>
            }
        </Column>
        <Column TData="string" Title="状态">
            @if (context.IsEnabled)
            {
                <Tag Color="@("green")">启用</Tag>
            }
            else
            {
                <Tag Color="@("red")">禁用</Tag>
            }
        </Column>
        <Column TData="string" Title="操作">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => Edit(context))">编辑</Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="确定要删除这个成员吗？" OnConfirm="@(() => Delete(context.Id))">
                        <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Column>
    </Table>
</Card>

<Modal Title="@(isEdit ? "编辑成员" : "添加成员")" Visible="@showDialog" OnOk="@Save" OnCancel="@CloseDialog"
       ConfirmLoading="@isSubmitting">
    <Form Model="@currentMember" LabelColSpan="6" WrapperColSpan="18">
        @if (!isEdit)
        {
            <FormItem Label="用户ID">
                <Input @bind-Value="@currentMember.UserId" Placeholder="请输入Account服务中的用户ID" />
            </FormItem>
        }
        <FormItem Label="所属部门">
            <Select TItem="Guid" TItemValue="Guid" @bind-Value="@currentMember.OrganizationId" Placeholder="请选择所属部门">
                @foreach (var org in organizations ?? new List<OrganizationDto>())
                {
                    <SelectOption Value="@org.Id" Label="@org.Name" />
                }
            </Select>
        </FormItem>
        <FormItem Label="成员类型">
            <Select TItem="int" TItemValue="int" @bind-Value="@currentMember.MemberType" Placeholder="请选择成员类型">
                <SelectOption Value="1" Label="普通成员" />
                <SelectOption Value="2" Label="部门负责人" />
                <SelectOption Value="3" Label="部门经理" />
            </Select>
        </FormItem>
        <FormItem Label="排序">
            <AntDesign.InputNumber @bind-Value="@currentMember.Sort" Style="width: 100%;" />
        </FormItem>
        <FormItem Label="设为主部门">
            <Switch @bind-Value="@currentMember.IsMain" />
        </FormItem>
        <FormItem Label="备注">
            <TextArea @bind-Value="@currentMember.Remark" Placeholder="请输入备注" Rows="3" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<MemberDto>? members;
    private List<OrganizationDto>? organizations;
    private bool showDialog;
    private bool isEdit;
    private bool isSubmitting;
    private MemberDto currentMember = new() { MemberType = 1 };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var memberResult = await IMemberService.GetListAsync(new MemberQueryParams { PageSize = 100 });
        members = memberResult.Items;

        var orgResult = await IOrganizationService.GetListAsync(new OrganizationQueryParams { PageSize = 100 });
        organizations = orgResult.Items;
    }

    private void ShowCreateDialog()
    {
        currentMember = new MemberDto { MemberType = 1 };
        isEdit = false;
        showDialog = true;
    }

    private void Edit(MemberDto member)
    {
        currentMember = new MemberDto
        {
            Id = member.Id,
            OrganizationId = member.OrganizationId,
            UserId = member.UserId,
            UserName = member.UserName,
            MemberType = member.MemberType,
            Sort = member.Sort,
            IsMain = member.IsMain,
            IsEnabled = member.IsEnabled,
            Remark = member.Remark
        };
        isEdit = true;
        showDialog = true;
    }

    private async Task Save(MouseEventArgs e)
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                await IMemberService.UpdateAsync(currentMember.Id, new UpdateMemberDto
                {
                    MemberType = currentMember.MemberType,
                    Sort = currentMember.Sort,
                    IsMain = currentMember.IsMain,
                    IsEnabled = currentMember.IsEnabled,
                    Remark = currentMember.Remark
                });
            }
            else
            {
                await IMemberService.AddAsync(new AddMemberDto
                {
                    OrganizationId = currentMember.OrganizationId,
                    UserId = currentMember.UserId,
                    MemberType = currentMember.MemberType,
                    Sort = currentMember.Sort,
                    IsMain = currentMember.IsMain,
                    Remark = currentMember.Remark
                });
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Delete(Guid id)
    {
        await IMemberService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog(MouseEventArgs? e = null)
    {
        showDialog = false;
    }
}
