@page "/organization/member"

@layout OrganizationLayout
@inject IMemberService IMemberService
@inject IOrganizationService IOrganizationService
@inject IJSRuntime JS

<HCard Title="成员管理">
    <div style="margin-bottom: 16px;">
        <button class="h-btn h-btn-primary" @onclick="@ShowCreateDialog">添加成员</button>
    </div>

    <HTable Loading="@(members == null)" ShowEmpty="@(members != null && !members.Any())">
        <thead>
            <tr>
                <th>用户名</th>
                <th>邮箱</th>
                <th>手机号</th>
                <th>所属部门</th>
                <th>成员类型</th>
                <th>主部门</th>
                <th>状态</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (members != null)
            {
                @foreach (var context in members)
                {
                    <tr>
                        <td>@context.UserName</td>
                        <td>@context.Email</td>
                        <td>@context.PhoneNumber</td>
                        <td>@context.OrganizationName</td>
                        <td>@context.MemberTypeName</td>
                        <td>
                            @if (context.IsMain)
                            {
                                <span class="h-tag h-tag-blue">是</span>
                            }
                            else
                            {
                                <span class="h-tag">否</span>
                            }
                        </td>
                        <td>
                            @if (context.IsEnabled)
                            {
                                <span class="h-tag h-tag-green">启用</span>
                            }
                            else
                            {
                                <span class="h-tag h-tag-red">禁用</span>
                            }
                        </td>
                        <td>
                            <span class="h-space">
                                <button class="h-btn h-btn-primary h-btn-sm" @onclick="@(() => Edit(context))">编辑</button>
                                <button class="h-btn h-btn-danger h-btn-sm" @onclick="@(() => ConfirmDelete(context.Id))">删除</button>
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </HTable>
</HCard>

<HModal Title="@(isEdit ? "编辑成员" : "添加成员")" Visible="@showDialog" OnOk="@Save" OnCancel="@CloseDialog" ConfirmLoading="@isSubmitting">
    @if (!isEdit)
    {
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">用户ID</label>
            <div class="h-form-control">
                <input type="text" @bind-value="@currentMember.UserId" placeholder="请输入Account服务中的用户ID" class="h-input" />
            </div>
        </div>
    }
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">所属部门</label>
        <div class="h-form-control">
            <select @bind="@currentMember.OrganizationId" class="h-select">
                <option value="">请选择</option>
                @foreach (var org in organizations ?? new List<OrganizationDto>())
                {
                    <option value="@org.Id">@org.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">成员类型</label>
        <div class="h-form-control">
            <select @bind="@currentMember.MemberType" class="h-select">
                <option value="1">普通成员</option>
                <option value="2">部门负责人</option>
                <option value="3">部门经理</option>
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">排序</label>
        <div class="h-form-control">
            <input type="number" @bind="@currentMember.Sort" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">设为主部门</label>
        <div class="h-form-control">
            <label class="h-switch">
                <input type="checkbox" @bind="@currentMember.IsMain" />
                <span class="h-switch-slider"></span>
            </label>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea @bind="@currentMember.Remark" placeholder="请输入备注" rows="3" class="h-textarea"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<MemberDto>? members;
    private List<OrganizationDto>? organizations;
    private bool showDialog;
    private bool isEdit;
    private bool isSubmitting;
    private MemberDto currentMember = new() { MemberType = 1 };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var memberResult = await IMemberService.GetListAsync(new MemberQueryParams { PageSize = 100 });
        members = memberResult.Items;

        var orgResult = await IOrganizationService.GetListAsync(new OrganizationQueryParams { PageSize = 100 });
        organizations = orgResult.Items;
    }

    private void ShowCreateDialog()
    {
        currentMember = new MemberDto { MemberType = 1 };
        isEdit = false;
        showDialog = true;
    }

    private void Edit(MemberDto member)
    {
        currentMember = new MemberDto
        {
            Id = member.Id,
            OrganizationId = member.OrganizationId,
            UserId = member.UserId,
            UserName = member.UserName,
            MemberType = member.MemberType,
            Sort = member.Sort,
            IsMain = member.IsMain,
            IsEnabled = member.IsEnabled,
            Remark = member.Remark
        };
        isEdit = true;
        showDialog = true;
    }

    private async Task Save()
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                await IMemberService.UpdateAsync(currentMember.Id, new UpdateMemberDto
                {
                    MemberType = currentMember.MemberType,
                    Sort = currentMember.Sort,
                    IsMain = currentMember.IsMain,
                    IsEnabled = currentMember.IsEnabled,
                    Remark = currentMember.Remark
                });
            }
            else
            {
                await IMemberService.AddAsync(new AddMemberDto
                {
                    OrganizationId = currentMember.OrganizationId,
                    UserId = currentMember.UserId,
                    MemberType = currentMember.MemberType,
                    Sort = currentMember.Sort,
                    IsMain = currentMember.IsMain,
                    Remark = currentMember.Remark
                });
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "确定要删除这个成员吗？");
        if (confirmed)
        {
            await Delete(id);
        }
    }

    private async Task Delete(Guid id)
    {
        await IMemberService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog()
    {
        showDialog = false;
    }
}
