@page "/organization/role"
@layout OrganizationLayout
@inject IRoleService IRoleService
@inject IJSRuntime JS

<Card Title="角色管理">
    <div style="margin-bottom: 16px;">
        <Button Type="@ButtonType.Primary" OnClick="@ShowCreateDialog">新增角色</Button>
    </div>

    <Table TItem="RoleDto" DataSource="@roles" Loading="@(roles == null)">
        <Column TData="string" Title="角色名称">
            @context.Name
        </Column>
        <Column TData="string" Title="编码">
            @context.Code
        </Column>
        <Column TData="string" Title="角色类型">
            @context.RoleTypeName
        </Column>
        <Column TData="string" Title="数据范围">
            @context.DataScopeName
        </Column>
        <Column TData="int" Title="成员数量">
            @context.MembersCount
        </Column>
        <Column TData="string" Title="状态">
            @if (context.IsEnabled)
            {
                <Tag Color="@("green")">启用</Tag>
            }
            else
            {
                <Tag Color="@("red")">禁用</Tag>
            }
        </Column>
        <Column TData="string" Title="操作">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(() => Edit(context))">编辑</Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="确定要删除这个角色吗？" OnConfirm="@(() => Delete(context.Id))">
                        <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Column>
    </Table>
</Card>

<Modal Title="@(isEdit ? "编辑角色" : "新增角色")" Visible="@showDialog" OnOk="@Save" OnCancel="@CloseDialog"
       ConfirmLoading="@isSubmitting">
    <Form Model="@currentRole" LabelColSpan="6" WrapperColSpan="18">
        <FormItem Label="角色名称">
            <Input @bind-Value="@currentRole.Name" Placeholder="请输入角色名称" />
        </FormItem>
        <FormItem Label="编码">
            <Input @bind-Value="@currentRole.Code" Placeholder="请输入编码" />
        </FormItem>
        <FormItem Label="角色类型">
            <Select TItem="int" TItemValue="int" @bind-Value="@currentRole.RoleType" Placeholder="请选择角色类型">
                <SelectOption Value="1" Label="系统角色" />
                <SelectOption Value="2" Label="自定义角色" />
            </Select>
        </FormItem>
        <FormItem Label="数据范围">
            <Select TItem="int" TItemValue="int" @bind-Value="@currentRole.DataScope" Placeholder="请选择数据范围">
                <SelectOption Value="1" Label="全部数据" />
                <SelectOption Value="2" Label="本部门数据" />
                <SelectOption Value="3" Label="仅本人数据" />
            </Select>
        </FormItem>
        <FormItem Label="排序">
            <AntDesign.InputNumber @bind-Value="@currentRole.Sort" Style="width: 100%;" />
        </FormItem>
        @if (isEdit)
        {
            <FormItem Label="启用">
                <Switch @bind-Value="@currentRole.IsEnabled" />
            </FormItem>
        }
        <FormItem Label="备注">
            <TextArea @bind-Value="@currentRole.Remark" Placeholder="请输入备注" Rows="3" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<RoleDto>? roles;
    private bool showDialog;
    private bool isEdit;
    private bool isSubmitting;
    private RoleDto currentRole = new() { RoleType = 2, DataScope = 1 };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await IRoleService.GetListAsync(new RoleQueryParams { PageSize = 100 });
        roles = result.Items;
    }

    private void ShowCreateDialog()
    {
        currentRole = new RoleDto { RoleType = 2, DataScope = 1 };
        isEdit = false;
        showDialog = true;
    }

    private void Edit(RoleDto role)
    {
        currentRole = new RoleDto
        {
            Id = role.Id,
            Name = role.Name,
            Code = role.Code,
            RoleType = role.RoleType,
            DataScope = role.DataScope,
            Sort = role.Sort,
            IsEnabled = role.IsEnabled,
            Remark = role.Remark
        };
        isEdit = true;
        showDialog = true;
    }

    private async Task Save(MouseEventArgs e)
    {
        isSubmitting = true;
        try
        {
            if (isEdit)
            {
                await IRoleService.UpdateAsync(currentRole.Id, new UpdateRoleDto
                {
                    Name = currentRole.Name,
                    Code = currentRole.Code,
                    RoleType = currentRole.RoleType,
                    DataScope = currentRole.DataScope,
                    Sort = currentRole.Sort,
                    IsEnabled = currentRole.IsEnabled,
                    Remark = currentRole.Remark
                });
            }
            else
            {
                await IRoleService.CreateAsync(new CreateRoleDto
                {
                    Name = currentRole.Name,
                    Code = currentRole.Code,
                    RoleType = currentRole.RoleType,
                    DataScope = currentRole.DataScope,
                    Sort = currentRole.Sort,
                    Remark = currentRole.Remark
                });
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Delete(Guid id)
    {
        await IRoleService.DeleteAsync(id);
        await LoadData();
    }

    private void CloseDialog(MouseEventArgs? e = null)
    {
        showDialog = false;
    }
}
