@namespace H.Approval.Web
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<link href="@Assets["_content/H.Approval.Web/css/approval-designer.css"]" rel="stylesheet" />

<div style="display: flex; flex-direction: column; height: 100vh;">
    <div class="fd-nav">
        <div class="fd-nav-left">
            <div class="fd-nav-back" @onclick="toReturn">
                <i class="anticon anticon-left"></i>
            </div>
            <div class="fd-nav-title">审批设计器</div>
        </div>
        <div class="fd-nav-right">
            <button type="button" class="ant-btn button-preview"><span>预览</span></button>
            <button type="button" class="ant-btn button-publish" @onclick="saveSet"><span>发布</span></button>
        </div>
    </div>
    <div class="fd-nav-content">
        <section class="dingflow-design">
            <div class="zoom">
                <div class="zoom-out">-</div>
                <span>100%</span>
                <div class="zoom-in">+</div>
            </div>
            <div id="box-scale" class="box-scale" style="transform: scale(1); transform-origin: 50% 0px 0px;">
                @Body
            </div>
        </section>
    </div>
</div>

@code {
    private void toReturn()
    {
        NavigationManager.NavigateTo("/approval/management");
    }
    
    private void saveSet()
    {
        // TODO: 保存审批设计
        Console.WriteLine("保存审批设计");
    }
}
