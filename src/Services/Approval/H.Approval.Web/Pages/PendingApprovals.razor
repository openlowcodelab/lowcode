@page "/approval/pending"
@layout ApprovalLayout

<h3>待我审批</h3>

<HTable ShowEmpty="@(!pendingTasks.Any())">
    <thead>
        <tr>
            <th>审批标题</th>
            <th>审批名称</th>
            <th>当前节点</th>
            <th>到达时间</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in pendingTasks)
        {
            <tr>
                <td>@item.InstanceTitle</td>
                <td>@item.ApprovalName</td>
                <td>@item.NodeName</td>
                <td>@item.CreationTime</td>
                <td>
                    <button class="h-btn h-btn-primary h-btn-sm" @onclick="() => Approve(item)">通过</button>
                    <button class="h-btn h-btn-danger h-btn-sm" @onclick="() => Reject(item)">驳回</button>
                    <button class="h-btn h-btn-ghost h-btn-sm">详情</button>
                </td>
            </tr>
        }
    </tbody>
</HTable>

@code {
    private List<ApprovalTaskDto> pendingTasks = new();
    
    protected override async Task OnInitializedAsync()
    {
        pendingTasks = new List<ApprovalTaskDto>
        {
            new() 
            { 
                Id = "TASK001",
                InstanceTitle = "张三的请假申请", 
                ApprovalName = "请假审批",
                NodeName = "部门经理审批",
                CreationTime = DateTime.Now.AddHours(-2)
            }
        };
    }
    
    private async Task Approve(ApprovalTaskDto task)
    {
        Console.WriteLine($"审批通过: {task.InstanceTitle}");
    }
    
    private async Task Reject(ApprovalTaskDto task)
    {
        Console.WriteLine($"审批驳回: {task.InstanceTitle}");
    }
}
