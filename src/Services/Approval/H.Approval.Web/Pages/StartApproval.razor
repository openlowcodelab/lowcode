@page "/approval/start"
@layout ApprovalLayout

@inject IApprovalDefinitionAppService DefinitionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="start-approval">
    <div class="start-header">
        <div class="start-search">
            <span class="start-search-icon">🔍</span>
            <input class="start-search-input" @bind="keyword" @bind:event="oninput" placeholder="请输入审批单名称" />
        </div>
        <div class="start-shortcuts">
            <a class="start-shortcut" @onclick='() => GoCenter("pending")'>待处理的 ›</a>
            <a class="start-shortcut" @onclick='() => GoCenter("completed")'>已处理的 ›</a>
            <a class="start-shortcut" @onclick='() => GoCenter("my")'>我发起的 ›</a>
            <a class="start-shortcut" @onclick='() => GoCenter("cc")'>抄送我的 ›</a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
    }
    else if (!FilteredGroups.Any())
    {
        <div class="h-alert h-alert-error">
            <span>暂无已启用的审批流程,请先在「审批管理」中创建并发布。</span>
        </div>
    }
    else
    {
        <div class="start-tabs">
            <a class="start-tab @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")" @onclick='() => selectedCategory = string.Empty'>全部</a>
            @foreach (var group in FilteredGroups)
            {
                <a class="start-tab @(selectedCategory == group.Key ? "active" : "")" @onclick="() => selectedCategory = group.Key">@group.Key</a>
            }
        </div>

        <div class="start-body">
            @foreach (var group in VisibleGroups)
            {
                <div class="start-group">
                    <div class="start-group-title">@group.Key</div>
                    <div class="start-card-grid">
                        @foreach (var def in group.Value)
                        {
                            <div class="start-card" @onclick="() => StartDefinition(def.Id)">
                                <span class="start-card-icon">@(string.IsNullOrEmpty(def.Icon) ? "📄" : def.Icon)</span>
                                <span class="start-card-name">@def.Name</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ApprovalDefinitionDto> approvalDefinitions = new();
    private bool isLoading = true;
    private string keyword = string.Empty;
    private string selectedCategory = string.Empty;

    private const string UncategorizedName = "其他";

    private List<KeyValuePair<string, List<ApprovalDefinitionDto>>> FilteredGroups
    {
        get
        {
            var filtered = approvalDefinitions
                .Where(d => string.IsNullOrWhiteSpace(keyword)
                            || d.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase));

            return filtered
                .GroupBy(d => string.IsNullOrWhiteSpace(d.CategoryName) ? UncategorizedName : d.CategoryName!)
                .Select(g => new KeyValuePair<string, List<ApprovalDefinitionDto>>(g.Key, g.ToList()))
                .OrderBy(g => g.Key == UncategorizedName ? 1 : 0)
                .ThenBy(g => g.Key)
                .ToList();
        }
    }

    private List<KeyValuePair<string, List<ApprovalDefinitionDto>>> VisibleGroups
        => string.IsNullOrEmpty(selectedCategory)
            ? FilteredGroups
            : FilteredGroups.Where(g => g.Key == selectedCategory).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await DefinitionService.GetAllAsync();
            // 仅展示已启用的审批定义
            approvalDefinitions = all.Where(d => d.IsEnabled).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"加载审批定义失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartDefinition(string id)
    {
        Nav.NavigateTo($"/approval/start/{id}");
    }

    private void GoCenter(string tab)
    {
        Nav.NavigateTo($"/approval/center?tab={tab}");
    }
}
