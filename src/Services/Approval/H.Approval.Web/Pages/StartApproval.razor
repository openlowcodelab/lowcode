@page "/approval/start"
@layout ApprovalLayout

@inject IApprovalDefinitionAppService DefinitionService
@inject IApprovalInstanceAppService InstanceService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>发起审批</h3>

@if (isLoading)
{
    <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
}
else if (!approvalDefinitions.Any())
{
    <div class="h-alert h-alert-error">
        <span>暂无已启用的审批流程,请先在「审批管理」中创建并发布。</span>
    </div>
}
else
{
    <div class="h-alert h-alert-success">选择审批类型并填写相关信息</div>

    <form @onsubmit="OnFinish">
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label"><span class="h-required">*</span> 审批类型</label>
            <div class="h-form-control">
                <select class="h-select" @bind="model.DefinitionId">
                    <option value="">请选择审批类型</option>
                    @foreach (var def in approvalDefinitions)
                    {
                        <option value="@def.Id">@(def.Icon) @def.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label"><span class="h-required">*</span> 审批标题</label>
            <div class="h-form-control">
                <input class="h-input" @bind="model.Title" placeholder="请输入审批标题" />
            </div>
        </div>

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">审批说明</label>
            <div class="h-form-control">
                <textarea class="h-textarea" rows="4" @bind="model.VariablesJson"></textarea>
            </div>
        </div>

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label"></label>
            <div class="h-form-control">
                <button type="submit" class="h-btn h-btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="h-btn-loading"></span>
                    }
                    提交审批
                </button>
                <button type="button" class="h-btn" style="margin-left: 8px;" @onclick="Reset">重置</button>
            </div>
        </div>
    </form>
}

@code {
    private StartApprovalInstanceDto model = new();
    private List<ApprovalDefinitionDto> approvalDefinitions = new();
    private bool isLoading = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await DefinitionService.GetAllAsync();
            // 仅展示已启用的审批定义
            approvalDefinitions = all.Where(d => d.IsEnabled).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"加载审批定义失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFinish()
    {
        if (string.IsNullOrWhiteSpace(model.DefinitionId))
        {
            await JS.InvokeVoidAsync("alert", "请选择审批类型");
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Title))
        {
            await JS.InvokeVoidAsync("alert", "请输入审批标题");
            return;
        }

        isSubmitting = true;
        try
        {
            var result = await InstanceService.StartAsync(model);
            await JS.InvokeVoidAsync("alert", "审批已提交");
            Nav.NavigateTo($"/approval/detail/{result.Id}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"提交失败: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Reset()
    {
        model = new StartApprovalInstanceDto();
        StateHasChanged();
    }
}
