@page "/approval/designer/{ApprovalId}"

@namespace H.Approval.Web
@layout ApprovalDesignerLayout
@inject IApprovalDefinitionAppService ApprovalDefinitionAppService
@inject NavigationManager Nav
@inject MessageService Message

<PageTitle>审批设计器</PageTitle>

@if (definition == null)
{
    <div style="padding: 40px; text-align: center;">
        <Spin Tip="加载中..." />
    </div>
}
else
{
    @if (DesignerLayout?.ActiveTab == "basic")
    {
        <BasicSettings Definition="@definition" OnSettingsChanged="OnBasicSettingsChanged" />
    }
    else if (DesignerLayout?.ActiveTab == "flow")
    {
        <div class="flow-design-container">
            <div class="flow-design-canvas" style="transform: scale(@(ZoomLevel / 100.0)); transform-origin: center top;">
                <NodeWrap Node="@RootNode" OnNodeTreeChanged="OnNodeTreeChanged" />
                <EndNode />
            </div>
            
            <div class="zoom-control">
                <button class="zoom-btn" @onclick="ZoomOut" disabled="@(ZoomLevel <= 50)">-</button>
                <span class="zoom-level">@ZoomLevel%</span>
                <button class="zoom-btn" @onclick="ZoomIn" disabled="@(ZoomLevel >= 150)">+</button>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public string ApprovalId { get; set; } = string.Empty;
    
    [CascadingParameter]
    public ApprovalDesignerLayout? DesignerLayout { get; set; }
    
    private ApprovalDefinitionDto? definition;
    private int ZoomLevel { get; set; } = 100;
    
    /// <summary>
    /// 根节点 - 发起人节点
    /// </summary>
    public NodeModelBase RootNode { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        InitDefaultNodeTree();
        
        try
        {
            if (ApprovalId == "_new")
            {
                definition = new ApprovalDefinitionDto
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = "新审批",
                    Icon = "💰",
                    WhoCanStart = "All",
                    AdminType = "All"
                };
            }
            else
            {
                definition = await ApprovalDefinitionAppService.GetByIdAsync(ApprovalId);
            }
            
            if (definition != null && !string.IsNullOrEmpty(definition.DefinitionJson) && definition.DefinitionJson != "{}")
            {
                // TODO: 从json反序列化节点树
            }
        }
        catch (Exception ex)
        {
            Message.Error($"加载审批定义失败: {ex.Message}");
        }
    }
    
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && DesignerLayout != null)
        {
            DesignerLayout.OnTabChanged += OnTabChanged;
            DesignerLayout.OnPublishRequested += OnPublishAsync;
            
            if (definition != null)
            {
                DesignerLayout.UpdateHeader(definition.Icon, definition.Name);
            }
        }
    }
    
    private void OnTabChanged(string tab)
    {
        StateHasChanged();
    }
    
    private void InitDefaultNodeTree()
    {
        RootNode = new StartNodeModel()
        {
            Id = Guid.NewGuid().ToString(),
            NodeName = "发起人",
            NodeType = NodeTypeEnum.Start,
            ChildNodes = new List<NodeModelBase>
            {
                new ApproveModel()
                {
                    Id = Guid.NewGuid().ToString(),
                    NodeName = "审批人",
                    NodeType = NodeTypeEnum.Approve,
                    ApproverType = ApproverTypeEnum.StarterSelect,
                    ChildNodes = new List<NodeModelBase>
                    {
                        new CarbonCopyModel()
                        {
                            Id = Guid.NewGuid().ToString(),
                            NodeName = "抄送人",
                            NodeType = NodeTypeEnum.CarbonCopy,
                            CarbonCopyType = CarbonCopyTypeEnum.StarterSelect
                        }
                    }
                }
            }
        };
    }
    
    private void OnBasicSettingsChanged(ApprovalDefinitionDto settings)
    {
        if (definition != null)
        {
            definition.Icon = settings.Icon;
            definition.Name = settings.Name;
            definition.CategoryId = settings.CategoryId;
            definition.CategoryName = settings.CategoryName;
            definition.Description = settings.Description;
            definition.WhoCanStart = settings.WhoCanStart;
            definition.AdminType = settings.AdminType;
            definition.SpecifiedStarters = settings.SpecifiedStarters;
            definition.SpecifiedAdmins = settings.SpecifiedAdmins;
            
            DesignerLayout?.UpdateHeader(definition.Icon, definition.Name);
        }
    }
    
    private void OnNodeTreeChanged()
    {
        StateHasChanged();
    }
    
    private void ZoomIn()
    {
        if (ZoomLevel < 150)
        {
            ZoomLevel += 10;
        }
    }
    
    private void ZoomOut()
    {
        if (ZoomLevel > 50)
        {
            ZoomLevel -= 10;
        }
    }
    
    private async Task OnPublishAsync()
    {
        if (definition == null)
        {
            Message.Error("审批定义未加载");
            return;
        }
        
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(RootNode);
            
            if (ApprovalId == "_new")
            {
                await ApprovalDefinitionAppService.CreateAsync(new CreateApprovalDefinitionDto
                {
                    Name = definition.Name,
                    Description = definition.Description,
                    Icon = definition.Icon,
                    CategoryId = definition.CategoryId,
                    CategoryName = definition.CategoryName,
                    WhoCanStart = definition.WhoCanStart,
                    SpecifiedStarters = definition.SpecifiedStarters,
                    AdminType = definition.AdminType,
                    SpecifiedAdmins = definition.SpecifiedAdmins,
                    DefinitionJson = json
                });
            }
            else
            {
                await ApprovalDefinitionAppService.UpdateAsync(new UpdateApprovalDefinitionDto
                {
                    Id = ApprovalId,
                    Name = definition.Name,
                    Description = definition.Description,
                    Icon = definition.Icon,
                    CategoryId = definition.CategoryId,
                    CategoryName = definition.CategoryName,
                    WhoCanStart = definition.WhoCanStart,
                    SpecifiedStarters = definition.SpecifiedStarters,
                    AdminType = definition.AdminType,
                    SpecifiedAdmins = definition.SpecifiedAdmins,
                    DefinitionJson = json
                });
            }
            
            Message.Success("发布成功");
            Nav.NavigateTo("/approval/management");
        }
        catch (Exception ex)
        {
            Message.Error($"发布失败: {ex.Message}");
        }
    }
    
    public void Dispose()
    {
        if (DesignerLayout != null)
        {
            DesignerLayout.OnTabChanged -= OnTabChanged;
            DesignerLayout.OnPublishRequested -= OnPublishAsync;
        }
    }
}
