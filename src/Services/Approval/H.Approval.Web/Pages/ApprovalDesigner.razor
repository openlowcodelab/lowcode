@page "/approval/designer/{AppId}/{ApprovalId}"

@namespace H.Approval.Web
@layout ApprovalDesignerLayout
@inject IApprovalDefinitionAppService ApprovalDefinitionAppService
@inject NavigationManager Nav
@inject MessageService Message

<link href="@Assets["_content/H.Approval.Web/css/dialog.css"]" rel="stylesheet" />
<link href="@Assets["_content/H.Approval.Web/css/override-element-ui.css"]" rel="stylesheet" />
<link href="@Assets["_content/H.Approval.Web/css/approval.css"]" rel="stylesheet" />
<link href="@Assets["_content/H.Approval.Web/css/app.css"]" rel="stylesheet" />
<link href="@Assets["_content/H.Approval.Web/css/chunk-vendors.dd03f60f.css"]" rel="stylesheet" />

<NodeWrap Node="@Node"></NodeWrap>
<EndNode></EndNode>

@code {
    [Parameter]
    public string AppId { get; set; } = string.Empty;

    [Parameter]
    public string ApprovalId { get; set; } = string.Empty;
    
    private ApprovalDefinitionDto? definition;
    private bool saving = false;

    public NodeModelBase Node = new StartNodeModel()
    {
        NodeName = "发起人",
        NodeType = NodeTypeEnum.Start,
        ChildNodes =
        {
            new ApproveModel()
            {
                NodeName = "审核人", NodeType = NodeTypeEnum.Approve,
                ChildNodes = new List<NodeModelBase>()
                {
                    new BranchModel(){
                        NodeName = "路由", NodeType = NodeTypeEnum.Branch,
                        ConditionNodes = new List<NodeModelBase>()
                        {
                            new ConditionModel(){
                                NodeName = "条件1", NodeType = NodeTypeEnum.Condition,
                                ChildNodes = new List<NodeModelBase>()
                                {
                                    new ApproveModel(){ NodeName = "审核人", NodeType = NodeTypeEnum.Approve }
                                }
                            },
                            new ConditionModel(){ NodeName = "条件2", NodeType = NodeTypeEnum.Condition }
                        },
                        ChildNodes = new List<NodeModelBase>()
                        {
                            new CarbonCopyModel(){ NodeName = "抄送人", NodeType = NodeTypeEnum.CarbonCopy }
                        }
                    }
                }
            }
        }
    };
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            definition = await ApprovalDefinitionAppService.GetByIdAsync(ApprovalId);
            
            if (!string.IsNullOrEmpty(definition?.DefinitionJson) && definition.DefinitionJson != "{}")
            {
                // TODO: 从JSON反序列化节点树
                // Node = JsonSerializer.Deserialize<NodeModelBase>(definition.DefinitionJson);
            }
        }
        catch (Exception ex)
        {
            Message.Error($"加载审批定义失败: {ex.Message}");
        }
    }
    
    private async Task SaveDesign()
    {
        if (definition == null)
        {
            Message.Error("审批定义未加载");
            return;
        }
        
        saving = true;
        StateHasChanged();
        
        try
        {
            // TODO: 将节点树序列化为JSON
            var json = "{}"; // JsonSerializer.Serialize(Node);
            
            await ApprovalDefinitionAppService.UpdateAsync(new UpdateApprovalDefinitionDto
            {
                Id = ApprovalId,
                Name = definition.Name,
                Description = definition.Description,
                DefinitionJson = json
            });
            
            Message.Success("保存成功");
            Nav.NavigateTo("/approval/management");
        }
        catch (Exception ex)
        {
            Message.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
    
    private void Cancel()
    {
        Nav.NavigateTo("/approval/management");
    }
}
