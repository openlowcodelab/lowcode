@page "/approval/my"
@layout ApprovalLayout

<h3>我发起的审批</h3>

<AntDesign.Table DataSource="@myApprovals" TItem="ApprovalInstanceDto">
    <AntDesign.Column TData="string" @bind-Field="@context.Id" Title="审批实例ID" />
    <AntDesign.Column TData="string" @bind-Field="@context.DefinitionName" Title="审批名称" />
    <AntDesign.Column TData="ApprovalStatusEnum" Title="状态">
        <Template>
            <span>@context.Status.ToString()</span>
        </Template>
    </AntDesign.Column>
    <AntDesign.Column TData="string" @bind-Field="@context.CurrentNodeName" Title="当前节点" />
    <AntDesign.Column TData="DateTime" @bind-Field="@context.CreationTime" Title="发起时间" />
    <AntDesign.Column TData="string" Title="操作">
        <AntDesign.Button Type="@ButtonType.Link" Size="@ButtonSize.Small">查看</AntDesign.Button>
    </AntDesign.Column>
</AntDesign.Table>

@code {
    private List<ApprovalInstanceDto> myApprovals = new();
    
    protected override async Task OnInitializedAsync()
    {
        // TODO: 加载我发起的审批实例
        // myApprovals = await ApprovalInstanceService.GetMyApprovalsAsync(userId);
        
        // 模拟数据
        myApprovals = new List<ApprovalInstanceDto>
        {
            new() 
            { 
                Id = "INST001", 
                DefinitionName = "请假审批", 
                Status = ApprovalStatusEnum.Running,
                CurrentNodeName = "部门经理审批",
                CreationTime = DateTime.Now.AddDays(-1)
            }
        };
    }
}
