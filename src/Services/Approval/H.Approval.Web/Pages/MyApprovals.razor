@page "/approval/my"
@layout ApprovalLayout

<h3>我发起的审批</h3>

<HTable ShowEmpty="@(!myApprovals.Any())">
    <thead>
        <tr>
            <th>审批实例ID</th>
            <th>审批名称</th>
            <th>状态</th>
            <th>当前节点</th>
            <th>发起时间</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in myApprovals)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.DefinitionName</td>
                <td>@item.Status.ToString()</td>
                <td>@item.CurrentNodeName</td>
                <td>@item.CreationTime</td>
                <td>
                    <button class="h-btn h-btn-ghost h-btn-sm">查看</button>
                </td>
            </tr>
        }
    </tbody>
</HTable>

@code {
    private List<ApprovalInstanceDto> myApprovals = new();
    
    protected override async Task OnInitializedAsync()
    {
        myApprovals = new List<ApprovalInstanceDto>
        {
            new() 
            { 
                Id = "INST001", 
                DefinitionName = "请假审批", 
                Status = ApprovalStatusEnum.Running,
                CurrentNodeName = "部门经理审批",
                CreationTime = DateTime.Now.AddDays(-1)
            }
        };
    }
}
