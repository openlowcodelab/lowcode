@page "/approval/my"
@layout ApprovalLayout

@inject IApprovalInstanceAppService InstanceService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>我发起的审批</h3>

@if (isLoading)
{
    <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
}
else
{
    <HTable ShowEmpty="@(!myApprovals.Any())">
        <thead>
            <tr>
                <th>审批标题</th>
                <th>审批名称</th>
                <th>状态</th>
                <th>当前节点</th>
                <th>发起时间</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in myApprovals)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.DefinitionName</td>
                    <td>
                        <span class="h-tag @GetStatusClass(item.Status)">
                            @GetStatusText(item.Status)
                        </span>
                    </td>
                    <td>@(item.CurrentNodeName ?? "-")</td>
                    <td>@item.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <button class="h-btn h-btn-ghost h-btn-sm" @onclick="() => View(item.Id)">查看</button>
                        @if (item.Status == ApprovalStatusEnum.Running)
                        {
                            <button class="h-btn h-btn-danger h-btn-sm" @onclick="() => Cancel(item.Id)">取消</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </HTable>
}

@code {
    private List<ApprovalInstanceDto> myApprovals = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            myApprovals = await InstanceService.GetMyApprovalsAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"加载失败: {ex.Message}");
            myApprovals = new List<ApprovalInstanceDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void View(string id)
    {
        Nav.NavigateTo($"/approval/detail/{id}");
    }

    private async Task Cancel(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "确认取消该审批实例?");
        if (!confirmed) return;
        try
        {
            await InstanceService.CancelAsync(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"取消失败: {ex.Message}");
        }
    }

    private string GetStatusText(ApprovalStatusEnum status) => status switch
    {
        ApprovalStatusEnum.Draft => "草稿",
        ApprovalStatusEnum.Running => "运行中",
        ApprovalStatusEnum.Completed => "已完成",
        ApprovalStatusEnum.Cancelled => "已取消",
        ApprovalStatusEnum.Rejected => "已驳回",
        _ => status.ToString()
    };

    private string GetStatusClass(ApprovalStatusEnum status) => status switch
    {
        ApprovalStatusEnum.Running => "h-tag-blue",
        ApprovalStatusEnum.Completed => "h-tag-green",
        ApprovalStatusEnum.Cancelled => "h-tag-default",
        ApprovalStatusEnum.Rejected => "h-tag-red",
        _ => "h-tag-default"
    };
}
