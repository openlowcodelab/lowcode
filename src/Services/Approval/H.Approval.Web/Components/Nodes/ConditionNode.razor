@namespace H.Approval.Web

@*条件节点*@
<div class="condition-node">
    <div class="condition-node-box">
        <div class="auto-judge" @onclick="() => OnNodeClick.InvokeAsync(Node)" @onclick:stopPropagation>
            <div class="title-wrapper">
                <span class="editable-title">@Node.NodeName</span>
                @if (conditionModel?.IsDefault == true)
                {
                    <span class="priority-title">默认</span>
                }
                else
                {
                    <span class="priority-title">@(index + 1)</span>
                }
                <i class="anticon anticon-close close" @onclick="DeleteSelf" @onclick:stopPropagation></i>
            </div>
            <div class="sort-right">&gt;</div>
            <div class="content">
                @{
                    var cm = conditionModel;
                    if (cm == null)
                    {
                        <text>请设置条件</text>
                    }
                    else if (cm.IsDefault)
                    {
                        <text>默认分支</text>
                    }
                    else if (cm.Rules == null || cm.Rules.Count == 0)
                    {
                        <text>请设置条件</text>
                    }
                    else
                    {
                        @string.Join(" 且 ", cm.Rules.Select(r => $"{r.Field} {r.Operator} {r.Value}"))
                    }
                }
            </div>
        </div>
        <AddNodeButton OnAddNode="OnAddNode" />
    </div>
</div>

@*递归渲染子节点*@
@foreach(var childNode in Node.ChildNodes)
{
    <NodeWrap Node="@childNode" OnNodeTreeChanged="OnNodeTreeChanged" OnNodeClick="OnNodeClick" OnDeleteNode="OnDeleteNode" />
}

@code {
    [Parameter]
    public NodeModelBase Node { get; set; } = null!;

    [Parameter]
    public EventCallback<NodeModelBase> OnAddNode { get; set; }

    [Parameter]
    public EventCallback OnNodeTreeChanged { get; set; }

    [Parameter]
    public EventCallback<NodeModelBase> OnNodeClick { get; set; }

    [Parameter]
    public EventCallback<NodeModelBase> OnDeleteNode { get; set; }

    [Parameter]
    public int Index { get; set; }

    private ConditionModel? conditionModel => Node as ConditionModel;
    private int index => Index;

    private async Task DeleteSelf()
    {
        await OnDeleteNode.InvokeAsync(Node);
    }
}
