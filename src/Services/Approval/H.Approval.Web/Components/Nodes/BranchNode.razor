@namespace H.Approval.Web

@*条件分支按钮*@
<div class="branch-box-wrap">
    <div class="branch-box">
        <button class="add-branch" @onclick="AddBranchNode">添加条件</button>
        @*渲染条件子节点*@
        @for (var i = 0; i < Node.ConditionNodes.Count; i++)
        {
            var idx = i;
            <div class="col-box">
                <NodeWrap Node="@Node.ConditionNodes[idx]" OnNodeTreeChanged="OnNodeTreeChanged" OnNodeClick="OnNodeClick" OnDeleteNode="OnDeleteNode" />
                
                @if (idx == 0)
                {
                    <div class="top-left-cover-line"></div>
                    <div class="bottom-left-cover-line"></div>
                }
                else if (idx == Node.ConditionNodes.Count - 1)
                {
                    <div class="top-right-cover-line"></div>
                    <div class="bottom-right-cover-line"></div>
                }
            </div>
        }
    </div>
    <AddNodeButton OnAddNode="OnAddNode" />
</div>

@code {
    [Parameter]
    public NodeModelBase Node { get; set; } = null!;

    [Parameter]
    public EventCallback<NodeModelBase> OnAddNode { get; set; }

    [Parameter]
    public EventCallback OnNodeTreeChanged { get; set; }

    [Parameter]
    public EventCallback<NodeModelBase> OnNodeClick { get; set; }

    [Parameter]
    public EventCallback<NodeModelBase> OnDeleteNode { get; set; }

    private void AddBranchNode()
    {
        var newCondition = new ConditionModel
        {
            Id = Guid.NewGuid().ToString(),
            NodeName = $"条件{Node.ConditionNodes.Count + 1}"
        };
        Node.ConditionNodes.Add(newCondition);
        OnNodeTreeChanged.InvokeAsync();
    }
}
