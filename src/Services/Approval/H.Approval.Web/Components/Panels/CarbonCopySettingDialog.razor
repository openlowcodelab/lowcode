@namespace H.Approval.Web

<div class="setting-panel">
    <div class="setting-section">
        <div class="setting-label">抄送人类型</div>
        <div class="h-radio-group">
            <label class="h-radio-button">
                <input type="radio" name="ccType" value="0" checked="@(ccTypeValue == 0)" @onchange="() => OnCcTypeChanged(0)" />指定成员
            </label>
            <label class="h-radio-button">
                <input type="radio" name="ccType" value="1" checked="@(ccTypeValue == 1)" @onchange="() => OnCcTypeChanged(1)" />发起人自选
            </label>
            <label class="h-radio-button">
                <input type="radio" name="ccType" value="2" checked="@(ccTypeValue == 2)" @onchange="() => OnCcTypeChanged(2)" />指定角色
            </label>
        </div>
    </div>

    @if (Node.CarbonCopyType == CarbonCopyTypeEnum.Specified || Node.CarbonCopyType == CarbonCopyTypeEnum.StarterSelect)
    {
        <div class="setting-section">
            <div class="setting-label">
                @(Node.CarbonCopyType == CarbonCopyTypeEnum.Specified ? "指定抄送人" : "可选抄送人范围")
            </div>

            @if ((Node.SpecifiedUserNames ?? new List<string>()).Any())
            {
                <div class="selected-users">
                    @for (var i = 0; i < Node.SpecifiedUserNames.Count; i++)
                    {
                        var idx = i;
                        <span class="selected-user-tag">
                            @Node.SpecifiedUserNames[idx]
                            <span class="remove-btn" @onclick="() => RemoveUser(idx)">&times;</span>
                        </span>
                    }
                </div>
            }

            @if (showUserPicker)
            {
                <UserPickerDialog SelectedIds="@pickerSelectedIds" SelectedNames="@pickerSelectedNames" OnConfirm="OnUserPickerConfirm" />
            }
            else
            {
                <button class="add-user-btn" @onclick="ShowUserPicker">
                    <span>+</span> 添加抄送人
                </button>
            }
        </div>
    }

    @if (Node.CarbonCopyType == CarbonCopyTypeEnum.Role)
    {
        <div class="setting-section">
            <div class="setting-label">指定角色</div>
            <div class="setting-hint">请输入角色名称(逗号分隔)</div>
            <textarea class="h-textarea" rows="3"
                      value="@specifiedRolesText"
                      @oninput="OnSpecifiedRolesInput"
                      placeholder="请输入角色名称，多个用逗号分隔"></textarea>
        </div>
    }

    <div class="setting-actions">
        <button class="h-btn h-btn-primary" @onclick="SaveSettings">确 定</button>
    </div>
</div>

@code {
    [Parameter]
    public CarbonCopyModel Node { get; set; } = null!;

    [Parameter]
    public EventCallback OnSave { get; set; }

    private int ccTypeValue;
    private string specifiedRolesText = "";
    private bool showUserPicker = false;
    private List<string> pickerSelectedIds = new();
    private List<string> pickerSelectedNames = new();

    protected override void OnParametersSet()
    {
        if (Node != null)
        {
            ccTypeValue = (int)Node.CarbonCopyType;
            specifiedRolesText = string.Join(",", Node.SpecifiedRoles ?? new List<string>());
            Node.SpecifiedUsers ??= new List<string>();
            Node.SpecifiedUserNames ??= new List<string>();
        }
    }

    private void OnCcTypeChanged(int value)
    {
        Node.CarbonCopyType = (CarbonCopyTypeEnum)value;
    }

    private void OnSpecifiedRolesInput(ChangeEventArgs e)
    {
        specifiedRolesText = e.Value?.ToString() ?? "";
        Node.SpecifiedRoles = specifiedRolesText.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        Node.SpecifiedRoleNames = new List<string>(Node.SpecifiedRoles);
    }

    private void ShowUserPicker()
    {
        pickerSelectedIds = new List<string>(Node.SpecifiedUsers ?? new List<string>());
        pickerSelectedNames = new List<string>(Node.SpecifiedUserNames ?? new List<string>());
        showUserPicker = true;
    }

    private void OnUserPickerConfirm((List<string> Ids, List<string> Names) result)
    {
        Node.SpecifiedUsers = result.Ids;
        Node.SpecifiedUserNames = result.Names;
        showUserPicker = false;
        StateHasChanged();
    }

    private void RemoveUser(int index)
    {
        if (index < Node.SpecifiedUsers.Count) Node.SpecifiedUsers.RemoveAt(index);
        if (index < Node.SpecifiedUserNames.Count) Node.SpecifiedUserNames.RemoveAt(index);
    }

    private async Task SaveSettings()
    {
        await OnSave.InvokeAsync();
    }
}
