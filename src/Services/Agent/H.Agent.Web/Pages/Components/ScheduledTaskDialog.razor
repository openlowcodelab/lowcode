@namespace H.Agent.Web.Pages.Components

<div class="scheduled-task-dialog">
    <div class="dialog-overlay" @onclick="Close"></div>
    <div class="dialog-content">
        <div class="dialog-header">
            <h3>@(IsEdit ? "编辑定时任务" : "创建定时任务")</h3>
            <button class="dialog-close" @onclick="Close">@IconSvg("close")</button>
        </div>
        <div class="dialog-body">
            <div class="form-group">
                <label class="form-label">任务名称 <span class="required">*</span></label>
                <input type="text" class="form-input" @bind="Input.TaskName" placeholder="输入任务名称" maxlength="100" />
            </div>

            <div class="form-group">
                <label class="form-label">任务描述</label>
                <input type="text" class="form-input" @bind="Input.TaskDescription" placeholder="输入任务描述（可选）" maxlength="500" />
            </div>

            <div class="form-group">
                <label class="form-label">提示词内容 <span class="required">*</span></label>
                <textarea class="form-textarea" @bind="Input.PromptContent" @bind:event="oninput" placeholder="输入要执行的任务内容..." rows="6"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Agent 类型</label>
                    <select class="form-select" @bind="Input.AgentType">
                        @foreach (var agent in Agents)
                        {
                            <option value="@agent.AgentType">@agent.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">模型</label>
                    <select class="form-select" @bind="SelectedModelId">
                        <option value="">默认</option>
                        @foreach (var model in Models)
                        {
                            <option value="@model.Id">@model.ProviderDisplayName - @model.Model</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">调度类型 <span class="required">*</span></label>
                <select class="form-select" @bind="Input.ScheduleType">
                    <option value="Once">仅一次</option>
                    <option value="Daily">每天</option>
                    <option value="Weekly">每周</option>
                    <option value="Monthly">每月</option>
                    <option value="Cron">Cron 表达式</option>
                </select>
            </div>

            @if (Input.ScheduleType == "Daily")
            {
                <div class="schedule-config">
                    <div class="config-title">执行时间</div>
                    <div class="time-config">
                        <div class="time-input-group">
                            <label>小时</label>
                            <input type="number" class="form-input" @bind="Input.Hour" min="0" max="23" />
                        </div>
                        <div class="time-input-group">
                            <label>分钟</label>
                            <input type="number" class="form-input" @bind="Input.Minute" min="0" max="59" />
                        </div>
                    </div>
                </div>
            }
            else if (Input.ScheduleType == "Weekly")
            {
                <div class="schedule-config">
                    <div class="config-title">执行时间</div>
                    <div class="weekly-config">
                        <div class="day-input-group">
                            <label>星期</label>
                            <select class="form-select" @bind="Input.DayOfWeek">
                                <option value="1">周一</option>
                                <option value="2">周二</option>
                                <option value="3">周三</option>
                                <option value="4">周四</option>
                                <option value="5">周五</option>
                                <option value="6">周六</option>
                                <option value="0">周日</option>
                            </select>
                        </div>
                        <div class="time-input-group">
                            <label>小时</label>
                            <input type="number" class="form-input" @bind="Input.Hour" min="0" max="23" />
                        </div>
                        <div class="time-input-group">
                            <label>分钟</label>
                            <input type="number" class="form-input" @bind="Input.Minute" min="0" max="59" />
                        </div>
                    </div>
                </div>
            }
            else if (Input.ScheduleType == "Monthly")
            {
                <div class="schedule-config">
                    <div class="config-title">执行时间</div>
                    <div class="monthly-config">
                        <div class="day-input-group">
                            <label>日期</label>
                            <input type="number" class="form-input" @bind="Input.DayOfMonth" min="1" max="31" />
                        </div>
                        <div class="time-input-group">
                            <label>小时</label>
                            <input type="number" class="form-input" @bind="Input.Hour" min="0" max="23" />
                        </div>
                        <div class="time-input-group">
                            <label>分钟</label>
                            <input type="number" class="form-input" @bind="Input.Minute" min="0" max="59" />
                        </div>
                    </div>
                </div>
            }
            else if (Input.ScheduleType == "Cron")
            {
                <div class="schedule-config">
                    <div class="config-title">Cron 表达式</div>
                    <input type="text" class="form-input" @bind="Input.CronExpression" placeholder="例如: 0 */2 * * *" />
                    <div class="cron-help">
                        <p>Cron 格式：分钟 小时 日 月 星期</p>
                        <p>示例：<code>0 */2 * * *</code> 表示每2小时执行</p>
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="form-checkbox-label">
                    <input type="checkbox" @bind="Input.IsEnabled" />
                    <span>立即启用</span>
                </label>
            </div>
        </div>
        <div class="dialog-footer">
            <button class="btn btn-cancel" @onclick="Close">取消</button>
            <button class="btn btn-primary" @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(Input.TaskName) || string.IsNullOrWhiteSpace(Input.PromptContent))">
                @(IsEdit ? "保存" : "创建")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public CreateScheduledTaskInputDto Input { get; set; } = new();
    [Parameter] public EventCallback<CreateScheduledTaskInputDto> InputChanged { get; set; }
    [Parameter] public List<AgentConfigDto> Agents { get; set; } = new();
    [Parameter] public List<LLMConfigDto> Models { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private string? SelectedModelId { get; set; }

    protected override Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Input.ModelConfigId?.ToString()))
        {
            SelectedModelId = Input.ModelConfigId.ToString();
        }
        return base.OnParametersSetAsync();
    }

    private async Task Save()
    {
        if (!string.IsNullOrEmpty(SelectedModelId) && Guid.TryParse(SelectedModelId, out var modelId))
        {
            Input.ModelConfigId = modelId;
        }

        await OnSave.InvokeAsync();
    }

    private async Task Close()
    {
        await VisibleChanged.InvokeAsync(false);
    }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);

    private static string GetIconSvg(string name) => name switch
    {
        "close" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>",
        _ => ""
    };
}
