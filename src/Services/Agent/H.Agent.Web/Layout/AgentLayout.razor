@namespace H.Agent.Web

@inherits LayoutComponentBase

<div class="agent-layout">
    @Body
</div>

<style>
    .agent-layout {
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .agent-chat-container {
        flex: 1;
        display: flex;
        overflow: hidden;
    }

    .chat-layout {
        display: flex;
        width: 100%;
        height: 100%;
    }

    /* 左侧会话列表 */
    .session-list-panel {
        width: 280px;
        border-right: 1px solid #e8e8e8;
        display: flex;
        flex-direction: column;
        background: #fafafa;
    }

    .panel-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .panel-content {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

    .session-item {
        padding: 12px;
        cursor: pointer;
        border-radius: 4px;
        margin-bottom: 4px;
        transition: background-color 0.2s;
    }

    .session-item:hover {
        background-color: #e6f7ff;
    }

    .session-item.active {
        background-color: #bae7ff;
    }

    .session-title {
        font-weight: 500;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .session-meta {
        font-size: 12px;
        color: #8c8c8c;
        display: flex;
        justify-content: space-between;
    }

    /* 中间聊天区域 */
    .chat-main-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .chat-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-header-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .message-item {
        display: flex;
        margin-bottom: 16px;
        gap: 12px;
    }

    .user-message {
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #1890ff;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-message .message-avatar {
        background-color: #52c41a;
    }

    .message-content {
        max-width: 60%;
    }

    .message-text {
        padding: 12px;
        border-radius: 8px;
        background-color: #f0f0f0;
        line-height: 1.5;
    }

    .user-message .message-text {
        background-color: #1890ff;
        color: white;
    }

    .message-time {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 4px;
    }

    .chat-input-area {
        border-top: 1px solid #e8e8e8;
        padding: 16px;
        background: #fafafa;
    }

    .input-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
    }

    .empty-chat-state {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 右侧 Agent 信息面板 */
    .agent-info-panel {
        width: 280px;
        border-left: 1px solid #e8e8e8;
        display: flex;
        flex-direction: column;
        background: #fafafa;
    }

    .agent-detail h4 {
        margin-bottom: 12px;
        color: #1890ff;
    }

    .agent-description {
        color: #595959;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .agent-capabilities h5 {
        margin-bottom: 8px;
        color: #262626;
    }

    .capabilities-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* 左下角用户菜单区域 */
    .user-menu-area {
        border-top: 1px solid #e8e8e8;
        padding: 8px 12px;
        background: #fafafa;
    }

    .user-menu-trigger {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border-radius: 6px;
        position: relative;
    }

    .user-avatar-small {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #1890ff;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
    }

    .user-menu-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .user-menu-icon:hover {
        background-color: #d9d9d9;
    }

    .user-name {
        flex: 1;
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .user-dropdown-menu {
        position: absolute;
        bottom: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        z-index: 1000;
        margin-bottom: 4px;
        overflow: hidden;
    }

    .dropdown-item {
        padding: 10px 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        transition: background-color 0.2s;
    }

    .dropdown-item:hover {
        background-color: #f5f5f5;
    }

    .dropdown-item.danger {
        color: #ff4d4f;
    }

    .dropdown-item.danger:hover {
        background-color: #fff1f0;
    }

    .dropdown-divider {
        height: 1px;
        background: #e8e8e8;
        margin: 4px 0;
    }

    /* 设置页面 */
    .settings-container {
        display: flex;
        height: 100%;
        width: 100%;
    }

    .settings-sidebar {
        width: 220px;
        border-right: 1px solid #e8e8e8;
        background: #fafafa;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .sidebar-menu {
        padding: 8px;
        flex: 1;
    }

    .menu-item {
        padding: 10px 16px;
        cursor: pointer;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        margin-bottom: 4px;
        transition: background-color 0.2s;
    }

    .menu-item:hover {
        background-color: #e6f7ff;
    }

    .menu-item.active {
        background-color: #bae7ff;
        font-weight: 500;
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .content-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .settings-form {
        max-width: 600px;
    }

    .form-section {
        margin-bottom: 32px;
    }

    .form-section h3 {
        font-size: 16px;
        margin-bottom: 16px;
        color: #262626;
    }

    .form-item {
        margin-bottom: 16px;
    }

    .form-item label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        color: #595959;
        font-weight: 500;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .theme-options {
        display: flex;
        gap: 8px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-item label {
        margin-bottom: 0;
    }

    .model-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .model-card {
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        overflow: hidden;
    }

    .model-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        border-bottom: 1px solid #e8e8e8;
    }

    .model-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .model-actions {
        display: flex;
        gap: 4px;
    }

    .model-card-body {
        padding: 12px 16px;
    }

    .model-info-row {
        font-size: 13px;
        color: #595959;
        margin-bottom: 4px;
    }

    .info-label {
        color: #8c8c8c;
        margin-right: 4px;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-dialog {
        background: white;
        border-radius: 8px;
        width: 520px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid #e8e8e8;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 16px;
    }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e8e8e8;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .agent-settings-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
</style>
