@page "/enterprise/select"
@using System.Net.Http.Json

@layout PortalLayout
@inject IEnterpriseAppService EnterpriseService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject HttpClient HttpClient

<div style="max-width: 600px; margin: 60px auto; text-align: center;">
    @if (loading)
    {
        <div style="padding: 40px;">加载中...</div>
    }
    else if (!isLoggedIn)
    {
        <div>
            <h3>请先登录</h3>
            <button class="h-btn h-btn-primary" @onclick="GoToLogin" style="margin-top: 16px;">去登录</button>
        </div>
    }
    else if (myEnterprises.Count == 0)
    {
        <div>
            <h2>🏭 欢迎</h2>
            <p style="color: #666; margin-top: 12px;">您还不属于任何企业，请创建一个企业后开始使用系统。</p>
            <div style="margin-top: 24px;">
                <button class="h-btn h-btn-primary" @onclick="GoToCreate" style="padding: 10px 32px; font-size: 16px;">
                    创建企业
                </button>
            </div>
            <p style="color: #999; margin-top: 16px; font-size: 12px;">
                创建企业后需要等待管理员激活
            </p>
        </div>
    }
    else if (activeEnterprises.Count == 0 && pendingEnterprises.Count > 0)
    {
        <div>
            <h2>🏭 等待激活</h2>
            <p style="color: #666; margin-top: 12px;">您创建的企业正在等待管理员激活：</p>
            <div style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px; align-items: center;">
                @foreach (var pe in pendingEnterprises)
                {
                    <div style="padding: 10px 20px; border: 1px solid #faad14; border-radius: 6px; background: #fffbe6; color: #ad6800;">
                        🕐 @pe.Name - 待激活
                    </div>
                }
            </div>
            <p style="color: #999; margin-top: 16px; font-size: 12px;">激活后即可使用系统，您也可以继续创建新企业</p>
            <div style="margin-top: 16px;">
                <button class="h-btn" @onclick="GoToCreate">创建新企业</button>
            </div>
        </div>
    }
    else if (activeEnterprises.Count == 1 && pendingEnterprises.Count == 0)
    {
        <div>
            <h3>正在进入 @activeEnterprises[0].Name ...</h3>
        </div>
    }
    else
    {
        <div>
            <h2>🏭 选择企业</h2>
            <p style="color: #666; margin-top: 8px; margin-bottom: 24px;">您关联了多个企业，请选择要进入的企业</p>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                @foreach (var enterprise in activeEnterprises)
                {
                    <div style="padding: 16px; border: 1px solid #e8e8e8; border-radius: 8px; cursor: pointer; text-align: left; display: flex; align-items: center; gap: 12px; transition: all 0.2s;"
                         @onclick="() => SelectAndEnter(enterprise.Id)"
                         onmouseover="this.style.borderColor='#1890ff';this.style.boxShadow='0 2px 8px rgba(24,144,255,0.15)'"
                         onmouseout="this.style.borderColor='#e8e8e8';this.style.boxShadow='none'">
                        <div style="width: 40px; height: 40px; background: #1890ff; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px;">
                            🏭
                        </div>
                        <div>
                            <div style="font-weight: 600; font-size: 15px;">@enterprise.Name</div>
                            <div style="color: #999; font-size: 12px; margin-top: 2px;">
                                @(enterprise.DatabaseMode == "Shared" ? "共用数据库" : "独立数据库")
                                · @enterprise.UserCount 名成员
                            </div>
                        </div>
                    </div>
                }
                @foreach (var pe in pendingEnterprises)
                {
                    <div style="padding: 16px; border: 1px solid #faad14; border-radius: 8px; text-align: left; display: flex; align-items: center; gap: 12px; background: #fffbe6; opacity: 0.7;">
                        <div style="width: 40px; height: 40px; background: #faad14; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px;">
                            🕐
                        </div>
                        <div>
                            <div style="font-weight: 600; font-size: 15px; color: #ad6800;">@pe.Name</div>
                            <div style="color: #ad6800; font-size: 12px; margin-top: 2px;">待激活</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="color: red; margin-top: 16px;">@errorMessage</div>
    }
</div>

@code {
    private List<EnterpriseDto> myEnterprises = new();
    private List<EnterpriseDto> activeEnterprises => myEnterprises.Where(e => e.Status == "Active" && e.IsActivated).ToList();
    private List<EnterpriseDto> pendingEnterprises => myEnterprises.Where(e => e.Status == "Pending" || !e.IsActivated).ToList();
    private bool loading = true;
    private bool isLoggedIn = false;
    private string? errorMessage;
    private Guid? currentUserId;

    private void GoToCreate() => Navigation.NavigateTo("/enterprise/create", forceLoad: true);

    protected override async Task OnInitializedAsync()
    {
        // 服务端预渲染时通过 HttpContext 检查认证状态
        var httpContextAccessor = ServiceProvider.GetService(typeof(Microsoft.AspNetCore.Http.IHttpContextAccessor)) as Microsoft.AspNetCore.Http.IHttpContextAccessor;
        var user = httpContextAccessor?.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            isLoggedIn = true;
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userIdClaim) && Guid.TryParse(userIdClaim, out var uid))
            {
                currentUserId = uid;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // WASM 环境通过 API 检查认证状态
        if (OperatingSystem.IsBrowser() && !isLoggedIn)
        {
            try
            {
                var response = await HttpClient.GetAsync("/api/app/account/current-user");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrEmpty(content) && content != "null")
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(content);
                        if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Null &&
                            doc.RootElement.TryGetProperty("id", out var idProp))
                        {
                            isLoggedIn = true;
                            currentUserId = Guid.Parse(idProp.GetString()!);
                        }
                    }
                }
            }
            catch { }
        }

        if (isLoggedIn && currentUserId.HasValue)
        {
            await LoadEnterprises();
        }
        else
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadEnterprises()
    {
        try
        {
            myEnterprises = await EnterpriseService.GetMyEnterprisesAsync(currentUserId!.Value);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        loading = false;
        StateHasChanged();

        // 只有一个已激活企业时自动选择
        if (activeEnterprises.Count == 1 && pendingEnterprises.Count == 0)
        {
            await SelectAndEnter(activeEnterprises[0].Id);
        }
    }

    private async Task SelectAndEnter(Guid enterpriseId)
    {
        errorMessage = null;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("/api/app/enterprise/select-enterprise",
                new { enterpriseId = enterpriseId.ToString() });

            if (response.IsSuccessStatusCode)
            {
                // 强制刷新页面以更新 Cookie 中的 TenantId
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(content);
                    errorMessage = doc.RootElement.TryGetProperty("message", out var msgProp)
                        ? msgProp.GetString() ?? "操作失败"
                        : "操作失败";
                }
                catch
                {
                    errorMessage = content;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/account/login?returnUrl=/enterprise/select", forceLoad: true);
    }
}
