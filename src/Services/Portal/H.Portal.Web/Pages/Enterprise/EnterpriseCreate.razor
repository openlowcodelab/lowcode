@page "/enterprise/create"
@using System.Net.Http.Json

@layout PortalLayout
@inject HttpClient HttpClient
@inject NavigationManager Navigation

<HCard Title="创建企业">
    <div style="max-width: 600px;">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="color: red; margin-bottom: 16px; padding: 8px; background: #fff2f0; border: 1px solid #ffccc7; border-radius: 4px;">
                @errorMessage
            </div>
        }

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">企业名称 <span style="color:red">*</span></label>
            <div class="h-form-control">
                <input type="text" @bind-value="@model.Name" placeholder="请输入企业名称" class="h-input" />
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">企业编码</label>
            <div class="h-form-control">
                <input type="text" @bind-value="@model.Code" placeholder="请输入企业编码（可选）" class="h-input" />
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">企业描述</label>
            <div class="h-form-control">
                <textarea @bind="@model.Description" placeholder="请输入企业描述" class="h-input" rows="3"></textarea>
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">联系人</label>
            <div class="h-form-control">
                <input type="text" @bind-value="@model.ContactName" placeholder="请输入联系人姓名" class="h-input" />
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">联系电话</label>
            <div class="h-form-control">
                <input type="text" @bind-value="@model.ContactPhone" placeholder="请输入联系电话" class="h-input" />
            </div>
        </div>
        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">联系邮箱</label>
            <div class="h-form-control">
                <input type="email" @bind-value="@model.ContactEmail" placeholder="请输入联系邮箱" class="h-input" />
            </div>
        </div>

        <div style="margin-top: 24px; display: flex; gap: 10px;">
            <button class="h-btn h-btn-primary" @onclick="Submit" disabled="@submitting">
                @(submitting ? "创建中..." : "创建企业")
            </button>
            <button class="h-btn" @onclick="GoBack">取消</button>
        </div>
    </div>
</HCard>

@code {
    private CreateEnterpriseModel model = new();
    private bool submitting = false;
    private string? errorMessage;

    private void GoBack() => Navigation.NavigateTo("/enterprise/select", forceLoad: true);

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "企业名称不能为空";
            return;
        }

        submitting = true;
        errorMessage = null;
        try
        {
            // 通过门户网关接口创建企业（前端不依赖 Enterprise Contracts）
            var response = await HttpClient.PostAsJsonAsync("/api/app/portal-enterprise", model);
            if (response.IsSuccessStatusCode)
            {
                // 新建企业为待激活状态，返回企业选择页查看激活状态
                Navigation.NavigateTo("/enterprise/select", forceLoad: true);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(content);
                    errorMessage = doc.RootElement.TryGetProperty("error", out var error)
                        && error.TryGetProperty("message", out var msgProp)
                        ? msgProp.GetString() ?? "创建失败"
                        : "创建失败";
                }
                catch
                {
                    errorMessage = "创建失败";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }
}
