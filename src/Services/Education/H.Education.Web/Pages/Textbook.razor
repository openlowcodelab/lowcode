@page "/education/textbook"

@layout EducationLayout
@inject ITextbookAppService TextbookService
@inject IJSRuntime JS
@inject HToastService Toast

<div class="h-split-page edu-textbook-split">
    <HCard Title="年级" Style="width:260px;flex-shrink:0;">
        <Extra>
            <div class="h-space">
                <button class="h-btn h-btn-sm" disabled="@importing" @onclick="ImportBuiltIn">
                    @if (importing)
                    {
                        <span class="h-btn-loading"></span>
                    }
                    导入目录
                </button>
                <button class="h-btn h-btn-sm h-btn-primary" @onclick="ShowCreateDialog">新增教材</button>
            </div>
        </Extra>

        <ChildContent>
            <div class="h-input-group" style="margin-bottom:12px;">
                <input type="text" @bind="filter" class="h-input" placeholder="教材名称、版本或出版社" />
                <button class="h-btn" style="flex-shrink:0;" @onclick="LoadData">查询</button>
            </div>

            @if (loading)
            {
                <div class="h-spin"><span class="h-spin-dot"></span><span class="h-spin-text">加载中...</span></div>
            }
            else if (!grades.Any())
            {
                <div class="h-empty">
                    @if (!string.IsNullOrWhiteSpace(filter))
                    {
                        <text>没有符合条件的教材，换个关键词试试。</text>
                    }
                    else
                    {
                        <text>教材目录还是空的。点上面的「导入目录」，会把内置的 18 册中小学教材与它们的五类课时资源一次登记进来。</text>
                    }
                </div>
            }
            else
            {
                <div class="edu-book-list">
                    @foreach (var group in grades)
                    {
                        <div class="edu-book-item @(group.Grade == selectedGrade ? "active" : "")"
                             @onclick="@(() => SelectGrade(group.Grade))">
                            <div class="edu-book-item-name">@group.Grade</div>
                            <div class="edu-score-label" style="margin-top:6px;">
                                @group.Stage · @group.SubjectCount 个学科 · @group.Books.Count 册
                            </div>
                            <div class="edu-score-label">
                                课时资源 @group.ResourceCount 条 · 已挂直链 @group.LinkedCount 条
                            </div>
                        </div>
                    }
                </div>

                <div class="h-pagination">
                    <span class="h-pagination-info">共 @grades.Count 个年级、@totalCount 册教材</span>
                </div>
            }
        </ChildContent>
    </HCard>

    <HCard Title="@(selectedGrade is null ? "教材详情" : $"{selectedGrade} · {SubjectTitle}")" Style="flex:1;">
        <Extra>
            @if (selected is not null)
            {
                var cur = selected;
                <div class="h-space">
                    @if (!string.IsNullOrWhiteSpace(cur.CourseUrl))
                    {
                        <a class="h-btn h-btn-sm" href="@cur.CourseUrl" target="_blank" rel="noopener noreferrer">课程教学频道</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(cur.BookUrl))
                    {
                        <a class="h-btn h-btn-sm" href="@cur.BookUrl" target="_blank" rel="noopener noreferrer">电子课本</a>
                    }
                    <button class="h-btn h-btn-sm" @onclick="@(() => ShowEditDialog(cur))">编辑教材</button>
                    <button class="h-btn h-btn-sm h-btn-danger" @onclick="@(() => ConfirmDeleteTextbook(cur))">删除教材</button>
                </div>
            }
        </Extra>

        <ChildContent>
            @if (selectedGrade is null)
            {
                <div class="h-empty">左边选一个年级，这里按学科分标签页展示它的教材。</div>
            }
            else
            {
                <div class="edu-book-tabs">
                    @foreach (var subject in subjects)
                    {
                        <div class="edu-book-tab @(subject == selectedSubject ? "active" : "")"
                             @onclick="@(() => SelectSubject(subject))">
                            @subject.GetSubjectName()
                            <span class="edu-book-tab-count">@CountOfSubject(subject) 册</span>
                        </div>
                    }
                </div>

                @if (subjectBooks.Count > 1)
                {
                    <div class="h-space gap-2" style="margin-bottom:16px;flex-wrap:wrap;">
                        @foreach (var book in subjectBooks)
                        {
                            <button class="h-btn h-btn-sm @(book.Id == selectedId ? "h-btn-primary" : "")"
                                    @onclick="@(() => SelectBook(book.Id))">
                                @book.Version @book.Volume.GetVolumeName()
                            </button>
                        }
                    </div>
                }

                @if (selected is null)
                {
                    <div class="h-empty">这个学科还没有登记教材，点左上「新增教材」补一本。</div>
                }
                else
                {
                    <table class="h-descriptions">
                        <tr>
                            <th>教材</th>
                            <td colspan="3">@selected.Name</td>
                        </tr>
                        <tr>
                            <th>学段</th>
                            <td>@selected.Stage.GetStageName()</td>
                            <th>册次</th>
                            <td>@selected.Volume.GetVolumeName()</td>
                        </tr>
                        <tr>
                            <th>版本</th>
                            <td>@selected.Version</td>
                            <th>出版社</th>
                            <td>@(string.IsNullOrWhiteSpace(selected.Publisher) ? "-" : selected.Publisher)</td>
                        </tr>
                        <tr>
                            <th>单元</th>
                            <td>@selected.UnitCount 个（样式 @(string.IsNullOrWhiteSpace(selected.UnitLabel) ? "第{0}单元" : selected.UnitLabel)）</td>
                            <th>来源</th>
                            <td>@(selected.Source == TextbookSourceEnum.BuiltIn ? "内置公开目录" : "手工录入")</td>
                        </tr>
                        <tr>
                            <th>资源条数</th>
                            <td colspan="3">@selected.ResourceCount 条，已挂直链 @selected.LinkedResourceCount 条</td>
                        </tr>
                    </table>

                    @if (!string.IsNullOrWhiteSpace(selected.Remark))
                    {
                        <div class="edu-score-label" style="margin:-8px 0 16px;">@selected.Remark</div>
                    }

                    <TextbookDetailPanel @key="@($"{selectedId}-{detailToken}")" TextbookId="@selectedId" OnChanged="OnResourceChanged" />
                }
            }
        </ChildContent>
    </HCard>
</div>

<HModal Title="@(editingId is null ? "新增教材" : "编辑教材")" Visible="@modalVisible"
        VisibleChanged="OnModalVisibleChanged" OnOk="Save" ConfirmLoading="@saving"
        OkText="@(editingId is null ? "新增" : "保存")" Style="width:640px;">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">版本</label>
        <div class="h-form-control">
            <input type="text" class="h-input" @bind="form.Version" placeholder="如：统编版 / 人教版 / 外研版" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">学段</label>
        <div class="h-form-control">
            <select class="h-input" @bind="form.Stage">
                <option value="@SchoolStageEnum.Primary">小学</option>
                <option value="@SchoolStageEnum.JuniorHigh">初中</option>
                <option value="@SchoolStageEnum.SeniorHigh">高中</option>
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">学科</label>
        <div class="h-form-control">
            <select class="h-input" @bind="form.Subject">
                @foreach (var subject in Enum.GetValues<TextbookSubjectEnum>())
                {
                    <option value="@subject">@subject.GetSubjectName()</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">年级</label>
        <div class="h-form-control">
            <select class="h-input" @bind="form.Grade">
                @foreach (var grade in GradeOptions.All)
                {
                    <option value="@grade">@grade</option>
                }
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">册次</label>
        <div class="h-form-control">
            <select class="h-input" @bind="form.Volume">
                <option value="@TextbookVolumeEnum.First">上册</option>
                <option value="@TextbookVolumeEnum.Second">下册</option>
                <option value="@TextbookVolumeEnum.Whole">全一册</option>
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">教材名称</label>
        <div class="h-form-control">
            <input type="text" class="h-input" @bind="form.Name" placeholder="留空则按「年级+学科+册次+版本」自动生成" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">出版社</label>
        <div class="h-form-control">
            <input type="text" class="h-input" @bind="form.Publisher" placeholder="如：人民教育出版社" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">单元数量</label>
        <div class="h-form-control">
            <input type="number" class="h-input" min="0" max="30" @bind="form.UnitCount" />
            <div class="edu-score-label">保存后会按单元补齐五类课时资源，已补录的条目不会被改动</div>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">单元名称样式</label>
        <div class="h-form-control">
            <select class="h-input" @bind="form.UnitLabel">
                <option value="第{0}单元">第{0}单元（语文、道法）</option>
                <option value="第{0}章">第{0}章（数学、物理、化学）</option>
                <option value="Unit {0}">Unit {0}（英语）</option>
                <option value="模块{0}">模块{0}</option>
            </select>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">电子课本</label>
        <div class="h-form-control">
            <input type="text" class="h-input" @bind="form.BookUrl" placeholder="https:// 开头的课本页地址，可留空" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">课程教学</label>
        <div class="h-form-control">
            <input type="text" class="h-input" @bind="form.CourseUrl" placeholder="https:// 开头的课程频道地址，可留空" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">备注</label>
        <div class="h-form-control">
            <textarea class="h-textarea" rows="2" @bind="form.Remark" placeholder="如单元编排说明、适用地区"></textarea>
        </div>
    </div>
</HModal>

@code {
    private List<TextbookDto> textbooks = [];
    private int detailToken;
    private int totalCount;
    private bool loading;
    private bool importing;

    private string filter = string.Empty;
    private string? selectedGrade;
    private TextbookSubjectEnum? selectedSubject;
    private Guid selectedId;

    private bool modalVisible;
    private bool saving;
    private Guid? editingId;

    // UpdateTextbookDto 继承自 CreateTextbookDto，新增与编辑复用同一份表单
    private UpdateTextbookDto form = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    /// <summary>左栏的一项：一个年级及其全部教材册</summary>
    private sealed record GradeGroup(string Grade, string Stage, int SubjectCount, List<TextbookDto> Books)
    {
        public int ResourceCount => Books.Sum(x => x.ResourceCount);

        public int LinkedCount => Books.Sum(x => x.LinkedResourceCount);
    }

    private TextbookDto? selected => textbooks.FirstOrDefault(x => x.Id == selectedId);

    /// <summary>服务端已按年级序号排好，这里按首次出现顺序分组即可保持 一→九→高一</summary>
    private List<GradeGroup> grades => textbooks
        .GroupBy(x => x.Grade)
        .Select(g => new GradeGroup(
            g.Key,
            g.First().Stage.GetStageName(),
            g.Select(x => x.Subject).Distinct().Count(),
            g.ToList()))
        .ToList();

    private List<TextbookDto> gradeBooks => grades.FirstOrDefault(x => x.Grade == selectedGrade)?.Books ?? [];

    private List<TextbookSubjectEnum> subjects => gradeBooks.Select(x => x.Subject).Distinct().ToList();

    private List<TextbookDto> subjectBooks => selectedSubject is null
        ? []
        : gradeBooks.Where(x => x.Subject == selectedSubject).ToList();

    private string SubjectTitle => selectedSubject is null
        ? string.Empty
        : selectedSubject.Value.GetSubjectName();

    private int CountOfSubject(TextbookSubjectEnum subject) => gradeBooks.Count(x => x.Subject == subject);

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var result = await TextbookService.GetListAsync(new TextbookQueryDto
            {
                MaxResultCount = 200,
                Filter = string.IsNullOrWhiteSpace(filter) ? null : filter.Trim()
            });
            textbooks = result.Data?.Items.ToList() ?? [];
            totalCount = (int)(result.Data?.TotalCount ?? 0);
            SyncSelection();
        }
        catch (Exception ex)
        {
            Toast.Error($"加载教材目录失败：{ex.Message}", 6000);
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>筛选或增删后原选中项可能已不在列表里，逐级回落到第一项</summary>
    private void SyncSelection()
    {
        var groups = grades;
        if (selectedGrade is null || groups.All(x => x.Grade != selectedGrade))
        {
            selectedGrade = groups.FirstOrDefault()?.Grade;
            selectedSubject = null;
            selectedId = Guid.Empty;
        }

        var books = groups.FirstOrDefault(x => x.Grade == selectedGrade)?.Books ?? [];
        var subjectList = books.Select(x => x.Subject).Distinct().ToList();
        if (selectedSubject is null || subjectList.All(x => x != selectedSubject))
        {
            selectedSubject = subjectList.FirstOrDefault();
            selectedId = Guid.Empty;
        }

        if (selected is not null) return;

        selectedId = books
            .Where(x => selectedSubject is null || x.Subject == selectedSubject)
            .FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void SelectGrade(string grade)
    {
        selectedGrade = grade;
        selectedSubject = null;
        selectedId = Guid.Empty;
        SyncSelection();
    }

    private void SelectSubject(TextbookSubjectEnum subject)
    {
        selectedSubject = subject;
        selectedId = subjectBooks.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void SelectBook(Guid id) => selectedId = id;

    private async Task ImportBuiltIn()
    {
        importing = true;
        try
        {
            var data = (await TextbookService.ImportBuiltInAsync()).Data;
            if (data is null)
            {
                Toast.Warning("导入未返回结果");
            }
            else if (data.InsertedTextbookCount == 0)
            {
                Toast.Info(data.Message);
            }
            else
            {
                Toast.Success($"{data.Message}（资源只登记到单元级，直链需在右侧详情里逐条补录）", 6000);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.Error($"导入失败：{ex.Message}", 6000);
        }
        finally
        {
            importing = false;
        }
    }

    private void ShowCreateDialog()
    {
        editingId = null;
        form = new UpdateTextbookDto
        {
            Stage = SchoolStageEnum.Primary,
            Subject = TextbookSubjectEnum.Chinese,
            Version = "统编版",
            Grade = selectedGrade ?? "一年级",
            Volume = TextbookVolumeEnum.First,
            Publisher = "人民教育出版社",
            UnitCount = 8,
            UnitLabel = "第{0}单元",
            CourseUrl = TextbookChannels.CourseUrl,
            BookUrl = TextbookChannels.MaterialUrl
        };

        var current = selected;
        if (current is not null)
        {
            form.Stage = current.Stage;
            form.Subject = current.Subject;
            form.Grade = current.Grade;
            form.Version = current.Version;
            form.Publisher = current.Publisher;
        }

        modalVisible = true;
    }

    private void ShowEditDialog(TextbookDto book)
    {
        editingId = book.Id;
        form = new UpdateTextbookDto
        {
            Name = book.Name,
            Stage = book.Stage,
            Subject = book.Subject,
            Version = book.Version,
            Grade = book.Grade,
            Volume = book.Volume,
            Publisher = book.Publisher,
            UnitCount = book.UnitCount,
            UnitLabel = book.UnitLabel,
            BookUrl = book.BookUrl,
            CourseUrl = book.CourseUrl,
            Remark = book.Remark
        };
        modalVisible = true;
    }

    private void OnModalVisibleChanged(bool visible) => modalVisible = visible;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Version))
        {
            Toast.Warning("请填写教材版本，如「统编版」");
            return;
        }
        if (string.IsNullOrWhiteSpace(form.Grade))
        {
            Toast.Warning("请选择年级");
            return;
        }

        saving = true;
        try
        {
            if (editingId is null)
            {
                var created = (await TextbookService.CreateAsync(form)).Data;
                if (created is not null)
                {
                    selectedGrade = created.Grade;
                    selectedSubject = created.Subject;
                    selectedId = created.Id;
                }
                Toast.Success("教材已加入目录");
            }
            else
            {
                await TextbookService.UpdateAsync(editingId.Value, form);
                Toast.Success("教材信息已更新");
            }

            modalVisible = false;
            detailToken++;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败：{ex.Message}", 6000);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ConfirmDeleteTextbook(TextbookDto book)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"删除《{book.Name}》？其 {book.ResourceCount} 条课时资源（含已补录的 {book.LinkedResourceCount} 条直链）会一起删除，同年级其它学科的教材不受影响。");
        if (!confirmed) return;

        try
        {
            await TextbookService.DeleteAsync(book.Id);
            Toast.Success("教材已删除");

            selectedId = Guid.Empty;
            detailToken++;
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.Error($"删除失败：{ex.Message}");
        }
    }

    /// <summary>资源增删后重新取一次，左栏年级的直链进度才是最新的</summary>
    private async Task OnResourceChanged() => await LoadData();
}
