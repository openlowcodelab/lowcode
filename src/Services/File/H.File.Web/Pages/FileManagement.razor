@code {
    private List<FileProjectDto> projects = new();
    private string selectedProjectIdStr = string.Empty;
    private Guid selectedProjectId => Guid.TryParse(selectedProjectIdStr, out var id) ? id : Guid.Empty;
    private List<FileFolderDto> folderTree = new();
    private List<FileObjectDto> files = new();
    private string? currentFolder;
    private bool loadingFiles;
    private bool uploading;
    private bool showFolderModal;
    private string newFolderName = string.Empty;
    private string newFolderCode = string.Empty;
    private string? newFolderParent;
    private bool showRenameModal;
    private FileFolderDto? renameTarget;
    private string renameFolderName = string.Empty;
    private bool showPreview;
    private FilePreviewDto? previewData;
    private bool officeRenderPending;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetListAsync();
        // 优先使用 URL 参数指定的项目，否则默认选择第一个项目
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var projectParam = query["project"];
        var pid = Guid.Empty;
        if (Guid.TryParse(projectParam, out var parsed) && projects.Any(p => p.Id == parsed))
            pid = parsed;
        else if (projects.Count > 0)
            pid = projects[0].Id;
        if (pid != Guid.Empty)
        {
            selectedProjectIdStr = pid.ToString();
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private async Task OnProjectChangedAsync()
    {
        currentFolder = null;
        if (selectedProjectId != Guid.Empty)
        {
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private async Task LoadFolderTree()
    {
        try { folderTree = await FileService.GetFolderTreeAsync(selectedProjectId); }
        catch { folderTree = new(); }
    }

    private async Task LoadFiles()
    {
        if (selectedProjectId == Guid.Empty) return;
        loadingFiles = true;
        try { files = await FileService.GetFilesAsync(selectedProjectId, currentFolder); }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"加载文件失败：{ex.Message}"); }
        finally { loadingFiles = false; }
    }

    private async Task SelectFolder(string? path)
    {
        currentFolder = path;
        await LoadFiles();
    }

    private void ShowNewFolderDialog(string? parentPath)
    {
        newFolderName = string.Empty;
        newFolderCode = string.Empty;
        newFolderParent = parentPath;
        showFolderModal = true;
    }

    private void OnAddChildFolder(FileFolderDto folder)
    {
        ShowNewFolderDialog(folder.Path);
    }

    private void ShowRenameDialog(FileFolderDto folder)
    {
        renameTarget = folder;
        renameFolderName = folder.Name;
        showRenameModal = true;
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderName))
        {
            await JS.InvokeVoidAsync("alert", "分类名称不能为空");
            return;
        }
        if (newFolderName.Contains('/'))
        {
            await JS.InvokeVoidAsync("alert", "分类名称不能包含 / 字符");
            return;
        }
        var code = newFolderCode.Trim();
        if (!string.IsNullOrEmpty(code) && !Regex.IsMatch(code, "^[a-z]{3,20}$"))
        {
            await JS.InvokeVoidAsync("alert", "分类编号需为 3-20 位小写字母（a-z）");
            return;
        }
        if (string.IsNullOrEmpty(code))
            code = GenerateRandomCode(8);
        try
        {
            var input = new CreateFolderInput
            {
                ParentPath = string.IsNullOrEmpty(newFolderParent) ? null : newFolderParent,
                Name = newFolderName.Trim(),
                Code = code
            };
            await FileService.CreateFolderAsync(selectedProjectId, input);
            showFolderModal = false;
            await LoadFolderTree();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"创建失败：{ex.Message}"); }
    }

    private static string GenerateRandomCode(int length)
    {
        const string chars = "abcdefghijklmnopqrstuvwxyz";
        var random = new Random();
        return new string(Enumerable.Range(0, length).Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }

    private async Task RenameFolder()
    {
        if (renameTarget == null) return;
        if (string.IsNullOrWhiteSpace(renameFolderName))
        {
            await JS.InvokeVoidAsync("alert", "分类名称不能为空");
            return;
        }
        if (renameFolderName.Contains('/'))
        {
            await JS.InvokeVoidAsync("alert", "分类名称不能包含 / 字符");
            return;
        }
        if (renameTarget.Name.Equals(renameFolderName.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            showRenameModal = false;
            return;
        }
        try
        {
            await FileService.RenameFolderAsync(selectedProjectId, renameTarget.Path, renameFolderName.Trim());
            showRenameModal = false;
            await LoadFolderTree();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"重命名失败：{ex.Message}"); }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var result = await FileService.UploadAsync(selectedProjectId, currentFolder ?? "", file.Name, ms.ToArray(), file.ContentType);
                if (!result.Success)
                    await JS.InvokeVoidAsync("alert", $"上传 {file.Name} 失败：{result.Message}");
            }
            await LoadFiles();
            await LoadFolderTree();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"上传失败：{ex.Message}"); }
        finally { uploading = false; }
    }

    private async Task DownloadFile(FileObjectDto f)
    {
        try
        {
            var url = await FileService.GetDownloadUrlAsync(selectedProjectId, f.Key);
            await JS.InvokeVoidAsync("eval", $"(function(){{var a=document.createElement('a');a.href='{url}';a.download='{f.FileName}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})()");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"获取下载链接失败：{ex.Message}"); }
    }

    private async Task PreviewFile(FileObjectDto f)
    {
        try
        {
            previewData = await FileService.GetPreviewAsync(selectedProjectId, f.Key);
            officeRenderPending = previewData?.PreviewType == "office" && previewData.Base64Content != null;
            showPreview = true;
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"预览失败：{ex.Message}"); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (officeRenderPending)
        {
            officeRenderPending = false;
            await RenderOfficePreviewAsync();
        }
    }

    private async Task RenderOfficePreviewAsync()
    {
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/H.File.Web/js/officePreview.js");
            await module.InvokeVoidAsync("previewOffice", previewData!.Base64Content, previewData.FileName, "office-preview-container");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Office 预览失败：{ex.Message}");
        }
    }

    private async Task ConfirmDeleteFile(FileObjectDto f)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"确定删除「{f.FileName}」？");
        if (ok)
        {
            await FileService.DeleteAsync(selectedProjectId, f.Key);
            await LoadFiles();
        }
    }

    private async Task ConfirmDeleteFolder(FileFolderDto folder)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"确定删除文件夹「{folder.Name}」及其所有文件？");
        if (ok)
        {
            await FileService.DeleteFolderAsync(selectedProjectId, folder.Path);
            if (currentFolder?.StartsWith(folder.Path) == true)
                currentFolder = null;
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):F2} GB"
    };

    private static string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".svg" or ".webp" or ".bmp" => "🖼️",
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".xls" or ".xlsx" => "📗",
            ".ppt" or ".pptx" => "📙",
            ".txt" or ".log" or ".md" => "📝",
            ".html" or ".htm" or ".css" or ".js" => "🌐",
            ".zip" or ".rar" or ".7z" => "📦",
            ".mp4" or ".avi" or ".mov" => "🎬",
            ".mp3" or ".wav" => "🎵",
            _ => "📄"
        };
    }
}
