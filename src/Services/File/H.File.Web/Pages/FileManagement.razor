@page "/file/objects"
@using Markdig
@using System.Text.RegularExpressions

@layout FileLayout
@inject IFileProjectAppService ProjectService
@inject IFileObjectAppService FileService
@inject NavigationManager Nav
@inject IJSRuntime JS

<HCard>
    <ChildContent>

    @if (selectedProjectId == Guid.Empty)
    {
        <div style="text-align:center;padding:60px;color:#86909C;">
            <div style="font-size:48px;margin-bottom:12px;">📄</div>
            <div>暂无项目，请先在项目管理中创建</div>
        </div>
    }
    else
    {
        <div class="file-manager">
            <!-- 左侧：项目下拉 + 文件夹树 -->
            <div class="file-tree-panel">
                <div class="project-select-bar">
                    <select class="h-input project-select" @bind="selectedProjectIdStr" @bind:after="OnProjectChangedAsync">
                        @foreach (var p in projects)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="file-tree-header">
                    <span>📁 分类</span>
                    <button class="h-btn h-btn-sm" @onclick="@(() => ShowNewFolderDialog(null))" title="新增一级目录">+</button>
                </div>
                <div class="file-tree-body">
                    <div class="file-tree-node @(currentFolder == null ? "active" : "")" @onclick="@(() => SelectFolder(null))">
                        <span class="node-label">📂 全部文件</span>
                    </div>
                    @foreach (var folder in folderTree)
                    {
                        <FileTreeNode Node="@folder" SelectedFolder="@currentFolder" OnSelect="@SelectFolder" OnAddChild="@OnAddChildFolder" OnRename="@ShowRenameDialog" OnDelete="@ConfirmDeleteFolder" />
                    }
                </div>
            </div>

            <!-- 右侧：文件列表 -->
            <div class="file-list-panel">
                <div class="file-list-toolbar">
                    <span class="file-list-path">@(currentFolder ?? "根目录")</span>
                    <div>
                        <label class="h-btn h-btn-primary h-btn-sm" style="cursor:pointer">
                            📤 上传文件
                            <InputFile OnChange="@OnFileSelected" multiple style="display:none" />
                        </label>
                        <button class="h-btn h-btn-sm" @onclick="@LoadFiles">刷新</button>
                    </div>
                </div>

                @if (uploading)
                {
                    <div style="padding:8px 12px;color:#165DFF;font-size:13px;">⏳ 正在上传...</div>
                }

                <HTable Loading="@loadingFiles" ShowEmpty="@(!loadingFiles && !files.Any())">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>名称</th>
                            <th style="width:100px">大小</th>
                            <th style="width:160px">修改时间</th>
                            <th style="width:160px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in files)
                        {
                            <tr>
                                <td>@GetFileIcon(f.FileName)</td>
                                <td>@f.FileName</td>
                                <td>@FormatSize(f.Size)</td>
                                <td>@f.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="row-actions">
                                        <a @onclick="@(() => PreviewFile(f))">预览</a>
                                        <a @onclick="@(() => DownloadFile(f))">下载</a>
                                        <a class="danger" @onclick="@(() => ConfirmDeleteFile(f))">删除</a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </HTable>
            </div>
        </div>
    }
    </ChildContent>
</HCard>

<!-- 新建分类弹窗 -->
<HModal Title="新建分类" Visible="@showFolderModal" OnOk="@CreateFolder" OnCancel="@(() => showFolderModal = false)">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">分类名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@newFolderName" placeholder="请输入分类名称" class="h-input" />
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">分类编号</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@newFolderCode" placeholder="3-20 位小写字母，留空自动生成" class="h-input" />
            <div class="h-form-tip">编号作为 MinIO 目录名，留空则自动生成 8 位小写字母</div>
        </div>
    </div>
</HModal>

<!-- 重命名分类弹窗 -->
<HModal Title="重命名分类" Visible="@showRenameModal" OnOk="@RenameFolder" OnCancel="@(() => showRenameModal = false)">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">分类编号</label>
        <div class="h-form-control">
            <input type="text" value="@renameTarget?.Code" disabled class="h-input" />
            <div class="h-form-tip">编号作为 MinIO 目录名，创建后不可修改</div>
        </div>
    </div>
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">分类名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@renameFolderName" placeholder="请输入新的分类名称" class="h-input" />
        </div>
    </div>
</HModal>

<!-- 文件预览遮罩层 -->
@if (showPreview && previewData != null)
{
    <div class="fp-overlay" @onclick="() => showPreview = false">
        <div class="fp-topbar">
            <span class="fp-filename">@previewData.FileName</span>
            <button class="fp-close" @onclick="() => showPreview = false" title="关闭">✕</button>
        </div>
        <div class="fp-content">
            <div class="fp-content-inner">
            @switch (previewData.PreviewType)
            {
                case "image":
                    <img src="@previewData.PreviewUrl" class="fp-image" alt="@previewData.FileName" @onclick:stopPropagation="true" />
                    break;
                case "text":
                    <pre class="fp-text" @onclick:stopPropagation="true">@previewData.TextContent</pre>
                    break;
                case "markdown":
                    <div class="fp-markdown" @onclick:stopPropagation="true">@((MarkupString)Markdown.ToHtml(previewData.TextContent ?? string.Empty))</div>
                    break;
                case "html":
                    <iframe srcdoc="@previewData.TextContent" class="fp-iframe" @onclick:stopPropagation="true"></iframe>
                    break;
                case "pdf":
                    <iframe src="@previewData.PreviewUrl" class="fp-iframe" @onclick:stopPropagation="true"></iframe>
                    break;
                case "office":
                    if (previewData.Base64Content == null)
                    {
                        <div class="fp-empty" @onclick:stopPropagation="true">
                            <div style="font-size:48px;margin-bottom:16px;">📊</div>
                            <div>文件过大，暂不支持在线预览</div>
                            <a href="@previewData.PreviewUrl" class="fp-download-btn">下载查看</a>
                        </div>
                    }
                    else
                    {
                        <div id="office-preview-container" class="fp-office" @onclick:stopPropagation="true">
                            <div style="text-align:center;padding:40px;color:#86909C;">⏳ 正在解析预览，请稍候...</div>
                        </div>
                    }
                    break;
                default:
                    <div class="fp-empty" @onclick:stopPropagation="true">
                        <div style="font-size:48px;margin-bottom:12px;">📎</div>
                        <div>该文件类型暂不支持预览</div>
                    </div>
                    break;
            }
            </div>
        </div>
    </div>
}

