@page "/file/objects"

@layout FileLayout
@inject IFileProjectAppService ProjectService
@inject IFileObjectAppService FileService
@inject NavigationManager Nav
@inject IJSRuntime JS

<HCard Title="文件管理">
    <Extra>
        <select class="h-input" style="width:200px" @onchange="@OnProjectChanged" value="@selectedProjectId">
            <option value="">-- 选择项目 --</option>
            @foreach (var p in projects)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </Extra>
    <ChildContent>

    @if (selectedProjectId == Guid.Empty)
    {
        <div style="text-align:center;padding:60px;color:#86909C;">
            <div style="font-size:48px;margin-bottom:12px;">📄</div>
            <div>请先选择一个项目</div>
        </div>
    }
    else
    {
        <div class="file-manager">
            <!-- 左侧：文件夹树 -->
            <div class="file-tree-panel">
                <div class="file-tree-header">
                    <span>📁 文件夹</span>
                    <button class="h-btn h-btn-sm" @onclick="@ShowNewFolderDialog" title="新建文件夹">+</button>
                </div>
                <div class="file-tree-body">
                    <div class="file-tree-node @(currentFolder == null ? "active" : "")" @onclick="@(() => SelectFolder(null))">
                        📂 全部文件
                    </div>
                    @foreach (var folder in folderTree)
                    {
                        <FileTreeNode Node="@folder" SelectedFolder="@currentFolder" OnSelect="@SelectFolder" OnDelete="@ConfirmDeleteFolder" />
                    }
                </div>
            </div>

            <!-- 右侧：文件列表 -->
            <div class="file-list-panel">
                <div class="file-list-toolbar">
                    <span class="file-list-path">@(currentFolder ?? "根目录")</span>
                    <div>
                        <label class="h-btn h-btn-primary h-btn-sm" style="cursor:pointer">
                            📤 上传文件
                            <InputFile OnChange="@OnFileSelected" multiple style="display:none" />
                        </label>
                        <button class="h-btn h-btn-sm" @onclick="@LoadFiles">刷新</button>
                    </div>
                </div>

                @if (uploading)
                {
                    <div style="padding:8px 12px;color:#165DFF;font-size:13px;">⏳ 正在上传...</div>
                }

                <HTable Loading="@loadingFiles" ShowEmpty="@(!loadingFiles && !files.Any())">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>名称</th>
                            <th style="width:100px">大小</th>
                            <th style="width:160px">修改时间</th>
                            <th style="width:160px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in files)
                        {
                            <tr>
                                <td>@(f.IsFolder ? "📁" : GetFileIcon(f.FileName))</td>
                                <td>
                                    @if (f.IsFolder)
                                    {
                                        <a class="file-name-link" @onclick="@(() => SelectFolder(f.Key))">@f.FileName</a>
                                    }
                                    else
                                    {
                                        @f.FileName
                                    }
                                </td>
                                <td>@(f.IsFolder ? "-" : FormatSize(f.Size))</td>
                                <td>@f.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="row-actions">
                                        @if (!f.IsFolder)
                                        {
                                            <a @onclick="@(() => PreviewFile(f))">预览</a>
                                            <a @onclick="@(() => DownloadFile(f))">下载</a>
                                        }
                                        <a class="danger" @onclick="@(() => ConfirmDeleteFile(f))">删除</a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </HTable>
            </div>
        </div>
    }
    </ChildContent>
</HCard>

<!-- 新建文件夹弹窗 -->
<HModal Title="新建文件夹" Visible="@showFolderModal" OnOk="@CreateFolder" OnCancel="@(() => showFolderModal = false)">
    <div class="h-form-item h-form-horizontal">
        <label class="h-form-label">文件夹名称</label>
        <div class="h-form-control">
            <input type="text" @bind-value="@newFolderName" placeholder="请输入文件夹名称" class="h-input" />
        </div>
    </div>
</HModal>

<!-- 文件预览弹窗 -->
<HModal Title="@($"预览 - {previewData?.FileName}")" Visible="@showPreview" OnCancel="@(() => showPreview = false)" ShowFooter="false" Style="width:800px;">
    @if (previewData != null)
    {
        @switch (previewData.PreviewType)
        {
            case "image":
                <div style="text-align:center;">
                    <img src="@previewData.PreviewUrl" style="max-width:100%;max-height:60vh;" alt="@previewData.FileName" />
                </div>
                break;
            case "text":
                <pre class="file-preview-text">@previewData.TextContent</pre>
                break;
            case "markdown":
                <pre class="file-preview-text">@previewData.TextContent</pre>
                break;
            case "html":
                <iframe srcdoc="@previewData.TextContent" style="width:100%;height:60vh;border:1px solid #F2F3F5;border-radius:4px;"></iframe>
                break;
            case "pdf":
                <iframe src="@previewData.PreviewUrl" style="width:100%;height:60vh;border:none;border-radius:4px;"></iframe>
                break;
            case "office":
                <div style="text-align:center;padding:40px;color:#86909C;">
                    <div style="font-size:36px;margin-bottom:12px;">📊</div>
                    <div>Office 文件暂不支持在线预览</div>
                    <a href="@previewData.PreviewUrl" target="_blank" class="h-btn h-btn-primary" style="margin-top:16px;display:inline-block;">下载查看</a>
                </div>
                break;
            default:
                <div style="text-align:center;padding:40px;color:#86909C;">
                    <div style="font-size:36px;margin-bottom:12px;">📎</div>
                    <div>该文件类型暂不支持预览</div>
                </div>
                break;
        }
    }
</HModal>

<style>
    .file-manager { display: flex; gap: 16px; min-height: 500px; }
    .file-tree-panel { width: 240px; min-width: 240px; border: 1px solid #F2F3F5; border-radius: 8px; display: flex; flex-direction: column; }
    .file-tree-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #F2F3F5; font-weight: 600; font-size: 14px; }
    .file-tree-body { flex: 1; overflow-y: auto; padding: 8px; }
    .file-tree-node { padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .file-tree-node:hover { background: #F7F8FA; }
    .file-tree-node.active { background: #E8F3FF; color: #165DFF; }
    .file-tree-node .node-actions { display: none; float: right; }
    .file-tree-node:hover .node-actions { display: inline; }
    .file-tree-children { padding-left: 16px; }
    .file-list-panel { flex: 1; min-width: 0; }
    .file-list-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .file-list-path { font-size: 13px; color: #86909C; }
    .file-name-link { color: #165DFF; cursor: pointer; }
    .file-name-link:hover { text-decoration: underline; }
    .file-preview-text { background: #F7F8FA; padding: 16px; border-radius: 4px; max-height: 60vh; overflow: auto; font-size: 13px; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
    .h-btn-sm { padding: 4px 10px; font-size: 12px; }
</style>

@code {
    private List<FileProjectDto> projects = new();
    private Guid selectedProjectId;
    private List<FileFolderDto> folderTree = new();
    private List<FileObjectDto> files = new();
    private string? currentFolder;
    private bool loadingFiles;
    private bool uploading;
    private bool showFolderModal;
    private string newFolderName = string.Empty;
    private bool showPreview;
    private FilePreviewDto? previewData;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetListAsync();
        // 从 URL 参数读取项目ID
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var projectParam = query["project"];
        if (Guid.TryParse(projectParam, out var pid))
        {
            selectedProjectId = pid;
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        selectedProjectId = Guid.TryParse(val, out var id) ? id : Guid.Empty;
        currentFolder = null;
        if (selectedProjectId != Guid.Empty)
        {
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private async Task LoadFolderTree()
    {
        try { folderTree = await FileService.GetFolderTreeAsync(selectedProjectId); }
        catch { folderTree = new(); }
    }

    private async Task LoadFiles()
    {
        if (selectedProjectId == Guid.Empty) return;
        loadingFiles = true;
        try { files = await FileService.GetFilesAsync(selectedProjectId, currentFolder); }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"加载文件失败：{ex.Message}"); }
        finally { loadingFiles = false; }
    }

    private async Task SelectFolder(string? path)
    {
        currentFolder = path;
        await LoadFiles();
    }

    private void ShowNewFolderDialog()
    {
        newFolderName = string.Empty;
        showFolderModal = true;
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderName))
        {
            await JS.InvokeVoidAsync("alert", "文件夹名称不能为空");
            return;
        }
        var path = string.IsNullOrEmpty(currentFolder) ? newFolderName : $"{currentFolder.TrimEnd('/')}/{newFolderName}";
        try
        {
            await FileService.CreateFolderAsync(selectedProjectId, path);
            showFolderModal = false;
            await LoadFolderTree();
            await LoadFiles();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"创建失败：{ex.Message}"); }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var result = await FileService.UploadAsync(selectedProjectId, currentFolder ?? "", file.Name, ms.ToArray(), file.ContentType);
                if (!result.Success)
                    await JS.InvokeVoidAsync("alert", $"上传 {file.Name} 失败：{result.Message}");
            }
            await LoadFiles();
            await LoadFolderTree();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"上传失败：{ex.Message}"); }
        finally { uploading = false; }
    }

    private async Task DownloadFile(FileObjectDto f)
    {
        try
        {
            var url = await FileService.GetDownloadUrlAsync(selectedProjectId, f.Key);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"获取下载链接失败：{ex.Message}"); }
    }

    private async Task PreviewFile(FileObjectDto f)
    {
        try
        {
            previewData = await FileService.GetPreviewAsync(selectedProjectId, f.Key);
            showPreview = true;
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"预览失败：{ex.Message}"); }
    }

    private async Task ConfirmDeleteFile(FileObjectDto f)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"确定删除「{f.FileName}」？");
        if (ok)
        {
            await FileService.DeleteAsync(selectedProjectId, f.Key);
            await LoadFiles();
        }
    }

    private async Task ConfirmDeleteFolder(FileFolderDto folder)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"确定删除文件夹「{folder.Name}」及其所有文件？");
        if (ok)
        {
            await FileService.DeleteFolderAsync(selectedProjectId, folder.Path);
            if (currentFolder?.StartsWith(folder.Path) == true)
                currentFolder = null;
            await LoadFolderTree();
            await LoadFiles();
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):F2} GB"
    };

    private static string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".svg" or ".webp" or ".bmp" => "🖼️",
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".xls" or ".xlsx" => "📗",
            ".ppt" or ".pptx" => "📙",
            ".txt" or ".log" or ".md" => "📝",
            ".html" or ".htm" or ".css" or ".js" => "🌐",
            ".zip" or ".rar" or ".7z" => "📦",
            ".mp4" or ".avi" or ".mov" => "🎬",
            ".mp3" or ".wav" => "🎵",
            _ => "📄"
        };
    }
}
