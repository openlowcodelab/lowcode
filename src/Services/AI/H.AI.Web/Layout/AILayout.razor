@namespace H.AI.Web

@inherits LayoutComponentBase

<DefaultLayoutComponent AppName="AI 应用" AuthMode="AuthenticationMode.Optional" MenuItems="@MenuItems">
    @Body
</DefaultLayoutComponent>

<style>
    /* ========== Buttons (shared by Settings and other pages) ========== */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 6px 16px;
        font-size: 14px;
        line-height: 1.5;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fafafa;
        color: #595959;
        cursor: pointer;
        transition: all 0.2s;
        outline: none;
        font-family: inherit;
        white-space: nowrap;
    }

    .btn:hover:not(:disabled) {
        color: #262626;
        border-color: #595959;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .btn:active:not(:disabled) {
        opacity: 0.8;
    }

    .btn-primary {
        color: #fff;
        background: #165DFF;
        border-color: #165DFF;
    }

    .btn-primary:hover:not(:disabled) {
        background: #4080FF;
        border-color: #4080FF;
        color: #fff;
    }

    .ai-btn-primary {
        background: #165DFF;
        border-color: #165DFF;
        color: #fff;
    }

    .ai-btn-primary:hover:not(:disabled) {
        background: #4080FF;
        border-color: #4080FF;
        color: #fff;
    }

    /* 返回按钮 */
    .back-btn {
        color: #262626;
    }

    .back-btn:hover {
        background: #f0f0f0;
        color: #262626;
    }

    .btn-link {
        border-color: transparent;
        background: transparent;
        color: #595959;
        padding: 4px 8px;
    }

    .btn-link:hover:not(:disabled) {
        background: transparent;
        color: #262626;
        border-color: transparent;
    }

    .btn-text {
        border-color: transparent;
        background: transparent;
        padding: 4px 8px;
    }

    .btn-text:hover:not(:disabled) {
        background: #f5f5f5;
        border-color: transparent;
    }

    .btn-danger {
        color: #ff4d4f;
    }

    .btn-danger:hover:not(:disabled) {
        color: #ff4d4f;
        background: #fff1f0;
        border-color: transparent;
    }

    .btn-small {
        padding: 2px 8px;
        font-size: 12px;
    }

    /* ========== SVG Icons (shared by Settings and other pages) ========== */
    .btn svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    /* ========== Empty State ========== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .empty-icon svg {
        width: 48px;
        height: 48px;
        color: #d9d9d9;
    }

    .empty-text {
        color: #8c8c8c;
        font-size: 14px;
    }

    /* ========== Modal（共享） ========== */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-dialog {
        background: white;
        border-radius: 8px;
        width: 520px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid #e8e8e8;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 16px;
    }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e8e8e8;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .modal-close-btn {
        padding: 4px;
    }

    .modal-close-btn:hover {
        background: #f5f5f5;
    }

    .modal-btn-primary {
        height: 36px;
        padding: 4px 20px;
        border: none;
        border-radius: 6px;
        background: #165DFF;
        color: #fff;
        font-size: 14px;
        cursor: pointer;
        min-width: 80px;
    }

    .modal-btn-primary:hover:not(:disabled) {
        background: #4080FF;
    }

    .modal-btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .modal-btn-cancel {
        height: 36px;
        padding: 4px 20px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fff;
        color: #595959;
        font-size: 14px;
        cursor: pointer;
        min-width: 80px;
    }

    .modal-btn-cancel:hover {
        color: #262626;
        border-color: #262626;
    }

    .modal-input {
        width: 100%;
        height: 36px;
        padding: 4px 11px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        font-size: 14px;
        color: #262626;
        background: #fff;
        outline: none;
        box-sizing: border-box;
    }

    .modal-input:focus {
        border-color: #a6a6a6;
        box-shadow: 0 0 0 2px rgba(166, 166, 166, 0.1);
    }

    .modal-input::placeholder {
        color: #bfbfbf;
    }

    textarea.modal-input {
        height: auto;
    }

    .modal-select {
        width: 100%;
        height: 36px;
        padding: 4px 11px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        font-size: 14px;
        color: #262626;
        background: #fff;
        outline: none;
        cursor: pointer;
    }

    .modal-textarea {
        min-height: 60px;
        resize: vertical;
        font-family: inherit;
        font-size: 13px;
    }

    /* ========== Form（共享） ========== */
    .form-item {
        margin-bottom: 16px;
    }

    .form-item label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        color: #595959;
        font-weight: 500;
    }

    .form-item.required label::before {
        content: "*";
        color: #ff4d4f;
        margin-right: 4px;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .form-row .form-item {
        flex: 1;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 14px;
        color: #333;
    }

    .checkbox-label input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: #1677ff;
        cursor: pointer;
    }

    .model-info-row {
        font-size: 13px;
        color: #595959;
        margin-bottom: 4px;
    }

    .info-label {
        color: #8c8c8c;
        margin-right: 4px;
    }

    /* ========== Toast（共享） ========== */
    .toast-notification {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        padding: 8px 20px;
        border-radius: 6px;
        font-size: 14px;
        color: #fff;
        background: #595959;
        z-index: 2000;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .toast-show {
        opacity: 1;
    }

    .toast-error {
        background: #ff4d4f;
    }

    .toast-warning {
        background: #faad14;
    }

    .toast-success {
        background: #52c41a;
</style>

@code {
    private static List<AppMenuItem> MenuItems => new()
    {
        new AppMenuItem { Name = "模型管理", Url = "/ai/models", Icon = "🤖" }
    };
}
