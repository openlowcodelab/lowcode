@namespace H.Account.Web

@inherits LayoutComponentBase

<div class="auth-page">
    <div class="auth-bg"></div>

    <div class="auth-illustration">
        <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:rgba(22,93,255,0.3)" />
                    <stop offset="100%" style="stop-color:rgba(118,75,162,0.15)" />
                </linearGradient>
                <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#165DFF" />
                    <stop offset="100%" style="stop-color:#0E42D2" />
                </linearGradient>
            </defs>
            <rect x="100" y="80" width="200" height="140" rx="12" fill="white" fill-opacity="0.6" stroke="rgba(22,93,255,0.3)" stroke-width="2" />
            <rect x="115" y="95" width="170" height="100" rx="4" fill="rgba(240,242,245,0.8)" />
            <rect x="170" y="220" width="60" height="12" rx="2" fill="rgba(22,93,255,0.2)" />
            <rect x="150" y="232" width="100" height="8" rx="4" fill="rgba(22,93,255,0.15)" />
            <rect x="130" y="110" width="60" height="8" rx="4" fill="rgba(22,93,255,0.4)" />
            <rect x="130" y="125" width="40" height="6" rx="3" fill="rgba(22,93,255,0.25)" />
            <rect x="130" y="145" width="80" height="10" rx="5" fill="rgba(22,93,255,0.15)" />
            <rect x="130" y="162" width="80" height="10" rx="5" fill="rgba(22,93,255,0.15)" />
            <circle cx="250" cy="140" r="20" fill="rgba(22,93,255,0.15)" stroke="url(#g3)" stroke-width="2" />
            <path d="M244 140 l4 4 l8-8" stroke="url(#g3)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <g transform="translate(60, 160)">
                <path d="M25 5 L45 15 L45 30 Q45 50 25 60 Q5 50 5 30 L5 15 Z" fill="url(#g1)" stroke="rgba(22,93,255,0.4)" stroke-width="1.5" />
                <path d="M20 32 l5 5 l10-12" stroke="url(#g3)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </g>
            <circle cx="320" cy="100" r="30" fill="rgba(22,93,255,0.08)" stroke="rgba(22,93,255,0.2)" stroke-width="1" />
            <circle cx="340" cy="200" r="18" fill="rgba(118,75,162,0.08)" stroke="rgba(118,75,162,0.15)" stroke-width="1" />
            <circle cx="80" cy="100" r="22" fill="rgba(22,93,255,0.06)" stroke="rgba(22,93,255,0.15)" stroke-width="1" />
            <line x1="80" y1="100" x2="100" y2="120" stroke="rgba(22,93,255,0.2)" stroke-width="1" stroke-dasharray="4 3" />
            <line x1="320" y1="100" x2="300" y2="120" stroke="rgba(22,93,255,0.2)" stroke-width="1" stroke-dasharray="4 3" />
            <line x1="340" y1="200" x2="300" y2="180" stroke="rgba(22,93,255,0.2)" stroke-width="1" stroke-dasharray="4 3" />
            <circle cx="180" cy="310" r="3" fill="rgba(22,93,255,0.35)" />
            <circle cx="200" cy="320" r="2" fill="rgba(118,75,162,0.25)" />
            <circle cx="220" cy="305" r="3.5" fill="rgba(22,93,255,0.3)" />
            <circle cx="160" cy="330" r="2" fill="rgba(22,93,255,0.2)" />
            <circle cx="240" cy="330" r="2.5" fill="rgba(118,75,162,0.2)" />
        </svg>
    </div>

    <div class="auth-decor">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="blob blob-3"></span>
    </div>

    <div class="auth-content">
        @Body
    </div>
</div>

<style>
    .auth-page {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .auth-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: linear-gradient(135deg, #dce2f8 0%, #e4e0f5 20%, #edf0f9 40%, #f5f7fc 60%, #fafbfe 100%);
    }

    .auth-illustration {
        position: relative;
        z-index: 1;
        flex: 0 0 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 40px;
        text-align: center;
    }

    .auth-illustration svg {
        width: 100%;
        max-width: 360px;
        height: auto;
        opacity: 0.9;
    }

    .auth-decor {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .auth-decor .blob {
        position: absolute;
        border-radius: 50%;
        opacity: 0.08;
        animation: authBlob 20s infinite ease-in-out;
    }

    .auth-decor .blob-1 {
        width: 400px;
        height: 400px;
        background: #165DFF;
        top: -120px;
        left: 10%;
    }

    .auth-decor .blob-2 {
        width: 300px;
        height: 300px;
        background: #0E42D2;
        bottom: -80px;
        left: 30%;
        animation-delay: -7s;
    }

    .auth-decor .blob-3 {
        width: 200px;
        height: 200px;
        background: #a78bfa;
        top: 40%;
        right: -60px;
        animation-delay: -14s;
    }

    @@keyframes authBlob {
        0%, 100% { transform: translateY(0) scale(1); }
        33% { transform: translateY(-15px) scale(1.03); }
        66% { transform: translateY(8px) scale(0.97); }
    }

    .auth-content {
        position: relative;
        z-index: 2;
        flex: 0 0 440px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 80px;
    }

    .auth-content > .auth-form,
    .auth-content > .auth-card {
        width: 100%;
        max-width: 400px;
        background: #fff;
        border-radius: 16px;
        padding: 40px 36px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06),
                    0 1px 4px rgba(0, 0, 0, 0.04);
    }

    .auth-form-links {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 4px 0 0 0;
    }

    .auth-form-links a {
        font-size: 13px;
        color: #165DFF;
    }

    .auth-form-links a:last-child {
        color: #86909C;
    }

    .auth-form-links-spacer {
        height: 20px;
    }

    .auth-form-links a:hover {
        text-decoration: none;
        opacity: 0.8;
    }

    .auth-form .h-input {
        background: #fff;
        border: 1px solid #E5E6EB;
        color: #1D2129;
        border-radius: 8px;
        height: 42px;
        width: 100%;
        padding: 4px 11px;
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .auth-form .h-input::placeholder {
        color: #C9CDD4;
    }

    .auth-form .h-input:focus {
        border-color: #165DFF;
        box-shadow: 0 0 0 2px rgba(22, 93, 255, 0.12);
        outline: none;
    }

    .auth-form .h-radio-group {
        display: flex;
        gap: 0;
    }

    .auth-form .h-radio-button {
        padding: 4px 15px;
        height: 32px;
        line-height: 30px;
        border: 1px solid #E5E6EB;
        background: #fff;
        color: #4E5969;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }

    .auth-form .h-radio-button:first-child {
        border-radius: 6px 0 0 6px;
    }

    .auth-form .h-radio-button:last-child {
        border-radius: 0 6px 6px 0;
    }

    .auth-form .h-radio-button:not(:first-child) {
        margin-left: -1px;
    }

    .auth-form .h-radio-button input[type="radio"] {
        display: none;
    }

    .auth-form .h-radio-button.active {
        background: rgba(22, 93, 255, 0.08);
        border-color: #165DFF;
        color: #165DFF;
        z-index: 1;
    }

    .auth-form .h-radio-button:hover {
        color: #165DFF;
    }

    .auth-btn-primary {
        height: 44px !important;
        border-radius: 8px !important;
        font-size: 15px !important;
        font-weight: 500 !important;
        background: linear-gradient(135deg, #165DFF 0%, #0E42D2 100%) !important;
        border: none !important;
        box-shadow: 0 4px 12px rgba(22, 93, 255, 0.3) !important;
        transition: all 0.3s ease !important;
        color: #fff !important;
    }

    .auth-btn-primary:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 18px rgba(22, 93, 255, 0.45) !important;
    }

    .auth-btn-primary:active {
        transform: translateY(0) !important;
    }

    .login-tabs {
        display: flex;
        gap: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid #F2F3F5;
    }

    .login-tab {
        padding: 8px 0;
        font-size: 15px;
        color: #86909C;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.3s ease;
        user-select: none;
    }

    .login-tab:hover {
        color: #165DFF;
    }

    .login-tab.active {
        color: #165DFF;
        font-weight: 500;
        border-bottom-color: #165DFF;
    }

    .auth-form .btn-send-code {
        height: 42px !important;
        border-radius: 8px !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        background: linear-gradient(135deg, #165DFF 0%, #0E42D2 100%) !important;
        border: none !important;
        color: #fff !important;
        white-space: nowrap !important;
        padding: 0 16px !important;
        transition: all 0.3s ease !important;
    }

    .auth-form .btn-send-code:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 4px 12px rgba(22, 93, 255, 0.35) !important;
    }

    .auth-form .btn-send-code[disabled] {
        background: #E5E6EB !important;
        color: #86909C !important;
        box-shadow: none !important;
        transform: none !important;
    }

    .auth-social-btns {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-bottom: 20px;
    }

    .auth-social-btns .social-circle-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #F7F8FA;
        border: 1px solid #E5E6EB;
        color: #4E5969;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
        font-size: 0;
        text-decoration: none;
    }

    .auth-social-btns .social-circle-btn:hover {
        background: #165DFF;
        border-color: #165DFF;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(22, 93, 255, 0.3);
        text-decoration: none;
    }

    .auth-social-btns .social-circle-btn .social-svg {
        fill: currentColor;
        display: block;
    }

    .auth-footer {
        text-align: center;
        color: #86909C;
        font-size: 14px;
    }

    .auth-footer a {
        color: #165DFF !important;
        font-weight: 500;
    }

    .auth-footer a:hover {
        color: #0E42D2 !important;
        text-decoration: none;
    }

    .auth-form .h-alert {
        border-radius: 8px;
    }

    .auth-card .auth-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .auth-card .auth-header .auth-logo {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, #165DFF, #0E42D2);
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        box-shadow: 0 4px 15px rgba(22, 93, 255, 0.3);
    }

    .auth-card .auth-header h2 {
        font-size: 24px;
        font-weight: 600;
        color: #1D2129 !important;
        margin: 0 0 6px 0;
    }

    .auth-card .auth-header p {
        font-size: 14px;
        color: #86909C !important;
        margin: 0;
    }

    .auth-card .h-spin-text {
        color: #4E5969;
    }

    @@media (max-width: 992px) {
        .auth-illustration {
            display: none;
        }
        .auth-content {
            flex: 1;
            margin-right: 0;
            justify-content: center;
            padding: 40px 20px;
        }
    }

    @@media (max-width: 480px) {
        .auth-content {
            padding: 24px 16px;
        }
        .auth-content > .auth-form,
        .auth-content > .auth-card {
            padding: 28px 20px;
        }
    }
</style>
