@page "/account/login"

@layout LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div style="max-width: 400px; margin: 50px auto;">
    <Card Title="用户登录">
        <Form Model="@loginModel" OnFinish="@HandleLogin" LabelColSpan="8" WrapperColSpan="16">
            <FormItem Label="用户名">
                <Input @bind-Value="@loginModel.UserName" Placeholder="请输入用户名" />
            </FormItem>

            <FormItem Label="密码">
                <InputPassword @bind-Value="@loginModel.Password" Placeholder="请输入密码" />
            </FormItem>

            <FormItem WrapperColOffset="8" WrapperColSpan="16">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block>登录</Button>
            </FormItem>
        </Form>

        <Divider />

        <div style="text-align: center;">
            还没有账户？ <a href="/account/register">点击注册</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <Alert Type="@AlertType.Success" Message="@successMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }
    </Card>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginRequestDto? loginModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";

    protected override void OnInitialized()
    {
        loginModel ??= new LoginRequestDto();
    }

    private async Task HandleLogin()
    {
        if (loginModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            if (AuthService == null)
            {
                errorMessage = "系统错误：认证服务未初始化";
                return;
            }
            
            var result = await AuthService.LoginAsync(loginModel);
            
            if (result == null)
            {
                errorMessage = "登录失败：服务器未返回有效响应";
                return;
            }
            
            if (result.Success)
            {
                successMessage = "登录成功！正在跳转到首页...";
                errorMessage = string.Empty;
                
                if (!string.IsNullOrEmpty(result.Token))
                {
                    Navigation.NavigateTo($"/?token={Uri.EscapeDataString(result.Token)}");
                }
                else
                {
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = result.Message ?? "登录失败";
                successMessage = string.Empty;
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"登录失败: {ex.Message}";
            successMessage = string.Empty;
        }
    }
}
