@page "/account/login"
@attribute [AllowAnonymous]

@layout AccountEmptyLayout
@inject HttpClient HttpClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="auth-form">
    <h2 class="auth-title">登录 <span class="auth-title-en">/ LOGIN</span></h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <Alert Type="@AlertType.Success" Message="@successMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    <Form Model="@loginModel" OnFinish="@HandleLogin">
        <FormItem>
            <Input @bind-Value="@loginModel.Account" Placeholder="请输入账号" />
        </FormItem>

        <FormItem>
            <InputPassword @bind-Value="@loginModel.Password" Placeholder="请输入密码" />
        </FormItem>

        <div class="auth-form-links">
            <a href="/account/register">注册</a>
            <a href="#">忘记密码？</a>
        </div>

        <FormItem Style="margin-top: 24px; margin-bottom: 20px;">
            <Button Type="@ButtonType.Primary" OnClick="@HandleLogin" Block Class="auth-btn-primary">登 录</Button>
        </FormItem>
    </Form>

    <div class="auth-social-btns">
        <Button Shape="@ButtonShape.Circle" OnClick="@(() => ExternalLogin("WeChat"))" Title="微信登录">
            <Icon Type="wechat" />
        </Button>
        <Button Shape="@ButtonShape.Circle" OnClick="@(() => ExternalLogin("DingTalk"))" Title="钉钉登录">
            <Icon Type="dingding" />
        </Button>
    </div>

    <div class="auth-footer">
        还没有账户？ <a href="/account/register">立即注册</a>
    </div>
</div>

@code {
    private LoginRequestDto? loginModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";
    private string returnUrl = "/";

    protected override void OnInitialized()
    {
        loginModel ??= new LoginRequestDto();
        
        // 读取查询参数
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query["returnUrl"] ?? "/";
        
        // 读取外部登录回调的错误信息
        var error = query["error"];
        if (!string.IsNullOrEmpty(error))
        {
            errorMessage = error;
        }
    }

    private async Task HandleLogin()
    {
        if (loginModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            // 使用ABP自动控制器的API路径
            var response = await HttpClient.PostAsJsonAsync("/api/app/account/login", loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "登录成功！正在跳转到首页...";
                errorMessage = string.Empty;
                
                // 跳转到目标页面
                Navigation.NavigateTo(returnUrl, forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = "登录失败：" + (response.ReasonPhrase ?? "未知错误");
                successMessage = string.Empty;
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"登录失败: {ex.Message}";
            successMessage = string.Empty;
        }
    }

    private void ExternalLogin(string provider)
    {
        var returnUrl = Navigation.ToAbsoluteUri("/account/external-callback");
        Navigation.NavigateTo(
            $"/api/external-login/challenge?provider={provider}&returnUrl={Uri.EscapeDataString(returnUrl.ToString())}",
            forceLoad: true);
    }
}
