@page "/account/login"
@layout LayoutComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3>用户登录</h3>

<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="LoginForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="username">用户名:</label>
        <InputText id="username" @bind-value="loginModel.UserName" class="form-control" />
    </div>

    <div class="form-group">
        <label for="password">密码:</label>
        <InputText id="password" @bind-value="loginModel.Password" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary w-100">登录</button>
</EditForm>

<div class="mt-3">
    还没有账户？ <a href="/account/register">点击注册</a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

@code {
    [SupplyParameterFromForm]
    private LoginRequestDto? loginModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";

    protected override void OnInitialized()
    {
        loginModel ??= new LoginRequestDto();
    }

    private async Task HandleLogin()
    {
        if (loginModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            // 检查 AuthService 是否注入成功
            if (AuthService == null)
            {
                errorMessage = "系统错误：认证服务未初始化";
                return;
            }
            
            var result = await AuthService.LoginAsync(loginModel);
            
            // 检查返回结果
            if (result == null)
            {
                errorMessage = "登录失败：服务器未返回有效响应";
                return;
            }
            
            if (result.Success)
            {
                successMessage = "登录成功！正在跳转到首页...";
                errorMessage = string.Empty;
                
                if (!string.IsNullOrEmpty(result.Token))
                {
                    // 直接跳转到首页，token 通过 URL 参数传递
                    Navigation.NavigateTo($"/?token={Uri.EscapeDataString(result.Token)}");
                }
                else
                {
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = result.Message ?? "登录失败";
                successMessage = string.Empty;
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"登录失败: {ex.Message}";
            successMessage = string.Empty;
        }
    }
}
