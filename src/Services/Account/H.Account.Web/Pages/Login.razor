@page "/account/login"
@attribute [AllowAnonymous]

@layout AccountEmptyLayout
@inject HttpClient HttpClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div style="max-width: 400px; margin: 50px auto;">
    <Card Title="用户登录">
        <Form Model="@loginModel" OnFinish="@HandleLogin" LabelColSpan="8" WrapperColSpan="16">
            <FormItem Label="账号">
                <Input @bind-Value="@loginModel.Account" Placeholder="请输入用户名/邮箱/手机号" />
            </FormItem>

            <FormItem Label="密码">
                <InputPassword @bind-Value="@loginModel.Password" Placeholder="请输入密码" />
            </FormItem>

            <FormItem WrapperColSpan="16" WrapperColOffset="8">
                <Checkbox @bind-Checked="@loginModel.RememberMe">记住我</Checkbox>
            </FormItem>

            <FormItem WrapperColSpan="16" WrapperColOffset="8">
                <Button Type="@ButtonType.Primary" OnClick="@HandleLogin" Block>登录</Button>
            </FormItem>
        </Form>

        <Divider>第三方登录</Divider>

        <div style="text-align: center;">
            <Space>
                <Button Icon="wechat" OnClick="@(() => ExternalLogin("WeChat"))">微信登录</Button>
                <Button OnClick="@(() => ExternalLogin("DingTalk"))">钉钉登录</Button>
            </Space>
        </div>

        <Divider />

        <div style="text-align: center;">
            还没有账户？ <a href="/account/register">点击注册</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <Alert Type="@AlertType.Success" Message="@successMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }
    </Card>
</div>

@code {
    private LoginRequestDto? loginModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";
    private string returnUrl = "/";

    protected override void OnInitialized()
    {
        loginModel ??= new LoginRequestDto();
        
        // 读取returnUrl参数
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        returnUrl = query["returnUrl"] ?? "/";
    }

    private async Task HandleLogin()
    {
        if (loginModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            // 使用ABP自动控制器的API路径
            var response = await HttpClient.PostAsJsonAsync("/api/app/account/login", loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "登录成功！正在跳转到首页...";
                errorMessage = string.Empty;
                
                // 跳转到目标页面
                Navigation.NavigateTo(returnUrl, forceLoad: true);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = "登录失败：" + (response.ReasonPhrase ?? "未知错误");
                successMessage = string.Empty;
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"登录失败: {ex.Message}";
            successMessage = string.Empty;
        }
    }

    private async Task ExternalLogin(string provider)
    {
        var returnUrl = Navigation.ToAbsoluteUri("/account/external-callback");
        Navigation.NavigateTo($"/api/account/external-login?provider={provider}&returnUrl={Uri.EscapeDataString(returnUrl.ToString())}");
    }
}
