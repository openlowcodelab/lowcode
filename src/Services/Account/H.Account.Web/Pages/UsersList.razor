@page "/users"
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>用户管理</PageTitle>

<Card Title="用户管理">
    <div style="margin-bottom: 16px;">
        <Space Size="@("middle")">
            <SpaceItem>
                <Input @bind-Value="@searchKeyword" Placeholder="搜索用户名、邮箱、手机号" Style="width: 200px;"
                       OnKeyUp="@HandleSearchKeyUp" />
            </SpaceItem>
            <SpaceItem>
                <Select TItem="UserType?" TItemValue="UserType?" @bind-Value="@searchUserType" Placeholder="用户类型" Style="width: 120px;" AllowClear>
                    <SelectOption Value="@((UserType?)UserType.Normal)" Label="普通用户" />
                    <SelectOption Value="@((UserType?)UserType.Admin)" Label="管理员" />
                    <SelectOption Value="@((UserType?)UserType.SuperAdmin)" Label="超级管理员" />
                </Select>
            </SpaceItem>
            <SpaceItem>
                <Select TItem="bool?" TItemValue="bool?" @bind-Value="@searchIsActive" Placeholder="状态" Style="width: 120px;" AllowClear>
                    <SelectOption Value="true" Label="激活" />
                    <SelectOption Value="false" Label="禁用" />
                </Select>
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="@LoadUsers">搜索</Button>
            </SpaceItem>
            <SpaceItem>
                <a href="/admin/users/create">
                    <Button Type="@ButtonType.Primary">新增</Button>
                </a>
            </SpaceItem>
        </Space>
    </div>

    <Table TItem="UserDto" DataSource="@users.Items" Loading="@isLoading" HidePagination="true">
        <Column TData="string" Title="ID">
            @context.Id.ToString("N")[..8]
        </Column>
        <Column TData="string" Title="用户名">
            @context.UserName
        </Column>
        <Column TData="string" Title="邮箱">
            @context.Email
        </Column>
        <Column TData="string" Title="手机号">
            @context.PhoneNumber
        </Column>
        <Column TData="string" Title="用户类型">
            <Tag Color="@GetUserTypeColor(context.UserType)">@GetUserTypeText(context.UserType)</Tag>
        </Column>
        <Column TData="string" Title="状态">
            @if (context.IsActive)
            {
                <Tag Color="@("green")">激活</Tag>
            }
            else
            {
                <Tag Color="@("red")">禁用</Tag>
            }
        </Column>
        <Column TData="string" Title="创建时间">
            @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
        </Column>
        <Column TData="string" Title="最后登录">
            @(context.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
        </Column>
        <Column TData="string" Title="操作">
            <Space>
                <SpaceItem>
                    <a href="/admin/users/@context.Id/edit">
                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small">编辑</Button>
                    </a>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="确定要删除该用户吗？" OnConfirm="@(() => DeleteUser(context.Id))">
                        <Button Type="@ButtonType.Primary" Danger Size="@ButtonSize.Small">删除</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </Column>
    </Table>

    @if (users.Items.Any())
    {
        <div style="margin-top: 16px; text-align: center;">
            <Pagination Current="@users.PageIndex" PageSize="@users.PageSize" Total="@users.Total"
                        OnChange="@HandlePageChange" />
        </div>
    }

    @if (!users.Items.Any() && !isLoading)
    {
        <Empty Description="@("暂无用户数据")" />
    }
</Card>

@code {
    private PagedResult<UserDto> users = new() { PageIndex = 1, PageSize = 10 };
    private bool isLoading = false;
    private string searchKeyword = "";
    private UserType? searchUserType = null;
    private bool? searchIsActive = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            var queryParams = new UserQueryParams
            {
                PageIndex = users.PageIndex,
                PageSize = users.PageSize
            };

            if (!string.IsNullOrWhiteSpace(searchKeyword))
                queryParams.Keyword = searchKeyword;
            if (searchUserType.HasValue)
                queryParams.UserType = searchUserType.Value;
            if (searchIsActive.HasValue)
                queryParams.IsActive = searchIsActive.Value;

            users = await UserService.GetPagedUsersAsync(queryParams);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载用户失败：{ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            users.PageIndex = 1;
            await LoadUsers();
        }
    }

    private async Task HandlePageChange(PaginationEventArgs e)
    {
        users.PageIndex = e.Page;
        users.PageSize = e.PageSize;
        await LoadUsers();
    }

    private async Task DeleteUser(Guid userId)
    {
        try
        {
            await UserService.DeleteUserAsync(userId);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"删除失败：{ex.Message}");
        }
    }

    private string GetUserTypeColor(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "blue",
            UserType.SuperAdmin => "red",
            _ => "default"
        };
    }

    private string GetUserTypeText(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "管理员",
            UserType.SuperAdmin => "超级管理员",
            _ => "普通用户"
        };
    }
}
