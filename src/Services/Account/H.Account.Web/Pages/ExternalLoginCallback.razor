@page "/account/external-callback"
@attribute [AllowAnonymous]
@layout AccountEmptyLayout
@inject NavigationManager Navigation

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <Icon Type="safety-certificate" />
        </div>
        <h2>第三方登录</h2>
        <p>正在处理您的登录请求</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Type="@AlertType.Error" Message="@_errorMessage" ShowIcon="true" Style="margin-bottom: 20px;" />
        <div style="text-align: center;">
            <Button Type="@ButtonType.Primary" OnClick="@ReturnToLogin" Class="auth-btn-primary">返回登录</Button>
        </div>
    }
    else if (_isLoading)
    {
        <div style="text-align: center; padding: 20px 0;">
            <Spin Tip="正在处理第三方登录..." />
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 20px 0;">
            <Spin Tip="正在跳转..." />
        </div>
    }
</div>

@code {
    private string? _errorMessage;
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var error = query["error"];
        var success = query["success"];

        if (!string.IsNullOrEmpty(error))
        {
            _errorMessage = error;
            _isLoading = false;
            return;
        }

        if (success == "true")
        {
            // Cookie 已由 Controller 写入，需要 forceLoad 让 Blazor 重新加载以读取新的认证状态
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        // 未知状态，返回登录
        _errorMessage = "外部登录未完成";
        _isLoading = false;
    }

    private void ReturnToLogin()
    {
        Navigation.NavigateTo("/account/login");
    }
}
