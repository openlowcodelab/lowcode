@page "/account/users/create"
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>创建用户</PageTitle>

<Card Title="创建用户">
    <Form Model="@createUserDto" OnFinish="@HandleSubmit" LabelColSpan="4" WrapperColSpan="20">
        <div class="ant-row">
            <div class="ant-col ant-col-12">
                <FormItem Label="用户名" Required>
                    <Input @bind-Value="@createUserDto.UserName" Placeholder="请输入用户名" />
                </FormItem>
            </div>
            <div class="ant-col ant-col-12">
                <FormItem Label="邮箱" Required>
                    <Input @bind-Value="@createUserDto.Email" Placeholder="请输入邮箱" />
                </FormItem>
            </div>
        </div>

        <div class="ant-row">
            <div class="ant-col ant-col-12">
                <FormItem Label="密码" Required>
                    <InputPassword @bind-Value="@createUserDto.Password" Placeholder="请输入密码" />
                </FormItem>
            </div>
            <div class="ant-col ant-col-12">
                <FormItem Label="确认密码" Required>
                    <InputPassword @bind-Value="@createUserDto.ConfirmPassword" Placeholder="请再次输入密码" />
                </FormItem>
            </div>
        </div>

        <div class="ant-row">
            <div class="ant-col ant-col-12">
                <FormItem Label="手机号">
                    <Input @bind-Value="@createUserDto.PhoneNumber" Placeholder="请输入手机号" />
                </FormItem>
            </div>
            <div class="ant-col ant-col-12">
                <FormItem Label="用户类型">
                    <Select TItem="UserType" TItemValue="UserType" @bind-Value="@createUserDto.UserType" Placeholder="请选择用户类型">
                        <SelectOption Value="@UserType.Normal" Label="普通用户" />
                        <SelectOption Value="@UserType.Admin" Label="管理员" />
                        <SelectOption Value="@UserType.SuperAdmin" Label="超级管理员" />
                    </Select>
                </FormItem>
            </div>
        </div>

        <div class="ant-row">
            <div class="ant-col ant-col-12">
                <FormItem Label="角色">
                    <Input @bind-Value="@createUserDto.Roles" Placeholder="逗号分隔多个角色" />
                </FormItem>
            </div>
            <div class="ant-col ant-col-12">
                <FormItem Label="账户激活">
                    <Switch @bind-Value="@createUserDto.IsActive" />
                </FormItem>
            </div>
        </div>

        <FormItem Label="备注">
            <TextArea @bind-Value="@createUserDto.Remark" Placeholder="请输入备注" Rows="3" />
        </FormItem>

        <FormItem WrapperColOffset="4">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" HtmlType="submit" Loading="@isSubmitting">创建用户</Button>
                </SpaceItem>
                <SpaceItem>
                    <a href="/account/users">
                        <Button>返回</Button>
                    </a>
                </SpaceItem>
            </Space>
        </FormItem>
    </Form>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-top: 16px;" />
    }
</Card>

@code {
    private CreateUserDto createUserDto = new();
    private bool isSubmitting = false;
    private string errorMessage = "";

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = "";

        try
        {
            await UserService.CreateUserAsync(createUserDto);
            Navigation.NavigateTo("/account/users");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"创建失败：{ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
