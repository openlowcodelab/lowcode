@page "/account/users/create"

@layout AccountLayout
@inject IUserAppService UserService
@inject NavigationManager Navigation

<PageTitle>创建用户</PageTitle>

<HCard Title="创建用户">
    <EditForm Model="@createUserDto" OnValidSubmit="@HandleSubmit">
        <div class="h-form-row">
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">用户名 <span class="h-required">*</span></label>
                    <div class="h-form-control">
                        <input type="text" @bind-value="@createUserDto.UserName" placeholder="请输入用户名" class="h-input" />
                    </div>
                </div>
            </div>
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">邮箱 <span class="h-required">*</span></label>
                    <div class="h-form-control">
                        <input type="text" @bind-value="@createUserDto.Email" placeholder="请输入邮箱" class="h-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="h-form-row">
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">密码 <span class="h-required">*</span></label>
                    <div class="h-form-control">
                        <input type="password" @bind-value="@createUserDto.Password" placeholder="请输入密码" class="h-input" />
                    </div>
                </div>
            </div>
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">确认密码 <span class="h-required">*</span></label>
                    <div class="h-form-control">
                        <input type="password" @bind-value="@createUserDto.ConfirmPassword" placeholder="请再次输入密码" class="h-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="h-form-row">
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">手机号</label>
                    <div class="h-form-control">
                        <input type="text" @bind-value="@createUserDto.PhoneNumber" placeholder="请输入手机号" class="h-input" />
                    </div>
                </div>
            </div>
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">用户类型</label>
                    <div class="h-form-control">
                        <select @bind="@createUserDto.UserType" class="h-select">
                            <option value="@UserType.Normal">普通用户</option>
                            <option value="@UserType.Admin">管理员</option>
                            <option value="@UserType.SuperAdmin">超级管理员</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="h-form-row">
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">角色</label>
                    <div class="h-form-control">
                        <input type="text" @bind-value="@createUserDto.Roles" placeholder="逗号分隔多个角色" class="h-input" />
                    </div>
                </div>
            </div>
            <div class="h-form-col">
                <div class="h-form-item h-form-horizontal">
                    <label class="h-form-label">账户激活</label>
                    <div class="h-form-control">
                        <label class="h-switch">
                            <input type="checkbox" @bind="@createUserDto.IsActive" />
                            <span class="h-switch-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label">备注</label>
            <div class="h-form-control">
                <textarea @bind="@createUserDto.Remark" placeholder="请输入备注" rows="3" class="h-textarea"></textarea>
            </div>
        </div>

        <div class="h-form-item h-form-horizontal">
            <label class="h-form-label"></label>
            <div class="h-form-control">
                <span class="h-space">
                    <button type="submit" class="h-btn h-btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="h-btn-loading"></span>
                        }
                        创建用户
                    </button>
                    <a href="/account/users" class="h-btn" style="text-decoration:none;">返回</a>
                </span>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="h-alert h-alert-error" style="margin-top: 16px;">
            <span class="h-alert-icon">&#9888;</span>
            <span>@errorMessage</span>
        </div>
    }
</HCard>

@code {
    private CreateUserDto createUserDto = new();
    private bool isSubmitting = false;
    private string errorMessage = "";

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = "";

        try
        {
            await UserService.CreateUserAsync(createUserDto);
            Navigation.NavigateTo("/account/users");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"创建失败：{ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
