@page "/account/register"
@layout LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div style="max-width: 500px; margin: 50px auto;">
    <Card Title="用户注册">
        <Form Model="@registerModel" OnFinish="@HandleRegister" LabelColSpan="6" WrapperColSpan="18">
            <FormItem Label="用户名">
                <Input @bind-Value="@registerModel.UserName" Placeholder="请输入用户名" />
            </FormItem>

            <FormItem Label="邮箱">
                <Input @bind-Value="@registerModel.Email" Placeholder="请输入邮箱" />
            </FormItem>

            <FormItem Label="密码">
                <InputPassword @bind-Value="@registerModel.Password" Placeholder="请输入密码" />
            </FormItem>

            <FormItem Label="确认密码">
                <InputPassword @bind-Value="@registerModel.ConfirmPassword" Placeholder="请再次输入密码" />
            </FormItem>

            <FormItem Label="手机号">
                <Input @bind-Value="@registerModel.PhoneNumber" Placeholder="请输入手机号" />
            </FormItem>

            <FormItem WrapperColOffset="6" WrapperColSpan="18">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block>注册</Button>
            </FormItem>
        </Form>

        <Divider />

        <div style="text-align: center;">
            已有账户？ <a href="/account/login">点击登录</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <Alert Type="@AlertType.Success" Message="@successMessage" ShowIcon="true" Style="margin-top: 16px;" />
        }
    </Card>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterRequestDto? registerModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";

    protected override void OnInitialized()
    {
        registerModel ??= new RegisterRequestDto();
    }

    private async Task HandleRegister()
    {
        if (registerModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            var result = await AuthService.RegisterAsync(registerModel);
            
            if (result.Success)
            {
                successMessage = "注册成功！正在跳转到登录页面...";
                errorMessage = "";
                
                await Task.Delay(500);
                Navigation.NavigateTo("/account/login");
            }
            else
            {
                errorMessage = result.Message;
                successMessage = "";
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"注册失败: {ex.Message}";
            successMessage = "";
        }
    }
}
