@page "/account/register"
@attribute [AllowAnonymous]

@layout AccountEmptyLayout
@inject IAccountAppService AccountAppService
@inject NavigationManager Navigation

<div class="auth-form">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="h-alert h-alert-error">
            <span class="h-alert-icon">&#9888;</span>
            <span>@errorMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="h-alert h-alert-success">
            <span class="h-alert-icon">&#10004;</span>
            <span>@successMessage</span>
        </div>
    }

    <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
        <div class="h-form-item">
            <div class="h-radio-group">
                <label class="h-radio-button @(registerModel.RegisterType == RegisterType.UserName ? "active" : "")">
                    <input type="radio" name="RegisterType" value="@RegisterType.UserName" @onchange="@(() => registerModel.RegisterType = RegisterType.UserName)" checked="@(registerModel.RegisterType == RegisterType.UserName)" />
                    用户名
                </label>
                <label class="h-radio-button @(registerModel.RegisterType == RegisterType.Email ? "active" : "")">
                    <input type="radio" name="RegisterType" value="@RegisterType.Email" @onchange="@(() => registerModel.RegisterType = RegisterType.Email)" checked="@(registerModel.RegisterType == RegisterType.Email)" />
                    邮箱
                </label>
                <label class="h-radio-button @(registerModel.RegisterType == RegisterType.PhoneNumber ? "active" : "")">
                    <input type="radio" name="RegisterType" value="@RegisterType.PhoneNumber" @onchange="@(() => registerModel.RegisterType = RegisterType.PhoneNumber)" checked="@(registerModel.RegisterType == RegisterType.PhoneNumber)" />
                    手机号
                </label>
            </div>
        </div>

        @if (registerModel.RegisterType == RegisterType.UserName)
        {
            <div class="h-form-item">
                <input type="text" @bind-value="@registerModel.UserName" placeholder="请输入用户名" class="h-input" />
            </div>
        }
        else if (registerModel.RegisterType == RegisterType.Email)
        {
            <div class="h-form-item">
                <input type="text" @bind-value="@registerModel.Email" placeholder="请输入邮箱" class="h-input" />
            </div>
            <div class="h-form-item">
                <div class="h-input-group">
                    <input type="text" @bind-value="@registerModel.EmailCode" placeholder="请输入邮箱验证码" class="h-input" style="flex:1;" />
                    <button type="button" @onclick="@SendEmailCode" class="h-btn btn-send-code">发送验证码</button>
                </div>
            </div>
        }
        else if (registerModel.RegisterType == RegisterType.PhoneNumber)
        {
            <div class="h-form-item">
                <input type="text" @bind-value="@registerModel.PhoneNumber" placeholder="请输入手机号" class="h-input" />
            </div>
            <div class="h-form-item">
                <div class="h-input-group">
                    <input type="text" @bind-value="@registerModel.PhoneCode" placeholder="请输入手机验证码" class="h-input" style="flex:1;" />
                    <button type="button" @onclick="@SendPhoneCode" class="h-btn btn-send-code">发送验证码</button>
                </div>
            </div>
        }

        <div class="h-form-item">
            <input type="password" @bind-value="@registerModel.Password" placeholder="请输入密码" class="h-input" />
        </div>

        <div class="h-form-item">
            <input type="password" @bind-value="@registerModel.ConfirmPassword" placeholder="请再次输入密码" class="h-input" />
        </div>

        <div class="h-form-item" style="margin-top: 24px; margin-bottom: 20px;">
            <button type="submit" class="h-btn h-btn-primary h-btn-block auth-btn-primary">注 册</button>
        </div>
    </EditForm>

    <div class="auth-social-btns">
        <button type="button" class="social-circle-btn" @onclick="@(() => BindExternalAccount("WeChat"))" title="绑定微信">
            <svg viewBox="0 0 1024 1024" width="22" height="22" class="social-svg">
                <path d="M690.1 377.4c5.9 0 11.8 0.2 17.6 0.5-32.3-104.7-143.4-182.5-273.7-182.5-149.9 0-272.1 100.6-272.1 224.9 0 71.8 40.3 130.9 108.8 176.7l-27.2 81.8 95-47.5c34 6.8 61.3 13.6 95.3 13.6 8.5 0 17-0.4 25.4-1.1-5.3-17.8-8.3-36.5-8.3-55.9-0.1-116.3 102-210.5 239.2-210.5zM512.5 282.6c27.2 0 40.8 13.6 40.8 27.2 0 13.6-13.6 27.2-40.8 27.2-27.2 0-54.4-13.6-54.4-27.2 0-13.6 27.2-27.2 54.4-27.2zM326.9 337c-27.2 0-54.4-13.6-54.4-27.2 0-13.6 27.2-27.2 54.4-27.2 27.2 0 40.8 13.6 40.8 27.2 0 13.6-13.6 27.2-40.8 27.2zM784.9 577.8c0-104.7-108.8-189.9-217.6-189.9-122.4 0-217.6 85.2-217.6 189.9 0 104.7 95.2 189.9 217.6 189.9 27.2 0 54.4-6.8 81.6-13.6l74.8 40.8-20.4-68c54.4-40.8 81.6-95.2 81.6-149.1zM485.3 537c-20.4 0-34-13.6-34-27.2 0-13.6 13.6-27.2 34-27.2 20.4 0 34 13.6 34 27.2 0 13.6-13.6 27.2-34 27.2zM680.5 537c-20.4 0-34-13.6-34-27.2 0-13.6 13.6-27.2 34-27.2 20.4 0 34 13.6 34 27.2 0 13.6-13.6 27.2-34 27.2z"/>
            </svg>
        </button>
        <button type="button" class="social-circle-btn" @onclick="@(() => BindExternalAccount("DingTalk"))" title="绑定钉钉">
            <svg viewBox="0 0 1024 1024" width="22" height="22" class="social-svg">
                <path d="M573.7 252.5C422.5 197.4 201.3 96.7 201.3 96.7c-15.7-4.1-17.9 11.1-17.9 11.1-5 61.1 33.6 160.5 53.6 182.8 19.9 22.3 319.1 113.7 319.1 113.7S326 357.9 270.5 341.9c-55.6-16-37.9 17.8-37.9 17.8 11.4 61.7 64.9 131.8 107.2 138.4 42.2 6.6 220.1 4 220.1 4s-35.5 4.1-93.2 11.9c-42.7 5.8-97 12.5-111.1 17.8-33.1 12.5 24 62.6 24 62.6 84.7 76.8 129.7 50.5 129.7 50.5 33.3-10.7 61.4-18.5 85.2-24.2L565 743.1h84.6L603 928l205.3-271.9H700.8l22.3-38.7c.3.5.4.8.4.8S799.8 496.1 829 433.8l.6-1h-.1c5-10.8 8.6-19.7 10-25.8 17-71.3-114.5-99.4-265.8-154.5z"/>
            </svg>
        </button>
    </div>

    <div class="auth-footer">
        已有账户？ <a href="/account/login">立即登录</a>
    </div>
</div>

@code {
    private RegisterRequestDto? registerModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";

    protected override void OnInitialized()
    {
        registerModel ??= new RegisterRequestDto();
    }

    private async Task HandleRegister()
    {
        if (registerModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            var result = (await AccountAppService.RegisterAsync(registerModel)).Data!;
            
            if (result.Success)
            {
                successMessage = "注册成功！正在跳转到登录页面...";
                errorMessage = "";
                
                await Task.Delay(500);
                Navigation.NavigateTo("/account/login");
            }
            else
            {
                errorMessage = result.Message;
                successMessage = "";
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"注册失败: {ex.Message}";
            successMessage = "";
        }
    }

    private async Task SendEmailCode()
    {
        errorMessage = "邮箱验证码功能暂未实现";
    }

    private async Task SendPhoneCode()
    {
        errorMessage = "手机验证码功能暂未实现";
    }

    private async Task BindExternalAccount(string provider)
    {
        errorMessage = $"绑定{provider}账号功能暂未实现";
    }
}
