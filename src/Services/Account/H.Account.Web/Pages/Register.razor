@page "/account/register"
@attribute [AllowAnonymous]

@layout AccountEmptyLayout
@inject IAccountAppService AccountAppService
@inject NavigationManager Navigation

<div class="auth-form">
    <h2 class="auth-title">注册 <span class="auth-title-en">/ REGISTER</span></h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <Alert Type="@AlertType.Success" Message="@successMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    <Form Model="@registerModel" OnFinish="@HandleRegister">
        <FormItem>
            <RadioGroup @bind-Value="@registerModel.RegisterType">
                <RadioButton Value="RegisterType.UserName">用户名</RadioButton>
                <RadioButton Value="RegisterType.Email">邮箱</RadioButton>
                <RadioButton Value="RegisterType.PhoneNumber">手机号</RadioButton>
            </RadioGroup>
        </FormItem>

        @if (registerModel.RegisterType == RegisterType.UserName)
        {
            <FormItem>
                <Input @bind-Value="@registerModel.UserName" Placeholder="请输入用户名" />
            </FormItem>
        }
        else if (registerModel.RegisterType == RegisterType.Email)
        {
            <FormItem>
                <Input @bind-Value="@registerModel.Email" Placeholder="请输入邮箱" />
            </FormItem>
            <FormItem>
                <Space>
                    <Input @bind-Value="@registerModel.EmailCode" Placeholder="请输入邮箱验证码" />
                    <Button OnClick="@SendEmailCode">发送验证码</Button>
                </Space>
            </FormItem>
        }
        else if (registerModel.RegisterType == RegisterType.PhoneNumber)
        {
            <FormItem>
                <Input @bind-Value="@registerModel.PhoneNumber" Placeholder="请输入手机号" />
            </FormItem>
            <FormItem>
                <Space>
                    <Input @bind-Value="@registerModel.PhoneCode" Placeholder="请输入手机验证码" />
                    <Button OnClick="@SendPhoneCode">发送验证码</Button>
                </Space>
            </FormItem>
        }

        <FormItem>
            <InputPassword @bind-Value="@registerModel.Password" Placeholder="请输入密码" />
        </FormItem>

        <FormItem>
            <InputPassword @bind-Value="@registerModel.ConfirmPassword" Placeholder="请再次输入密码" />
        </FormItem>

        <FormItem Style="margin-top: 24px; margin-bottom: 20px;">
            <Button Type="@ButtonType.Primary" HtmlType="submit" Block Class="auth-btn-primary">注 册</Button>
        </FormItem>
    </Form>

    <div class="auth-social-btns">
        <Button Shape="@ButtonShape.Circle" OnClick="@(() => BindExternalAccount("WeChat"))" Title="绑定微信">
            <Icon Type="wechat" />
        </Button>
        <Button Shape="@ButtonShape.Circle" OnClick="@(() => BindExternalAccount("DingTalk"))" Title="绑定钉钉">
            <Icon Type="dingding" />
        </Button>
    </div>

    <div class="auth-footer">
        已有账户？ <a href="/account/login">立即登录</a>
    </div>
</div>

@code {
    private RegisterRequestDto? registerModel { get; set; }
    private string errorMessage = "";
    private string successMessage = "";

    protected override void OnInitialized()
    {
        registerModel ??= new RegisterRequestDto();
    }

    private async Task HandleRegister()
    {
        if (registerModel == null)
        {
            errorMessage = "系统错误：表单数据未初始化";
            return;
        }
        
        try
        {
            var result = await AccountAppService.RegisterAsync(registerModel);
            
            if (result.Success)
            {
                successMessage = "注册成功！正在跳转到登录页面...";
                errorMessage = "";
                
                await Task.Delay(500);
                Navigation.NavigateTo("/account/login");
            }
            else
            {
                errorMessage = result.Message;
                successMessage = "";
            }
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            errorMessage = $"注册失败: {ex.Message}";
            successMessage = "";
        }
    }

    private async Task SendEmailCode()
    {
        // TODO: 实现邮箱验证码发送逻辑
        errorMessage = "邮箱验证码功能暂未实现";
    }

    private async Task SendPhoneCode()
    {
        // TODO: 实现手机验证码发送逻辑
        errorMessage = "手机验证码功能暂未实现";
    }

    private async Task BindExternalAccount(string provider)
    {
        // TODO: 实现第三方账号绑定逻辑
        errorMessage = $"绑定{provider}账号功能暂未实现";
    }
}
