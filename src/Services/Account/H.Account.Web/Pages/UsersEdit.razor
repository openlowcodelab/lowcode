@page "/account/users/{id:guid}/edit"

@layout AccountLayout
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>编辑用户</PageTitle>

<Card Title="编辑用户">
    <Spin Spinning="@isLoading">
        @if (user != null)
        {
            <Form Model="@updateUserDto" OnFinish="@HandleSubmit" LabelColSpan="4" WrapperColSpan="20">
                <div class="ant-row">
                    <div class="ant-col ant-col-12">
                        <FormItem Label="用户名" Required>
                            <Input @bind-Value="@updateUserDto.UserName" Placeholder="请输入用户名" />
                        </FormItem>
                    </div>
                    <div class="ant-col ant-col-12">
                        <FormItem Label="邮箱" Required>
                            <Input @bind-Value="@updateUserDto.Email" Placeholder="请输入邮箱" />
                        </FormItem>
                    </div>
                </div>

                <div class="ant-row">
                    <div class="ant-col ant-col-12">
                        <FormItem Label="手机号">
                            <Input @bind-Value="@updateUserDto.PhoneNumber" Placeholder="请输入手机号" />
                        </FormItem>
                    </div>
                    <div class="ant-col ant-col-12">
                        <FormItem Label="用户类型">
                            <Select TItem="UserType" TItemValue="UserType" @bind-Value="@updateUserDto.UserType" Placeholder="请选择用户类型">
                                <SelectOption Value="@UserType.Normal" Label="普通用户" />
                                <SelectOption Value="@UserType.Admin" Label="管理员" />
                                <SelectOption Value="@UserType.SuperAdmin" Label="超级管理员" />
                            </Select>
                        </FormItem>
                    </div>
                </div>

                <div class="ant-row">
                    <div class="ant-col ant-col-12">
                        <FormItem Label="角色">
                            <Input @bind-Value="@updateUserDto.Roles" Placeholder="逗号分隔多个角色" />
                        </FormItem>
                    </div>
                    <div class="ant-col ant-col-12">
                        <FormItem Label="账户激活">
                            <Switch @bind-Value="@updateUserDto.IsActive" />
                        </FormItem>
                    </div>
                </div>

                <div class="ant-row">
                    <div class="ant-col ant-col-8">
                        <FormItem Label="邮箱已验证">
                            <Switch @bind-Value="@updateUserDto.EmailConfirmed" />
                        </FormItem>
                    </div>
                    <div class="ant-col ant-col-8">
                        <FormItem Label="手机号已验证">
                            <Switch @bind-Value="@updateUserDto.PhoneNumberConfirmed" />
                        </FormItem>
                    </div>
                </div>

                <FormItem Label="备注">
                    <TextArea @bind-Value="@updateUserDto.Remark" Placeholder="请输入备注" Rows="3" />
                </FormItem>

                <FormItem WrapperColOffset="4">
                    <Space>
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary" HtmlType="submit" Loading="@isSubmitting">保存修改</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <a href="/account/users">
                                <Button>返回</Button>
                            </a>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary" Ghost OnClick="@ShowResetPassword">重置密码</Button>
                        </SpaceItem>
                    </Space>
                </FormItem>
            </Form>

            <Divider />

            <Descriptions Title="用户信息" Bordered>
                <DescriptionsItem Label="ID">@user.Id</DescriptionsItem>
                <DescriptionsItem Label="创建时间">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</DescriptionsItem>
                <DescriptionsItem Label="最后登录">@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "从未登录")</DescriptionsItem>
                <DescriptionsItem Label="更新时间">@(user.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "未更新")</DescriptionsItem>
            </Descriptions>
        }
        else if (!isLoading)
        {
            <Alert Type="@AlertType.Error" Message="用户不存在" />
        }
    </Spin>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-top: 16px;" />
    }
</Card>

<Modal Title="重置密码" Visible="@showResetPasswordModal" OnOk="@SubmitResetPassword" OnCancel="@CloseResetPassword">
    <Form Model="@resetPasswordDto" LabelColSpan="6" WrapperColSpan="18">
        <FormItem Label="新密码">
            <InputPassword @bind-Value="@resetPasswordDto.NewPassword" Placeholder="请输入新密码" />
        </FormItem>
        <FormItem Label="确认密码">
            <InputPassword @bind-Value="@resetPasswordDto.ConfirmPassword" Placeholder="请再次输入密码" />
        </FormItem>
    </Form>
    @if (!string.IsNullOrEmpty(resetPasswordError))
    {
        <Alert Type="@AlertType.Error" Message="@resetPasswordError" ShowIcon="true" />
    }
</Modal>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserDto? user;
    private UpdateUserDto updateUserDto = new();
    private ResetPasswordDto resetPasswordDto = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showResetPasswordModal = false;
    private string errorMessage = "";
    private string resetPasswordError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        try
        {
            user = await UserService.GetUserDtoByIdAsync(Id);
            if (user != null)
            {
                updateUserDto = new UpdateUserDto
                {
                    UserName = user.UserName,
                    Email = user.Email,
                    PhoneNumber = user.PhoneNumber,
                    UserType = user.UserType,
                    Roles = user.Roles,
                    IsActive = user.IsActive,
                    EmailConfirmed = user.EmailConfirmed,
                    PhoneNumberConfirmed = user.PhoneNumberConfirmed,
                    Remark = user.Remark
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载用户失败：{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = "";

        try
        {
            await UserService.UpdateUserAsync(Id, updateUserDto);
            Navigation.NavigateTo("/account/users");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"保存失败：{ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowResetPassword()
    {
        showResetPasswordModal = true;
        resetPasswordDto = new ResetPasswordDto();
        resetPasswordError = "";
    }

    private void CloseResetPassword(MouseEventArgs e)
    {
        showResetPasswordModal = false;
        resetPasswordError = "";
    }

    private async Task SubmitResetPassword(MouseEventArgs e)
    {
        try
        {
            await UserService.ResetPasswordAsync(Id, resetPasswordDto);
            showResetPasswordModal = false;
            _ = JS.InvokeVoidAsync("alert", "密码重置成功");
        }
        catch (ArgumentException ex)
        {
            resetPasswordError = ex.Message;
        }
        catch (Exception ex)
        {
            resetPasswordError = $"重置密码失败：{ex.Message}";
        }
    }
}
