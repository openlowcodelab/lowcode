@page "/admin/users/{id:guid}/edit"
@using Microsoft.AspNetCore.Components.Forms
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>编辑用户</PageTitle>

<h3>编辑用户</h3>

<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">加载中...</span>
                </div>
            </div>
        }
        else if (user != null)
        {
            <EditForm Model="@updateUserDto" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">用户名 <span class="text-danger">*</span></label>
                        <InputText @bind-value="updateUserDto.UserName" class="form-control" />
                        <ValidationMessage For="@(() => updateUserDto.UserName)" class="text-danger" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">邮箱 <span class="text-danger">*</span></label>
                        <InputText @bind-value="updateUserDto.Email" class="form-control" />
                        <ValidationMessage For="@(() => updateUserDto.Email)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">手机号</label>
                        <InputText @bind-value="updateUserDto.PhoneNumber" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">用户类型</label>
                        <InputSelect @bind-value="updateUserDto.UserType" class="form-select">
                            <option value="0">普通用户</option>
                            <option value="1">管理员</option>
                            <option value="2">超级管理员</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">角色</label>
                        <InputText @bind-value="updateUserDto.Roles" class="form-control" placeholder="逗号分隔多个角色" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="form-check mt-4">
                            <InputCheckbox @bind-value="updateUserDto.IsActive" class="form-check-input" />
                            <label class="form-check-label">账户激活</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="form-check">
                            <InputCheckbox @bind-value="updateUserDto.EmailConfirmed" class="form-check-input" />
                            <label class="form-check-label">邮箱已验证</label>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="form-check">
                            <InputCheckbox @bind-value="updateUserDto.PhoneNumberConfirmed" class="form-check-input" />
                            <label class="form-check-label">手机号已验证</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">备注</label>
                    <InputTextArea @bind-value="updateUserDto.Remark" class="form-control" rows="3" />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        保存修改
                    </button>
                    <a href="/admin/users" class="btn btn-secondary ms-2">返回</a>
                    <button type="button" class="btn btn-warning ms-2" @onclick="ShowResetPassword">重置密码</button>
                </div>
            </EditForm>

            <!-- 用户信息 -->
            <hr />
            <h5>用户信息</h5>
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@user.Id</dd>

                <dt class="col-sm-3">创建时间</dt>
                <dd class="col-sm-9">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                <dt class="col-sm-3">最后登录</dt>
                <dd class="col-sm-9">@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "从未登录")</dd>

                <dt class="col-sm-3">更新时间</dt>
                <dd class="col-sm-9">@(user.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "未更新")</dd>
            </dl>
        }
        else
        {
            <div class="alert alert-danger">用户不存在</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
    </div>
</div>

<!-- 重置密码模态框 -->
@if (showResetPasswordModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">重置密码</h5>
                    <button type="button" class="btn-close" @onclick="CloseResetPassword"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">新密码</label>
                        <InputText @bind-value="resetPasswordDto.NewPassword" type="password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">确认密码</label>
                        <InputText @bind-value="resetPasswordDto.ConfirmPassword" type="password" class="form-control" />
                    </div>
                    @if (!string.IsNullOrEmpty(resetPasswordError))
                    {
                        <div class="text-danger">@resetPasswordError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetPassword">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitResetPassword">确定</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserDto? user;
    private UpdateUserDto updateUserDto = new();
    private ResetPasswordDto resetPasswordDto = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showResetPasswordModal = false;
    private string errorMessage = "";
    private string resetPasswordError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        try
        {
            user = await UserService.GetUserDtoByIdAsync(Id);
            if (user != null)
            {
                updateUserDto = new UpdateUserDto
                {
                    UserName = user.UserName,
                    Email = user.Email,
                    PhoneNumber = user.PhoneNumber,
                    UserType = user.UserType,
                    Roles = user.Roles,
                    IsActive = user.IsActive,
                    EmailConfirmed = user.EmailConfirmed,
                    PhoneNumberConfirmed = user.PhoneNumberConfirmed,
                    Remark = user.Remark
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载用户失败：{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = "";

        try
        {
            await UserService.UpdateUserAsync(Id, updateUserDto);
            Navigation.NavigateTo("/admin/users");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"保存失败：{ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowResetPassword()
    {
        showResetPasswordModal = true;
        resetPasswordDto = new ResetPasswordDto();
        resetPasswordError = "";
    }

    private void CloseResetPassword()
    {
        showResetPasswordModal = false;
        resetPasswordError = "";
    }

    private async Task SubmitResetPassword()
    {
        try
        {
            await UserService.ResetPasswordAsync(Id, resetPasswordDto);
            showResetPasswordModal = false;
            Alert("密码重置成功");
        }
        catch (ArgumentException ex)
        {
            resetPasswordError = ex.Message;
        }
        catch (Exception ex)
        {
            resetPasswordError = $"重置密码失败：{ex.Message}";
        }
    }

    private void Alert(string message)
    {
        Console.WriteLine(message);
    }
}
