@namespace H.SystemPortal.Web

@inherits LayoutComponentBase

<DefaultLayoutComponent
    AppName="系统管理"
    AuthMode="AuthenticationMode.SystemRequired"
    LoginUrl="/system/login"
    MenuItems="@MenuItems">
    @Body
</DefaultLayoutComponent>

@code {
    private static List<AppMenuItem> MenuItems => new()
    {
        new AppMenuItem { Name = "首页", Url = "/system", Icon = "🏢" },
        new AppMenuItem { Name = "应用管理", Url = "/system/apps", Icon = "📦" },
        new AppMenuItem { Name = "用户管理", Url = "/account/users", Icon = "👥" },
        new AppMenuItem { Name = "企业管理", Url = "/enterprise", Icon = "🏢" }
    };
}
