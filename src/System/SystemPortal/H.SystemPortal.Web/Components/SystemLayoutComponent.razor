@namespace H.SystemPortal.Web

<style>
.layout-container { display: flex; flex-direction: column; height: 100vh; }
.menu-container { display: flex; flex: 1; }
.content-container { flex: 1; overflow-y: auto; background-color: #F2F3F5; padding: 20px; display: flex; flex-direction: column; }
.content-container > * { flex-shrink: 0; }
.content-container > .h-card,
.content-container > .card,
.content-container > .table-wrap,
.content-container > .h-table-wrapper,
.content-container > .page-fill { flex: 1 0 auto; }
.top-navbar { display: flex; justify-content: space-between; align-items: center; height: 60px; flex-shrink: 0; padding: 0 20px 0 5px; background-color: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); z-index: 100; }
.navbar-left { display: flex; align-items: center; gap: 15px; }
.navbar-left h3 { margin: 0; font-size: 18px; color: #1D2129; }
.navbar-logo { height: 32px; width: 32px; object-fit: contain; }
.navbar-right { display: flex; align-items: center; gap: 10px; }
.login-btn { padding: 6px 16px; background-color: #165DFF; color: white; border: none; border-radius: 4px; cursor: pointer; }
.user-dropdown { position: relative; cursor: pointer; }
.user-info { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 4px; }
.user-info:hover { background-color: #F2F3F5; }
.user-avatar { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; }
.dropdown-mask { position: fixed; inset: 0; z-index: 999; background: transparent; }
.dropdown-menu { position: absolute; top: 100%; right: 0; background: white; box-shadow: 0 6px 18px rgba(29,33,41,0.10); border: 1px solid #F2F3F5; border-radius: 8px; min-width: 160px; z-index: 1000; margin-top: 8px; padding: 4px; }
.dropdown-item { padding: 8px 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px; border-radius: 4px; transition: background 0.15s; }
.dropdown-item:hover { background-color: #F7F8FA; }
.menu-sidebar { width: 220px; background-color: #fff; border-right: 1px solid #E5E6EB; overflow-y: auto; padding: 5px 0 10px; }
.menu-list { list-style: none; margin: 0; padding: 0; }
.menu-item { display: flex; align-items: center; padding: 12px 20px; cursor: pointer; transition: all 0.3s; color: #1D2129; }
.menu-item:hover { background-color: #f0f7ff; color: #165DFF; }
.menu-item.active { background-color: #E8F3FF; color: #165DFF; border-right: 3px solid #165DFF; }
.menu-icon { margin-right: 10px; font-size: 18px; width: 20px; text-align: center; }
.menu-text { font-size: 14px; flex: 1; }
</style>

<div class="layout-container">
    <div class="top-navbar">
        <div class="navbar-left">
            @if (!string.IsNullOrEmpty(Logo))
            {
                <a href="/" target="_self">
                    <img class="navbar-logo" src="@Logo" alt="logo" />
                </a>
            }
            <h3>@AppName</h3>
        </div>
        <div class="navbar-right">
            @if (_isLoggedIn)
            {
                <div class="user-dropdown" @onclick:stopPropagation="true">
                    <div class="user-info" @onclick="ToggleDropdown">
                        <div class="user-avatar" style="background-color: #165DFF; display: flex; align-items: center; justify-content: center;">
                            <svg viewBox="0 0 100 100" style="width: 100%; height: 100%;">
                                <circle fill="#fff" cx="50" cy="35" r="20"/>
                                <path fill="#fff" d="M50 60 Q20 60 20 85 L80 85 Q80 60 50 60"/>
                            </svg>
                        </div>
                        <span style="color: #4E5969; font-size: 14px;">@_userName</span>
                    </div>
                    @if (_showDropdown)
                    {
                        <div class="dropdown-mask" @onclick="() => _showDropdown = false"></div>
                        <div class="dropdown-menu">
                            <div class="dropdown-item" @onclick="HandleLogout">
                                <span>🚪</span> 退出登录
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <button class="login-btn" @onclick="HandleLogin">
                    <span>登录</span>
                </button>
            }
        </div>
    </div>

    <div class="menu-container">
        @if (MenuItems != null && MenuItems.Any())
        {
            <div class="menu-sidebar">
                <ul class="menu-list">
                    @foreach (var item in MenuItems)
                    {
                        var isActive = !string.IsNullOrEmpty(item.Url) && IsMatch(item.Url);
                        <li class="menu-item @(isActive ? "active" : "")"
                            @onclick="() => NavigateTo(item.Url)">
                            <span class="menu-icon">@(string.IsNullOrEmpty(item.Icon) ? "📄" : item.Icon)</span>
                            <span class="menu-text">@item.Name</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="content-container">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string AppName { get; set; } = "系统管理";

    [Parameter]
    public string Logo { get; set; } = "/favicon.png";

    [Parameter]
    public List<AppMenuItem>? MenuItems { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IServiceProvider ServiceProvider { get; set; } = default!;
    [Inject] private HttpClient HttpClient { get; set; } = default!;

    public string LoginUrl { get; set; } = "/system/login";

    private bool _isLoggedIn;
    private bool _authChecked;
    private string _userName = "用户";
    private bool _showDropdown;

    protected override void OnInitialized()
    {
        // 检查 SystemCookies Cookie 是否存在（服务端预渲染时的乐观判断）
        var httpContext = ServiceProvider.GetService<IHttpContextAccessor>()?.HttpContext;
        if (httpContext?.Request.Cookies.ContainsKey(".AspNetCore.SystemCookies") == true)
        {
            _isLoggedIn = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _authChecked)
            return;

        // WASM 环境：通过 API 精确验证认证状态
        var result = await CheckAuthViaApiAsync();
        _isLoggedIn = result.authenticated && result.isSystemUser;
        if (!string.IsNullOrEmpty(result.userName))
        {
            _userName = result.userName;
        }

        _authChecked = true;

        // 仅 WASM 环境下才执行重定向（避免 SSR 时误跳转）
        if (!_isLoggedIn)
        {
            var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
            NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}");
        }

        StateHasChanged();
    }

    private async Task<(bool authenticated, string? userName, bool isSystemUser)> CheckAuthViaApiAsync()
    {
        try
        {
            // 系统用户应调用 systemaccount 的 current-user 端点
            var response = await HttpClient.GetAsync("/api/app/system-account/current-user");
            if (!response.IsSuccessStatusCode)
                return (false, null, false);

            var content = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(content) || content == "null")
                return (false, null, false);

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            var root = doc.RootElement;

            if (root.ValueKind == System.Text.Json.JsonValueKind.Null)
                return (false, null, false);

            var isSystemUser = root.TryGetProperty("loginMode", out var lmProp)
                && lmProp.GetString() == "System";

            if (root.TryGetProperty("isAuthenticated", out var authProp))
            {
                if (authProp.ValueKind == System.Text.Json.JsonValueKind.False)
                    return (false, null, false);
                var userName = root.TryGetProperty("userName", out var nameProp)
                    ? nameProp.GetString()
                    : null;
                return (true, userName, isSystemUser);
            }

            var abpUserName = root.TryGetProperty("userName", out var abpNameProp)
                ? abpNameProp.GetString()
                : null;
            if (!string.IsNullOrEmpty(abpUserName))
                return (true, abpUserName, isSystemUser);

            return (false, null, false);
        }
        catch
        {
            return (false, null, false);
        }
    }

    private void ToggleDropdown()
    {
        _showDropdown = !_showDropdown;
    }

    private void HandleLogin()
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
        NavigationManager.NavigateTo($"{LoginUrl}?returnUrl={returnUrl}");
    }

    private void HandleLogout()
    {
        _showDropdown = false;
        NavigationManager.NavigateTo("/system/logout", forceLoad: true);
    }

    private void NavigateTo(string? url)
    {
        if (!string.IsNullOrEmpty(url))
            NavigationManager.NavigateTo(url);
    }

    private bool IsMatch(string menuUrl)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var qIndex = currentPath.IndexOf('?');
        if (qIndex >= 0) currentPath = currentPath[..qIndex];
        currentPath = currentPath.Trim('/');
        menuUrl = menuUrl.Trim('/');

        if (string.IsNullOrEmpty(menuUrl)) return false;
        if (currentPath.Equals(menuUrl, StringComparison.OrdinalIgnoreCase)) return true;

        // 对于 /system 这种根路径菜单，仅在精确匹配时高亮
        if (menuUrl.Split('/').Length == 1) return false;

        return currentPath.StartsWith(menuUrl + "/", StringComparison.OrdinalIgnoreCase);
    }
}
