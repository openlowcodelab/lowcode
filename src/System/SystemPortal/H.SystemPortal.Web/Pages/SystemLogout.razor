@page "/system/logout"
@attribute [AllowAnonymous]

@inject HttpClient HttpClient
@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await HttpClient.PostAsync("/api/app/system-account/system-logout", null);
        }
        catch
        {
            // 忽略退出登录错误
        }

        // 跳转到系统登录页
        Navigation.NavigateTo("/system/login", forceLoad: true);
    }
}
