@page "/system/users"

@layout SystemPortalLayout
@inject IUserAppService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject H.Util.Blazor.HToastService Toast

<PageTitle>用户管理</PageTitle>

<HCard Title="用户管理">
    <div class="h-toolbar">
        <input type="text" @bind-value="@searchKeyword" placeholder="搜索用户名、邮箱、手机号" class="h-input" style="width: 200px;"
               @onkeyup="@HandleSearchKeyUp" />
        <select @bind="@searchUserType" class="h-select" style="width: 120px;">
            <option value="">用户类型</option>
            <option value="@UserType.Normal">普通用户</option>
            <option value="@UserType.Admin">管理员</option>
            <option value="@UserType.SuperAdmin">超级管理员</option>
        </select>
        <select @bind="@searchIsActive" class="h-select" style="width: 120px;">
            <option value="">状态</option>
            <option value="true">激活</option>
            <option value="false">禁用</option>
        </select>
        <button class="h-btn h-btn-primary" @onclick="@LoadUsers">搜索</button>
        <a href="/system/users/create" class="h-btn h-btn-primary" style="text-decoration:none;">新增</a>
    </div>

    <HTable Loading="@isLoading" ShowEmpty="@(!users.Items.Any() && !isLoading)">
        <thead>
            <tr>
                <th>用户名</th>
                <th>邮箱</th>
                <th>手机号</th>
                <th>第三方账号</th>
                <th>用户类型</th>
                <th>状态</th>
                <th>最后登录</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var context in users.Items)
            {
                <tr>
                    <td>@context.UserName</td>
                    <td>@context.Email</td>
                    <td>@context.PhoneNumber</td>
                    <td>
                        @if (context.ExternalAccounts.Any())
                        {
                            <span class="h-space">
                                @foreach (var account in context.ExternalAccounts)
                                {
                                    <span class="h-tooltip" title="@account.Provider">
                                        @GetProviderIcon(account.Provider)
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span style="color: #86909C;">未绑定</span>
                        }
                    </td>
                    <td>
                        <span class="h-tag h-tag-@GetUserTypeColor(context.UserType)">@GetUserTypeText(context.UserType)</span>
                    </td>
                    <td>
                        @if (context.IsActive)
                        {
                            <span class="h-tag h-tag-green">激活</span>
                        }
                        else
                        {
                            <span class="h-tag h-tag-red">禁用</span>
                        }
                    </td>
                    <td>@(context.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        <span class="row-actions">
                            <a @onclick="@(() => ViewUser(context.Id))">查看</a>
                            <a href="/system/users/@context.Id/edit">编辑</a>
                            <a class="danger" @onclick="@(() => ConfirmDelete(context.Id))">删除</a>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </HTable>

    @if (users.Items.Any())
    {
        <div class="h-pagination">
            <button class="h-btn h-btn-sm" disabled="@(users.PageIndex <= 1)" @onclick="@(() => GoToPage(users.PageIndex - 1))">上一页</button>
            <span class="h-pagination-info">第 @users.PageIndex 页 / 共 @((users.Total + users.PageSize - 1) / users.PageSize) 页 (共 @users.Total 条)</span>
            <button class="h-btn h-btn-sm" disabled="@((users.PageIndex * users.PageSize) >= users.Total)" @onclick="@(() => GoToPage(users.PageIndex + 1))">下一页</button>
        </div>
    }
</HCard>

@code {
    private Application.Contracts.PagedResult<UserDto> users = new() { PageIndex = 1, PageSize = 10 };
    private bool isLoading = false;
    private string searchKeyword = "";
    private UserType? searchUserType = null;
    private bool? searchIsActive = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            var queryParams = new UserQueryParams
            {
                PageIndex = users.PageIndex,
                PageSize = users.PageSize
            };

            if (!string.IsNullOrWhiteSpace(searchKeyword))
                queryParams.Keyword = searchKeyword;
            if (searchUserType.HasValue)
                queryParams.UserType = searchUserType.Value;
            if (searchIsActive.HasValue)
                queryParams.IsActive = searchIsActive.Value;

            var result = (await UserService.GetPagedUsersAsync(queryParams)).Data;
            if (result != null)
            {
                users = result;
            }
        }
        catch
        {
            
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            users.PageIndex = 1;
            await LoadUsers();
        }
    }

    private async Task GoToPage(int page)
    {
        users.PageIndex = page;
        await LoadUsers();
    }

    private async Task ConfirmDelete(Guid userId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "确定要删除该用户吗？");
        if (confirmed)
        {
            await DeleteUser(userId);
        }
    }

    private async Task DeleteUser(Guid userId)
    {
        try
        {
            await UserService.DeleteUserAsync(userId);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Toast.Error($"删除失败：{ex.Message}");
        }
    }

    private string GetUserTypeColor(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "blue",
            UserType.SuperAdmin => "red",
            _ => "default"
        };
    }

    private string GetUserTypeText(UserType userType)
    {
        return userType switch
        {
            UserType.Admin => "管理员",
            UserType.SuperAdmin => "超级管理员",
            _ => "普通用户"
        };
    }

    private void ViewUser(Guid userId)
    {
        Navigation.NavigateTo($"/system/users/{userId}/detail");
    }

    private string GetProviderIcon(string provider)
    {
        return provider.ToLower() switch
        {
            "wechat" => "\U0001F4AC",
            "dingtalk" => "\U0001F4E7",
            _ => "\U0001F517"
        };
    }
}
