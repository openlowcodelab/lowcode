@namespace H.Enterprise.Web

@inherits LayoutComponentBase

<DefaultLayoutComponent
    AppName="企业管理" 
    AuthMode="AuthenticationMode.EnterpriseRequired"
    LoginUrl="/system/login"
    MenuItems="@MenuItems">
    @Body
</DefaultLayoutComponent>

@code {
    private static List<AppMenuItem> MenuItems => new()
    {
        new AppMenuItem { Name = "企业列表", Url = "/enterprise", Icon = "🏭" },
        new AppMenuItem { Name = "创建企业", Url = "/enterprise/create", Icon = "➕" }
    };
}
