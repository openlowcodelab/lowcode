@namespace H.Workbench.Web
@* 运行看板：原独立页面与左栏菜单，现作为「员工管理」页的一个 Tab 渲染 *@
@inject ITaskAppService TaskAppService
@inject NavigationManager Navigation

<div class="st-board">
    <div class="st-head">
        <span class="st-head-title">执行概况</span>
        <div class="st-range">
            @foreach (var d in RangeOptions)
            {
                <span class="st-chip @(days == d ? "st-chip-active" : "")" @onclick="() => LoadAsync(d)">近 @d 天</span>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="st-empty">加载中…</div>
    }
    else if (_s is null)
    {
        <div class="st-empty">暂无数据</div>
    }
    else
    {
        <div class="st-cards">
            <div class="st-card">
                <div class="st-num">@_s.TotalRuns</div>
                <div class="st-label">执行次数</div>
            </div>
            <div class="st-card">
                <div class="st-num">@_s.SuccessRate%</div>
                <div class="st-label">成功率（成功+失败为分母）</div>
            </div>
            <div class="st-card">
                <div class="st-num">@(_s.PromptTokens + _s.CompletionTokens)</div>
                <div class="st-label">token 消耗（入 @(_s.PromptTokens) / 出 @(_s.CompletionTokens)）</div>
            </div>
            <div class="st-card">
                <div class="st-num">@_s.AvgDurationSeconds s</div>
                <div class="st-label">平均耗时</div>
            </div>
        </div>

        <div class="st-verdict">
            <span class="st-v st-v-pass">验收通过 @_s.VerdictPass</span>
            <span class="st-v st-v-fail">验收未通过 @_s.VerdictFail</span>
            <span class="st-v st-v-unclear">证据不足 @_s.VerdictUnclear</span>
            <span class="st-v st-v-none">未设验收标准 @_s.UnverifiedRuns</span>
        </div>
        <div class="st-note">
            「未设验收标准」的那些执行，成败只是员工自己的说法；它们不计入可信完成量。
        </div>

        <div class="st-two">
            <div class="st-block">
                <div class="st-block-title">按员工</div>
                <table class="st-table">
                    <thead>
                    <tr><th>员工</th><th>次数</th><th>失败</th><th>验收未过</th><th>token</th><th>均耗时</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var a in _s.ByAgent)
                    {
                        <tr>
                            <td>@(string.IsNullOrEmpty(a.AgentType) ? "未分配" : a.AgentType)</td>
                            <td>@a.Runs</td>
                            <td>@a.Failed</td>
                            <td>@a.VerdictFail</td>
                            <td>@a.Tokens</td>
                            <td>@a.AvgDurationSeconds s</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="st-block">
                <div class="st-block-title">token 消耗 Top 任务</div>
                <table class="st-table">
                    <thead>
                    <tr><th>任务</th><th>次数</th><th>失败</th><th>token</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var t in _s.TopTasks)
                    {
                        <tr>
                            <td class="st-name" title="@t.TaskName">@Short(t.TaskName)</td>
                            <td>@t.Runs</td>
                            <td>@t.Failed</td>
                            <td>@t.Tokens</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="st-pending">
            待你处理：
            <a @onclick='() => Navigation.NavigateTo("/workbench/settings?section=approvals")' @onclick:preventDefault>
                @_s.PendingApprovals 条待裁决审批
            </a>
            、
            @_s.PendingArtifactReviews 条待验收产物
        </div>
    }
</div>

@code {
    private static readonly int[] RangeOptions = [7, 30, 90];

    private int days = 7;
    private bool _loading = true;
    private RuntimeStatsDto? _s;

    protected override async Task OnInitializedAsync() => await LoadAsync(days);

    private async Task LoadAsync(int range)
    {
        days = range;
        _loading = true;
        try
        {
            var res = await TaskAppService.GetRuntimeStatsAsync(range);
            _s = res.Data;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Short(string text) => text.Length > 28 ? text[..28] + "…" : text;
}

<style>
    .st-board { max-width: 960px; }
    .st-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .st-head-title { font-size: 14px; font-weight: 500; color: #262626; }
    .st-range { display: flex; gap: 8px; }
    .st-chip { padding: 3px 10px; border-radius: 12px; background: #f2f3f5; color: #595959; font-size: 12px; cursor: pointer; }
    .st-chip-active { background: #1f6feb; color: #fff; }
    .st-empty { color: #8c8c8c; padding: 20px 0; }
    .st-cards { display: flex; gap: 12px; flex-wrap: wrap; margin: 14px 0; }
    .st-card { flex: 1 1 170px; border: 1px solid #e8e8e8; border-radius: 8px; padding: 14px 16px; background: #fff; }
    .st-num { font-size: 24px; font-weight: 600; }
    .st-label { color: #8c8c8c; font-size: 12px; margin-top: 4px; }
    .st-verdict { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
    .st-v { font-size: 12px; padding: 3px 10px; border-radius: 10px; }
    .st-v-pass { background: #f6ffed; color: #389e0d; }
    .st-v-fail { background: #fff1f0; color: #cf1322; }
    .st-v-unclear { background: #fff7e6; color: #d46b08; }
    .st-v-none { background: #f2f3f5; color: #595959; }
    .st-note { color: #8c8c8c; font-size: 12px; margin-bottom: 14px; }
    .st-two { display: flex; gap: 16px; flex-wrap: wrap; }
    .st-block { flex: 1 1 380px; }
    .st-block-title { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    .st-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .st-table th, .st-table td { border-bottom: 1px solid #f0f0f0; padding: 6px 8px; text-align: left; }
    .st-table th { color: #8c8c8c; font-weight: 500; }
    .st-name { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .st-pending { margin-top: 16px; color: #595959; font-size: 13px; }
    .st-pending a { color: #1f6feb; cursor: pointer; }
</style>
