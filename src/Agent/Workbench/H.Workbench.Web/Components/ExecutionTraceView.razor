@namespace H.Workbench.Web
@* 执行步骤时间线：回放（GetLogTraceAsync 懒加载）与流式实时（对话页构造同构 DTO）共用 *@
<div class="wb-steps">
    <div class="wb-steps-head" @onclick="ToggleOpenAsync">
        <span class="wb-steps-caret">@(_open ? "▾" : "▸")</span>
        <span>执行过程（@_items.Count 步@(_totalMs > 0 ? $" · 工具耗时 {FormatMs(_totalMs)}" : "")）</span>
    </div>

    @if (_open)
    {
        <div class="wb-steps-body">
            @if (_loading)
            {
                <div class="wb-steps-loading">加载执行轨迹…</div>
            }
            @foreach (var item in _items)
            {
                <div class="wb-step wb-step-@item.State @(item.Kind == "Step" ? "wb-step-group" : "")">
                    <div class="wb-step-row @(item.Indent ? "wb-step-child" : "")" @onclick="() => ToggleExpand(item)">
                        <span class="wb-step-icon">@Icon(item.Kind)</span>
                        <span class="wb-step-name">@DisplayName(item)</span>
                        @if (item.StateText is not null)
                        {
                            <span class="wb-step-badge">@item.StateText</span>
                        }
                        @if (item.DurationMs is > 0)
                        {
                            <span class="wb-step-dur">@FormatMs(item.DurationMs.Value)</span>
                        }
                        @if (item.HasDetail)
                        {
                            <span class="wb-step-expand">@(_expanded.Contains(item) ? "收起 ▲" : "详情 ▼")</span>
                        }
                    </div>
                    @if (_expanded.Contains(item))
                    {
                        @if (!string.IsNullOrEmpty(item.Arguments))
                        {
                            <pre class="wb-step-pre wb-step-args">参数：@item.Arguments</pre>
                        }
                        @if (!string.IsNullOrEmpty(item.Detail))
                        {
                            <pre class="wb-step-pre">@(item.Kind == "Tool" ? $"结果：{item.Detail}" : item.Detail)</pre>
                        }
                        @if (item.Truncated)
                        {
                            <div class="wb-step-trunc">内容过长，已截断</div>
                        }
                    }
                </div>
            }
            @if (!_loading && _items.Count == 0)
            {
                <div class="wb-steps-loading">无步骤记录</div>
            }
        </div>
    }
</div>

@code {
    /// <summary>回放数据（流式实时由对话页持续更新）</summary>
    [Parameter] public List<ExecutionStepDto> Steps { get; set; } = [];

    /// <summary>提供时在首次展开处按需拉取完整轨迹（含产物）；为 null 表示直接用 Steps</summary>
    [Parameter] public Func<Task<TaskLogTraceDto?>>? Loader { get; set; }

    /// <summary>Steps 已由外部加载完成（无需 Loader）</summary>
    [Parameter] public bool TraceLoaded { get; set; }

    /// <summary>Loader 拉到的产物列表（父页面可在此组件外复用渲染）</summary>
    [Parameter] public List<ArtifactDto>? LoadedArtifacts { get; set; }

    /// <summary>Answer 与气泡正文重复，默认不展示</summary>
    [Parameter] public bool ShowAnswer { get; set; }

    /// <summary>外部已决定展开（如弹窗中点"查看步骤"）</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    private class StepItem
    {
        public string Kind { get; set; } = "Tool";
        public string? ToolName { get; set; }
        public int Iteration { get; set; }
        public string? Arguments { get; set; }
        public string? Detail { get; set; }
        public int? DurationMs { get; set; }
        public bool Truncated { get; set; }
        /// <summary>ok | error | running | pending | approved | denied | timeout</summary>
        public string State { get; set; } = "ok";
        public string? StateText { get; set; }
        /// <summary>工作流步骤内的子行缩进</summary>
        public bool Indent { get; set; }
        public bool HasDetail => !string.IsNullOrEmpty(Arguments) || !string.IsNullOrEmpty(Detail);
    }

    private bool _open;
    private bool _loading;
    private bool _loaded;
    private List<StepItem> _items = [];
    private readonly List<StepItem> _expanded = [];
    private long _totalMs;

    protected override void OnParametersSet()
    {
        if (DefaultOpen && !_open)
        {
            _open = true;
        }

        // 懒加载模式下未展开前不构建；实时模式（无 Loader）或数据已备好（TraceLoaded）时每次重算
        if (Loader is null || TraceLoaded || _loaded)
        {
            Rebuild(Steps);
        }
    }

    private async Task ToggleOpenAsync()
    {
        _open = !_open;
        if (_open && Loader is not null && !_loaded && !TraceLoaded)
        {
            _loading = true;
            try
            {
                var trace = await Loader();
                Steps.Clear();
                if (trace?.Steps is not null)
                {
                    Steps.AddRange(trace.Steps);
                }
                LoadedArtifacts?.Clear();
                LoadedArtifacts?.AddRange(trace?.Artifacts ?? []);
                _loaded = true;
                Rebuild(Steps);
            }
            finally
            {
                _loading = false;
            }
        }
    }

    private void Rebuild(List<ExecutionStepDto> steps)
    {
        var items = new List<StepItem>();
        var pending = new List<(ExecutionStepDto Call, StepItem Item)>();
        long totalMs = 0;
        var inWorkflow = false;

        foreach (var s in steps.OrderBy(x => x.StepIndex).ThenBy(x => x.Iteration).ThenBy(x => x.Seq))
        {
            switch (s.Kind)
            {
                case "Step":
                    // 工作流步骤头部行（其后的子行缩进）
                    inWorkflow = true;
                    items.Add(new StepItem
                    {
                        Kind = "Step",
                        ToolName = s.ToolName,
                        Iteration = s.Iteration,
                        State = s.Content == "执行中" ? "running" : s.IsError ? "error" : "ok",
                        StateText = Short(s.Content)
                    });
                    continue;
                case "Thinking":
                    items.Add(new StepItem { Kind = "Thinking", Iteration = s.Iteration, Detail = s.Content, Truncated = s.Truncated });
                    break;
                case "ToolCall":
                {
                    var item = new StepItem { Kind = "Tool", ToolName = s.ToolName, Iteration = s.Iteration, Arguments = s.Arguments, State = "running", StateText = "执行中" };
                    items.Add(item);
                    pending.Add((s, item));
                    break;
                }
                case "ToolResult":
                {
                    // 服务端流式 chunk 的 toolCallId 可能为空，回退"同名最早未配对"
                    var idx = pending.FindIndex(p =>
                        (!string.IsNullOrEmpty(s.ToolCallId) && p.Call.ToolCallId == s.ToolCallId) ||
                        (string.IsNullOrEmpty(s.ToolCallId) && p.Call.ToolName == s.ToolName));
                    StepItem item;
                    if (idx >= 0)
                    {
                        var (call, existing) = pending[idx];
                        pending.RemoveAt(idx);
                        item = existing;
                        item.Arguments ??= call.Arguments;
                    }
                    else
                    {
                        item = new StepItem { Kind = "Tool", ToolName = s.ToolName, Iteration = s.Iteration };
                        items.Add(item);
                    }

                    item.ToolName = s.ToolName ?? item.ToolName;
                    item.Detail = s.Result;
                    item.DurationMs = s.DurationMs;
                    item.Truncated = s.Truncated;
                    item.State = s.IsError ? "error" : "ok";
                    item.StateText = s.IsError ? "出错" : "成功";
                    totalMs += s.DurationMs ?? 0;
                    break;
                }
                case "Approval":
                    items.Add(new StepItem
                    {
                        Kind = "Approval",
                        ToolName = s.ToolName,
                        Iteration = s.Iteration,
                        Arguments = s.Arguments,
                        DurationMs = s.WaitMs,
                        State = s.ApprovalState?.ToLowerInvariant() ?? "pending",
                        StateText = ApprovalText(s.ApprovalState)
                    });
                    break;
                case "Answer" when ShowAnswer:
                    items.Add(new StepItem { Kind = "Answer", Iteration = s.Iteration, Detail = s.Content, Truncated = s.Truncated });
                    break;
                case "Verify":
                    items.Add(new StepItem
                    {
                        Kind = "Verify",
                        ToolName = s.ToolName,
                        Iteration = s.Iteration,
                        Detail = s.Content,
                        State = s.IsError ? "error" : "ok",
                        StateText = VerdictText(s.ToolName)
                    });
                    break;
                case "Error":
                    items.Add(new StepItem { Kind = "Error", Iteration = s.Iteration, Detail = s.Content, State = "error", StateText = s.IsError ? "失败" : null });
                    break;
            }
        }

        // 工作流步骤内的子行统一缩进
        if (inWorkflow)
        {
            var seenStep = false;
            foreach (var it in items)
            {
                if (it.Kind == "Step") { seenStep = true; continue; }
                if (seenStep) it.Indent = true;
            }
        }

        _items = items;
        _totalMs = totalMs;
        _expanded.RemoveAll(e => !items.Contains(e));
    }

    private static string Short(string? text) =>
        string.IsNullOrEmpty(text) ? text! : text.Length <= 60 ? text : text[..60] + "…";

    private void ToggleExpand(StepItem item)
    {
        if (!item.HasDetail) return;
        if (!_expanded.Remove(item))
        {
            _expanded.Add(item);
        }
    }

    private static string DisplayName(StepItem item) => item.Kind switch
    {
        "Step" => item.ToolName ?? "步骤",
        "Thinking" => $"思考（第 {item.Iteration} 轮）",
        "Answer" => "回答",
        "Error" => "错误",
        "Approval" => $"审批：{item.ToolName}",
        "Verify" => "验收裁决",
        _ => item.ToolName ?? "工具"
    };

    private static string Icon(string kind) => kind switch
    {
        "Step" => "🧩",
        "Thinking" => "💭",
        "Answer" => "✉️",
        "Error" => "⚠️",
        "Approval" => "🔐",
        "Verify" => "🧪",
        _ => "🔧"
    };

    private static string? VerdictText(string? verdict) => verdict switch
    {
        "Pass" => "通过",
        "Fail" => "未通过",
        "Unclear" => "证据不足",
        _ => verdict
    };

    private static string? ApprovalText(string? state) => state switch
    {
        "Pending" => "待审批",
        "Approved" => "已批准",
        "Denied" => "已拒绝",
        "Timeout" => "审批超时",
        "SkippedNonInteractive" => "自动跳过",
        _ => null
    };

    private static string FormatMs(long ms) => ms >= 1000 ? $"{ms / 1000.0:0.#}s" : $"{ms}ms";
}

<style>
    .wb-steps {
        margin-top: 8px;
        width: 100%;
        border: 1px solid #f0f0f0;
        border-radius: 8px;
        background: #fafbfc;
        font-size: 12px;
    }

    .wb-steps-head {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        cursor: pointer;
        color: #595959;
        user-select: none;
    }

    .wb-steps-head:hover {
        color: #262626;
    }

    .wb-steps-caret {
        color: #bfbfbf;
        width: 10px;
    }

    .wb-steps-body {
        border-top: 1px solid #f0f0f0;
        padding: 4px 0;
    }

    .wb-step-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 12px;
        cursor: pointer;
    }

    .wb-step-row:hover {
        background: #f0f2f5;
    }

    .wb-step-group {
        border-top: 1px dashed #f0f0f0;
        margin-top: 2px;
    }

    .wb-step-group .wb-step-name {
        font-weight: 600;
        color: #165DFF;
    }

    .wb-step-child {
        padding-left: 28px;
    }

    .wb-step-icon {
        width: 16px;
        text-align: center;
    }

    .wb-step-name {
        color: #262626;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .wb-step-badge {
        flex-shrink: 0;
        padding: 0 6px;
        border-radius: 4px;
        background: #f0f0f0;
        color: #8c8c8c;
        font-size: 11px;
    }

    .wb-step-error .wb-step-badge {
        background: #fff2f0;
        color: #ff4d4f;
    }

    .wb-step-running .wb-step-badge {
        background: #e6f4ff;
        color: #165DFF;
    }

    .wb-step-approved .wb-step-badge {
        background: #f6ffed;
        color: #52c41a;
    }

    .wb-step-dur {
        margin-left: auto;
        color: #bfbfbf;
        flex-shrink: 0;
    }

    .wb-step-expand {
        color: #8c8c8c;
        flex-shrink: 0;
        font-size: 11px;
    }

    .wb-step-pre {
        margin: 0 12px 6px;
        padding: 8px 10px;
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
        max-height: 220px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
        color: #595959;
        font-size: 12px;
        font-family: Consolas, Menlo, monospace;
    }

    .wb-step-args {
        color: #8c8c8c;
    }

    .wb-step-trunc {
        padding: 0 12px 6px;
        color: #faad14;
    }

    .wb-steps-loading {
        padding: 8px 12px;
        color: #bfbfbf;
    }
</style>
