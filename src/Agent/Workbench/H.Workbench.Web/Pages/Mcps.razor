@page "/workbench/mcps"

@layout WorkbenchLayout
@inject IMcpServerAppService McpServerAppService

<PageTitle>MCP 管理 - AI 工作台</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">
        @toastMessage
    </div>
}

<div class="settings-container">
    <div class="settings-content">
        <div class="content-header">
            <h2>MCP 管理</h2>
            <button class="btn btn-primary workbench-btn-primary btn-small" @onclick="ShowAddServer">
                @IconSvg("plus") 添加
            </button>
        </div>
        <div class="agent-list">
            @if (loadingServers)
            {
                <div class="loading-spinner"><div class="spinner"></div><span>加载中...</span></div>
            }
            else if (servers.Any())
            {
                @foreach (var server in servers)
                {
                    <div class="model-card">
                        <div class="model-card-header">
                            <div class="model-name">
                                <strong>@server.DisplayName</strong>
                                <span class="tag tag-blue">@server.TransportType</span>
                                @if (server.IsEnabled)
                                {
                                    <span class="tag tag-green">已启用</span>
                                }
                                else
                                {
                                    <span class="tag tag-default">已禁用</span>
                                }
                            </div>
                            <div class="model-actions">
                                <button class="btn btn-link btn-small" @onclick="@(() => ToggleServer(server))">
                                    @(server.IsEnabled ? "禁用" : "启用")
                                </button>
                                <button class="btn btn-link btn-small" @onclick="@(() => EditServer(server))">编辑</button>
                                <button class="btn btn-link btn-small btn-danger" @onclick="@(() => DeleteServer(server.Id))">删除</button>
                            </div>
                        </div>
                        <div class="model-card-body">
                            <div class="model-info-row">
                                <span class="info-label">名称:</span>
                                <span>@server.Name</span>
                            </div>
                            <div class="model-info-row">
                                <span class="info-label">端点:</span>
                                <span>@server.Endpoint</span>
                            </div>
                            <div class="model-info-row">
                                <span class="info-label">超时:</span>
                                <span>@server.TimeoutSeconds 秒</span>
                                @if (!string.IsNullOrEmpty(server.AuthToken))
                                {
                                    <span class="info-label" style="margin-left:16px;">Token:</span>
                                    <span>@MaskToken(server.AuthToken)</span>
                                }
                                @if (!string.IsNullOrEmpty(server.ApiKey))
                                {
                                    <span class="info-label" style="margin-left:16px;">API Key:</span>
                                    <span>@MaskToken(server.ApiKey)</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">@IconSvg("inbox")</div>
                    <div class="empty-text">暂无 MCP 服务配置，点击添加按钮新增</div>
                </div>
            }
        </div>

        @if (showServerDialog)
        {
            <div class="modal-overlay" @onclick="CloseServerDialog">
                <div class="modal-dialog agent-dialog" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(isEditing ? "编辑 MCP 服务" : "添加 MCP 服务")</h3>
                        <button class="btn btn-text modal-close-btn" @onclick="CloseServerDialog">
                            @IconSvg("close")
                        </button>
                    </div>
                    <div class="modal-body">
                        @if (!isEditing)
                        {
                            <div class="form-item required">
                                <label>* 名称</label>
                                <input class="modal-input" @bind="@editServer.Name" placeholder="英文标识，如 yunxiao" />
                            </div>
                        }
                        <div class="form-item required">
                            <label>* 显示名称</label>
                            <input class="modal-input" @bind="@editServer.DisplayName" placeholder="如：云效项目管理" />
                        </div>
                        <div class="form-item required">
                            <label>* 端点 URL</label>
                            <input class="modal-input" @bind="@editServer.Endpoint" placeholder="如：http://localhost:8080/mcp" />
                        </div>
                        <div class="form-item required">
                            <label>* 传输方式</label>
                            <select class="modal-select" @bind="@editServer.TransportType">
                                <option value="SSE">SSE (Server-Sent Events)</option>
                                <option value="HTTP">HTTP (Streamable HTTP)</option>
                                <option value="Stdio">Stdio (标准输入输出)</option>
                            </select>
                        </div>
                        <div class="form-item">
                            <label>Token</label>
                            <input class="modal-input" @bind="@editServer.AuthToken" placeholder="Bearer Token（可选）" />
                        </div>
                        <div class="form-item">
                            <label>API Key</label>
                            <input class="modal-input" @bind="@editServer.ApiKey" placeholder="API Key（可选）" />
                        </div>
                        <div class="form-item">
                            <label>自定义请求头 (JSON)</label>
                            <textarea class="modal-input modal-textarea" @bind="@editServer.Headers" placeholder='可选，如 {"X-Custom": "value"}'></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-item">
                                <label>超时（秒）</label>
                                <input class="modal-input" type="number" @bind="@editServer.TimeoutSeconds" min="1" max="300" />
                            </div>
                        </div>
                        <div class="form-item">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="@editServer.IsEnabled" />
                                启用
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="modal-btn-cancel" @onclick="CloseServerDialog">取消</button>
                        <button class="modal-btn-primary" @onclick="SaveServer" disabled="@savingServer">
                            @(isEditing ? "保存" : "添加")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool loadingServers;
    private bool savingServer;
    private bool showServerDialog;
    private bool isEditing;
    private List<McpServerDto> servers = new();

    private McpEditModel editServer = new();

    private string toastMessage = string.Empty;
    private string toastType = "info";
    private bool toastVisible;

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadServers();
    }

    private async Task LoadServers()
    {
        loadingServers = true;
        try { servers = (await McpServerAppService.GetAllAsync()).Data ?? []; }
        catch (Exception ex) { ShowToast("加载 MCP 服务列表失败: " + ex.Message, "error"); }
        finally { loadingServers = false; }
    }

    private void ShowAddServer()
    {
        isEditing = false;
        editServer = new McpEditModel
        {
            Name = "",
            DisplayName = "",
            Endpoint = "",
            TransportType = "SSE",
            AuthToken = "",
            ApiKey = "",
            Headers = "",
            TimeoutSeconds = 30,
            IsEnabled = true
        };
        showServerDialog = true;
    }

    private void EditServer(McpServerDto server)
    {
        isEditing = true;
        editServer = new McpEditModel
        {
            Id = server.Id,
            Name = server.Name,
            DisplayName = server.DisplayName,
            Endpoint = server.Endpoint,
            TransportType = server.TransportType,
            AuthToken = server.AuthToken ?? "",
            ApiKey = server.ApiKey ?? "",
            Headers = server.Headers ?? "",
            TimeoutSeconds = server.TimeoutSeconds,
            IsEnabled = server.IsEnabled
        };
        showServerDialog = true;
    }

    private void CloseServerDialog() { showServerDialog = false; }

    private async Task SaveServer()
    {
        if (string.IsNullOrWhiteSpace(editServer.Name)) { ShowToast("请输入名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editServer.DisplayName)) { ShowToast("请输入显示名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editServer.Endpoint)) { ShowToast("请输入端点 URL", "warning"); return; }

        savingServer = true;
        try
        {
            if (isEditing && editServer.Id.HasValue)
            {
                await McpServerAppService.UpdateAsync(editServer.Id.Value, new UpdateMcpServerDto
                {
                    DisplayName = editServer.DisplayName,
                    Endpoint = editServer.Endpoint,
                    TransportType = editServer.TransportType,
                    AuthToken = string.IsNullOrWhiteSpace(editServer.AuthToken) ? null : editServer.AuthToken,
                    ApiKey = string.IsNullOrWhiteSpace(editServer.ApiKey) ? null : editServer.ApiKey,
                    Headers = string.IsNullOrWhiteSpace(editServer.Headers) ? null : editServer.Headers,
                    TimeoutSeconds = editServer.TimeoutSeconds,
                    IsEnabled = editServer.IsEnabled
                });
                ShowToast("MCP 服务已更新", "success");
            }
            else
            {
                await McpServerAppService.CreateAsync(new CreateMcpServerDto
                {
                    Name = editServer.Name.Trim(),
                    DisplayName = editServer.DisplayName,
                    Endpoint = editServer.Endpoint,
                    TransportType = editServer.TransportType,
                    AuthToken = string.IsNullOrWhiteSpace(editServer.AuthToken) ? null : editServer.AuthToken,
                    ApiKey = string.IsNullOrWhiteSpace(editServer.ApiKey) ? null : editServer.ApiKey,
                    Headers = string.IsNullOrWhiteSpace(editServer.Headers) ? null : editServer.Headers,
                    TimeoutSeconds = editServer.TimeoutSeconds,
                    IsEnabled = editServer.IsEnabled
                });
                ShowToast("MCP 服务已添加", "success");
            }
            showServerDialog = false;
            await LoadServers();
        }
        catch (Exception ex) { ShowToast("保存失败: " + ex.Message, "error"); }
        finally { savingServer = false; }
    }

    private async Task ToggleServer(McpServerDto server)
    {
        try
        {
            await McpServerAppService.ToggleEnabledAsync(server.Id, !server.IsEnabled);
            ShowToast(server.IsEnabled ? "MCP 服务已禁用" : "MCP 服务已启用", "success");
            await LoadServers();
        }
        catch (Exception ex) { ShowToast("操作失败: " + ex.Message, "error"); }
    }

    private async Task DeleteServer(Guid id)
    {
        try
        {
            await McpServerAppService.DeleteAsync(id);
            ShowToast("已删除", "success");
            await LoadServers();
        }
        catch (Exception ex) { ShowToast("删除失败: " + ex.Message, "error"); }
    }

    private string MaskToken(string token)
    {
        if (string.IsNullOrEmpty(token)) return "(未设置)";
        if (token.Length <= 8) return "****";
        return token[..4] + "****" + token[^4..];
    }

    private class McpEditModel
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Endpoint { get; set; } = "";
        public string TransportType { get; set; } = "SSE";
        public string AuthToken { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public string Headers { get; set; } = "";
        public int TimeoutSeconds { get; set; } = 30;
        public bool IsEnabled { get; set; } = true;
    }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);

    private static string GetIconSvg(string name) => name switch
    {
        "plus" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg>",
        "close" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>",
        "inbox" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"></polyline><path d=\"M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path></svg>",
        _ => ""
    };
}

<style>
    /* ========== MCP 管理页 ========== */
    .settings-container {
        display: flex;
        height: 100%;
        width: 100%;
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
        box-sizing: border-box;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .content-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .agent-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .model-card {
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        overflow: hidden;
    }

    .model-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        border-bottom: 1px solid #e8e8e8;
    }

    .model-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .model-actions {
        display: flex;
        gap: 4px;
    }

    .model-card-body {
        padding: 12px 16px;
    }

    .tag {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
        line-height: 1.5;
    }

    .tag-green {
        background: #f6ffed;
        color: #52c41a;
        border: 1px solid #b7eb8f;
    }

    .tag-blue {
        background: #e6f7ff;
        color: #1890ff;
        border: 1px solid #91d5ff;
    }

    .tag-default {
        background: #fafafa;
        color: #595959;
        border: 1px solid #d9d9d9;
    }

    .agent-dialog {
        width: 600px;
        max-width: 90vw;
    }

    .modal-textarea {
        min-height: 60px;
        resize: vertical;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 12px;
    }

    .modal-select {
        width: 100%;
        height: 36px;
        padding: 4px 11px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        font-size: 14px;
        color: #262626;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
        cursor: pointer;
        appearance: auto;
    }

    .modal-select:focus {
        border-color: #a6a6a6;
        box-shadow: 0 0 0 2px rgba(166, 166, 166, 0.1);
    }
</style>
