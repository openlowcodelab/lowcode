@page "/workbench/employees/{Id:guid}/settings"

@layout WorkbenchLayout
@inject IAgentAppService AgentAppService
@inject ISkillAppService SkillAppService
@inject IConnectorAppService ConnectorAppService
@inject IKnowledgeBaseAppService KnowledgeBaseAppService
@inject IWorkbenchProjectAppService ProjectAppService
@inject ITaskAppService TaskAppService
@inject NavigationManager Navigation

<PageTitle>员工设置 - AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">@toastMessage</div>
}

@if (_agent is null)
{
    <div class="es-page"><div class="empty-state"><div class="empty-text">加载中...</div></div></div>
}
else
{
    <div class="es-page">
        <!-- ========== 二级导航 ========== -->
        <div class="es-nav">
            <div class="es-back" @onclick='() => Navigation.NavigateTo("/workbench/employees")'>← 返回</div>
            @foreach (var section in Sections)
            {
                <div class="es-nav-item @(_section == section.Key ? "es-nav-active" : "")"
                     @onclick="() => SwitchSection(section.Key)">@section.Value</div>
            }
        </div>

        <!-- ========== 内容区 ========== -->
        <div class="es-content">
            @if (_section == "overview")
            {
                <h2 class="es-title">概览</h2>
                <div style="max-width:640px;">
                    <div class="form-row">
                        <div class="form-item required">
                            <label>* 名称</label>
                            <input class="modal-input" @bind="_editName" />
                        </div>
                        <div class="form-item">
                            <label>角色</label>
                            <input class="modal-input" @bind="_editRole" />
                        </div>
                    </div>
                    <div class="form-item">
                        <label>描述</label>
                        <textarea class="modal-input modal-textarea" @bind="_editDescription"></textarea>
                    </div>
                    <div class="form-item">
                        <label>系统提示词</label>
                        <textarea class="modal-input modal-textarea" @bind="_editPrompt" style="min-height:140px;"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-item">
                            <label>温度 (0-1)</label>
                            <input class="modal-input" type="number" step="0.1" min="0" max="1" @bind="_editTemperature" />
                        </div>
                        <div class="form-item">
                            <label>MaxTokens</label>
                            <input class="modal-input" type="number" @bind="_editMaxTokens" />
                        </div>
                    </div>
                    <div class="form-item">
                        <label class="checkbox-label"><input type="checkbox" @bind="_editStreaming" /> 支持流式响应</label>
                    </div>
                    <div class="form-item">
                        <label class="checkbox-label"><input type="checkbox" @bind="_editEnabled" /> 启用</label>
                    </div>
                    <button class="btn btn-primary workbench-btn-primary btn-small" disabled="@_saving" @onclick="SaveOverviewAsync">保存</button>
                </div>
            }
            else if (_section == "tasks")
            {
                <h2 class="es-title">任务</h2>
                <div class="rs-rows">
                    @foreach (var task in _tasks)
                    {
                        <div class="rs-row">
                            <div class="rs-row-info">
                                <div class="rs-row-name">@task.TaskName
                                    <span class="em-role">@(task.TaskType == "manual" ? "对话任务" : "自动任务")</span>
                                    <span class="wb-task-status wb-status-@task.Status.ToLower()">@task.Status</span>
                                </div>
                                <div class="rs-row-desc">@task.ScheduleDisplayText · 最近运行 @(task.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "暂无")</div>
                            </div>
                            <button class="btn btn-link btn-small" @onclick="() => ExecuteTaskAsync(task)">立即执行</button>
                            <button class="btn btn-link btn-small btn-danger" @onclick="() => DeleteTaskAsync(task)">删除</button>
                        </div>
                    }
                    @if (!_tasks.Any())
                    {
                        <div class="empty-state"><div class="empty-text">暂无任务</div></div>
                    }
                </div>
            }
            else if (_section == "skills")
            {
                <h2 class="es-title">Skill</h2>
                <div class="rs-rows">
                    @foreach (var skill in _skills)
                    {
                        <div class="rs-row">
                            <div class="rs-row-info">
                                <div class="rs-row-name">@skill.DisplayName <span class="em-role">@skill.SkillType</span></div>
                                <div class="rs-row-desc">@skill.Description</div>
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_agent.SkillIdList.Contains(skill.Id)"
                                       @onchange='e => ToggleBindingAsync("skill", skill.Id, e)' />
                            </label>
                        </div>
                    }
                    @if (!_skills.Any())
                    {
                        <div class="empty-state"><div class="empty-text">暂无技能</div></div>
                    }
                </div>
            }
            else if (_section == "connectors")
            {
                <h2 class="es-title">连接器</h2>
                <div class="rs-rows">
                    @foreach (var connector in _connectors.Where(x => x.IsEnabled))
                    {
                        <div class="rs-row">
                            <span class="rs-row-icon">@connector.Icon</span>
                            <div class="rs-row-info">
                                <div class="rs-row-name">@connector.ConnectorName</div>
                                <div class="rs-row-desc">@connector.Description</div>
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_agent.ConnectorIds.Contains(connector.Id)"
                                       @onchange='e => ToggleBindingAsync("connector", connector.Id, e)' />
                            </label>
                        </div>
                    }
                    @if (!_connectors.Any(x => x.IsEnabled))
                    {
                        <div class="empty-state"><div class="empty-text">暂无已启用的连接器，请到 能力与资源 启用</div></div>
                    }
                </div>
            }
            else if (_section == "knowledge")
            {
                <h2 class="es-title">知识库</h2>
                <div class="rs-rows">
                    @foreach (var kb in _knowledgeBases)
                    {
                        <div class="rs-row">
                            <div class="rs-row-info">
                                <div class="rs-row-name">@kb.Name</div>
                                <div class="rs-row-desc">@kb.Description</div>
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_agent.KnowledgeBaseIds.Contains(kb.Id)"
                                       @onchange='e => ToggleBindingAsync("knowledge", kb.Id, e)' />
                            </label>
                        </div>
                    }
                    @if (!_knowledgeBases.Any())
                    {
                        <div class="empty-state"><div class="empty-text">暂无知识库</div></div>
                    }
                </div>
            }
            else
            {
                <h2 class="es-title">项目</h2>
                <div class="rs-rows">
                    @foreach (var project in _projects)
                    {
                        <div class="rs-row">
                            <div class="rs-row-info">
                                <div class="rs-row-name">@project.ProjectName</div>
                                <div class="rs-row-desc">@project.Description</div>
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_agent.ProjectIds.Contains(project.Id)"
                                       @onchange='e => ToggleBindingAsync("project", project.Id, e)' />
                            </label>
                        </div>
                    }
                    @if (!_projects.Any())
                    {
                        <div class="empty-state"><div class="empty-text">暂无项目，请到 项目 页新建</div></div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public WorkbenchState State { get; set; } = default!;

    private static readonly (string Key, string Value)[] Sections =
    [
        ("overview", "概览"),
        ("tasks", "任务"),
        ("skills", "Skill"),
        ("connectors", "连接器"),
        ("knowledge", "知识库"),
        ("projects", "项目")
    ];

    private string _section = "overview";

    private AgentDto? _agent;
    private List<TaskDto> _tasks = [];
    private List<SkillDto> _skills = [];
    private List<ConnectorDto> _connectors = [];
    private List<KnowledgeBaseDto> _knowledgeBases = [];
    private List<WorkbenchProjectDto> _projects = [];

    private string _editName = "";
    private string _editRole = "";
    private string _editDescription = "";
    private string _editPrompt = "";
    private float _editTemperature;
    private int _editMaxTokens;
    private bool _editStreaming;
    private bool _editEnabled;

    private bool _saving;

    private string toastMessage = "";
    private string toastType = "info";
    private bool toastVisible;

    protected override async Task OnInitializedAsync() => await LoadAgentAsync();

    private async Task LoadAgentAsync()
    {
        try
        {
            _agent = (await AgentAppService.GetAsync(Id)).Data;
            if (_agent is not null)
            {
                _editName = _agent.DisplayName;
                _editRole = _agent.Role;
                _editDescription = _agent.Description;
                _editPrompt = _agent.SystemPrompt;
                _editTemperature = _agent.Temperature;
                _editMaxTokens = _agent.MaxTokens;
                _editStreaming = _agent.SupportsStreaming;
                _editEnabled = _agent.IsEnabled;
            }
        }
        catch (Exception ex)
        {
            ShowToast($"加载员工失败: {ex.Message}", "error");
        }

        await LoadSectionAsync();
    }

    private async Task SwitchSection(string section)
    {
        _section = section;
        await LoadSectionAsync();
    }

    private async Task LoadSectionAsync()
    {
        try
        {
            switch (_section)
            {
                case "tasks":
                    _tasks = (await TaskAppService.GetListAsync(new TaskQueryDto
                    {
                        AgentType = _agent?.AgentType,
                        MaxResultCount = 100
                    })).Data?.Items.ToList() ?? [];
                    break;
                case "skills":
                    _skills = (await SkillAppService.GetListAsync(new SkillDefinitionQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
                    break;
                case "connectors":
                    _connectors = (await ConnectorAppService.GetListAsync(new ConnectorQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
                    break;
                case "knowledge":
                    _knowledgeBases = (await KnowledgeBaseAppService.GetListAsync()).Data ?? [];
                    break;
                case "projects":
                    _projects = (await ProjectAppService.GetListAsync(new WorkbenchProjectQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
                    break;
            }
        }
        catch (Exception ex)
        {
            ShowToast($"加载失败: {ex.Message}", "error");
        }
    }

    private UpdateAgentDto BuildUpdateDto() => new()
    {
        DisplayName = _editName.Trim(),
        Role = _editRole.Trim(),
        Description = _editDescription.Trim(),
        SystemPrompt = _editPrompt,
        Temperature = _editTemperature,
        MaxTokens = _editMaxTokens,
        SupportsStreaming = _editStreaming,
        IsEnabled = _editEnabled,
        DefaultModelConfigId = _agent?.DefaultModelConfigId,
        Metadata = _agent?.Metadata,
        SkillIds = _agent?.SkillIdList ?? [],
        ConnectorIds = _agent?.ConnectorIds ?? [],
        KnowledgeBaseIds = _agent?.KnowledgeBaseIds ?? [],
        ProjectIds = _agent?.ProjectIds ?? []
    };

    private async Task SaveOverviewAsync()
    {
        if (_agent is null) return;
        if (string.IsNullOrWhiteSpace(_editName))
        {
            ShowToast("请输入名称", "warning");
            return;
        }

        _saving = true;
        try
        {
            _agent = (await AgentAppService.UpdateAsync(_agent.Id, BuildUpdateDto())).Data ?? _agent;
            State.SetAgents((await AgentAppService.GetListAsync(new AgentQueryDto { MaxResultCount = 100 })).Data?.Items ?? []);
            ShowToast("已保存", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"保存失败: {ex.Message}", "error");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleBindingAsync(string kind, Guid id, ChangeEventArgs e)
    {
        if (_agent is null) return;
        var checkedValue = (bool)(e.Value ?? false);

        var skillIds = new List<Guid>(_agent.SkillIdList);
        var connectorIds = new List<Guid>(_agent.ConnectorIds);
        var knowledgeIds = new List<Guid>(_agent.KnowledgeBaseIds);
        var projectIds = new List<Guid>(_agent.ProjectIds);

        switch (kind)
        {
            case "skill":
                if (checkedValue) { if (!skillIds.Contains(id)) skillIds.Add(id); } else skillIds.Remove(id);
                break;
            case "connector":
                if (checkedValue) { if (!connectorIds.Contains(id)) connectorIds.Add(id); } else connectorIds.Remove(id);
                break;
            case "knowledge":
                if (checkedValue) { if (!knowledgeIds.Contains(id)) knowledgeIds.Add(id); } else knowledgeIds.Remove(id);
                break;
            case "project":
                if (checkedValue) { if (!projectIds.Contains(id)) projectIds.Add(id); } else projectIds.Remove(id);
                break;
        }

        var dto = BuildUpdateDto();
        dto.SkillIds = skillIds;
        dto.ConnectorIds = connectorIds;
        dto.KnowledgeBaseIds = knowledgeIds;
        dto.ProjectIds = projectIds;

        try
        {
            _agent = (await AgentAppService.UpdateAsync(_agent.Id, dto)).Data ?? _agent;
            ShowToast("绑定已更新", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"更新失败: {ex.Message}", "error");
            await LoadSectionAsync();
        }
    }

    private async Task ExecuteTaskAsync(TaskDto task)
    {
        try
        {
            await TaskAppService.ExecuteNowAsync(task.Id);
            ShowToast("已触发执行", "success");
            await LoadSectionAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"执行失败: {ex.Message}", "error");
        }
    }

    private async Task DeleteTaskAsync(TaskDto task)
    {
        try
        {
            await TaskAppService.DeleteAsync(task.Id);
            ShowToast("任务已删除", "success");
            await LoadSectionAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}

<style>
    .es-page {
        display: flex;
        height: 100%;
        min-height: 0;
        background: #fff;
    }

    .es-nav {
        width: 200px;
        flex-shrink: 0;
        border-right: 1px solid #f0f0f0;
        padding: 16px 10px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow-y: auto;
    }

    .es-back {
        font-size: 14px;
        color: #262626;
        padding: 8px 10px;
        cursor: pointer;
        border-radius: 6px;
        margin-bottom: 8px;
    }

    .es-back:hover {
        background: #f5f5f5;
    }

    .es-nav-item {
        padding: 9px 12px;
        border-radius: 6px;
        font-size: 14px;
        color: #595959;
        cursor: pointer;
        user-select: none;
    }

    .es-nav-item:hover {
        background: #f7f8fa;
        color: #262626;
    }

    .es-nav-active,
    .es-nav-active:hover {
        background: #f0f0f0;
        color: #262626;
        font-weight: 500;
    }

    .es-content {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        padding: 24px;
    }

    .es-title {
        margin: 0 0 20px;
        font-size: 20px;
    }
</style>
