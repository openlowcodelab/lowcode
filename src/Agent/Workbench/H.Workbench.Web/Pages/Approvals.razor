@page "/workbench/approvals"

@layout WorkbenchLayout
@inject ITaskAppService TaskAppService
@inject IApprovalRuleAppService ApprovalRuleAppService
@inject NavigationManager Navigation

<PageTitle>审批中心 - AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div class="toast-notification toast-@_toastType @(_toastVisible ? "toast-show" : "")">@_toastMessage</div>
}

<div class="settings-container">
    <div class="settings-content">
        <div class="content-header">
            <h2>审批中心</h2>
        </div>

        <div class="ap-tabs">
            <div class="ap-tab @(_tab == "queue" ? "ap-tab-active" : "")" @onclick='() => SwitchTab("queue")'>待裁决队列</div>
            <div class="ap-tab @(_tab == "rules" ? "ap-tab-active" : "")" @onclick='() => SwitchTab("rules")'>审批规则</div>
        </div>

        @if (_tab == "queue")
        {
            <div class="ap-filter">
                @foreach (var opt in StateOptions)
                {
                    <span class="ap-chip @(_state == opt.Value ? "ap-chip-active" : "")"
                          @onclick='() => LoadQueueAsync(opt.Value)'>@opt.Text</span>
                }
            </div>

            @if (_loading)
            {
                <div class="ap-empty">加载中…</div>
            }
            else if (_queue.Count == 0)
            {
                <div class="ap-empty">没有该状态的审批记录</div>
            }
            else
            {
                @foreach (var item in _queue)
                {
                    <div class="ap-card">
                        <div class="ap-head">
                            <span class="ap-tool">🔐 @(item.ToolName ?? "未知工具")</span>
                            <span class="ap-state ap-state-@item.ApprovalState.ToLowerInvariant()">@StateText(item.ApprovalState)</span>
                        </div>
                        <div class="ap-meta">
                            任务：@item.TaskName ｜ 员工：@AgentName(item.AgentType) ｜ 技能：@(item.SkillName ?? "-") ｜ @item.StartedAt.ToString("MM-dd HH:mm:ss")
                            @if (item.WaitMs is > 0)
                            {
                                <span> ｜ 等待 {(int)(item.WaitMs.Value / 1000)}s</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Arguments))
                        {
                            <pre class="ap-args">@(item.Arguments!.Length > 400 ? item.Arguments[..400] + "…" : item.Arguments)</pre>
                        }
                        @if (item.Live && item.ApprovalId is not null)
                        {
                            <div class="ap-actions">
                                <button class="modal-btn-cancel" disabled="@item.Busy" @onclick="() => DecideAsync(item, false)">拒绝</button>
                                <button class="modal-btn-primary" disabled="@item.Busy" @onclick="() => DecideAsync(item, true)">批准</button>
                            </div>
                        }
                        else
                        {
                            <div class="ap-dead">所属执行已结束（@(item.LogStatus)），该请求已无法回传裁决</div>
                        }
                    </div>
                }
            }
        }
        else
        {
            <div class="ap-note">
                判定顺序：本次运行预授权 &gt; 下方规则（按优先级取首条命中） &gt; 技能级「需人工审批」。
                规则未命中时不会放行，只会回落到技能级。
            </div>

            @foreach (var rule in _rules)
            {
                <div class="ap-card">
                    <div class="ap-head">
                        <span class="ap-tool">@rule.Name</span>
                        <span class="ap-state ap-state-@rule.Effect.ToLowerInvariant()">@EffectText(rule.Effect)</span>
                    </div>
                    <div class="ap-meta">
                        工具：@rule.ToolPattern ｜ 参数正则：@(string.IsNullOrEmpty(rule.ArgPattern) ? "不限" : rule.ArgPattern)
                        ｜ 员工：@(string.IsNullOrEmpty(rule.AgentType) ? "全部" : AgentName(rule.AgentType)) ｜ 优先级 @rule.Priority
                    </div>
                    <div class="ap-actions">
                        <button class="modal-btn-cancel" @onclick="() => DeleteRuleAsync(rule.Id)">删除</button>
                    </div>
                </div>
            }

            <div class="ap-form">
                <input class="modal-input" @bind="_ruleName" placeholder="规则名，如：推送到 main 需批准" />
                <input class="modal-input" @bind="_ruleToolPattern" placeholder="工具匹配：精确名或 Git*" />
                <input class="modal-input" @bind="_ruleArgPattern" placeholder="参数正则（可选）" />
                <select class="modal-select" @bind="_ruleEffect">
                    <option value="Require">需人工批准</option>
                    <option value="Auto">直接放行</option>
                    <option value="Deny">直接拒绝</option>
                </select>
                <input class="modal-input ap-priority" type="number" @bind="_rulePriority" />
                <button class="modal-btn-primary" disabled="@_saving" @onclick="AddRuleAsync">新增规则</button>
            </div>
        }
    </div>
</div>

@code {
    private record StateOption(string Value, string Text);

    private static readonly StateOption[] StateOptions =
    [
        new("Pending", "待裁决"),
        new("Approved", "已批准"),
        new("Denied", "已拒绝"),
        new("Timeout", "已超时"),
        new("Orphaned", "已失效")
    ];

    private string _tab = "queue";
    private string _state = "Pending";
    private bool _loading;
    private bool _saving;

    private readonly List<QueueRow> _queue = [];
    private List<ApprovalRuleDto> _rules = [];

    private string _ruleName = "";
    private string _ruleToolPattern = "";
    private string _ruleArgPattern = "";
    private string _ruleEffect = "Require";
    private int _rulePriority = 10;

    private string? _toastMessage;
    private string _toastType = "success";
    private bool _toastVisible;

    private sealed class QueueRow : ApprovalQueueItemDto
    {
        public bool Busy { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync("Pending");
        _rules = (await ApprovalRuleAppService.GetListAsync())?.Data ?? [];
    }

    private void SwitchTab(string tab)
    {
        _tab = tab;
        if (tab == "rules")
        {
            _ = LoadRulesAsync();
        }
    }

    private async Task LoadRulesAsync()
    {
        var res = await ApprovalRuleAppService.GetListAsync();
        _rules = res.Data ?? [];
    }

    private async Task LoadQueueAsync(string state)
    {
        _state = state;
        _loading = true;
        try
        {
            var res = await TaskAppService.GetApprovalQueueAsync(state, 100);
            _queue.Clear();
            foreach (var item in res.Data ?? [])
            {
                _queue.Add(new QueueRow
                {
                    Id = item.Id,
                    ApprovalId = item.ApprovalId,
                    TaskLogId = item.TaskLogId,
                    TaskId = item.TaskId,
                    TaskName = item.TaskName,
                    AgentType = item.AgentType,
                    ToolName = item.ToolName,
                    SkillName = item.SkillName,
                    Arguments = item.Arguments,
                    ApprovalState = item.ApprovalState,
                    LogStatus = item.LogStatus,
                    Live = item.Live,
                    StartedAt = item.StartedAt,
                    ApproverId = item.ApproverId,
                    WaitMs = item.WaitMs
                });
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideAsync(QueueRow row, bool approved)
    {
        if (row.ApprovalId is null || row.Busy) return;

        row.Busy = true;
        var res = await TaskAppService.ResumeApprovalAsync(new ResumeApprovalInputDto
        {
            ApprovalId = row.ApprovalId.Value,
            Approved = approved
        });
        row.Busy = false;

        ShowToast(res.Success ? (approved ? "已批准，执行继续" : "已拒绝") : res.Message ?? "审批已失效",
            res.Success ? "success" : "warning");
        await LoadQueueAsync(_state);
    }

    private async Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_ruleName) || string.IsNullOrWhiteSpace(_ruleToolPattern))
        {
            ShowToast("规则名与工具匹配不能为空", "warning");
            return;
        }

        _saving = true;
        var res = await ApprovalRuleAppService.CreateAsync(new CreateApprovalRuleDto
        {
            Name = _ruleName.Trim(),
            ToolPattern = _ruleToolPattern.Trim(),
            ArgPattern = string.IsNullOrWhiteSpace(_ruleArgPattern) ? null : _ruleArgPattern.Trim(),
            Effect = _ruleEffect,
            Priority = _rulePriority,
            IsEnabled = true
        });
        _saving = false;

        if (res.Success)
        {
            _ruleName = _ruleToolPattern = _ruleArgPattern = "";
            _rulePriority = 10;
            ShowToast("规则已新增", "success");
            await LoadRulesAsync();
        }
        else
        {
            ShowToast(res.Message ?? "规则保存失败", "error");
        }
    }

    private async Task DeleteRuleAsync(Guid id)
    {
        await ApprovalRuleAppService.DeleteAsync(id);
        await LoadRulesAsync();
        ShowToast("规则已删除", "success");
    }

    private static string StateText(string state) => state switch
    {
        "Pending" => "待裁决",
        "Approved" => "已批准",
        "Denied" => "已拒绝",
        "Timeout" => "已超时",
        "SkippedNonInteractive" => "自动跳过",
        "Orphaned" => "已失效",
        _ => state
    };

    private static string EffectText(string effect) => effect switch
    {
        "Require" => "需批准",
        "Auto" => "放行",
        "Deny" => "拒绝",
        _ => effect
    };

    private string AgentName(string? agentType) =>
        string.IsNullOrWhiteSpace(agentType) ? "-" : agentType;

    private void ShowToast(string message, string type)
    {
        _toastMessage = message;
        _toastType = type;
        _toastVisible = true;
        InvokeAsync(async () =>
        {
            await Task.Delay(2600);
            _toastVisible = false;
            StateHasChanged();
        });
    }
}

<style>
    .ap-tabs { display: flex; gap: 4px; border-bottom: 1px solid #e8e8e8; margin-bottom: 4px; }
    .ap-tab { padding: 8px 14px; font-size: 13px; color: #595959; cursor: pointer; border-bottom: 2px solid transparent; }
    .ap-tab-active { color: #1f6feb; border-bottom-color: #1f6feb; font-weight: 600; }
    .ap-filter { display: flex; gap: 8px; margin: 12px 0; }
    .ap-chip { padding: 4px 12px; border-radius: 12px; background: #f2f3f5; color: #595959; font-size: 13px; cursor: pointer; }
    .ap-chip-active { background: #1f6feb; color: #fff; }
    .ap-empty, .ap-note { color: #8c8c8c; font-size: 13px; padding: 16px 0; }
    .ap-note { background: #f7f8fa; border-radius: 6px; padding: 10px 12px; margin: 12px 0; }
    .ap-card { border: 1px solid #e8e8e8; border-radius: 6px; padding: 12px; margin-bottom: 10px; background: #fff; }
    .ap-head { display: flex; justify-content: space-between; align-items: center; }
    .ap-tool { font-weight: 600; font-size: 14px; }
    .ap-state { font-size: 12px; padding: 2px 8px; border-radius: 10px; background: #f2f3f5; color: #595959; }
    .ap-state-pending { background: #fff7e6; color: #d46b08; }
    .ap-state-approved { background: #f6ffed; color: #389e0d; }
    .ap-state-denied, .ap-state-timeout, .ap-state-orphaned { background: #fff1f0; color: #cf1322; }
    .ap-state-require { background: #fff7e6; color: #d46b08; }
    .ap-state-auto { background: #f6ffed; color: #389e0d; }
    .ap-state-deny { background: #fff1f0; color: #cf1322; }
    .ap-meta { color: #8c8c8c; font-size: 12px; margin-top: 6px; }
    .ap-args { margin: 8px 0 0; padding: 8px; background: #f7f8fa; border-radius: 4px; font-size: 12px; white-space: pre-wrap; word-break: break-all; }
    .ap-actions { display: flex; gap: 8px; margin-top: 10px; }
    .ap-dead { color: #bfbfbf; font-size: 12px; margin-top: 8px; }
    .ap-form { display: flex; gap: 8px; align-items: center; margin-top: 14px; flex-wrap: wrap; }
    .ap-form .modal-input { flex: 1 1 160px; }
    .ap-priority { max-width: 90px; }
</style>
