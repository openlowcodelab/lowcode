@page "/workbench/conversations"

@layout WorkbenchLayout
@implements IDisposable
@using System.Text
@using H.Abp.HttpClientProxy
@using H.Workbench.Web.Services
@inject ITaskAppService TaskAppService
@inject IWorkbenchProjectAppService ProjectAppService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject RemoteServiceOptions RemoteOptions

<PageTitle>AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">@toastMessage</div>
}

<div class="wb-home">
    <!-- ========== 中栏：员工任务记录 ========== -->
    <div class="wb-task-col">
        @if (_agent is null)
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <div class="empty-text">暂无员工，<a href="/workbench/employees">去新建</a></div>
            </div>
        }
        else
        {
            <div class="wb-task-head">
                <span class="wb-agent-avatar">@_agent.DisplayName.Substring(0, 1)</span>
                <span class="wb-task-head-name">@_agent.DisplayName</span>
                <button class="btn btn-text btn-small"
                        @onclick='() => Navigation.NavigateTo($"/workbench/employees/{_agent.Id}/settings")'>设置</button>
            </div>

            <div class="wb-seg">
                <div class="wb-seg-item @(_tab == "manual" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("manual")'>对话任务</div>
                <div class="wb-seg-item @(_tab == "scheduled" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("scheduled")'>自动任务</div>
            </div>

            <div class="wb-task-count">
                <span>共 @_tasks.Count 个任务</span>
                <button class="btn btn-text btn-small" @onclick="OnCreateClicked">＋ 新建</button>
            </div>

            <div class="wb-task-list">
                @foreach (var task in _tasks)
                {
                    <div class="wb-task-item @(_chatTask?.Id == task.Id ? "wb-task-item-active" : "")" @onclick="() => OpenTaskAsync(task)">
                        <div class="wb-task-item-name">@task.TaskName</div>
                        <div class="wb-task-item-meta">
                            <span class="wb-task-status wb-status-@task.Status.ToLower()">@task.Status</span>
                            <span>@FormatTime(task)</span>
                        </div>
                    </div>
                }
                @if (!_loadingTasks && !_tasks.Any())
                {
                    <div class="wb-task-empty">@(_tab == "manual" ? "暂无对话任务" : "暂无自动任务")</div>
                }
            </div>
        }
    </div>

    <!-- ========== 右栏：新建任务 / 对话视图 ========== -->
    <div class="wb-main-col">
        @if (_chatTask is null)
        {
            <div class="wb-main-head">新建任务</div>

            <div class="wb-hero">
                <div class="wb-hero-avatar">@(_agent?.DisplayName.Substring(0, 1) ?? "？")</div>
                <div class="wb-hero-title">你好，今天我能帮你什么？</div>
                <div class="wb-hero-sub">@(_agent is null ? "请先在左侧选择或新建员工。" : $"我是{_agent.DisplayName}，{_agent.Description}")</div>

                <div class="wb-suggests">
                    @foreach (var suggest in Suggests)
                    {
                        <div class="wb-suggest" @onclick="() => _input = suggest">
                            <span class="wb-suggest-icon">✦</span>
                            <span>@suggest</span>
                        </div>
                    }
                </div>
            </div>

            <div class="wb-input-card">
                <textarea class="wb-input" placeholder="输入消息，@@ 选择当前工作区上下文..."
                          @bind="_input" @bind:event="oninput"></textarea>
                <div class="wb-input-bar">
                    <select class="wb-project-select" @bind="_inputProjectId">
                        <option value="">选择项目</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.Id">@project.ProjectName</option>
                        }
                    </select>
                    <button class="wb-send" disabled="@(_sending || string.IsNullOrWhiteSpace(_input) || _agent is null)"
                            @onclick="SendAsync">↑</button>
                </div>
            </div>
        }
        else
        {
            <div class="wb-main-head wb-conv-head">
                <button class="btn btn-text btn-small" @onclick="CloseConversation">← 返回</button>
                <span class="wb-conv-title">@_chatTask.TaskName</span>
                <span class="wb-conv-actions">
                    <button class="btn btn-text btn-small" disabled="@_executing" @onclick="RerunConversationAsync">重新执行</button>
                    <button class="btn btn-text btn-small btn-danger" @onclick="DeleteConversationAsync">删除任务</button>
                </span>
            </div>

            <div class="wb-conv-body">
                @foreach (var msg in _chatMessages)
                {
                    <div class="wb-msg wb-msg-@msg.Role">
                        @if (msg.Role is "assistant" or "error")
                        {
                            <div class="wb-msg-agent">
                                <span class="wb-msg-agent-avatar">@(_agent?.DisplayName.Substring(0, 1) ?? "AI")</span>
                                <span>@(_agent?.DisplayName ?? "员工")</span>
                            </div>
                        }
                        @if (msg.Role == "user")
                        {
                            <div class="wb-msg-bubble">@msg.Content</div>
                        }
                        else
                        {
                            <div class="wb-msg-bubble wb-msg-bubble-md">
                                @if (string.IsNullOrEmpty(msg.Content))
                                {
                                    <span>…</span>
                                }
                                else
                                {
                                    <MarkdownRenderer Content="@msg.Content" />
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(msg.Content))
                        {
                            <div class="wb-msg-time">@msg.Time.ToString("MM-dd HH:mm:ss")</div>
                        }
                    </div>
                }
                @if (_streamStatus is not null)
                {
                    <div class="wb-stream-status">@_streamStatus</div>
                }
            </div>

            <div class="wb-input-card">
                <textarea class="wb-input" placeholder="继续对话，回车发送（Shift+Enter 换行）..."
                          @bind="_input" @bind:event="oninput" @onkeydown="OnConvInputKeyDownAsync"></textarea>
                <div class="wb-input-bar">
                    <span class="wb-conv-hint">继续对话将作为该任务的一次新执行（携带历史上下文）</span>
                    <button class="wb-send" disabled="@(_executing || string.IsNullOrWhiteSpace(_input))"
                            @onclick="SendFollowUpAsync">↑</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========== 新建任务对话框 ========== -->
@if (_showCreate)
{
    <div class="modal-overlay" @onclick="CloseCreateDialog">
        <div class="modal-dialog" style="width:520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>新建任务</h3>
                <button class="btn btn-text modal-close-btn" @onclick="CloseCreateDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-item required">
                    <label>* 任务名称</label>
                    <input class="modal-input" @bind="_editTaskName" placeholder="如：登录模块单元测试" />
                </div>
                <div class="form-item required">
                    <label>* 任务内容（提示词）</label>
                    <textarea class="modal-input modal-textarea" @bind="_editPrompt" style="min-height:100px;"
                              placeholder="描述要完成的任务"></textarea>
                </div>
                <div class="form-item">
                    <label>执行方式</label>
                    <div class="wb-radio-row">
                        <label class="checkbox-label">
                            <input type="radio" name="execMode" checked="@(_editMode == "Manual")" @onchange='() => _editMode = "Manual"' /> 手动执行
                        </label>
                        <label class="checkbox-label">
                            <input type="radio" name="execMode" checked="@(_editMode == "Auto")" @onchange='() => _editMode = "Auto"' /> 自动执行
                        </label>
                    </div>
                </div>
                @if (_editMode == "Auto")
                {
                    <div class="form-row">
                        <div class="form-item">
                            <label>调度类型</label>
                            <select class="modal-select" @bind="_editScheduleType">
                                <option value="Once">单次</option>
                                <option value="Daily">每天</option>
                            </select>
                        </div>
                        @if (_editScheduleType == "Daily")
                        {
                            <div class="form-item">
                                <label>执行时间</label>
                                <input class="modal-input" type="time" @bind="_editTime" />
                            </div>
                        }
                    </div>
                }
                <div class="form-item">
                    <label>归属项目（可选）</label>
                    <select class="modal-select" @bind="_editProjectId">
                        <option value="">无</option>
                        @foreach (var project in _projects)
                        {
                            <option value="@project.Id">@project.ProjectName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" @onclick="CloseCreateDialog">取消</button>
                <button class="modal-btn-primary" disabled="@_saving" @onclick="CreateTaskAsync">创建</button>
            </div>
        </div>
    </div>
}

<!-- ========== 任务详情对话框 ========== -->
@if (_detail is not null)
{
    <div class="modal-overlay" @onclick="() => _detail = null">
        <div class="modal-dialog" style="width:560px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@_detail.TaskName</h3>
                <button class="btn btn-text modal-close-btn" @onclick="() => _detail = null">✕</button>
            </div>
            <div class="modal-body">
                <div class="model-info-row"><span class="info-label">类型:</span><span>@(_detail.TaskType == "manual" ? "对话任务" : "自动任务")</span>
                    <span class="info-label" style="margin-left:16px;">状态:</span><span>@_detail.Status</span>
                    <span class="info-label" style="margin-left:16px;">调度:</span><span>@_detail.ScheduleDisplayText</span></div>
                <div class="model-info-row"><span class="info-label">内容:</span><span>@_detail.PromptContent</span></div>
                <div class="model-info-row"><span class="info-label">最近运行:</span><span>@(_detail.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "暂无")</span></div>

                <h4 style="margin:16px 0 8px;font-size:14px;">执行记录</h4>
                @if (_detailLogs.Any())
                {
                    foreach (var log in _detailLogs)
                    {
                        <div class="wb-log-row">
                            <span class="wb-task-status wb-status-@log.Status.ToLower()">@log.Status</span>
                            <span>@log.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            <span class="wb-log-msg">@log.ErrorMessage</span>
                        </div>
                    }
                }
                else
                {
                    <div class="wb-task-empty">暂无执行记录</div>
                }
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel btn-danger" @onclick="DeleteDetailAsync">删除任务</button>
                <button class="modal-btn-cancel" @onclick="ExecuteDetailAsync">立即执行</button>
                <button class="modal-btn-primary" @onclick="() => _detail = null">关闭</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public WorkbenchState State { get; set; } = default!;

    private static readonly string[] Suggests =
    [
        "帮我配置一个 Node.js 项目的 CI/CD 流水线，包括构建、测试和自动部署",
        "为这个用户登录模块编写单元测试，确保覆盖正常登录、异常密码和边界场景",
        "我的 API 接口返回 500 错误，帮我排查日志并修复这个 Bug"
    ];

    private AgentDto? _agent;
    private string _tab = "manual";
    private List<TaskDto> _tasks = [];
    private bool _loadingTasks;
    private List<WorkbenchProjectDto> _projects = [];

    private string _input = "";
    private string _inputProjectId = "";
    private bool _sending;

    private bool _showCreate;
    private bool _saving;
    private string _editTaskName = "";
    private string _editPrompt = "";
    private string _editMode = "Manual";
    private string _editScheduleType = "Once";
    private TimeOnly _editTime = new(9, 0);
    private string _editProjectId = "";

    private TaskDto? _detail;
    private List<TaskLogDto> _detailLogs = [];

    private TaskDto? _chatTask;
    private List<ConvMessage> _chatMessages = [];
    private bool _executing;
    private string? _streamStatus;

    private class ConvMessage
    {
        public string Role { get; set; } = "user";
        public string Content { get; set; } = "";
        public DateTime Time { get; set; }
    }

    private string toastMessage = "";
    private string toastType = "info";
    private bool toastVisible;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _agent = State.SelectedAgent;
        await LoadProjectsAsync();
        await LoadTasksAsync();
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    private async void OnStateChanged()
    {
        _agent = State.SelectedAgent;
        await InvokeAsync(async () =>
        {
            CloseConversation();
            await LoadTasksAsync();
            StateHasChanged();
        });
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            _projects = (await ProjectAppService.GetListAsync(new WorkbenchProjectQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
        }
        catch { }
    }

    private async Task LoadTasksAsync()
    {
        if (_agent is null)
        {
            _tasks = [];
            return;
        }

        _loadingTasks = true;
        try
        {
            var result = (await TaskAppService.GetListAsync(new TaskQueryDto
            {
                AgentType = _agent.AgentType,
                TaskType = _tab,
                MaxResultCount = 100
            })).Data;
            _tasks = result?.Items.ToList() ?? [];
            if (_chatTask is not null)
            {
                _chatTask = _tasks.FirstOrDefault(t => t.Id == _chatTask.Id) ?? _chatTask;
            }
        }
        catch (Exception ex)
        {
            ShowToast($"加载任务失败: {ex.Message}", "error");
        }
        finally
        {
            _loadingTasks = false;
        }
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        CloseConversation();
        await LoadTasksAsync();
    }

    private void OnCreateClicked()
    {
        // 对话任务走右栏"新建任务"态；自动任务保留表单弹窗
        if (_tab == "manual")
        {
            CloseConversation();
        }
        else
        {
            ShowCreateDialog();
        }
    }

    private void ShowCreateDialog()
    {
        _editTaskName = "";
        _editPrompt = "";
        _editMode = _tab == "scheduled" ? "Auto" : "Manual";
        _editScheduleType = "Once";
        _editTime = new TimeOnly(9, 0);
        _editProjectId = "";
        _showCreate = true;
    }

    private void CloseCreateDialog() => _showCreate = false;

    private async Task CreateTaskAsync()
    {
        if (_agent is null) return;
        if (string.IsNullOrWhiteSpace(_editTaskName)) { ShowToast("请输入任务名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(_editPrompt)) { ShowToast("请输入任务内容", "warning"); return; }

        _saving = true;
        try
        {
            var (hour, minute) = (_editTime.Hour, _editTime.Minute);
            await TaskAppService.CreateAsync(new CreateTaskDto
            {
                TaskName = _editTaskName.Trim(),
                PromptContent = _editPrompt.Trim(),
                ExecutionMode = _editMode,
                AgentType = _agent.AgentType,
                ProjectId = ParseGuid(_editProjectId),
                ScheduleType = _editMode == "Manual" ? "Once" : _editScheduleType,
                Hour = _editMode == "Auto" && _editScheduleType == "Daily" ? hour : null,
                Minute = _editMode == "Auto" && _editScheduleType == "Daily" ? minute : null,
                IsEnabled = true
            });
            ShowToast("任务已创建", "success");
            _showCreate = false;
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"创建失败: {ex.Message}", "error");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendAsync()
    {
        if (_agent is null || string.IsNullOrWhiteSpace(_input)) return;

        _sending = true;
        try
        {
            var prompt = _input.Trim();
            var name = prompt.Length > 30 ? prompt[..30] + "…" : prompt;
            var created = (await TaskAppService.CreateAsync(new CreateTaskDto
            {
                TaskName = name,
                PromptContent = prompt,
                ExecutionMode = "Manual",
                AgentType = _agent.AgentType,
                ProjectId = ParseGuid(_inputProjectId),
                ScheduleType = "Once",
                IsEnabled = true
            })).Data;
            _input = "";
            _tab = "manual";
            await LoadTasksAsync();

            if (created is not null)
            {
                await OpenConversationAsync(created);
                StateHasChanged();
                await StreamExecuteAsync(created);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"创建失败: {ex.Message}", "error");
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task OpenTaskAsync(TaskDto task)
    {
        if (task.TaskType == "manual")
        {
            await OpenConversationAsync(task);
        }
        else
        {
            await ShowTaskDetail(task);
        }
    }

    private async Task OpenConversationAsync(TaskDto task)
    {
        _chatTask = task;
        _chatMessages = [];
        try
        {
            var logs = (await TaskAppService.GetExecutionLogsAsync(task.Id, 50)).Data ?? [];
            var ordered = logs.OrderBy(l => l.StartTime).ToList();
            if (ordered.Count == 0)
            {
                _chatMessages.Add(new ConvMessage { Role = "user", Content = task.PromptContent, Time = task.CreationTime });
            }
            else
            {
                // 每次执行渲染为一对 用户提问 + 员工回复；旧日志无 Prompt 时回退任务默认提示词
                foreach (var log in ordered)
                {
                    _chatMessages.Add(new ConvMessage { Role = "user", Content = log.Prompt ?? task.PromptContent, Time = log.StartTime });
                    _chatMessages.Add(LogToMessage(log));
                }
            }
        }
        catch (Exception ex)
        {
            ShowToast($"加载执行记录失败: {ex.Message}", "error");
        }
        ScrollConversationToBottom();
    }

    private void CloseConversation()
    {
        _chatTask = null;
        _chatMessages = [];
    }

    private async Task RerunConversationAsync()
    {
        if (_chatTask is null || _executing) return;
        await StreamExecuteAsync(_chatTask);
    }

    private async Task DeleteConversationAsync()
    {
        if (_chatTask is null) return;
        try
        {
            await TaskAppService.DeleteAsync(_chatTask.Id);
            ShowToast("任务已删除", "success");
            CloseConversation();
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private async Task OnConvInputKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendFollowUpAsync();
        }
    }

    private async Task SendFollowUpAsync()
    {
        if (_chatTask is null || _executing || string.IsNullOrWhiteSpace(_input)) return;
        var prompt = _input.Trim();
        _input = "";
        await StreamExecuteAsync(_chatTask, prompt);
    }

    private async Task StreamExecuteAsync(TaskDto task, string? prompt = null)
    {
        if (_chatTask is null || _executing) return;

        _executing = true;
        _streamStatus = null;
        if (prompt is not null)
        {
            _chatMessages.Add(new ConvMessage { Role = "user", Content = prompt, Time = DateTime.Now });
        }
        var live = new ConvMessage { Role = "assistant", Content = "", Time = DateTime.Now };
        _chatMessages.Add(live);
        ScrollConversationToBottom();
        StateHasChanged();

        var thinking = new StringBuilder();
        var answer = new StringBuilder();
        string? error = null;

        var client = new TaskStreamClient(HttpClientFactory, RemoteOptions);
        using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
        try
        {
            await foreach (var data in client.StreamAsync(task.Id, prompt, cts.Token))
            {
                string? type = null, content = null, message = null, toolName = null;
                var isFatal = true;
                try
                {
                    using var doc = JsonDocument.Parse(data);
                    var root = doc.RootElement;
                    type = root.TryGetProperty("type", out var t) ? t.GetString() : null;
                    if (root.TryGetProperty("content", out var c)) content = c.GetString();
                    if (root.TryGetProperty("message", out var m)) message = m.GetString();
                    if (root.TryGetProperty("toolName", out var tn)) toolName = tn.GetString();
                    if (root.TryGetProperty("isFatal", out var f)) isFatal = f.GetBoolean();
                }
                catch
                {
                    content = data;
                }

                switch (type)
                {
                    case "thinking":
                        thinking.Append(content);
                        _streamStatus = null;
                        break;
                    case "answer":
                        answer.Append(content);
                        break;
                    case "tool_call":
                        _streamStatus = $"正在调用工具 {toolName}…";
                        break;
                    case "tool_result":
                        _streamStatus = null;
                        break;
                    case "error":
                        if (isFatal) error = message;
                        break;
                }

                live.Content = answer.Length > 0 ? answer.ToString() : thinking.ToString();
                if (error is not null)
                {
                    live.Role = "error";
                    live.Content = error;
                }
                ScrollConversationToBottom();
                StateHasChanged();
            }

            if (live.Role == "assistant" && string.IsNullOrEmpty(live.Content))
            {
                live.Content = "（无返回内容）";
            }
        }
        catch (Exception ex)
        {
            live.Role = "error";
            live.Content = ex.Message;
            ShowToast($"执行失败: {ex.Message}", "error");
        }
        finally
        {
            _executing = false;
            _streamStatus = null;
            await LoadTasksAsync();
            ScrollConversationToBottom();
            StateHasChanged();
        }
    }

    private static ConvMessage LogToMessage(TaskLogDto log) => new()
    {
        Role = log.Status == "Success" ? "assistant" : "error",
        Content = log.Status == "Success"
            ? (string.IsNullOrWhiteSpace(log.Result) ? "（无返回内容）" : log.Result)
            : (log.ErrorMessage ?? log.Status),
        Time = log.StartTime
    };

    private bool _pendingScroll;

    private void ScrollConversationToBottom()
    {
        _pendingScroll = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScroll)
        {
            _pendingScroll = false;
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "document.querySelectorAll('.wb-conv-body').forEach(e => e.scrollTop = e.scrollHeight)");
            }
            catch { }
        }
    }

    private async Task ShowTaskDetail(TaskDto task)
    {
        _detail = task;
        _detailLogs = [];
        try
        {
            _detailLogs = (await TaskAppService.GetExecutionLogsAsync(task.Id, 20)).Data ?? [];
        }
        catch { }
    }

    private async Task ExecuteDetailAsync()
    {
        if (_detail is null) return;
        try
        {
            await TaskAppService.ExecuteNowAsync(_detail.Id);
            ShowToast("已触发执行", "success");
            _detail = null;
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"执行失败: {ex.Message}", "error");
        }
    }

    private async Task DeleteDetailAsync()
    {
        if (_detail is null) return;
        try
        {
            await TaskAppService.DeleteAsync(_detail.Id);
            ShowToast("任务已删除", "success");
            _detail = null;
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private static string FormatTime(TaskDto task)
        => (task.LastExecutionTime ?? task.CreationTime).ToString("MM-dd HH:mm");

    private static Guid? ParseGuid(string? value)
        => Guid.TryParse(value, out var id) ? id : null;

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}

