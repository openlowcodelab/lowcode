@page "/workbench/projects"

@layout WorkbenchLayout
@inject IWorkbenchProjectAppService ProjectAppService

<PageTitle>项目 - AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">@toastMessage</div>
}

<div class="pg-page">
    <div class="pg-header">
        <h2>项目</h2>
        <button class="btn btn-primary workbench-btn-primary btn-small" @onclick="ShowCreate">＋ 新建项目</button>
    </div>

    <div class="pg-search">
        <input placeholder="搜索项目名称或描述..." @bind="_filter" @bind:after="LoadAsync" />
    </div>

    @if (_loading)
    {
        <div class="empty-state"><div class="empty-text">加载中...</div></div>
    }
    else if (_projects.Any())
    {
        <div class="pg-grid">
            @foreach (var project in _projects)
            {
                <div class="pg-card">
                    <div class="pg-card-head">
                        <span class="pg-card-icon">🗂</span>
                        <strong class="pg-card-name">@project.ProjectName</strong>
                    </div>
                    <div class="pg-card-desc">@project.Description</div>
                    @foreach (var resource in project.Resources)
                    {
                        <div class="pg-card-repo" title="@(resource.Url ?? resource.Name)">
                            @ResourceIcon(resource.ResourceType) @resource.Name@(resource.ResourceType == WorkbenchResourceTypes.Code && !string.IsNullOrEmpty(resource.Url) ? $"：{resource.Url}" : "")@(resource.ResourceType == WorkbenchResourceTypes.Code && !string.IsNullOrEmpty(resource.Branch) ? $"（{resource.Branch}）" : "")
                        </div>
                    }
                    <div class="pg-card-foot">
                        <span>任务数 @project.TaskCount</span>
                        <span>@project.CreationTime.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="pg-card-actions">
                        <button class="btn btn-link btn-small" @onclick="() => ShowEdit(project)">编辑</button>
                        <button class="btn btn-link btn-small btn-danger" @onclick="() => DeleteAsync(project)">删除</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🗂</div>
            <div class="empty-text">暂无项目，点击新建按钮新增</div>
        </div>
    }
</div>

@if (_showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-dialog" style="width:720px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editId is null ? "新建项目" : "编辑项目")</h3>
                <button class="btn btn-text modal-close-btn" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-item required">
                    <label>* 项目名称</label>
                    <input class="modal-input" @bind="_editName" placeholder="如：点餐系统" />
                </div>
                <div class="form-item">
                    <label>项目描述</label>
                    <textarea class="modal-input modal-textarea" @bind="_editDescription" placeholder="描述项目目标与范围"></textarea>
                </div>
                <div class="form-item">
                    <label>项目资源</label>
                    <div class="pg-res-note">项目关联的工作资料（代码仓库、设计文件等）。员工绑定项目后，代码仓库类资源会作为"可操作仓库"注入提示词。</div>
                    @foreach (var (resource, index) in _editResources.Select((r, i) => (r, i)))
                    {
                        <div class="pg-res-row">
                            <select class="modal-input pg-res-type" @bind="resource.ResourceType" @bind:after='() => OnResourceTypeChanged(resource)'>
                                @foreach (var type in ResourceTypeOptions)
                                {
                                    <option value="@type.Value">@type.Label</option>
                                }
                            </select>
                            <input class="modal-input pg-res-name" @bind="resource.Name" placeholder="名称，如：后端服务" />
                            <input class="modal-input pg-res-url" @bind="resource.Url" placeholder="地址，如 https://... 或文件链接" />
                            @if (resource.ResourceType == WorkbenchResourceTypes.Code)
                            {
                                <input class="modal-input pg-res-branch" @bind="resource.Branch" placeholder="默认分支，可留空" />
                            }
                            <button class="btn btn-link btn-small btn-danger" @onclick="() => RemoveResource(index)">删除</button>
                        </div>
                    }
                    <button class="btn btn-link btn-small" @onclick="AddResource">＋ 添加资源</button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" @onclick="CloseDialog">取消</button>
                <button class="modal-btn-primary" disabled="@_saving" @onclick="SaveAsync">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Value, string Label)[] ResourceTypeOptions =
    [
        (WorkbenchResourceTypes.Code, "代码仓库"),
        (WorkbenchResourceTypes.Design, "设计文件"),
        (WorkbenchResourceTypes.Document, "文档"),
        (WorkbenchResourceTypes.Data, "数据集"),
        (WorkbenchResourceTypes.Other, "其他")
    ];

    private List<WorkbenchProjectDto> _projects = [];
    private bool _loading;
    private string _filter = "";

    private bool _showDialog;
    private bool _saving;
    private Guid? _editId;
    private string _editName = "";
    private string _editDescription = "";
    private List<WorkbenchProjectResourceInputDto> _editResources = [];

    private string toastMessage = "";
    private string toastType = "info";
    private bool toastVisible;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static string ResourceIcon(string resourceType) => resourceType switch
    {
        WorkbenchResourceTypes.Code => "📦",
        WorkbenchResourceTypes.Design => "🎨",
        WorkbenchResourceTypes.Document => "📄",
        WorkbenchResourceTypes.Data => "📊",
        _ => "🔗"
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = (await ProjectAppService.GetListAsync(new WorkbenchProjectQueryDto
            {
                Filter = string.IsNullOrWhiteSpace(_filter) ? null : _filter,
                MaxResultCount = 100
            })).Data;
            _projects = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            ShowToast($"加载项目失败: {ex.Message}", "error");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowCreate()
    {
        _editId = null;
        _editName = "";
        _editDescription = "";
        _editResources = [];
        _showDialog = true;
    }

    private void ShowEdit(WorkbenchProjectDto project)
    {
        _editId = project.Id;
        _editName = project.ProjectName;
        _editDescription = project.Description;
        _editResources = project.Resources.Select(r => new WorkbenchProjectResourceInputDto
        {
            ResourceType = r.ResourceType,
            Name = r.Name,
            Url = r.Url,
            Branch = r.Branch
        }).ToList();
        _showDialog = true;
    }

    private void AddResource() => _editResources.Add(new WorkbenchProjectResourceInputDto
    {
        ResourceType = WorkbenchResourceTypes.Code
    });

    private void RemoveResource(int index) => _editResources.RemoveAt(index);

    private void OnResourceTypeChanged(WorkbenchProjectResourceInputDto resource)
    {
        if (resource.ResourceType != WorkbenchResourceTypes.Code)
        {
            resource.Branch = null;
        }
    }

    private void CloseDialog() => _showDialog = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            ShowToast("请输入项目名称", "warning");
            return;
        }

        var resources = _editResources
            .Where(r => !string.IsNullOrWhiteSpace(r.Name) || !string.IsNullOrWhiteSpace(r.Url))
            .Select(r => new WorkbenchProjectResourceInputDto
            {
                ResourceType = r.ResourceType,
                Name = r.Name?.Trim() ?? "",
                Url = r.Url?.Trim(),
                Branch = r.Branch?.Trim()
            })
            .ToList();
        if (resources.Any(r => string.IsNullOrWhiteSpace(r.Name)))
        {
            ShowToast("请填写每个资源的名称，或删除空资源行", "warning");
            return;
        }

        _saving = true;
        try
        {
            if (_editId is null)
            {
                await ProjectAppService.CreateAsync(new CreateWorkbenchProjectDto
                {
                    ProjectName = _editName.Trim(),
                    Description = _editDescription.Trim(),
                    Resources = resources
                });
                ShowToast("项目已创建", "success");
            }
            else
            {
                await ProjectAppService.UpdateAsync(_editId.Value, new UpdateWorkbenchProjectDto
                {
                    ProjectName = _editName.Trim(),
                    Description = _editDescription.Trim(),
                    Resources = resources
                });
                ShowToast("项目已更新", "success");
            }

            _showDialog = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"保存失败: {ex.Message}", "error");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(WorkbenchProjectDto project)
    {
        try
        {
            await ProjectAppService.DeleteAsync(project.Id);
            ShowToast("项目已删除", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}

<style>
    .pg-page {
        height: 100%;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
        box-sizing: border-box;
    }

    .pg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .pg-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .pg-search {
        margin-bottom: 16px;
    }

    .pg-search input {
        width: 280px;
        height: 32px;
        padding: 2px 12px;
        border: 1px solid #e8e8e8;
        border-radius: 6px;
        font-size: 13px;
        outline: none;
    }

    .pg-search input:focus {
        border-color: #a6a6a6;
    }

    .pg-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .pg-card {
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        position: relative;
    }

    .pg-card:hover {
        border-color: #d9d9d9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .pg-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pg-card-icon {
        font-size: 18px;
    }

    .pg-card-name {
        font-size: 15px;
        color: #262626;
    }

    .pg-card-desc {
        font-size: 13px;
        color: #8c8c8c;
        min-height: 20px;
    }

    .pg-card-repo {
        font-size: 12px;
        color: #595959;
        background: #fafafa;
        border-radius: 6px;
        padding: 4px 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pg-res-note {
        font-size: 12px;
        color: #8c8c8c;
        margin-bottom: 8px;
    }

    .pg-res-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
    }

    .pg-res-row .modal-input {
        height: 32px;
        min-width: 0;
    }

    /* 双类选择器提高特异性，避免被其他页面 .modal-input{width:100%} 按加载顺序覆盖 */
    .pg-res-row .pg-res-type {
        width: 110px;
        flex: 0 0 auto;
    }

    .pg-res-row .pg-res-name {
        width: 190px;
        flex: 0 0 auto;
    }

    .pg-res-row .pg-res-url {
        flex: 1 1 220px;
        width: auto;
        min-width: 180px;
    }

    .pg-res-row .pg-res-branch {
        width: 150px;
        flex: 0 0 auto;
    }

    .pg-card-foot {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #8c8c8c;
        border-top: 1px solid #f0f0f0;
        padding-top: 8px;
    }

    .pg-card-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }
</style>
