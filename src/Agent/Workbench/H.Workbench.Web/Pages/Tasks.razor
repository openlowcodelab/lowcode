@page "/workbench/tasks"

@layout WorkbenchLayout
@inject ITaskAppService TaskAppService
@inject IAgentAppService AgentAppService
@inject IWorkbenchProjectAppService ProjectAppService
@inject IWorkflowAppService WorkflowAppService

<PageTitle>任务 - AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">@toastMessage</div>
}

<div class="tk-page">
    <div class="tk-header">
        <h2>任务</h2>
        <button class="btn btn-primary workbench-btn-primary btn-small" @onclick="ShowCreate">＋ 新建任务</button>
    </div>

    <div class="tk-filters">
        <input class="tk-search" placeholder="搜索任务名称或描述..." @bind="_filter" @bind:event="oninput" @onkeyup="EnterKeyAsync" />
        <div class="wb-seg tk-seg">
            <div class="wb-seg-item @(_type == "all" ? "wb-seg-active" : "")" @onclick='() => SwitchType("all")'>全部</div>
            <div class="wb-seg-item @(_type == "manual" ? "wb-seg-active" : "")" @onclick='() => SwitchType("manual")'>对话任务</div>
            <div class="wb-seg-item @(_type == "scheduled" ? "wb-seg-active" : "")" @onclick='() => SwitchType("scheduled")'>自动任务</div>
        </div>
        <select class="tk-select" @bind="_status" @bind:after="LoadTasksAsync">
            <option value="">全部状态</option>
            <option value="Active">进行中</option>
            <option value="Paused">已暂停</option>
            <option value="Completed">已完成</option>
        </select>
        <select class="tk-select" @bind="_agentType" @bind:after="LoadTasksAsync">
            <option value="">全部员工</option>
            @foreach (var agent in _agents)
            {
                <option value="@agent.AgentType">@agent.DisplayName</option>
            }
        </select>
    </div>

    <div class="tk-table-wrap">
        <table class="tk-table">
            <thead>
                <tr>
                    <th style="min-width:220px;">任务</th>
                    <th>员工</th>
                    <th>类型</th>
                    <th>调度</th>
                    <th>状态</th>
                    <th>下次执行</th>
                    <th>最近运行</th>
                    <th class="tk-col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="8" class="tk-empty">加载中...</td></tr>
                }
                else if (!_tasks.Any())
                {
                    <tr><td colspan="8" class="tk-empty">暂无任务</td></tr>
                }
                else
                {
                    foreach (var task in _tasks)
                    {
                        <tr>
                            <td>
                                <div class="tk-name" @onclick="() => ShowDetailAsync(task)">@task.TaskName</div>
                                @if (!string.IsNullOrWhiteSpace(task.TaskDescription))
                                {
                                    <div class="tk-desc">@task.TaskDescription</div>
                                }
                            </td>
                            <td>@AgentName(task.AgentType)</td>
                            <td><span class="em-role">@(task.TaskType == "manual" ? "对话任务" : "自动任务")</span></td>
                            <td class="tk-schedule">@task.ScheduleDisplayText</td>
                            <td><span class="wb-task-status wb-status-@task.Status.ToLower()">@StatusText(task)</span></td>
                            <td>@(task.NextExecutionTime?.ToString("MM-dd HH:mm") ?? (task.ExecutionMode == "Auto" ? "执行中" : "—"))</td>
                            <td>@(task.LastExecutionTime?.ToString("MM-dd HH:mm") ?? "暂无")</td>
                            <td class="tk-col-actions">
                                <button class="btn btn-link btn-small" @onclick="() => ExecuteAsync(task)">执行</button>
                                <button class="btn btn-link btn-small" @onclick="() => ShowEdit(task)">编辑</button>
                                <button class="btn btn-link btn-small" @onclick="() => ToggleEnableAsync(task)">@(task.IsEnabled ? "停用" : "启用")</button>
                                <button class="btn btn-link btn-small btn-danger" @onclick="() => DeleteAsync(task)">删除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ========== 新建/编辑任务对话框 ========== -->
@if (_showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-dialog" style="width:540px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editId is null ? "新建任务" : "编辑任务")</h3>
                <button class="btn btn-text modal-close-btn" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-item required">
                    <label>* 任务名称</label>
                    <input class="modal-input" @bind="_editName" placeholder="如：登录模块单元测试" />
                </div>
                <div class="form-item">
                    <label>任务描述</label>
                    <input class="modal-input" @bind="_editDescription" placeholder="可选" />
                </div>
                <div class="form-item required">
                    <label>* 创建方式</label>
                    <div class="wb-radio-row">
                        <label class="checkbox-label">
                            <input type="radio" name="tkSrcType" checked="@(_editSourceType == "Prompt")" @onchange='() => _editSourceType = "Prompt"' /> 单提示词
                        </label>
                        <label class="checkbox-label">
                            <input type="radio" name="tkSrcType" checked="@(_editSourceType == "Workflow")" @onchange="OnSwitchToWorkflow" /> 工作流（多员工接力 + 人工卡点）
                        </label>
                    </div>
                </div>
                @if (_editSourceType == "Prompt")
                {
                    <div class="form-item required">
                        <label>* 任务内容（提示词）</label>
                        <textarea class="modal-input modal-textarea" @bind="_editPrompt" style="min-height:100px;" placeholder="描述要完成的任务"></textarea>
                    </div>
                }
                else
                {
                    <div class="form-item">
                        <label>从员工工作流导入</label>
                        <select class="modal-select" @bind="_editTemplateId" @bind:after="ApplyWorkflowTemplate">
                            <option value="">（手动编排步骤）</option>
                            @foreach (var tpl in _workflowTemplates)
                            {
                                <option value="@tpl.Id">@AgentName(tpl.AgentType) · @tpl.WorkflowName（@tpl.Steps.Count 步）</option>
                            }
                        </select>
                    </div>
                    <div class="tk-steps">
                        @for (var i = 0; i < _editSteps.Count; i++)
                        {
                            var idx = i;
                            var step = _editSteps[idx];
                            <div class="tk-step-card">
                                <div class="tk-step-head">
                                    <span class="tk-step-no">步骤 @(idx + 1)</span>
                                    <input class="modal-input tk-step-name" @bind="step.Name" placeholder="步骤名称" />
                                    <select class="modal-select tk-step-agent" @bind="step.AgentType">
                                        <option value="">默认员工</option>
                                        @foreach (var agent in _agents)
                                        {
                                            <option value="@agent.AgentType">@agent.DisplayName</option>
                                        }
                                    </select>
                                </div>
                                <div class="tk-step-head tk-step-opts">
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="step.RequireApproval" /> 人工卡点（对话执行时暂停待批准）
                                    </label>
                                    <span class="tk-step-failure">失败时
                                        <select class="modal-select" @bind="step.OnFailure">
                                            <option value="Stop">中止</option>
                                            <option value="Skip">跳过继续</option>
                                        </select>
                                    </span>
                                    <span class="tk-step-actions">
                                        <button class="btn btn-link btn-small" disabled="@(idx == 0)" @onclick="() => MoveStep(idx, -1)">↑</button>
                                        <button class="btn btn-link btn-small" disabled="@(idx == _editSteps.Count - 1)" @onclick="() => MoveStep(idx, 1)">↓</button>
                                        <button class="btn btn-link btn-small btn-danger" @onclick="() => _editSteps.RemoveAt(idx)">✕</button>
                                    </span>
                                </div>
                                <textarea class="modal-input modal-textarea" @bind="step.Prompt" style="min-height:64px;" placeholder="该步骤的任务提示词（自动获得前序步骤结果）"></textarea>
                            </div>
                        }
                        <button class="btn btn-text btn-small" @onclick="AddStep">＋ 添加步骤</button>
                    </div>
                }
                <div class="form-item">
                    <label>验收标准（可选）</label>
                    <textarea class="modal-input modal-textarea" @bind="_editAcceptance" style="min-height:56px;"
                              placeholder="写清「怎样算做完了」。执行结束后由一次不带工具的模型复核据此裁决 Pass/Fail；留空则不验收"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-item required">
                        <label>* 执行员工</label>
                        <select class="modal-select" @bind="_editAgentType">
                            @foreach (var agent in _agents)
                            {
                                <option value="@agent.AgentType">@agent.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="form-item">
                        <label>归属项目（可选）</label>
                        <select class="modal-select" @bind="_editProjectId">
                            <option value="">无</option>
                            @foreach (var project in _projects)
                            {
                                <option value="@project.Id">@project.ProjectName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-item">
                    <label>执行方式</label>
                    <div class="wb-radio-row">
                        <label class="checkbox-label">
                            <input type="radio" name="tkExecMode" checked="@(_editMode == "Manual")" @onchange='() => _editMode = "Manual"' /> 手动执行
                        </label>
                        <label class="checkbox-label">
                            <input type="radio" name="tkExecMode" checked="@(_editMode == "Auto")" @onchange='() => _editMode = "Auto"' /> 自动执行
                        </label>
                    </div>
                </div>
                @if (_editMode == "Auto")
                {
                    <div class="form-row">
                        <div class="form-item">
                            <label>调度类型</label>
                            <select class="modal-select" @bind="_editScheduleType">
                                <option value="Once">单次</option>
                                <option value="Daily">每天</option>
                                <option value="Weekly">每周</option>
                                <option value="Monthly">每月</option>
                                <option value="Cron">Cron 表达式</option>
                            </select>
                        </div>
                        @if (_editScheduleType == "Weekly")
                        {
                            <div class="form-item">
                                <label>星期</label>
                                <select class="modal-select" @bind="_editDayOfWeek">
                                    <option value="1">周一</option>
                                    <option value="2">周二</option>
                                    <option value="3">周三</option>
                                    <option value="4">周四</option>
                                    <option value="5">周五</option>
                                    <option value="6">周六</option>
                                    <option value="0">周日</option>
                                </select>
                            </div>
                        }
                        @if (_editScheduleType == "Monthly")
                        {
                            <div class="form-item">
                                <label>日期(1-31)</label>
                                <input class="modal-input" type="number" min="1" max="31" @bind="_editDayOfMonth" />
                            </div>
                        }
                        @if (_editScheduleType is "Daily" or "Weekly" or "Monthly")
                        {
                            <div class="form-item">
                                <label>执行时间</label>
                                <input class="modal-input" type="time" @bind="_editTime" />
                            </div>
                        }
                    </div>
                    @if (_editScheduleType == "Cron")
                    {
                        <div class="form-item">
                            <label>Cron 表达式（5 段：分 时 日 月 周，如 */30 9-18 * * 1-5）</label>
                            <input class="modal-input" @bind="_editCron" placeholder="*/2 * * * *" />
                        </div>
                    }
                }
                @if (_editId is not null)
                {
                    <div class="form-item">
                        <label class="checkbox-label"><input type="checkbox" @bind="_editEnabled" /> 启用任务</label>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" @onclick="CloseDialog">取消</button>
                <button class="modal-btn-primary" disabled="@_saving" @onclick="SaveAsync">@(_editId is null ? "创建" : "保存")</button>
            </div>
        </div>
    </div>
}

<!-- ========== 任务详情对话框 ========== -->
@if (_detail is not null)
{
    <div class="modal-overlay" @onclick="() => _detail = null">
        <div class="modal-dialog" style="width:560px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@_detail.TaskName</h3>
                <button class="btn btn-text modal-close-btn" @onclick="() => _detail = null">✕</button>
            </div>
            <div class="modal-body">
                <div class="model-info-row">
                    <span class="info-label">员工:</span><span>@AgentName(_detail.AgentType)</span>
                    <span class="info-label" style="margin-left:16px;">类型:</span><span>@(_detail.TaskType == "manual" ? "对话任务" : "自动任务")</span>
                    <span class="info-label" style="margin-left:16px;">状态:</span><span>@StatusText(_detail)</span>
                </div>
                <div class="model-info-row"><span class="info-label">调度:</span><span>@_detail.ScheduleDisplayText</span></div>
                @if (_detail.SourceType == "Workflow" && ParseWorkflowSteps(_detail.WorkflowContent).Count > 0)
                {
                    <div class="model-info-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span><span class="info-label">工作流（@ParseWorkflowSteps(_detail.WorkflowContent).Count 步）:</span></span>
                        @{ var si = 0; }
                        @foreach (var ws in ParseWorkflowSteps(_detail.WorkflowContent))
                        {
                            si++;
                            <span style="font-size:12px;color:#595959;">@si. @ws.Name
                                @if (!string.IsNullOrWhiteSpace(ws.AgentType))
                                {
                                    <span style="color:#165DFF;">[@AgentName(ws.AgentType)]</span>
                                }
                                @if (ws.RequireApproval)
                                {
                                    <span style="color:#ad6800;">·人工卡点</span>
                                }
                                @if (ws.OnFailure == "Skip")
                                {
                                    <span style="color:#8c8c8c;">·失败跳过</span>
                                }
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="model-info-row"><span class="info-label">内容:</span><span>@_detail.PromptContent</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(_detail.AcceptanceCriteria))
                {
                    <div class="model-info-row">
                        <span class="info-label">验收标准:</span><span>@_detail.AcceptanceCriteria</span>
                    </div>
                }
                <div class="model-info-row">
                    <span class="info-label">最近运行:</span><span>@(_detail.LastExecutionTime?.ToString("yyyy-MM-dd HH:mm") ?? "暂无")</span>
                    <span class="info-label" style="margin-left:16px;">执行次数:</span><span>@_detail.ExecutionCount</span>
                </div>

                <h4 style="margin:16px 0 8px;font-size:14px;">执行记录</h4>
                @if (_detailLogs.Any())
                {
                    foreach (var log in _detailLogs)
                    {
                        <div class="tk-log-row">
                            <span class="wb-task-status wb-status-@log.Status.ToLower()">@log.Status</span>
                            <span>@log.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            @if (log.DurationSeconds is not null)
                            {
                                <span>@log.DurationSeconds 秒</span>
                            }
                            @if (log.StepCount > 0)
                            {
                                <button class="btn btn-text btn-small" @onclick="() => ToggleLogTraceAsync(log)">
                                    @(_logTraceOpenId == log.Id ? "收起步骤" : $"查看步骤 ({log.StepCount})")
                                </button>
                            }
                            <span class="tk-log-msg">@log.ErrorMessage</span>
                        </div>
                        @if (_logTraceOpenId == log.Id)
                        {
                            <ExecutionTraceView Steps="@_logTraceSteps" DefaultOpen="true" />
                            <ArtifactList Artifacts="@_logTraceArtifacts" />
                        }
                    }
                }
                else
                {
                    <div class="tk-empty" style="padding:12px 0;">暂无执行记录</div>
                }
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" @onclick="ExecuteFromDetailAsync">立即执行</button>
                <button class="modal-btn-primary" @onclick="() => _detail = null">关闭</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskDto> _tasks = [];
    private List<AgentDto> _agents = [];
    private List<WorkbenchProjectDto> _projects = [];
    private bool _loading;

    private string _filter = "";
    private string _type = "all";
    private string _status = "";
    private string _agentType = "";

    private bool _showDialog;
    private bool _saving;
    private Guid? _editId;
    private string _editName = "";
    private string _editDescription = "";
    private string _editPrompt = "";
    private string _editAcceptance = "";
    private string _editAgentType = "";
    private string _editProjectId = "";
    private string _editMode = "Manual";
    private string _editScheduleType = "Once";
    private TimeOnly _editTime = new(9, 0);
    private int _editDayOfWeek = 1;
    private int _editDayOfMonth = 1;
    private string _editCron = "";
    private bool _editEnabled = true;
    private string _editCategory = "";

    private TaskDto? _detail;
    private List<TaskLogDto> _detailLogs = [];
    private Guid? _logTraceOpenId;
    private List<ExecutionStepDto> _logTraceSteps = [];
    private List<ArtifactDto> _logTraceArtifacts = [];

    private string _editSourceType = "Prompt";
    private List<WorkflowStepDto> _editSteps = [];
    private List<WorkflowDto> _workflowTemplates = [];
    private string _editTemplateId = "";

    private string toastMessage = "";
    private string toastType = "info";
    private bool toastVisible;

    protected override async Task OnInitializedAsync()
    {
        await LoadAgentsAsync();
        await LoadProjectsAsync();
        await LoadWorkflowTemplatesAsync();
        await LoadTasksAsync();
    }

    private async Task LoadAgentsAsync()
    {
        try
        {
            _agents = (await AgentAppService.GetListAsync(new AgentQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            ShowToast($"加载员工失败: {ex.Message}", "error");
        }
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            _projects = (await ProjectAppService.GetListAsync(new WorkbenchProjectQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
        }
        catch { }
    }

    private async Task LoadWorkflowTemplatesAsync()
    {
        try
        {
            _workflowTemplates = (await WorkflowAppService.GetListAsync(new WorkflowQueryDto
            {
                IsEnabled = true,
                MaxResultCount = 100
            })).Data?.Items.ToList() ?? [];
        }
        catch { }
    }

    /// <summary>
    /// 选用员工工作流模板：深拷贝步骤进编辑器，改任务不影响模板本身
    /// </summary>
    private void ApplyWorkflowTemplate()
    {
        if (!Guid.TryParse(_editTemplateId, out var id)) return;
        var template = _workflowTemplates.FirstOrDefault(t => t.Id == id);
        if (template is null) return;

        _editSteps = template.Steps.Select(s => new WorkflowStepDto
        {
            Id = string.IsNullOrWhiteSpace(s.Id) ? Guid.NewGuid().ToString("N")[..8] : s.Id,
            Name = s.Name,
            Prompt = s.Prompt,
            AgentType = s.AgentType,
            RequireApproval = s.RequireApproval,
            OnFailure = s.OnFailure,
            OutputVar = s.OutputVar
        }).ToList();

        if (!string.IsNullOrWhiteSpace(template.AgentType))
        {
            _editAgentType = template.AgentType;
        }
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        try
        {
            var result = (await TaskAppService.GetListAsync(new TaskQueryDto
            {
                Filter = string.IsNullOrWhiteSpace(_filter) ? null : _filter,
                TaskType = _type == "all" ? null : _type,
                Status = string.IsNullOrWhiteSpace(_status) ? null : _status,
                AgentType = string.IsNullOrWhiteSpace(_agentType) ? null : _agentType,
                MaxResultCount = 100
            })).Data;
            _tasks = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            ShowToast($"加载任务失败: {ex.Message}", "error");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnterKeyAsync() => await LoadTasksAsync();

    private async Task SwitchType(string type)
    {
        _type = type;
        await LoadTasksAsync();
    }

    private string AgentName(string agentType)
    {
        if (string.IsNullOrWhiteSpace(agentType))
        {
            return "未分配";
        }

        return _agents.FirstOrDefault(x => x.AgentType == agentType)?.DisplayName ?? agentType;
    }

    private static string StatusText(TaskDto task)
        => task.Status switch
        {
            "Active" => "进行中",
            "Paused" => "已暂停",
            "Completed" => "已完成",
            _ => task.Status
        };

    private void ShowCreate()
    {
        if (!_agents.Any())
        {
            ShowToast("请先创建员工", "warning");
            return;
        }

        _editId = null;
        _editName = "";
        _editDescription = "";
        _editPrompt = "";
        _editAcceptance = "";
        _editAgentType = _agents[0].AgentType;
        _editProjectId = "";
        _editMode = _type == "scheduled" ? "Auto" : "Manual";
        _editScheduleType = "Once";
        _editTime = new TimeOnly(9, 0);
        _editDayOfWeek = 1;
        _editDayOfMonth = 1;
        _editCron = "";
        _editEnabled = true;
        _editCategory = "";
        _editSourceType = "Prompt";
        _editSteps = [];
        _editTemplateId = "";
        _showDialog = true;
    }

    private void ShowEdit(TaskDto task)
    {
        _editId = task.Id;
        _editName = task.TaskName;
        _editDescription = task.TaskDescription;
        _editPrompt = task.PromptContent;
        _editAcceptance = task.AcceptanceCriteria ?? "";
        _editAgentType = task.AgentType;
        _editProjectId = task.ProjectId?.ToString() ?? "";
        _editMode = task.ExecutionMode;
        // 原样回填调度配置（非法值才回退 Once），不再把 Weekly/Monthly/Cron 静默折叠
        _editScheduleType = task.ScheduleType is "Once" or "Daily" or "Weekly" or "Monthly" or "Cron"
            ? task.ScheduleType : "Once";
        _editTime = new TimeOnly(task.Hour ?? 9, task.Minute ?? 0);
        _editDayOfWeek = task.DayOfWeek ?? 1;
        _editDayOfMonth = task.DayOfMonth ?? 1;
        _editCron = task.CronExpression ?? "";
        _editEnabled = task.IsEnabled;
        _editCategory = task.Category;
        _editSourceType = task.SourceType == "Workflow" ? "Workflow" : "Prompt";
        _editSteps = ParseWorkflowSteps(task.WorkflowContent);
        _editTemplateId = "";
        _showDialog = true;
    }

    private static List<WorkflowStepDto> ParseWorkflowSteps(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<WorkflowStepDto>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
        }
        catch
        {
            return [];
        }
    }

    private void OnSwitchToWorkflow()
    {
        _editSourceType = "Workflow";
        if (_editSteps.Count == 0)
        {
            _editSteps.Add(NewStep());
            if (!string.IsNullOrWhiteSpace(_editPrompt))
            {
                _editSteps[0].Name = "步骤 1";
                _editSteps[0].Prompt = _editPrompt.Trim();
            }
        }
    }

    private static WorkflowStepDto NewStep() => new()
    {
        Id = Guid.NewGuid().ToString("N")[..8],
        Name = "",
        Prompt = "",
        OnFailure = "Stop"
    };

    private void AddStep() => _editSteps.Add(NewStep());

    private void MoveStep(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _editSteps.Count) return;
        (_editSteps[index], _editSteps[target]) = (_editSteps[target], _editSteps[index]);
    }

    private void CloseDialog() => _showDialog = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName)) { ShowToast("请输入任务名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(_editAgentType)) { ShowToast("请选择执行员工", "warning"); return; }

        string promptContent;
        string? workflowContent = null;
        if (_editSourceType == "Workflow")
        {
            if (_editSteps.Count == 0 || _editSteps.Any(s => string.IsNullOrWhiteSpace(s.Name) || string.IsNullOrWhiteSpace(s.Prompt)))
            {
                ShowToast("工作流每个步骤都需要名称与任务提示词", "warning");
                return;
            }
            workflowContent = System.Text.Json.JsonSerializer.Serialize(_editSteps,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
            promptContent = string.Join(" → ", _editSteps.Select(s => s.Name.Trim()));
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_editPrompt)) { ShowToast("请输入任务内容", "warning"); return; }
            promptContent = _editPrompt.Trim();
        }

        _saving = true;
        try
        {
            var scheduleType = _editMode == "Manual" ? "Once" : _editScheduleType;
            var usesTime = _editMode == "Auto" && _editScheduleType is "Daily" or "Weekly" or "Monthly";
            var hour = usesTime ? _editTime.Hour : (int?)null;
            var minute = usesTime ? _editTime.Minute : (int?)null;
            var dayOfWeek = _editMode == "Auto" && _editScheduleType == "Weekly" ? _editDayOfWeek : (int?)null;
            var dayOfMonth = _editMode == "Auto" && _editScheduleType == "Monthly"
                ? Math.Clamp(_editDayOfMonth, 1, 31) : (int?)null;
            var cron = _editMode == "Auto" && _editScheduleType == "Cron" ? _editCron.Trim() : null;
            var projectId = Guid.TryParse(_editProjectId, out var pid) ? pid : (Guid?)null;

            if (_editId is null)
            {
                await TaskAppService.CreateAsync(new CreateTaskDto
                {
                    TaskName = _editName.Trim(),
                    TaskDescription = _editDescription.Trim(),
                    Category = _editCategory,
                    SourceType = _editSourceType,
                    WorkflowContent = workflowContent,
                    PromptContent = promptContent,
                    AcceptanceCriteria = string.IsNullOrWhiteSpace(_editAcceptance) ? null : _editAcceptance.Trim(),
                    AgentType = _editAgentType,
                    ProjectId = projectId,
                    ExecutionMode = _editMode,
                    ScheduleType = scheduleType,
                    CronExpression = cron,
                    Hour = hour,
                    Minute = minute,
                    DayOfWeek = dayOfWeek,
                    DayOfMonth = dayOfMonth,
                    IsEnabled = true
                });
                ShowToast("任务已创建", "success");
            }
            else
            {
                await TaskAppService.UpdateAsync(_editId.Value, new UpdateTaskDto
                {
                    TaskName = _editName.Trim(),
                    TaskDescription = _editDescription.Trim(),
                    Category = _editCategory,
                    SourceType = _editSourceType,
                    WorkflowContent = workflowContent,
                    PromptContent = promptContent,
                    AcceptanceCriteria = string.IsNullOrWhiteSpace(_editAcceptance) ? null : _editAcceptance.Trim(),
                    AgentType = _editAgentType,
                    ProjectId = projectId,
                    ExecutionMode = _editMode,
                    ScheduleType = scheduleType,
                    CronExpression = cron,
                    Hour = hour,
                    Minute = minute,
                    DayOfWeek = dayOfWeek,
                    DayOfMonth = dayOfMonth,
                    IsEnabled = _editEnabled
                });
                ShowToast("任务已更新", "success");
            }

            _showDialog = false;
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"保存失败: {ex.Message}", "error");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowDetailAsync(TaskDto task)
    {
        _detail = task;
        _detailLogs = [];
        _logTraceOpenId = null;
        _logTraceSteps = [];
        try
        {
            _detailLogs = (await TaskAppService.GetExecutionLogsAsync(task.Id, 20)).Data ?? [];
        }
        catch { }
    }

    private async Task ToggleLogTraceAsync(TaskLogDto log)
    {
        if (_logTraceOpenId == log.Id)
        {
            _logTraceOpenId = null;
            return;
        }

        try
        {
            var trace = (await TaskAppService.GetLogTraceAsync(log.Id)).Data;
            _logTraceSteps = trace?.Steps ?? [];
            _logTraceArtifacts = trace?.Artifacts ?? [];
            _logTraceOpenId = log.Id;
        }
        catch (Exception ex)
        {
            ShowToast($"加载执行轨迹失败: {ex.Message}", "error");
        }
    }

    private async Task ExecuteAsync(TaskDto task)
    {
        try
        {
            await TaskAppService.ExecuteNowAsync(task.Id);
            ShowToast("已触发执行", "success");
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"执行失败: {ex.Message}", "error");
        }
    }

    private async Task ExecuteFromDetailAsync()
    {
        if (_detail is null) return;
        var taskId = _detail.Id;
        _detail = null;
        var task = _tasks.FirstOrDefault(t => t.Id == taskId);
        if (task is not null)
        {
            await ExecuteAsync(task);
        }
    }

    private async Task ToggleEnableAsync(TaskDto task)
    {
        try
        {
            await TaskAppService.ToggleEnableAsync(task.Id);
            ShowToast(task.IsEnabled ? "任务已停用" : "任务已启用", "success");
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"操作失败: {ex.Message}", "error");
        }
    }

    private async Task DeleteAsync(TaskDto task)
    {
        try
        {
            await TaskAppService.DeleteAsync(task.Id);
            ShowToast("任务已删除", "success");
            await LoadTasksAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}

