<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.Assistant.UI.Views.ChatInputView"
             x:Name="Root">
  <Panel>
    <!-- 无边框输入容器，浅灰底色区分区域，铺满宽度 -->
    <Border CornerRadius="0" Padding="10,8" Background="#f7f7f8">
      <DockPanel>
        <!-- 底部工具栏 -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <!-- 智能体选择 -->
            <Button Classes="selectorBtn" Command="{Binding ToggleAgentDropdownCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding SelectedAgentDisplayName}" FontSize="13" />
                <TextBlock Text="▾" FontSize="11" />
              </StackPanel>
            </Button>
            <!-- 模型选择 -->
            <Button Classes="selectorBtn" Command="{Binding ToggleModelDropdownCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding SelectedModelDisplay}" FontSize="13" />
                <TextBlock Text="▾" FontSize="11" />
              </StackPanel>
            </Button>
            <!-- 分隔线 -->
            <Border Width="1" Height="14" Background="#d0d0d0" VerticalAlignment="Center" />
            <!-- 更多功能 -->
            <Button Classes="ghostIcon" ToolTip.Tip="更多功能">
              <TextBlock Text="☰" FontSize="13" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <!-- 停止按钮 -->
            <Button Width="30" Height="30" Padding="0" CornerRadius="4"
                    Background="#ef5350" Foreground="White" BorderThickness="0"
                    IsVisible="{Binding IsSending}" Command="{Binding StopCommand}"
                    ToolTip.Tip="停止生成"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <TextBlock Text="■" FontSize="12" />
            </Button>
            <!-- 发送按钮 -->
            <Button Width="30" Height="30" Padding="0" CornerRadius="4"
                    Background="#fafafa" Foreground="#595959" BorderThickness="0"
                    IsVisible="{Binding !IsSending}" Command="{Binding SendCommand}"
                    ToolTip.Tip="发送"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <TextBlock Text="➤" FontSize="14" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 输入框 -->
        <TextBox Name="InputBox"
                 Text="{Binding InputMessage, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="80" MaxHeight="300"
                 Watermark="描述计划，@ 引用上下文，/ 使用命令"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="14"
                 Padding="8,6"
                 VerticalContentAlignment="Top" />
      </DockPanel>
    </Border>

    <!-- 智能体下拉（向上弹出） -->
    <Border IsVisible="{Binding ShowAgentDropdown}"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="6,0,0,46" MinWidth="120" MaxHeight="240"
            Background="#ffffff" BorderBrush="#e0e0e0" BorderThickness="1"
            CornerRadius="3" Padding="3" BoxShadow="0 2 10 0 #1a000000">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding AvailableAgents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="dropdownItem"
                      Command="{Binding DataContext.SelectAgentCommand, ElementName=Root}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding DisplayName}" FontSize="13" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 模型下拉（向上弹出） -->
    <Border IsVisible="{Binding ShowModelDropdown}"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="100,0,0,46" MinWidth="160" MaxHeight="240"
            Background="#ffffff" BorderBrush="#e0e0e0" BorderThickness="1"
            CornerRadius="3" Padding="3" BoxShadow="0 2 10 0 #1a000000">
      <ScrollViewer>
        <Panel>
          <ItemsControl ItemsSource="{Binding AvailableModels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="dropdownItem"
                        Command="{Binding DataContext.SelectModelCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding ProviderDisplayName}" FontSize="13" />
                    <TextBlock Text="{Binding Model, StringFormat='({0})'}" FontSize="13" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </ScrollViewer>
    </Border>
  </Panel>

  <UserControl.Styles>
    <!-- 输入框去除聚焦/悬停时的高亮边框与背景变化 -->
    <Style Selector="TextBox#InputBox /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox#InputBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox#InputBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.selectorBtn">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.selectorBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#333333" />
    </Style>
    <Style Selector="Button.dropdownItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#444444" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.dropdownItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f5f5f5" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
  </UserControl.Styles>
</UserControl>
