<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:H.Assistant.UI.Controls"
             x:Class="H.Assistant.UI.Views.KnowledgeSectionView">
  <Grid ColumnDefinitions="280,*">
    <!-- ========== 左侧树面板 ========== -->
    <Border Grid.Column="0" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Padding="12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="btn small" Content="+ 目录" ToolTip.Tip="新建目录"
                    Command="{Binding CreateRootNodeCommand}" CommandParameter="Directory" />
            <Button Classes="btn small" Content="{Binding DocumentButtonText}" ToolTip.Tip="新建文档"
                    Command="{Binding CreateRootNodeCommand}" CommandParameter="Document" />
          </StackPanel>
        </Border>

        <Panel Margin="8">
          <!-- 树 -->
          <TreeView Name="Tree" ItemsSource="{Binding TreeNodes}" IsVisible="{Binding HasNodes}"
                    SelectionChanged="OnTreeSelectionChanged" Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                  <!-- 标题 / 重命名 -->
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}"
                             DoubleTapped="OnTitleDoubleTapped" Background="Transparent" Padding="0,4" />
                  <TextBox Grid.Column="0" Text="{Binding RenamingTitle, Mode=TwoWay}" FontSize="13"
                           IsVisible="{Binding IsRenaming}" MinHeight="24" Padding="6,2"
                           BorderBrush="#1890ff" BorderThickness="1" CornerRadius="3"
                           AttachedToVisualTree="OnRenameBoxAttached"
                           KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" />
                  <!-- 更多操作 -->
                  <Button Grid.Column="1" Classes="ghostIcon" Padding="4,0" ToolTip.Tip="更多操作"
                          IsVisible="{Binding !IsRenaming}">
                    <TextBlock Text="⋯" FontSize="14" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="+ 新建子目录" IsVisible="{Binding IsDirectory}"
                                  Command="{Binding Section.CreateChildDirectoryCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="+ 新建子文档" IsVisible="{Binding IsDirectory}"
                                  Command="{Binding Section.CreateChildDocumentCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="✎ 重命名" Command="{Binding StartRenameCommand}" />
                        <MenuItem Header="× 删除" Foreground="#ff4d4f"
                                  Command="{Binding Section.DeleteNodeCommand}" CommandParameter="{Binding}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <!-- 空状态 -->
          <StackPanel IsVisible="{Binding !HasNodes}" HorizontalAlignment="Center" Margin="16,40" Spacing="8">
            <TextBlock Text="{Binding EmptyText}" Foreground="#8c8c8c" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyHint}" FontSize="12" Foreground="#bfbfbf" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- ========== 右侧内容面板（对应 ContentPanel） ========== -->
    <Panel Grid.Column="1" Background="#ffffff">
      <!-- 空态 -->
      <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="📝" FontSize="44" Opacity="0.5" HorizontalAlignment="Center" />
        <TextBlock Text="选择一个文档查看或编辑内容" Foreground="#8c8c8c" />
      </StackPanel>

      <DockPanel IsVisible="{Binding HasSelection}">
        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1" MinHeight="52">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding SelectedTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="#262626" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !IsEditingTitle}" DoubleTapped="OnPanelTitleDoubleTapped"
                       Background="Transparent" />
            <TextBox Grid.Column="0" Text="{Binding EditingTitle, Mode=TwoWay}" FontSize="16" FontWeight="SemiBold"
                     IsVisible="{Binding IsEditingTitle}" BorderBrush="#1890ff" BorderThickness="1" CornerRadius="4"
                     KeyDown="OnPanelTitleKeyDown" LostFocus="OnPanelTitleLostFocus" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding SelectedIsDocument}">
              <Button Classes="blueBtn" Content="预览" IsVisible="{Binding IsEditing}" Command="{Binding TogglePreviewCommand}" />
              <Button Classes="bluePrimary" Content="保存" IsVisible="{Binding IsEditing}" Command="{Binding SaveContentCommand}" />
              <Button Classes="bluePrimary" Content="编辑" IsVisible="{Binding !IsEditing}" Command="{Binding StartEditCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 内容区 -->
        <Panel Margin="16">
          <!-- 编辑器 -->
          <TextBox IsVisible="{Binding IsEditing}" Text="{Binding EditingContent, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300"
                   FontFamily="Consolas,Monaco,Courier New" FontSize="14"
                   Background="#fafafa" BorderBrush="#e8e8e8" CornerRadius="6"
                   Watermark="在此输入 Markdown 内容..." VerticalContentAlignment="Top" />
          <!-- 预览 -->
          <ScrollViewer IsVisible="{Binding !IsEditing}">
            <Panel>
              <controls:MarkdownTextView Markdown="{Binding SelectedContent}" IsVisible="{Binding HasContent}" />
              <TextBlock Text="暂无内容" Foreground="#8c8c8c" HorizontalAlignment="Center" Margin="0,40"
                         IsVisible="{Binding ShowEmptyContentHint}" />
            </Panel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Panel>
  </Grid>

  <UserControl.Styles>
    <!-- 蓝色系按钮（对应 ContentPanel btn-sm） -->
    <Style Selector="Button.blueBtn">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#d9d9d9" />
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="Foreground" Value="#595959" />
    </Style>
    <Style Selector="Button.blueBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#1890ff" />
      <Setter Property="Foreground" Value="#1890ff" />
      <Setter Property="Background" Value="#ffffff" />
    </Style>
    <Style Selector="Button.bluePrimary">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1890ff" />
      <Setter Property="Background" Value="#1890ff" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.bluePrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40a9ff" />
      <Setter Property="BorderBrush" Value="#40a9ff" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>

    <!-- 树节点选中样式 -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#e6f7ff" />
    </Style>
  </UserControl.Styles>
</UserControl>
