<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.Assistant.UI.Views.AgentSettingsView"
             x:Name="AgentRoot">
  <Panel>
    <ScrollViewer Padding="24">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <TextBlock Grid.Column="0" Text="智能体管理" FontSize="20" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="btn assistantPrimary small" Command="{Binding ShowAddCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="＋" /><TextBlock Text="新建智能体" />
            </StackPanel>
          </Button>
        </Grid>
        <Border Height="1" Background="#e8e8e8" Margin="0,0,0,24" />

        <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
          <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Agents}" IsVisible="{Binding HasAgents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,0,12" ClipToBounds="True">
                <StackPanel>
                  <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="tag tagBlue"><TextBlock Text="{Binding AgentType}" /></Border>
                        <Border Classes="tag tagGreen" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                        <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Classes="link small" Content="{Binding ToggleText}"
                                Command="{Binding DataContext.ToggleCommand, ElementName=AgentRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small" Content="编辑"
                                Command="{Binding DataContext.EditCommand, ElementName=AgentRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small danger" Content="删除"
                                Command="{Binding DataContext.DeleteCommand, ElementName=AgentRoot}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Margin="16,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="描述:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#595959" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="温度:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding TemperatureText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="MaxTokens:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding MaxTokensText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="流式:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding StreamingText}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSkills}">
                      <TextBlock Text="关联技能:" FontSize="13" Foreground="#8c8c8c" VerticalAlignment="Center" />
                      <ItemsControl ItemsSource="{Binding SkillNames}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="tag tagBlue" Margin="0,0,6,4"><TextBlock Text="{Binding}" /></Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Loading" /><Binding Path="!HasAgents" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
          <TextBlock Text="暂无智能体,点击新建按钮新增" Foreground="#8c8c8c" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 对话框 ========== -->
    <Panel IsVisible="{Binding ShowDialog}">
      <Border Background="#73000000" PointerPressed="OnOverlayPressed" />
      <Border Background="#ffffff" CornerRadius="8" Width="600" MaxWidth="600" MaxHeight="760"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DialogTitle}" FontSize="16" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding CloseDialogCommand}">
                <TextBlock Text="✕" FontSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="24,16" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="modalCancel" Content="取消" Command="{Binding CloseDialogCommand}" />
              <Button Classes="modalPrimary" Content="{Binding DialogSaveText}" IsEnabled="{Binding !Saving}" Command="{Binding SaveCommand}" />
            </StackPanel>
          </Border>
          <ScrollViewer Padding="24,20">
            <StackPanel Spacing="14">
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="类型标识" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditAgentType, Mode=TwoWay}" Watermark="如: general"
                         IsEnabled="{Binding AgentTypeEditable}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="显示名称" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditDisplayName, Mode=TwoWay}" Watermark="如: 通用助手" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="描述" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditDescription, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" Watermark="描述智能体的功能和用途" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="系统提示词" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditSystemPrompt, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="120" Watermark="输入系统提示词" />
              </StackPanel>
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="formLabel" Text="温度 (0-1)" />
                  <NumericUpDown Classes="modalInput" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.0"
                                 Value="{Binding EditTemperature, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="formLabel" Text="MaxTokens" />
                  <NumericUpDown Classes="modalInput" Minimum="1" FormatString="0"
                                 Value="{Binding EditMaxTokens, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <CheckBox Content="支持流式响应" IsChecked="{Binding EditSupportsStreaming, Mode=TwoWay}" />
              <CheckBox Content="启用" IsChecked="{Binding EditIsEnabled, Mode=TwoWay}" />
              <StackPanel>
                <TextBlock Classes="formLabel" Text="技能选择" />
                <TextBox Classes="modalInput" Text="{Binding SkillSearchText, Mode=TwoWay}" Watermark="搜索技能..." Margin="0,0,0,8" />
                <Border BorderBrush="#d9d9d9" BorderThickness="1" CornerRadius="6" Background="#fafafa"
                        MaxHeight="280" Padding="12">
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredSkills}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Panel>
                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#8c8c8c" Margin="0,4"
                                       IsVisible="{Binding IsGroupHeader}" />
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsVisible="{Binding IsCheckable}" Padding="8,4" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="默认模型 (可选)" />
                <ComboBox Classes="modalSelect" ItemsSource="{Binding LlmOptions}"
                          SelectedItem="{Binding EditDefaultModel, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>
