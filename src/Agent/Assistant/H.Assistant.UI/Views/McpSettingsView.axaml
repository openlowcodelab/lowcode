<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.Assistant.UI.Views.McpSettingsView"
             x:Name="McpRoot">
  <Panel>
    <ScrollViewer Padding="24,14,24,24">
      <StackPanel>
        <TextBlock Text="MCP 管理" FontSize="20" Margin="0,0,0,14" />
        <Button Classes="btn assistantPrimary small" HorizontalAlignment="Right" Margin="0,0,0,14"
                Command="{Binding ShowAddCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="＋" /><TextBlock Text="添加" />
          </StackPanel>
        </Button>

        <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
          <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Servers}" IsVisible="{Binding HasServers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,0,12" ClipToBounds="True">
                <StackPanel>
                  <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="tag tagBlue"><TextBlock Text="{Binding TransportType}" /></Border>
                        <Border Classes="tag tagGreen" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                        <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Classes="link small" Content="{Binding ToggleText}"
                                Command="{Binding DataContext.ToggleCommand, ElementName=McpRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small" Content="编辑"
                                Command="{Binding DataContext.EditCommand, ElementName=McpRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small danger" Content="删除"
                                Command="{Binding DataContext.DeleteCommand, ElementName=McpRoot}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Margin="16,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="名称:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="端点:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Endpoint}" FontSize="13" Foreground="#595959" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="超时:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding TimeoutText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="Token:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" IsVisible="{Binding HasAuthToken}" />
                      <TextBlock Text="{Binding MaskedAuthToken}" FontSize="13" Foreground="#595959" IsVisible="{Binding HasAuthToken}" />
                      <TextBlock Text="API Key:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" IsVisible="{Binding HasApiKey}" />
                      <TextBlock Text="{Binding MaskedApiKey}" FontSize="13" Foreground="#595959" IsVisible="{Binding HasApiKey}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Loading" /><Binding Path="!HasServers" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
          <TextBlock Text="暂无 MCP 服务配置，点击添加按钮新增" Foreground="#8c8c8c" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 对话框 ========== -->
    <Panel IsVisible="{Binding ShowDialog}">
      <Border Background="#73000000" PointerPressed="OnOverlayPressed" />
      <Border Background="#ffffff" CornerRadius="8" Width="600" MaxWidth="600" MaxHeight="720"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DialogTitle}" FontSize="16" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding CloseDialogCommand}">
                <TextBlock Text="✕" FontSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="24,16" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="modalCancel" Content="取消" Command="{Binding CloseDialogCommand}" />
              <Button Classes="modalPrimary" Content="{Binding DialogSaveText}" IsEnabled="{Binding !Saving}" Command="{Binding SaveCommand}" />
            </StackPanel>
          </Border>
          <ScrollViewer Padding="24,20">
            <StackPanel Spacing="14">
              <StackPanel IsVisible="{Binding ShowNameField}">
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="名称" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditName, Mode=TwoWay}" Watermark="英文标识，如 yunxiao" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="显示名称" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditDisplayName, Mode=TwoWay}" Watermark="如：云效项目管理" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="端点 URL" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditEndpoint, Mode=TwoWay}" Watermark="如：http://localhost:8080/mcp" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="传输方式" /></TextBlock>
                <ComboBox Classes="modalSelect" ItemsSource="{Binding TransportOptions}"
                          SelectedItem="{Binding EditTransportType, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="Token" />
                <TextBox Classes="modalInput" Text="{Binding EditAuthToken, Mode=TwoWay}" Watermark="Bearer Token（可选）" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="API Key" />
                <TextBox Classes="modalInput" Text="{Binding EditApiKey, Mode=TwoWay}" Watermark="API Key（可选）" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="自定义请求头 (JSON)" />
                <TextBox Classes="modalInput" Text="{Binding EditHeaders, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" Watermark='可选，如 {"X-Custom": "value"}' />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="超时（秒）" />
                <NumericUpDown Classes="modalInput" Minimum="1" Maximum="300" FormatString="0"
                               Value="{Binding EditTimeoutSeconds, Mode=TwoWay}" />
              </StackPanel>
              <CheckBox Content="启用" IsChecked="{Binding EditIsEnabled, Mode=TwoWay}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>
