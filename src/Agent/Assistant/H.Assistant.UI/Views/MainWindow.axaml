<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="H.Assistant.UI.Views.MainWindow"
        Title="Agent 助手"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI, Inter"
        FontSize="14"
        Foreground="#262626"
        Background="#ffffff">
  <Panel>
    <!-- ========== 主布局：会话侧栏 + 页面内容（对应 ChatLayout） ========== -->
    <Grid ColumnDefinitions="280,*" IsVisible="{Binding !IsSettingsPage}">
      <!-- 会话侧栏 -->
      <Border Grid.Column="0" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- 顶部：新建会话 -->
          <Border DockPanel.Dock="Top" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1" Padding="16">
            <Button Classes="iconBtn" HorizontalAlignment="Right" Command="{Binding NewChatCommand}"
                    ToolTip.Tip="新建会话">
              <TextBlock Text="＋" FontSize="16" />
            </Button>
          </Border>

          <!-- 定时任务菜单项 -->
          <Button DockPanel.Dock="Top" Classes="sideMenuItem"
                  Classes.sideMenuActive="{Binding IsTasksPage}"
                  Command="{Binding GoToTasksCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🕒" FontSize="14" />
              <TextBlock Text="定时任务" />
            </StackPanel>
          </Button>

          <!-- 会话标题 -->
          <Button DockPanel.Dock="Top" Classes="sectionTitle" Command="{Binding GoToChatCommand}"
                  IsHitTestVisible="{Binding SessionTitleClickable}">
            <TextBlock Text="会话" />
          </Button>

          <!-- 用户区域（底部） -->
          <Border DockPanel.Dock="Bottom" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0" Padding="12,8" Background="#fafafa">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#bfbfbf">
                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="未登录" VerticalAlignment="Center" Margin="8,0" />
              <Button Grid.Column="2" Classes="ghostIcon" Width="28" Height="28">
                <TextBlock Text="⚙" FontSize="14" />
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedLeft">
                    <MenuItem Header="设置" Command="{Binding GoToSettingsCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>

          <!-- 知识中心菜单项（底部） -->
          <Button DockPanel.Dock="Bottom" Classes="sideMenuItem"
                  Classes.sideMenuActive="{Binding IsKnowledgePage}"
                  Command="{Binding GoToKnowledgeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="📖" FontSize="14" />
              <TextBlock Text="知识中心" />
            </StackPanel>
          </Button>

          <!-- 会话列表 -->
          <ScrollViewer>
            <Panel Margin="8">
              <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding HasSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="sessionItem"
                            Classes.sessionItemActive="{Binding IsSelected}"
                            Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding MessageCountText}" FontSize="12" Foreground="#8c8c8c" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="12" Foreground="#8c8c8c" />
                          </Grid>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghostIcon" VerticalAlignment="Top" ToolTip.Tip="更多操作">
                          <TextBlock Text="⋮" FontSize="14" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="删除" Foreground="#ff4d4f" Command="{Binding DeleteCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 空状态 -->
              <StackPanel IsVisible="{Binding !HasSessions}" HorizontalAlignment="Center" Margin="20,60" Spacing="12">
                <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
                <TextBlock Text="暂无会话" Foreground="#8c8c8c" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 右侧页面内容 -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>

    <!-- ========== 设置页（全屏，对应 AssistantLayout 的 Settings 页面） ========== -->
    <ContentControl Content="{Binding Settings}" IsVisible="{Binding IsSettingsPage}" />

    <!-- ========== Toast ========== -->
    <Border IsVisible="{Binding Toast.IsVisible}"
            Background="{Binding Toast.Background}"
            CornerRadius="6" Padding="16,10"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
            BoxShadow="0 2 8 0 #33000000">
      <TextBlock Text="{Binding Toast.Message}" Foreground="White" FontSize="13" />
    </Border>
  </Panel>

  <Window.Styles>
    <!-- 侧栏菜单项 -->
    <Style Selector="Button.sideMenuItem">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#595959" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.sideMenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
      <Setter Property="Foreground" Value="#262626" />
    </Style>
    <Style Selector="Button.sideMenuActive">
      <Setter Property="Background" Value="#e6f7ff" />
      <Setter Property="Foreground" Value="#1890ff" />
    </Style>
    <Style Selector="Button.sideMenuActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#e6f7ff" />
      <Setter Property="Foreground" Value="#1890ff" />
    </Style>

    <!-- 会话分区标题 -->
    <Style Selector="Button.sectionTitle">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#8c8c8c" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.sectionTitle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
      <Setter Property="Foreground" Value="#1890ff" />
    </Style>

    <!-- 会话项 -->
    <Style Selector="Button.sessionItem">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="#262626" />
    </Style>
    <Style Selector="Button.sessionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
    </Style>
    <Style Selector="Button.sessionItemActive">
      <Setter Property="Background" Value="#f2f2f2" />
    </Style>
  </Window.Styles>
</Window>
