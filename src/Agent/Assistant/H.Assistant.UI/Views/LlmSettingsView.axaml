<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="H.Assistant.UI.Views.LlmSettingsView"
             x:Name="LlmRoot">
  <Panel>
    <ScrollViewer Padding="24,14,24,24">
      <StackPanel>
        <!-- 标题与窗口按钮同水平，操作按钮下移一行避开窗口按钮 -->
        <TextBlock Text="模型管理" FontSize="20" Margin="0,0,0,14" />
        <Button Classes="btn assistantPrimary small" HorizontalAlignment="Right" Margin="0,0,0,14"
                Command="{Binding ShowAddCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="＋" />
            <TextBlock Text="添加" />
          </StackPanel>
        </Button>

        <!-- 加载中 -->
        <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
          <TextBlock Text="加载中..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 卡片列表（两列） -->
        <ItemsControl ItemsSource="{Binding Configs}" IsVisible="{Binding HasConfigs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="6" ClipToBounds="True">
                <StackPanel>
                  <!-- 卡片头 -->
                  <Border Background="#fafafa" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProviderDisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="tag tagGreen" IsVisible="{Binding IsDefault}"><TextBlock Text="默认" /></Border>
                        <Border Classes="tag tagBlue" IsVisible="{Binding IsEnabled}"><TextBlock Text="已启用" /></Border>
                        <Border Classes="tag tagDefault" IsVisible="{Binding !IsEnabled}"><TextBlock Text="已禁用" /></Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                        <Button Classes="link small" Content="设为默认" IsVisible="{Binding IsNotDefault}"
                                Command="{Binding DataContext.SetDefaultCommand, ElementName=LlmRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small" Content="编辑"
                                Command="{Binding DataContext.EditCommand, ElementName=LlmRoot}" CommandParameter="{Binding}" />
                        <Button Classes="link small danger" Content="删除"
                                Command="{Binding DataContext.DeleteCommand, ElementName=LlmRoot}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <!-- 卡片体 -->
                  <StackPanel Margin="16,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Provider:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding ProviderName}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="模型:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding Model}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="API Key:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding MaskedApiKey}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBaseUrl}">
                      <TextBlock Text="Base URL:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding BaseUrl}" FontSize="13" Foreground="#595959" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="MaxTokens:" FontSize="13" Foreground="#8c8c8c" />
                      <TextBlock Text="{Binding MaxTokensText}" FontSize="13" Foreground="#595959" />
                      <TextBlock Text="Temperature:" FontSize="13" Foreground="#8c8c8c" Margin="10,0,0,0" />
                      <TextBlock Text="{Binding TemperatureText}" FontSize="13" Foreground="#595959" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <StackPanel HorizontalAlignment="Center" Margin="0,60" Spacing="12">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Loading" />
              <Binding Path="!HasConfigs" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
          <TextBlock Text="暂无模型配置，点击添加按钮新增" Foreground="#8c8c8c" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ========== 添加/编辑对话框 ========== -->
    <Panel IsVisible="{Binding ShowDialog}">
      <Border Background="#73000000" PointerPressed="OnOverlayPressed" />
      <Border Background="#ffffff" CornerRadius="8" Width="460" MaxHeight="640"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DialogTitle}" FontSize="16" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding CloseDialogCommand}">
                <TextBlock Text="✕" FontSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Classes="modalCancel" Content="取消" Command="{Binding CloseDialogCommand}" />
              <Button Classes="modalPrimary" Content="{Binding DialogSaveText}" IsEnabled="{Binding !Saving}"
                      Command="{Binding SaveCommand}" />
            </StackPanel>
          </Border>
          <ScrollViewer Padding="24,20,24,12">
            <StackPanel Spacing="14">
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="提供商" /></TextBlock>
                <ComboBox Classes="modalSelect" ItemsSource="{Binding ProviderDefs}"
                          SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="类型" /></TextBlock>
                <ComboBox Classes="modalSelect" ItemsSource="{Binding CurrentProviderTypes}"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="模型Id" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditModel, Mode=TwoWay}" Watermark="选择模型" />
                <ItemsControl ItemsSource="{Binding CurrentModels}" IsVisible="{Binding HasModelSuggestions}" Margin="0,6,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="suggestionTag" Margin="0,0,6,6"
                              Command="{Binding DataContext.SelectSuggestedModelCommand, ElementName=LlmRoot}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding}" FontSize="12" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel" Text="请求地址" />
                <TextBox Classes="modalInput" Text="{Binding EditBaseUrl, Mode=TwoWay}" Watermark="留空则使用默认地址" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="* " Foreground="#ff4d4f" /><Run Text="API 密钥" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditApiKey, Mode=TwoWay}" Watermark="API密钥" />
                <Button Classes="link small" Content="获取 API 密钥" HorizontalAlignment="Left"
                        Foreground="#1890ff" Command="{Binding OpenApiKeyUrlCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>

  <UserControl.Styles>
    <Style Selector="Button.suggestionTag">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#d9d9d9" />
      <Setter Property="Background" Value="#fafafa" />
      <Setter Property="Foreground" Value="#595959" />
    </Style>
    <Style Selector="Button.suggestionTag:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
      <Setter Property="BorderBrush" Value="#595959" />
      <Setter Property="Foreground" Value="#262626" />
    </Style>
  </UserControl.Styles>
</UserControl>
