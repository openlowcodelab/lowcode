<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:H.Assistant.UI"
             xmlns:controls="using:H.Assistant.UI.Controls"
             x:Class="H.Assistant.UI.Views.TasksView"
             x:Name="TasksRoot">
  <Panel Background="#ffffff">
    <DockPanel>
      <!-- Tab 栏 -->
      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1" Padding="16,0">
        <StackPanel Orientation="Horizontal">
          <Button Classes="tabItem" Classes.tabItemActive="{Binding IsTasksTab}"
                  Command="{Binding SwitchTabCommand}" CommandParameter="tasks" Content="我的定时任务" />
          <Button Classes="tabItem" Classes.tabItemActive="{Binding IsLogsTab}"
                  Command="{Binding SwitchTabCommand}" CommandParameter="logs" Content="执行记录" />
        </StackPanel>
      </Border>

      <Panel>
        <!-- ========== 我的定时任务 ========== -->
        <DockPanel IsVisible="{Binding IsTasksTab}">
          <Border DockPanel.Dock="Top" Padding="16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="定时任务" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="btn primary" Command="{Binding CreateNewTaskCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="＋" />
                  <TextBlock Text="新建定时任务" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <Panel>
            <!-- 加载中 -->
            <StackPanel IsVisible="{Binding LoadingTasks}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
              <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
              <TextBlock Text="Loading..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 任务卡片列表（两列） -->
            <ScrollViewer IsVisible="{Binding HasTasks}" Padding="16">
              <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="6" Padding="16,14"
                            Opacity="{Binding IsEnabled, Converter={x:Static ui:Converters.EnabledOpacity}}">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding TaskName}" FontWeight="Medium"
                                     Foreground="#262626" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <!-- 启用开关 -->
                          <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0"
                                  Command="{Binding ToggleEnableCommand}" Margin="6,0" VerticalAlignment="Center">
                            <Border Width="32" Height="18" CornerRadius="9"
                                    Background="{Binding IsEnabled, Converter={x:Static ui:Converters.ToggleTrackBrush}}">
                              <Ellipse Width="14" Height="14" Fill="White" Margin="2"
                                       HorizontalAlignment="{Binding IsEnabled, Converter={x:Static ui:Converters.ToggleThumbAlignment}}" />
                            </Border>
                          </Button>
                          <!-- 更多操作 -->
                          <Button Grid.Column="2" Classes="ghostIcon" VerticalAlignment="Center">
                            <TextBlock Text="⋮" FontSize="14" />
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="编辑" Command="{Binding EditTaskCommand}" />
                                <MenuItem Header="立即执行" Command="{Binding ExecuteNowCommand}" />
                                <MenuItem Header="删除任务" Foreground="#ff4d4f" Command="{Binding DeleteCommand}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding TaskDescription}" FontSize="12" Foreground="#8c8c8c"
                                   IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="🕒" FontSize="11" Foreground="#bfbfbf" />
                          <TextBlock Text="{Binding ScheduleDisplayText}" FontSize="12" Foreground="#8c8c8c" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowNextExecution}">
                          <TextBlock Text="⏲" FontSize="11" Foreground="#bfbfbf" />
                          <TextBlock Text="{Binding NextExecutionText}" FontSize="12" Foreground="#8c8c8c" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!LoadingTasks" />
                  <Binding Path="!HasTasks" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <TextBlock Text="📄" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
              <TextBlock Text="暂无定时任务，点击上方按钮创建" Foreground="#8c8c8c" />
            </StackPanel>
          </Panel>
        </DockPanel>

        <!-- ========== 执行记录 ========== -->
        <DockPanel IsVisible="{Binding IsLogsTab}">
          <Border DockPanel.Dock="Top" Padding="16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="执行记录" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="btn small" Content="{Binding SelectAllText}" IsVisible="{Binding IsLogSelectionMode}"
                        Command="{Binding ToggleLogSelectAllCommand}" />
                <Button Classes="btn small danger" Content="删除选中" IsVisible="{Binding IsLogSelectionMode}"
                        IsEnabled="{Binding CanBatchDelete}" Command="{Binding ConfirmBatchDeleteLogsCommand}" />
                <Button Classes="btn small" Content="取消" IsVisible="{Binding IsLogSelectionMode}"
                        Command="{Binding ExitLogSelectionModeCommand}" />
                <Button Classes="btn" Content="多选" IsVisible="{Binding !IsLogSelectionMode}"
                        Command="{Binding ToggleLogSelectionModeCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Panel>
            <!-- 加载中 -->
            <StackPanel IsVisible="{Binding LoadingTaskLogs}" HorizontalAlignment="Center" Margin="0,40" Spacing="12">
              <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="#a6a6a6" />
              <TextBlock Text="Loading..." Foreground="#8c8c8c" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 左右分栏 -->
            <Grid ColumnDefinitions="280,*" IsVisible="{Binding HasLogs}">
              <!-- 左：摘要列表 -->
              <Border Grid.Column="0" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,1,0">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding TaskLogs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="logItem" Classes.logItemActive="{Binding IsSelected}"
                                Command="{Binding DataContext.SelectLogCommand, ElementName=TasksRoot}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsVisible="{Binding DataContext.IsLogSelectionMode, ElementName=TasksRoot}"
                                      VerticalAlignment="Top" Padding="0" MinWidth="0" />
                            <Ellipse Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top"
                                     Fill="{Binding StatusColor, Converter={x:Static ui:Converters.StringToBrush}}" />
                            <StackPanel Spacing="3" MaxWidth="190">
                              <TextBlock Text="{Binding TaskName}" FontSize="13" FontWeight="Medium"
                                         Foreground="#262626" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding StartTimeText}" FontSize="12" Foreground="#8c8c8c" />
                                <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="#bfbfbf"
                                           IsVisible="{Binding HasDuration}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <!-- 右：详情 -->
              <Panel Grid.Column="1">
                <DockPanel IsVisible="{Binding HasSelectedLog}">
                  <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border Grid.Column="0" CornerRadius="4" Padding="8,2" Margin="0,0,10,0"
                              Background="{Binding SelectedLog.StatusBackground, Converter={x:Static ui:Converters.StringToBrush}}">
                        <TextBlock Text="{Binding SelectedLog.StatusText}" FontSize="12" FontWeight="Medium"
                                   Foreground="{Binding SelectedLog.StatusColor, Converter={x:Static ui:Converters.StringToBrush}}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedLog.TaskName}" FontWeight="Medium"
                                 Foreground="#262626" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" FontSize="12" Foreground="#8c8c8c" VerticalAlignment="Center">
                        <Run Text="{Binding SelectedLog.FullStartTimeText}" />
                        <Run Text="{Binding SelectedLog.DurationText}" />
                      </TextBlock>
                    </Grid>
                  </Border>
                  <ScrollViewer Padding="16">
                    <StackPanel Spacing="12">
                      <Border IsVisible="{Binding SelectedLog.HasResult}" Background="#f9f9f9"
                              CornerRadius="6" Padding="16,12">
                        <controls:MarkdownTextView Markdown="{Binding SelectedLog.Result}" />
                      </Border>
                      <Border IsVisible="{Binding SelectedLog.HasError}" Background="#fff1f0"
                              CornerRadius="4" Padding="8">
                        <SelectableTextBlock Text="{Binding SelectedLog.ErrorMessage}" FontSize="13"
                                             Foreground="#ff4d4f" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
                <StackPanel IsVisible="{Binding !HasSelectedLog}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                  <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
                  <TextBlock Text="请选择一条执行记录" Foreground="#8c8c8c" />
                </StackPanel>
              </Panel>
            </Grid>

            <!-- 空状态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!LoadingTaskLogs" />
                  <Binding Path="!HasLogs" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <TextBlock Text="📥" FontSize="40" Foreground="#d9d9d9" HorizontalAlignment="Center" />
              <TextBlock Text="暂无执行记录" Foreground="#8c8c8c" />
            </StackPanel>
          </Panel>
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- ========== 任务创建/编辑对话框 ========== -->
    <Panel IsVisible="{Binding ShowTaskDialog}">
      <Border Background="#80000000" PointerPressed="OnOverlayPressed" />
      <Border Background="#ffffff" CornerRadius="8" MaxWidth="600" MaxHeight="640"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #26000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" />
              <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding CloseTaskDialogCommand}">
                <TextBlock Text="✕" FontSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="modalCancel" Content="取消" Command="{Binding CloseTaskDialogCommand}" />
              <Button Classes="modalPrimary" Content="{Binding DialogSaveText}" Command="{Binding SaveScheduledTaskCommand}" />
            </StackPanel>
          </Border>
          <ScrollViewer Padding="20" MinWidth="520">
            <StackPanel Spacing="16">
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="任务名称 " /><Run Text="*" Foreground="#ff4d4f" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditTaskModel.TaskName, Mode=TwoWay}" Watermark="输入任务名称" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="formLabel"><Run Text="提示词内容 " /><Run Text="*" Foreground="#ff4d4f" /></TextBlock>
                <TextBox Classes="modalInput" Text="{Binding EditTaskModel.PromptContent, Mode=TwoWay}"
                         Watermark="输入要执行的任务内容..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
              </StackPanel>
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="formLabel" Text="Agent 类型" />
                  <ComboBox Classes="modalSelect" ItemsSource="{Binding AvailableAgents}"
                            SelectedItem="{Binding DialogSelectedAgent, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="formLabel" Text="调度类型" />
                  <ComboBox Classes="modalSelect" ItemsSource="{Binding ScheduleTypeOptions}"
                            SelectedItem="{Binding EditTaskModel.ScheduleType, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <!-- 执行时间配置 -->
              <Border IsVisible="{Binding EditTaskModel.ShowTimeConfig}" Background="#f9f9f9"
                      BorderBrush="#e8e8e8" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="执行时间" FontSize="13" FontWeight="Medium" Foreground="#595959" />
                  <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel Grid.Column="0" IsVisible="{Binding EditTaskModel.ShowWeeklyConfig}">
                      <TextBlock Text="星期" FontSize="12" Foreground="#8c8c8c" Margin="0,0,0,4" />
                      <ComboBox Classes="modalSelect" ItemsSource="{Binding DayOfWeekOptions}"
                                SelectedItem="{Binding EditTaskModel.DayOfWeek, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="0" IsVisible="{Binding EditTaskModel.ShowMonthlyConfig}">
                      <TextBlock Text="日期" FontSize="12" Foreground="#8c8c8c" Margin="0,0,0,4" />
                      <NumericUpDown Classes="modalInput" Minimum="1" Maximum="31" FormatString="0"
                                     Value="{Binding EditTaskModel.DayOfMonth, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="小时" FontSize="12" Foreground="#8c8c8c" Margin="0,0,0,4" />
                      <NumericUpDown Classes="modalInput" Minimum="0" Maximum="23" FormatString="0"
                                     Value="{Binding EditTaskModel.Hour, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="分钟" FontSize="12" Foreground="#8c8c8c" Margin="0,0,0,4" />
                      <NumericUpDown Classes="modalInput" Minimum="0" Maximum="59" FormatString="0"
                                     Value="{Binding EditTaskModel.Minute, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Cron 表达式 -->
              <Border IsVisible="{Binding EditTaskModel.ShowCronConfig}" Background="#f9f9f9"
                      BorderBrush="#e8e8e8" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Cron 表达式" FontSize="13" FontWeight="Medium" Foreground="#595959" />
                  <TextBox Classes="modalInput" Text="{Binding EditTaskModel.CronExpression, Mode=TwoWay}"
                           Watermark="例如: 0 */2 * * *" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ========== 批量删除确认对话框 ========== -->
    <Panel IsVisible="{Binding ShowBatchDeleteConfirm}">
      <Border Background="#80000000" />
      <Border Background="#ffffff" CornerRadius="8" Width="400"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 12 0 #26000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="确认批量删除" FontSize="16" FontWeight="SemiBold" />
              <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding CancelBatchDeleteCommand}">
                <TextBlock Text="✕" FontSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="modalCancel" Content="取消" Command="{Binding CancelBatchDeleteCommand}" />
              <Button Classes="modalPrimary" Content="删除" Background="#ff4d4f" Command="{Binding BatchDeleteLogsCommand}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding BatchDeleteMessage}" FontSize="14" Foreground="#595959"
                     TextAlignment="Center" Margin="20,32" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Panel>
  </Panel>

  <UserControl.Styles>
    <Style Selector="Button.logItem">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#f0f0f0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.logItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
    </Style>
    <Style Selector="Button.logItemActive">
      <Setter Property="Background" Value="#e6f7ff" />
      <Setter Property="BorderThickness" Value="3,0,0,1" />
      <Setter Property="BorderBrush" Value="#1890ff" />
    </Style>
    <Style Selector="Button.logItemActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#e6f7ff" />
    </Style>
  </UserControl.Styles>
</UserControl>
