@page "/assistant/resources"

@layout AssistantLayout
@inject ISkillAppService SkillAppService
@inject IConnectorAppService ConnectorAppService
@inject IKnowledgeBaseAppService KnowledgeBaseAppService
@inject IMcpServerAppService McpServerAppService
@inject NavigationManager Navigation

<PageTitle>能力与资源 - AI 工作台</PageTitle>

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">@toastMessage</div>
}

<div class="rs-page">
    <div class="rs-header">
        <h2>能力与资源</h2>
        <button class="btn btn-primary assistant-btn-primary btn-small"
                @onclick='() => Navigation.NavigateTo("/assistant/employees")'>员工管理</button>
    </div>

    <div class="wb-seg" style="max-width:440px;margin-bottom:20px;">
        <div class="wb-seg-item @(_tab == "skill" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("skill")'>Skill</div>
        <div class="wb-seg-item @(_tab == "mcp" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("mcp")'>MCP</div>
        <div class="wb-seg-item @(_tab == "connector" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("connector")'>连接器</div>
        <div class="wb-seg-item @(_tab == "knowledge" ? "wb-seg-active" : "")" @onclick='() => SwitchTab("knowledge")'>知识库</div>
    </div>

    @if (_tab == "skill")
    {
        <div class="rs-section-head">
            <span>技能列表</span>
            <button class="btn btn-link btn-small" @onclick='() => Navigation.NavigateTo("/assistant/skills")'>前往技能管理 →</button>
        </div>
        <div class="rs-rows">
            @foreach (var skill in _skills)
            {
                <div class="rs-row">
                    <span class="rs-row-icon">⚡</span>
                    <div class="rs-row-info">
                        <div class="rs-row-name">@skill.DisplayName <span class="em-role">@skill.SkillType</span></div>
                        <div class="rs-row-desc">@skill.Description</div>
                    </div>
                    <label class="rs-switch">
                        <input type="checkbox" checked="@skill.IsEnabled" @onchange="e => ToggleSkillAsync(skill, e)" />
                        <span class="rs-slider"></span>
                    </label>
                </div>
            }
            @if (!_skills.Any())
            {
                <div class="empty-state"><div class="empty-text">暂无技能</div></div>
            }
        </div>
    }
    else if (_tab == "mcp")
    {
        <div class="rs-section-head">
            <span>MCP 服务列表</span>
            <button class="btn btn-link btn-small" @onclick='() => Navigation.NavigateTo("/assistant/mcps")'>前往 MCP 管理 →</button>
        </div>
        <div class="rs-rows">
            @foreach (var server in _mcpServers)
            {
                <div class="rs-row">
                    <span class="rs-row-icon">🔌</span>
                    <div class="rs-row-info">
                        <div class="rs-row-name">@server.DisplayName <span class="em-role">@server.TransportType</span></div>
                        <div class="rs-row-desc">@server.Endpoint</div>
                    </div>
                    <label class="rs-switch">
                        <input type="checkbox" checked="@server.IsEnabled" @onchange="e => ToggleMcpAsync(server, e)" />
                        <span class="rs-slider"></span>
                    </label>
                </div>
            }
            @if (!_mcpServers.Any())
            {
                <div class="empty-state"><div class="empty-text">暂无 MCP 服务</div></div>
            }
        </div>
    }
    else if (_tab == "connector")
    {
        <div class="rs-section-head">
            <span>自定义</span>
            <button class="btn btn-primary assistant-btn-primary btn-small" @onclick="() => ShowConnectorDialog()">＋ 手动添加</button>
        </div>
        <div class="rs-rows">
            @foreach (var connector in _connectors.Where(x => x.Source == "Custom"))
            {
                <div class="rs-row">
                    <span class="rs-row-icon">@connector.Icon</span>
                    <div class="rs-row-info">
                        <div class="rs-row-name">@connector.ConnectorName</div>
                        <div class="rs-row-desc">@connector.Description</div>
                    </div>
                    <button class="btn btn-link btn-small" @onclick="() => ShowConnectorDialog(connector)">编辑</button>
                    <button class="btn btn-link btn-small btn-danger" @onclick="() => DeleteConnectorAsync(connector)">删除</button>
                    <label class="rs-switch">
                        <input type="checkbox" checked="@connector.IsEnabled" @onchange="e => ToggleConnectorAsync(connector, e)" />
                        <span class="rs-slider"></span>
                    </label>
                </div>
            }
            @if (!_connectors.Any(x => x.Source == "Custom"))
            {
                <div class="empty-state">
                    <div class="empty-icon">🔗</div>
                    <div class="empty-text">暂无自定义连接器，可手动添加或从 JSON 导入。</div>
                </div>
            }
        </div>

        <div class="rs-section-head" style="margin-top:24px;">
            <span>来自连接器市场</span>
        </div>
        <div class="rs-rows">
            @foreach (var connector in _connectors.Where(x => x.Source == "Market"))
            {
                <div class="rs-row">
                    <span class="rs-row-icon">@connector.Icon</span>
                    <div class="rs-row-info">
                        <div class="rs-row-name">@connector.ConnectorName</div>
                        <div class="rs-row-desc">@connector.Description</div>
                    </div>
                    <label class="rs-switch">
                        <input type="checkbox" checked="@connector.IsEnabled" @onchange="e => ToggleConnectorAsync(connector, e)" />
                        <span class="rs-slider"></span>
                    </label>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rs-section-head">
            <span>知识库列表</span>
            <button class="btn btn-link btn-small" @onclick='() => Navigation.NavigateTo("/assistant/knowledge")'>前往知识库管理 →</button>
        </div>
        <div class="rs-rows">
            @foreach (var kb in _knowledgeBases)
            {
                <div class="rs-row" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo($"/assistant/knowledge/{kb.Id}")'>
                    <span class="rs-row-icon">📚</span>
                    <div class="rs-row-info">
                        <div class="rs-row-name">@kb.Name</div>
                        <div class="rs-row-desc">@kb.Description</div>
                    </div>
                    <span class="em-role">@kb.DocumentCount 文档</span>
                </div>
            }
            @if (!_knowledgeBases.Any())
            {
                <div class="empty-state"><div class="empty-text">暂无知识库</div></div>
            }
        </div>
    }
</div>

<!-- ========== 连接器对话框 ========== -->
@if (_showConnectorDialog)
{
    <div class="modal-overlay" @onclick="CloseConnectorDialog">
        <div class="modal-dialog" style="width:480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editConnectorId is null ? "手动添加连接器" : "编辑连接器")</h3>
                <button class="btn btn-text modal-close-btn" @onclick="CloseConnectorDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-item required">
                    <label>* 名称</label>
                    <input class="modal-input" @bind="_editConnectorName" placeholder="如：钉钉" />
                </div>
                <div class="form-row">
                    <div class="form-item">
                        <label>图标</label>
                        <input class="modal-input" @bind="_editConnectorIcon" placeholder="emoji，如 📨" />
                    </div>
                </div>
                <div class="form-item">
                    <label>描述</label>
                    <textarea class="modal-input modal-textarea" @bind="_editConnectorDescription" placeholder="连接器的用途说明"></textarea>
                </div>
                <div class="form-item">
                    <label>配置（JSON）</label>
                    <textarea class="modal-input modal-textarea" @bind="_editConnectorConfig" style="min-height:100px;" placeholder='{ "endpoint": "..." }'></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" @onclick="CloseConnectorDialog">取消</button>
                <button class="modal-btn-primary" disabled="@_saving" @onclick="SaveConnectorAsync">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private string _tab = "skill";

    private List<SkillDto> _skills = [];
    private List<ConnectorDto> _connectors = [];
    private List<KnowledgeBaseDto> _knowledgeBases = [];
    private List<McpServerDto> _mcpServers = [];

    private bool _showConnectorDialog;
    private bool _saving;
    private Guid? _editConnectorId;
    private string _editConnectorName = "";
    private string _editConnectorIcon = "";
    private string _editConnectorDescription = "";
    private string _editConnectorConfig = "";

    private string toastMessage = "";
    private string toastType = "info";
    private bool toastVisible;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            if (_tab == "skill")
            {
                _skills = (await SkillAppService.GetListAsync(new SkillDefinitionQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
            }
            else if (_tab == "mcp")
            {
                _mcpServers = (await McpServerAppService.GetAllAsync()).Data ?? [];
            }
            else if (_tab == "connector")
            {
                _connectors = (await ConnectorAppService.GetListAsync(new ConnectorQueryDto { MaxResultCount = 100 })).Data?.Items.ToList() ?? [];
            }
            else
            {
                _knowledgeBases = (await KnowledgeBaseAppService.GetListAsync()).Data ?? [];
            }
        }
        catch (Exception ex)
        {
            ShowToast($"加载失败: {ex.Message}", "error");
        }
    }

    private async Task ToggleSkillAsync(SkillDto skill, ChangeEventArgs e)
    {
        try
        {
            await SkillAppService.ToggleEnabledAsync(skill.Id, (bool)(e.Value ?? false));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"操作失败: {ex.Message}", "error");
        }
    }

    private async Task ToggleMcpAsync(McpServerDto server, ChangeEventArgs e)
    {
        try
        {
            await McpServerAppService.ToggleEnabledAsync(server.Id, (bool)(e.Value ?? false));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"操作失败: {ex.Message}", "error");
        }
    }

    private async Task ToggleConnectorAsync(ConnectorDto connector, ChangeEventArgs e)
    {
        try
        {
            await ConnectorAppService.ToggleEnabledAsync(connector.Id, (bool)(e.Value ?? false));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"操作失败: {ex.Message}", "error");
        }
    }

    private void ShowConnectorDialog(ConnectorDto? connector = null)
    {
        _editConnectorId = connector?.Id;
        _editConnectorName = connector?.ConnectorName ?? "";
        _editConnectorIcon = connector?.Icon ?? "";
        _editConnectorDescription = connector?.Description ?? "";
        _editConnectorConfig = connector?.Config ?? "";
        _showConnectorDialog = true;
    }

    private void CloseConnectorDialog() => _showConnectorDialog = false;

    private async Task SaveConnectorAsync()
    {
        if (string.IsNullOrWhiteSpace(_editConnectorName))
        {
            ShowToast("请输入连接器名称", "warning");
            return;
        }

        _saving = true;
        try
        {
            if (_editConnectorId is null)
            {
                await ConnectorAppService.CreateAsync(new CreateConnectorDto
                {
                    ConnectorName = _editConnectorName.Trim(),
                    Icon = _editConnectorIcon.Trim(),
                    Description = _editConnectorDescription.Trim(),
                    Config = string.IsNullOrWhiteSpace(_editConnectorConfig) ? null : _editConnectorConfig
                });
                ShowToast("连接器已添加", "success");
            }
            else
            {
                await ConnectorAppService.UpdateAsync(_editConnectorId.Value, new UpdateConnectorDto
                {
                    ConnectorName = _editConnectorName.Trim(),
                    Icon = _editConnectorIcon.Trim(),
                    Description = _editConnectorDescription.Trim(),
                    Config = string.IsNullOrWhiteSpace(_editConnectorConfig) ? null : _editConnectorConfig
                });
                ShowToast("连接器已更新", "success");
            }

            _showConnectorDialog = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"保存失败: {ex.Message}", "error");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteConnectorAsync(ConnectorDto connector)
    {
        try
        {
            await ConnectorAppService.DeleteAsync(connector.Id);
            ShowToast("连接器已删除", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"删除失败: {ex.Message}", "error");
        }
    }

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}

<style>
    .rs-page {
        height: 100%;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
        box-sizing: border-box;
    }

    .rs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .rs-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .rs-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        font-weight: 500;
        color: #262626;
        margin-bottom: 12px;
    }

    .rs-rows {
        display: flex;
        flex-direction: column;
        border: 1px solid #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .rs-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid #f0f0f0;
    }

    .rs-row:last-child {
        border-bottom: none;
    }

    .rs-row:hover {
        background: #fafafa;
    }

    .rs-row-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #f5f5f5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .rs-row-info {
        flex: 1;
        min-width: 0;
    }

    .rs-row-name {
        font-size: 14px;
        color: #262626;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rs-row-desc {
        font-size: 12px;
        color: #8c8c8c;
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ========== 开关 ========== */
    .rs-switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
        flex-shrink: 0;
    }

    .rs-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .rs-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #e8e8e8;
        border-radius: 20px;
        transition: 0.2s;
    }

    .rs-slider::before {
        content: "";
        position: absolute;
        height: 16px;
        width: 16px;
        left: 2px;
        top: 2px;
        background: #fff;
        border-radius: 50%;
        transition: 0.2s;
    }

    .rs-switch input:checked + .rs-slider {
        background: #52c41a;
    }

    .rs-switch input:checked + .rs-slider::before {
        transform: translateX(16px);
    }
</style>
