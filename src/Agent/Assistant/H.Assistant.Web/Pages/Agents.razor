@page "/assistant/base"
@page "/assistant/base/agents"

@layout BaseLayout
@inject IAgentAppService AgentDefinitionAppService
@inject ISkillAppService SkillDefinitionAppService
@inject ILLMAppService LLMConfigAppService

<PageTitle>智能体 - Agent 助手</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification toast-@toastType @(toastVisible ? "toast-show" : "")">
        @toastMessage
    </div>
}

<div class="settings-container">
    <div class="settings-content">
        <div class="content-header">
            <h2>智能体管理</h2>
            <button class="btn btn-primary assistant-btn-primary btn-small" @onclick="ShowAddAgent">
                @IconSvg("plus") 新建智能体
            </button>
        </div>
        <div class="agent-list">
            @if (loadingAgents)
            {
                <div class="loading-spinner"><div class="spinner"></div><span>加载中...</span></div>
            }
            else if (agentsFromDb.Any())
            {
                @foreach (var agent in agentsFromDb)
                {
                    <div class="model-card">
                        <div class="model-card-header">
                            <div class="model-name">
                                <strong>@agent.DisplayName</strong>
                                <span class="tag tag-blue">@agent.AgentType</span>
                                @if (agent.IsEnabled)
                                {
                                    <span class="tag tag-green">已启用</span>
                                }
                                else
                                {
                                    <span class="tag tag-default">已禁用</span>
                                }
                            </div>
                            <div class="model-actions">
                                <button class="btn btn-link btn-small" @onclick="@(() => ToggleAgent(agent))">
                                    @(agent.IsEnabled ? "禁用" : "启用")
                                </button>
                                <button class="btn btn-link btn-small" @onclick="@(() => EditAgent(agent))">编辑</button>
                                <button class="btn btn-link btn-small btn-danger" @onclick="@(() => DeleteAgent(agent.Id))">删除</button>
                            </div>
                        </div>
                        <div class="model-card-body">
                            <div class="model-info-row">
                                <span class="info-label">描述:</span>
                                <span>@agent.Description</span>
                            </div>
                            <div class="model-info-row">
                                <span class="info-label">温度:</span>
                                <span>@agent.Temperature</span>
                                <span class="info-label" style="margin-left:16px;">MaxTokens:</span>
                                <span>@agent.MaxTokens</span>
                                <span class="info-label" style="margin-left:16px;">流式:</span>
                                <span>@(agent.SupportsStreaming ? "支持" : "不支持")</span>
                            </div>
                            @if (agentSkillDetails.TryGetValue(agent.Id, out var skills) && skills.Any())
                            {
                                <div class="model-info-row" style="margin-top: 8px;">
                                    <span class="info-label">关联技能:</span>
                                    @foreach (var skill in skills)
                                    {
                                        <span class="tag tag-blue tag-inline">@skill.DisplayName</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">@IconSvg("inbox")</div>
                    <div class="empty-text">暂无智能体,点击新建按钮新增</div>
                </div>
            }
        </div>

        @if (showAgentDialog)
        {
            <div class="modal-overlay" @onclick="CloseAgentDialog">
                <div class="modal-dialog agent-dialog" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(isEditingAgent ? "编辑智能体" : "新建智能体")</h3>
                        <button class="btn btn-text modal-close-btn" @onclick="CloseAgentDialog">
                            @IconSvg("close")
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="form-item required">
                            <label>* 类型标识</label>
                            <input class="modal-input" @bind="@editAgent.AgentType" placeholder="如: general" disabled="@isEditingAgent" />
                        </div>
                        <div class="form-item required">
                            <label>* 显示名称</label>
                            <input class="modal-input" @bind="@editAgent.DisplayName" placeholder="如: 通用助手" />
                        </div>
                        <div class="form-item required">
                            <label>* 描述</label>
                            <textarea class="modal-input modal-textarea" @bind="@editAgent.Description" placeholder="描述智能体的功能和用途"></textarea>
                        </div>
                        <div class="form-item required">
                            <label>* 系统提示词</label>
                            <textarea class="modal-input modal-textarea" @bind="@editAgent.SystemPrompt" placeholder="输入系统提示词" style="min-height: 120px;"></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-item">
                                <label>温度 (0-1)</label>
                                <input class="modal-input" type="number" step="0.1" min="0" max="1" @bind="@editAgent.Temperature" />
                            </div>
                            <div class="form-item">
                                <label>MaxTokens</label>
                                <input class="modal-input" type="number" @bind="@editAgent.MaxTokens" />
                            </div>
                        </div>
                        <div class="form-item">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="@editAgent.SupportsStreaming" />
                                支持流式响应
                            </label>
                        </div>
                        <div class="form-item">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="@editAgent.IsEnabled" />
                                启用
                            </label>
                        </div>
                        <div class="form-item">
                            <label>技能选择</label>
                            <div class="skill-search-box">
                                <input class="modal-input" @bind="@agentSkillSearchText" placeholder="搜索技能..." />
                            </div>
                            <div class="skill-selection-area">
                                @foreach (var group in FilteredAvailableSkills)
                                {
                                    <div style="margin-bottom: 8px;">
                                        <div style="font-size: 12px; color: #8c8c8c; margin-bottom: 4px;">@group.Key</div>
                                        @foreach (var skill in group)
                                        {
                                            <div class="skill-checkbox-item">
                                                <input type="checkbox" id="skill-@skill.Id" @bind="@editAgent.SelectedSkillIds" value="@skill.Id" />
                                                <label for="skill-@skill.Id" class="skill-checkbox-label">
                                                    @skill.DisplayName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-item">
                            <label>默认模型 (可选)</label>
                            <select class="modal-select" @bind="@editAgent.DefaultModelConfigId">
                                <option value="">无</option>
                                @foreach (var config in llmConfigs)
                                {
                                    <option value="@config.Id">@config.ProviderDisplayName - @config.Model</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="modal-btn-cancel" @onclick="CloseAgentDialog">取消</button>
                        <button class="modal-btn-primary" @onclick="SaveAgent" disabled="@savingAgent">
                            @(isEditingAgent ? "保存" : "创建")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<AgentDto> agentsFromDb = new();
    private Dictionary<Guid, List<SkillDto>> agentSkillDetails = new();
    private bool loadingAgents;
    private bool showAgentDialog;
    private bool isEditingAgent;
    private bool savingAgent;
    private AgentEditModel editAgent = new();
    private List<SkillDto> availableSkills = new();
    private string agentSkillSearchText = "";

    private List<LLMDto> llmConfigs = new();

    private string toastMessage = string.Empty;
    private string toastType = "info";
    private bool toastVisible;

    private void ShowToast(string message, string type = "info")
    {
        toastMessage = message;
        toastType = type;
        toastVisible = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastVisible = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLLMConfigs();
        await LoadAgents();
    }

    private async Task LoadLLMConfigs()
    {
        try { llmConfigs = (await LLMConfigAppService.GetAllAsync()).Data ?? []; }
        catch (Exception ex) { ShowToast("加载模型配置失败: " + ex.Message, "error"); }
    }

    private async Task LoadAgents()
    {
        loadingAgents = true;
        try
        {
            var result = (await AgentDefinitionAppService.GetListAsync(new AgentQueryDto
            {
                MaxResultCount = 100
            })).Data!;
            agentsFromDb = result.Items.ToList();

            agentSkillDetails.Clear();
            foreach (var agent in agentsFromDb)
            {
                try
                {
                    var skills = (await AgentDefinitionAppService.GetAgentSkillsAsync(agent.Id)).Data ?? [];
                    agentSkillDetails[agent.Id] = skills;
                }
                catch { }
            }
        }
        catch (Exception ex) { ShowToast("加载智能体列表失败: " + ex.Message, "error"); }
        finally { loadingAgents = false; }
    }

    private async Task LoadAvailableSkills()
    {
        try
        {
            availableSkills = (await SkillDefinitionAppService.GetEnabledSkillsAsync()).Data ?? [];
        }
        catch (Exception ex) { ShowToast("加载可用技能失败: " + ex.Message, "error"); }
    }

    private IEnumerable<IGrouping<string, SkillDto>> FilteredAvailableSkills
    {
        get
        {
            var filtered = string.IsNullOrWhiteSpace(agentSkillSearchText)
                ? availableSkills
                : availableSkills.Where(s =>
                    s.DisplayName.Contains(agentSkillSearchText, StringComparison.OrdinalIgnoreCase) ||
                    s.SkillName.Contains(agentSkillSearchText, StringComparison.OrdinalIgnoreCase));

            return filtered.GroupBy(s => s.SkillType);
        }
    }

    private void ShowAddAgent()
    {
        isEditingAgent = false;
        editAgent = new AgentEditModel
        {
            AgentType = "",
            DisplayName = "",
            Description = "",
            SystemPrompt = "",
            IsEnabled = true,
            SupportsStreaming = true,
            Temperature = 0.7f,
            MaxTokens = 2000,
            SelectedSkillIds = new()
        };
        _ = LoadAvailableSkills();
        showAgentDialog = true;
    }

    private async void EditAgent(AgentDto agent)
    {
        isEditingAgent = true;
        editAgent = new AgentEditModel
        {
            Id = agent.Id,
            AgentType = agent.AgentType,
            DisplayName = agent.DisplayName,
            Description = agent.Description,
            SystemPrompt = agent.SystemPrompt,
            IsEnabled = agent.IsEnabled,
            SupportsStreaming = agent.SupportsStreaming,
            Temperature = agent.Temperature,
            MaxTokens = agent.MaxTokens,
            DefaultModelConfigId = agent.DefaultModelConfigId,
            SelectedSkillIds = new()
        };

        await LoadAvailableSkills();

        try
        {
            var currentSkills = (await AgentDefinitionAppService.GetAgentSkillsAsync(agent.Id)).Data ?? [];
            editAgent.SelectedSkillIds = currentSkills.Select(s => s.Id).ToList();
        }
        catch { }

        showAgentDialog = true;
        StateHasChanged();
    }

    private void CloseAgentDialog() { showAgentDialog = false; }

    private async Task SaveAgent()
    {
        if (string.IsNullOrWhiteSpace(editAgent.AgentType)) { ShowToast("请输入类型标识", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editAgent.DisplayName)) { ShowToast("请输入显示名称", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editAgent.Description)) { ShowToast("请输入描述", "warning"); return; }
        if (string.IsNullOrWhiteSpace(editAgent.SystemPrompt)) { ShowToast("请输入系统提示词", "warning"); return; }

        savingAgent = true;
        try
        {
            if (isEditingAgent && editAgent.Id.HasValue)
            {
                await AgentDefinitionAppService.UpdateAsync(editAgent.Id.Value, new UpdateAgentDto
                {
                    DisplayName = editAgent.DisplayName,
                    Description = editAgent.Description,
                    SystemPrompt = editAgent.SystemPrompt,
                    IsEnabled = editAgent.IsEnabled,
                    SupportsStreaming = editAgent.SupportsStreaming,
                    Temperature = editAgent.Temperature,
                    MaxTokens = editAgent.MaxTokens,
                    DefaultModelConfigId = editAgent.DefaultModelConfigId,
                    SkillIds = editAgent.SelectedSkillIds
                });
                ShowToast("智能体已更新", "success");
            }
            else
            {
                await AgentDefinitionAppService.CreateAsync(new CreateAgentDto
                {
                    AgentType = editAgent.AgentType.Trim().ToLower(),
                    DisplayName = editAgent.DisplayName,
                    Description = editAgent.Description,
                    SystemPrompt = editAgent.SystemPrompt,
                    IsEnabled = editAgent.IsEnabled,
                    SupportsStreaming = editAgent.SupportsStreaming,
                    Temperature = editAgent.Temperature,
                    MaxTokens = editAgent.MaxTokens,
                    DefaultModelConfigId = editAgent.DefaultModelConfigId,
                    SkillIds = editAgent.SelectedSkillIds
                });
                ShowToast("智能体已创建", "success");
            }
            showAgentDialog = false;
            await LoadAgents();
        }
        catch (Exception ex) { ShowToast("保存失败: " + ex.Message, "error"); }
        finally { savingAgent = false; }
    }

    private async Task DeleteAgent(Guid id)
    {
        try
        {
            await AgentDefinitionAppService.DeleteAsync(id);
            ShowToast("已删除", "success");
            await LoadAgents();
        }
        catch (Exception ex) { ShowToast("删除失败: " + ex.Message, "error"); }
    }

    private async Task ToggleAgent(AgentDto agent)
    {
        try
        {
            await AgentDefinitionAppService.ToggleEnabledAsync(agent.Id, !agent.IsEnabled);
            ShowToast(agent.IsEnabled ? "智能体已禁用" : "智能体已启用", "success");
            await LoadAgents();
        }
        catch (Exception ex) { ShowToast("操作失败: " + ex.Message, "error"); }
    }

    private class AgentEditModel
    {
        public Guid? Id { get; set; }
        public string AgentType { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public string SystemPrompt { get; set; } = "";
        public bool IsEnabled { get; set; } = true;
        public bool SupportsStreaming { get; set; } = true;
        public float Temperature { get; set; } = 0.7f;
        public int MaxTokens { get; set; } = 2000;
        public Guid? DefaultModelConfigId { get; set; }
        public List<Guid> SelectedSkillIds { get; set; } = new();
    }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);

    private static string GetIconSvg(string name) => name switch
    {
        "plus" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg>",
        "setting" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>",
        "robot" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"10\" rx=\"2\"></rect><circle cx=\"12\" cy=\"5\" r=\"2\"></circle><path d=\"M12 7v4\"></path><line x1=\"8\" y1=\"16\" x2=\"8\" y2=\"16\"></line><line x1=\"16\" y1=\"16\" x2=\"16\" y2=\"16\"></line></svg>",
        "thunderbolt" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg>",
        "arrow-left" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg>",
        "sun" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"5\"></circle><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\"></line><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\"></line><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"></line><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"></line><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"></line><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"></line><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"></line><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"></line></svg>",
        "moon" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg>",
        "close" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>",
        "inbox" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"></polyline><path d=\"M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path></svg>",
        "api" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"></polyline><polyline points=\"8 6 2 12 8 18\"></polyline></svg>",
        "plug" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2v6a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V2\"></path><path d=\"M12 10v12\"></path><path d=\"M8 22h8\"></path><path d=\"M5 2h14\"></path></svg>",
        _ => ""
    };
}

<style>
    /* ========== Settings Page ========== */
    .settings-container {
        display: flex;
        height: 100%;
        width: 100%;
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e8e8e8;
    }

    .content-header h2 {
        margin: 0;
        font-size: 20px;
    }

    .settings-form {
        max-width: 600px;
    }

    .form-section {
        margin-bottom: 32px;
    }

    .form-section h3 {
        font-size: 16px;
        margin-bottom: 16px;
        color: #262626;
    }

    .form-item {
        margin-bottom: 16px;
    }

    .form-item label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        color: #595959;
        font-weight: 500;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .form-row .form-item {
        flex: 1;
    }

    .theme-options {
        display: flex;
        gap: 8px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-item label {
        margin-bottom: 0;
    }

    /* ========== Model Cards ========== */
    .model-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .model-card {
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        overflow: hidden;
    }

    .model-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        border-bottom: 1px solid #e8e8e8;
    }

    .model-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .model-actions {
        display: flex;
        gap: 4px;
    }

    .model-card-body {
        padding: 12px 16px;
    }

    .model-info-row {
        font-size: 13px;
        color: #595959;
        margin-bottom: 4px;
    }

    .info-label {
        color: #8c8c8c;
        margin-right: 4px;
    }

    /* ========== Tags ========== */
    .tag {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
        line-height: 1.5;
    }

    .tag-inline {
        margin-left: 4px;
    }

    .tag-green {
        background: #f6ffed;
        color: #52c41a;
        border: 1px solid #b7eb8f;
    }

    .tag-blue {
        background: #e6f7ff;
        color: #1890ff;
        border: 1px solid #91d5ff;
    }

    .tag-default {
        background: #fafafa;
        color: #595959;
        border: 1px solid #d9d9d9;
    }

    /* ========== Modal ========== */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-dialog {
        background: white;
        border-radius: 8px;
        width: 520px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid #e8e8e8;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 16px;
    }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
