@page "/assistant"
@page "/assistant/chat"

@layout ChatLayout
@inject IChatMessageAppService ChatMessageAppService
@inject ILLMAppService LLMAppService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using System.Text.Json
@using Markdig

<PageTitle>Chat - Agent 助手</PageTitle>

<!-- Right Panel - Chat Area -->
<div class="chat-main-panel">
    @if (selectedChatId.HasValue)
    {
        <div class="chat-header">
            <div class="chat-header-left">
                <span>Agent: @selectedAgent?.DisplayName</span>
            </div>
        </div>

        <div class="chat-messages" @ref="chatMessagesRef">
            @if (loadingMessages)
            {
                <div class="loading-spinner"><div class="spinner"></div><span>Loading...</span></div>
            }
            else if (messages.Any() || pendingUserMessage != null)
            {
                @* 如果正在流式响应且有 reactSteps，隐藏最后一条助手消息以避免重复 *@
                @foreach (var message in GetMessagesToRender())
                {
                    <div class="message-item @(message.Role == "user" ? "user-message" : "assistant-message")">
                        <div class="message-avatar">
                            @if (message.Role == "user") { @IconSvg("user") } else { @IconSvg("robot") }
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                <MarkdownRenderer Content="@message.Content" />
                            </div>
                            <div class="message-time">@message.CreationTime.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }

                @if (pendingUserMessage != null)
                {
                    <div class="message-item user-message">
                        <div class="message-avatar">@IconSvg("user")</div>
                        <div class="message-content">
                            <div class="message-text">
                                <MarkdownRenderer Content="@pendingUserMessage.Content" />
                            </div>
                            <div class="message-time">@pendingUserMessage.CreationTime.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }

                @* ReAct 步骤可视化 *@
                @if (hasReactSteps && reactSteps.Any())
                {
                    <div class="message-item assistant-message">
                        <div class="message-avatar">@IconSvg("robot")</div>
                        <div class="message-content react-content">
                            @foreach (var step in reactSteps)
                            {
                                @if (!string.IsNullOrEmpty(step.ThinkingContent))
                                {
                                    <div class="react-thinking">
                                        <div class="react-thinking-header">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                                            <span>思考中</span>
                                        </div>
                                        <div class="react-thinking-body">
                                            <MarkdownRenderer Content="@step.ThinkingContent" />
                                        </div>
                                    </div>
                                }
                                @foreach (var tool in step.ToolCalls)
                                {
                                    <div class="react-tool-call">
                                        <div class="react-tool-header">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                                            <span class="react-tool-name">@GetFriendlyToolName(tool.ToolName)</span>
                                            @if (tool.IsExecuting)
                                            {
                                                <span class="react-tool-status executing">
                                                    <span class="executing-dot"></span>
                                                    执行中...
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(tool.Arguments))
                                        {
                                            <details class="react-tool-details">
                                                <summary>参数</summary>
                                                <pre class="react-tool-args">@FormatToolArguments(tool.Arguments)</pre>
                                            </details>
                                        }
                                        @if (tool.Result != null)
                                        {
                                            <div class="react-tool-result @(tool.IsError ? "error" : "")">
                                                <div class="react-tool-result-label">
                                                    @(tool.IsError ? "错误" : "结果")
                                                </div>
                                                <pre class="react-tool-result-text">@TruncateResult(tool.Result)</pre>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @* 最终回答（流式 markdown 或历史消息中的答案） *@
                            @if (!string.IsNullOrEmpty(streamingResponse) || !string.IsNullOrEmpty(historicalAnswer))
                            {
                                <div class="react-answer">
                                    <div class="markdown-content">
                                        @((MarkupString)RenderMarkdown(!string.IsNullOrEmpty(streamingResponse) ? streamingResponse : historicalAnswer))
                                    </div>
                                </div>
                            }
                            <div class="message-time">@DateTime.Now.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(streamingResponse))
                {
                    <div class="message-item assistant-message">
                        <div class="message-avatar">@IconSvg("robot")</div>
                        <div class="message-content">
                            <div class="message-text">
                                <div class="markdown-content">
                                    @((MarkupString)RenderMarkdown(streamingResponse))
                                </div>
                            </div>
                            <div class="message-time">@DateTime.Now.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><div class="empty-icon">@IconSvg("chat")</div><div class="empty-text">Start a conversation</div></div>
            }

            @if (isSending && string.IsNullOrEmpty(streamingResponse) && !hasReactSteps)
            {
                <div class="message-item assistant-message">
                    <div class="message-avatar">@IconSvg("robot")</div>
                    <div class="message-content">
                        <div class="message-text thinking-text">
                            <span class="thinking-dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <ChatInput @bind-Message="inputMessage"
                       @bind-SelectedAgentType="selectedAgentType"
                       @bind-SelectedProviderName="selectedProviderName"
                       AvailableAgents="availableAgents"
                       AvailableModels="availableModels"
                       IsSending="isSending"
                       OnSend="SendMessage"
                       OnStop="StopSending" />
    }
    else
    {
        <div class="new-task-container">
            <ChatInput @bind-Message="inputMessage"
                           @bind-SelectedAgentType="selectedAgentType"
                           @bind-SelectedProviderName="selectedProviderName"
                           AvailableAgents="availableAgents"
                           AvailableModels="availableModels"
                           IsSending="isSending"
                           OnSend="SendNewTask" />
        </div>
    }
</div>

@code {
    private List<ChatMessageDto> messages = new();
    private Guid? selectedChatId;
    private List<AgentConfigDto> availableAgents = new();
    private List<LLMDto> availableModels = new();
    private string selectedAgentType = "";
    private string inputMessage = string.Empty;
    private string selectedProviderName = string.Empty;
    private bool loadingMessages;
    private bool isSending;
    private bool isNewTask;
    private AgentConfigDto? selectedAgent;
    private ChatMessageDto? pendingUserMessage;
    private string streamingResponse = string.Empty;
    private string historicalAnswer = string.Empty; // 从历史消息中解析出的最终回答
    private ElementReference chatMessagesRef;
    private CancellationTokenSource? streamCts;
    private DotNetObjectReference<SseStreamCallbacks>? _sseCallbacksRef;

    // ReAct 步骤可视化状态
    private List<ReactStep> reactSteps = new();
    private bool hasReactSteps;

    private static readonly MarkdownPipeline _mdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseEmojiAndSmiley()
        .UseCustomContainers()
        .Build();

    private static string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        var html = Markdown.ToHtml(markdown, _mdPipeline);
        html = html.Replace("<pre><code", "<pre class=\"markdown-code-block\"><code");
        html = html.Replace("<code>", "<code class=\"markdown-inline-code\">");
        return html;
    }

    private static string FormatToolArguments(string args)
    {
        if (string.IsNullOrEmpty(args)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(args);
            // 禁用非 ASCII 字符转义，确保中文等字符正常显示
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch { return args; }
    }

    /// <summary>
    /// 将技术性工具名称转换为友好的中文说明
    /// </summary>
    private static string GetFriendlyToolName(string toolName)
    {
        return toolName switch
        {
            "SearchAsync" => "网络搜索",
            "SearchNewsAsync" => "新闻搜索",
            "FetchPageAsync" => "访问网页",
            "ExtractTextAsync" => "提取文本",
            "ExtractLinksAsync" => "提取链接",
            "CheckUrlAsync" => "检查链接",
            _ => toolName // 未知工具名保持原样
        };
    }

    /// <summary>
    /// 获取要渲染的消息列表（如果有 reactSteps，排除最后一条助手消息以避免重复）
    /// </summary>
    private List<ChatMessageDto> GetMessagesToRender()
    {
        if (hasReactSteps && reactSteps.Any() && messages.Count > 0 && messages.Last().Role == "assistant")
        {
            // 排除最后一条助手消息（由 reactSteps 替代显示）
            return messages.Take(messages.Count - 1).ToList();
        }
        return messages;
    }

    private static string TruncateResult(string result, int maxLen = 500)
    {
        if (string.IsNullOrEmpty(result)) return "";
        return result.Length > maxLen ? result[..maxLen] + "..." : result;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Inject JS SSE stream helper
            await JS.InvokeVoidAsync("eval", @"
                window.__chatSseStream = async function(url, body, dotNetRef) {
                    const resp = await fetch(url, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: typeof body === 'string' ? body : JSON.stringify(body),
                        credentials: 'same-origin'
                    });
                    if (!resp.ok) { await dotNetRef.invokeMethodAsync('OnSseDone'); await dotNetRef.invokeMethodAsync('OnSseError', 'HTTP ' + resp.status); return; }
                    const reader = resp.body.pipeThrough(new TextDecoderStream()).getReader();
                    let buffer = '';
                    try {
                        while (true) {
                            const { done, value } = await reader.read();
                            if (done) break;
                            buffer += value;
                            let nl;
                            while ((nl = buffer.indexOf('\n')) >= 0) {
                                const line = buffer.substring(0, nl).trimEnd();
                                buffer = buffer.substring(nl + 1);
                                if (!line.startsWith('data: ')) continue;
                                const d = line.substring(6);
                                if (d === '[DONE]') { await dotNetRef.invokeMethodAsync('OnSseDone'); return; }
                                await dotNetRef.invokeMethodAsync('OnSseChunk', d);
                            }
                        }
                        await dotNetRef.invokeMethodAsync('OnSseDone');
                    } catch(e) {
                        await dotNetRef.invokeMethodAsync('OnSseError', e.message);
                    }
                };
            ");

            await LoadAvailableAgents();
            await LoadAvailableModels();

            // Read query param for initial session selection
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var idStr = query["id"];
            if (!string.IsNullOrEmpty(idStr) && Guid.TryParse(idStr, out var id))
            {
                await SelectChat(id);
            }
            else
            {
                _ = CreateNewChat();
            }
        }
        catch (Exception ex) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Handle navigation from sidebar (page stays alive, only query param changes)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var idStr = query["id"];
        if (!string.IsNullOrEmpty(idStr) && Guid.TryParse(idStr, out var id))
        {
            if (selectedChatId != id)
            {
                await SelectChat(id);
            }
        }
        else if (!selectedChatId.HasValue)
        {
            await CreateNewChat();
        }
    }

    private async Task LoadAvailableAgents()
    {
        availableAgents = await ChatMessageAppService.GetAvailableAgentsAsync();
        selectedAgent = availableAgents.FirstOrDefault(a => a.AgentType == selectedAgentType);
    }

    private async Task LoadAvailableModels()
    {
        try
        {
            var allConfigs = await LLMAppService.GetAllAsync();
            availableModels = allConfigs.Where(c => c.IsEnabled).ToList();
            if (string.IsNullOrEmpty(selectedProviderName) && availableModels.Any())
            {
                var defaultModel = availableModels.FirstOrDefault(m => m.IsDefault) ?? availableModels.First();
                selectedProviderName = defaultModel.Id.ToString();
            }
        }
        catch (Exception ex) { availableModels = new List<LLMDto>(); await ShowToast($"Load models failed: {ex.Message}", "error"); }
    }

    private async Task SelectChat(Guid sessionId)
    {
        selectedChatId = sessionId;
        isNewTask = false;
        inputMessage = string.Empty;
        await LoadMessages(sessionId);
        StateHasChanged();
    }

    private async Task LoadMessages(Guid sessionId)
    {
        loadingMessages = true;
        try 
        { 
            messages = await ChatMessageAppService.GetMessagesAsync(sessionId); 
            
            // 检查最后一条助手消息是否包含嵌入的 ReAct 步骤数据
            var lastAssistantMsg = messages.LastOrDefault(m => m.Role == "assistant");
            if (lastAssistantMsg != null && !string.IsNullOrEmpty(lastAssistantMsg.Content))
            {
                try
                {
                    // 尝试解析为 JSON 格式（包含 answer + reactSteps）
                    using var doc = JsonDocument.Parse(lastAssistantMsg.Content);
                    var root = doc.RootElement;
                    
                    // 检查是否有 "answer" 和 "reactSteps" 字段（新的富内容格式）
                    if (root.TryGetProperty("answer", out var answerProp) && 
                        root.TryGetProperty("reactSteps", out var reactStepsProp))
                    {
                        // 提取最终回答内容用于显示
                        var answerContent = answerProp.GetString() ?? "";
                        
                        // 解析 ReAct 步骤
                        reactSteps.Clear();
                        foreach (var stepElem in reactStepsProp.EnumerateArray())
                        {
                            var type = stepElem.TryGetProperty("type", out var t) ? t.GetString() ?? "" : "";
                            var iteration = stepElem.TryGetProperty("iteration", out var i) ? i.GetInt32() : 0;
                            
                            var step = reactSteps.LastOrDefault(s => s.Iteration == iteration);
                            
                            switch (type)
                            {
                                case "thinking":
                                    if (step == null) { step = new ReactStep { Iteration = iteration }; reactSteps.Add(step); }
                                    step.ThinkingContent = stepElem.TryGetProperty("content", out var tc) ? tc.GetString() ?? "" : "";
                                    break;
                                    
                                case "tool_call":
                                    if (step == null) { step = new ReactStep { Iteration = iteration }; reactSteps.Add(step); }
                                    step.ToolCalls.Add(new ToolCallInfo
                                    {
                                        ToolName = stepElem.TryGetProperty("toolName", out var tn) ? tn.GetString() ?? "" : "",
                                        Arguments = stepElem.TryGetProperty("arguments", out var args) ? args.GetString() ?? "" : "",
                                        IsExecuting = false,
                                        Result = null
                                    });
                                    break;
                                    
                                case "tool_result":
                                    var rToolName = stepElem.TryGetProperty("toolName", out var rtn) ? rtn.GetString() ?? "" : "";
                                    var rResult = stepElem.TryGetProperty("result", out var res) ? res.GetString() ?? "" : "";
                                    var rIsError = stepElem.TryGetProperty("isError", out var ie) && ie.GetBoolean();
                                    var toolInfo = reactSteps.SelectMany(st => st.ToolCalls)
                                        .LastOrDefault(t => t.ToolName == rToolName && t.Result == null);
                                    if (toolInfo != null)
                                    {
                                        toolInfo.Result = rResult;
                                        toolInfo.IsError = rIsError;
                                    }
                                    break;
                            }
                        }
                        
                        hasReactSteps = reactSteps.Any();
                        
                        // 保存最终回答内容用于 ReAct 区域渲染
                        historicalAnswer = answerContent;
                        
                        // 更新消息内容为纯文本答案（防止 GetMessagesToRender 中渲染 JSON）
                        lastAssistantMsg.Content = answerContent;
                        
                        // 兜底逻辑：如果有 ReAct 步骤但没有最终回答，降级为普通消息显示
                        if (hasReactSteps && string.IsNullOrEmpty(historicalAnswer))
                        {
                            hasReactSteps = false;
                        }
                        
                        // 触发 UI 重新渲染
                        StateHasChanged();
                    }
                    else
                    {
                        // 不是富内容格式，清空 ReAct 步骤
                        reactSteps.Clear();
                        hasReactSteps = false;
                    }
                }
                catch (Exception)
                {
                    // 解析失败时（可能是普通文本消息），清空 ReAct 步骤
                    reactSteps.Clear();
                    hasReactSteps = false;
                }
            }
            else
            {
                reactSteps.Clear();
                hasReactSteps = false;
            }
            
            await ScrollToBottom(); 
        }
        finally { loadingMessages = false; }
    }

    private async Task CreateNewChat()
    {
        selectedChatId = null;
        messages.Clear(); inputMessage = string.Empty; isNewTask = true;
        reactSteps.Clear(); hasReactSteps = false; historicalAnswer = string.Empty;
        await LoadAvailableModels(); StateHasChanged();
    }

    private async Task SendNewTask()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isSending)
        {
            return;
        }

        isSending = true; var message = inputMessage; inputMessage = string.Empty;
        var newSessionTitle = message.Length > 30 ? message[..30] + "..." : message;
        pendingUserMessage = new ChatMessageDto { Id = Guid.NewGuid(), SessionId = Guid.NewGuid(), Role = "user", Content = message, CreationTime = DateTime.Now };
        streamingResponse = string.Empty; reactSteps.Clear(); hasReactSteps = false; historicalAnswer = string.Empty; StateHasChanged(); await ScrollToBottom();
        try
        {
            var input = new SendChatMessageInputDto
                {
                    SessionId = null,
                    Message = message,
                    AgentType = string.IsNullOrEmpty(selectedAgentType) ? null : selectedAgentType,
                    ProviderName = string.IsNullOrEmpty(selectedProviderName) ? null : selectedProviderName,
                    ModelConfigId = Guid.TryParse(selectedProviderName, out var configId) ? configId : null
                };

            await foreach (var chunk in SendMessageStreamViaJsAsync(input, newSessionTitle))
            {
                streamingResponse += chunk;
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(1);
            }

            if (selectedChatId.HasValue)
            {
                isNewTask = false;
                pendingUserMessage = null;
                streamingResponse = string.Empty;
                await LoadMessages(selectedChatId.Value);
                await JS.InvokeVoidAsync("ChatStateBus.notifySessionsChanged", "chatLayout");
            }
        }
        catch (Exception ex)
        {
            inputMessage = message; pendingUserMessage = null;
            streamingResponse = string.Empty;
            await ShowToast("Send failed: " + ex.Message, "error");
        }
        finally { isSending = false; StateHasChanged(); }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isSending)
        {
            return;
        }
        if (!selectedChatId.HasValue) { await ShowToast("请先选择或创建一个会话", "warning"); return; }
        isSending = true; var message = inputMessage; inputMessage = string.Empty;
        pendingUserMessage = new ChatMessageDto { Id = Guid.NewGuid(), SessionId = selectedChatId.Value, Role = "user", Content = message, CreationTime = DateTime.Now };
        streamingResponse = string.Empty; reactSteps.Clear(); hasReactSteps = false; historicalAnswer = string.Empty; StateHasChanged(); await ScrollToBottom();
        try
        {
            var input = new SendChatMessageInputDto
                {
                    SessionId = selectedChatId,
                    Message = message,
                    AgentType = string.IsNullOrEmpty(selectedAgentType) ? null : selectedAgentType,
                    ProviderName = string.IsNullOrEmpty(selectedProviderName) ? null : selectedProviderName,
                    ModelConfigId = Guid.TryParse(selectedProviderName, out var configId) ? configId : null
                };

            await foreach (var chunk in SendMessageStreamViaJsAsync(input))
            {
                streamingResponse += chunk;
                StateHasChanged();
                await ScrollToBottom();
                await Task.Delay(1);
            }

            pendingUserMessage = null;
            streamingResponse = string.Empty;
            await LoadMessages(selectedChatId.Value);
            await JS.InvokeVoidAsync("ChatStateBus.notifySessionsChanged", "chatLayout");
        }
        catch (Exception ex)
        {
            inputMessage = message; pendingUserMessage = null;
            streamingResponse = string.Empty; await ShowToast("Send failed: " + ex.Message, "error");
        }
        finally { isSending = false; StateHasChanged(); }
    }

    private async IAsyncEnumerable<string> SendMessageStreamViaJsAsync(SendChatMessageInputDto input, string? newSessionTitle = null)
    {
        streamCts?.Cancel();
        streamCts = new CancellationTokenSource();

        var chunkQueue = new Queue<string>();
        var tcs = new TaskCompletionSource<bool>();
        var error = (string?)null;

        void OnChunk(string data)
        {
            if (data.TrimStart().StartsWith("{"))
            {
                try
                {
                    using var doc = JsonDocument.Parse(data);
                    var root = doc.RootElement;

                    // Session 事件
                    if (root.TryGetProperty("session", out var s))
                    {
                        var sessionId = Guid.Parse(s.GetString()!);
                        selectedChatId = sessionId;
                        if (!string.IsNullOrEmpty(newSessionTitle))
                        {
                            var newChat = new ChatDto
                            {
                                Id = sessionId,
                                Title = newSessionTitle,
                                CreationTime = DateTime.Now,
                                LastMessageTime = DateTime.Now,
                                MessageCount = 1
                            };
                            _ = JS.InvokeVoidAsync("ChatStateBus.insertSessionAtTop", "chatLayout", JsonSerializer.Serialize(newChat));
                            _ = JS.InvokeVoidAsync("ChatStateBus.notifyChatSelected", "chatLayout", sessionId.ToString());
                        }
                        _ = InvokeAsync(StateHasChanged);
                        return;
                    }

                    // ReAct 类型化事件
                    if (root.TryGetProperty("type", out var typeProp))
                    {
                        var eventType = typeProp.GetString();
                        var iteration = root.TryGetProperty("iteration", out var iterProp) ? iterProp.GetInt32() : 0;
                        var step = reactSteps.LastOrDefault(s => s.Iteration == iteration);

                        switch (eventType)
                        {
                            case "thinking":
                                if (step == null) { step = new ReactStep { Iteration = iteration }; reactSteps.Add(step); }
                                step.ThinkingContent += root.TryGetProperty("content", out var tc) ? tc.GetString() ?? "" : "";
                                hasReactSteps = true;
                                _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottom(); });
                                return;

                            case "tool_call":
                                if (step == null) { step = new ReactStep { Iteration = iteration }; reactSteps.Add(step); }
                                step.ToolCalls.Add(new ToolCallInfo
                                {
                                    ToolName = root.TryGetProperty("toolName", out var tn) ? tn.GetString() ?? "" : "",
                                    Arguments = root.TryGetProperty("arguments", out var args) ? args.GetString() ?? "" : "",
                                    IsExecuting = true
                                });
                                hasReactSteps = true;
                                _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottom(); });
                                return;

                            case "tool_result":
                                var rToolName = root.TryGetProperty("toolName", out var rtn) ? rtn.GetString() ?? "" : "";
                                var rResult = root.TryGetProperty("result", out var res) ? res.GetString() ?? "" : "";
                                var rIsError = root.TryGetProperty("isError", out var ie) && ie.GetBoolean();
                                var toolInfo = reactSteps.SelectMany(st => st.ToolCalls)
                                    .LastOrDefault(t => t.ToolName == rToolName && t.IsExecuting);
                                if (toolInfo != null)
                                {
                                    toolInfo.Result = rResult;
                                    toolInfo.IsError = rIsError;
                                    toolInfo.IsExecuting = false;
                                }
                                _ = InvokeAsync(async () => { StateHasChanged(); await ScrollToBottom(); });
                                return;

                            case "answer":
                                var ansContent = root.TryGetProperty("content", out var ac) ? ac.GetString() ?? "" : "";
                                // 只有非空 answer 内容才追加到 streamingResponse（空 answer 是完成信号）
                                if (!string.IsNullOrEmpty(ansContent))
                                {
                                    chunkQueue.Enqueue(ansContent);
                                    tcs.TrySetResult(true);
                                }
                                else
                                {
                                    // 空 answer = 流式完成信号
                                    tcs.TrySetResult(false);
                                }
                                return;

                            case "error":
                                var errMsg = root.TryGetProperty("message", out var em) ? em.GetString() ?? "Unknown error" : "Unknown error";
                                var isFatal = root.TryGetProperty("isFatal", out var fat) && fat.GetBoolean();
                                if (isFatal)
                                {
                                    error = errMsg;
                                    tcs.TrySetResult(false);
                                }
                                else
                                {
                                    _ = InvokeAsync(async () => await ShowToast(errMsg, "warning"));
                                }
                                return;
                        }
                    }

                    // 向后兼容：旧格式 error
                    if (root.TryGetProperty("error", out var e))
                    {
                        error = e.GetString();
                        tcs.TrySetResult(false);
                        return;
                    }
                }
                catch (JsonException) { }
            }
            // 非 JSON 纯文本（向后兼容）
            chunkQueue.Enqueue(data);
            tcs.TrySetResult(true);
        }

        void OnDone()
        {
            tcs.TrySetResult(false);
        }

        void OnError(string msg)
        {
            error = msg;
            tcs.TrySetResult(false);
        }

        var callbacks = new SseStreamCallbacks(OnChunk, OnDone, OnError);
        _sseCallbacksRef?.Dispose();
        _sseCallbacksRef = DotNetObjectReference.Create(callbacks);
        var requestJson = JsonSerializer.Serialize(input);
        _ = JS.InvokeVoidAsync("__chatSseStream", "api/assistant/chat/stream", requestJson, _sseCallbacksRef);

        try
        {
            while (true)
            {
                streamCts.Token.ThrowIfCancellationRequested();

                while (chunkQueue.Count > 0)
                    yield return chunkQueue.Dequeue();

                if (error != null) throw new Exception(error);

                var hasMore = await tcs.Task;
                tcs = new TaskCompletionSource<bool>();

                while (chunkQueue.Count > 0)
                    yield return chunkQueue.Dequeue();

                if (!hasMore) yield break;
            }
        }
        finally
        {
            _sseCallbacksRef?.Dispose();
            _sseCallbacksRef = null;
        }
    }

    private class SseStreamCallbacks
    {
        private readonly Action<string> _onChunk;
        private readonly Action _onDone;
        private readonly Action<string> _onError;

        public SseStreamCallbacks(Action<string> onChunk, Action onDone, Action<string> onError)
        {
            _onChunk = onChunk; _onDone = onDone; _onError = onError;
        }

        [JSInvokable] public void OnSseChunk(string data) => _onChunk(data);
        [JSInvokable] public void OnSseDone() => _onDone();
        [JSInvokable] public void OnSseError(string msg) => _onError(msg);
    }

    /// <summary>
    /// ReAct 步骤 - 对应一次 LLM 迭代
    /// </summary>
    private class ReactStep
    {
        public int Iteration { get; set; }
        public string ThinkingContent { get; set; } = string.Empty;
        public List<ToolCallInfo> ToolCalls { get; set; } = new();
    }

    /// <summary>
    /// 工具调用信息
    /// </summary>
    private class ToolCallInfo
    {
        public string ToolName { get; set; } = string.Empty;
        public string Arguments { get; set; } = string.Empty;
        public string? Result { get; set; }
        public bool IsError { get; set; }
        public bool IsExecuting { get; set; }
    }

    private void StopSending()
    {
        streamCts?.Cancel();
        isSending = false;
        StateHasChanged();
    }

    private async Task ShowToast(string message, string type = "info") => await JS.InvokeVoidAsync("ChatStateBus.showToast", message, type);

    private async Task ScrollToBottom() { try { await JS.InvokeVoidAsync("eval", "var el = document.querySelector('.chat-messages'); if(el) el.scrollTop = el.scrollHeight;"); } catch { } }

    private static MarkupString IconSvg(string name) => (MarkupString)GetIconSvg(name);
    private static string GetIconSvg(string name) => name switch
    {
        "user" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg>",
        "robot" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"10\" rx=\"2\"></rect><circle cx=\"12\" cy=\"5\" r=\"2\"></circle><path d=\"M12 7v4\"></path><line x1=\"8\" y1=\"16\" x2=\"8\" y2=\"16\"></line><line x1=\"16\" y1=\"16\" x2=\"16\" y2=\"16\"></line></svg>",
        "chat" => "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>",
        _ => ""
    };
}

