@namespace H.Assistant.Web

@if (Nodes != null && Nodes.Any())
{
    @foreach (var node in Nodes)
    {
        var hasChildren = node.Children != null && node.Children.Any();
        var isExpanded = expandedNodes.ContainsKey(node.Id) && expandedNodes[node.Id];
        var isSelected = SelectedNodeId == node.Id;
        var isDirectory = node.NodeType == "Directory";
        var isRenaming = renamingNodeId == node.Id;

        <div class="tree-node">
            <div class="tree-node-content @(isSelected ? "selected" : "")"
                 style="padding-left: @(Depth * 16 + 8)px"
                 @onclick="() => OnNodeClick(node)">
                @* 展开/折叠箭头 *@
                @if (isDirectory)
                {
                    <span class="tree-node-arrow" @onclick:stopPropagation @onclick="() => ToggleExpand(node.Id)">
                        @if (hasChildren)
                        {
                            @(isExpanded ? "▾" : "▸")
                        }
                        else
                        {
                            <span style="visibility:hidden">▸</span>
                        }
                    </span>
                }
                else
                {
                    <span class="tree-node-arrow spacer"></span>
                }

                @* 标题 *@
                @if (isRenaming)
                {
                    <input class="tree-node-rename-input"
                           @bind="renamingTitle"
                           @bind:event="oninput"
                           @onkeydown="@(e => HandleRenameKeydown(e, node.Id))"
                           @onblur="() => CommitRename(node.Id)"
                           @onclick:stopPropagation
                           autofocus />
                }
                else
                {
                    var canRenameNode = AllowDirectoryEdit || !isDirectory;
                    <span class="tree-node-title" @ondblclick="() => { if (canRenameNode) StartRename(node); }">
                        @node.Title
                    </span>
                }

                @* 操作按钮（非只读且非重命名状态） *@
                @if (!IsReadOnly && !isRenaming)
                {
                    var canEditNode = AllowDirectoryEdit || !isDirectory;
                    <span class="tree-node-actions">
                        <button class="tree-more-btn" title="更多操作" @onclick:stopPropagation @onclick="() => ToggleMoreMenu(node.Id)">⋯</button>
                        @if (showMoreMenu == node.Id)
                        {
                            <div class="tree-dropdown-menu" @onclick:stopPropagation>
                                @if (isDirectory)
                                {
                                    <div class="dropdown-item" @onclick="() => { OnCreateDirectory.InvokeAsync(node.Id); CloseMoreMenu(); }">
                                        + 新建子目录
                                    </div>
                                    <div class="dropdown-item" @onclick="() => { OnCreateNode.InvokeAsync(node.Id); CloseMoreMenu(); }">
                                        + 新建子文档
                                    </div>
                                    <div class="dropdown-divider"></div>
                                }
                                @if (canEditNode)
                                {
                                    <div class="dropdown-item" @onclick="() => { StartRename(node); CloseMoreMenu(); }">
                                        ✎ 重命名
                                    </div>
                                    <div class="dropdown-item danger" @onclick="() => { OnDeleteNode.InvokeAsync(node.Id); CloseMoreMenu(); }">
                                        × 删除
                                    </div>
                                }
                            </div>
                        }
                    </span>
                }
            </div>

            @* 子节点 *@
            @if (isDirectory && isExpanded && hasChildren)
            {
                <KnowledgeTree Nodes="node.Children"
                               SelectedNodeId="SelectedNodeId"
                               OnNodeSelected="OnNodeSelected"
                               OnCreateNode="OnCreateNode"
                               OnCreateDirectory="OnCreateDirectory"
                               OnDeleteNode="OnDeleteNode"
                               OnRenameNode="OnRenameNode"
                               IsReadOnly="IsReadOnly"
                               AllowDirectoryEdit="AllowDirectoryEdit"
                               Depth="Depth + 1"
                               @key="node.Id" />
            }
        </div>
    }
}

@code {
    [Parameter]
    public List<KnowledgeNodeDto> Nodes { get; set; } = new();

    [Parameter]
    public Guid? SelectedNodeId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnNodeSelected { get; set; }

    [Parameter]
    public EventCallback<Guid?> OnCreateNode { get; set; }

    [Parameter]
    public EventCallback<Guid> OnCreateDirectory { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeleteNode { get; set; }

    [Parameter]
    public EventCallback<(Guid Id, string NewTitle)> OnRenameNode { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public bool AllowDirectoryEdit { get; set; } = true;

    [Parameter]
    public int Depth { get; set; }

    private Dictionary<Guid, bool> expandedNodes = new();
    private Guid? renamingNodeId;
    private string renamingTitle = string.Empty;
    private Guid? showMoreMenu;

    private void ToggleExpand(Guid nodeId)
    {
        if (expandedNodes.ContainsKey(nodeId))
        {
            expandedNodes[nodeId] = !expandedNodes[nodeId];
        }
        else
        {
            expandedNodes[nodeId] = true;
        }
    }

    private async Task OnNodeClick(KnowledgeNodeDto node)
    {
        await OnNodeSelected.InvokeAsync(node.Id);

        // 点击目录时自动展开/折叠
        if (node.NodeType == "Directory")
        {
            ToggleExpand(node.Id);
        }
    }

    private void StartRename(KnowledgeNodeDto node)
    {
        if (IsReadOnly) return;
        renamingNodeId = node.Id;
        renamingTitle = node.Title;
    }

    private async Task HandleRenameKeydown(KeyboardEventArgs e, Guid nodeId)
    {
        if (e.Key == "Enter")
        {
            await CommitRename(nodeId);
        }
        else if (e.Key == "Escape")
        {
            renamingNodeId = null;
        }
    }

    private async Task CommitRename(Guid nodeId)
    {
        if (renamingNodeId == nodeId && !string.IsNullOrWhiteSpace(renamingTitle))
        {
            await OnRenameNode.InvokeAsync((nodeId, renamingTitle.Trim()));
        }
        renamingNodeId = null;
    }

    private void ToggleMoreMenu(Guid nodeId)
    {
        showMoreMenu = showMoreMenu == nodeId ? null : nodeId;
    }

    private void CloseMoreMenu()
    {
        showMoreMenu = null;
    }

    /// <summary>
    /// 展开全部节点（由父组件调用）
    /// </summary>
    public void ExpandAll(List<KnowledgeNodeDto>? nodes = null)
    {
        var targetNodes = nodes ?? Nodes;
        foreach (var node in targetNodes)
        {
            expandedNodes[node.Id] = true;
            if (node.Children != null && node.Children.Any())
            {
                ExpandAll(node.Children);
            }
        }
    }
}

<style>
    .tree-node-content {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 8px;
        cursor: pointer;
        border-radius: 4px;
        transition: background-color 0.15s;
        font-size: 13px;
        color: #262626;
        user-select: none;
    }

    .tree-node-content:hover {
        background-color: #f0f0f0;
    }

    .tree-node-content.selected {
        background-color: #e6f7ff;
        color: #1890ff;
    }

    .tree-node-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        font-size: 10px;
        color: #8c8c8c;
        flex-shrink: 0;
        cursor: pointer;
    }

    .tree-node-arrow.spacer {
        cursor: default;
    }

    .tree-node-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .tree-node-rename-input {
        flex: 1;
        min-width: 0;
        padding: 2px 6px;
        border: 1px solid #1890ff;
        border-radius: 3px;
        font-size: 13px;
        outline: none;
        font-family: inherit;
    }

    .tree-node-actions {
        display: none;
        align-items: center;
        gap: 4px;
        margin-left: auto;
        flex-shrink: 0;
        position: relative;
    }

    .tree-node-content:hover .tree-node-actions {
        display: flex;
    }

    .tree-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 24px;
        border: 1px solid #d9d9d9;
        background: #fff;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
        color: #595959;
        padding: 0;
        line-height: 1;
    }

    .tree-more-btn:hover {
        background-color: #f0f0f0;
        border-color: #bfbfbf;
        color: #262626;
    }

    .tree-dropdown-menu {
        position: absolute;
        right: 0;
        top: 100%;
        min-width: 140px;
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        z-index: 1000;
        margin-top: 4px;
        overflow: hidden;
        padding: 4px 0;
    }

    .tree-dropdown-menu .dropdown-item {
        padding: 8px 16px;
        cursor: pointer;
        font-size: 13px;
        color: #595959;
        transition: background-color 0.2s;
    }

    .tree-dropdown-menu .dropdown-item:hover {
        background-color: #f5f5f5;
    }

    .tree-dropdown-menu .dropdown-item.danger {
        color: #ff4d4f;
    }

    .tree-dropdown-menu .dropdown-item.danger:hover {
        background-color: #fff1f0;
    }

    .tree-dropdown-menu .dropdown-divider {
        height: 1px;
        background: #e8e8e8;
        margin: 4px 0;
    }
</style>
