@namespace H.Assistant.Web

@inherits LayoutComponentBase

<DefaultLayoutComponent
    AppName="Agent 助手"
    MenuItems="@MenuItems">
    @Body
</DefaultLayoutComponent>

@code {
    private static List<AppMenuItem> MenuItems => new()
    {
        new AppMenuItem { Name = "智能体", Url = "/assistant/agents", Icon = "🤖" },
        new AppMenuItem { Name = "模型", Url = "/assistant/llms", Icon = "🧠" },
        new AppMenuItem { Name = "技能", Url = "/assistant/skills", Icon = "⚡" },
        new AppMenuItem { Name = "MCP", Url = "/assistant/mcps", Icon = "🔌" },
        new AppMenuItem { Name = "知识库", Url = "/assistant/knowledge", Icon = "📚" }
    };
}

<style>
    /* ========== Buttons (shared by Settings and other pages) ========== */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 6px 16px;
        font-size: 14px;
        line-height: 1.5;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        background: #fafafa;
        color: #595959;
        cursor: pointer;
        transition: all 0.2s;
        outline: none;
        font-family: inherit;
        white-space: nowrap;
    }

    .btn:hover:not(:disabled) {
        color: #262626;
        border-color: #595959;
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .btn:active:not(:disabled) {
        opacity: 0.8;
    }

    .btn-primary {
        color: #fff;
        background: #595959;
        border-color: #595959;
    }

    .btn-primary:hover:not(:disabled) {
        background: #404040;
        border-color: #404040;
        color: #fff;
    }

    /* 灰色系 primary 按钮 */
    .assistant-btn-primary {
        background: #a6a6a6;
        border-color: #a6a6a6;
        color: #fff;
    }

    .assistant-btn-primary:hover:not(:disabled) {
        background: #bfbfbf;
        border-color: #bfbfbf;
        color: #fff;
    }

    /* 返回按钮 */
    .back-btn {
        color: #262626;
    }

    .back-btn:hover {
        background: #f0f0f0;
        color: #262626;
    }

    .btn-link {
        border-color: transparent;
        background: transparent;
        color: #595959;
        padding: 4px 8px;
    }

    .btn-link:hover:not(:disabled) {
        background: transparent;
        color: #262626;
        border-color: transparent;
    }

    .btn-text {
        border-color: transparent;
        background: transparent;
        padding: 4px 8px;
    }

    .btn-text:hover:not(:disabled) {
        background: #f5f5f5;
        border-color: transparent;
    }

    .btn-danger {
        color: #ff4d4f;
    }

    .btn-danger:hover:not(:disabled) {
        color: #ff4d4f;
        background: #fff1f0;
        border-color: transparent;
    }

    .btn-small {
        padding: 2px 8px;
        font-size: 12px;
    }

    /* ========== SVG Icons (shared by Settings and other pages) ========== */
    .btn svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    /* ========== Empty State ========== */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .empty-icon svg {
        width: 48px;
        height: 48px;
        color: #d9d9d9;
    }

    .empty-text {
        color: #8c8c8c;
        font-size: 14px;
    }
</style>
