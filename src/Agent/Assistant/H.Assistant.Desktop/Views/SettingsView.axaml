<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:H.Assistant.Desktop.Views"
             x:Class="H.Assistant.Desktop.Views.SettingsView"
             x:Name="SettingsRoot">
  <Grid ColumnDefinitions="220,*">
    <!-- ========== 左侧菜单 ========== -->
    <Border Grid.Column="0" Background="#fafafa" BorderBrush="#f5f5f5" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16" BorderBrush="#f5f5f5" BorderThickness="0,0,0,1">
          <Button Classes="btn" Command="{Binding GoBackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="←" />
              <TextBlock Text="返回" />
            </StackPanel>
          </Button>
        </Border>
        <ItemsControl ItemsSource="{Binding MenuItems}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="settingsMenuItem"
                      Command="{Binding DataContext.NavigateCommand, ElementName=SettingsRoot}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding Label}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- ========== 右侧内容 ========== -->
    <Panel Grid.Column="1" Background="#ffffff">
      <!-- 通用设置 -->
      <ScrollViewer IsVisible="{Binding IsGeneral}" Padding="24,14,24,24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
          <TextBlock Text="通用设置" FontSize="20" Margin="0,0,0,24" />
          <StackPanel Margin="0,0,0,32" Spacing="16">
            <TextBlock Text="外观" FontSize="16" Foreground="#262626" />
            <StackPanel>
              <TextBlock Classes="formLabel" Text="主题模式" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="btn" Classes.assistantPrimary="{Binding IsLightTheme}"
                        Command="{Binding SetThemeModeCommand}" CommandParameter="light" Content="浅色" />
                <Button Classes="btn" Classes.assistantPrimary="{Binding IsDarkTheme}"
                        Command="{Binding SetThemeModeCommand}" CommandParameter="dark" Content="深色" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="16">
            <TextBlock Text="语言" FontSize="16" Foreground="#262626" />
            <StackPanel>
              <TextBlock Classes="formLabel" Text="界面语言" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="btn" Classes.assistantPrimary="{Binding IsChineseLanguage}"
                        Command="{Binding SetLanguageCommand}" CommandParameter="zh" Content="中文" />
                <Button Classes="btn" Classes.assistantPrimary="{Binding IsEnglishLanguage}"
                        Command="{Binding SetLanguageCommand}" CommandParameter="en" Content="English" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- 模型 / 智能体 / MCP / 技能（IsVisible 需绑到父级 DataContext，子视图 DataContext 已被替换） -->
      <views:LlmSettingsView DataContext="{Binding Llm}"
                             IsVisible="{Binding DataContext.IsModel, ElementName=SettingsRoot}" />
      <views:AgentSettingsView DataContext="{Binding Agents}"
                               IsVisible="{Binding DataContext.IsAgent, ElementName=SettingsRoot}" />
      <views:McpSettingsView DataContext="{Binding Mcp}"
                             IsVisible="{Binding DataContext.IsMcp, ElementName=SettingsRoot}" />
      <views:SkillSettingsView DataContext="{Binding Skills}"
                               IsVisible="{Binding DataContext.IsSkill, ElementName=SettingsRoot}" />
    </Panel>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.settingsMenuItem">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#262626" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.settingsMenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f0f0f0" />
    </Style>
  </UserControl.Styles>
</UserControl>
