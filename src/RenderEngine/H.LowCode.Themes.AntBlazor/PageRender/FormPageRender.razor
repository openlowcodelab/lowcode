@namespace H.LowCode.Themes.AntBlazor
@inherits RenderEngineLowCodeComponentBase
@using H.LowCode.MetaSchema.Services
@using System.Linq

@inject IFormDataAppService FormDataAppService
@inject IFormValidationService ValidationService

@if (_formDto != null)
{
    <Form Model="_fieldDictData"
    OnFinish="OnFinishAsync" OnFinishFailed="OnFinishFailed"
    LabelColSpan="8" WrapperColSpan="16">
        @foreach (var component in Page.Components)
        {
            <FormComponentRender Component="@component" IsInRootContainer="true"></FormComponentRender>
        }

        <FormItem WrapperColOffset="8" WrapperColSpan="16" Style="clear:both; padding-top: 15px;">
            <Button Type="@ButtonType.Primary" HtmlType="submit">
                保存
            </Button>
            <Button HtmlType="button" Style="margin: 0 8px">
                取消
            </Button>
        </FormItem>
    </Form>
}

@code {
    [Parameter]
    public required PageSchema Page { get; set; }

    [PersistentState]
    public required FormDataDto _formDto { get; set; }

    private string? Id;
    public required Dictionary<string, object?> _fieldDictData;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Id = GetQueryValue("id");
        _formDto = await FormDataAppService.GetAsync(Page.AppId, Page.Id, Id);
        
        if (_formDto.Fields == null)
            _fieldDictData = new Dictionary<string, object>();
        else
            _fieldDictData = _formDto.Fields.ToDictionary(x => x.Name, x => x.Value);
    }

    private async Task OnFinishAsync()
    {
        if (_formDto == null)
            return;

        // 执行表单校验
        var validationResult = ValidationService.ValidateForm(_fieldDictData, Page.Components.Cast<ComponentSchemaBase>().ToList());
        if (!validationResult.IsValid)
        {
            var errorMessage = string.Join("\n", validationResult.ErrorMessages);
            await Message.ErrorAsync($"表单校验失败：\n{errorMessage}");
            return;
        }

        foreach (var field in _formDto.Fields)
        {
            if (!_fieldDictData.ContainsKey(field.Name))
                continue;

            field.Value = _fieldDictData[field.Name];
        }
        
        try
        {
            var success = await FormDataAppService.SaveAsync(_formDto);
            if (success)
                await Message.SuccessAsync("保存成功");
            else
                await Message.ErrorAsync("保存失败");
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"保存时发生错误：{ex.Message}");
        }
    }

    private void OnFinishFailed(EditContext editContext)
    {

    }

    /// <summary>
    /// 用于 FormDataState 的 key（每个页面每个数据独立缓存）
    /// </summary>
    /// <returns></returns>
    public override string ToString()
    {
        return $"{base.ToString()}-{Page.AppId}-{Page.Id}-{Id}";
    }
}