@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase
@layout PartsDesignEngineLayout

@inject IComponentLibraryAppService ComponentLibraryAppService

<div style="max-width: 600px;">
    <div style="margin-bottom: 16px;">
        <label style="display: block; margin-bottom: 4px; font-weight: 500;">
            <span style="color: red;">*</span> 组件库标识
        </label>
        <Input @bind-Value="@ComponentLibrary.LibraryId" />
    </div>
    <div style="margin-bottom: 16px;">
        <label style="display: block; margin-bottom: 4px; font-weight: 500;">
            <span style="color: red;">*</span> 组件库名称
        </label>
        <Input @bind-Value="@ComponentLibrary.LibraryName" />
    </div>
    <div style="margin-bottom: 16px;">
        <label style="display: block; margin-bottom: 4px; font-weight: 500;">组件库描述</label>
        <TextArea @bind-Value="@ComponentLibrary.Description" />
    </div>
    <div style="margin-bottom: 16px;">
        <label style="display: block; margin-bottom: 4px; font-weight: 500;">支持平台</label>
        <EnumCheckboxGroup TEnum="SupportPlatformEnum" @bind-Value="@ComponentLibrary.SupportPlatforms"></EnumCheckboxGroup>
    </div>
</div>

@code {
    [Parameter]
    public ComponentLibrarySchema ComponentLibrary { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (ComponentLibrary == null)
            ComponentLibrary = new();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        // 确保每次参数变化时都有有效的ComponentLibrary对象
        if (ComponentLibrary == null)
            ComponentLibrary = new();
    }

    public async Task<bool> SubmitAsync()
    {
        var success = await SaveComponentLibrarySchema();
        return success;
    }

    private async Task<bool> SaveComponentLibrarySchema()
    {
        bool isSuccess = false;
        
        // 简单验证必填字段
        if (string.IsNullOrWhiteSpace(ComponentLibrary.LibraryId) || 
            string.IsNullOrWhiteSpace(ComponentLibrary.LibraryName))
        {
            await Message.ErrorAsync("请填写必填字段");
            return false;
        }

        isSuccess = await ComponentLibraryAppService.SaveAsync(ComponentLibrary);
        if (isSuccess)
        {
            // 重置表单
            ComponentLibrary = new();
        }
        
        return isSuccess;
    }
}