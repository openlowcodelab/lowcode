@namespace H.LowCode.PartsDesignEngine
@inherits DesignEngineLowCodeComponentBase

@inject IComponentPartsAppService ComponentPartsAppService

<Modal Title="新增组件" @bind-Visible="@Visible" OnOk="@OnOk" OnCancel="@OnCancel" Width="600">
    <div style="padding: 16px;">
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 组件名称
            </label>
            <Input @bind-Value="@_componentModel.ComponentName" Placeholder="请输入组件名称（英文，用于代码生成）" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 组件标签
            </label>
            <Input @bind-Value="@_componentModel.Label" Placeholder="请输入组件显示标签（中文）" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 组件类型
            </label>
            <RadioGroup @bind-Value="@_componentModel.ComponentType">
                <Radio RadioButton Value="1">原子组件</Radio>
                <Radio RadioButton Value="2">低代码组件</Radio>
            </RadioGroup>
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">是否容器</label>
            <Switch @bind-Value="@_componentModel.IsContainer" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">支持数据源</label>
            <Switch @bind-Value="@_componentModel.IsSupportDataSource" Disabled="@_componentModel.IsContainer" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">描述</label>
            <TextArea @bind-Value="@_componentModel.Description" Placeholder="请输入组件描述" Rows="3" />
        </div>
    </div>
</Modal>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string LibraryId { get; set; }

    [Parameter]
    public EventCallback<ComponentPartsSchema> OnComponentCreated { get; set; }

    private ComponentCreateModel _componentModel = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        // 当模态框打开时重置表单
        if (Visible)
        {
            _componentModel = new ComponentCreateModel
            {
                ComponentType = 1, // 默认原子组件
                IsContainer = false,
                IsSupportDataSource = false
            };
        }
    }

    private async Task OnOk()
    {
        // 手动验证必填字段
        if (string.IsNullOrWhiteSpace(_componentModel.ComponentName))
        {
            await Message.ErrorAsync("请输入组件名称");
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_componentModel.Label))
        {
            await Message.ErrorAsync("请输入组件标签");
            return;
        }

        try
        {
            // 创建组件基本信息
            var componentParts = new ComponentPartsSchema
            {
                ComponentId = ShortIdGenerator.Generate(),
                LibraryId = LibraryId,
                ComponentName = _componentModel.ComponentName,
                Label = _componentModel.Label,
                ComponentType = _componentModel.ComponentType,
                IsContainer = _componentModel.IsContainer,
                IsSupportDataSource = _componentModel.IsSupportDataSource,
                Description = _componentModel.Description,
                Fragment = new ComponentPartsFragmentSchema
                {
                    Attributes = new ComponentAttributeFragmentSchema[0]
                },
                AttributeDefineGroups = new List<ComponentPartsAttributeDefineGroupSchema>(),
                EventDefines = new List<ComponentPartsEventDefineSchema>(),
                StyleDefines = new List<ComponentPartsStyleDefineSchema>()
            };

            // 保存基本信息
            var isSuccess = await ComponentPartsAppService.SaveAsync(componentParts);
            if (isSuccess)
            {
                await Message.SuccessAsync("组件创建成功！");
                
                // 关闭模态框
                Visible = false;
                await VisibleChanged.InvokeAsync(Visible);
                
                // 触发组件创建事件，传递组件信息用于后续跳转
                await OnComponentCreated.InvokeAsync(componentParts);
            }
            else
            {
                await Message.ErrorAsync("组件创建失败");
            }
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"组件创建失败：{ex.Message}");
        }
    }

    private async Task OnCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }

    public class ComponentCreateModel
    {
        public string ComponentName { get; set; }
        public string Label { get; set; }
        public int ComponentType { get; set; } = 1;
        public bool IsContainer { get; set; }
        public bool IsSupportDataSource { get; set; }
        public string Description { get; set; }
    }
}