@namespace H.LowCode.PartsDesignEngine
@inherits LowCodeComponentBase

@inject IComponentPartsAppService ComponentPartsAppService

<Modal Title="@_modalTitle" @bind-Visible="@Visible" OnOk="@OnOk" OnCancel="@OnCancel" Width="600">
    <div style="padding: 16px;">
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 组件Id
            </label>
            <Input @bind-Value="@_componentParts.PartsId" Placeholder="请输入组件Id（组件唯一标识, 如 input）" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 显示名称
            </label>
            <Input @bind-Value="@_componentParts.Label" Placeholder="请输入组件显示名称" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                <span style="color: red;">*</span> 组件类型
            </label>
            <RadioGroup @bind-Value="@_componentParts.ComponentType">
                <Radio RadioButton Value="1">原子组件</Radio>
                <Radio RadioButton Value="2">低代码组件</Radio>
            </RadioGroup>
        </div>

        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">是否容器</label>
            <Switch @bind-Value="@_componentParts.IsContainer" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">支持数据源</label>
            <Switch @bind-Value="@_componentParts.IsSupportDataSource" Disabled="@_componentParts.IsContainer" />
        </div>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">描述</label>
            <TextArea @bind-Value="@_componentParts.Description" Placeholder="请输入组件描述" Rows="3" />
        </div>

        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">排序</label>
            <InputNumber @bind-Value="@_componentParts.Order" Min="0" />
        </div>

        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">版本</label>
            <Input @bind-Value="@_componentParts.Version" Placeholder="版本号" />
        </div>
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">发布状态</label>
            <Switch @bind-Value="@_isPublished" />
        </div>
    </div>
</Modal>

@code {

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string LibraryId { get; set; }

    [Parameter]
    public string ComponentId { get; set; }

    [Parameter]
    public bool IsEditMode { get; set; } = false;

    [Parameter]
    public EventCallback<ComponentPartsSchema> OnComponentCreated { get; set; }

    [Parameter]
    public EventCallback<ComponentPartsSchema> OnComponentUpdated { get; set; }

    private ComponentPartsSchema _componentParts;
    private bool _isPublished = false;
    private bool _loading = false;
    private string _modalTitle => IsEditMode ? "编辑组件" : "新增组件";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Visible)
        {
            if (IsEditMode && !string.IsNullOrEmpty(ComponentId))
            {
                await LoadComponentData();
            }
            else
            {
                // 新增模式，重置表单
                _componentParts = new ComponentPartsSchema
                {
                    Id = ShortIdGenerator.Generate(),
                    PartsId = "",
                    ComponentType = 1, // 默认原子组件
                    IsContainer = false,
                    IsSupportDataSource = false,
                    PublishStatus = 0,
                    Order = 0,
                    Version = "0.0.1"
                };
                _isPublished = false;
            }
        }
    }

    private async Task LoadComponentData()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _componentParts = await ComponentPartsAppService.GetByIdAsync(LibraryId, ComponentId);

            if (_componentParts == null)
            {
                await Message.ErrorAsync("未找到组件数据");
                Visible = false;
                await VisibleChanged.InvokeAsync(Visible);
            }
            else
            {
                _isPublished = _componentParts.PublishStatus == 1;
            }
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"加载组件数据失败：{ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnOk()
    {
        // 手动验证必填字段
        if (string.IsNullOrWhiteSpace(_componentParts.PartsId))
        {
            await Message.ErrorAsync("请输入组件Id");
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_componentParts.Label))
        {
            await Message.ErrorAsync("请输入组件标签");
            return;
        }

        try
        {
            _loading = true;
            StateHasChanged();

            if (IsEditMode)
            {
                await UpdateComponent();
            }
            else
            {
                await CreateComponent();
            }
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"操作失败：{ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CreateComponent()
    {
        // 创建组件基本信息
        var componentParts = new ComponentPartsSchema
        {
            Id = ShortIdGenerator.Generate(),
            PartsId = _componentParts.PartsId,
            LibraryId = LibraryId,
            Label = _componentParts.Label,
            ComponentType = _componentParts.ComponentType,
            Order = _componentParts.Order,
            Version = _componentParts.Version,
            IsContainer = _componentParts.IsContainer,
            IsSupportDataSource = _componentParts.IsSupportDataSource,
            PublishStatus = _isPublished ? 1 : 0,
            Description = _componentParts.Description,
            Fragment = new ComponentPartsFragmentSchema
            {
                Attributes = new ComponentAttributeFragmentSchema[0]
            },
            AttributeDefineGroups = new List<ComponentPartsAttributeDefineGroupSchema>(),
            EventDefines = new List<ComponentPartsEventDefineSchema>(),
            StyleDefines = new List<ComponentPartsStyleDefineSchema>()
        };

        // 保存基本信息
        var isSuccess = await ComponentPartsAppService.SaveAsync(componentParts);
        if (isSuccess)
        {
            await Message.SuccessAsync("组件创建成功！");
            
            // 关闭模态框
            Visible = false;
            await VisibleChanged.InvokeAsync(Visible);
            
            // 触发组件创建事件
            await OnComponentCreated.InvokeAsync(componentParts);
        }
        else
        {
            await Message.ErrorAsync("组件创建失败");
        }
    }

    private async Task UpdateComponent()
    {
        // 获取现有组件数据
        var componentParts = await ComponentPartsAppService.GetByIdAsync(LibraryId, ComponentId);
        
        // 更新基本信息
        componentParts.Label = _componentParts.Label;
        componentParts.ComponentType = _componentParts.ComponentType;
        componentParts.Order = _componentParts.Order;
        componentParts.Version = _componentParts.Version;
        componentParts.IsContainer = _componentParts.IsContainer;
        componentParts.IsSupportDataSource = _componentParts.IsSupportDataSource;
        componentParts.PublishStatus = _isPublished ? 1 : 0;
        componentParts.Description = _componentParts.Description;

        // 保存更新
        var isSuccess = await ComponentPartsAppService.SaveAsync(componentParts);
        if (isSuccess)
        {
            await Message.SuccessAsync("组件更新成功！");
            
            // 关闭模态框
            Visible = false;
            await VisibleChanged.InvokeAsync(Visible);
            
            // 触发组件更新事件
            await OnComponentUpdated.InvokeAsync(componentParts);
        }
        else
        {
            await Message.ErrorAsync("组件更新失败");
        }
    }

    private async Task OnCancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }
}