@namespace H.LowCode.PartsDesignEngine
@inherits DesignEngineLowCodeComponentBase

<div class="api-datasource-editor">
    <Card Title="API数据源配置" Size="CardSize.Small">
        <ChildContent>
            <Row Gutter="16">
                <Col Span="12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">API地址 <span style="color: red;">*</span></label>
                        <Input @bind-Value="@DataSource.Path" Placeholder="https://api.example.com/data" />
                    </div>
                </Col>
                <Col Span="12">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">请求方法</label>
                        <Select TItem="string" TItemValue="string" @bind-Value="@DataSource.Method">
                            <SelectOption TItem="string" TItemValue="string" Value="@("GET")">GET</SelectOption>
                            <SelectOption TItem="string" TItemValue="string" Value="@("POST")">POST</SelectOption>
                            <SelectOption TItem="string" TItemValue="string" Value="@("PUT")">PUT</SelectOption>
                            <SelectOption TItem="string" TItemValue="string" Value="@("DELETE")">DELETE</SelectOption>
                        </Select>
                    </div>
                </Col>
            </Row>
            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">请求头</label>
                <APIParamsList APIParams="@DataSource.Headers" />
            </div>
            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">请求参数</label>
                <APIParamsList APIParams="@DataSource.Queries" />
            </div>
            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">请求体</label>
                <TextArea @bind-Value="@DataSource.Body.Value" Rows="4" Placeholder="JSON格式的请求体（POST/PUT请求时使用）" />
            </div>
        </ChildContent>
    </Card>
</div>

@code {
    [Parameter]
    public APIDataSourceSchema DataSource { get; set; }
    
    [Parameter]
    public EventCallback<APIDataSourceSchema> DataSourceChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (DataSource == null)
        {
            DataSource = new APIDataSourceSchema
            {
                Method = "GET",
                Headers = new List<APIParamSchema>(),
                Queries = new List<APIParamSchema>(),
                Body = new APIBodySchema()
            };
        }
        if (DataSource.Headers == null)
        {
            DataSource.Headers = new List<APIParamSchema>();
        }
        if (DataSource.Queries == null)
        {
            DataSource.Queries = new List<APIParamSchema>();
        }
        if (DataSource.Body == null)
        {
            DataSource.Body = new APIBodySchema();
        }
    }

    private async Task NotifyChange()
    {
        await DataSourceChanged.InvokeAsync(DataSource);
        StateHasChanged();
    }
}