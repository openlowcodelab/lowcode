@using AntDesign
@using H.LowCode.MetaSchema.DesignEngine
@using H.LowCode.MetaSchema
@using H.Util.Ids

<Modal Title="新增组件"
       Visible="@Visible"
       OnOk="@HandleOk"
       OnCancel="@HandleCancel"
       OkText="@("确定")"
       CancelText="@("取消")"
       ConfirmLoading="@_loading">
    <Form @ref="_form" Model="@_model" LabelCol="new ColLayoutParam { Span = 6 }" WrapperCol="new ColLayoutParam { Span = 18 }">
        <FormItem Label="组件名称" Required>
            <Input @bind-Value="@_model.ComponentName" Placeholder="请输入组件名称" />
        </FormItem>
        
        <FormItem Label="组件标签" Required>
            <Input @bind-Value="@_model.Label" Placeholder="请输入组件标签" />
        </FormItem>
        
        <FormItem Label="组件类型" Required>
            <Select @bind-Value="@_model.ComponentType" Placeholder="请选择组件类型" TItemValue="int" TItem="int">
                <SelectOption TItemValue="int" TItem="int" Value="1">原子组件</SelectOption>
                <SelectOption TItemValue="int" TItem="int" Value="2">低代码组件</SelectOption>
            </Select>
        </FormItem>
        
        <FormItem Label="是否容器">
            <Switch @bind-Value="@_model.IsContainer" />
        </FormItem>
        
        <FormItem Label="支持数据源">
            <Switch @bind-Value="@_model.IsSupportDataSource" />
        </FormItem>
        
        <FormItem Label="描述">
            <TextArea @bind-Value="@_model.Description" Placeholder="请输入组件描述" Rows="3" />
        </FormItem>
    </Form>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string LibraryId { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<ComponentPartsSchema> OnComponentCreated { get; set; }

    private Form<ComponentModel> _form;
    private ComponentModel _model = new();
    private bool _loading = false;

    public class ComponentModel
    {
        public string ComponentName { get; set; }
        public string Label { get; set; }
        public int ComponentType { get; set; } = 1;
        public bool IsContainer { get; set; }
        public bool IsSupportDataSource { get; set; }
        public string Description { get; set; }
    }

    private async Task HandleOk()
    {
        if (!_form.Validate())
            return;

        _loading = true;
        try
        {
            var componentParts = new ComponentPartsSchema
            {
                ComponentId = ShortIdGenerator.Generate(),
                LibraryId = LibraryId,
                ComponentName = _model.ComponentName,
                Label = _model.Label,
                ComponentType = _model.ComponentType,
                IsContainer = _model.IsContainer,
                IsSupportDataSource = _model.IsSupportDataSource,
                Description = _model.Description,
                Fragment = new ComponentPartsFragmentSchema
                {
                    TypeName = "div",
                    Attributes = new ComponentAttributeFragmentSchema[0],
                    ChildFragments = new ComponentPartsFragmentSchema[0]
                },
                AttributeDefineGroups = new List<ComponentPartsAttributeDefineGroupSchema>(),
                EventDefines = new List<ComponentPartsEventDefineSchema>(),
                StyleDefines = new List<ComponentPartsStyleDefineSchema>(),
                Childrens = new List<ComponentPartsSchema>(),
                Order = 0,
                PublishStatus = 0,
                ModifiedTime = DateTime.Now
            };

            await OnComponentCreated.InvokeAsync(componentParts);
            await HandleCancel();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleCancel()
    {
        _model = new ComponentModel();
        await VisibleChanged.InvokeAsync(false);
    }
}