@namespace H.LowCode.PartsDesignEngine
@inherits DesignEngineLowCodeComponentBase

<div class="style-define-editor">
    <AntDesign.Card Title="样式定义" Size="@CardSize.Small">
        <AntDesign.Extra>
            <Button Type="@ButtonType.Primary" Icon="plus" Size="@ButtonSize.Small" OnClick="AddStyle">
                添加样式
            </Button>
        </AntDesign.Extra>
        <AntDesign.ChildContent>
            @if (_stylesList != null && _stylesList.Any())
            {
                @for (int i = 0; i < _stylesList.Count; i++)
                {
                    var styleDefine = _stylesList[i];
                    var currentIndex = i;
                    <AntDesign.Card Size="@CardSize.Small" Style="margin-bottom: 12px;">
                        <AntDesign.Extra>
                            <Button Type="@ButtonType.Text" Icon="delete" Size="@ButtonSize.Small" 
                                    OnClick="@(() => RemoveStyle(currentIndex))" Danger>删除</Button>
                        </AntDesign.Extra>
                        <AntDesign.ChildContent>
                            <AntDesign.Row Gutter="16">
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">样式名称 <span style="color: red;">*</span></label>
                                        <Input @bind-Value="@styleDefine.StyleName" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="样式名称，如：backgroundColor" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">显示名称</label>
                                        <Input @bind-Value="@styleDefine.DisplayName" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="显示名称，如：背景颜色" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">样式类型</label>
                                        <AntDesign.Select TItem="string" TItemValue="string" @bind-Value="@styleDefine.StyleType" 
                                                @onchange="@(() => NotifyChange())"
                                                DefaultValue='@("color")'>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("color")'>颜色</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("size")'>尺寸</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("spacing")'>间距</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("border")'>边框</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("font")'>字体</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("layout")'>布局</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("custom")'>自定义</AntDesign.SelectOption>
                                        </AntDesign.Select>
                                    </div>
                                </AntDesign.Col>
                            </AntDesign.Row>
                            <AntDesign.Row Gutter="16">
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">控件类型</label>
                                        <AntDesign.Select TItem="string" TItemValue="string" @bind-Value="@styleDefine.ControlType" 
                                                @onchange="@(() => NotifyChange())"
                                                DefaultValue='@("input")'>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("input")'>输入框</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("colorPicker")'>颜色选择器</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("slider")'>滑块</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("select")'>下拉选择</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("switchCtrl")'>开关</AntDesign.SelectOption>
                                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value='@("inputNumber")'>数字输入</AntDesign.SelectOption>
                                        </AntDesign.Select>
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">默认值</label>
                                        <Input @bind-Value="@styleDefine.DefaultValue" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="默认值" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="8">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">单位</label>
                                        <Input @bind-Value="@styleDefine.Unit" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="单位，如：px, %, em" />
                                    </div>
                                </AntDesign.Col>
                            </AntDesign.Row>
                            <AntDesign.Row Gutter="16">
                                <AntDesign.Col Span="12">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">样式描述</label>
                                        <TextArea @bind-Value="@styleDefine.Description" 
                                                  @onchange="@(() => NotifyChange())"
                                                  Rows="2" 
                                                  Placeholder="样式描述" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="12">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">选项配置</label>
                                        <TextArea @bind-Value="@styleDefine.Options" 
                                                  @onchange="@(() => NotifyChange())"
                                                  Rows="2" 
                                                  Placeholder="选项配置（JSON格式，用于下拉选择等控件）" />
                                    </div>
                                </AntDesign.Col>
                            </AntDesign.Row>
                            <AntDesign.Row Gutter="16">
                                <AntDesign.Col Span="6">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">是否必需</label>
                                        <Switch @bind-Checked="@styleDefine.IsRequired" 
                                                @onchange="@(() => NotifyChange())" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">排序</label>
                                        <InputNumber @bind-Value="@styleDefine.Order" 
                                                     @onchange="@(() => NotifyChange())"
                                                     Min="0" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">分组</label>
                                        <Input @bind-Value="@styleDefine.Group" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="样式分组" />
                                    </div>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <div style="margin-bottom: 16px;">
                                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">CSS属性</label>
                                        <Input @bind-Value="@styleDefine.CssProperty" 
                                               @onchange="@(() => NotifyChange())"
                                               Placeholder="对应的CSS属性名" />
                                    </div>
                                </AntDesign.Col>
                            </AntDesign.Row>
                        </AntDesign.ChildContent>
                    </AntDesign.Card>
                }
            }
            else
            {
                <AntDesign.Empty Description="@emptyDescription" />
            }
        </AntDesign.ChildContent>
    </AntDesign.Card>
</div>

@code {
    [Parameter]
    public List<ComponentPartsStyleDefineSchema> StyleDefines { get; set; }

    [Parameter]
    public EventCallback<IEnumerable<ComponentPartsStyleDefineSchema>> StyleDefinesChanged { get; set; }

    private List<ComponentPartsStyleDefineSchema> _stylesList = new();
    private string emptyDescription = "暂无样式定义";

    protected override void OnParametersSet()
    {
        if (StyleDefines != null)
        {
            _stylesList = StyleDefines.ToList();
        }
        else
        {
            _stylesList = new List<ComponentPartsStyleDefineSchema>();
        }
    }

    private async Task AddStyle()
    {
        _stylesList.Add(new ComponentPartsStyleDefineSchema
        {
            StyleName = "",
            DisplayName = "",
            StyleType = "color",
            ControlType = "input",
            IsRequired = false,
            Order = _stylesList.Count
        });
        await NotifyChange();
    }

    private async Task RemoveStyle(int index)
    {
        if (index >= 0 && index < _stylesList.Count)
        {
            _stylesList.RemoveAt(index);
            await NotifyChange();
        }
    }

    private async Task NotifyChange()
    {
        await StyleDefinesChanged.InvokeAsync(_stylesList);
        StateHasChanged();
    }
}