@namespace H.LowCode.PartsDesignEngine
@inherits DesignEngineLowCodeComponentBase

<div class="sql-data-source-editor">
    <AntDesign.Card Size="CardSize.Small" Style="margin-bottom: 8px;">
        <AntDesign.ChildContent>
            <AntDesign.Row Gutter="16">
                <AntDesign.Col Span="12">
                    <FormItem Label="数据库类型">
                        <AntDesign.Select TItem="string" TItemValue="string" @bind-Value="DataSource.DbType">
                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value="@("SqlServer")">SQL Server</AntDesign.SelectOption>
                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value="@("MySQL")">MySQL</AntDesign.SelectOption>
                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value="@("PostgreSQL")">PostgreSQL</AntDesign.SelectOption>
                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value="@("Oracle")">Oracle</AntDesign.SelectOption>
                            <AntDesign.SelectOption TItem="string" TItemValue="string" Value="@("SQLite")">SQLite</AntDesign.SelectOption>
                        </AntDesign.Select>
                    </FormItem>
                </AntDesign.Col>
            </AntDesign.Row>
            <AntDesign.Row Gutter="16">
                <AntDesign.Col Span="24">
                    <FormItem Label="SQL 查询">
                        <TextArea @bind-Value="DataSource.Sql" Rows="4" Placeholder="请输入 SQL 查询语句" />
                    </FormItem>
                </AntDesign.Col>
            </AntDesign.Row>
        </AntDesign.ChildContent>
    </AntDesign.Card>
</div>

@code {
    [Parameter]
    public SQLDataSourceSchema DataSource { get; set; }
    [Parameter]
    public EventCallback<SQLDataSourceSchema> DataSourceChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (DataSource == null)
        {
            DataSource = new SQLDataSourceSchema
            {
                DbType = "SqlServer",
                Sql = ""
            };
        }
    }
}