@namespace H.LowCode.PartsDesignEngine
@inherits DesignEngineLowCodeComponentBase
@using AntDesign

<div class="event-define-editor">
    @if (EventDefines != null && EventDefines.Count > 0)
    {
        @for (int i = 0; i < EventDefines.Count; i++)
        {
            var eventDefine = EventDefines[i];
            <AntDesign.Card Size="@CardSize.Small" Style="margin-bottom: 12px;">
                <AntDesign.ChildContent>
                    <AntDesign.Row Gutter="16">
                        <AntDesign.Col Span="8">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">事件名称 <span style="color: red;">*</span></label>
                                <AntDesign.Input @bind-Value="eventDefine.Name" Placeholder="请输入事件名称" />
                            </div>
                        </AntDesign.Col>
                        <AntDesign.Col Span="8">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">事件类型 <span style="color: red;">*</span></label>
                                <AntDesign.Select TItemValue="string" TItem="string" @bind-Value="eventDefine.EventType" Placeholder="请选择事件类型">
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("click")">点击事件</AntDesign.SelectOption>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("change")">值变更事件</AntDesign.SelectOption>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("focus")">获得焦点</AntDesign.SelectOption>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("blur")">失去焦点</AntDesign.SelectOption>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("submit")">提交事件</AntDesign.SelectOption>
                                    <AntDesign.SelectOption TItemValue="string" TItem="string" Value="@("custom")">自定义事件</AntDesign.SelectOption>
                                </AntDesign.Select>
                            </div>
                        </AntDesign.Col>
                        <AntDesign.Col Span="8">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">参数定义</label>
                                <AntDesign.TextArea @bind-Value="eventDefine.ParameterType" Rows="2" Placeholder="请输入参数定义" />
                            </div>
                        </AntDesign.Col>
                    </AntDesign.Row>
                    <AntDesign.Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">描述</label>
                                <AntDesign.Input @bind-Value="eventDefine.Description" Placeholder="事件描述" />
                            </div>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 4px; font-weight: 500;">操作</label>
                                <AntDesign.Button Type="@ButtonType.Text" Icon="delete" Size="@ButtonSize.Small" OnClick="@(() => RemoveEvent(i))" Danger>删除事件</AntDesign.Button>
                            </div>
                        </AntDesign.Col>
                    </AntDesign.Row>
                </AntDesign.ChildContent>
            </AntDesign.Card>
        }
    }
    else
    {
        <AntDesign.Empty Description="@("暂无事件定义")" />
    }
    <AntDesign.Button Type="@ButtonType.Dashed" Block OnClick="@AddEvent" Icon="plus">添加事件</AntDesign.Button>
</div>

@code {
    [Parameter]
    public List<ComponentPartsEventDefineSchema> EventDefines { get; set; }

    [Parameter]
    public EventCallback<List<ComponentPartsEventDefineSchema>> EventDefinesChanged { get; set; }

    private async Task AddEvent()
    {
        EventDefines ??= new List<ComponentPartsEventDefineSchema>();
        EventDefines.Add(new ComponentPartsEventDefineSchema
        {
            Name = "",
            EventType = "click",
            ParameterType = "",
            Description = ""
        });
        await EventDefinesChanged.InvokeAsync(EventDefines);
        StateHasChanged();
    }

    private async Task RemoveEvent(int index)
    {
        if (EventDefines != null && index >= 0 && index < EventDefines.Count)
        {
            EventDefines.RemoveAt(index);
            await EventDefinesChanged.InvokeAsync(EventDefines);
            StateHasChanged();
        }
    }
}