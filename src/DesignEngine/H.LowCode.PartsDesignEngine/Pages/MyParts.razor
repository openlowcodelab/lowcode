@page "/myparts/{Tab?}"
@namespace H.LowCode.PartsDesignEngine
@inherits LowCodePageComponentBase
@layout DesignEngineNavLayout

<PageTitle>我的物料 - H.LowCode</PageTitle>

<Tabs DefaultActiveKey="componentlibraries" ActiveKey="@_tabKey" Centered Animated Style="width: 80%; margin: auto;">
    <TabPane Tab="组件库" Key="componentlibraries">
        <ComponentLibraryManager></ComponentLibraryManager>
    </TabPane>
    <TabPane Tab="页面库" Key="pagelibraries">
        <PageLibraryList></PageLibraryList>
    </TabPane>
    <TabPane Tab="应用模板" Key="apptemplates">
        <AppPartsList></AppPartsList>
    </TabPane>
    <TabPane Tab="主题" Key="themes">
        <ThemePartsList></ThemePartsList>
    </TabPane>
</Tabs>

@code {
    [Parameter]
    public string? Tab { get; set; }

    private string LibraryId => GetQueryValue("libId");

    private string _tabKey => Tab ?? "componentlibraries";
}