@namespace H.LowCode.DesignEngine
@inherits LowCodeComponentBase

@if (DataSource != null)
{
    <Tabs DefaultActiveKey="1">
        <TabPane Key="1" Tab="数据源配置">
            <div class="propertysetting-item">
                <label>数据源类型：</label>
                <RadioGroup DefaultValue="ComponentDataSourceTypeEnum.Fiexd"
                    @bind-Value="@DataSource.DataSourceType">
                    <Radio AutoFocus="true" Value="ComponentDataSourceTypeEnum.Fiexd">固定值</Radio>
                    <Radio Value="ComponentDataSourceTypeEnum.API">API</Radio>
                    <Radio Value="ComponentDataSourceTypeEnum.SQL">SQL</Radio>
                </RadioGroup>
            </div>

            @if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.Fiexd)
            {
                <FixedListDataSource @bind-DataSource="DataSource.ListDataSource"></FixedListDataSource>
            }
            else if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.API)
            {
                <div style="margin: 16px 0;">
                    <Alert Type="@AntDesign.AlertType.Info" 
                           Message="API 数据源配置"
                           Description="配置 API 接口，返回的数据应该是数组格式" />
                    <div style="margin-top: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">API 接口</label>
                        @* TODO: 实现 API 配置界面 *@
                        <Input TValue="string" Placeholder="API 接口地址" />
                    </div>
                </div>
            }
            else if (DataSource.DataSourceType == ComponentDataSourceTypeEnum.SQL)
            {
                <div style="margin: 16px 0;">
                    <Alert Type="@AntDesign.AlertType.Info" 
                           Message="SQL 数据源配置"
                           Description="配置 SQL 查询语句，返回的数据应该是列表格式" />
                    <div style="margin-top: 16px;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">SQL 查询</label>
                        @* TODO: 实现 SQL 配置界面 *@
                        <TextArea Rows="4" Placeholder="SELECT * FROM tb_question WHERE survey_id = {surveyId}" />
                    </div>
                </div>
            }
        </TabPane>

        <TabPane Key="2" Tab="ItemTemplate 配置">
            <Alert Type="@AntDesign.AlertType.Info" 
                   Message="ItemTemplate 说明"
                   Description="ItemTemplate 定义每个列表项的组件结构。可以配置组件类型、属性绑定等。使用 $(item.fieldName) 语法绑定数据字段。"
                   Style="margin-bottom: 16px;" />
            
            @if (DataSource.DataSourceFragment != null)
            {
                <ComponentFragmentEditor Fragment="@DataSource.DataSourceFragment" />
            }
            else
            {
                <Button Type="@ButtonType.Dashed" OnClick="AddItemTemplate" Icon="plus">添加 ItemTemplate</Button>
            }
        </TabPane>
    </Tabs>
}

@code {
    [Parameter]
    public string AppId { get; set; }

    [Parameter]
    public ComponentPartsDataSourceSchema DataSource { get; set; }

    [Parameter]
    public EventCallback<ComponentPartsDataSourceSchema> DataSourceChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        // 初始化 ListDataSource
        if (DataSource != null && DataSource.ListDataSource == null)
        {
            DataSource.ListDataSource = new ListDataSourceSchema
            {
                FixedData = new List<Dictionary<string, object>>()
            };
        }
    }

    private void AddItemTemplate()
    {
        if (DataSource != null)
        {
            DataSource.DataSourceFragment = new ComponentPartsFragmentSchema
            {
                TypeName = "AntDesign.ListItem, AntDesign",
                DefaultTypeName = "AntDesign.ListItem, AntDesign",
                Attributes = Array.Empty<ComponentAttributeFragmentSchema>(),
                ChildFragments = Array.Empty<ComponentPartsFragmentSchema>()
            };
            StateHasChanged();
        }
    }
}
