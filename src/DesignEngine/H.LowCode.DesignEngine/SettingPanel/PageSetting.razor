@namespace H.LowCode.DesignEngine
@inherits DesignEngineLowCodeComponentBase

@if (Page != null)
{
    <div class="pagesetting-item">
        <label>布局：</label>
        <RadioGroup TValue="int" @bind-Value="@Page.PageProperty.PageLayout" OnChange="OnLayoutChange">
            <Radio RadioButton Value="1">一列</Radio>
            <Radio RadioButton Value="2">两列</Radio>
            <Radio RadioButton Value="3">三列</Radio>
            <Radio RadioButton Value="4">四列</Radio>
        </RadioGroup>
    </div>

    @* 表单页 *@
    @if (Page.PageType == PageTypeEnum.Form)
    {
        <div style="border-left: 5px solid #d0d4da;padding: 0 0 0 8px; margin:30px 0 10px;">数据源</div>
        <div class="propertysetting-item">
            <label>类型：</label>
            <EnumRadioGroup TEnum="PageDataSourceTypeEnum" @bind-Value="@Page.DataSource.DataSourceType" Name="radio_datasourcetype"></EnumRadioGroup>
        </div>

        @if (Page.DataSource.DataSourceType == PageDataSourceTypeEnum.DB)
        {
            <div class="propertysetting-item">
                <label>表：</label>
                <Input TValue="string" @bind-value="@Page.DataSource.DataSourceValue" />
            </div>
        }
        else if (Page.DataSource.DataSourceType == PageDataSourceTypeEnum.API)
        {
            <div class="propertysetting-item">
                <label>API：</label>

            </div>
        }
    }

    <div style="border-left: 5px solid #d0d4da;padding: 0 0 0 8px; margin:30px 0 10px;">其它</div>
    <div class="pagesetting-item">
        <label>自定义样式：</label>
        <TextArea @bind-value="@Page.PageProperty.CustomStyle" OnChange="OnStyleChange" Style="height: 150px;" />
    </div>

    @*事件属性*@
    <div style="border-left: 5px solid #d0d4da;padding: 0 0 0 8px; margin:30px 0 10px;">事件</div>
    <Button Type="ButtonType.Default" OnClick="() => ShowEventModal()">
        配置事件
    </Button>
}

<Modal Title="配置事件" @bind-Visible="@_eventVisible"
       OnOk="()=>OnEventConfirm()" Width="1000">
    <EventList Events="@_eventList"></EventList>
</Modal>

@code {
    [Parameter]
    public PagePartsSchema Page { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private void OnLayoutChange(int pageLayout)
    {
        // 使用InvokeAsync确保在正确的线程上下文中执行
        InvokeAsync(() => BlazorEventDispatcher.Publish("designengine.pagesetting.pagelayout.onchange", pageLayout));
    }

    private void OnStyleChange(string customStyle)
    {
        
    }

    private bool _eventVisible;
    private IList<EventSchema> _eventList;

    private void ShowEventModal()
    {
        _eventList = Page.Events ?? [];
        foreach (var ev in Page.SupportEvents)
        {
            var any = _eventList.Any(t => string.Equals(t.EventName, ev, StringComparison.OrdinalIgnoreCase));
            if (any)
                continue;
            _eventList.Add(new() { EventName = ev });
        }

        _eventVisible = true;
    }

    private void OnEventConfirm()
    {
        Page.Events = _eventList;
        _eventVisible = false;
    }
}
