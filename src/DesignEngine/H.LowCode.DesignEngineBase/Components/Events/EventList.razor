@namespace H.LowCode.DesignEngineBase
@inherits LowCodeComponentBase

@inject IPageAppService PageAppService
@inject IComponentPartsAppService ComponentPartsAppService

<Layout Style="height: 550px;">
    <Sider Style="background:#ffffff">
        <Tree TItem="string" OnSelect="OnEventSelect"
              DefaultSelectedKey="@_firstNodeKey"
                Style="height:100%; border:solid 1px #e8e8e8; padding-top:5px; margin-right:5px;">
            @foreach(var ev in Events)
            {
                <TreeNode Title="@ev.EventName" Key="@ev.EventName"></TreeNode>
            }
        </Tree>
    </Sider>
    <Layout Style="background:#ffffff">
        <Content>
            <div class="propertysetting-item">
                <label>事件对象：</label>
                <RadioGroup DefaultValue="EventTargetTypeEnum.None"
                            @bind-Value="@_currentEvent.EventHandlerType">
                    <Radio AutoFocus="true" Value="EventTargetTypeEnum.None">无</Radio>
                    <Radio Value="EventTargetTypeEnum.Page">页面</Radio>
                    <Radio Value="EventTargetTypeEnum.Component">组件</Radio>
                    <Radio Value="EventTargetTypeEnum.Data">数据</Radio>
                    <Radio Value="EventTargetTypeEnum.Custom">自定义</Radio>
                </RadioGroup>
            </div>

            @if (_currentEvent.EventHandlerType == EventTargetTypeEnum.Page)
            {
                <div class="propertysetting-item">
                    <label>选择页面：</label>
                    <Select DataSource="@_pageList"
                            @bind-Value="@_currentEvent.EventTargetId"
                            ItemValue="p => p.PageId"
                            ItemLabel="p => p.PageName"
                            EnableSearch
                            AllowClear>
                    </Select>
                </div>
                <div class="propertysetting-item">
                    <label>选择操作：</label>
                    <RadioGroup @bind-Value="@_currentEvent.EventTargetAction">
                        <Radio Value="@("11")">刷新</Radio>
                        <Radio Value="@("12")">弹窗</Radio>
                        <Radio Value="@("13")">当前页</Radio>
                        <Radio Value="@("14")">新标签页</Radio>
                    </RadioGroup>
                </div>
                <div class="propertysetting-item">
                    <label>设置参数：</label>
                    <div style="margin-top: 10px;">
                        <label style="font-size: 12px; color: #666;">固定参数：</label>
                        @if (_currentEvent.EventArgs == null)
                        {
                            _currentEvent.EventArgs = new Dictionary<string, string>();
                        }
                        @foreach (var arg in _currentEvent.EventArgs.ToList())
                        {
                            var currentKey = arg.Key;
                            var currentValue = arg.Value;
                            <div style="display: flex; margin-bottom: 5px; align-items: center;">
                                <Input Value="@currentKey" Placeholder="参数名" Style="width: 100px; margin-right: 5px;" 
                                       OnChange="@((string value) => UpdateEventArgKey(currentKey, value))" />
                                <Input Value="@currentValue" Placeholder="参数值" Style="width: 120px; margin-right: 5px;" 
                                       OnChange="@((string value) => UpdateEventArgValue(currentKey, value))" />
                                <Button Size="ButtonSize.Small" Type="ButtonType.Text" OnClick="() => RemoveEventArg(currentKey)">删除</Button>
                            </div>
                        }
                        <Button Size="ButtonSize.Small" Type="ButtonType.Dashed" OnClick="AddEventArg">添加固定参数</Button>
                    </div>
                    <div style="margin-top: 15px;">
                        <label style="font-size: 12px; color: #666;">行数据参数映射：</label>
                        @if (_currentEvent.RowDataParams == null)
                        {
                            _currentEvent.RowDataParams = new Dictionary<string, string>();
                        }
                        @foreach (var param in _currentEvent.RowDataParams.ToList())
                        {
                            var currentKey = param.Key;
                            var currentValue = param.Value;
                            <div style="display: flex; margin-bottom: 5px; align-items: center;">
                                <Input Value="@currentKey" Placeholder="URL参数名" Style="width: 100px; margin-right: 5px;" 
                                       OnChange="@((string value) => UpdateRowDataParamKey(currentKey, value))" />
                                <Input Value="@currentValue" Placeholder="行数据字段名" Style="width: 120px; margin-right: 5px;" 
                                       OnChange="@((string value) => UpdateRowDataParamValue(currentKey, value))" />
                                <Button Size="ButtonSize.Small" Type="ButtonType.Text" OnClick="() => RemoveRowDataParam(currentKey)">删除</Button>
                            </div>
                        }
                        <Button Size="ButtonSize.Small" Type="ButtonType.Dashed" OnClick="AddRowDataParam">添加行数据参数</Button>
                    </div>
                </div>
            }
            else if (_currentEvent.EventHandlerType == EventTargetTypeEnum.Component)
            {
                <div class="propertysetting-item">
                    <label>选择组件：</label>
                    <Select DataSource="@_componentList"
                            @bind-Value="@_currentEvent.EventTargetId"
                            ItemValue="p => p.Id"
                            ItemLabel="p => p.Label"
                            TItem="ComponentListModel"
                            TItemValue="string"
                            EnableSearch
                            AllowClear
                            OnSelectedItemChanged="OnComponentSelectedItemChangedHandler">
                    </Select>
                </div>
                <div class="propertysetting-item">
                    <label>选择操作：</label>
                    <RadioGroup @bind-Value="@_currentEvent.EventTargetAction">
                        @foreach (var eventAction in _componentEventTargetActions)
                        {
                            <Radio Value="@eventAction.EventName">@eventAction.EventDisplayName</Radio>
                        }
                    </RadioGroup>
                </div>
            }
            else if (_currentEvent.EventHandlerType == EventTargetTypeEnum.Data)
            {
                <div class="propertysetting-item">
                    <label>选择操作：</label>
                    <RadioGroup @bind-Value="@_currentEvent.EventDataActionType">
                        <Radio Value="EventDataActionTypeEnum.EditRow">编辑行</Radio>
                        <Radio Value="EventDataActionTypeEnum.DeleteRow">删除行</Radio>
                        <Radio Value="EventDataActionTypeEnum.SaveRow">保存行</Radio>
                        <Radio Value="EventDataActionTypeEnum.CancelEdit">取消编辑</Radio>
                        <Radio Value="EventDataActionTypeEnum.AddRow">添加行</Radio>
                        <Radio Value="EventDataActionTypeEnum.RefreshData">刷新数据</Radio>
                    </RadioGroup>
                </div>
            }
            else if (_currentEvent.EventHandlerType == EventTargetTypeEnum.Custom)
            {
                <div class="propertysetting-item">
                    <label>语言：</label>
                    <RadioGroup @bind-Value="@_currentEvent.EventCustomLanguage">
                        <Radio Value="EventCustomLanguageEnum.JavaScript">JavaScript</Radio>
                        <Radio Value="EventCustomLanguageEnum.Python">Python</Radio>
                        <Radio Value="EventCustomLanguageEnum.CSharp">C#</Radio>
                    </RadioGroup>
                </div>
                <div class="propertysetting-item" style="height:463px;">
                    <TextArea @bind-value="@_currentEvent.EventCustomScript" Style="height:100%;" />
                </div>
            }
        </Content>
    </Layout>
</Layout>

@code {
    [Parameter]
    public IList<EventSchema> Events { get; set; }

    [CascadingParameter(Name = "pageCascading")]
    public PageCascadingModel PageCascading { get; set; }

    private string _firstNodeKey;
    private EventSchema _currentEvent = new();

    private PageListModel[] _pageList;
    private ComponentListModel[] _componentList;
    private EventConsumeSchema[] _componentEventTargetActions = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        InitEvents();
        await LoadPagesAsync();
        await LoadComponentsAsync();
    }

    private void InitEvents()
    {
        if (Events == null)
        {
            Events = [];
        }

        _firstNodeKey = Events.FirstOrDefault()?.EventName ?? string.Empty;
    }

    private void OnEventSelect(TreeEventArgs<string> args)
    {
        var ev = Events.FirstOrDefault(e => e.EventName == args.Node.Key);
        if (ev != null)
        {
            _currentEvent = ev;
        }
    }

    private async Task LoadPagesAsync()
    {
        var result = await PageAppService.GetListAsync(PageCascading.AppId);
        _pageList = result?.ToArray() ?? [];
    }

    private async Task LoadComponentsAsync()
    {
        var result = await PageAppService.GetByIdAsync(PageCascading.AppId, PageCascading.PageId);
        _componentList = result?.Components
            ?.Select(t =>
                new ComponentListModel()
                    {
                        Id = t.Id,
                        Name = t.Name,
                        Label = t.Label,
                    })?.ToArray()
            ?? [];
    }

    private async Task OnComponentSelectedItemChangedHandler(ComponentListModel comp)
    {
        await LoadComponentEventTargetActionsAsync(comp.Id);
    }

    private async Task LoadComponentEventTargetActionsAsync(string componentId)
    {
        var component = await PageAppService.GetPageComponentAsync(PageCascading.AppId, PageCascading.PageId, componentId);
        _componentEventTargetActions = component?.EventConsumes?.ToArray() ?? [];
    }

    private void AddEventArg()
    {
        if (_currentEvent.EventArgs == null)
        {
            _currentEvent.EventArgs = new Dictionary<string, string>();
        }
        
        var newKey = $"param{_currentEvent.EventArgs.Count + 1}";
        _currentEvent.EventArgs[newKey] = "";
    }

    private void RemoveEventArg(string key)
    {
        if (_currentEvent.EventArgs != null && _currentEvent.EventArgs.ContainsKey(key))
        {
            _currentEvent.EventArgs.Remove(key);
        }
    }

    private void AddRowDataParam()
    {
        if (_currentEvent.RowDataParams == null)
        {
            _currentEvent.RowDataParams = new Dictionary<string, string>();
        }
        
        var newKey = $"param{_currentEvent.RowDataParams.Count + 1}";
        _currentEvent.RowDataParams[newKey] = "";
    }

    private void RemoveRowDataParam(string key)
    {
        if (_currentEvent.RowDataParams != null && _currentEvent.RowDataParams.ContainsKey(key))
        {
            _currentEvent.RowDataParams.Remove(key);
        }
    }

    private void UpdateEventArgKey(string oldKey, string newKey)
    {
        if (_currentEvent.EventArgs != null && _currentEvent.EventArgs.ContainsKey(oldKey) && !string.IsNullOrEmpty(newKey) && newKey != oldKey)
        {
            var value = _currentEvent.EventArgs[oldKey];
            _currentEvent.EventArgs.Remove(oldKey);
            _currentEvent.EventArgs[newKey] = value;
        }
    }

    private void UpdateEventArgValue(string key, string value)
    {
        if (_currentEvent.EventArgs != null && _currentEvent.EventArgs.ContainsKey(key))
        {
            _currentEvent.EventArgs[key] = value ?? "";
        }
    }

    private void UpdateRowDataParamKey(string oldKey, string newKey)
    {
        if (_currentEvent.RowDataParams != null && _currentEvent.RowDataParams.ContainsKey(oldKey) && !string.IsNullOrEmpty(newKey) && newKey != oldKey)
        {
            var value = _currentEvent.RowDataParams[oldKey];
            _currentEvent.RowDataParams.Remove(oldKey);
            _currentEvent.RowDataParams[newKey] = value;
        }
    }

    private void UpdateRowDataParamValue(string key, string value)
    {
        if (_currentEvent.RowDataParams != null && _currentEvent.RowDataParams.ContainsKey(key))
        {
            _currentEvent.RowDataParams[key] = value ?? "";
        }
    }
}
