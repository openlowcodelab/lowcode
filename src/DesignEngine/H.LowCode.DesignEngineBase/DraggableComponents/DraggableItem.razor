        //         if (!ReferenceEquals(child, DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId)))
        //         {
        //             child.DesignState.AnimationTransform = string.Empty;
        //             child.DesignState.IsAnimating = false;
        //             child.RefreshState();
        //         }
        //     }
        // }
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (IsInRootContainer)
            {
                BlazorEventDispatcher.Remove("designengine.pagesetting.pagelayout.onchange");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing DraggableItem: {ex.Message}");
        }
    }
}