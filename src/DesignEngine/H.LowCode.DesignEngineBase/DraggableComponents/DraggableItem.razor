@namespace H.LowCode.DesignEngineBase
@inherits DesignEngineLowCodeComponentBase
@implements IAsyncDisposable

@inject DragDropStateService DragDropStateService
@inject IJSRuntime JSRuntime

<div @ref="itemRef" class="draggableitem-box @DraggableItemBoxClassMapper.Class"
    draggable="true" data-component-id="@Component.Id"
     style="float:left;
        width: @((Component.Style.ItemWidth > 4 ? Component.Style.ItemWidth : (IsInRootContainer ? 24/PageCascading.PageLayout : 24))  /24 * 100)%;
        min-height: @(Component.Style.ItemHeight)px;
        transform: @Component.DesignState.AnimationTransform;
        will-change: @(Component.DesignState.IsAnimating ? "transform" : "auto");
        transition: @(Component.DesignState.IsAnimating && !isDragging ? "transform 0.2s ease-out" : "none");
        z-index: @(isDragging ? "9999" : "auto");
        position: @(isDragging ? "relative" : "static");
        pointer-events: @(isDragging ? "none" : "auto");
        @Component.Style.DefaultStyle @Component.Style.CustomStyle"
     @onclick="OnClick" @onclick:stopPropagation
     @ondragstart="OnDragStart" @ondragstart:stopPropagation
     @ondragenter="OnDragEnter" @ondragenter:preventDefault @ondragenter:stopPropagation
     @ondragover="OnDragOver" @ondragover:preventDefault @ondragover:stopPropagation
     @ondrag="OnDrag"
     @ondragleave="OnDragLeave" @ondragleave:stopPropagation
     @ondragend="OnDragEnd" @ondragend:stopPropagation
     @onmouseover="OnMouseOver" @onmouseover:stopPropagation
     @onmouseout="OnMouseOut" @onmouseout:stopPropagation>

    <div @ref="innerRef" draggable="true" class="draggableitem @DraggableItemClassMapper.Class" style="@Component.DesignState.DragEffectStyle">
        @if (Component.DesignState.IsSelected)
        {
            <div draggable="true" class="draggableitem-icon-move">
                <Icon Type="drag" Theme="IconThemeType.Outline" />
            </div>
            <div class="draggableitem-pointer-wrapper">
                <div class="draggableitem-pointer" @onclick="OnDelete">
                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                </div>
                <div class="draggableitem-pointer" @onclick="OnCopy">
                    <Icon Type="copy" Theme="IconThemeType.Outline" />
                </div>
            </div>
        }

        <ComponentItem Component="@Component"></ComponentItem>
    </div>
</div>

@code {
    [CascadingParameter(Name = "pageCascading")]
    public PageCascadingModel PageCascading { get; set; }

    [Parameter]
    public ComponentPartsSchema Component { get; set; }

    /// <summary>
    /// 当前组件是否在根容器内
    /// </summary>
    [Parameter]
    public bool IsInRootContainer { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemClick { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemDelete { get; set; }

    [Parameter]
    public Action<ComponentPartsSchema> OnItemCopy { get; set; }

    protected ClassMapper DraggableItemBoxClassMapper { get; } = new ClassMapper();
    protected ClassMapper DraggableItemClassMapper { get; } = new ClassMapper();

    private ElementReference itemRef;
    private ElementReference innerRef;
    private DragDropElementDimensions dimensions;

    private bool isDragging = false;
    private double initialX = 0;
    private double initialY = 0;
    private long lastAnimationMs = 0;
    private ComponentPartsSchema pendingOverComponent;
    private long pendingOverStartMs = 0;
    private int hoverStableMs = 120;

    private bool TryScheduleAnimation(int intervalMs = 120)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        if (now - lastAnimationMs < intervalMs) return false;
        lastAnimationMs = now;
        return true;
    }

    private bool TryCommitHoverTarget(ComponentPartsSchema candidate)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        if (!ReferenceEquals(pendingOverComponent, candidate))
        {
            pendingOverComponent = candidate;
            pendingOverStartMs = now;
            return false;
        }
        if (now - pendingOverStartMs < hoverStableMs)
            return false;

        DragDropStateService.SetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId, candidate);
        // 清空候选
        pendingOverComponent = null;
        pendingOverStartMs = 0;
        return true;
    }

    #region Init
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Init();
        SetClassMap();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //已在 App.razor 中引入
            //await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/H.LowCode.DesignEngineBase/js/elementUtils.js");

            await UpdateDimensions();
            RegisterEventDispatcher();

            try
            {
                // 优先对内部真实组件容器绑定覆盖层，使拖拽在 WASM 下更稳定
                await JSRuntime.InvokeVoidAsync("elementUtils.attachDragImage", innerRef, Component?.Label ?? "组件");
            }
            catch { }
        }
    }

    private async Task UpdateDimensions()
    {
        try
        {
            dimensions = await JSRuntime.InvokeAsync<DragDropElementDimensions>("elementUtils.getDimensions", itemRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting element dimensions: {ex.Message}");
        }
    }

    private void Init()
    {
        if (Component == null)
            throw new NullReferenceException(nameof(Component));
    }

    private void RegisterEventDispatcher()
    {
        if (IsInRootContainer)
        {
            //订阅 PageSetting 中的组件点击事件
            BlazorEventDispatcher.Subscribe("designengine.pagesetting.pagelayout.onchange", (value) =>
            {
                PageCascading.PageLayout = (int)value;
                StateHasChanged();
            });
        }
    }

    private void SetClassMap()
    {
        DraggableItemClassMapper.Clear()
            .If("draggableitem-selected", () => Component.DesignState.IsSelected)
            .If("draggableitem-component", () => Component.IsContainer == false)
            .If("draggableitem-container", () => Component.IsContainer);

        DraggableItemBoxClassMapper.Clear()
            .If("draggableitem-box-layout", () => Component.IsContainer)
            .If("draggableitem-animating", () => Component.DesignState.IsAnimating);
    }
    #endregion

    #region Event
    private void OnClick()
    {
        Component.DesignState.DragEffectStyle = string.Empty;
        Component.DesignState.AnimationTransform = string.Empty;
        Component.DesignState.IsAnimating = false;

        //重置所有组件的动画状态
        ResetAllAnimationStates();

        OnItemClick.Invoke(Component);
        BlazorEventDispatcher.Publish("designengine.draggableitem.onclick", Component);
    }

    private void OnDragStart(DragEventArgs dragEventArgs)
    {
        // 避免在拖拽开始时触发 Blazor 重渲染，保持 DOM 稳定
        initialX = dragEventArgs.ClientX;
        initialY = dragEventArgs.ClientY;
        Console.WriteLine($"拖拽开始:{initialX}-{initialY}");

        //记录当前选中对象
        DragDropStateService.SetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId, Component);
    }

    private void OnDragEnter(DragEventArgs dragEventArgs)
    {
        // 仅在进入“新”目标组件时触发一次让位，避免在同一组件内重复触发
        var last = DragDropStateService.GetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(last, Component)) return;

        DragDropStateService.SetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId, Component);
        if (TryScheduleAnimation())
        {
            TriggerSiblingAnimation();
        }
    }

    private void OnDragOver(DragEventArgs dragEventArgs)
    {
        Console.WriteLine($"OnDragOver:{isDragging}");
        TriggerCurrentSiblingAnimation(dragEventArgs.ClientX, dragEventArgs.ClientY);

        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(currentDragComponent, Component))
            return;

        var lastDragOverComponent = DragDropStateService.GetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId);

        // 只有当拖拽到不同组件时才触发让位动画，避免在同一目标组件内频繁移动导致闪烁
        if (!ReferenceEquals(lastDragOverComponent, Component))
        {
            // 在同一目标上方时先稳定一段时间再触发，避免来回移动造成闪烁
            if (TryCommitHoverTarget(Component) && TryScheduleAnimation())
            {
                TriggerSiblingAnimation();
            }
        }
    }

    private void OnDragLeave()
    {
        //如果当前被拖拽的组件和拖拽到上面的组件是同一个，直接返回
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (ReferenceEquals(currentDragComponent, Component))
            return;

        Component.DesignState.DragEffectStyle = string.Empty;

        //清理让位动画
        // 为保持连续拖拽的平滑过渡，这里不清理动画，交由下一个目标组件的计算覆盖
    }

    private void OnDragEnd(DragEventArgs e)
    {
        isDragging = false;
        Console.WriteLine("拖拽结束");
        initialX = 0;
        initialY = 0;

        // 清理所有拖动相关的样式和状态
        Component.DesignState.DragEffectStyle = string.Empty;
        Component.DesignState.AnimationTransform = string.Empty;
        Component.DesignState.IsAnimating = false;
        //重置所有组件的动画状态
        ResetAllAnimationStates();
    }

    private void OnMouseOver()
    {
        if (Component.DesignState.IsSelected == false)
        {
            Component.DesignState.DragEffectStyle = "outline: #1890ff dashed 1.5px;";
        }
    }

    private void OnMouseOut()
    {
        if (Component.DesignState.IsSelected == false)
        {
            Component.DesignState.DragEffectStyle = string.Empty;
        }
    }

    private void TriggerCurrentSiblingAnimation(double clientX, double clientY)
    {
        if (!isDragging) return;

        // 计算相对于初始位置的偏移量
        var dragOffsetX = clientX - initialX;
        var dragOffsetY = clientY - initialY;

        Console.WriteLine($"dragOffset:{dragOffsetX}-{dragOffsetY}");

        // 优化：只有当偏移量发生变化时才更新，避免不必要的重渲染
        if (Math.Abs(dragOffsetX) < 2 && Math.Abs(dragOffsetY) < 2)
            return;

        // 使用 transform3d 优化性能，触发 GPU 加速，添加 will-change 提示浏览器优化
        // 拖拽过程中不再移动原始组件，改为使用自定义拖拽图像展示拖拽效果
        // 仅保持内部状态用于命中测试与位移计算
    }

    private async Task OnDrag(DragEventArgs dragEventArgs)
    {
        if (!isDragging) return;

        // 更新被拖拽组件的跟随移动
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
        if (currentDragComponent == null) return;

        // 不再更新原始组件 transform，避免遮挡目标组件导致让位事件不触发

        // 命中测试：在拖拽过程中，识别鼠标下方的目标组件（排除当前拖拽组件），以触发让位动画
        try
        {
            var overComponentId = await JSRuntime.InvokeAsync<string>("elementUtils.getComponentIdByPoint", dragEventArgs.ClientX, dragEventArgs.ClientY, currentDragComponent.Id);
            if (!string.IsNullOrEmpty(overComponentId) && !string.Equals(overComponentId, currentDragComponent.Id, StringComparison.Ordinal))
            {
                var overComponent = DragDropStateService.FindComponentById(PageCascading.AppId, PageCascading.PageId, overComponentId);
                if (overComponent != null)
                {
                    var last = DragDropStateService.GetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId);
                    if (!ReferenceEquals(last, overComponent))
                    {
                        // 命中检测到新目标时，要求稳定停留 hoverStableMs 再触发动画
                        if (TryCommitHoverTarget(overComponent) && TryScheduleAnimation())
                        {
                            TriggerSiblingAnimation();
                        }
                    }
                }
            }
        }
        catch { }
    }

    private void OnDelete()
    {
        OnItemDelete.Invoke(Component);
    }

    private void OnCopy()
    {
        OnItemCopy.Invoke(Component);
    }
    #endregion

    #region Animation Methods
    /// <summary>
    /// 重置所有组件的动画状态
    /// </summary>
    private void ResetAllAnimationStates()
    {
        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        if (rootComponent?.Childrens != null)
        {
            foreach (var child in rootComponent.Childrens)
            {
                child.DesignState.AnimationTransform = string.Empty;
                child.DesignState.IsAnimating = false;
                child.RefreshState();
            }
        }
    }

    /// <summary>
    /// 触发兄弟组件的让位动画
    /// </summary>
    private void TriggerSiblingAnimation()
    {
        if (dimensions == null) return;

        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        var currentDragComponent = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);

        if (rootComponent?.Childrens == null || currentDragComponent == null)
            return;

        // 使用最后一次命中测试到的目标组件作为让位依据
        var overComponent = DragDropStateService.GetLastDragOverComponent(PageCascading.AppId, PageCascading.PageId);
        if (overComponent == null) return;
        var overIndex = rootComponent.Childrens.IndexOf(overComponent);
        var dragIndex = rootComponent.Childrens.IndexOf(currentDragComponent);

        if (overIndex == -1 || dragIndex == -1)
            return;

        // 计算每行可容纳的组件数量（至少为 1）
        var itemsPerRowDouble = Math.Floor(dimensions.ContainerWidth / dimensions.ActualWidth);
        var itemsPerRow = (int)(itemsPerRowDouble < 1 ? 1 : itemsPerRowDouble);

        foreach (var child in rootComponent.Childrens)
        {
            if (ReferenceEquals(child, currentDragComponent))
                continue;

            var childIndex = rootComponent.Childrens.IndexOf(child);
            var shouldMove = false;
            var moveDistanceX = 0.0;
            var moveDistanceY = 0.0;

            if (dragIndex > overIndex)    // 往前拖拽, 夹在两者之间的组件向后移动
            {
                if (childIndex >= overIndex && childIndex < dragIndex)
                {
                    shouldMove = true;
                    var col = childIndex % itemsPerRow;
                    var isRowEnd = col == (itemsPerRow - 1);
                    if (!isRowEnd)
                    {
                        // 同行移动
                        moveDistanceX = dimensions.ActualWidth;
                    }
                    else
                    {
                        // 跨行移动
                        moveDistanceX = -(itemsPerRow - 1) * dimensions.ActualWidth;
                        moveDistanceY = dimensions.ActualHeight;
                    }
                }
            }
            else    // 往后拖拽, 夹在两者之间的组件向前移动
            {
                if (childIndex > dragIndex && childIndex <= overIndex)
                {
                    shouldMove = true;
                    var col = childIndex % itemsPerRow;
                    var isRowStart = col == 0;
                    if (!isRowStart)
                    {
                        // 同行移动
                        moveDistanceX = -dimensions.ActualWidth;
                    }
                    else
                    {
                        // 跨行移动
                        moveDistanceX = (itemsPerRow - 1) * dimensions.ActualWidth;
                        moveDistanceY = -dimensions.ActualHeight;
                    }
                }
            }

            if (shouldMove)
            {
                // 使用 translate3d 优化性能，触发 GPU 加速
                var newTransform = moveDistanceY != 0
                    ? $"translate3d({moveDistanceX}px, {moveDistanceY}px, 0)"
                    : $"translate3d({moveDistanceX}px, 0, 0)";

                if (!string.Equals(child.DesignState.AnimationTransform, newTransform, StringComparison.Ordinal) || !child.DesignState.IsAnimating)
                {
                    child.DesignState.AnimationTransform = newTransform;
                    child.DesignState.IsAnimating = true;
                    child.RefreshState();
                }
            }
            else
            {
                // 未参与当前让位的组件需要复位，避免残留位移造成闪烁或错位
                if (!string.IsNullOrEmpty(child.DesignState.AnimationTransform) || child.DesignState.IsAnimating)
                {
                    child.DesignState.AnimationTransform = string.Empty;
                    child.DesignState.IsAnimating = false;
                    child.RefreshState();
                }
            }
        }

        // 计算并移动被拖拽组件到目标插槽位置（相对于其原始位置的位移）
        if (dragIndex != overIndex)
        {
            var currentRow = (int)Math.Floor(dragIndex / (double)itemsPerRow);
            var targetRow = (int)Math.Floor(overIndex / (double)itemsPerRow);
            var currentCol = dragIndex % itemsPerRow;
            var targetCol = overIndex % itemsPerRow;

            var dragDistanceX = (targetCol - currentCol) * dimensions.ActualWidth;
            var dragDistanceY = (targetRow - currentRow) * dimensions.ActualHeight;

            var newTransform = $"translate3d({dragDistanceX}px, {dragDistanceY}px, 0)";
            if (!string.Equals(currentDragComponent.DesignState.AnimationTransform, newTransform, StringComparison.Ordinal) || !currentDragComponent.DesignState.IsAnimating)
            {
                currentDragComponent.DesignState.AnimationTransform = newTransform;
                currentDragComponent.DesignState.IsAnimating = true;
                currentDragComponent.RefreshState();
            }
        }
        else
        {
            // 悬停在自身位置时复位拖拽组件
            if (!string.IsNullOrEmpty(currentDragComponent.DesignState.AnimationTransform) || currentDragComponent.DesignState.IsAnimating)
            {
                currentDragComponent.DesignState.AnimationTransform = string.Empty;
                currentDragComponent.DesignState.IsAnimating = false;
                currentDragComponent.RefreshState();
            }
        }
    }

    /// <summary>
    /// 清理兄弟组件的让位动画
    /// </summary>
    private void ClearSiblingAnimation()
    {
        var rootComponent = DragDropStateService.GetRootComponent(PageCascading.AppId, PageCascading.PageId);
        if (rootComponent?.Childrens != null)
        {
            var currentDrag = DragDropStateService.GetCurrentDragComponent(PageCascading.AppId, PageCascading.PageId);
            foreach (var child in rootComponent.Childrens)
            {
                if (!ReferenceEquals(child, currentDrag))
                {
                    child.DesignState.AnimationTransform = string.Empty;
                    child.DesignState.IsAnimating = false;
                    child.RefreshState();
                }
            }
        }
    }
    #endregion

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (IsInRootContainer)
            {
                BlazorEventDispatcher.Remove("designengine.pagesetting.pagelayout.onchange");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing DraggableItem: {ex.Message}");
        }
    }
}